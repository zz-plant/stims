{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stims-embed-backfill",
  "main": "scripts/embed-backfill-worker.ts",
  "compatibility_date": "2024-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No scheduled trigger. Embeddings only need refreshing when catalog
  // content or visual descriptions change, which happens in this repo's
  // catalog pipeline — run `bun run embed:backfill` (scripts/
  // trigger-embed-backfill.ts) after those change instead of paying for an
  // always-on cron. The authenticated POST route triggers a run; PUT /static
  // serves scripts/sync-previews-r2.ts.
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stims-gallery",
      "database_id": "89718825-6d36-4578-b97e-9eba1d60d75d"
    }
  ],
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "stims-presets" }],
  // Static-asset store (preset previews); populated via the authenticated
  // upload route on this worker, served by the site worker.
  "r2_buckets": [
    {
      "binding": "STATIC_R2",
      "bucket_name": "stims-static"
    }
  ],
  "observability": { "enabled": true }
}
