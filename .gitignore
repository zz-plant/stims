# Dependencies
node_modules/

# Local secrets: env files and Wrangler's .dev.vars
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Editors: only the shared VS Code config is tracked
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# OS files, backups, logs
.DS_Store
*.bak
*.log

# Build output (each package ignores its own dist/ so its mirror repo does too)
/dist/
# `bun run site:packages`: all package sites, for GitHub Pages
/_site/
# `bun run ctl:compile`: a 60 MB single-platform executable
/bin/stims-ctl
# Preset previews are published to R2 (scripts/sync-previews-r2.ts)
/public/milkdrop-presets/previews/

# Caches and local environments
.wrangler/
# Frame captures from scripts/generate-readme-clips.ts
/.cache/
__pycache__/
.venv/

# Measurement output
/scratch/
/output/
# e2e failure diagnostics (tests/e2e/agent-api.ts writeAgentFailureArtifact)
/test-results/

# Agent and tool state
/.claude/worktrees/
/.claude/settings.local.json
.cmux/
.codex/
.playwright-cli/
.playwright-mcp/
.sisyphus/
opencode.json
# .agent/ holds agent scratch, but skills are checked in. An unqualified ignore
# once swallowed close-parity-gap/SKILL.md on `git add` and broke `bun run mcp`.
.agent/*
!.agent/skills/
# Lefthook writes its shims here on clones whose core.hooksPath predates the
# move off husky. They embed machine-specific paths.
/.husky/

# Screenshots are capture-tool output unless a tracked report or manifest cites
# them, so everything here is ignored except the evidence directories.
/screenshots/*
!/screenshots/aesthetic-audit/
!/screenshots/butterchurn-support-sweep/
!/screenshots/parity/
# Ad-hoc parity captures. Files already tracked here stay tracked; a new
# certified capture needs its own `!` line, because `git add -f` is off limits.
/screenshots/parity/*.png
/screenshots/parity/*.debug*.json
/screenshots/parity/parity-artifacts.manifest.json
