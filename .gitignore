# Node dependencies
node_modules/

# Editor directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
*.bak

# Build directories
/dist/

# Stale TypeScript compiled outputs
/src/js/utils/**/*.js
/tests/unit/**/*.js

# Local Codex session state
.codex/
.playwright-mcp/
.sisyphus/
opencode.json

# Tooling
.cmux/
.agent/
.wrangler/

scratch/
thumbnails/

# Regenerable capture-script output. Each of these is the --output target of a
# script (run-milkdrop-loop-visual-sweep.ts, run-certification-corpus-perf-suite.ts),
# so the captures are reproducible and don't belong in history. Iteration rounds
# used to be preserved as sibling directories (-after, -final, -pilot, …); use
# --output outside the repo instead.
/screenshots/loop-preset-sweep*/
/screenshots/certification-perf/
/screenshots/ui-diff/
/screenshots/ui-diff-baseline/

# Ad-hoc milkdrop parity captures (regenerable via scripts/capture-*.ts).
# Curated evidence is kept: screenshots/parity/suite/, debug-canvas-*, and the
# captures cited by src/data/milkdrop-parity/webgpu-certification-report.json.
/screenshots/parity/*.png
/screenshots/parity/*.debug.json
/screenshots/parity/parity-artifacts.manifest.json
/screenshots/parity/*.debug*.json

