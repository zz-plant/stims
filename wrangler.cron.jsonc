{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stims-embed-backfill",
  "main": "scripts/embed-backfill-worker.ts",
  "compatibility_date": "2024-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Every 15 minutes: at 100 presets/run the multi-thousand preset catalog
  // finishes in hours instead of the months a daily 25-preset run would take.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stims-gallery",
      "database_id": "89718825-6d36-4578-b97e-9eba1d60d75d"
    }
  ],
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "stims-presets" }],
  "observability": { "enabled": true }
}
