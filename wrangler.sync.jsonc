{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Watch-together sync rooms (Durable Objects). Separate Worker because the
  // site Worker's entry is generated by `wrangler pages functions build`,
  // which cannot export DO classes.
  "name": "stims-sync",
  "main": "scripts/sync-room-worker.ts",
  "compatibility_date": "2026-02-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
  "observability": { "enabled": true }
}
