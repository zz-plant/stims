{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Workspace packages (packages/*) export their TypeScript source under
    // this condition, so the app type-checks against source, not dist.
    "customConditions": ["stims-source"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["bun", "node"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "functions/**/*"],
  "exclude": ["dist"]
}
