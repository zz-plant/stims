[preset00]
// Everything in Track 5 combined and made audio-reactive: q8 carries
// smoothed volume from per_frame into both the shape (radius) and the
// wave (amplitude via value's natural scaling), the same q-var bridge
// Track 4 used for per_pixel.
fRating=5
fDecay=0.97
fWaveAlpha=0.5
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.1
wave_g=0.2
wave_b=0.3
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
wavecode_0_enabled=1
wavecode_0_samples=200
wavecode_0_sep=0
wavecode_0_scaling=1
wavecode_0_smoothing=0.5
wavecode_0_r=1
wavecode_0_g=0.7
wavecode_0_b=0.2
wavecode_0_a=1
shapecode_0_enabled=1
shapecode_0_sides=5
shapecode_0_additive=0
shapecode_0_thickoutline=1
shapecode_0_textured=0
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.15
shapecode_0_ang=0
shapecode_0_r=0.9
shapecode_0_g=0.6
shapecode_0_b=0.1
shapecode_0_a=1
per_frame_1=ra=1/fps*0.1;
per_frame_2=bass_avg=bass_avg*(1-ra)+ra*bass;
per_frame_3=q8=bass_avg;
wave_0_per_point1=t=sample*6.283185+time*0.3;
wave_0_per_point2=x=0.5+(0.2+0.15*q8)*sin(t*3);
wave_0_per_point3=y=0.5+(0.2+0.15*q8)*cos(t*2);
shape_0_per_frame1=rad=0.1+q8*0.15;
shape_0_per_frame2=ang=time*0.5;
