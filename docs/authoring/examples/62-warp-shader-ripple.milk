[preset00]
// A ripple: read the previous frame at a coordinate pushed along a sine of
// distance from center. Same idea as Track 4's rings, written in GLSL and
// run per pixel on the GPU. The shader owns the fade, so fDecay is 1.
fRating=5
fDecay=1
fWaveAlpha=1.2
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.2
wave_g=0.85
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
[warp_shader]
vec2 center = uv - vec2(0.5, 0.5);
float dist = length(center);
float ripple = 0.01 * sin(dist * 40.0 - time * 2.0);
vec2 dir = center / (dist + 0.0001);
ret = texture2D(sampler_main, uv + dir * ripple).rgb;
ret *= 0.98;
