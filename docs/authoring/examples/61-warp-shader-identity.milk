[preset00]
// The smallest possible warp_shader: read the previous frame at uv, fade
// it, and write the color to ret. The shaderless bench does the same
// read with fDecay=0.98 as its fade. MilkDrop skips fDecay once a preset
// has a warp shader, so fDecay is 1 here and ret *= 0.98 is the fade.
fRating=5
fDecay=1
fWaveAlpha=1.2
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.2
wave_g=0.85
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
[warp_shader]
ret = texture2D(sampler_main, uv).rgb;
ret *= 0.98;
