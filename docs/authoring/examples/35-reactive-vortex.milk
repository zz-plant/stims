[preset00]
// The lab-measured example: RC-smoothed bass drives rotation speed, an
// adaptive beat threshold drives a color flash, and vol drives zoom.
// Run through: bun run lab:reactivity -- --file docs/authoring/examples/35-reactive-vortex.milk
fRating=5
fDecay=0.97
fWaveAlpha=1.2
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.2
wave_g=0.85
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
per_frame_1=ra = 1/fps*0.1;
per_frame_2=bass_avg = bass_avg*(1-ra) + ra*bass;
per_frame_3=vol = (bass+mid+treb)*0.333;
per_frame_4=vol = vol*vol;
per_frame_5=zoom = 1.005 + 0.03*vol;
per_frame_6=rot = 0.01 + bass_avg*0.04;
per_frame_7=bass_thresh = above(bass_att,bass_thresh)*2 + (1-above(bass_att,bass_thresh))*((bass_thresh-1.3)*0.96+1.3);
per_frame_8=beat_fired = above(bass_att,bass_thresh);
per_frame_9=wave_r = wave_r + 0.3*beat_fired*(1-wave_r);
