[preset00]
// Pattern 12 from the coding guide: a shape cycling through identities.
// Every 6th frame it advances to a new sides/color/rad combination — the
// shape doesn't move, it *morphs*.
fRating=5
fDecay=0.97
fWaveAlpha=0
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0
wave_g=0
wave_b=0
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
shapecode_0_enabled=1
shapecode_0_sides=4
shapecode_0_additive=0
shapecode_0_thickoutline=1
shapecode_0_textured=0
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.1
shapecode_0_ang=0
shapecode_0_r=1
shapecode_0_g=1
shapecode_0_b=1
shapecode_0_a=1
shape_0_per_frame1=s=frame%6+4;
shape_0_per_frame2=sides=s;
shape_0_per_frame3=rad=0.08+s*0.01;
shape_0_per_frame4=ang=s*0.3;
shape_0_per_frame5=r=sin(s*1.1)*0.5+0.5;
shape_0_per_frame6=g=sin(s*2.2)*0.5+0.5;
shape_0_per_frame7=b=sin(s*3.3)*0.5+0.5;
