[preset00]
// The lesson bench: a bright waveform, no motion, nothing hidden.
// Every Track 1 and Track 2 example is this file with one or two lines changed.
fRating=5
fDecay=0.97
fWaveAlpha=1.2
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.2
wave_g=0.85
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
per_frame_1=arc = progress*progress;
per_frame_2=zoom = 1.002 + 0.016*arc;
per_frame_3=rot = 0.012*arc*sin(time*0.21);
per_frame_4=warp = 0.15*arc;
per_frame_5=wave_r = 0.2 + 0.7*arc;
per_frame_6=wave_b = 1 - 0.5*arc;
