[preset00]
// The lesson bench: a bright waveform, no motion, nothing hidden.
// Every Track 1 and Track 2 example is this file with one or two lines changed.
fRating=5
fDecay=0.97
fWaveAlpha=1.2
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1.008
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.2
wave_g=0.85
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
per_frame_1=rot = 0.008 + 0.004*sin(time*0.13);
per_frame_2=wave_r = wave_r + 0.25*(0.6*sin(0.98*time) + 0.4*sin(1.047*time));
per_frame_3=wave_g = wave_g + 0.25*(0.6*sin(0.835*time) + 0.4*sin(1.081*time));
per_frame_4=wave_b = wave_b + 0.25*(0.6*sin(0.814*time) + 0.4*sin(1.011*time));
