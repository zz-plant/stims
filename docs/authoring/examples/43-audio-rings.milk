[preset00]
// Same rings, but the amplitude comes from q8 — set once in per_frame
// from smoothed volume, then read by every mesh point in per_pixel.
// This is the q-var bridge: per_frame can't see per-pixel state, and
// per_pixel can't see across frames, so q1-q32 are the handoff.
fRating=5
fDecay=0.97
fWaveAlpha=1.2
fWaveScale=1
nWaveMode=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=1
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
warp=0
wave_r=0.2
wave_g=0.85
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0
mv_a=0
per_frame_1=ra=1/fps*0.1;
per_frame_2=bass_avg=bass_avg*(1-ra)+ra*bass;
per_frame_3=q8=bass_avg;
per_pixel_1=dr=0.01+0.05*q8*sin(rad*12+time*0.5);
per_pixel_2=dx=dx+dr*cos(ang)*0.6;
per_pixel_3=dy=dy+dr*sin(-ang)*0.6;
