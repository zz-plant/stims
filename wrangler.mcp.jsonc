{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // "stims" is the site Worker (wrangler.site.jsonc); this one must not
  // share the name or deploying it would overwrite the site.
  "name": "stims-mcp",
  "main": "scripts/mcp-worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": false
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
