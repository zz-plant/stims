{
  "name": "stims",
  "description": "Browser-native MilkDrop-inspired visualizer with curated presets, live editing, and import/export.",
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://toil.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/zz-plant/stims.git"
  },
  "bugs": {
    "url": "https://github.com/zz-plant/stims/issues"
  },
  "keywords": [
    "milkdrop",
    "milkdrop-successor",
    "visualizer",
    "audio-reactive",
    "threejs",
    "webgl",
    "webgpu",
    "generative-art",
    "creative-coding",
    "preset-browser"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun run scripts/run-tests.ts",
    "test:fast": "bun run scripts/run-tests.ts --profile fast",
    "test:unit": "bun run scripts/run-tests.ts --profile unit",
    "test:integration": "bun run scripts/run-tests.ts --profile integration",
    "test:e2e": "bun run scripts/run-tests.ts --profile e2e",
    "test:compat": "bun run scripts/run-tests.ts --profile compat",
    "test:corpus": "bun run scripts/run-tests.ts --profile corpus",
    "test:changed": "bun run scripts/run-tests.ts --changed",
    "test:android": "bun run scripts/android-test.ts",
    "check:accessibility": "bun run scripts/accessibility-audit.ts",
    "test:watch": "bun run scripts/run-tests.ts --watch",
    "test:watch:milkdrop": "bun run scripts/run-tests.ts --watch tests/unit/milkdrop-compiler tests/unit/milkdrop-expression tests/unit/milkdrop-shader tests/unit/milkdrop-wgsl-vectorization",
    "biome:check": "bash scripts/run-biome.sh check",
    "lint": "bash scripts/run-biome.sh lint",
    "lint:fix": "bash scripts/run-biome.sh lint --write",
    "format": "bash scripts/run-biome.sh format --write",
    "format:check": "bash scripts/run-biome.sh format",
    "typecheck": "bun --bun ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:watch": "bun --bun ./node_modules/typescript/bin/tsc --noEmit --watch",
    "dev": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js",
    "dev:host": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js --host",
    "dev:check": "bun scripts/dev-check.mjs || node scripts/dev-check.mjs",
    "play:toy": "bun run scripts/play-toy.ts",
    "doctor": "bun run setup:codex --status",
    "setup": "mise trust && bun run setup:codex",
    "setup:codex": "bash scripts/codex-setup.sh",
    "session:codex": "bash scripts/codex-session.sh",
    "model:codex": "bash scripts/codex-model-route.sh",
    "agent:status": "bash scripts/codex-setup.sh --status && echo && bash scripts/codex-session.sh --status",
    "agent:verify": "bash scripts/codex-setup.sh --status && bun run check:quick",
    "check": "bun run scripts/run-quality-gate.ts",
    "check:all": "bun run scripts/run-quality-gate.ts --all",
    "check:catalog-fidelity": "bun run scripts/check-bundled-catalog-fidelity.ts",
    "check:catalog-integrity": "bun run scripts/check-catalog-integrity.ts",
    "check:pre-commit": "bun run scripts/check-pre-commit-guards.ts",
    "check:quick": "bun run scripts/run-quality-gate.ts --quick",
    "check:architecture": "bun --bun ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config .dependency-cruiser.mjs --cache node_modules/.cache/dependency-cruiser src/js scripts tests",
    "check:toys": "bun run scripts/check-toys.ts",
    "check:seo": "bun run scripts/check-seo.ts",
    "check:css-tokens": "bun run scripts/check-css-tokens.ts",
    "check:stale-paths": "bun run scripts/check-stale-paths.ts",
    "check:doc-references": "bun run scripts/check-doc-references.ts",
    "check:authoring-examples": "bun run scripts/check-authoring-examples.ts",
    "check:authoring-docs": "bun run scripts/check-authoring-examples.ts && bun run scripts/generate-authoring-reference.ts --check",
    "docs:authoring-reference": "bun run scripts/generate-authoring-reference.ts",
    "check:ci-config": "bun run scripts/check-ci-config.ts",
    "check:commit-msg": "bun run scripts/check-commit-msg.ts",
    "check:duplicate-css": "bun run scripts/check-duplicate-css.ts",
    "check:unused-exports": "bun run scripts/check-unused-exports.ts",
    "build": "bun scripts/build.mjs || node scripts/build.mjs",
    "build:reuse": "bun run build -- --reuse",
    "generate:toys": "bun run scripts/generate-toy-manifest.ts",
    "generate:seo": "bun run scripts/generate-seo.ts",
    "generate:search-index": "bun run scripts/generate-catalog-search-index.ts",
    "generate:previews": "bun run scripts/generate-thumbnails.ts",
    "generate:clips": "bun run scripts/generate-readme-clips.ts",
    "previews:sync": "bun run scripts/sync-previews-r2.ts",
    "generate:all": "bun run --parallel generate:search-index generate:previews",
    "serve:dist": "bun run scripts/serve-dist.ts",
    "preview": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js preview --host",
    "cf:whoami": "bunx wrangler whoami",
    "site:build": "bun run build && bunx wrangler pages functions build --outdir=dist/_worker.js && printf '_worker.js\\n.vite\\nmilkdrop-presets/previews\\n' > dist/.assetsignore",
    "site:check": "bun run site:build && bunx wrangler deploy --dry-run --config wrangler.site.jsonc",
    "site:deploy": "bun run site:build && bunx wrangler deploy --config wrangler.site.jsonc",
    "site:preview": "bun run site:build && bunx wrangler versions upload --config wrangler.site.jsonc",
    "site:dev": "bun run site:build && bunx wrangler dev --config wrangler.site.jsonc",
    "mcp": "bun run scripts/mcp-server.ts",
    "mcp:check": "bunx wrangler deploy --dry-run --config wrangler.mcp.jsonc",
    "mcp:deploy": "bunx wrangler deploy --config wrangler.mcp.jsonc",
    "mcp:dev": "bunx wrangler dev --config wrangler.mcp.jsonc",
    "cron:check": "bunx wrangler deploy --dry-run --config wrangler.cron.jsonc",
    "cron:deploy": "bunx wrangler deploy --config wrangler.cron.jsonc",
    "cron:dev": "bunx wrangler dev --config wrangler.cron.jsonc",
    "parity:diff": "bun run scripts/diff-parity-artifacts.ts",
    "parity:capture": "bun run scripts/capture-visual-reference-suite.ts",
    "parity:capture:projectm-native": "bun run scripts/capture-native-projectm-reference.ts",
    "parity:capture:corpus": "bun run scripts/capture-certification-corpus.ts",
    "parity:capture:bundled": "bun run scripts/capture-certification-corpus.ts --group bundled-shipped",
    "parity:promote-reference": "bun run scripts/promote-projectm-reference.ts",
    "parity:promote-result": "bun run scripts/promote-parity-suite-result.ts",
    "parity:prune": "bun run scripts/prune-parity-artifacts.ts",
    "parity:sync-catalog": "bun run scripts/sync-bundled-catalog-fidelity.ts",
    "parity:suite": "bun run scripts/run-parity-diff-suite.ts",
    "perf:certification-corpus": "bun run scripts/run-certification-corpus-perf-suite.ts",
    "lab:reactivity": "bun run scripts/preset-lab-reactivity.ts",
    "lab:visual": "bun run scripts/preset-lab-visual.ts",
    "sweep:milkdrop-loops": "bun run scripts/run-milkdrop-loop-visual-sweep.ts",
    "sweep:butterchurn": "bun run scripts/sweep-butterchurn-support.ts",
    "test:agent": "bun run test:integration",
    "postinstall": "bun scripts/postinstall.mjs || node scripts/postinstall.mjs",
    "dev:webgpu": "bun scripts/dev-webgpu.mjs || node scripts/dev-webgpu.mjs",
    "dev:ui": "vite --config vite.config.ui.js",
    "ui:diff": "bun scripts/ui-diff.ts",
    "check:no-ts-nocheck": "bash scripts/check-no-ts-nocheck.sh",
    "check:production-edge": "bash scripts/check_production_edge.sh",
    "assets:check": "bun run scripts/check-assets.ts",
    "assets:generate": "bun run scripts/generate-scenes.ts",
    "perf:low-resource": "bun run scripts/run-certification-corpus-perf-suite.ts --cpu-throttle 4 --renderer compatibility --viewport-width 1280 --viewport-height 720 --output ./screenshots/low-resource-perf"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "6.0.5",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "dependency-cruiser": "^17.3.9",
    "esbuild": "^0.28.1",
    "happy-dom": "20.11.1",
    "husky": "^9.1.7",
    "playwright": "1.62.1",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.120.1"
  },
  "engines": {
    "node": "^22",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@resvg/resvg-wasm": "^2.6.2",
    "@strudel/web": "^1.3.0",
    "browser-fs-access": "^0.38.0",
    "comlink": "^4.4.2",
    "meyda": "^5.6.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stats-gl": "4.2.3",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/autocomplete": "6.20.3",
    "zod": "4.4.3"
  }
}
