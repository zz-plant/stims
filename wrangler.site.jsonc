{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The site Worker — replaces the Cloudflare Pages project of the same name.
  // Built and deployed by Cloudflare Workers Builds on push (see
  // docs/DEPLOYMENT.md). `main` is the Pages Functions bundle compiled by
  // `bun run site:build`; static assets come from the same dist/ directory.
  "name": "stims",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-02-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The OG-rewrite middleware must see HTML navigations first; pure static
    // asset paths skip the Worker invocation.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/vendor/*",
      "!/icons/*",
      "!/screenshots/*",
      "!/og/*",
      "!/textures/*",
      // Previews are served from R2 by the Worker; the rest of the preset
      // corpus (.milk sources, catalogs, engine libraries) stays on assets.
      "!/milkdrop-presets/*.milk",
      "!/milkdrop-presets/*.json",
      "!/milkdrop-presets/butterchurn/*",
      "!/milkdrop-presets/libraries/*",
      "!/robots.txt",
      "!/sitemap*.xml",
      "!/manifest.json",
      "!/favicon.ico",
      // Read by the OG middleware through the ASSETS binding; direct hits do
      // not need the Worker.
      "!/preset-meta.json",
      "!/llms.txt",
      "!/llms-full.txt",
      "!/openapi.json",
      "!/toys.json"
    ]
  },
  "placement": { "mode": "smart" },
  "ai": { "binding": "AI" },
  // Telemetry sink for /api/telemetry — without this binding every client
  // data point is silently dropped.
  "analytics_engine_datasets": [
    { "binding": "STIMS_TELEMETRY", "dataset": "stims_telemetry" }
  ],
  // Semantic preset search; /api/visual-search falls back to a brute-force
  // D1 cosine scan when this binding is absent.
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "stims-presets" }],
  // Per-IP limiter for the Workers AI endpoints (open-beta ratelimit binding).
  "unsafe": {
    "bindings": [
      {
        "name": "AI_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stims-gallery",
      "database_id": "89718825-6d36-4578-b97e-9eba1d60d75d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY_R2",
      "bucket_name": "stims-gallery"
    },
    {
      "binding": "STATIC_R2",
      "bucket_name": "stims-static"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
