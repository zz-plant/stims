shape_0_per_frame1=// Shape pulses on beat
shape_0_per_frame2=rad = 0.08 + 0.12*q8;
shape_0_per_frame3=ang = ang + 0.05*beat + 0.008*q1;
shape_0_per_frame4=x = 0.5 + 0.08*sin(q1*1.3);
shape_0_per_frame5=y = 0.5 + 0.08*cos(q1*0.9);
