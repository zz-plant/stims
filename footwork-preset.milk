wavecode_1_a=0.600000
wave_1_per_frame1=
wave_1_per_point1=// Inverse radial zoom
wave_1_per_point2=zoom = (zoom-1)*(1-rad) + 1;
wave_1_per_point3=
wave_1_per_point4=// Counter-rotating pulse
wave_1_per_point5=dr = 0.006 + 0.025*q8*sin(rad*12 - time*0.5);
wave_1_per_point6=dx = dx + dr*cos(ang)*0.5;
wave_1_per_point7=dy = dy + dr*sin(ang)*0.5;
wave_1_per_point8=
wave_1_per_point9=// Different angular modulation
wave_1_per_point10=ang = ang - 0.015*q8*sin(rad*10 - time*0.4);
wave_1_per_point11=
wave_1_per_point12=// Complementary color
wave_1_per_point13=r = 1.0 - wave_r*0.5 + 0.2*sin(ang*4 + q1);
wave_1_per_point14=g = 1.0 - wave_g*0.5 + 0.2*sin(ang*4 + 2.1 + q1);
wave_1_per_point15=b = 1.0 - wave_b*0.5 + 0.2*sin(ang*4 + 4.2 + q1);
wave_1_per_point16=a = 0.4 + 0.3*rad;
