shape_0_per_frame7=g = 0.3 + 0.3*sin(q1*1.7 + 2.1);
shape_0_per_frame8=b = 0.1 + 0.4*sin(q1*2.3 + 4.2);
shape_0_per_frame9=a = 0.3 + 0.4*q8;
