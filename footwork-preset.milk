wave_0_per_frame1=// RC smoothing for tight footwork response
wave_0_per_frame2=ra = 1/fps_corr*0.12;
wave_0_per_frame3=bass_avg = bass_avg*(1-ra) + ra*bass_att;
wave_0_per_frame4=mid_avg = mid_avg*(1-ra) + ra*mid_att;
wave_0_per_frame5=treb_avg = treb_avg*(1-ra) + ra*treb_att;
wave_0_per_frame6=
wave_0_per_frame7=// Volume squaring for punch
wave_0_per_frame8=vol = (bass_avg+mid_avg+treb_avg)*0.33;
wave_0_per_frame9=vol = vol*vol;
wave_0_per_frame10=
wave_0_per_frame11=// Master animation clock
wave_0_per_frame12=mtime = mtime + vol*0.025*(75/fps);
wave_0_per_frame13=q1 = mtime*0.6;
wave_0_per_frame14=q8 = vol;
wave_0_per_frame15=
wave_0_per_frame16=// Beat detection with adaptive threshold
wave_0_per_frame17=beat_thresh = above(bass_att,beat_thresh)*2.5 + (1-above(bass_att,beat_thresh))*((beat_thresh-1.4)*0.94+1.4);
wave_0_per_frame18=beat = above(bass_att,beat_thresh);
wave_0_per_frame19=
wave_0_per_frame20=// Color cycling with irrational frequencies
wave_0_per_frame21=wave_r = wave_r + 0.25*(0.6*sin(0.97*time) + 0.4*sin(1.03*time));
wave_0_per_frame22=wave_g = wave_g + 0.35*(0.6*sin(0.83*time) + 0.4*sin(1.07*time));
wave_0_per_frame23=wave_b = wave_b + 0.20*(0.6*sin(0.81*time) + 0.4*sin(1.01*time));
wave_0_per_frame24=
wave_0_per_frame25=// Wave position modulation
wave_0_per_frame26=wave_x = 0.5 + 0.15*sin(q1*0.7);
wave_0_per_frame27=wave_y = 0.5 + 0.15*cos(q1*0.9);
wave_0_per_point1=// Per-pixel radial zoom (Pattern 3)
wave_0_per_point2=zoom = (zoom-1)*rad + 1;
wave_0_per_point3=
wave_0_per_point4=// Radial pulse rings (Pattern 4) - synced to q8
wave_0_per_point5=dr = 0.008 + 0.035*q8*sin(rad*16 + time*0.4);
wave_0_per_point6=dx = dx + dr*cos(ang)*0.7;
wave_0_per_point7=dy = dy + dr*sin(-ang)*0.7;
wave_0_per_point8=
wave_0_per_point9=// Angular rotation modulated by audio
wave_0_per_point10=ang = ang + 0.02*q8*sin(rad*8 + time*0.3);
wave_0_per_point11=
wave_0_per_point12=// Spectrum-reactive wave shape
wave_0_per_point13=spec_val = spec_int*0.5 + spec_avg*0.5;
wave_0_per_point14=y = y + spec_val*0.15*sin(sample*12 + q1*2);
wave_0_per_point15=
wave_0_per_point16=// Color from frame state
wave_0_per_point17=r = wave_r*0.7 + 0.3*sin(ang*3);
wave_0_per_point18=g = wave_g*0.7 + 0.3*sin(ang*3 + 2.1);
wave_0_per_point19=b = wave_b*0.7 + 0.3*sin(ang*3 + 4.2);
wave_0_per_point20=a = 0.6 + 0.4*(1-rad);
wavecode_1_enabled=1
wavecode_1_samples=512
