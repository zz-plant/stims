/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Large preset sources, previews, and textures use stable human-readable names.
# Cache them long enough to avoid repeat transfers during normal use, then
# revalidate in the background so an in-place asset correction still reaches
# returning users.
#
# Each preset page links its .milk file. The page is what should rank for a
# preset; the raw source is a download, not a search result.
/milkdrop-presets/*.milk
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Robots-Tag: noindex

# Catalog manifests are the largest payloads in the app (catalog.json ~2.4 MB
# raw / ~100 KB gzipped, search-index.json ~1.1 MB / ~61 KB gzipped) and change
# only on deploy. `check:bundle-size` budgets the gzipped sizes so growth here
# cannot go unnoticed again — the catalog had reached 2.4 MB while this comment
# still said 1.7 MB. A short max-age keeps
# them fresh within the hour while stale-while-revalidate makes repeat visits
# serve instantly from HTTP cache instead of re-downloading on every load.
/milkdrop-presets/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/milkdrop-presets/previews/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Icons and the manifest previously shipped with no Cache-Control at all,
# leaving freshness to browser heuristics (typically 10% of file age — days
# for these). Explicit rules make revocation predictable: a day of caching,
# then background revalidation.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/screenshots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/.vite/*
  Cache-Control: public, max-age=0, must-revalidate

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# The commit this deploy serves, written by `site:build`. A check reads it to
# see whether a merge is live, so a cached copy must not outlast the deploy
# that replaces it. It is for checks, not search results.
/deploy-manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Cache-Control: no-store
