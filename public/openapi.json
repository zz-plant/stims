{
  "openapi": "3.0.3",
  "info": {
    "title": "Stims (toil.fyi) API",
    "description": "Preset source operations exposed by the site Worker. Model-backed routes depend on configured bindings; compilation does not establish visual fidelity.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://toil.fyi/api",
      "description": "Example production base URL; optional endpoint availability depends on deployment bindings"
    }
  ],
  "paths": {
    "/validate-preset": {
      "post": {
        "summary": "Validate MilkDrop preset syntax",
        "description": "Compile MilkDrop source and return diagnostics without GPU rendering. Valid means no compiler error diagnostics.",
        "operationId": "validatePreset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["milkSource"],
                "properties": {
                  "milkSource": {
                    "type": "string",
                    "description": "Raw MilkDrop .milk equations source code."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnostic output",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "fieldCount": {
                      "type": "integer"
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["severity", "code", "message"],
                        "properties": {
                          "severity": {
                            "type": "string",
                            "enum": ["error", "warning"]
                          },
                          "code": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer"
                          },
                          "message": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["severity", "code", "message"],
                        "properties": {
                          "severity": {
                            "type": "string",
                            "enum": ["error", "warning"]
                          },
                          "code": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer"
                          },
                          "message": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "valid",
                    "fieldCount",
                    "sections",
                    "errors",
                    "warnings"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          }
        }
      }
    },
    "/patch-preset": {
      "post": {
        "summary": "Apply deterministic parameter patch",
        "description": "Applies key-value field overrides directly to MilkDrop source code.",
        "operationId": "patchPreset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["milkSource", "patch"],
                "properties": {
                  "milkSource": {
                    "type": "string"
                  },
                  "patch": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patched source code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "milkSource": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          }
        }
      }
    },
    "/generate-preset": {
      "post": {
        "summary": "Generate preset from prompt",
        "description": "Generates MilkDrop equations from a text description.",
        "operationId": "generatePreset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "complexity": {
                    "type": "string",
                    "enum": ["simple", "moderate", "complex"]
                  },
                  "model": {
                    "type": "string",
                    "description": "Allowed model override; unsupported names fall back to server selection."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated preset payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "milkSource": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          },
          "429": {
            "description": "Configured model rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay in seconds"
              }
            }
          },
          "500": {
            "description": "Provider or service failure"
          }
        }
      }
    },
    "/refine-preset": {
      "post": {
        "summary": "Iteratively refine preset",
        "description": "Applies prompt instructions to refine existing MilkDrop equations.",
        "operationId": "refinePreset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentSource", "instruction"],
                "properties": {
                  "currentSource": {
                    "type": "string"
                  },
                  "instruction": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string",
                    "description": "Allowed model override; unsupported names fall back to server selection."
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refined source code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "milkSource": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string",
                      "description": "Present for explain/describe instructions; milkSource is unchanged."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          },
          "429": {
            "description": "Configured model rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay in seconds"
              }
            }
          },
          "500": {
            "description": "Provider or service failure"
          }
        }
      }
    },
    "/blend-presets": {
      "post": {
        "summary": "Blend two presets",
        "description": "Combines motion from Preset A with colors from Preset B.",
        "operationId": "blendPresets",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sourceA", "sourceB"],
                "properties": {
                  "sourceA": {
                    "type": "string"
                  },
                  "sourceB": {
                    "type": "string"
                  },
                  "instruction": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blended source code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "milkSource": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          },
          "429": {
            "description": "Configured model rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay in seconds"
              }
            }
          },
          "500": {
            "description": "Provider or service failure"
          }
        }
      }
    },
    "/visual-search": {
      "post": {
        "summary": "Search catalog visually",
        "description": "Finds presets matching visual description.",
        "operationId": "visualSearch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "embedOnly": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "presetId": {
                                "type": "string"
                              },
                              "score": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "source": {
                          "type": "string"
                        }
                      },
                      "required": ["results"]
                    },
                    {
                      "type": "object",
                      "required": ["embedding"],
                      "properties": {
                        "embedding": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          },
          "429": {
            "description": "Configured model rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay in seconds"
              }
            }
          },
          "500": {
            "description": "Provider or service failure"
          }
        }
      }
    },
    "/batch-generate": {
      "post": {
        "summary": "Generate preset variations",
        "operationId": "batchGenerate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["presets"],
                  "properties": {
                    "presets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          },
          "429": {
            "description": "Configured model rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay in seconds"
              }
            }
          },
          "500": {
            "description": "Provider or service failure"
          }
        }
      }
    },
    "/image-to-preset": {
      "post": {
        "summary": "Generate source from an image",
        "operationId": "imageToPreset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "description": "Base64 image data"
                  },
                  "guidance": {
                    "type": "string",
                    "description": "Trimmed to 500 characters"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "guidance": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["description", "milkSource"],
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "milkSource": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing request fields"
          },
          "405": {
            "description": "Unsupported method; use POST or OPTIONS"
          },
          "429": {
            "description": "Configured model rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Retry delay in seconds"
              }
            }
          },
          "500": {
            "description": "Provider or service failure"
          }
        }
      }
    },
    "/decide": {
      "post": {
        "summary": "Evaluate a fixed typed visual or audio question set",
        "description": "Optional AI binding. Probabilistic observations with provisional acceptance policy; never generates source or certifies safety, parity or performance. Audio/video selects Clef Omni. Limits: 6 MiB total decoded media, 9 MiB JSON body.",
        "operationId": "decide",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task", "state"],
                "properties": {
                  "task": {
                    "type": "string",
                    "enum": [
                      "visual-profile",
                      "prompt-match",
                      "audio-match",
                      "scene-choice",
                      "capture-review"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "enum": ["clef-flash", "clef-omni"]
                  },
                  "state": {
                    "type": "object",
                    "description": "At most 16 KiB. prompt-match requires prompt; audio-match candidates and scene-choice scenes are 1-12 {id,description} entries. Video-only sound tasks require videoHasAudio:true."
                  },
                  "images": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "string"
                    },
                    "description": "Image MIME data URLs; 1 MiB decoded each."
                  },
                  "audio": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    },
                    "description": "WAV/MP3 data URLs; 2 MiB decoded each."
                  },
                  "videos": {
                    "type": "array",
                    "maxItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "WebM/MP4 data URLs; 4 MiB decoded each. Provider validates decoding and duration."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed noul/choice/score answers, accepted/review disposition, model and input/question provenance. Cache-Control: no-store. See docs/DECISION_MODELS.md for the exact versioned contract."
          },
          "400": {
            "description": "Invalid request"
          },
          "405": {
            "description": "Use POST"
          },
          "413": {
            "description": "Input too large"
          },
          "429": {
            "description": "Configured rate limit exceeded"
          },
          "502": {
            "description": "Provider failure or malformed output"
          },
          "503": {
            "description": "AI binding unavailable"
          },
          "504": {
            "description": "Request/evaluation deadline exceeded"
          }
        }
      }
    }
  }
}
