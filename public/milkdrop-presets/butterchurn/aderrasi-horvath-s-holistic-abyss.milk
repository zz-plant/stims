[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=0.999997
bWaveThick=1.000000
bTexWrap=0.000000
fWaveAlpha=100.000000
fWaveScale=0.010000
fWaveSmoothing=0.500000
fWaveParam=0.400000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fZoomExponent=1.000157
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
nMotionVectorsX=64.000000
nMotionVectorsY=1.488000
nMotionVectorsDy=-0.100000
nMotionVectorsLoop=0.500000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 3.35 * sin(4 * mid_att) - 3.25 * sin(2.5 * bass);
per_frame_2=wave_g = wave_g + 3.35 * sin(3.7 * treb_att) - 3.25 * sin(2.11 * mid);
per_frame_3=wave_b = wave_b + 3.35 * sin(3.84 * bass_att) - 3.25 * sin(2.3 * treb);
per_frame_4=warp = 0;
per_frame_5=zoom = zoom + 0.03;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + if(0.00001 < abs(above(rad, 0.2 + 0.25 * sin(1.2 * time))), if(0.00001 < abs(below(rad, 0.5 + 0.25 * sin(1.2 * time))), -0.05, -0.025), -0.02 * (1 - rad));
per_pixel_5=rot = rot + if(0.00001 < abs(above(rad, 0.2 + 0.25 * cos(1.8 * time))), if(0.00001 < abs(below(rad, 0.5 + 0.25 * cos(1.8 * time))), 0.08, -0.08), -0.5 * (0.5 - rad));
per_pixel_6=zoom = zoom + 0.003;
per_pixel_7=dx = dx + (1 - rad) * dx_r;
per_pixel_8=dy = dy + (1 - rad) * dy_r;
per_pixel_9=dx = dx + 0.03 * above(rad, 0.5 + 0.4 * cos(2 * time)) * dx_r;
per_pixel_10=dy = dy + 0.03 * above(rad, 0.5 + 0.4 * sin(2 * time)) * dy_r;
