per_frame_init_1=tg3 = 0;
per_frame_init_2=rg2 = 0;
per_frame_init_3=pfdx_r = 0;
per_frame_init_4=pfthresh = 0;
per_frame_init_5=ocog = 0;
per_frame_init_6=thresh = 0;
per_frame_init_7=q1 = 0;
per_frame_init_8=cog = 0;
per_frame_init_9=x = 0;
per_frame_init_10=dy_r = 0;
per_frame_init_11=tg2 = 0;
per_frame_init_12=tg1 = 0;
per_frame_init_13=rg3 = 0;
per_frame_init_14=pfdy_r = 0;
per_frame_init_15=rg1 = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=xy1 = 0;
per_frame_init_18=dx_r = 0;
per_frame_init_19=y = 0;
per_frame_init_20=q2 = 0;
per_frame_init_21=xy2 = 0;
per_frame_1=wave_r = wave_r + 0.5 * (0.6 * sin(1.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.5 * (0.6 * sin(0.909 * time) + 0.4 * sin(1.956 * time));
per_frame_3=wave_b = wave_b + 0.5 * (0.6 * sin(2.91 * time) + 0.4 * sin(0.992 * time));
per_frame_4=xy1 = x * above(sin(time), 0) + y * below(sin(time), 0);
per_frame_5=xy2 = x * below(sin(time), 0) + y * above(sin(time), 0);
per_frame_6=q1 = xy1;
per_frame_7=q2 = xy2;
per_frame_8=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_frame_9=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_frame_10=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_frame_11=echo_orient = echo_orient + 50 * dy_r;
per_frame_12=cog = ocog + 0.005 * (bass + bass_att + bass * bass_att - 2);
per_frame_13=ocog = below(cog, 30000) * cog;
per_frame_14=q4 = cog;
per_frame_15=decay = min(0.995 + abs(0.05 * sin(time)), 1);
per_frame_16=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_17=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_18=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_19=rg1 = abs(sin(1.3 * q4));
per_frame_20=rg2 = 0 * above(rg1, 0.5) + 1 * below(rg1, 0.5);
per_frame_21=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_22=invert = rg3;
per_frame_23=darken = 1 - invert;
per_frame_24=brighten = invert;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + abs(3 * (0.5 - rad) * bass_att * 0.2);
per_pixel_5=zoom = zoom + if(0.00001 < abs(above(bass_att, 1.2)), 0.06 * sin(24 * time), 0);
per_pixel_6=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_7=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_8=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_9=tg1 = abs(sin(1.32 * q4));
per_pixel_10=tg2 = 8 * above(tg1, 0.75) + 12 * below(tg1, 0.25) + 16 * above(tg1, 0.25) * below(tg1, 0.5);
per_pixel_11=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_12=zoom = zoom + abs(7 * rad * dx_r);
per_pixel_13=dx = dx + dx_r * sin(sin(3 + tg3 * y)) * sin(3 + tg3 * x);
per_pixel_14=dy = dy + dy_r * sin(sin(3 + tg3 * y)) * sin(3 + (tg3 + x));
