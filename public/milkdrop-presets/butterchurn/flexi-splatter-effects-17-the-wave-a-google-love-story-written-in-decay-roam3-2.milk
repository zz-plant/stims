shape_3_init26=q3 = 0;
shape_3_init27=sample = 0;
shape_3_per_frame1=sample = instance / num_inst;
shape_3_per_frame2=rad = 0.05 + 0.04 * sin(sample);
shape_3_per_frame3=q10 = 250 * sample;
shape_3_per_frame4=my_x = -0.22 * cos(q10) - 1.28 * sin(q10) - 0.44 * cos(3 * q10) - 0.78 * sin(3 * q10);
shape_3_per_frame5=my_y = -0.1 * cos(2 * q10) - 0.27 * sin(2 * q10) + 0.38 * cos(4 * q10) + 0.46 * sin(4 * q10);
shape_3_per_frame6=my_z = 0.7 * cos(3 * q10) - 0.4 * sin(3 * q10);
shape_3_per_frame7=d = 0.2;
shape_3_per_frame8=zoom = 1;
shape_3_per_frame9=w3 = q1;
shape_3_per_frame10=w2 = q2;
shape_3_per_frame11=w1 = q3;
shape_3_per_frame12=x1 = cos(w1) * my_x + sin(w1) * my_y;
shape_3_per_frame13=y1 = -sin(w1) * my_x + cos(w1) * my_y;
shape_3_per_frame14=z1 = my_z;
shape_3_per_frame15=x2 = cos(w2) * x1 + sin(w2) * z1;
shape_3_per_frame16=z2 = -sin(w2) * x1 + cos(w2) * z1;
shape_3_per_frame17=y2 = y1;
shape_3_per_frame18=y3 = cos(w3) * y2 + sin(w3) * z2;
shape_3_per_frame19=z3 = -sin(w3) * y2 + cos(w3) * z2;
shape_3_per_frame20=x3 = x2;
shape_3_per_frame21=l = sqrt(x3 * x3 + y3 * y3);
shape_3_per_frame22=w = atan2(x3, y3);
shape_3_per_frame23=p = tan(asin(1) + atan2(d + z3, l));
shape_3_per_frame24=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_3_per_frame25=my_x = zoom * sin(w) * p;
shape_3_per_frame26=my_y = zoom * cos(w) * p;
shape_3_per_frame27=p1 = 0.2 * sin(50 * sample);
shape_3_per_frame28=p2 = 0.2 * sin(80 * sample);
shape_3_per_frame29=x = 0.5 + my_x * p1;
shape_3_per_frame30=y = 0.5 + my_y * p2;
shape_3_per_frame31=r = 0.4 * sin(80 * sample);
shape_3_per_frame32=b = 0.8 * sin(66 * sample);
shape_3_per_frame33=g = 0.6 * sin(120 * sample);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (texsize.zw * 4.0);
  vec2 tmpvar_3;
  tmpvar_3.x = ((2.0 * (
    (texture (sampler_blur1, (uv + (vec2(1.0, 0.0) * tmpvar_2))).xyz * scale1)
   + bias1)) - (2.0 * (
    (texture (sampler_blur1, (uv - (vec2(1.0, 0.0) * tmpvar_2))).xyz * scale1)
   + bias1))).x;
  tmpvar_3.y = ((2.0 * (
    (texture (sampler_blur1, (uv + (vec2(0.0, 1.0) * tmpvar_2))).xyz * scale1)
   + bias1)) - (2.0 * (
    (texture (sampler_blur1, (uv - (vec2(0.0, 1.0) * tmpvar_2))).xyz * scale1)
   + bias1))).x;
  vec2 tmpvar_4;
  tmpvar_4 = (-(tmpvar_3) * texsize.zw);
  ret_1.yz = vec2(0.0, 0.0);
  ret_1.x = (texture (sampler_fw_main, (uv - tmpvar_4)).x - ((
    (texture (sampler_blur3, uv).xyz * scale3)
   + bias3).x - (
    (texture (sampler_blur1, (uv + tmpvar_4)).xyz * scale1)
   + bias1).x));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (vec3((tmpvar_2.x * (1.0 - 
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
  .x))) - (roam_sin.wzy * roam_cos.zxy));
  ret_1 = (ret_1 + ((
    (1.0 - tmpvar_2.x)
   * 
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  .x) * vec3(2.0, 1.2, 0.0)));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
