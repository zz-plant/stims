per_frame_init_18=x1 = 0;
per_frame_init_19=y1 = 0;
per_frame_1=vvb = if(0.00001 < abs(below(vvb, 0)), 0, vvb);
per_frame_2=vvm = if(0.00001 < abs(below(vvm, 0)), 0, vvm);
per_frame_3=vvt = if(0.00001 < abs(below(vvt, 0)), 0, vvt);
per_frame_4=vvb = if(0.00001 < abs(above(vvb, 1)), 1, vvb);
per_frame_5=vvm = if(0.00001 < abs(above(vvm, 1)), 1, vvm);
per_frame_6=vvt = if(0.00001 < abs(above(vvt, 1)), 1, vvt);
per_frame_7=vb = 0.85 * vb + (1 - vb) * pow(bass, 2) * 0.01;
per_frame_8=vvb = 0.95 * vvb + (1 - vvb) * vb * 0.2;
per_frame_9=vm = 0.85 * vm + (1 - vm) * pow(mid, 2) * 0.01;
per_frame_10=vvm = 0.95 * vvm + (1 - vvm) * vm * 0.2;
per_frame_11=vt = 0.85 * vt + (1 - vt) * pow(treb, 2) * 0.01;
per_frame_12=vvt = 0.95 * vvt + (1 - vvt) * vt * 0.2;
per_frame_13=q1 = vvb;
per_frame_14=q2 = vvm;
per_frame_15=q3 = vvt;
per_frame_16=v = 0.2 * (60 / fps);
per_frame_17=d = 0.35 * v;
per_frame_18=bb = bb + vvb * v - d;
per_frame_19=mm = mm + vvm * v - d;
per_frame_20=tt = tt + vvt * v - d;
per_frame_21=q6 = bb;
per_frame_22=q5 = mm;
per_frame_23=q4 = tt;
per_frame_24=zoom = 0.995;
