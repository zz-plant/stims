per_frame_init_1=redsine = 0;
per_frame_init_2=bluesine = 0;
per_frame_init_3=greenif = 0;
per_frame_init_4=q5 = 0;
per_frame_init_5=q4 = 0;
per_frame_init_6=redif = 0;
per_frame_init_7=blueif = 0;
per_frame_init_8=vol = 0;
per_frame_init_9=greensine = 0;
per_frame_init_10=decay = 0.1;
per_frame_1=sx = 1;
per_frame_2=sy = 1;
per_frame_3=vol = 0.3333 * (bass + mid + treb_att);
per_frame_4=redsine = 0.5 + 0.15 * bass * sin(3 * time);
per_frame_5=greensine = 0.5 + 0.15 * mid * sin(2 * time);
per_frame_6=bluesine = 0.5 + 0.15 * treb * sin(time);
per_frame_7=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.85 * redif));
per_frame_8=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.85 * greenif));
per_frame_9=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.85 * blueif));
per_frame_10=q4 = 0.5 + 0.05 * sin(0.52 * time) * cos(0.39 * time);
per_frame_11=q5 = 0.5 + 0.05 * sin(0.44 * time) * cos(0.71 * time);
per_pixel_1=zoom = zoom + 0.015 * rad + 0.015 * treb_att * rad;
per_pixel_2=sy = sy + 0.1 * cos(sin(0.05 * y + time) - 0.5 * sin(20 * x + time) * treb_att);
per_pixel_3=sx = sx + 0.1 * sin(cos(70 * x + time) + 0.5 * cos(20 * y + time) * treb_att);

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 uv6_2;
  vec2 tmpvar_3;
  tmpvar_3 = ((uv - 0.5) * aspect.xy);
  float x_4;
  x_4 = (tmpvar_3.x * tmpvar_3.y);
  float tmpvar_5;
  tmpvar_5 = ((q10 * 24.0) * sqrt((x_4 * x_4)));
  uv_1 = (uv + (vec2(0.0, 0.01) * dot (
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  , vec3(0.32, 0.49, 0.29))));
  uv_1 = (uv_1 - (clamp (
    ((sin(tmpvar_5) / cos(tmpvar_5)) * normalize(tmpvar_3))
  , vec2(-2.0, -2.0), vec2(2.0, 2.0)) / 200.0));
  uv6_2 = (0.4 * sin((
    (uv_1 * 6.0)
   + 
    (rand_frame * 16.0)
  .xy)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((
    (texture (sampler_main, uv_1).xyz - (((texture (sampler_blur2, 
      fract(uv_1)
    ).xyz * scale2) + bias2) * 0.02))
   + 
    (0.1 * (vec3((0.1 / sqrt(
      dot (uv6_2, uv6_2)
    ))) * (0.5 * (1.0 + roam_cos)).xyz))
  ) * 0.99) - 0.025);
  ret = tmpvar_6.xyz;
 }
