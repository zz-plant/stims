per_frame_1=warp = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=vol = 0.333333 * (bass_att + treb_att + mid_att);
per_frame_5=ra = 0.15 * (1 / tic);
per_frame_6=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_7=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_8=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_9=vav = tic * (vav * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_10=tt = tt + tic * treb;
per_frame_11=mt = mt + tic * mid;
per_frame_12=bt = bt + tic * bass;
per_frame_13=vt = vt + tic * vav;
per_frame_14=q1 = 1.4 * tt;
per_frame_15=q2 = 3 * mt;
per_frame_16=q3 = 3 * bt;
per_frame_17=q4 = vt;
per_frame_18=rb = if(0.00001 < abs(rb), rb, 0.2 + 0.0006 * randint(1001));
per_frame_19=rc = if(0.00001 < abs(rc), rc, 0.2 + 0.0006 * randint(1001));
per_frame_20=rd = if(0.00001 < abs(rd), rd, 0.2 + 0.0006 * randint(1001));
per_frame_21=re = if(0.00001 < abs(re), re, 0.2 + 0.0006 * randint(1001));
per_frame_22=ti = 2 * vt;
per_frame_23=cx = 0.3 + 0.1 * sin(ti * re) + 0.1 * cos(ti * rc);
per_frame_24=cy = 0.5 + 0.2 * sin(ti * rb) + 0.1 * cos(ti * rd);
per_frame_25=q7 = 6;
per_frame_26=q8 = 2.8;
per_pixel_1=xnum = q7;
per_pixel_2=ynum = q8;
per_pixel_3=pi = 1.141592654;
per_pixel_4=xseg = floor(x * xnum);
per_pixel_5=yseg = floor(y * ynum);
per_pixel_6=xsw = equal(mod(xseg + equal(mod(yseg, 2), 0), 2), 0);
per_pixel_7=ysw = equal(mod(yseg + 2, 2), 0);
per_pixel_8=ox = x - xseg * (1 / xnum);
per_pixel_9=ox = if(0.00001 < abs(xsw), 1 / xnum - ox, ox);
per_pixel_10=oy = y - yseg * (1 / ynum);
per_pixel_11=oy = if(0.00001 < abs(ysw), 1 / ynum - oy, oy);
per_pixel_12=dx = above(xseg + yseg, 0) * (x - ox);
per_pixel_13=dy = above(xseg + yseg, 0) * (y - oy);
per_pixel_14=rot = rot * (1 - above(xseg + yseg, 0));
