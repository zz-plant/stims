wave_3_init17=zq = 0;
wave_3_init18=phs = 0;
wave_3_init19=t7 = 0;
wave_3_init20=ang = 0;
wave_3_init21=sinang = 0;
wave_3_init22=tm = 0;
wave_3_init23=t2 = 0;
wave_3_init24=zp = 0;
wave_3_init25=t4 = 0;
wave_3_init26=q8 = 0;
wave_3_init27=t7 = 1;
wave_3_per_frame1=t1 = 0.5 * sin(time) + 0.5;
wave_3_per_frame2=t2 = 0.5 * sin(time + 2.1) + 0.5;
wave_3_per_frame3=t3 = 0.5 * sin(time + 4.2) + 0.5;
wave_3_per_frame4=t4 = 0.5 * sin(time + 1.1) + 0.5;
wave_3_per_frame5=t5 = 0.5 * sin(time + 3.1) + 0.5;
wave_3_per_frame6=t6 = 0.5 * sin(time + 5.2) + 0.5;
wave_3_per_frame7=t8 = floor(2 * sin(2 * time) + 3);
wave_3_per_frame8=t8 = 2;
wave_3_per_point1=n = 6.283 * sample;
wave_3_per_point2=phs = 0.2 * -sample;
wave_3_per_point3=tm = q1 + phs;
wave_3_per_point4=flip = flip + 0.5 * t7;
wave_3_per_point5=t7 = if(0.00001 < abs(equal(flip, 1) + equal(flip, 0)), -t7, t7);
wave_3_per_point6=tm = if(0.00001 < abs(equal(flip, 0.5)), tm + 0.02 * q8, tm);
wave_3_per_point7=xp = 0;
wave_3_per_point8=yp = 0.1 * flip + 0.2 * (0.5 * sin(tm) + 0.5) + 0.1;
wave_3_per_point9=yp = -yp;
wave_3_per_point10=zp = 0;
wave_3_per_point11=ang = 0.5 * sin(2 * tm) + 0.5;
wave_3_per_point12=sinang = sin(ang);
wave_3_per_point13=cosang = cos(ang);
wave_3_per_point14=xq = xp;
wave_3_per_point15=yq = yp * sinang + zp * cosang;
wave_3_per_point16=zq = yp * cosang - zp * sinang;
wave_3_per_point17=yq = yp;
wave_3_per_point18=zq = zp;
wave_3_per_point19=ang = 8 * tm + 1;
wave_3_per_point20=sinang = sin(ang);
wave_3_per_point21=cosang = cos(ang);
wave_3_per_point22=xp = xq * sinang + yq * cosang;
wave_3_per_point23=yp = xq * cosang - yq * sinang;
wave_3_per_point24=zp = zq;
wave_3_per_point25=zp = zp - 0.3;
wave_3_per_point26=ang = 3.14 + 1.5 * sin(2 * tm - 0.5);
wave_3_per_point27=sinang = sin(ang);
wave_3_per_point28=cosang = cos(ang);
wave_3_per_point29=xq = xp;
wave_3_per_point30=yq = yp * sinang + zp * cosang;
wave_3_per_point31=zq = yp * cosang - zp * sinang;
wave_3_per_point32=ang = -1 + cos(3.1 * tm + 0.5);
wave_3_per_point33=sinang = sin(ang);
wave_3_per_point34=cosang = cos(ang);
wave_3_per_point35=xp = xq * sinang + yq * cosang;
wave_3_per_point36=yp = xq * cosang - yq * sinang;
wave_3_per_point37=zp = zq;
wave_3_per_point38=zp = zp - 0.35;
wave_3_per_point39=ang = 1.75 * cos(2.3 * tm) - 1.05;
wave_3_per_point40=sinang = sin(ang);
wave_3_per_point41=cosang = cos(ang);
wave_3_per_point42=xq = xp * sinang + zp * cosang;
wave_3_per_point43=yq = yp;
wave_3_per_point44=zq = xp * cosang - zp * sinang;
wave_3_per_point45=ang = 0.5 * cos(tm) - 0.5;
wave_3_per_point46=sinang = sin(ang);
wave_3_per_point47=cosang = cos(ang);
wave_3_per_point48=xp = xq;
wave_3_per_point49=yp = yq * cosang - zq * sinang;
wave_3_per_point50=zp = yq * sinang + zq * cosang;
wave_3_per_point51=zp = zp + 2;
wave_3_per_point52=xs = xp / zp;
wave_3_per_point53=ys = yp / zp;
wave_3_per_point54=x = xs + 0.5;
wave_3_per_point55=y = 1.3 * ys + 0.5;
wave_3_per_point56=a = if(0.00001 < abs(equal(q8, 1)), 1 - sample, sample);
wave_3_per_point57=a = a * above(sin(128 * tm * t8), 0);
wave_3_per_point58=a = a * (1 - abs(flip - 0.5));
wave_3_per_point59=mag = 1 - 2 * abs(flip - 0.5) + 1;
wave_3_per_point60=r = min(t4 * mag, 1);
wave_3_per_point61=g = min(t5 * mag, 1);
wave_3_per_point62=b = min(t6 * mag, 1);

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 0.85);
  ret_1 = (ret_1 - 0.022);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2.xy = uv;
  tmpvar_2.z = q2;
  vec2 tmpvar_3;
  vec2 tmpvar_4;
  tmpvar_4 = (uv - 0.5);
  tmpvar_3 = ((tmpvar_4 * vec2(-1.0, 1.0)) + 0.5);
  ret_1 = (((
    (mix (texture (sampler_main, ((tmpvar_4 * 0.98) + 0.5)).xyz, texture (sampler_main, ((
      (tmpvar_3 - 0.5)
     * 0.98) + 0.5)).xyz, vec3(0.2, 0.2, 0.2)) + ((texture (sampler_blur3, uv).xyz * scale3) + bias3))
   + 
    ((texture (sampler_blur3, tmpvar_3).xyz * scale3) + bias3)
  ) + (
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1)) + ((texture (sampler_blur1, tmpvar_3).xyz * scale1) + bias1));
  ret_1 = (ret_1 * texture (sampler_noisevol_hq, tmpvar_2).xyz);
  ret_1 = (ret_1 * 2.0);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }
