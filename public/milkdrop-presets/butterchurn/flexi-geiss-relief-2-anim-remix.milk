per_frame_init_50=x4 = 0.5;
per_frame_init_51=y4 = 0.5;
per_frame_1=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_2=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_3=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_4=x1 = 0.5 + 2 * (xx1 - xx2);
per_frame_5=y1 = 0.4 + yy1;
per_frame_6=x1 = max(0, min(1, x1));
per_frame_7=y1 = max(0, min(1, y1));
per_frame_8=spring = 10;
per_frame_9=grav = 0.5;
per_frame_10=resist = 1;
per_frame_11=bounce = 0.75;
per_frame_12=dt = 0.0002 * (60 / fps);
per_frame_13=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_14=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_15=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_16=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_17=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_18=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_19=x2 = x2 + vx2;
per_frame_20=y2 = y2 + vy2;
per_frame_21=x3 = x3 + vx3;
per_frame_22=y3 = y3 + vy3;
per_frame_23=x4 = x4 + vx4;
per_frame_24=y4 = y4 + vy4;
per_frame_25=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_26=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_27=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_28=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_29=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_30=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_31=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_32=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_33=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_34=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_35=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_36=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_37=q4 = x4;
per_frame_38=q8 = y4;
per_frame_39=q1 = aspectx;
per_frame_40=q2 = aspecty;
per_frame_41=zoom = 1;
per_frame_42=warp = 0;
per_frame_43=bb = 0.99 * bb + 0.02 * bass;
per_frame_44=mm = 0.99 * mm + 0.02 * mid;
per_frame_45=tt = 0.99 * tt + 0.02 * treb;
per_frame_46=mx = max(max(bb, mm), tt);
per_frame_47=mn = min(min(bb, mm), tt);
per_frame_48=ob_r = (bb - mn) / (mx - mn);
per_frame_49=ob_b = (mm - mn) / (mx - mn);
per_frame_50=ob_g = (tt - mn) / (mx - mn);
per_frame_51=q6 = atan2(vx4, vy4);
per_frame_52=q5 = sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_53=a = 0.95 * a + q5;
per_frame_54=s = 0.9 * s + a;
per_frame_55=q3 = 0.1 * s;
per_frame_56=monitor = s;
per_frame_57=wave_a = 0;
per_pixel_1=x = 0.5 + (x - 0.5) * q1;
per_pixel_2=y = 0.5 + (y - 0.5) * q2;
per_pixel_3=xx = q4;
per_pixel_4=yy = 1 - q8;
per_pixel_5=dx = 0;
per_pixel_6=dy = 0;
per_pixel_7=d = sqrt((x - xx) * (x - xx) + (y - yy) * (y - yy));
per_pixel_8=r = 0.11;
per_pixel_9=v = 20;
per_pixel_10=v2 = q5;
per_pixel_11=dx = (v * (sin(y - yy) * (d - r) - (x - xx) * (d - r / 2)) + cos(dir) * v2) * (1 - sigmoid(d - r, 100));
per_pixel_12=dy = (-v * (sin(x - xx) * (d - r) + (y - yy) * (d - r / 2)) - sin(dir) * v2) * (1 - sigmoid(d - r, 100));

[warp_shader]
shader_body { 
  vec2 d_1;
  vec3 ret_2;
  d_1.x = cos(((uv.y * 13.32) + time));
  d_1.y = cos(((uv.x * 11.32) - (time * 0.31)));
  ret_2.y = texture (sampler_fc_main, (uv + (d_1 * 0.01))).y;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (texsize.zw * 4.0);
  vec3 tmpvar_2;
  tmpvar_2 = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1));
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_4;
  tmpvar_4.x = tmpvar_2.y;
  tmpvar_4.y = tmpvar_3.y;
  vec2 x_5;
  x_5 = ((uv + (tmpvar_4 * 2.0)) - vec2(0.5, 0.5));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (vec3(((
    ((tmpvar_2 - (tmpvar_3 * 0.2)) * 0.8)
   + 0.5).y * 0.3)) + (vec3((1.04 - 
    pow (sqrt(dot (x_5, x_5)), 0.25)
  )) * 0.5));
  ret = tmpvar_6.xyz;
 }
