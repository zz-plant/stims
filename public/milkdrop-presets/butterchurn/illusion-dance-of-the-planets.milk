per_frame_init_1=q1 = 0;
per_frame_init_2=q2 = 0;
per_frame_init_3=dx_residual = 0;
per_frame_init_4=dy_residual = 0;
per_frame_init_5=bass_thresh = 0;
per_frame_1=rot = rot + 0.03 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.479 * time));
per_frame_2=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_3=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_4=zoom = zoom + 0.05 + 0.05 * sin(0.133 * time);
per_frame_5=decay = decay - 0.01 * mod(frame, 2);
per_frame_6=dx = dx + dx_residual;
per_frame_7=dy = dy + dy_residual;
per_frame_8=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_9=dx_residual = 0.016 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * dx_residual;
per_frame_10=dy_residual = 0.012 * equal(bass_thresh, 2) * sin(9 * time) + (1 - equal(bass_thresh, 2)) * dy_residual;
per_frame_11=q1 = dx_residual;
per_frame_12=q2 = dy_residual;
per_frame_13=wave_r = 0.444 * sin(0.118 * time);
per_frame_14=wave_g = 0.901 * sin(0.568 * time);
per_frame_15=wave_b = 0.111 * sin(0.972 * time);
per_frame_16=ib_r = wave_g + 0.189 * sin(0.111 * time);
per_frame_17=ib_g = sin(wave_g / 2);
per_frame_18=ib_b = 0.345 * sin(0.888 * time);
per_frame_19=ib_size = 0.065 + 0.014 * bass;
per_pixel_1=zoom = 1 - zoom * rad * sin(time) * (q1 + q2) * cos(20 * rad * sin(0.5 * time)) * 10;
