[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.995000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=3.000000
nWaveMode=5.000000
fWaveAlpha=100.000000
fWaveScale=0.721000
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fWarpAnimSpeed=0.028000
fWarpScale=0.905000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=rg2 = 0;
per_frame_init_2=pfdx_r = 0;
per_frame_init_3=pfthresh = 0;
per_frame_init_4=thresh = 0;
per_frame_init_5=wx = 0;
per_frame_init_6=dy_r = 0;
per_frame_init_7=rg3 = 0;
per_frame_init_8=pfdy_r = 0;
per_frame_init_9=rg1 = 0;
per_frame_init_10=wy = 0;
per_frame_init_11=dx_r = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_6=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_7=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_8=rg1 = abs(sin(time));
per_frame_9=rg2 = -1 * above(rg1, 0.75) - 0.66 * below(rg1, 0.25) - 0.33 * above(rg1, 0.25) * below(rg1, 0.5) - 0 * above(rg1, 0.5) * below(rg1, 0.75);
per_frame_10=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_11=ob_r = 1 - abs(wave_r);
per_frame_12=ob_b = 1 - abs(wave_b);
per_frame_13=ob_g = 1 - abs(wave_g);
per_frame_14=echo_alpha = echo_alpha - rg3;
per_frame_15=echo_zoom = echo_zoom + sin(bass_att);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=wx = 0.2 * cos(time) * x;
per_pixel_5=wy = 0.2 * sin(1.2 * time) * y;
per_pixel_6=rot = rot + dx_r * abs(4 * dy_r - treb_att - thresh);
per_pixel_7=zoom = zoom + 0.05 * sin(4 - 64 * cos(0.5 - rad * cos(tan(14 * dx_r * bass_att)) * cos(1.12 * time) * rad * 14 * rad) * dx_r);
per_pixel_8=rot = rot + dx_r;
per_pixel_9=rot = rot + dy_r;
per_pixel_10=dx = dx + 1.1 * dx_r;
per_pixel_11=dy = dy + 1.1 * dy_r;
per_pixel_12=rot = rot + 1.2 * above(bass_att, 1.25) * tan(cos(time));
per_pixel_13=warp = warp + 12 * above(bass_att, 1.3);
per_pixel_14=zoom = zoom - 1.2 * above(bass_att, 1.2) * cos(2 - abs(2 * rad - time)) * wx * rad;

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0) * 7.0));
  vec3 tmpvar_2;
  tmpvar_2 = fract((ret_1 - (
    (clamp (((vol / vol_att) - 1.1), 0.0, 1.0) * 0.5)
   + 0.004)));
  ret_1 = tmpvar_2;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = tmpvar_2;
  ret = tmpvar_3.xyz;
 }
