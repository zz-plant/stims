[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=0.977000
fVideoEchoZoom=1.006596
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
nWaveMode=5.000000
bAdditiveWaves=1.000000
bWaveDots=1.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
fWaveAlpha=1.193337
fWaveScale=1.000291
fWaveSmoothing=0.900000
fModWaveAlphaStart=0.730000
fModWaveAlphaEnd=1.070000
fWarpScale=2.853000
fZoomExponent=0.999835
fZoom=0.999682
fWarp=0.000000
fWaveG=0.800000
fWaveB=0.200000
fOuterBorderSize=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.1 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.1 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=mv_r = wave_r;
per_frame_5=mv_b = wave_b;
per_frame_6=mv_g = wave_g;
per_frame_7=q1 = 0.05 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_8=mv_a = if(0.00001 < abs(above(bass - 1.2, 1)), 1, bass - 1.2);
per_pixel_1=zoom = 1.01 + 0.15 * rad * q1;

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 1.333);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
