per_frame_1=dec_med = pow(0.7, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.3 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 16);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 2);
per_frame_10=q20 = avg;
per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q24 = is_beat;
per_frame_14=q26 = bass_att + mid_att + treb_att;
per_frame_15=q27 = index + 1;
per_frame_16=q28 = index2;
per_frame_17=k1 = is_beat * equal(mod(index, 2), 0);
per_frame_18=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_19=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_20=rott = 3.1416 * p2 / 8;
per_frame_21=q1 = cos(rott);
per_frame_22=q2 = sin(rott);
per_frame_23=q3 = -q2;
per_frame_24=q4 = q1;
per_frame_25=step = step + q24;
per_frame_26=p3 = p3 * dec_slow + (1 - dec_slow) * step;
per_frame_27=q30 = step;
per_frame_28=p4 = dec_slow * p4 + (1 - dec_slow) * q27;
per_frame_29=q31 = p4;
per_frame_30=q12 = time - t0;
per_frame_31=monitor = q12;
per_frame_32=zoom = 1.2 + 0.2 * q1;
per_frame_33=rot = -0;
per_frame_34=dx = 0;

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 uv6_2;
  vec2 tmpvar_3;
  tmpvar_3 = ((uv - 0.5) * aspect.xy);
  float tmpvar_4;
  tmpvar_4 = ((2.0 * sqrt(
    dot (tmpvar_3, tmpvar_3)
  )) + (rand_frame * 64.0)).x;
  uv_1 = (uv + (clamp (
    ((sin(tmpvar_4) / cos(tmpvar_4)) * normalize(tmpvar_3))
  , vec2(-2.0, -2.0), vec2(2.0, 2.0)) / 20.0));
  uv6_2 = (0.4 * sin((tmpvar_3 * 22.0)));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = (((q24 * 
    (((texture (sampler_main, uv_1).xyz - (
      ((texture (sampler_blur1, fract(uv_1)).xyz * scale1) + bias1)
     * 0.04)) + (0.15 * (vec3(
      (0.1 / sqrt(dot (uv6_2, uv6_2)))
    ) * roam_cos.xyz))) - 0.02)
  ) * 0.98) + ((1.0 - q24) * texture (sampler_main, uv_orig).xyz));
  ret = tmpvar_5.xyz;
 }

[comp_shader]
vec3 xlat_mutablenoise;
vec3 xlat_mutableret1;
vec2 xlat_mutablers;
 shader_body { 
  float z_1;
  vec2 tmpvar_2;
  tmpvar_2 = ((uv - 0.5) * aspect.xy);
  float tmpvar_3;
  tmpvar_3 = (0.5 / abs(tmpvar_2.y));
  xlat_mutablers.x = (tmpvar_2.x * tmpvar_3);
  xlat_mutablers.y = (tmpvar_3 + (time * 6.0));
  vec4 tmpvar_4;
  tmpvar_4 = texture (sampler_pw_noise_lq, (xlat_mutablers / 128.0));
  xlat_mutablenoise = (tmpvar_4.xyz * vec3(greaterThanEqual (tmpvar_4.xyz, vec3(0.9, 0.9, 0.9))));
  xlat_mutableret1 = xlat_mutablenoise;
  z_1 = (0.5 / abs(tmpvar_2.x));
  xlat_mutablers.y = (tmpvar_2.y * z_1);
  xlat_mutablers.x = (z_1 + (time * 2.0));
  vec4 tmpvar_5;
  tmpvar_5 = texture (sampler_pw_noise_lq, (xlat_mutablers / 128.0));
  xlat_mutablenoise = (tmpvar_5.xyz * vec3(greaterThanEqual (tmpvar_5.xyz, vec3(0.9, 0.9, 0.9))));
  xlat_mutableret1 = (xlat_mutableret1 + xlat_mutablenoise);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((texture (sampler_main, 
    ((uv * 4.0) + (xlat_mutableret1 * 0.1).xy)
  ).xyz * 
    clamp ((1.0 - (2.0 * rad)), 0.0, 1.0)
  ) * (1.0 + q22)) + (texture (sampler_main, (uv + xlat_mutableret1.xy)).xyz * rad));
  ret = tmpvar_6.xyz;
 }
