per_pixel_1=ring = 2 * sin(3.14 * rad + 0.3) - 1;
per_pixel_2=ring = max(ring, 0);
per_pixel_3=ring = ring * ring;
per_pixel_4=zoom = 1 + 0.04 * rad;
per_pixel_5=sx = 1 + 0.3 * ring;
per_pixel_6=sy = 1 - 0.3 * ring;
