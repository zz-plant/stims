wave_0_per_frame2=t2 = 0.5;
wave_0_per_frame3=scalar = 5 * sin(0.3 * time);
wave_0_per_frame4=t3 = scalar;
wave_0_per_point1=x = t1;
wave_0_per_point2=y = t2;
wave_0_per_point3=n = 6.283 * sample;
wave_0_per_point4=timea = 0.3 * time + t3;
wave_0_per_point5=timeb = 0.1 * time + t3;
wave_0_per_point6=xm = sin(3 * n) * sin(5.7 * n + timeb) * sin(11.5 * n + timea) * sin(31 * n);
wave_0_per_point7=ym = sin(3.5 * n) * sin(1.1 * n) * sin(23 * n + timea) * sin(13.3 * n + timeb);
wave_0_per_point8=x = x + 0.1 * xm;
wave_0_per_point9=y = y + 0.1 * ym;
wave_0_per_point10=t1 = x;
wave_0_per_point11=t2 = y;
wave_0_per_point12=r = 0.5 * tan(n) + 0.5;
wave_0_per_point13=r = min(r, 1) * above(r, 0);
wave_0_per_point14=g = 0.5 * tan(n + 2.1) + 0.5;
wave_0_per_point15=g = min(g, 1) * above(g, 0);
wave_0_per_point16=b = 0.5 * tan(n + 4.2) + 0.5;
wave_0_per_point17=b = min(b, 1) * above(b, 0);
shape_0_per_frame1=ang = 0.01 * sin(0.3 * time);

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = ((uv * texsize.xy) * 0.08);
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_main, (uv - (
    ((sin(tmpvar_1) / cos(tmpvar_1)) * texsize.zw)
   * 3.0))).xyz + (vec3(dot (texture (sampler_noise_lq, 
    ((((texsize.xy * texsize_noise_lq.zw).x * uv) * 0.02) + (0.1 * rand_frame).xy)
  ), vec4(0.32, 0.49, 0.29, 0.0))) / 30.0));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ((mix (tmpvar_2, 
    (1.0 - tmpvar_2.zyx)
  , vec3(0.01, 0.01, 0.01)) - 0.03) - (0.2 * pow (
    (1.0 - rad)
  , 18.0)));
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = rad;
  tmpvar_2.y = uv.y;
  ret_1 = (texture (sampler_main, tmpvar_2).xyz + ((texture (sampler_blur1, tmpvar_2).xyz * scale1) + bias1));
  vec3 tmpvar_3;
  tmpvar_3.x = (bass * 0.4);
  tmpvar_3.y = (treb * 0.4);
  tmpvar_3.z = (mid * 0.4);
  ret_1 = (ret_1 * (tmpvar_3 * 0.95));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }
