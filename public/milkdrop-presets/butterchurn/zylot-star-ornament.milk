per_frame_init_16=yspeed = 0;
per_frame_1=warp = 0;
per_frame_2=decay = 0.92;
per_frame_3=vol = (bass + mid + att) / 6;
per_frame_4=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_5=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_6=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_7=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_8=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_9=xpos = xpos + 0.001 * xspeed;
per_frame_10=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_11=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_12=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_13=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_14=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_15=ypos = ypos + 0.001 * yspeed;
per_frame_16=q1 = ypos;
per_frame_17=q2 = xpos;
per_pixel_1=zoom = zoom + q1 * q2 * 2;
per_pixel_2=rot = 10 + rad * treb * 0.1;
shape_0_init1=angle = 0;
shape_0_init2=bassspin = 0;
shape_0_init3=q1 = 0;
shape_0_init4=q2 = 0;
shape_0_init5=bassspin = 0;
shape_0_init6=angle = 0;
shape_0_per_frame1=ang = angle;
shape_0_per_frame2=bassspin = if(0.00001 < abs(above(0.05 * bass, bassspin)), bassspin + 0.001, bassspin - 0.001);
shape_0_per_frame3=bassspin = bassspin * above(bassspin, 0);
shape_0_per_frame4=angle = angle + bassspin;
shape_0_per_frame5=r = 0.3 * bass;
shape_0_per_frame6=g = 0.3 * treb;
shape_0_per_frame7=b = 0.3 * mid;
shape_0_per_frame8=r2 = 0.8 + 0.2 * sin(1.2 * time);
shape_0_per_frame9=g2 = 0.8 + 0.2 * sin(0.9777 * time);
shape_0_per_frame10=b2 = 0.8 + 0.2 * sin(0.7005 * time);
shape_0_per_frame11=border_a = 1 * above(bass + treb + mid, 5);
shape_0_per_frame12=x = 0.5 + q1;
shape_0_per_frame13=y = 0.5 + q2;
