per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=redsine = 0;
per_frame_init_4=bass_flop = 0;
per_frame_init_5=bluesine = 0;
per_frame_init_6=q6 = 0;
per_frame_init_7=greenif = 0;
per_frame_init_8=q1 = 0;
per_frame_init_9=q5 = 0;
per_frame_init_10=treb_flop = 0;
per_frame_init_11=q9 = 0;
per_frame_init_12=bass_thresh = 0;
per_frame_init_13=old_bass_flop = 0;
per_frame_init_14=treb_thresh = 0;
per_frame_init_15=pulse = 0;
per_frame_init_16=q11 = 0;
per_frame_init_17=q10 = 0;
per_frame_init_18=bass_changed = 0;
per_frame_init_19=mid_thresh = 0;
per_frame_init_20=q4 = 0;
per_frame_init_21=mid_changed = 0;
per_frame_init_22=entropy = 0;
per_frame_init_23=redif = 0;
per_frame_init_24=blueif = 0;
per_frame_init_25=old_mid_flop = 0;
per_frame_init_26=mid_residual = 0;
per_frame_init_27=b = 0;
per_frame_init_28=r = 0;
per_frame_init_29=xv = 0;
per_frame_init_30=g = 0;
per_frame_init_31=treb_residual = 0;
per_frame_init_32=vol = 0;
per_frame_init_33=chaos = 0;
per_frame_init_34=greensine = 0;
per_frame_init_35=mid_flop = 0;
per_frame_init_36=q2 = 0;
per_frame_init_37=treb_changed = 0;
per_frame_init_38=q3 = 0;
per_frame_init_39=q7 = 0;
per_frame_init_40=yv = 0;
per_frame_init_41=q8 = 0;
per_frame_1=old_bass_flop = bass_flop;
per_frame_2=old_treb_flop = treb_flop;
per_frame_3=old_mid_flop = mid_flop;
per_frame_4=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_5=entropy = if(0.00001 < abs(equal(pulse, -20)), 1 + bass_flop + treb_flop + mid_flop + randint(2), entropy);
per_frame_6=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_7=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_8=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_9=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_10=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_11=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_12=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_13=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_14=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_15=bass_residual = bass_changed * sin(0.1 * pulse * entropy) + bnot(bass_changed) * bass_residual;
per_frame_16=treb_residual = treb_changed * sin(0.1 * pulse * entropy) + bnot(treb_changed) * treb_residual;
per_frame_17=mid_residual = mid_changed * sin(0.1 * pulse * entropy) + bnot(mid_changed) * mid_residual;
per_frame_18=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.032 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_19=q1 = mid_residual;
per_frame_20=q2 = bass_residual;
per_frame_21=q3 = treb_residual;
per_frame_22=q4 = sin(pulse);
per_frame_23=q5 = cos(pulse / 2 + q1);
per_frame_24=q6 = sin(q3 * q1 + q7 * q2);
per_frame_25=q7 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_26=q8 = entropy;
per_frame_27=vol = 0.3333 * (bass + mid + treb_att);
per_frame_28=redsine = 0.5 + 0.15 * bass * sin(3 * time);
per_frame_29=greensine = 0.5 + 0.15 * mid * sin(2 * time);
per_frame_30=bluesine = 0.5 + 0.15 * treb * sin(time);
per_frame_31=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.95 * redif));
per_frame_32=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.95 * greenif));
per_frame_33=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.95 * blueif));
per_frame_34=r = redif;
per_frame_35=g = greenif;
per_frame_36=b = blueif;
per_frame_37=q9 = r;
per_frame_38=q10 = g;
per_frame_39=q11 = b;
per_frame_40=wave_r = wave_r * sin(redif * cos(b + g));
per_frame_41=wave_g = wave_g * sin(greenif * cos(r + b));
per_frame_42=wave_b = wave_b * sin(blueif * cos(r + g));
per_frame_43=ib_r = r;
per_frame_44=ib_g = g;
per_frame_45=ib_b = b;
per_frame_46=ob_r = wave_r * redif;
per_frame_47=ob_g = wave_g * greenif;
per_frame_48=ob_b = wave_b * blueif;
per_pixel_1=xv = sin(0.333 * time) * x - cos(0.667 * time) * x;
per_pixel_2=yv = cos(0.233 * time) * y + sin(0.567 * time) * y;
per_pixel_3=x = xv;
per_pixel_4=y = yv;
per_pixel_5=sx = sx + 0.075 * sin(3 * x + q7 * x);
per_pixel_6=sy = sy + 0.075 * sin(3.1 * y + q7 * y);
per_pixel_7=dx = dx + 0.005 * cos(20 * y + 0.1 * cos(0.11 * time) + q2 * q6);
per_pixel_8=dy = dy + 0.005 * sin(20 * x + 0.1 * sin(0.09 * time) + q3 * q6);
shape_0_per_frame1=x = x + 0.2 * sin(0.411 * time);
shape_0_per_frame2=y = y + 0.2 * cos(0.423 * time);
shape_1_per_frame1=x = x - 0.2 * sin(0.411 * time);
shape_1_per_frame2=y = y - 0.2 * cos(0.423 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uvv_1;
  vec2 uvm_2;
  uvm_2.x = ((0.5 * texture (sampler_noise_hq, uv.xx)) + (0.5 * texture (sampler_main, uv.xx))).x;
  uvm_2.y = ((0.5 * texture (sampler_main, uv.yy)) + (0.5 * texture (sampler_noise_hq, uv.yy))).x;
  uvv_1 = (uv * uvm_2);
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur1, uv).xyz * scale1) + bias1) - ((texture (sampler_blur3, texture (sampler_noise_hq, 
    ((texture (sampler_blur3, uvv_1).xyz * scale3) + bias3)
  .xy).xy).xyz * scale3) + bias3));
  vec2 tmpvar_4;
  tmpvar_4 = fract((tmpvar_3.xy + uvm_2));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ((2.0 * tmpvar_3) * texture (sampler_main, (tmpvar_4 * (uvv_1 - tmpvar_4))).xyz);
  ret = tmpvar_5.xyz;
 }
