per_frame_init_12=swapcolour = 0;
per_frame_init_13=green_aim = 0;
per_frame_1=q1 = (bass_att + mid_att + treb_att) / 3;
per_frame_2=q2 = time + 1000;
per_frame_3=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.95 * (bass_thresh - 1.4) + 1.4);
per_frame_4=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.85 * (treb_thresh - 1.5) + 1.2);
per_frame_5=bass_on = above(bass_thresh, 1.9);
per_frame_6=treb_on = above(treb_thresh, 1.9);
per_frame_7=swapcolour = bass_on - treb_on;
per_frame_8=red_aim = if(0.00001 < abs(equal(swapcolour, 1)), 1, if(0.00001 < abs(equal(swapcolour, 0)), 0.9, 0.7));
per_frame_9=green_aim = if(0.00001 < abs(equal(swapcolour, 1)), 0.7, if(0.00001 < abs(equal(swapcolour, 0)), 0.3, 0.6));
per_frame_10=blue_aim = if(0.00001 < abs(equal(swapcolour, 1)), 0, if(0.00001 < abs(equal(swapcolour, 0)), 0.2, 0.8));
per_frame_11=red = red + 0.5 * (red_aim - red);
per_frame_12=green = green + 0.5 * (green_aim - green);
per_frame_13=blue = blue + 0.5 * (blue_aim - blue);
per_frame_14=wave_r = red;
per_frame_15=wave_g = green;
per_frame_16=wave_b = blue;
per_pixel_1=dy = -0.1 * (q1 - 1) * log(2 - abs(2 * y - 1.8));
per_pixel_2=dy = below(dy, 0.02) * dy - 0.02;
per_pixel_3=dy = dy + 0.01 * (sin(x * q2 * 0.483 + y * q2 * 1.238) + sin(x * q2 * 1.612 + y * q2 * 0.648));
