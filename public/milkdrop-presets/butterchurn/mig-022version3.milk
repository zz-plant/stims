wave_0_per_frame1=adv = adv + bass * bass * 0.005;
wave_0_per_frame2=t1 = 0.3 * sin(adv);
wave_0_per_frame3=t2 = 0.3 * cos(adv);
wave_0_per_frame4=t3 = adv;
wave_0_per_point1=waver = 0.2 * sin(100.48 * sample);
wave_0_per_point2=xp = sin(6.28 * sample + waver);
wave_0_per_point3=yp = cos(6.28 * sample + waver);
wave_0_per_point4=scale = sin(18.84 * sample - 3 * t3);
wave_0_per_point5=scale2 = 0.5 * sin(6.28 * sample * 5 - 2.9 * t3) + 0.5;
wave_0_per_point6=xp = xp * scale * scale2;
wave_0_per_point7=yp = yp * scale * scale2;
wave_0_per_point8=x = 0.4 * xp * 0.7 + 0.5;
wave_0_per_point9=y = 0.35 * yp + 0.5;
wave_0_per_point10=rmod = 0.5 * sin(0.2 * time) + 0.5;
wave_0_per_point11=rmod = rmod * rmod;
wave_0_per_point12=gmod = 0.5 * sin(0.2 * time + 2.1) + 0.5;
wave_0_per_point13=gmod = gmod * gmod;
wave_0_per_point14=bmod = 0.5 * sin(0.2 * time + 4.2) + 0.5;
wave_0_per_point15=bmod = bmod * bmod;
wave_0_per_point16=r = rmod;
