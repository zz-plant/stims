per_frame_init_42=q20 = 0;
per_frame_init_43=q8 = 0;
per_frame_init_44=hksy = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=ob_r = 1 - abs(wave_r);
per_frame_6=ob_b = 1 - abs(wave_b);
per_frame_7=ob_g = 1 - abs(wave_g);
per_frame_8=a = 0.98 * a - 0.01 * (bass - treb);
per_frame_9=v = 0.96 * v + 0.12 * a;
per_frame_10=w = w + 0.01 * v;
per_frame_11=q15 = a - v;
per_frame_12=q18 = w;
per_frame_13=q19 = sigmoid(treb_att - bass_att, 2);
per_frame_14=d = d + 0.6 * (bass_att - 0.5) / fps;
per_frame_15=d2 = d2 + 0.36 * (treb_att - 0.5) / fps;
per_frame_16=q20 = d + d2;
per_frame_17=q21 = d2;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = 0.9 + 0.1 * sin(50 * x) / cos(50 * y);
per_pixel_5=rot = rot + dx_r;
per_pixel_6=rot = rot + dy_r;
per_pixel_7=dx = dx + 0.1 * dx_r;
per_pixel_8=dy = dy + 0.1 * dy_r;
per_pixel_9=rot = 0.1 * pow(-ang, 3) - 1.18 * sin(ang);
per_pixel_10=zoom = 2 * sin(-rad) + 1.3 + sin(rad);
per_pixel_11=dx = dx + 0.09 * sin(0.785 * q8);
per_pixel_12=dy = dy + 0.09 * sin(0.675 * q8);
per_pixel_13=zoom = zoom + q7;
per_pixel_14=zoom = zoom + 0.2 * 2.1 * cos(6 * bass_att * sin(2 * bass_att) * cos(4 * rad * bass + cos(9 * bass)) * 0.5 - rad) * (0.5 - rad);
per_pixel_15=zoom = zoom - 0.042 * tan(6 * mid_att * sin(2 * mid_att) * cos(4 * rad * treb + cos(9 * treb)) * 0.5 - rad) * (1.8 - rad);
per_pixel_16=hkdx = dx;
per_pixel_17=hkdy = dy;
per_pixel_18=hksx = sx;
per_pixel_19=hksy = sy;
per_pixel_20=hkrt = rot;
per_pixel_21=hkzm = zoom;
per_pixel_22=hkcx = cx;
per_pixel_23=hkcy = cy;
per_pixel_24=hkwp = warp;
per_pixel_25=dx = 0;
per_pixel_26=dy = 0;
per_pixel_27=sx = 1;
per_pixel_28=sy = 1;
per_pixel_29=rot = 0;
per_pixel_30=zoom = 1;
per_pixel_31=cx = 0.5;
per_pixel_32=cy = 0.5;
per_pixel_33=warp = 0;
per_pixel_34=rot = rot + 0.02 * if(0.00001 < abs(below(rad, 0.5 * bass)), 0.5 * abs(1 - rad) * sin(0.7 * bass), -0.5 * abs(1 - rad) * sin(0.7 * mid));
per_pixel_35=zoom = zoom - 0.00525 * abs((1 - rad) * sin(treb));
per_pixel_36=cr1 = floor(sin(2 * treb + 2 * mid + 2 * bass) / 2 + 0.5 + 0.999);
per_pixel_37=cr2 = cr1;
per_pixel_38=crx = cr2 - cr1;
per_pixel_39=ci = rad;
per_pixel_40=cb = 0.25;
per_pixel_41=crs = 2;
per_pixel_42=cr = pow(sin(6.3 * ci - 6.3 * cb) / 2 + 0.5, crs) * crx + cr1;
per_pixel_43=cqr = if(0.00001 < abs(above(ci, 0.25 + cb)), cr, crx + cr1);
per_pixel_44=crr = if(0.00001 < abs(below(ci, 1.5)), cqr, crx + cr1);
per_pixel_45=jx1 = crr;
per_pixel_46=kx1 = 1 - crr;
per_pixel_47=hjdx = dx;
per_pixel_48=hjdy = dy;
per_pixel_49=hjsx = sx;
per_pixel_50=hjsy = sy;
per_pixel_51=hjrt = rot;
per_pixel_52=hjzm = zoom;
per_pixel_53=hjcx = cx;
per_pixel_54=hjcy = cy;
per_pixel_55=hjwp = warp;
per_pixel_56=dx = jx1 * hjdx + kx1 * hkdx;
per_pixel_57=dy = jx1 * hjdy + kx1 * hkdy;
per_pixel_58=sx = jx1 * hjsx + kx1 * hksx;
per_pixel_59=sy = jx1 * hjsy + kx1 * hksy;
per_pixel_60=rot = jx1 * hjrt + kx1 * hkrt;
per_pixel_61=zoom = jx1 * hjzm + kx1 * hkzm;
per_pixel_62=cx = jx1 * hjcx + kx1 * hkcx;
per_pixel_63=cy = jx1 * hjcy + kx1 * hkcy;
per_pixel_64=warp = jx1 * hjwp + kx1 * hkwp;

[comp_shader]
vec2 xlat_mutablers;
 shader_body { 
  vec2 uv_1;
  uv_1 = (0.5 + ((uv - 0.5) * aspect.xy));
  xlat_mutablers.x = (((ang / 3.14) + (rad * q15)) - q18);
  vec2 x_2;
  x_2 = (uv_1 - 0.5);
  xlat_mutablers.y = ((0.1 / (0.05 + 
    (sqrt(dot (x_2, x_2)) * 1.4)
  )) + q21);
  vec2 tmpvar_3;
  tmpvar_3 = fract(xlat_mutablers);
  vec2 tmpvar_4;
  tmpvar_4.y = 0.0;
  tmpvar_4.x = texsize.z;
  vec2 tmpvar_5;
  tmpvar_5 = (tmpvar_4 * 4.0);
  vec2 tmpvar_6;
  tmpvar_6.x = 0.0;
  tmpvar_6.y = texsize.w;
  vec2 tmpvar_7;
  tmpvar_7 = (tmpvar_6 * 4.0);
  vec2 tmpvar_8;
  tmpvar_8.x = dot (((
    (texture (sampler_blur1, (tmpvar_3 - tmpvar_5)).xyz * scale1)
   + bias1) - (
    (texture (sampler_blur1, (tmpvar_3 + tmpvar_5)).xyz * scale1)
   + bias1)), vec3(0.32, 0.49, 0.29));
  tmpvar_8.y = dot (((
    (texture (sampler_blur1, (tmpvar_3 - tmpvar_7)).xyz * scale1)
   + bias1) - (
    (texture (sampler_blur1, (tmpvar_3 + tmpvar_7)).xyz * scale1)
   + bias1)), vec3(0.32, 0.49, 0.29));
  uv_1 = (cos((
    (12.56 * tmpvar_3)
   - 
    (vec2(0.0, 10.0) * q20)
  )) - (8.0 * tmpvar_8));
  vec3 tmpvar_9;
  tmpvar_9 = pow (((
    (2.0 * (clamp ((0.02 / 
      sqrt(dot (uv_1, uv_1))
    ), 0.0, 1.0) * hue_shader))
   * 
    ((texture (sampler_main, tmpvar_3).xyz * 5.0) + 1.0)
  ) - 0.04), vec3(0.5, 0.5, 0.5));
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = mix (tmpvar_9, tmpvar_9.zxy, vec3(q19));
  ret = tmpvar_10.xyz;
 }
