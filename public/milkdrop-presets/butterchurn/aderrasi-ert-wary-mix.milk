[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.990000
fVideoEchoZoom=0.334695
bMaximizeWaveColor=0.000000
fWaveAlpha=0.255374
fWaveScale=100.000000
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fZoomExponent=0.999997
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fOuterBorderSize=0.005000
fOuterBorderR=1.000000
fOuterBorderA=0.200000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=1.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=treb_tick = 0;
per_frame_init_2=bass_shift = 0;
per_frame_init_3=thresh = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=dy_r = 0;
per_frame_init_6=bass_tick = 0;
per_frame_init_7=mid_tick = 0;
per_frame_init_8=dx_r = 0;
per_frame_init_9=treb_shift = 0;
per_frame_init_10=r = 0;
per_frame_init_11=mid_shift = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=q3 = 0;
per_frame_1=bass_tick = 2 * above(bass_att, bass_tick) + (1 - above(bass_att, bass_tick)) * (0.96 * (bass_tick - 1.3) + 1.3);
per_frame_2=treb_tick = 2 * above(treb_att, treb_tick) + (1 - above(treb_att, treb_tick)) * (0.96 * (treb_tick - 1.3) + 1.3);
per_frame_3=mid_tick = 2 * above(mid_att, mid_tick) + (1 - above(mid_att, mid_tick)) * (0.96 * (mid_tick - 1.3) + 1.3);
per_frame_4=bass_shift = 0.95 * equal(bass_tick, 2) * sin(5 * time) + (1 - equal(bass_tick, 2)) * bass_shift;
per_frame_5=treb_shift = 0.95 * equal(treb_tick, 2) * sin(5 * time) + (1 - equal(treb_tick, 2)) * treb_shift;
per_frame_6=mid_shift = 0.95 * equal(mid_tick, 2) * sin(5 * time) + (1 - equal(mid_tick, 2)) * mid_shift;
per_frame_7=wave_r = wave_r + bass_shift;
per_frame_8=wave_g = wave_g + mid_shift;
per_frame_9=wave_b = wave_b + treb_shift;
per_frame_10=q1 = bass_shift;
per_frame_11=q2 = mid_shift;
per_frame_12=q3 = treb_shift;
per_frame_13=zoom = zoom + abs(0.05 * (treb / 2) * cos(bass_att * treb_shift) * bass_shift);
per_frame_14=ib_r = 1 - wave_r;
per_frame_15=ib_g = 1 - wave_g;
per_frame_16=ib_b = 1 - wave_b;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=rot = rot - 0.05 * (rad * q3 + 0.55 * q1) * (0.5 * sin(time) - cos(0.5 - 5 * rad));
per_pixel_5=rot = rot - 0.05 * if(0.00001 < abs(above(time, q1 * q2 * q3 / 3)), 6.5 * sin(2 * rad) * rad * 2 * dy - r, dx_r);
per_pixel_6=zoom = zoom + 0.1 * equal(zoom, 0) * dy_r;
per_pixel_7=rot = rot + 0.025 * (6 * rad + q1 * q3);
per_pixel_8=cx = cx - 0.25 * (cos(time) - 0.5 * sin(1.2 * time));
per_pixel_9=cy = cy - 0.25 * (sin(time) + 0.5 * cos(1.22 * time));
per_pixel_10=dx = dx + dx_r;
per_pixel_11=dy = dy + dy_r;
per_pixel_12=zoom = zoom - 0.1 * rad;
