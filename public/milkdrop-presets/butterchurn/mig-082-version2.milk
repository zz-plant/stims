shape_1_init2=q1 = 0;
shape_1_init3=q1 = 0;
shape_1_init4=t1 = 0;
shape_1_init5=t1 = 0.01 * randint(100);
shape_1_init6=t2 = 0.01 * randint(100);
shape_1_per_frame1=x = x + 0.05 * sin(0.15 * q1 + 3);
shape_1_per_frame2=y = y + 0.03 * sin(0.19 * q1 + 1);
shape_1_per_frame3=tex_ang = q1 * (0.01 + 0.0001 * t1);
shape_1_per_frame4=r = min(1, max(0, r + 0.01 * sin(0.0417 * time + 1)));
shape_1_per_frame5=g = min(1, max(0, g + 0.01 * sin(0.391 * time + 2)));
shape_1_per_frame6=b = min(1, max(0, b + 0.01 * sin(0.432 * time + 4)));
shape_1_per_frame7=r2 = min(1, max(0, r2 + 0.01 * sin(0.457 * time + 3)));
shape_1_per_frame8=g2 = min(1, max(0, g2 + 0.01 * sin(0.0437 * time + 5)));
shape_1_per_frame9=b2 = min(1, max(0, b2 + 0.01 * sin(0.484 * time + 6)));
shape_2_init1=q1 = 0;
shape_2_init2=q1 = 0;
shape_2_init3=q1 = 0;
shape_2_init4=t1 = 0;
shape_2_init5=t2 = 0;
shape_2_init6=t1 = 0.01 * randint(100);
shape_2_init7=t2 = 0.01 * randint(100);
shape_2_per_frame1=x = x + 0.05 * sin(0.017 * q1);
shape_2_per_frame2=y = y + 0.03 * sin(0.013 * q1);
shape_2_per_frame3=tex_ang = q1 * (0.02 + 0.0001 * t1);
shape_2_per_frame4=rad = rad * (0.9 + 0.2 * t2);
shape_2_per_frame5=r = min(1, max(0, r + 0.01 * sin(0.417 * time + 1)));
shape_2_per_frame6=g = min(1, max(0, g + 0.01 * sin(0.391 * time + 2)));
shape_2_per_frame7=b = min(1, max(0, b + 0.01 * sin(0.432 * time + 4)));
shape_2_per_frame8=r2 = min(1, max(0, r2 + 0.01 * sin(0.457 * time + 3)));
shape_2_per_frame9=g2 = min(1, max(0, g2 + 0.01 * sin(0.437 * time + 5)));
shape_2_per_frame10=b2 = min(1, max(0, b2 + 0.01 * sin(0.484 * time + 6)));
shape_3_init1=q1 = 0;
shape_3_init2=q1 = 0;
shape_3_per_frame1=x = x + 0.2 * sin(0.25 * q1);
shape_3_per_frame2=y = y + 0.1 * sin(0.5 * q1 + 2);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.98);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  float ang2_1;
  ang2_1 = ((ang * 0.1591549) + (time * 0.025));
  float tmpvar_2;
  tmpvar_2 = (3.0 + floor((rand_preset.z * 5.95)));
  ang2_1 = (fract((ang2_1 * tmpvar_2)) / tmpvar_2);
  ang2_1 = (abs((ang2_1 - 
    (0.5 / tmpvar_2)
  )) * 6.283185);
  vec2 tmpvar_3;
  tmpvar_3.x = cos(ang2_1);
  tmpvar_3.y = sin(ang2_1);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, (0.5 + (
    ((0.4 * (rad * sqrt(
      dot (texsize.xy, texsize.xy)
    ))) * tmpvar_3)
   * texsize.zw))).xyz * 1.333);
  ret = tmpvar_4.xyz;
 }
