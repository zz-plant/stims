wave_0_init6=yp = 0;
wave_0_init7=z = 0;
wave_0_per_point1=n = 6.283 * sample + 0.0015 * q7;
wave_0_per_point2=tm = 0.1 * time;
wave_0_per_point3=phs = sin(50 * n);
wave_0_per_point4=xp = sin(n + phs);
wave_0_per_point5=yp = cos(n + phs);
wave_0_per_point6=z = sin(3 * n + tm) * sin(7 * n - tm);
wave_0_per_point7=xp = xp * z;
wave_0_per_point8=yp = yp * z;
wave_0_per_point9=x = 0.3 * xp + 0.5;
wave_0_per_point10=y = 0.39 * yp + 0.5;
