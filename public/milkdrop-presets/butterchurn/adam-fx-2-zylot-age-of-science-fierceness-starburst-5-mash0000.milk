wave_3_per_point4=wx = if(0.00001 < abs(equal(sc, 1)), 0.9, wx);
wave_3_per_point5=wy = if(0.00001 < abs(equal(sc, 1)), 0.5, wy);
wave_3_per_point6=d = if(0.00001 < abs(below(sc, 2)), 0.3, 0.7 * d);
wave_3_per_point7=wainc = if(0.00001 < abs(equal(branch, 1)), 0.25 + cos(time), -0.25);
wave_3_per_point8=wa = if(0.00001 < abs(below(sc, 2)), 3.1415927, wa + wainc);
wave_3_per_point9=wx = if(0.00001 < abs(above(sc, 2)), wx + cos(wa) * d, wx);
wave_3_per_point10=wy = if(0.00001 < abs(above(sc, 2)), wy + sin(wa) * d, wy);
