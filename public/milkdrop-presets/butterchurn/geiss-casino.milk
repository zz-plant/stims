per_frame_1=wave_r = wave_r + 0.15 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.15 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=dx = dx + 0.03 * (0.6 * sin(0.334 * time) + 0.4 * sin(0.264 * time));
per_frame_5=decay = decay - 0.01 * mod(frame, 2);
per_pixel_1=zoom = (zoom - 1) * rad + 1;
