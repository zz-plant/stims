per_pixel_1=adv = min(bass * bass * bass, 1);
per_pixel_2=warp = 3 * (0.5 * sin(3 * time) + 0.5) * (x - 0.5) * -2 + 3 * (0.5 * cos(3 * time) + 0.5) * (y - 0.5) * 2;
