per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=meanbass_att = 0;
per_frame_init_5=q6 = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=box = 0;
per_frame_init_8=lastbeat = 0;
per_frame_init_9=beatrate = 0;
