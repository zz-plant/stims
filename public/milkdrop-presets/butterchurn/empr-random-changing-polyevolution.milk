per_frame_init_1=treb_effect = 0;
per_frame_init_2=meanbass_att = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=lastbeat = 0;
per_frame_init_5=beatrate = 0;
per_frame_init_6=peakbass_att = 0;
per_frame_init_7=bass_effect = 0;
per_frame_init_8=att = 0;
per_frame_init_9=b = 0;
per_frame_init_10=effect = 0;
per_frame_init_11=volume = 0;
per_frame_init_12=beat = 0;
per_frame_init_13=mid_effect = 0;
per_frame_1=wave_r = wave_r + 0.45 * (0.6 * sin(1.517 * time) + 0.4 * mid_effect);
per_frame_2=wave_b = wave_b + 0.45 * (0.6 * sin(1.088 * time) + 0.4 * bass_effect);
per_frame_3=wave_g = wave_g + 0.45 * (0.6 * sin(1.037 * time) + 0.4 * treb_effect);
per_frame_4=zoom = zoom + 0.013 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.02 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=decay = decay - 0.01 * below(mod(frame, 5), 1);
per_frame_7=volume = 0.3 * (bass + mid + att);
per_frame_8=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_9=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_10=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_11=peakbass_att = max(bass_att, peakbass_att);
per_frame_12=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_13=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_14=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_15=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_16=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_17=effect = if(0.00001 < abs(beat), effect + randint(5) + 1, effect);
per_frame_18=effect = if(0.00001 < abs(above(effect, 5)), effect - 6, effect);
per_frame_19=q1 = effect + 2;
per_frame_20=monitor = q1;
per_frame_21=wave_mode = wave_g * wave_b;
per_frame_22=wave_r = time + treb;
per_frame_23=wave_r = if(0.00001 < abs(below(wave_r, 0)), 0, wave_r);
per_frame_24=wave_r = if(0.00001 < abs(above(wave_r, 1)), 1, wave_r);
per_frame_25=wave_mode = if(0.00001 < abs(below(wave_mode, 0)), 0, wave_mode);
per_frame_26=wave_mode = if(0.00001 < abs(above(wave_mode, 7)), 7, wave_mode);
per_frame_27=wave_r = if(0.00001 < abs(below(wave_r, 0)), 0, wave_r);
per_frame_28=wave_r = if(0.00001 < abs(above(wave_r, 1)), 1, wave_r);
per_pixel_1=zoom = zoom + 0.04 * sin(ang * floor(q1) + 2.6 * time);
per_pixel_2=cy = x * b;
per_pixel_3=cy = if(0.00001 < abs(below(cy, -1)), -1, cy);
per_pixel_4=cy = if(0.00001 < abs(above(cy, 2)), 2, cy);
