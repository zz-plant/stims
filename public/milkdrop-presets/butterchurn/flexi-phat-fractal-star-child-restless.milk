per_frame_1=zoom = 1;
per_frame_2=q1 = 0.1 * (bass - treb);
per_frame_3=vvb = if(0.00001 < abs(below(vvb, 0)), 0, vvb);
per_frame_4=vvm = if(0.00001 < abs(below(vvm, 0)), 0, vvm);
per_frame_5=vvt = if(0.00001 < abs(below(vvt, 0)), 0, vvt);
per_frame_6=vb = 0.85 * vb + (1 - vb) * pow(bass, 2) * 0.001;
per_frame_7=vvb = 0.95 * vvb + (1 - vvb) * vb * 0.2;
per_frame_8=vm = 0.85 * vm + (1 - vm) * pow(mid, 2) * 0.01;
per_frame_9=vvm = 0.95 * vvm + (1 - vvm) * vm * 0.2;
per_frame_10=vt = 0.85 * vt + (1 - vt) * pow(treb, 2) * 0.001;
per_frame_11=vvt = 0.95 * vvt + (1 - vvt) * vt * 0.2;
per_frame_12=q1 = (vvb - vvt) * vvm;
per_frame_13=q2 = vvm;
per_frame_14=q3 = vvt;
per_frame_15=v = 0.2;
per_frame_16=d = 0;
per_frame_17=bb = bb + vvb * v - d;
per_frame_18=mm = mm + vvm * v - d;
per_frame_19=tt = tt + vvt * v - d;
per_frame_20=q4 = bb;
per_frame_21=q5 = mm;
per_frame_22=q6 = tt;
per_frame_23=echo_zoom = 0.5 * sin(time) + 0.9;
per_frame_24=decay = if(0.00001 < abs(above(abs(q1), 0.005)), 0.99, 1);
