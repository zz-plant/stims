per_frame_1=vol = bass + mid + treb;
per_frame_2=vol_ = 0.9 * vol_ + 0.1 * vol;
per_frame_3=k1 = above(vol, 1.3 * vol_);
per_frame_4=k2 = 0.9 * k2 + 0.1 * k1;
per_frame_5=k3 = 0.9 * k3 + 0.1 * k2;
per_frame_6=q10 = k2;
per_frame_7=q11 = k3;
per_frame_8=q12 = vol_;
per_frame_9=dec_med = pow(0.9, 30 / fps);
per_frame_10=dec_slow = pow(0.99, 30 / fps);
per_frame_11=beat = max(max(bass, mid), treb);
per_frame_12=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_13=is_beat = above(beat, 0.5 + avg + peak) * above(time, t0 + 0.2);
per_frame_14=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_15=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_16=index = mod(index + is_beat, 8);
per_frame_17=q20 = avg;
per_frame_18=q21 = beat;
per_frame_19=q22 = peak;
per_frame_20=q23 = index;
per_frame_21=q24 = is_beat;
per_frame_22=q26 = bass + mid + treb;
per_frame_23=k1 = is_beat * equal(index, 0);
per_frame_24=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_25=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_26=rott = 3.1416 * p2 / 2;
per_frame_27=q27 = index + 1;
per_frame_28=q1 = cos(rott);
per_frame_29=q2 = sin(rott);
per_frame_30=q3 = -q2;
per_frame_31=q4 = q1;
per_frame_32=trel = time / 8;
per_frame_33=q5 = cos(trel);
per_frame_34=q6 = sin(trel);
per_frame_35=q7 = -q6;
per_frame_36=q8 = q5;
per_frame_37=q9 = sin(time / 13) + 2;
per_frame_38=q32 = pow(0.99, 30 / fps);
per_pixel_1=p1 = sin(time / 7);
per_pixel_2=p2 = cos(time / 3);
per_pixel_3=p3 = 1 + cos(time / 6);
per_pixel_4=p4 = 0.5 * cos(time / 4.5);
per_pixel_5=dx = 0.004 * p1 * rad;
per_pixel_6=dy = 0.004 * p2 * rad;
per_pixel_7=zoom = 1 + pow(rad, p4) * p3 / 50;
per_pixel_8=rot = 0;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = dot ((texture (sampler_main, (uv + vec2(0.003, 0.0))) - texture (sampler_main, (uv - vec2(0.003, 0.0)))), vec4(0.32, 0.49, 0.29, 0.0));
  tmpvar_2.y = dot ((texture (sampler_main, (uv + vec2(0.0, 0.003))) - texture (sampler_main, (uv - vec2(0.0, 0.003)))), vec4(0.32, 0.49, 0.29, 0.0));
  ret_1 = ((-(
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  ) * 0.1) + ((texture (sampler_main, 
    (uv + (tmpvar_2 * 0.02))
  ).xyz + 
    (0.06 * vec3(dot (texture (sampler_noise_lq, ((
      ((texsize.xy * texsize_noise_lq.zw).x * uv)
     * 4.0) + rand_frame.xy)), vec4(0.32, 0.49, 0.29, 0.0))))
  ) - (
    sqrt(dot (tmpvar_2, tmpvar_2))
   * 0.03)));
  ret_1 = (ret_1 * q32);
  ret_1 = (ret_1 - 0.03);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = (0.7 * dot ((texture (sampler_main, 
    (uv + vec2(0.002, 0.0))
  ) - texture (sampler_main, 
    (uv - vec2(0.002, 0.0))
  )), vec4(0.32, 0.49, 0.29, 0.0)));
  tmpvar_1.y = (0.7 * dot ((texture (sampler_main, 
    (uv + vec2(0.0, 0.002))
  ) - texture (sampler_main, 
    (uv - vec2(0.0, 0.002))
  )), vec4(0.32, 0.49, 0.29, 0.0)));
  mat2 tmpvar_2;
  tmpvar_2[uint(0)] = _qb.xy;
  tmpvar_2[1u] = _qb.zw;
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  float tmpvar_4;
  tmpvar_4 = clamp (((
    -(q9)
   * 
    abs(texture (sampler_noise_hq, (((
      ((16.0 * tmpvar_3) * tmpvar_2)
     + 
      (time / 8.0)
    ) + (20.0 * 
      (tmpvar_1 - dot (texture (sampler_main, uv).xyz, vec3(0.32, 0.49, 0.29)))
    )) / 100.0)).x)
  ) + 1.0), 0.0, 1.0);
  vec3 tmpvar_5;
  tmpvar_5.x = tmpvar_4;
  tmpvar_5.y = ((tmpvar_4 * (tmpvar_4 - 0.55)) * 2.0);
  tmpvar_5.z = ((tmpvar_4 - 1.0) * 16.0);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (vec3((0.6 * dot (
    (texture (sampler_main, ((tmpvar_3 * 0.95) + 0.5)).xyz - 0.05)
  , vec3(0.32, 0.49, 0.29)))) + clamp (tmpvar_5, 0.0, 1.0));
  ret = tmpvar_6.xyz;
 }
