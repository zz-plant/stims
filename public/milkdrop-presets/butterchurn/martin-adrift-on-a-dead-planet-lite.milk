per_frame_25=trig = is_beat * below(randint(100), 5 * avg);
per_frame_26=ran3 = ran3 * bnot(trig) + trig * (avg / 32 + 0.05);
per_frame_27=speed = speed + 1 / fps * max(min(ran3 + (q29 - 1) / 6 - speed, 0.05), -0.05);
per_frame_28=rota = 0;
per_frame_29=ddir = ddir * dec_s + (1 - dec_s) * (2 * ran1 - dir);
per_frame_30=ddir_ = ddir_ * dec_s + ddir * (1 - dec_s);
per_frame_31=dir = dir + ddir_ / fps * abs(speed);
per_frame_32=q9 = dir;
per_frame_33=vdir1 = vdir1 * dec_s + 8 * ((1 - dec_s) * ran2 / fps);
per_frame_34=vdir = vdir * dec_s + (1 - dec_s) * vdir1;
