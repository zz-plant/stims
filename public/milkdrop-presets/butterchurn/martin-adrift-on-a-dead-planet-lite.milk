per_frame_50=q13 = 0.1 + 0.3 * sin(p1 / 3);
per_frame_51=q14 = (1 + cos(p2 / 5)) / 3;
per_frame_52=q30 = 0.3 * (cos(time / 75 + p2 / 123) + 1);
per_frame_53=q31 = 0.2 + 0.1 * sin(time / 94);
per_frame_54=q32 = -0.2 - sin(time / 22) / 4;
per_frame_55=q15 = abs(sin(time / 45 + p1 / 87)) - 0.75;
per_frame_56=q16 = 0.2 / height;
per_frame_57=q17 = tan(dir / 2);
per_frame_58=q18 = q16 - q15;
per_frame_59=q21 = min(hpeak, 1) * randint(10) / 10 * below(q15, -0.4) * above(q10, 0.1);
per_frame_60=rot = -ddir_ * speed / 2 + rota;
