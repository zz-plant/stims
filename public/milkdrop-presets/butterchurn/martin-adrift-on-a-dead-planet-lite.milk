per_frame_36=vdir = if(0.00001 < abs(above(vdir, 0)), vdir * if(0.00001 < abs(above(height, 4)), 1 - pow(height - 4, 2) / 4, 1), vdir);
per_frame_37=height = height + speed / fps * vdir * 16;
