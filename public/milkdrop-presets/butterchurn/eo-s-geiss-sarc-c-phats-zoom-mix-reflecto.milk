wave_0_per_frame1=t1 = 13 * time;
wave_0_per_frame2=t2 = 0.5 * sin(3 * time) + 0.5;
wave_0_per_frame3=t2 = 0.3 * t2 + 0.1;
wave_0_per_frame4=t2 = 0.003 * q2 + 0.06;
wave_0_per_frame5=t3 = q1;
wave_0_per_frame6=t4 = time / 8;
wave_0_per_frame7=t5 = 0.5 * sin(time / 4) + 0.5;
wave_0_per_frame8=t5 = 17 * t5 + 2;
wave_0_per_point1=n = 6.283 * sample;
wave_0_per_point2=pi = 3.1415;
wave_0_per_point3=pi2 = 6.283;
wave_0_per_point4=phs = t1 + 9 * sample;
wave_0_per_point5=bias = t5;
wave_0_per_point6=bias_i = bias - 1;
wave_0_per_point7=cc = phs / 3;
wave_0_per_point8=cc_int = floor(cc);
wave_0_per_point9=cc_ramp = cc - cc_int;
wave_0_per_point10=cc_ad_a = (cc_ramp * bias - 1) / bias_i;
wave_0_per_point11=cc_ad_a = if(0.00001 < abs(below(cc_ad_a, 0)), 0, cc_ad_a);
wave_0_per_point12=cc_ad_b = cc_ramp * bias;
wave_0_per_point13=cc_ad_b = if(0.00001 < abs(above(cc_ad_b, 1)), 1, cc_ad_b);
wave_0_per_point14=cc_a = cc_ad_a + cc_int;
wave_0_per_point15=cc_b = cc_ad_b + cc_int;
wave_0_per_point16=xp = t2 * above(cc_ad_a, 0);
wave_0_per_point17=yp = 1;
wave_0_per_point18=zp = 0;
wave_0_per_point19=ang = 100.528 * cc_a;
wave_0_per_point20=sang = sin(ang);
wave_0_per_point21=cang = cos(ang);
wave_0_per_point22=xq = sang * xp + cang * zp;
wave_0_per_point23=yq = yp;
wave_0_per_point24=zq = cang * xp - sang * zp;
wave_0_per_point25=xp = xq;
wave_0_per_point26=yp = yq;
wave_0_per_point27=zp = zq;
wave_0_per_point28=ang2 = cc_b + t4;
wave_0_per_point29=sang = sin(ang2);
wave_0_per_point30=cang = cos(ang2);
wave_0_per_point31=xq = xp;
wave_0_per_point32=yq = sang * yp + cang * zp;
wave_0_per_point33=zq = cang * yp - sang * zp;
wave_0_per_point34=xp = xq;
wave_0_per_point35=yp = yq;
wave_0_per_point36=zp = zq;
wave_0_per_point37=ang2 = 3.13 * cc_b + t4;
wave_0_per_point38=sang = sin(ang2);
wave_0_per_point39=cang = cos(ang2);
wave_0_per_point40=xq = sang * xp + cang * yp;
wave_0_per_point41=yq = cang * xp - sang * yp;
wave_0_per_point42=zq = zp;
wave_0_per_point43=xp = xq;
wave_0_per_point44=yp = yq;
wave_0_per_point45=zp = zq;
wave_0_per_point46=ang2 = 1.43 * cc_b + t4;
wave_0_per_point47=sang = sin(ang2);
wave_0_per_point48=cang = cos(ang2);
wave_0_per_point49=xq = sang * xp + cang * zp;
wave_0_per_point50=yq = yp;
wave_0_per_point51=zq = cang * xp - sang * zp;
wave_0_per_point52=xp = xq;
wave_0_per_point53=yp = yq;
wave_0_per_point54=zp = zq;
wave_0_per_point55=zp = zp + 3.1;
wave_0_per_point56=xs = xp / zp + 0.5;
wave_0_per_point57=ys = 1.333 * (yp / zp) + 0.5;
wave_0_per_point58=x = xs;
wave_0_per_point59=y = ys;
shape_2_per_frame1=ang = time / 4;
shape_3_per_frame1=ang = -time / 3;

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = rad;
  tmpvar_2.y = uv.y;
  ret_1 = (texture (sampler_main, tmpvar_2).xyz + ((texture (sampler_blur1, tmpvar_2).xyz * scale1) + bias1));
  ret_1 = (ret_1 * vec3(1.04, 0.64, 0.4));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
