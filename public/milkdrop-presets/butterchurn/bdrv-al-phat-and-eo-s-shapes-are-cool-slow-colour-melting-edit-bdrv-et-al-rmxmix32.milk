per_frame_1=decay = 1;
per_frame_2=speed = 0.8;
per_frame_3=speedinv = 1 - speed;
per_frame_4=q1 = qa * speed + bass * speedinv;
per_frame_5=q2 = qb * speed + mid * speedinv;
per_frame_6=q3 = qc * speed + treb * speedinv;
per_frame_7=qa = q1;
per_frame_8=qb = q2;
per_frame_9=qc = q3;
per_frame_10=flux = sin(time / 2);
per_frame_11=q4 = 0.5 * flux + 0.5;
per_frame_12=q5 = flux;
per_frame_13=zoom = 0.9995;
per_pixel_1=nn = mod(0.2 * time, 7) + 1;
per_pixel_2=nn = 7;
per_pixel_3=cx = (floor(x * nn) + 0.5) / nn;
per_pixel_4=cy = (floor(y * nn) + 0.5) / nn;
per_pixel_5=dx = 0.0001 * (q1 + floor(x * nn - 2));
per_pixel_6=dx = 0.0001 * (q2 + floor(y * nn - 2));
per_pixel_7=dx = 0.01 * tan(q1 + floor(x * nn) * (q2 + 1));
per_pixel_8=dx = 0.01 * tan(q2 + floor(y * nn) * (q1 + 1));
per_pixel_9=rot = 0.06 * floor(2 * tan(q3 + 10 * (cx + cy)));
per_pixel_10=sx = -0.95 + 0.5 * bass * rd;
per_pixel_11=sy = -0.95 - 0.5 * treb * ag;
per_pixel_12=cx = 0.5 + q4;
per_pixel_13=cy = 0.5 - q5;
per_pixel_14=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_15=zm = 0.95;
per_pixel_16=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_17=star = atan(6 * ag) * (4 - rd - ag) / 5;
per_pixel_18=zm = zm + star * ag / 20 * ag;
per_pixel_19=sx = zm;
per_pixel_20=sy = zm;
per_pixel_21=dx = 0.01 * sin(140 * y) * bass;
per_pixel_22=dy = 0.01 * cos(140 * x) * bass;
per_pixel_23=q1 = 0.4 * rad;
per_pixel_24=q2 = 0.3 * rad;
per_pixel_25=q3 = below(rad, 0.1 * q5 + 0.3);
per_pixel_26=q7 = if(0.00001 < abs(q3), 0, 10 + floor(1 * rad));
per_pixel_27=q8 = if(0.00001 < abs(q3), 0, 10 + floor(1 * rad));
per_pixel_28=cx = if(0.00001 < abs(q3), 0.5, band(0, x * q7 - q1) * (1 / q7) + 0.1 * q1);
per_pixel_29=cy = if(0.00001 < abs(q3), 0.5, band(0, y * q8 - q2) * (1 / q8) + 0.1 * q2);
per_pixel_30=rot = if(0.00001 < abs(q3), 2 * q6 * rad, 0.1 * rad + 0.1 * bass + 0 * cx * cy);
per_pixel_31=num = 8;
per_pixel_32=pi = 3.141592654;
per_pixel_33=radi = 0.75 * (y - 0.5);
per_pixel_34=radi = y - 0.5;
per_pixel_35=radi = pow(radi * radi + (x - 0.5) * (x - 0.5), 0.5);
per_pixel_36=an = ang + pi + time;
per_pixel_37=an = an - 2 * pi * floor(an / (2 * pi));
per_pixel_38=mod = 0.1;
per_pixel_39=seg = ang + pi;
per_pixel_40=seg = seg / (2 * pi) * num;
per_pixel_41=seg = floor(seg);
per_pixel_42=seg = seg - equal(seg, num);
per_pixel_43=anga = ang + pi - 2 * pi / num * seg;
per_pixel_44=anga = if(0.00001 < abs(equal(mod(seg, 2), 0)), 2 * pi / num - anga, anga);
per_pixel_45=anga = anga + pi / 4;
per_pixel_46=ox = 0.5 - radi * sin(anga);
per_pixel_47=oy = 0.5 + radi * cos(anga);
per_pixel_48=dx = equal(seg, 3) * (x - ox);
per_pixel_49=dy = equal(seg, 3) * (y - oy);
per_pixel_50=dx = above(seg, 0) * (x - ox);
per_pixel_51=dy = above(seg, 0) * (y - oy);
per_pixel_52=nn = mod(0.2 * time, 7) + 1;
per_pixel_53=nn = 7;
per_pixel_54=cx = (floor(x * nn) + 0.5) / nn;
per_pixel_55=cy = (floor(y * nn) + 0.5) / nn;
per_pixel_56=dx = 0.0001 * (q1 + floor(x * nn - 2));
per_pixel_57=dx = 0.0001 * (q2 + floor(y * nn - 2));
per_pixel_58=dx = 0.01 * tan(q1 + floor(x * nn) * (q2 + 1));
per_pixel_59=dx = 0.01 * tan(q2 + floor(y * nn) * (q1 + 1));
per_pixel_60=rot = 0.06 * floor(2 * tan(q3 + 10 * (cx + cy)));
per_pixel_61=cx = (band(0, x * q3 - q5) + q5) * q4;
per_pixel_62=cy = (band(0, y * q3 - q6) + q6) * q4;
per_pixel_63=newx = q1 - x;
per_pixel_64=newy = q2 - y;
per_pixel_65=newrad = 2 * sqrt(newx * newx + 0.5625 * newy * newy);
per_pixel_66=newzoom = pow(1.05 + 0.03 * newrad, pow(0.01 + sin(newrad * newrad), 2 * newrad - 1));
per_pixel_67=dx = newx * newzoom - newx;
per_pixel_68=dy = newy * newzoom - newy;
per_pixel_69=dx = dx * 0.1;
per_pixel_70=dy = dy * 0.1;
per_pixel_71=rot = 2 * newrad * (0.5 * (0.5 - rad) + 0.1);
per_pixel_72=rot = rot * sin(0.01 * time) * 0.2;
per_pixel_73=zoom = 1 + 0.01 * sin(13.28 * rad);
per_pixel_74=zoom = zoom + equal(q2, 1) * q3 * 0.1 * (x - 0.5);
per_pixel_75=zoom = zoom + equal(q2, 2) * q3 * 0.1 * (0.5 - x);
per_pixel_76=zoom = zoom + equal(q2, 5) * q3 * 0.1 * (0.5 - y);
per_pixel_77=zoom = zoom + equal(q2, 4) * q3 * 0.1 * (y - 0.5);
per_pixel_78=rot = rot + equal(q2, 3) * q3 * 0.3;
per_pixel_79=rot = rot - equal(q2, 6) * q3 * 0.3;
per_pixel_80=sx = sx + equal(q2, 7) * q3 * 0.2;
per_pixel_81=sy = sy - equal(q2, 8) * q3 * 0.2;
per_pixel_82=sx = sx - equal(q2, 9) * q3 * 0.2;
per_pixel_83=sy = sy + equal(q2, 10) * q3 * 0.2;
per_pixel_84=dy = dy + equal(q2, 11) * abs(0.5 - x) * sign(0.5 - x) * q3 * 0.2;
per_pixel_85=dx = dx + equal(q2, 12) * abs(0.5 - y) * sign(0.5 - y) * q3 * 0.2;
per_pixel_86=dx = dx - equal(q2, 14) * abs(0.5 - y) * sign(0.5 - y) * q3 * 0.2;
per_pixel_87=dy = dy - equal(q2, 13) * abs(0.5 - x) * sign(0.5 - x) * q3 * 0.2;
per_pixel_88=cx = 0.5;
