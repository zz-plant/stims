per_frame_6=wave_b = mv_r;
per_frame_7=wave_g = mv_b;
per_frame_8=rot = rot + 0.2 * (bass_att - 1);
per_frame_9=decay = if(0.00001 < abs(mod(time, 20)), 0.99, 0.5);
per_pixel_1=dx = 0.01 * sin(sqrt(15 * sqr(15 * x)));
per_pixel_2=dy = 0.01 * sin(sqrt(15 * sqr(15 * y)));
