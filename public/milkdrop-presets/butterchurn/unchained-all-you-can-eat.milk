per_frame_init_1=zoom_fade = 0;
per_frame_init_2=g3 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q5 = 0;
per_frame_init_5=bass_thresh = 0;
per_frame_init_6=g2 = 0;
per_frame_init_7=treb_thresh = 0;
per_frame_init_8=pulse = 0;
per_frame_init_9=bass_changed = 0;
per_frame_init_10=y_shift = 0;
per_frame_init_11=mid_thresh = 0;
per_frame_init_12=q4 = 0;
per_frame_init_13=mid_changed = 0;
per_frame_init_14=entropy = 0;
per_frame_init_15=x_shift = 0;
per_frame_init_16=chaos = 0;
per_frame_init_17=r_shift = 0;
per_frame_init_18=q2 = 0;
per_frame_init_19=treb_changed = 0;
per_frame_init_20=q3 = 0;
per_frame_init_21=g1 = 0;
per_frame_1=warp = 0;
per_frame_2=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_3=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -20)), 1 + randint(5), entropy));
per_frame_4=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_5=bass_changed = abs(bass_changed - equal(bass_thresh, 2));
per_frame_6=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_7=treb_changed = abs(treb_changed - equal(treb_thresh, 2));
per_frame_8=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_9=mid_changed = abs(mid_changed - equal(mid_thresh, 2));
per_frame_10=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.1 * chaos * bor(bor(bass_changed, treb_changed), mid_changed) + 0.025 * (mid + bass + treb));
per_frame_11=q3 = sin(pulse);
per_frame_12=q2 = 0.5 * (pulse / entropy) * chaos;
per_frame_13=q4 = sin(q2);
per_frame_14=q5 = entropy;
per_frame_15=q1 = (1 + 1 * above(q4, 0)) * (1 + 2 * above(q3, 0)) * (1 + 4 * mid_changed * above(q3, 0)) * (1 + 6 * above(pulse, 0));
per_frame_16=wave_r = if(0.00001 < abs(treb_changed), 0.5 + 0.5 * q3, if(0.00001 < abs(bass_changed), 0.5 + 0.5 * q4, 1));
per_frame_17=wave_g = 0.5 + 0.2 * bnot(mod(q1, 2)) - 0.2 * bnot(mod(q1, 3)) + 0.2 * bnot(mod(q1, 5)) - 0.2 * bnot(mod(q1, 7));
per_frame_18=wave_b = if(0.00001 < abs(bnot(mod(q1, 6))), 0.8 + 0.2 * q4, bass_changed * mid_changed);
per_frame_19=ob_r = ob_r + 0.2 * q4 + 0.3 * bnot(mod(q1, 7)) * q3;
per_frame_20=ob_b = ob_b - 0.1 * bnot(mod(q1, 105)) - 0.4 * sin(0.8 * q2);
per_frame_21=ob_g = ob_g + 0.5 * sin(0.4 * pulse * entropy);
per_frame_22=ob_a = 0.07 + 0.05 * q3;
per_frame_23=ob_size = 0.01 * entropy * bnot(mod(q1, 6));
per_frame_24=ib_r = ib_r + 0.2 * q1 - 0.3 * bnot(mod(q1, 3)) * q4;
per_frame_25=ib_b = ib_b - 0.1 * bnot(mod(q1, 42)) - 0.4 * sin(0.7 * q2);
per_frame_26=ib_g = ib_g + 0.5 * sin(0.5 * pulse * entropy);
per_frame_27=ib_a = 0.07 + 0.05 * q3 * q4;
per_frame_28=ib_size = 0.005 + 0.005 * q3;
per_frame_29=zoom_fade = if(0.00001 < abs(above(q3, 0)), if(0.00001 < abs(above(q4, 0)), zoom_fade - 0.0013, zoom_fade + 0.002), 1 + 0.04 * q4);
per_frame_30=zoom = zoom_fade;
per_pixel_1=g1 = sin(0.04 * q2 * q5);
per_pixel_2=g2 = sin(0.05 * q2 * q5);
per_pixel_3=g3 = sin(0.06 * q2 * q5);
per_pixel_4=x_shift = pow(x, 2) + x * g1 * 2 + sqr(g1);
per_pixel_5=y_shift = pow(y, 2) + y * g2 * 2 + sqr(g2);
per_pixel_6=r_shift = pow(rad, 2) + rad * g3 * 2 + sqr(g3);
per_pixel_7=zoom = zoom - sin(x_shift * bnot(mod(q1, 10)) + y_shift * bnot(mod(q1, 14)) + r_shift * bnot(mod(q1, 21))) * q3 * (0.1 + 0.1 * bnot(mod(q1, 30)) + 0.1 * bnot(mod(q1, 7)));
per_pixel_8=dx = dx + bnot(mod(q1, 35)) * (rad - 0.5 * g3) * g2 - 0.1 * cos(1.68 * y) * bnot(mod(q1, 21));
per_pixel_9=dy = dy - cos(1.68 * x) * bnot(mod(q1, 10));
per_pixel_10=rot = if(0.00001 < abs(above(sin(4.3 * q2), 0)), 0.3 * above(abs(zoom - 1), 0.05), 0.3 * g3);
