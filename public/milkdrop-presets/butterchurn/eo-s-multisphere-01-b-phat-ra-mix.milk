per_frame_3=vol = 0.25 * (bass + mid + treb);
per_frame_4=vol = vol * vol;
per_frame_5=q1 = vol;
per_frame_6=mtime = mtime + 0.01 * vol * (53 / fps);
per_frame_7=q2 = 0.25 * mtime;
wave_1_init1=n = 0;
wave_1_init2=yq = 0;
wave_1_init3=xp = 0;
wave_1_init4=xs = 0;
