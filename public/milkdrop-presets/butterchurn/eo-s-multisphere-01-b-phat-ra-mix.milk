wave_1_init12=zp = 0;
wave_1_init13=q2 = 0;
wave_1_per_point1=n = 6.283 * sample;
wave_1_per_point2=ang = 6.283 * (floor(12 * sample) / 12);
wave_1_per_point3=ps = 0.1 * time;
wave_1_per_point4=xp = 0.5 * sin(12 * n + ps);
wave_1_per_point5=yp = 0.5 * cos(12 * n + ps);
wave_1_per_point6=zp = 2 + 0.03 * q1;
wave_1_per_point7=xq = xp;
wave_1_per_point8=yq = yp * sin(ang) + zp * cos(ang);
wave_1_per_point9=zq = yp * cos(ang) - zp * sin(ang);
wave_1_per_point10=xp = xq;
wave_1_per_point11=yp = yq * sin(q2) + zq * cos(q2);
wave_1_per_point12=zp = yq * cos(q2) - zq * sin(q2);
wave_1_per_point13=xq = xp * sin(q2) + yp * cos(q2);
wave_1_per_point14=yq = xp * cos(q2) - yp * sin(q2);
wave_1_per_point15=zq = zp;
wave_1_per_point16=xp = xq;
wave_1_per_point17=yp = yq;
wave_1_per_point18=zp = zq;
wave_1_per_point19=zp = zp + 8;
wave_1_per_point20=xs = xp / zp;
wave_1_per_point21=ys = yp / zp;
wave_1_per_point22=x = xs + 0.5;
wave_1_per_point23=y = 1.3 * ys + 0.5;
