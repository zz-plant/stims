[preset00]
fRating=4.000000
fGammaAdj=1.320000
fDecay=1.000000
fVideoEchoZoom=1.220000
fVideoEchoAlpha=0.150000
nWaveMode=5.000000
bDarken=1.000000
fWaveAlpha=0.691000
fWaveScale=4.778000
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fShader=1.000000
fZoom=0.999510
fWarp=0.010100
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.015000
fOuterBorderA=0.100000
fInnerBorderSize=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=1.000000
shapecode_0_textured=1.000000
shapecode_0_y=1.800000
shapecode_1_enabled=1.000000
shapecode_1_textured=1.000000
shapecode_1_y=1.800000
shapecode_2_enabled=1.000000
shapecode_2_textured=1.000000
shapecode_2_y=1.800000
shapecode_3_enabled=0.000000
per_frame_init_1=xx = 0;
per_frame_init_2=w = 0;
per_frame_init_3=decay_rate = 0;
per_frame_init_4=res = 0;
per_frame_init_5=q12 = 0;
per_frame_init_6=q18 = 0;
per_frame_init_7=q13 = 0;
per_frame_init_8=diff = 0;
per_frame_init_9=prev_beat = 0;
per_frame_init_10=is_beat = 0;
per_frame_init_11=q11 = 0;
per_frame_init_12=ry = 0;
per_frame_init_13=rx = 0;
per_frame_init_14=min_att = 0;
per_frame_init_15=beat = 0;
per_frame_init_16=q17 = 0;
per_frame_init_17=vol = 0;
per_frame_init_18=decay_to = 0;
per_frame_init_19=q14 = 0;
per_frame_init_20=m = 0;
per_frame_init_21=beat_level = 0;
per_frame_init_22=yy = 0;
per_frame_1=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_2=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_3=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_frame_4=wave_x = wave_x + 0.2 * sin(0.32 * time);
per_frame_5=wave_y = wave_y + 0.2 * cos(0.32 * time);
per_frame_6=ob_r = wave_r;
per_frame_7=ob_g = wave_g;
per_frame_8=ob_b = wave_b;
per_frame_9=vol = 8 * bass + 5 * mid + 3 * treb;
per_frame_10=m = 0.97 * m + 0.08 * vol;
per_frame_11=monitor = vol;
per_frame_12=beat = above(vol, res) * above(vol, m) * above(vol, 16);
per_frame_13=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_14=res = beat * (vol + 0.04 * m) + (1 - beat) * (res - 60 * (0.1 + 0.02 * diff) / fps);
per_frame_15=res = max(0, res);
per_frame_16=w = if(0.00001 < abs(beat), randint(4096) / 1024 * asin(1), w);
per_frame_17=xx = if(0.00001 < abs(beat), 0.1 + randint(800) / 1000, xx);
per_frame_18=yy = if(0.00001 < abs(beat), 0.1 + randint(800) / 1000, yy);
per_frame_19=decay_rate = pow(0.995, fps);
per_frame_20=min_att = 2.2;
per_frame_21=decay_to = 1;
per_frame_22=beat = bass / max(min_att, bass_att);
per_frame_23=beat = max(beat, mid / max(min_att, mid_att));
per_frame_24=beat = max(beat, treb / max(min_att, treb_att));
per_frame_25=beat = max(beat, (prev_beat - decay_to) * decay_rate + decay_to);
per_frame_26=beat_level = 24 * (beat - prev_beat - 0.07);
per_frame_27=is_beat = above(beat_level, 0.5);
per_frame_28=prev_beat = beat;
per_frame_29=w = if(0.00001 < abs(is_beat), w + (randint(256) - 128) / 1024, w);
per_frame_30=xx = if(0.00001 < abs(is_beat), xx + (randint(256) - 128) / 4096, xx);
per_frame_31=yy = if(0.00001 < abs(is_beat), yy + (randint(256) - 128) / 4096, yy);
per_frame_32=q11 = sin(w);
per_frame_33=q12 = cos(w);
per_frame_34=q13 = xx;
per_frame_35=q14 = yy;
per_frame_36=q17 = sin(-w);
per_frame_37=q18 = cos(-w);
per_pixel_1=rx = ang;
per_pixel_2=ry = rad;
per_pixel_3=rot = sin(floor(1 + 2.864 * ry) * (8446669 + 667777 * sin(time / 21774898 + treb / 55559599))) / 2 + 0.5;
per_pixel_4=zoom = sin(floor(1 + 2.654 * rx) * (4747833 + 754166 * sin(time / 26666825 + mid / 59555599))) / 2 + 0.5;
per_pixel_5=rot = sin(rot * rot * rad * 88) / 399;
per_pixel_6=zoom = 1 - sin(sqr(zoom) * ang * 88) / 356 - 0.004141 * (1 - rad);
per_pixel_7=dx = dx;
per_pixel_8=dy = dy;

[comp_shader]
shader_body { 
  vec2 uv_rr_1;
  vec2 uv_r_2;
  vec2 tmpvar_3;
  tmpvar_3.x = q13;
  tmpvar_3.y = q14;
  vec2 tmpvar_4;
  tmpvar_4 = ((uv - tmpvar_3) * aspect.xy);
  vec2 tmpvar_5;
  tmpvar_5.x = ((q12 * tmpvar_4.x) - (q11 * tmpvar_4.y));
  tmpvar_5.y = ((q11 * tmpvar_4.x) + (q12 * tmpvar_4.y));
  uv_r_2 = (4.0 * tmpvar_5);
  uv_r_2 = (tmpvar_3 + (uv_r_2 * aspect.zw));
  uv_r_2 = (1.0 - abs((
    (fract((uv_r_2 * 0.5)) * 2.0)
   - 1.0)));
  vec2 tmpvar_6;
  tmpvar_6 = ((uv_r_2 - tmpvar_3) * aspect.xy);
  vec2 tmpvar_7;
  tmpvar_7.x = ((q18 * tmpvar_6.x) - (q17 * tmpvar_6.y));
  tmpvar_7.y = ((q17 * tmpvar_6.x) + (q18 * tmpvar_6.y));
  uv_rr_1 = (4.0 * tmpvar_7);
  uv_rr_1 = (tmpvar_3 + ((
    (uv_rr_1 - tmpvar_3)
   * aspect.zw) * 0.06));
  uv_rr_1 = (1.0 - abs((
    (fract((uv_rr_1 * 0.5)) * 2.0)
   - 1.0)));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = pow (((
    abs((((texture (sampler_blur3, uv_rr_1).xyz * scale3) + bias3) - texture (sampler_main, uv_rr_1).xyz))
   * 3.0) + 0.1), vec3(1.5, 1.5, 1.5));
  ret = tmpvar_8.xyz;
 }
