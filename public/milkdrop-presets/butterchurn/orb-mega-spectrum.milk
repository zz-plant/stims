wave_0_per_point1=u = 3.14159 * abs(cos(0.1 * q1));
wave_0_per_point2=v = 6.28318 * abs(cos(0.015 * q1));
wave_0_per_point3=s = 314 * sample;
wave_0_per_point4=ss = 6280 * sample;
wave_0_per_point5=xs = 0.5 * sin(s) * cos(ss) * equal(q5, 0) + (0.6 + 0.1 * cos(s)) * cos(ss) * equal(q5, 1) + 0.5 * sin(s) * cos(ss) * equal(q5, 2);
wave_0_per_point6=ys = 0.5 * sin(s) * sin(ss) * equal(q5, 0) + (0.6 + 0.1 * cos(s)) * sin(ss) * equal(q5, 1) + 0.5 * sin(s) * sin(ss) * equal(q5, 2);
wave_0_per_point7=zs = 0.5 * cos(s) * equal(q5, 0) + 0.1 * sin(s) * equal(q5, 1) + 0.5 * sin(s) * equal(q5, 2);
wave_0_per_point8=xtor = (0.6 + 0.1 * cos(s)) * cos(ss);
wave_0_per_point9=ytor = (0.6 + 0.1 * cos(s)) * sin(ss);
wave_0_per_point10=ztor = 0.1 * sin(s);
wave_0_per_point11=angle = 0.3 * q1;
wave_0_per_point12=yx = ys * cos(angle) - zs * sin(angle);
wave_0_per_point13=zx = ys * sin(angle) + zs * cos(angle);
wave_0_per_point14=xx = xs;
wave_0_per_point15=angle2 = 0.5 * q1;
wave_0_per_point16=xd = xx * cos(angle2) - zx * sin(angle2);
wave_0_per_point17=zd = xx * sin(angle2) + zx * cos(angle2);
wave_0_per_point18=yd = yx;
wave_0_per_point19=angle3 = 0.41 * q1;
wave_0_per_point20=xn = xd * cos(angle3) - yd * sin(angle3);
wave_0_per_point21=yn = xd * sin(angle3) + yd * cos(angle3);
wave_0_per_point22=zd = zd + 2;
wave_0_per_point23=peek1 = 10 * (value1 + value2);
wave_0_per_point24=level = if(0.00001 < abs(above(peek1, level)), peek1, level - 0.00025);
wave_0_per_point25=level = if(0.00001 < abs(below(level, 0)), 0, level);
wave_0_per_point26=zd = zd + 2 + level;
wave_0_per_point27=x = xn * zd * 0.05 + 0.5;
wave_0_per_point28=y = yn * zd * 0.06 + 0.5;
wave_0_per_point29=r = 0.5 + 0.5 * sin(1.2 * q1 + x + x);
wave_0_per_point30=g = 0.5 + 0.5 * sin(1.5 * q1 + x + y);
wave_0_per_point31=b = 0.5 + 0.5 * sin(1.36 * q1 + y + y);
