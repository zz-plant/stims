wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=star = 0;
per_frame_init_3=cdelay1 = 0;
per_frame_init_4=cdelay2 = 0;
per_frame_init_5=q = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=counter2 = 0;
per_frame_init_9=musictime = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=ypos = 0;
per_frame_init_12=colorcounter = 0;
per_frame_init_13=zm = 0;
per_frame_init_14=rd = 0;
per_frame_init_15=ag = 0;
per_frame_init_16=q2 = 0;
per_frame_init_17=counter1 = 0;
per_frame_init_18=q3 = 0;
per_frame_1=wave_a = 0;
per_frame_2=counter1 = if(0.00001 < abs(equal(counter2, 1)), if(0.00001 < abs(equal(counter1, 1)), 0, counter1 + 0.2), 1);
per_frame_3=counter2 = if(0.00001 < abs(equal(counter1, 1)), if(0.00001 < abs(equal(counter2, 1)), 0, counter2 + 0.2), 1);
per_frame_4=cdelay1 = if(0.00001 < abs(equal(cdelay2, 1)), 1, if(0.00001 < abs(equal(mod(colorcounter, 2), 1)), if(0.00001 < abs(equal(counter1, 1)), 2, 0), if(0.00001 < abs(equal(counter2, 1)), 2, 0)));
per_frame_5=cdelay2 = if(0.00001 < abs(equal(cdelay1, 2)), 1, 0);
per_frame_6=colorcounter = if(0.00001 < abs(above(colorcounter, 7)), 0, if(0.00001 < abs(equal(cdelay1, 1)), colorcounter + 1, colorcounter));
per_frame_7=ib_r = 0.5 * if(0.00001 < abs(equal(colorcounter, 1)), 1, if(0.00001 < abs(equal(colorcounter, 2)), 1, if(0.00001 < abs(equal(colorcounter, 3)), 1, if(0.00001 < abs(equal(colorcounter, 4)), sin(counter2 + 2.1), if(0.00001 < abs(equal(colorcounter, 5)), 0, if(0.00001 < abs(equal(colorcounter, 6)), 0, sin(counter1)))))));
per_frame_8=ib_g = 0.5 * if(0.00001 < abs(equal(colorcounter, 1)), 0, if(0.00001 < abs(equal(colorcounter, 2)), sin(0.5 * counter2), if(0.00001 < abs(equal(colorcounter, 3)), sin(0.4 * (counter1 + 1.75)), if(0.00001 < abs(equal(colorcounter, 4)), 1, if(0.00001 < abs(equal(colorcounter, 5)), 1, if(0.00001 < abs(equal(colorcounter, 6)), sin(counter2 + 2), 0))))));
per_frame_9=ib_b = if(0.00001 < abs(equal(colorcounter, 1)), sin(counter1 + 2.1), if(0.00001 < abs(equal(colorcounter, 2)), 0, if(0.00001 < abs(equal(colorcounter, 3)), 0, if(0.00001 < abs(equal(colorcounter, 4)), 0, if(0.00001 < abs(equal(colorcounter, 5)), sin(counter1), exec2(equal(colorcounter, 6), 1))))));
per_frame_10=ob_r = ib_r - 0.5;
per_frame_11=ob_g = ib_g - 0.5;
per_frame_12=ob_b = ib_b - 0.5;
per_frame_13=q1 = ib_r;
per_frame_14=q2 = ib_g;
per_frame_15=q3 = ib_b;
per_frame_16=decay = 0.9999;
per_frame_17=musictime = musictime + mid * mid * mid * 0.02;
per_frame_18=xpos = 0.3 * sin(0.6 * musictime);
per_frame_19=ypos = 0.3 * sin(0.4 * musictime);
per_frame_20=q4 = xpos;
per_frame_21=q5 = ypos;
per_pixel_1=zoom = 1;
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_5=zm = 1;
per_pixel_6=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_7=star = sin(6 * ag + time) * (2 - rd);
per_pixel_8=zm = zm + star / 20;
per_pixel_9=sx = zm;
per_pixel_10=sy = zm;
per_pixel_11=rot = 0.1 * (above(rd, 0.7) / (rd + 2)) * bass_att / rd;
per_pixel_12=rot = rot + 0.05 * sin(13.5 * rad + 1.3 * q2 + 1.31 * q);
per_pixel_13=zoom = zoom + 0.05 * sin(10 * ang + 7.5 * rad + 1.63 * q2 + q);

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 1.333);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
