per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_init_4=tg1 = 0;
per_frame_init_5=tg2 = 0;
per_frame_init_6=tg3 = 0;
per_frame_init_7=six = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 2;
per_frame_5=ob_r = ob_r + wave_b * above(sin(0.1 * time), 0);
per_frame_6=ob_b = ob_b + wave_g * above(sin(0.1 * time), 0);
per_frame_7=ob_g = ob_g + wave_r * above(sin(0.1 * time), 0);
per_frame_8=ob_r = ob_r + wave_g * below(sin(0.1 * time), 0);
per_frame_9=ob_b = ob_b + wave_r * below(sin(0.1 * time), 0);
per_frame_10=ob_g = ob_g + wave_b * below(sin(0.1 * time), 0);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.05 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.056 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 22 * above(tg1, 0.75) + 12 * below(tg1, 0.25) + 18 * above(tg1, 0.25) * below(tg1, 0.5) + 12 * above(tg1, 0.5) * below(tg1, 0.75);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_7=six = sin(x);
per_pixel_8=dx = dx + dx_r * sin(abs(tg3 * y)) * sin(time);
per_pixel_9=dy = dy + dy_r * sin(abs(tg3 * x)) * cos(time);
per_pixel_10=dx = dx + dx_r * pow(rad, 2 * y) * sin(time);
per_pixel_11=dy = dy + dy_r * pow(rad, 2 * x) * sin(time);
per_pixel_12=zoom = zoom - 0.0825 * pow(rad, 6 * x) * cos(6 * ang);
per_pixel_13=rot = rot - 0.039375 * sin(1.25 * time) * pow(rad, x) * sin(1.45 * time) * sin(time);
