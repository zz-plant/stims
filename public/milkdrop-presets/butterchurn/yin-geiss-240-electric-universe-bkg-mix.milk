per_frame_1=sure = if(0.00001 < abs(equal(sure, 0)), 0.75, sure);
per_frame_2=interval = if(0.00001 < abs(equal(interval, 0)), 0.7 * fps, interval);
per_frame_3=avginterval = if(0.00001 < abs(equal(avginterval, 0)), 0.7 * fps, avginterval);
per_frame_4=lockinterval = if(0.00001 < abs(equal(lockinterval, 0)), 0.7 * fps, lockinterval);
per_frame_5=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), frame - fps, lastbeat);
per_frame_6=dbass = (bass - pbass) * fps;
per_frame_7=beat = below(dbass, 0) * above(pdbass, 0) * above(bass, 0.95 * avgbass) * above(frame - lastbeat, fps / 3);
per_frame_8=sure = if(0.00001 < abs(beat * below(abs(frame - (interval + lastbeat)), fps / 5)), min(0.095 + sure, 1), beat * (sure - 0.095) + (1 - beat) * sure * 0.9996);
per_frame_9=sure = max(0.5, sure);
per_frame_10=avgbass = 0.995 * avgbass + 0.005 * bass;
per_frame_11=maxdbass = max(0.999 * maxdbass, dbass);
per_frame_12=maxdbass = min(200, maxdbass);
per_frame_13=maxdbass = max(0.02, maxdbass);
per_frame_14=interval = if(0.00001 < abs(beat * below(frame - lastbeat, 1.8 * interval)), 0.25 * (frame - lastbeat) + 0.75 * interval, interval);
per_frame_15=lastbeat = if(0.00001 < abs((1 - force) * beat + equal(lastbeat + interval, frame)), frame, lastbeat);
per_frame_16=avginterval = if(0.00001 < abs(beat), 0.9 * avginterval + 0.1 * interval, avginterval);
per_frame_17=lockinterval = if(0.00001 < abs(beat), 0.9 * lockinterval + 0.1 * avginterval, lockinterval);
per_frame_18=pbass = bass;
per_frame_19=pdbass = dbass;
per_frame_20=bpm = 60 * fps * 0.3333 * (2 * (1 - sure) / interval + 2 * sure / avginterval + 1 / lockinterval);
per_frame_21=phase = min((frame - lastbeat) / (0.333 * (2 * sure * avginterval + 2 * (1 - sure) * interval + lockinterval)), 1);
per_frame_22=beat = if(0.00001 < abs(equal(phase, 0)), 1, beat);
per_frame_23=interval = min(interval, 0.7 * fps);
per_frame_24=avginterval = min(avginterval, 0.7 * fps);
per_frame_25=lockinterval = min(lockinterval, 0.7 * fps);
per_frame_26=q1 = 0.1 * cos(time);
per_frame_27=q2 = 0.42 * sin(time);
per_frame_28=q8 = 0.1 * time;
per_frame_29=q7 = beat;
per_frame_30=q6 = time / 6.2831 - floor(time / 6.2831);
per_frame_31=q5 = abs(6.2831 * q6 - 3.1415) / 3.1415;
per_frame_32=monitor = q6;
