wave_3_per_frame1=fbx = 0.5 + q1 * cos(6.2831 / 3) - q2 * sin(6.2831 / 3);
wave_3_per_frame2=fby = 0.5 + q1 * sin(6.2831 / 3) + q2 * cos(6.2831 / 3);
wave_3_per_frame3=ox = 0.5 * (q1 + 0.5 + fbx);
wave_3_per_frame4=oy = 0.5 * (q2 + 0.5 + fby);
wave_3_per_frame5=nx = 0.5 + (ox - 0.5) * cos(q8) - (oy - 0.5) * sin(q8);
wave_3_per_frame6=ny = 0.5 + (ox - 0.5) * sin(q8) + (oy - 0.5) * cos(q8);
wave_3_per_frame7=t1 = nx;
wave_3_per_frame8=t2 = ny;
wave_3_per_frame9=nx = 0.5 + (fbx - 0.5) * cos(q8) - (fby - 0.5) * sin(q8);
wave_3_per_frame10=ny = 0.5 + (fbx - 0.5) * sin(q8) + (fby - 0.5) * cos(q8);
wave_3_per_frame11=t3 = sqrt(sqr(ox - fbx) + sqr(oy - fby));
wave_3_per_frame12=t4 = 0.5 * sqrt(q1 * q1 + q2 * q2);
wave_3_per_frame13=t5 = atan2(t2 - ny, t1 - nx);
wave_3_per_frame14=b = b + 0.2 * (1 - q5);
wave_3_per_point1=v1 = t3 * (1 + 0.3 * (1 + q7) * value1 * (1 - sqr(2 * abs(sample - 0.5)))) * cos(3.1415 * sample);
wave_3_per_point2=v2 = t4 * (1 + 0.3 * (1 + q7) * value2 * (1 - sqr(2 * abs(sample - 0.5)))) * sin(3.1415 * sample);
wave_3_per_point3=v2 = v2 * pow(1 - abs(sample - 0.5), 1.3);
wave_3_per_point4=a = max(q7, 0.15 * abs(cos(4.32 * time + 0.63 + sin(7.3 * time + 1.07))) * (1 - sqrt(2 * abs(sample - 0.5))));
wave_3_per_point5=nx = v1 * cos(t5) - v2 * sin(t5);
wave_3_per_point6=ny = v1 * sin(t5) + v2 * cos(t5);
wave_3_per_point7=x = nx + t1;
wave_3_per_point8=y = ny + t2;
