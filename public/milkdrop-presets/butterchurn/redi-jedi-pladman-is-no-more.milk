shape_0_init12=q3 = 0;
shape_0_per_frame1=bb = bb + 0.0001 * (q10 + q11);
shape_0_per_frame2=tex_ang = q7 - q6;
shape_0_per_frame3=rad = 0.1 + 0.1 * (q10 - q11);
shape_0_per_frame4=tex_zoom = (0.7 - 0.4 * sin(20 * (bb - q4 + q5) + 0.5 * mod(q3, 8))) / rad;

[warp_shader]
shader_body { 
  vec2 newuv_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv_orig);
  float tmpvar_3;
  tmpvar_3 = ((tmpvar_2.y - tmpvar_2.z) * 0.1);
  vec2 tmpvar_4;
  tmpvar_4.x = (0.5 + (q7 * 0.3));
  tmpvar_4.y = (0.5 + (q6 * 0.3));
  float tmpvar_5;
  tmpvar_5 = sin(tmpvar_3);
  float tmpvar_6;
  tmpvar_6 = cos(tmpvar_3);
  vec2 tmpvar_7;
  tmpvar_7.x = (((uv_orig.x - tmpvar_4.x) * tmpvar_6) - ((uv_orig.y - tmpvar_4.y) * tmpvar_5));
  tmpvar_7.y = (((uv_orig.x - tmpvar_4.x) * tmpvar_5) + ((uv_orig.y - tmpvar_4.y) * tmpvar_6));
  newuv_1 = (tmpvar_7 + tmpvar_4);
  newuv_1 = (newuv_1 - vec2(0.5, 0.5));
  newuv_1 = (newuv_1 * (1.0 + (tmpvar_2.x * 0.1)));
  newuv_1 = (newuv_1 + vec2(0.5, 0.5));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = (0.9996 * texture (sampler_main, newuv_1).xyz);
  ret = tmpvar_8.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.98);
  ret = tmpvar_1.xyz;
 }
