per_frame_init_37=avgdb = 0;
per_frame_init_38=db = 0.001;
per_frame_init_39=dt = 0.001;
per_frame_init_40=avgdb = bass - bass_att;
per_frame_init_41=avgdt = treb - treb_att;
per_frame_init_42=lbass = 0;
per_frame_init_43=ltreb = 0;
per_frame_init_44=avgbbeatrate = 0.5;
per_frame_init_45=beatb = 0;
per_frame_init_46=beatb2 = 0;
per_frame_init_47=lbbtime2 = time;
per_frame_init_48=rawbeatb = 0;
per_frame_init_49=lbbtime = time;
per_frame_init_50=avgdb = 0.01;
per_frame_init_51=vol = 0;
per_frame_init_52=avgvol = 1;
per_frame_init_53=ph = 0;
per_frame_init_54=phase = 0;
per_frame_init_55=bool = 0;
per_frame_init_56=const = 0.01;
per_frame_init_57=mtime = 100 + 1000 * bass_att;
per_frame_init_58=mtime2 = 100 + 1000 * treb_att;
per_frame_1=db = (bass - lbass) * fps;
per_frame_2=dt = (treb - ltreb) * fps;
per_frame_3=ltreb = treb;
per_frame_4=lbass = bass;
per_frame_5=avgdb = 0.9 * avgdb + 0.1 * abs(db);
per_frame_6=avgdt = 0.9 * avgdt + 0.1 * abs(dt);
per_frame_7=lavgdb = 0.99 * lavgdb + 0.01 * abs(db);
per_frame_8=lavgdt = 0.99 * lavgdt + 0.01 * abs(dt);
per_frame_9=rawbeatb = above(abs(db), avgdt);
per_frame_10=beatb = rawbeatb * above(time - lbbtime, 0.75 * avgbbeatrate);
per_frame_11=beatb2 = beatb * above(abs(dt), avgdb);
per_frame_12=beatbhard = beatb2 * (abs(db) - 3 * avgdb);
per_frame_13=avgbbeatrate = beatb * (0.99 * avgbbeatrate + 0.01 * (time - lbbtime)) + (1 - beatb) * (avgbbeatrate + 0.00001 * (3 - avgbbeatrate));
per_frame_14=lbbtime2 = time * beatb2 + (1 - beatb2) * lbbtime2;
per_frame_15=lbbtime = time * beatb + (1 - beatb) * lbbtime;
per_frame_16=ph = (time - lbbtime2) * (60 / avgbbeatrate) * const;
per_frame_17=phase = max(min(ph, 1), 0);
per_frame_18=const = const * (1 - beatb2) + beatb2 * (const + 0.001 * bool);
per_frame_19=bool = below(phase, 0.98) * (0.99 - ph) - 0.5 * above(phase, 0.98) * ph;
per_frame_20=bc = bc + beatb;
per_frame_21=vol = rawbeatb * abs(db) * 0.001;
per_frame_22=avgvol = 0.999 * avgvol + 0.01 * vol;
per_frame_23=mtime = mtime + (min(0.01 * avgdt, 0.25) - 0.01 * beatbhard * dt) * (1 / fps);
per_frame_24=mtime2 = mtime2 + (min(0.01 * avgdb, 0.25) + 0.01 * beatbhard * db) * (1 / fps);
per_frame_25=q1 = phase;
per_frame_26=q2 = 60 / avgbbeatrate;
per_frame_27=q3 = bc;
per_frame_28=q4 = mtime;
per_frame_29=q5 = mtime2;
per_frame_30=q6 = 0.5 * sin(2 * mtime) + 0.5;
per_frame_31=q7 = 0.5 * sin(2 * mtime2) + 0.5;
per_frame_32=q8 = 0.5 * sin(10 * mtime) + 0.5;
per_frame_33=q9 = 0.5 * sin(10 * mtime2) + 0.5;
per_frame_34=q10 = avgdb;
per_frame_35=q11 = avgdt;
per_frame_36=q12 = lavgdb;
per_frame_37=q13 = lavgdt;
per_frame_38=monitor = q7;
per_frame_39=decay = 1;
per_frame_40=warp = 0;
per_frame_41=wrap = 1;
per_frame_42=zoom = 1;
per_frame_43=ob_r = q8;
per_frame_44=ob_g = q7;
per_frame_45=ob_b = q6;
wave_0_per_point1=x = pow(sample, 0.5);
wave_0_per_point2=y = max(value2 * mod(frame, 2), 0.5 * bass_att - 0.3 * treb_att) - min(0.5 * bass_att - 0.3 * treb_att, value1 * (1 - mod(frame, 2)));
wave_0_per_point3=r = value1 - bass;
wave_0_per_point4=g = value2 - treb;
wave_0_per_point5=b = 1 - (value1 + value2 + mid);
shape_0_init1=bb = 0;
