shape_0_per_frame1=rand1 = if(0.00001 < abs(equal(instance, 0)), t1, rand1);
shape_0_per_frame2=rand2 = if(0.00001 < abs(equal(instance, 0)), t2, rand2);
shape_0_per_frame3=rand1 = 4 * rand1 * (1 - rand1);
