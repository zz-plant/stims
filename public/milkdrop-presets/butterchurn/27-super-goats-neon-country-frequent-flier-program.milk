[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_fc_main, uv).xyz;
  ret_1 = (ret_1 + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).y * 2.0)
   - 1.0) * 0.002));
  vec2 tmpvar_2;
  tmpvar_2.x = (0.5 + (0.5 * sin(
    -(uv.x)
  )));
  tmpvar_2.y = (0.8 - uv.y);
  ret_1 = (ret_1 + ((
    ((((texture (sampler_blur1, 
      (tmpvar_2 + 0.1)
    ).xyz * scale1) + bias1).zzz * tmpvar_2.y) * tmpvar_2.y)
   * tmpvar_2.y) * 0.005));
  ret_1 = (ret_1 * 0.978);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 2.0);
  ret_1 = (ret_1 + ((texture (sampler_blur1, uv).xyz * scale1) + bias1));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
