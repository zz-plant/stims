shape_0_per_frame13=rad = 0.02 * treb + 3 * bass * sin(3.141 * x) * 0.05 * (1 - 0.5 * rand1);
shape_0_per_frame14=sides = mod(100 * rand2, 9) + 4;
shape_0_per_frame15=a = if(0.00001 < abs(above(y, 0.18)), 0, a);
shape_1_per_frame1=rad = 0.1 * bass;
