per_frame_init_67=mtime = 100 + 1000 * bass_att;
per_frame_1=db = (bass - lbass) * fps;
per_frame_2=ltreb = treb;
per_frame_3=avgdb = 0.9 * avgdb + 0.1 * abs(db);
per_frame_4=avgdb2 = 0.99 * avgdb2 + 0.01 * abs(db);
per_frame_5=rbeatb = above(abs(db), 2 * avgdb);
per_frame_6=beatb = rbeatb * above(time - lbt, 0.75 * avgbr);
per_frame_7=decay_rate = pow(0.993, fps);
per_frame_8=min_att = 2.5;
per_frame_9=decay_to = 1;
per_frame_10=beat = bass / max(min_att, bass_att);
per_frame_11=beat = max(beat, mid / max(min_att, mid_att));
per_frame_12=beat = max(beat, treb / max(min_att, treb_att));
per_frame_13=beat = max(beat, (prev_beat - decay_to) * decay_rate + decay_to);
per_frame_14=beat_level = 24 * (beat - prev_beat - 0.07) + 1;
per_frame_15=is_beat = above(beat_level, 0.5);
per_frame_16=prev_beat = beat;
per_frame_17=beatb2 = is_beat;
per_frame_18=avgbr = beatb * (0.99 * avgbr + 0.01 * (time - lbt)) + (1 - beatb) * (avgbr + 0.00001 * (3 - avgbr));
per_frame_19=avgbr2 = beatb2 * (0.99 * avgbr2 + 0.01 * (time - lbt2)) + (1 - beatb2) * (avgbr2 + 0.00001 * (3 - avgbr2));
per_frame_20=lbt = time * beatb + (1 - beatb) * lbt;
per_frame_21=lbt2 = time * beatb2 + (1 - beatb2) * lbt2;
per_frame_22=ph = (time - lbt) * (60 / avgbr) * const;
per_frame_23=phase = max(min(ph, 1), 0);
per_frame_24=const = const * (1 - beatb) + beatb * (const + 0.002 * bool);
per_frame_25=bool = below(phase, 0.98) * (0.98 - ph) - 0.5 * above(phase, 0.98) * ph;
per_frame_26=ph2 = (time - lbt2) * (60 / avgbr2) * const2;
per_frame_27=phase2 = max(min(ph2, 1), 0);
per_frame_28=const2 = const2 * (1 - beatb2) + beatb2 * (const2 + 0.002 * bool2);
per_frame_29=bool2 = below(phase2, 0.98) * (0.98 - ph2) - 0.5 * above(phase2, 0.98) * ph2;
per_frame_30=bc = bc + beatb;
per_frame_31=bc2 = bc2 + beatb2;
per_frame_32=mtime = mtime + avgdb * avgbr * 0.1 * (1 / fps);
per_frame_33=mtime2 = mtime2 + avgdt * avgbr2 * 0.1 * (1 / fps);
per_frame_34=q1 = 1 - phase;
per_frame_35=q2 = 1 - phase2;
per_frame_36=q3 = bc;
per_frame_37=q4 = bc2;
per_frame_38=q5 = mtime;
per_frame_39=q6 = mtime2;
per_frame_40=q7 = 0.5 * sin(mtime) + 0.5;
per_frame_41=q8 = 0.5 * sin(mtime2) + 0.5;
per_frame_42=q9 = 0.5 * sin(0.01 * mtime) + 0.5;
per_frame_43=q10 = 0.5 * sin(0.01 * mtime2) + 0.5;
per_frame_44=q11 = avgdb;
per_frame_45=q12 = avgdt;
per_frame_46=q14 = 60 / avgbr;
per_frame_47=q15 = 60 / avgbr2;
per_frame_48=q20 = beatb;
per_frame_49=q21 = beatb2;
per_frame_50=q22 = mod(bc, 4);
per_frame_51=q23 = mod(bc2, 4);
