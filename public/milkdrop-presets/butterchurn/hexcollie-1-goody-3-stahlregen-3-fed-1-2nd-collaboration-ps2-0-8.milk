per_frame_init_1=q1 = 0;
per_frame_init_2=dvy = 0;
per_frame_init_3=vx = 0;
per_frame_init_4=vy = 0;
per_frame_init_5=vang = 0;
per_frame_init_6=xv = 0;
per_frame_init_7=dvx = 0;
per_frame_init_8=bb = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=q3 = 0;
per_frame_init_11=yv = 0;
per_frame_1=q1 = 0.5 + 0.4 * sin(0.43 * time + 0.12 * bass_att);
per_frame_2=q2 = 0.5 + 0.4 * sin(0.63 * time + 0.14 * bass_att);
per_frame_3=q3 = 0.5 + 0.4 * sin(0.83 * time + 0.16 * bass_att);
per_frame_4=ob_b = 0.01 * mod(frame, 40);
per_frame_5=bb = 0.016 * bass_att + 0.98 * bb;
per_frame_6=mv_x = 30 * bb;
per_frame_7=mv_dx = mv_dx + 0.1 * sin(time) + 0.01 * mv_x - 0.3;
per_frame_8=monitor = mv_x;
per_frame_9=wave_mystery = 0.01 * floor(randint(150)) - 0.01 * floor(randint(150));
per_pixel_1=xv = sin(0.333 * time) * x * cos(0.667 * time) * x;
per_pixel_2=yv = cos(0.333 * time) * y * sin(0.667 * time) * y;
per_pixel_3=x = xv;
per_pixel_4=y = yv;
per_pixel_5=vang = 0.0628318 * sin(0.2 * time) - 1.68;
per_pixel_6=vx = (x - 0.5) * cos(vang) - (y - 0.5) * sin(vang) + 0.5;
per_pixel_7=vy = (x - 0.5) * sin(vang) + (y - 0.5) * cos(vang) + 0.5;
per_pixel_8=dvx = 0.01 + 0.01 * floor(randint(2));
per_pixel_9=dvy = -0.01;
per_pixel_10=dx = dvx * cos(vang) - dvy * sin(vang);
per_pixel_11=dy = -dvx * sin(vang) - dvy * cos(vang);
per_pixel_12=dy = below(y, 0.2) * dy + 0.01 * above(y, 0.1);
per_pixel_13=dx = below(x, 0.2) * dx + 0.01 * above(x, 0.1);
per_pixel_14=sx = sx + 0.075 * sin(3 * x);
per_pixel_15=sy = sy + 0.075 * sin(3.1 * y);
per_pixel_16=cx = 0.5 + 0.15 * sin(time);
per_pixel_17=cy = 0.5 + 0.15 * cos(time);
per_pixel_18=rot = rot + 0.05 * sin(10 * rad - 5 * time) * treb_att - 0.005 * cos(time * rad);
shape_0_init1=q1 = 0;
shape_0_init2=q2 = 0;
shape_0_init3=q3 = 0;
shape_0_init4=q1 = 0;
shape_0_init5=q2 = 0;
shape_0_init6=q3 = 0;
shape_0_per_frame1=r = q1;
shape_0_per_frame2=b = q2;
shape_0_per_frame3=g = q3;
shape_0_per_frame4=r2 = 1 - abs(q1);
shape_0_per_frame5=b2 = q2;
shape_0_per_frame6=g2 = q3;
shape_0_per_frame7=ang = ang + 12 * tan(time);
shape_0_per_frame8=x = x + 0.15 * sin(time);
shape_0_per_frame9=y = y + 0.15 * cos(time);
shape_0_per_frame10=a = 0.5 + 0.5 * sin(bass_att);
shape_0_per_frame11=a2 = 0.5 + 0.5 * cos(bass_att);

[warp_shader]
uniform sampler2D sampler_fw_clouds;
 shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (normalize((uv - uv_orig)) * texsize.zw);
  vec4 tmpvar_3;
  tmpvar_3.w = 0.0;
  tmpvar_3.xyz = ret_1;
  vec4 tmpvar_4;
  tmpvar_4.w = 0.0;
  tmpvar_4.xyz = max (tmpvar_3, (texture (sampler_main, (uv + tmpvar_2)) * 0.97)).xyz;
  vec4 tmpvar_5;
  tmpvar_5.w = 0.0;
  tmpvar_5.xyz = max (tmpvar_4, (texture (sampler_main, (uv - tmpvar_2)) * 0.97)).xyz;
  vec4 tmpvar_6;
  tmpvar_6.w = 0.0;
  tmpvar_6.xyz = max (tmpvar_5, (texture (sampler_main, (uv + 
    (tmpvar_2 * 2.0)
  )) * 0.9)).xyz;
  ret_1 = (max (tmpvar_6, (texture (sampler_main, 
    (uv - (tmpvar_2 * 2.0))
  ) * 0.9)).xyz - (0.85 * (
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1)));
  ret_1 = (ret_1 + (texture (sampler_fw_clouds, uv) * 0.25).xyz);
  ret_1 = ((ret_1 - 0.05) * 0.98);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_1;
  ret = tmpvar_7.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  vec2 tmpvar_3;
  tmpvar_3.x = (uv.x + 0.001);
  tmpvar_3.y = uv.y;
  vec4 tmpvar_4;
  tmpvar_4 = texture (sampler_main, tmpvar_3);
  float tmpvar_5;
  tmpvar_5 = abs(((
    (((tmpvar_2.x + tmpvar_2.y) + tmpvar_2.z) - tmpvar_4.x)
   - tmpvar_4.y) - tmpvar_4.z));
  if ((tmpvar_5 > 0.1)) {
    ret_1 = ((texture (sampler_blur2, uv).xyz * scale2) + bias2);
  } else {
    ret_1 = ((texture (sampler_blur3, uv).xyz * scale3) + bias3);
  };
  ret_1 = (ret_1 + (0.66 * (
    (texture (sampler_blur2, uv).xyz * scale2)
   + bias2)));
  float tmpvar_6;
  tmpvar_6 = ret_1.x;
  ret_1 = (ret_1 * 2.0);
  float tmpvar_7;
  tmpvar_7 = dot (ret_1, vec3(0.32, 0.49, 0.29));
  vec3 tmpvar_8;
  tmpvar_8 = mix ((0.75 * vec3(tmpvar_7)), (vec3(tmpvar_7) * (
    ((texture (sampler_blur3, uv).xyz * scale3) + bias3)
   - 
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  )), ((
    (0.5 * rand_preset)
  .xyz + 
    (0.5 * _qa.xyz)
  ) * vec3(tmpvar_7)));
  ret_1 = (tmpvar_8 + (tmpvar_6 * tmpvar_8));
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = ret_1;
  ret = tmpvar_9.xyz;
 }
