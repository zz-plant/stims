per_frame_1=decay = 0;
per_frame_2=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_3=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_4=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_5=x1 = 0.5 + 3 * (xx1 - xx2);
per_frame_6=y1 = 1 - 0.75 * yy1;
per_frame_7=spring = 20;
per_frame_8=grav = 0.65 - 0.25 * yy1;
per_frame_9=resist = 0.03;
per_frame_10=bounce = 1;
per_frame_11=dt = 0.0005;
per_frame_12=spx2 = (x1 + x3 - 2 * x2) * spring;
per_frame_13=spy2 = (y1 + y3 - 2 * y2) * spring;
per_frame_14=spx3 = (x2 + x4 - 2 * x3) * spring;
per_frame_15=spy3 = (y2 + y4 - 2 * y3) * spring;
per_frame_16=spx4 = (x3 - x4) * spring;
per_frame_17=spy4 = (y3 - y4) * spring;
per_frame_18=vx2 = vx2 * (1 - resist) + dt * spx2;
per_frame_19=vy2 = vy2 * (1 - resist) + dt * (spy2 - grav);
per_frame_20=vx3 = vx3 * (1 - resist) + dt * spx3;
per_frame_21=vy3 = vy3 * (1 - resist) + dt * (spy3 - 1.5 * grav);
per_frame_22=vx4 = vx4 * (1 - resist) + dt * spx4;
per_frame_23=vy4 = vy4 * (1 - resist) + dt * (spy4 - 4 * grav);
per_frame_24=x2 = x2 + vx2;
per_frame_25=y2 = y2 + vy2;
per_frame_26=x3 = x3 + vx3;
per_frame_27=y3 = y3 + vy3;
per_frame_28=x4 = x4 + vx4;
per_frame_29=y4 = y4 + vy4;
per_frame_30=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_31=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_32=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_33=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_34=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_35=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_36=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_37=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_38=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_39=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_40=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_41=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_42=q1 = x1;
