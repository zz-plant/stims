per_frame_1=decay = 1;
per_frame_2=vol = vol;
per_frame_3=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_4=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_5=zoom = 1;
per_frame_6=musictime = musictime + vol;
per_frame_7=q4 = 0.3 * sin(0.02 * musictime);
per_frame_8=q5 = 0.3 * sin(0.01 * musictime);
per_frame_9=dx = 0.01 * sin(0.1 * musictime);
per_frame_10=dy = 0.01 * cos(0.069 * musictime);
per_frame_11=monitor = rot;
per_pixel_1=radd = rad - 0.000000001 * time;
per_pixel_2=q1 = 0.4 * rad;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_5=zm = 1;
per_pixel_6=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_7=star = sin(6 * ag + time) * (2 - rd - ag) / 5;
per_pixel_8=zm = zm + star / 10;
per_pixel_9=sx = zm;
per_pixel_10=sy = zm;
per_pixel_11=q1 = 0.4 * x;
per_pixel_12=q2 = 0.3 * x;
per_pixel_13=q3 = below(x, 0.1 * q5 + 0.3);
per_pixel_14=q7 = if(0.00001 < abs(q3), 0, 10 + floor(1 * x));
per_pixel_15=q8 = if(0.00001 < abs(q3), 0, 10 + floor(1 * x));
per_pixel_16=cx = if(0.00001 < abs(q3), 0.5, band(0, x * q7 - q1) * (1 / q7) + 0.1 * q1);
per_pixel_17=cy = if(0.00001 < abs(q3), 0.5, band(0, y * q8 - q2) * (1 / q8) + 0.1 * q2);
per_pixel_18=rot = if(0.00001 < abs(q3), 2 * q6 * x, 0.1 * x + 0.1 * bass + 0 * cx * cy);
per_pixel_19=zoom = if(0.00001 < abs(q3), 0.3 + 0.1 * q5 + 0.5 * q4, zoom);
per_pixel_20=rot = 0.01 * sin(0.5 * q2 * q4 + 10 * rad * sin(0.1 * q2));
per_pixel_21=it = 0.3 * sin(0.2 * time);
per_pixel_22=radm = 0.5 * rad;
per_pixel_23=rot = 0.02 * sin(30 * (radm + it)) / (20 * (rad + 0.1) * (0.4 * sin(time) + 0.5));
per_pixel_24=mod = sin(5 * ang);
per_pixel_25=mod = mod * mod;
per_pixel_26=zoom = 0.99 - abs(0.01 * mod);
per_pixel_27=mx = 1.33 * (x - 0.5);
per_pixel_28=my = y - 0.5;
per_pixel_29=sw = above(rad, 0.4) + below(rad, 0.04) + above(rad, 0.3) * below(rad, 0.4) * (rad - 0.3) * 5;
per_pixel_30=sw = above(rad, 0.3) * (rad - 0.3) * 5;
per_pixel_31=zoom = 1 - 0.1 * sw;
per_pixel_32=rot = 0.2 * sw;
per_pixel_33=dx = (1 - sw) * sin(ang) * 0.00075;
per_pixel_34=dy = (1 - sw) * cos(ang) * 0.001;
per_pixel_35=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_36=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_37=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_38=zoom = zoom + 0.01;
per_pixel_39=zoom = zoom + 0.2 * (0.05 + 0.04 * sin(time)) * sin(ang * time);
per_pixel_40=rot = rot + 0.005 * cos(5 * ang * bass * time);
per_pixel_41=dx = dx + 0.1 * above(rad, 0.25) * dx_r;
per_pixel_42=dy = dy + 0.1 * above(rad, 0.25) * dy_r;
per_pixel_43=zoom = if(0.00001 < abs(q3), 0.3 + 0.1 * q5 + 0.5 * q4, zoom);
per_pixel_44=rot = 0.01 * sin(0.5 * q2 * q4 + 10 * rad * sin(0.1 * q2));
per_pixel_45=sx = -1.2;
per_pixel_46=rot = 11;
per_pixel_47=dx = dx - 0.05 * sin(1.35 * time + 18 * (2 * x - 1));
per_pixel_48=dy = dy - 0.05 * sin(1.79 * time + 9 * (2 * y - 1));
shape_0_init1=q4 = 0;
