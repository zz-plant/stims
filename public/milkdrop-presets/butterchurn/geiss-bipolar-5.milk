[preset00]
fRating=0.000000
fGammaAdj=1.998000
fVideoEchoZoom=1.904763
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
bWaveDots=1.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.900000
fWaveScale=0.559785
fWaveSmoothing=0.900000
fWaveParam=0.200000
fModWaveAlphaStart=1.150000
fModWaveAlphaEnd=1.310000
fWarpScale=2.853000
fRot=0.001440
fWarp=0.000000
fWaveR=0.600000
fWaveG=0.800000
fWaveB=0.950000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.1 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.05 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.049 * (0.6 * sin(0.816 * time) + 0.4 * sin(1.036 * time));
per_frame_4=decay = decay - 0.01 * equal(mod(frame, 40), 0);
per_frame_5=rot = rot + 0.01 * sin(0.1 * time);
per_pixel_1=zoom = 0.745 + 0.5 * rad;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (mix (texture (sampler_main, uv).xyz, texture (sampler_main, (
    -(((uv - 0.5) * 0.525))
   + 0.5)).xyz, vec3(0.5, 0.5, 0.5)) * 2.0);
  ret = tmpvar_1.xyz;
 }
