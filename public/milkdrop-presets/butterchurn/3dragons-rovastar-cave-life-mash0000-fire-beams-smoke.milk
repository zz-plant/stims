per_frame_13=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_14=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_15=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_16=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_17=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_18=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_19=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_20=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_21=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_22=countertime = if(0.00001 < abs(beat), time, countertime);
per_frame_23=counter = -1 * pow(min(time - countertime - 3, 0), 3);
per_frame_24=counter2 = -1 * pow(min(time - countertime - 2.7, 0), 5);
per_frame_25=q4 = oldq4 + 0.00045 * counter2;
per_frame_26=oldq4 = q4;
per_frame_27=q3 = oldq3 + 0.001 * counter;
per_frame_28=oldq3 = q3;
per_frame_29=mv_dx = mv_dx - 0.03 * sin(q3);
per_frame_30=dx = dx + 0.0005 * sin(q4);
per_frame_31=mv_r = 0.5 + 0.5 * sin(0.924 * time);
per_frame_32=mv_b = 0.5 + 0.5 * sin(1.215 * time);
per_frame_33=mv_g = 0.5 + 0.5 * sin(1.41 * time);
per_frame_34=monitor = q4;
per_frame_35=ib_r = 0.5 + 0.5 * cos(q4);
per_frame_36=ob_b = 0.5 + 0.5 * sin(q3);
per_frame_37=ib_g = 0.5 + 0.5 * sin(q4 - q3);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = dot ((texture (sampler_main, (uv + vec2(0.005, 0.007))) - texture (sampler_main, (uv - vec2(0.005, 0.007)))), vec4(0.32, 0.49, 0.29, 0.0));
  tmpvar_2.y = dot ((texture (sampler_main, (uv + vec2(-0.007, 0.005))) - texture (sampler_main, (uv - vec2(-0.007, 0.005)))), vec4(0.32, 0.49, 0.29, 0.0));
  vec3 tmpvar_3;
  tmpvar_3 = ((texture (sampler_blur1, uv).xyz * scale1) + bias1);
  ret_1 = (((
    -(tmpvar_3)
   * 0.1) + (
    (texture (sampler_main, (uv - ((tmpvar_2 * 
      (1.0 - tmpvar_3)
    .xy) * 0.02))).xyz + ((vec3(dot (texture (sampler_noise_lq, 
      ((((texsize.xy * texsize_noise_lq.zw).x * uv) * 0.5) + (0.1 * rand_frame).xy)
    ), vec4(0.32, 0.49, 0.29, 0.0))) * 0.12) - (0.01 * pow (
      (1.0 - rad)
    , 4.0))))
   * 1.1)) * 0.97);
  ret_1 = (ret_1 - 0.05);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }
