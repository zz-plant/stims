per_frame_1=basstime = basstime + 0.03 * bass_att;
per_frame_2=q1 = basstime;
per_frame_3=vol = pow(bass + mid + treb, 2);
per_frame_4=basssum = vol;
per_frame_5=basstime = if(0.00001 < abs(below(basstime, 465)), 465, basstime);
per_frame_6=stickybit = mod(time, 2);
per_frame_7=volavg = volavg + vol * equal(stickybit, 1);
per_frame_8=sample1 = sample1 + equal(stickybit, 1);
per_frame_9=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_10=sample2 = sample2 + equal(stickybit, 0);
per_frame_11=edge = bnot(equal(bit2, stickybit));
per_frame_12=volavg = volavg - volavg * edge * stickybit;
per_frame_13=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_14=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_15=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_16=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_17=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_18=q3 = diff;
per_frame_19=bit2 = mod(time, 2);
per_frame_20=difftime = difftime + 0.03 * diff;
per_frame_21=q2 = difftime;
per_frame_22=difftime = if(0.00001 < abs(above(difftime, 2000)), 0, difftime);
per_frame_23=spintime = spintime + 0.03 * bass * if(0.00001 < abs(equal(mod(state, 2), 1)), 1, -1);
per_frame_24=q8 = spintime;
per_frame_25=state = state + above(diff, 10);
per_frame_26=monitor = spintime;
per_pixel_1=zoom = 1.05 - 0.04 * sin(q3);
per_pixel_2=rot = 0;
