per_frame_init_1=q1 = 0;
per_frame_init_2=oldq1 = 0;
per_frame_1=ib_r = 0.5 + 5.499 * (0.6 * sin(0.933 * time / 3) + 0.4 * sin(1.045 * time / 3));
per_frame_2=ib_g = 0.5 + 5 * (0.6 * sin(0.9 * time / 3) + 0.4 * sin(0.956 * time / 3));
per_frame_3=ib_b = 0.5 + 5.499 * (0.6 * sin(0.91 * time / 3) + 0.4 * sin(0.92 * time / 3));
per_frame_4=wave_a = 0;
per_frame_5=decay = 1;
per_frame_6=zoom = -1;
per_frame_7=rot = 0;
per_frame_8=warp = 0;
per_frame_9=q1 = oldq1 + 0.005 * (bass + bass_att + bass * bass_att - 1);
per_frame_10=oldq1 = below(q1, 30000) * q1;
per_frame_11=monitor = q1;
per_pixel_1=dx = 0.001 * (bass * bass + bass_att) * sin(5 * sin(sqrt(4) - rad) + 5 * rad * sin(q1)) * y * ang;
per_pixel_2=dy = 0.001 * (bass * bass + bass_att) * cos(5 * sin(sqrt(4) - rad) + 5 * -rad * sin(q1)) * x * rad * ang;
per_pixel_3=rot = sin(time / (0.5 * rad)) * x / (cos(time / rad) / (ang / 3) / x / ((0.5 * sin(time / 6) + 0.5) * y));
per_pixel_4=warp = 3 * (cos(time / 10) * y / (sin(time / 6) / (rad * (0.5 * sin(time / 3) + 0.5)) * y * x));
shape_0_per_frame1=rad = 0.2 + 0.1 * ((bass_att + mid_att + treb_att) / 3);
shape_1_init1=q1 = 0;
shape_1_per_frame1=ang = q1 + 3.1415;
