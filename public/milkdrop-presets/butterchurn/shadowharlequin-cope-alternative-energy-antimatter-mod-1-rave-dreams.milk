bDarken=1.000000
fWaveAlpha=1.060000
fWaveScale=0.829000
fWaveSmoothing=0.549000
fWaveParam=-1.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=0.403000
fZoomExponent=1.001600
fZoom=1.029800
fWarp=0.010000
fSx=0.990100
fSy=0.970780
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=0.050000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.500000
fMotionVectorsR=0.100000
fMotionVectorsG=0.100000
fMotionVectorsB=0.100000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q12 = 0;
per_frame_init_2=q6 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=wg = 0;
per_frame_init_5=q11 = 0;
per_frame_init_6=q10 = 0;
per_frame_init_7=wb = 0;
per_frame_init_8=vol = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=wr = 0;
per_frame_init_11=q7 = 0;
per_frame_init_12=mtime = 0;
per_frame_init_13=q8 = 0;
per_frame_1=wave_r = wave_r + 0.5 * (0.6 * sin(1.3 * time) + 0.4 * sin(0.98 * time));
per_frame_2=wave_b = wave_b + 0.5 * (0.6 * sin(1.1 * time) + 0.4 * sin(0.78 * time));
per_frame_3=wave_g = wave_g + 0.5 * (0.6 * sin(1.2 * time) + 0.4 * sin(0.6 * time));
per_frame_4=q8 = wave_r;
per_frame_5=q7 = wave_b;
per_frame_6=q6 = wave_g;
per_frame_7=wr = 0.5 + 0.3 * (0.6 * sin(1.8 * time) + 0.4 * sin(0.8 * time));
per_frame_8=wb = 0.5 + 0.3 * (0.6 * sin(1.67 * time) + 0.4 * sin(0.5 * time));
per_frame_9=wg = 0.5 + 0.3 * (0.6 * sin(1.92 * time) + 0.4 * sin(0.4 * time));
per_frame_10=q10 = wr;
per_frame_11=q11 = wb;
per_frame_12=q12 = wg;
per_frame_13=vol = 0.1 * (9 * vol + 0.333333 * (bass_att + mid_att + treb_att));
per_frame_14=q1 = vol;
per_frame_15=monitor = vol;
per_frame_16=mtime = mtime + 0.01 * vol;
per_frame_17=q2 = 0.25 * mtime;
per_frame_18=wave_mystery = wave_mystery + 0.6 * vol;
per_frame_19=sy = sy + 0.02 * vol;
per_frame_20=sx = sy;
per_frame_21=cx = cx + 0.2 * sin(treb_att);
per_frame_22=cy = cy - 0.3 * sin(1.2 * treb_att);
per_frame_23=wave_a = mid_att + 0.35 * treb_att;
per_frame_24=mv_l = 0.35 * treb_att + 0.15 * mid_att;
per_frame_25=mv_a = 0.15 * treb_att;
per_frame_26=mv_g = mv_g + sin(0.45 * treb_att);
per_frame_27=mv_b = mv_b + sin(0.2 * treb_att);
per_frame_28=mv_r = mv_r + sin(0.35 * treb_att);
per_frame_29=wave_mode = 21 * sin(0.35 * treb_att);
per_pixel_1=rot = log(x + 0.1) * (x + 0.1);
per_pixel_2=rot = rot * 0.1;
per_pixel_3=rot = rot + sin(0.02 * treb_att);

[warp_shader]
shader_body { 
  vec3 noise2_1;
  vec3 ret_2;
  vec4 tmpvar_3;
  tmpvar_3 = texture (sampler_main, uv);
  vec3 tmpvar_4;
  tmpvar_4.x = q8;
  tmpvar_4.y = q7;
  tmpvar_4.z = q6;
  vec3 tmpvar_5;
  tmpvar_5.x = q10;
  tmpvar_5.y = q11;
  tmpvar_5.z = q12;
  noise2_1 = (texture (sampler_noise_lq, ((
    (uv_orig * texsize.xy)
   * texsize_noise_lq.zw) + rand_frame.xy)).xyz * (1.7 * mix (tmpvar_4, tmpvar_5, vec3(
    (1.0 - rad)
  ))));
  vec3 a_6;
  a_6 = (tmpvar_3.xyz * 0.7);
  ret_2 = (tmpvar_3.xyz + clamp ((
    (a_6.yzx * noise2_1.zxy)
   - 
    (a_6.zxy * noise2_1.yzx)
  ), 0.0, 1.0));
  ret_2 = (ret_2 * 0.9);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_2;
  ret = tmpvar_7.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 1.49);
  ret_1 = (ret_1 * (ret_1 + sin(
    (treb_att * 0.5)
  )));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
