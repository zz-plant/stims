  ret_4 = (ret_4 + ((
    (((rand_preset / 2.0) * 2.0) * (tmpvar_13 * tmpvar_13))
   / 4.0) * tmpvar_9).xyz);
  ret_4 = (ret_4 + ((
    (pow (sqrt(dot (x_12, x_12)), -2.0) * vec3(0.4, 0.8, 1.0))
   * 
    (0.2 + noise_3)
  ) * tmpvar_9));
  ret_4 = (ret_4 + ((
    (64.0 * ((texture (sampler_blur3, (
