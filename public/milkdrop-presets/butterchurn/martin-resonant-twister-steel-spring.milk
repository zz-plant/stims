    dot (ret_4, vec3(0.32, 0.49, 0.29))
  )), 0.0, 1.0);
  float x_10;
  x_10 = ((uv.y * 8.0) - (dot (ret_4, vec3(0.32, 0.49, 0.29)) * 5.0));
  ret_4 = (ret_4 * vec3((0.1 + (0.15 / 
