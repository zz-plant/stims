per_frame_1=wave_mystery = -1 * abs(sin(0.51 * time));
per_frame_2=cx = cx + sin(time) * if(0.00001 < abs(above(sin(time), 0)), -1 + bass, 1.3) * 0.5;
per_frame_3=cy = cy + cos(time) * if(0.00001 < abs(below(sin(time), 0)), -1 + bass, 1.3) * 0.6;
per_frame_4=mv_x = mv_x + 3 * sin(time / 1.8);
per_frame_5=mv_y = mv_x - 3.5 * sin(time / 2);
per_frame_6=wave_r = bass;
per_frame_7=wave_g = wave_g + 0.3 * sin(0.74 * time);
per_frame_8=wave_b = wave_b + 0.2 * sin(0.83 * time);
per_frame_9=mv_g = mv_g * abs(sin(time));
per_frame_10=mv_r = bass;
per_frame_11=mv_b = treb;
per_frame_12=ib_size = ib_size + 0.15 * bass;
per_frame_13=rot = 0.03 * sin(time);
per_frame_14=ib_r = 0.4 * abs(sin(1.5 * time));
per_frame_15=ib_g = 0.5 * abs(sin(1.53 * time));
per_frame_16=ib_b = 0.45 * abs(sin(1.51 * time));
per_pixel_1=zoom = zoom + 0.1 * rad;
