shapecode_0_r2=1.000000
shapecode_0_b2=1.000000
shapecode_0_a2=0.400000
shapecode_1_enabled=1.000000
shapecode_1_textured=1.000000
shapecode_1_rad=2.667180
shapecode_1_tex_zoom=0.377130
shapecode_1_g=1.000000
shapecode_1_b=1.000000
shapecode_1_a=0.700000
shapecode_1_r2=0.800000
shapecode_1_b2=1.000000
shapecode_1_a2=0.500000
shapecode_2_enabled=1.000000
shapecode_2_sides=100.000000
shapecode_2_r2=1.000000
shapecode_3_enabled=0.000000
per_frame_init_1=basstime = 0;
per_frame_init_2=q2 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q4 = 0;
per_frame_init_5=q5 = 0;
per_frame_init_6=state = 0;
per_frame_init_7=q3 = 0;
per_frame_1=basstime = basstime + 0.0006 * bass;
per_frame_2=q2 = basstime;
per_frame_3=q1 = 0.001 * basstime;
per_frame_4=q4 = cos(basstime);
per_frame_5=q5 = sin(basstime);
per_frame_6=state = if(0.00001 < abs(above(state, 5)), -4, state);
per_frame_7=state = state + above(bass, 1.5);
per_frame_8=monitor = state;
per_frame_9=q3 = state;
per_pixel_1=zoom = 1;
per_pixel_2=rot = 0;
shape_0_init1=basstime = 0;
shape_0_init2=basstime = 0;
shape_0_init3=ob_r = 0;
shape_0_init4=basstime = 0;
shape_0_init5=ob_g = 0;
shape_0_init6=basstime = 0;
shape_0_init7=ob_b = 0;
shape_0_init8=basstime = 0;
shape_0_per_frame1=ang = basstime;
shape_0_per_frame2=tex_ang = sin(basstime);
shape_0_per_frame3=ob_r = 0.5 * sin(1.12 * basstime);
shape_0_per_frame4=ob_g = 0.5 * sin(1.5 * basstime);
shape_0_per_frame5=ob_b = 0.5 * sin(2.12 * basstime);
shape_1_init1=tex_capture = 0;
shape_1_per_frame1=tex_capture = above(bass, 1);

[warp_shader]
shader_body { 
  float final_noise_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)].x = q5;
  tmpvar_2[uint(0)].y = -(q4);
  tmpvar_2[1u].x = q4;
  tmpvar_2[1u].y = q5;
  vec3 tmpvar_3;
  tmpvar_3.xy = uv;
  tmpvar_3.z = (q2 * 5.0);
  final_noise_1 = ((texture (sampler_noisevol_lq, (tmpvar_3 * 
    pow (q3, 0.0)
  )) * 2.0) - 1.0).x;
  final_noise_1 = (final_noise_1 + (0.5 * (
    (texture (sampler_noisevol_lq, (tmpvar_3 * q3)) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.25 * (
    (texture (sampler_noisevol_lq, (tmpvar_3 * (q3 * q3))) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.125 * (
    (texture (sampler_noisevol_lq, (tmpvar_3 * pow (q3, 3.0))) * 2.0)
   - 1.0)).x);
  final_noise_1 += 1.0;
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = texture (sampler_main, (((
    ((uv - 0.5) * tmpvar_2)
   * 
    (1.0 - ((rad * 3.0) * (1.0 - (bass * 0.1))))
  ) * final_noise_1) + 0.5)).xyz;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)].x = q4;
  tmpvar_2[uint(0)].y = -(q5);
  tmpvar_2[1u].x = q5;
  tmpvar_2[1u].y = q4;
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  ret_1 = (mix (texture (sampler_main, fract(
    (((tmpvar_3 * tmpvar_2) * 0.9) + 0.5)
  )).xyz, texture (sampler_main, fract(
    ((((
      (-(tmpvar_3) + 0.5)
     - 0.5) * -(tmpvar_2)) * 0.9) + 0.5)
  )).xyz, vec3(0.5, 0.5, 0.5)) * 2.0);
  vec3 tmpvar_4;
  tmpvar_4.x = (ret_1.x * 5.0);
  tmpvar_4.y = ret_1.y;
  tmpvar_4.z = (ret_1.z * 5.0);
  ret_1 = (1.0 - tmpvar_4);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }
