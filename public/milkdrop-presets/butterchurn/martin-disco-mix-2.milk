[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 uv6_2;
  uv_1 = (uv + (vec2(0.0, 0.01) * dot (
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  , vec3(0.32, 0.49, 0.29))));
  uv6_2 = (0.4 * sin((
    (uv_1 * 8.0)
   + 
    (rand_frame * 6.0)
  .xy)));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (((
    (texture (sampler_main, uv_1).xyz - (((texture (sampler_blur2, 
      fract(uv_1)
    ).xyz * scale2) + bias2) * 0.03))
   + 
    (0.1 * (vec3((0.1 / sqrt(
      dot (uv6_2, uv6_2)
    ))) * ((1.0 + roam_cos) / 2.0).xyz))
  ) * 0.99) - 0.02);
  ret = tmpvar_3.xyz;
 }

[comp_shader]
float xlat_mutablepads;
vec2 xlat_mutablers;
 shader_body { 
  vec2 uv1_1;
  uv1_1 = (((uv - 0.5) * aspect.xy) * aspect.yx);
  float tmpvar_2;
  tmpvar_2 = (3.0 / abs(uv1_1.y));
  xlat_mutablers.x = ((uv1_1.x * tmpvar_2) * 2.0);
  xlat_mutablers.y = tmpvar_2;
  mat2 tmpvar_3;
  tmpvar_3[uint(0)] = _qa.xy;
  tmpvar_3[1u] = _qa.zw;
  xlat_mutablers = (xlat_mutablers * tmpvar_3);
  xlat_mutablers.y = (xlat_mutablers.y + q17);
  vec2 tmpvar_4;
  tmpvar_4 = sin(xlat_mutablers);
  float x_5;
  x_5 = (tmpvar_4.x * tmpvar_4.y);
  xlat_mutablepads = (0.5 - sqrt(sqrt(
    (x_5 * x_5)
  )));
  xlat_mutablepads = (xlat_mutablepads * (float(
    (xlat_mutablepads <= -0.1)
  ) * clamp (
    ((15.0 / tmpvar_2) - 0.3)
  , 0.0, 1.0)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((
    ((1.0 - (2.0 * xlat_mutablepads)) * texture (sampler_main, (uv + (xlat_mutablepads / 4.0))).xyz)
   * 
    (1.0 + q22)
  ) - (
    ((xlat_mutablepads * q2) * texture (sampler_main, (xlat_mutablers / 180.0)).xyz)
   * 4.0)) - ((
    (xlat_mutablepads * q1)
   * texture (sampler_main, 
    (1.0 - uv)
  ).xyz) * 4.0));
  ret = tmpvar_6.xyz;
 }
