per_frame_init_1=d = 0;
per_frame_init_2=cx1 = 0;
per_frame_init_3=y3 = 0;
per_frame_init_4=y1 = 0;
per_frame_init_5=cy1 = 0;
per_frame_init_6=x1 = 0;
per_frame_init_7=x3 = 0;
per_frame_init_8=dir = 0;
per_frame_init_9=r = 0;
per_frame_init_10=x2 = 0;
per_frame_init_11=y2 = 0;
per_frame_1=ib_r = 0.3 * sin(5 * time) + 0.7;
per_frame_2=ib_g = 0.3 * sin(4 * time) + 0.3;
per_frame_3=ib_b = 0.5 * sin(4 * (time / 3)) + 0.5;
per_frame_4=wave_r = 1 - ib_r;
per_frame_5=wave_g = 1 - ib_g;
per_frame_6=wave_b = 1 - ib_b;
per_frame_7=wave_x = 0.5 + 0.3 * sin(3 * time);
per_frame_8=wave_y = 0.5 + 0.3 * cos(2.187 * time);
per_pixel_1=r = bass / 4;
per_pixel_2=cx1 = 0.5 + 0.2 * sin(0.618 * time);
per_pixel_3=cy1 = 0.5 + 0.2 * cos(1.618 * time);
per_pixel_4=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_5=dir = bass * (r * r - d * d) * 0.3;
per_pixel_6=x1 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_7=y1 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_8=cx1 = 0.5 + 0.3 * sin(2.618 * time);
per_pixel_9=cy1 = 0.5 + 0.3 * cos(3.14 * time);
per_pixel_10=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_11=dir = -mid * (r * r - d * d) * 0.3;
per_pixel_12=x2 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_13=y2 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_14=cx1 = 0.5 + 0.4 * sin(2.618 * -time);
per_pixel_15=cy1 = 0.5 + 0.4 * cos(1.14 * -time);
per_pixel_16=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_17=dir = -treb * (r * r - d * d) * 0.3;
per_pixel_18=x3 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_19=y3 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_20=dx = x1 + x2 + x3;
per_pixel_21=dy = y1 + y2 + y3;

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 2.0)) + rand_frame.xy);
  uv_1 = (uv + ((texture (sampler_noise_lq, tmpvar_2).xy - 0.5) * texsize.zw));
  vec2 tmpvar_3;
  tmpvar_3.x = bass;
  tmpvar_3.y = treb;
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, (uv_1 + (
    (texture (sampler_main, (mix (uv_1, uv_orig, vec2(-1.0, -1.0)) + texsize.zw)).xy - 0.4)
   * 
    (-0.004 + (0.04 * clamp ((tmpvar_3 - 1.0), 0.0, 1.0)))
  ))).xyz - (0.0008 + (
    (texture (sampler_noise_lq, tmpvar_2) - 0.5)
   * 0.02)).xyz);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv1_1;
  vec2 tmpvar_2;
  tmpvar_2.y = 0.0;
  tmpvar_2.x = texsize.z;
  vec2 tmpvar_3;
  tmpvar_3.x = 0.0;
  tmpvar_3.y = texsize.w;
  vec2 tmpvar_4;
  tmpvar_4.x = (texture (sampler_main, (uv - tmpvar_2)).xyz - texture (sampler_main, (uv + tmpvar_2)).xyz).x;
  tmpvar_4.y = (texture (sampler_main, (uv - tmpvar_3)).xyz - texture (sampler_main, (uv + tmpvar_3)).xyz).x;
  uv1_1 = ((0.3 * cos(
    ((uv - 0.5) * 2.0)
  )) - tmpvar_4);
  float tmpvar_5;
  tmpvar_5 = clamp ((0.04 / sqrt(
    dot (uv1_1, uv1_1)
  )), 0.0, 1.0);
  uv1_1 = ((0.3 * cos(
    (uv1_1 * 12.0)
  )) - (9.0 * tmpvar_4));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (tmpvar_5 + ((texture (sampler_main, uv).xyz * 12.0) * vec3(clamp (
    (0.04 / sqrt(dot (uv1_1, uv1_1)))
  , 0.0, 1.0))));
  ret = tmpvar_6.xyz;
 }
