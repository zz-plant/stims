per_frame_init_1=d = 0;
per_frame_init_2=res = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=x = 0;
per_frame_init_5=v = 0;
per_frame_init_6=diff = 0;
per_frame_init_7=r = 0;
per_frame_init_8=y = 0;
per_frame_init_9=beat = 0;
per_frame_init_10=vol = 0;
per_frame_init_11=q2 = 0;
per_frame_init_12=m = 0;
per_frame_1=vol = 8 * bass + 5 * mid + 3 * treb;
per_frame_2=m = 0.97 * m + 0.08 * vol;
per_frame_3=monitor = vol;
per_frame_4=beat = above(vol, res) * above(vol, m) * above(vol, 16);
per_frame_5=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_6=res = beat * (vol + 0.1 * m) + (1 - beat) * (res - 60 * (0.1 + 0.02 * diff) / fps);
per_frame_7=res = max(0, res);
per_frame_8=x = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, x);
per_frame_9=y = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, y);
per_frame_10=q1 = x;
per_frame_11=q2 = y;
per_frame_12=wave_x = q1;
per_frame_13=wave_y = 1 - q2;
per_pixel_1=cx = q1;
per_pixel_2=cy = q2;
per_pixel_3=d = pow(sqrt(sqr(x - cx) + sqr(y - cy)), 0.8);
per_pixel_4=r = 0.2;
per_pixel_5=v = 0.2;
per_pixel_6=dx = (x - cx) * v * (d - r);
per_pixel_7=dy = (y - cy) * v * (d - r);
shape_0_per_frame1=x = randint(1000) / 1000;
shape_0_per_frame2=y = randint(1000) / 1000;
shape_0_per_frame3=ang = randint(150) / 100;
shape_3_init1=q1 = 0;
shape_3_init2=q2 = 0;
shape_3_per_frame1=x = 1 - q1;
shape_3_per_frame2=y = q2;
shape_3_per_frame3=x = 0.5 + 0.25 * (x - 0.5);
shape_3_per_frame4=y = 0.5 + 0.25 * (y - 0.5);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (texsize.zw * 12.0);
  vec2 tmpvar_3;
  tmpvar_3 = (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 0.8)) + rand_frame.xy);
  vec2 tmpvar_4;
  tmpvar_4.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_2))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_2))
  ).xyz * scale1) + bias1)).x;
  tmpvar_4.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_2))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_2))
  ).xyz * scale1) + bias1)).x;
  vec2 tmpvar_5;
  tmpvar_5 = ((mix (uv_orig, uv, vec2(0.2, 0.2)) + (
    (tmpvar_4 * texsize.zw)
   * 2.0)) + ((
    (texture (sampler_noise_lq, tmpvar_3).xy - 0.5)
   * texsize.zw) * 4.0));
  ret_1.x = (((texture (sampler_fc_main, tmpvar_5).x - 
    ((texture (sampler_fc_main, tmpvar_5).x - ((texture (sampler_blur3, tmpvar_5).xyz * scale3) + bias3).x) * 0.02)
  ) - 0.008) + ((texture (sampler_noise_lq, tmpvar_3).x - 0.5) * 0.1));
  ret_1.y = texture (sampler_main, uv).y;
  ret_1.y = (ret_1.y + ((
    (ret_1.y - ((texture (sampler_blur1, uv).xyz * scale1) + bias1).y)
   * 0.1) - 0.015));
  ret_1.z = ((texture (sampler_fc_main, (uv_orig + 
    (uv_orig - uv)
  )).z * 0.96) - 0.004);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_1;
  ret = tmpvar_6.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (texsize.zw * 4.0);
  vec2 tmpvar_2;
  tmpvar_2.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  tmpvar_2.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = mix ((texture (sampler_fc_main, (uv - 
    (tmpvar_2 * 0.4)
  )).x * (hue_shader.zxy * hue_shader.zxy)), mix ((
    pow (hue_shader, vec3(4.0, 4.0, 4.0))
   * 1.2), vec3(3.0, 3.0, 3.0), texture (sampler_main, uv).zzz), vec3(((
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1).y * 0.7)));
  ret = tmpvar_3.xyz;
 }
