per_frame_107=q1 = aspectx;
per_frame_108=q2 = aspecty;
per_frame_109=q3 = 2 * r;
per_frame_110=q4 = x1;
per_frame_111=q5 = y1;
per_frame_112=q6 = vr1;
per_frame_113=q7 = x2;
per_frame_114=q8 = y2;
per_frame_115=q9 = vr2;
per_frame_116=q10 = x3;
per_frame_117=q11 = y3;
per_frame_118=q12 = vr3;
per_frame_119=q13 = atan2((x1 + x2 + x3) / 3 - 0.5, (y1 + y2 + y3) / 3 - 0.5);
per_frame_120=q14 = 0.2 * sigmoid(sqrt(sqr((x1 + x2 + x3) / 3 - 0.5) + sqr((y1 + y2 + y3) / 3 - 0.5)), 2);
per_frame_121=q15 = 1 / max(aspectx, aspecty);
per_pixel_1=c = 42;
per_pixel_2=s = 0.5;
per_pixel_3=d = 0.6 * q3;
per_pixel_4=cx1 = 0.5 + (q4 - 0.5) * q15;
per_pixel_5=cy1 = 0.5 - (q5 - 0.5) * q15;
per_pixel_6=d1 = sqrt(sqr(x - cx1) + sqr(y - cy1));
per_pixel_7=s1 = sigmoid(d - d1, c) * s;
per_pixel_8=rx1 = -q6 * sin(y - cy1) * s1;
per_pixel_9=ry1 = q6 * sin(x - cx1) * s1;
per_pixel_10=cx2 = 0.5 + (q7 - 0.5) * q15;
per_pixel_11=cy2 = 0.5 - (q8 - 0.5) * q15;
per_pixel_12=d2 = sqrt(sqr(x - cx2) + sqr(y - cy2));
per_pixel_13=s2 = sigmoid(d - d2, c) * s;
per_pixel_14=rx2 = -q9 * sin(y - cy2) * s2;
per_pixel_15=ry2 = q9 * sin(x - cx2) * s2;
per_pixel_16=cx3 = 0.5 + (q10 - 0.5) * q15;
per_pixel_17=cy3 = 0.5 - (q11 - 0.5) * q15;
per_pixel_18=d3 = sqrt(sqr(x - cx3) + sqr(y - cy3));
per_pixel_19=s3 = sigmoid(0.12 - d3, c) * s;
per_pixel_20=rx3 = -q12 * sin(y - cy3) * s3;
per_pixel_21=ry3 = q12 * sin(x - cx3) * s3;
per_pixel_22=dx = rx1 + rx2 + rx3;
per_pixel_23=dy = ry1 + ry2 + ry3;
