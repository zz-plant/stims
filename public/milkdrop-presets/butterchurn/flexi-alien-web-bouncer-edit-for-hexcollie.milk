per_frame_66=vy1 = if(0.00001 < abs(bounce), cos(ref_ang) * v1 * cos(w1 - ref_ang) + 0.1 * (vr - v2r - cos(ref_ang) * v1 * cos(w1 - ref_ang)) + cos(ref_ang + asin(1)) * v2 * cos(w2 - ref_ang - asin(1)), vy1);
per_frame_67=vx2 = if(0.00001 < abs(bounce), sin(ref_ang) * v2 * cos(w2 - ref_ang) + 0.1 * (v2r - vr - sin(ref_ang) * v2 * cos(w2 - ref_ang)) + sin(ref_ang + asin(1)) * v1 * cos(w1 - ref_ang - asin(1)), vx2);
per_frame_68=vy2 = if(0.00001 < abs(bounce), cos(ref_ang) * v2 * cos(w2 - ref_ang) + 0.1 * (v2r - vr - cos(ref_ang) * v2 * cos(w2 - ref_ang)) + cos(ref_ang + asin(1)) * v1 * cos(w1 - ref_ang - asin(1)), vy2);
