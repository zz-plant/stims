wave_1_per_frame1=t1 = asin(1);
wave_1_per_frame2=rot = rot + q6;
wave_1_per_frame3=t2 = rot;
wave_1_per_frame4=q4 = 0.5 + (q4 - 0.5) * q15;
wave_1_per_frame5=q5 = 0.5 + (q5 - 0.5) * q15;
wave_1_per_point1=w = 4 * t1 * sample;
wave_1_per_point2=fnord = cos(4 * (w - t2)) * sin(5 * (w - t2));
wave_1_per_point3=d = 0.8 * q3 * q15 * fnord + 0 * value1;
wave_1_per_point4=x = q4 + sin(w) * d - 0.04 * cos(-t2);
wave_1_per_point5=y = q5 + cos(w) * d - 0.04 * sin(-t2);
