per_frame_1=warp = 0;
per_frame_2=volume = 0.3 * (bass + mid + att);
per_frame_3=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.25 * volume * bass_att, 0.5), xamptarg);
per_frame_4=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_5=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_6=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_7=xpos = xpos + 0.001 * xspeed;
per_frame_8=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.15 * volume * treb_att, 0.5), yamptarg);
per_frame_9=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_10=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_11=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_12=ypos = ypos + 0.001 * yspeed;
per_frame_13=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_14=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_15=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_16=peakbass_att = max(bass_att, peakbass_att);
per_frame_17=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_18=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_19=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_20=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_21=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_22=q1 = wave_x;
per_frame_23=q2 = 1 - wave_y;
per_frame_24=q2 = ypos + 0.5;
per_frame_25=movement = movement + 0.4 * ((bass + bass_att + 0.1 * pow(bass + 0.6 * bass_att + 0.2 * treb_att, 3)) / fps);
per_frame_26=movement = if(0.00001 < abs(above(movement, 10000)), 0, movement);
per_frame_27=rot = sin(movement);
per_frame_28=cx = wave_x;
per_frame_29=cy = y_pos + 0.5;
per_frame_30=q8 = movement;
per_pixel_1=myy = x - q1;
per_pixel_2=myx = y - q2 + 0.1;
per_pixel_3=dx = 6 * sin(0.675 * q8) * myx * myy;
per_pixel_4=dy = 3 * sin(0.675 * q8) * (myx * myx - myy * myy);

