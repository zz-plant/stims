wave_0_init5=q1 = 0;
wave_0_init6=count = 0;
wave_0_init7=q6 = 0;
wave_0_init8=q7 = 0;
wave_0_per_point1=zs = if(0.00001 < abs(below(zs, 1)), 9, zs);
wave_0_per_point2=zs = if(0.00001 < abs(above(zs, 1300)), 1, zs);
wave_0_per_point3=speed = 0.002 * bass;
wave_0_per_point4=xcoef = 2 * equal(q4, 0) + 2.1 * equal(q4, 1) + 2.2 * equal(q4, 2) + 2.3 * equal(q4, 3) + 2.4 * equal(q4, 4) + 2.5 * equal(q4, 5);
wave_0_per_point5=zs = zs + tan(0.015 * q1) * speed;
wave_0_per_point6=count = count + 0.0001;
wave_0_per_point7=count = if(0.00001 < abs(above(count, 6.24)), 0, count);
wave_0_per_point8=x = 0.1 * cos(q1 * zs * 2 + 0.1);
wave_0_per_point9=y = 0.1 * sin(q1 * zs + 0.1);
wave_0_per_point10=x = x * cos(3 * q1) * 0.8 - y * sin(3 * q1) * 0.8;
wave_0_per_point11=y = x * sin(3 * q1) + y * cos(3 * q1);
wave_0_per_point12=x = x + q6 + 0.5;
wave_0_per_point13=y = y - q7 + 0.5;
wave_0_per_point14=r = 0.5 + 0.5 * sin(1.2 * q1 + x + x);
wave_0_per_point15=g = 0.5 + 0.5 * sin(1.5 * q1 + x + y);
wave_0_per_point16=b = 0.5 + 0.5 * sin(1.36 * q1 + y + y);
