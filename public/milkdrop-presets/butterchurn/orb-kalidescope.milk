per_frame_1=basstime = basstime + 0.03 * bass;
per_frame_2=basstime2 = basstime + 0.03 * bass;
per_frame_3=q1 = basstime2;
per_frame_4=basstime = if(0.00001 < abs(below(basstime, 450)), 450, basstime);
per_frame_5=basstime = if(0.00001 < abs(above(basstime, 495)), 450, basstime);
per_frame_6=basstime = basstime + 0.03 * bass_att;
per_frame_7=vol = pow(bass + mid + treb, 2);
per_frame_8=basssum = vol;
per_frame_9=stickybit = mod(time, 2);
per_frame_10=volavg = volavg + vol * equal(stickybit, 1);
per_frame_11=sample1 = sample1 + equal(stickybit, 1);
per_frame_12=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_13=sample2 = sample2 + equal(stickybit, 0);
per_frame_14=edge = bnot(equal(bit2, stickybit));
per_frame_15=volavg = volavg - volavg * edge * stickybit;
per_frame_16=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_17=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_18=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_19=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_20=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_21=q3 = diff;
per_frame_22=bit2 = mod(time, 2);
per_frame_23=state = if(0.00001 < abs(above(state, 5)), 0, state);
per_frame_24=state = state + above(diff, 3);
per_frame_25=q4 = state;
per_frame_26=difftime = difftime + 0.03 * diff;
per_frame_27=q2 = difftime;
per_frame_28=difftime = if(0.00001 < abs(above(difftime, 2000)), 0, difftime);
per_frame_29=state = state + equal(diff, 3);
per_frame_30=state = if(0.00001 < abs(above(state, 5)), 0, state);
per_frame_31=xs = 0;
per_frame_32=ys = 0;
per_frame_33=xs = xs + equal(0, state) * atan(4 * bass_time) * 0.1;
per_frame_34=ys = ys + equal(0, state) * cos(4 * bass_time) * 0.1;
per_frame_35=xs = xs + equal(1, state) * cos(4 * bass_time) * 0.1;
per_frame_36=ys = ys + equal(1, state) * cos(4 * bass_time) * 0.1;
per_frame_37=xs = xs + equal(2, state) * cos(4 * bass_time) * 0.1;
per_frame_38=ys = ys + equal(2, state) * sin(4 * bass_time) * 0.1;
per_frame_39=xs = xs + equal(3, state) * cos(5 * bass_time) * 0.1;
per_frame_40=ys = ys + equal(3, state) * cos(9 * bass_time) * 0.1;
per_frame_41=xs = xs + equal(4, state) * atan(6 * bass_time) * 0.1;
per_frame_42=ys = ys + equal(4, state) * cos(2 * bass_time) * 0.1;
per_frame_43=xs = xs + equal(5, state) * cos(2 * bass_time) * 0.1;
per_frame_44=ys = ys + equal(5, state) * sin(1 * bass_time) * 0.1;
per_frame_45=xpass = xs + xpass;
per_frame_46=ypass = ys + ypass;
per_frame_47=q6 = 0.3 * sin(0.5 * xpass);
per_frame_48=q7 = 0.3 * sin(0.5 * ypass);
per_frame_49=zoom_in = zoom_in + above(diff, 4);
per_frame_50=zoom_in = if(0.00001 < abs(above(zoom_in, 2)), 0, zoom_in);
per_frame_51=q5 = zoom_in;
per_frame_52=tex_saw = tex_saw - 0.002 * diff;
per_frame_53=tex_saw = if(0.00001 < abs(below(tex_saw, 0.1)), 1, tex_saw);
per_frame_54=q8 = tex_saw;
per_frame_55=monitor = tex_saw;
per_pixel_1=zoom = 1 - 0.1 * equal(q5, 0) * q3 + 0.1 * equal(q5, 1) * q3;
per_pixel_2=saw_r = saw_r + 0.0001 * bass;
per_pixel_3=saw_r = if(0.00001 < abs(above(saw_r, 1)), 0, saw_r);
per_pixel_4=saw_g = saw_g + 0.00012 * bass;
per_pixel_5=saw_g = if(0.00001 < abs(above(saw_g, 1)), 0, saw_g);
per_pixel_6=saw_b = saw_b + 0.00011 * bass;
per_pixel_7=saw_b = if(0.00001 < abs(above(saw_b, 1)), 0, saw_b);
per_pixel_8=decay_r = 5 - x * y * saw_r;
per_pixel_9=decay_g = 5 - y * x * saw_g;
per_pixel_10=decay_b = 5 - x * y * saw_b;
per_pixel_11=rot = 4.19;
per_pixel_12=zoom = 1;
wave_0_init1=zs = 0;
wave_0_init2=speed = 0;
wave_0_init3=xcoef = 0;
