per_frame_39=q6 = y2;
per_frame_40=q7 = y3;
per_frame_41=q8 = y4;
per_frame_42=q9 = 1 / aspectx;
per_frame_43=q10 = 1 / aspecty;
per_frame_44=q11 = aspectx;
per_frame_45=q12 = aspecty;
per_frame_46=q13 = 0.8 * sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_47=q14 = atan2(vx4, vy4);
per_pixel_1=x = 0.5 + (x - 0.5) * q11;
per_pixel_2=y = 0.5 + (y - 0.5) * q12;
per_pixel_3=dir = -q14 + asin(1);
per_pixel_4=velocity = q13;
per_pixel_5=strength = 100;
per_pixel_6=size = 0.07;
per_pixel_7=xx = q4;
per_pixel_8=yy = 1 - q8;
per_pixel_9=x1 = xx + cos(dir + 1.5708) * size;
per_pixel_10=y1 = yy - sin(dir + 1.5708) * size;
per_pixel_11=x2 = xx - cos(dir + 1.5708) * size;
per_pixel_12=y2 = yy + sin(dir + 1.5708) * size;
per_pixel_13=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * size;
per_pixel_14=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_15=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * size;
per_pixel_16=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_17=dx = (si1 * sin(y1 - y) * d1 - si2 * sin(y2 - y) * d2) * strength * velocity;
per_pixel_18=dy = (-si1 * sin(x1 - x) * d1 + si2 * sin(x2 - x) * d2) * strength * velocity;
wave_2_init1=d = 0;
wave_2_init2=xx = 0;
