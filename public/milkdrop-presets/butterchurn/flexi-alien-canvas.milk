per_frame_4=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_5=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_6=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_7=x1 = 0.5 + 2 * (xx1 - xx2);
per_frame_8=y1 = 0.4 + 1.5 * yy1;
per_frame_9=dt = 0.03 / fps;
per_frame_10=vx2 = vx2 * (1 - 2 * dt) + 10 * dt * (x1 + x3 - 2 * x2);
per_frame_11=vy2 = vy2 * (1 - 2 * dt) + dt * (10 * (y1 + y3 - 2 * y2) - 0.5);
per_frame_12=vx3 = vx3 * (1 - 2 * dt) + 10 * dt * (x2 + x4 - 2 * x3);
per_frame_13=vy3 = vy3 * (1 - 2 * dt) + dt * (10 * (y2 + y4 - 2 * y3) - 0.5);
per_frame_14=vx4 = vx4 * (1 - 2 * dt) + 10 * dt * (x3 - x4);
per_frame_15=vy4 = vy4 * (1 - 2 * dt) + dt * (10 * (y3 - y4) - 0.5);
per_frame_16=x2 = x2 + vx2;
per_frame_17=y2 = y2 + vy2;
per_frame_18=x3 = x3 + vx3;
per_frame_19=y3 = y3 + vy3;
per_frame_20=x4 = x4 + vx4;
per_frame_21=y4 = y4 + vy4;
per_frame_22=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, 0.5 * abs(vx2));
per_frame_23=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, 0.5 * -abs(vx2));
per_frame_24=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, 0.5 * abs(vx3));
per_frame_25=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, 0.5 * -abs(vx3));
per_frame_26=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, 0.5 * abs(vx4));
per_frame_27=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, 0.5 * -abs(vx4));
per_frame_28=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, 0.5 * abs(vy2));
per_frame_29=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, 0.5 * -abs(vy2));
per_frame_30=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, 0.5 * abs(vy3));
per_frame_31=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, 0.5 * -abs(vy3));
per_frame_32=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, 0.5 * abs(vy4));
per_frame_33=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, 0.5 * -abs(vy4));
