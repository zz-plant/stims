wave_2_init12=q2 = 0;
wave_2_init13=q3 = 0;
wave_2_init14=yy = 0;
wave_2_init15=q7 = 0;
wave_2_init16=q8 = 0;
wave_2_per_point1=sample = 1 - sample;
wave_2_per_point2=xxx = xx;
wave_2_per_point3=yyy = yy;
wave_2_per_point4=xx = pow(sample, 5) * q1 + 5 * pow(sample, 4) * (1 - sample) * q1 + 10 * pow(sample, 3) * sqr(1 - sample) * q2 + 10 * sqr(sample) * pow(1 - sample, 3) * q3 + 5 * pow(1 - sample, 4) * sample * q4 + pow(1 - sample, 5) * q4;
wave_2_per_point5=yy = pow(sample, 5) * q5 + 5 * pow(sample, 4) * (1 - sample) * q5 + 10 * pow(sample, 3) * sqr(1 - sample) * q6 + 10 * sqr(sample) * pow(1 - sample, 3) * q7 + 5 * pow(1 - sample, 4) * sample * q8 + pow(1 - sample, 5) * q8;
wave_2_per_point6=d = 1 / sqrt(sqr(xx - xxx) + sqr(yy - yyy));
wave_2_per_point7=dd = sample * (1 - sample) * sin(180 * sample) * d * 0.1;
wave_2_per_point8=x = xx + (yy - yyy) * dd;
wave_2_per_point9=y = yy - (xx - xxx) * dd;
wave_2_per_point10=x = 0.5 + (x - 0.5) * q9;
wave_2_per_point11=y = 0.5 + (y - 0.5) * q10;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = ((uv * texsize.xy) * texsize_noise_lq.zw);
  vec2 tmpvar_3;
  tmpvar_3 = (texsize.zw * 4.0);
  vec2 tmpvar_4;
  tmpvar_4.x = (((2.0 * 
    ((texture (sampler_blur1, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
  ) - (2.0 * 
    ((texture (sampler_blur1, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
  )).y * 0.5);
  tmpvar_4.y = (((2.0 * 
    ((texture (sampler_blur1, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
  ) - (2.0 * 
    ((texture (sampler_blur1, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
  )).y * 0.5);
  ret_1.y = texture (sampler_fw_main, clamp ((uv + (
    (tmpvar_4 * texsize.zw)
   * 4.0)), 0.0, 1.0)).y;
  ret_1.y = (ret_1.y + ((
    (ret_1 - ((texture (sampler_blur1, uv).xyz * scale1) + bias1))
  .y * 0.025) + (-0.01 + 
    (texture (sampler_main, uv).x * 0.1)
  )));
  ret_1.y = (ret_1.y + ((texture (sampler_noise_lq, tmpvar_2).y - 0.5) * 0.02));
  vec2 tmpvar_5;
  tmpvar_5.x = (((2.0 * 
    ((texture (sampler_blur1, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
  ) - (2.0 * 
    ((texture (sampler_blur1, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
  )).z * 0.5);
  tmpvar_5.y = (((2.0 * 
    ((texture (sampler_blur1, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
  ) - (2.0 * 
    ((texture (sampler_blur1, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
  )).z * 0.5);
  ret_1.z = ((texture (sampler_main, (uv - 
    ((tmpvar_5 * texsize.zw) * 4.0)
  )).z - (ret_1.y * 0.01)) + 0.004);
  ret_1.z = (ret_1.z + ((texture (sampler_noise_lq, tmpvar_2).y - 0.5) * 0.01));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_1;
  ret = tmpvar_6.xyz;
 }

[comp_shader]
shader_body { 
  vec2 dz_1;
  vec2 d_2;
  vec3 ret_3;
  vec2 tmpvar_4;
  vec2 tmpvar_5;
  tmpvar_5 = (vec2(1.0, 0.0) * texsize.zw);
  tmpvar_4.x = (texture (sampler_main, (uv + tmpvar_5)).xyz - texture (sampler_main, (uv - tmpvar_5)).xyz).y;
  vec2 tmpvar_6;
  tmpvar_6 = (vec2(0.0, 1.0) * texsize.zw);
  tmpvar_4.y = (texture (sampler_main, (uv + tmpvar_6)).xyz - texture (sampler_main, (uv - tmpvar_6)).xyz).y;
  d_2 = (texsize.zw * 2.0);
  vec2 tmpvar_7;
  tmpvar_7.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * d_2))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * d_2))
  ).xyz * scale1) + bias1)).y;
  tmpvar_7.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * d_2))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * d_2))
  ).xyz * scale1) + bias1)).y;
  dz_1 = ((tmpvar_4 * 3.0) + tmpvar_7);
  ret_3 = (vec3(((
    pow ((sqrt(dot (dz_1, dz_1)) * 0.8), 0.7)
   + 
    (((texture (sampler_blur2, uv).xyz * scale2) + bias2).y * 0.4)
  ) - 0.1)) * vec3(0.4, 0.5, 0.7));
  vec2 tmpvar_8;
  tmpvar_8.x = q19;
  tmpvar_8.y = q20;
  vec3 tmpvar_9;
  tmpvar_9 = mix (mix (ret_3, vec3(1.0, 0.4, 0.0), texture (sampler_main, fract(
    ((0.5 + (uv - 0.5)) + (tmpvar_8 * vec2(-1.0, 1.0)))
  )).xxx), vec3(1.0, 1.0, 1.0), texture (sampler_main, uv).zzz);
  ret_3 = tmpvar_9;
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = tmpvar_9;
  ret = tmpvar_10.xyz;
 }
