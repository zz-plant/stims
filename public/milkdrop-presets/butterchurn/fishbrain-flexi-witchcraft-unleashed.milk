[warp_shader]
shader_body { 
  vec2 uv_x_1;
  vec3 ret_2;
  ret_2.x = ((texture (sampler_main, uv_orig).x * 0.8) - 0.004);
  uv_x_1 = (1.0 - abs((
    (fract(uv) * 2.0)
   - 1.0)));
  uv_x_1 = ((0.5 + (
    (uv_x_1 - 0.5)
   * vec2(0.75, -0.9))) - vec2(0.0, 0.05));
  ret_2.y = (texture (sampler_main, clamp ((0.5 + 
    ((uv - 0.5) * 2.0)
  ), 0.0, 1.0)).y + texture (sampler_main, uv_x_1.yx).x);
  vec2 tmpvar_3;
  tmpvar_3 = (texsize.zw * 4.0);
  vec2 tmpvar_4;
  tmpvar_4.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_3))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_3))
  ).xyz * scale1) + bias1)).z;
  tmpvar_4.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_3))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_3))
  ).xyz * scale1) + bias1)).z;
  vec2 tmpvar_5;
  tmpvar_5 = (uv_orig + ((tmpvar_4 * texsize.zw) * 6.0));
  ret_2.z = ((texture (sampler_main, tmpvar_5).z + (
    (texture (sampler_main, tmpvar_5).z - ((texture (sampler_blur1, uv).xyz * scale1) + bias1).z)
   * 0.06)) - 0.008);
  ret_2.z = (ret_2.z + (texture (sampler_main, uv_x_1).x * 0.012));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_2;
