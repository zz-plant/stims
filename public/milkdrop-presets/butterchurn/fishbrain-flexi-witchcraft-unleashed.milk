    (uv - (vec2(0.0, 1.0) * tmpvar_10))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_13;
  tmpvar_13.x = tmpvar_11.z;
  tmpvar_13.y = tmpvar_12.z;
  ret_4 = (((0.5 + 
