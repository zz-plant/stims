  vec2 tmpvar_7;
  tmpvar_7.x = ((q12 * tmpvar_6.x) - (q11 * tmpvar_6.y));
  tmpvar_7.y = ((q11 * tmpvar_6.x) + (q12 * tmpvar_6.y));
  uv_r_2 = (q15 * tmpvar_7);
  uv_r_2 = (tmpvar_5 + (uv_r_2 * aspect.zw));
  uv_r_2 = (1.0 - abs((
    (fract((uv_r_2 * 0.5)) * 2.0)
   - 1.0)));
  vec2 tmpvar_8;
  tmpvar_8 = ((uv_r_2 - tmpvar_5) * aspect.xy);
  vec2 tmpvar_9;
  tmpvar_9.x = ((q18 * tmpvar_8.x) - (q17 * tmpvar_8.y));
  tmpvar_9.y = ((q17 * tmpvar_8.x) + (q18 * tmpvar_8.y));
  uv_rr_1 = (q16 * tmpvar_9);
  uv_rr_1 = (tmpvar_5 + (uv_rr_1 * aspect.zw));
  vec2 tmpvar_10;
