  vec3 tmpvar_11;
  tmpvar_11 = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_10))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
