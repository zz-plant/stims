[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_fc_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (mix (tmpvar_1.xyz, (0.1 - tmpvar_1.xyz), vec3(0.04, 0.04, 0.04)) * 0.98);
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_fc_main, ((uv * 0.75) + 0.2)).xyz * 0.6);
  vec2 tmpvar_2;
  tmpvar_2.x = (1.0 - (uv.x * 0.8));
  tmpvar_2.y = (uv.y * 0.8);
  ret_1 = (ret_1 + (texture (sampler_fc_main, tmpvar_2).xyz * 0.6));
  ret_1 = (ret_1 + ((
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1) * 0.5));
  ret_1 = (((1.0/(
    (1.0 + exp2(((
      -(ret_1)
     * 3.5) + 3.0)))
  )) * 2.0) - 0.2);
  ret_1 = (ret_1 * 2.0);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
