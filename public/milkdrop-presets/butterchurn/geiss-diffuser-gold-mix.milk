shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.25 * (0.6 * sin(10.937 * time) + 0.4 * sin(1.47 * time));
per_frame_2=wave_g = wave_g + 0.15 * (0.6 * sin(11.344 * time) + 0.4 * sin(1.041 * time));
per_frame_3=wave_b = wave_b + 0.12 * (0.6 * sin(21.251 * time) + 0.4 * sin(1.355 * time));
per_pixel_1=dx = 0;
per_pixel_2=dy = 0;

[warp_shader]
uniform sampler2D sampler_rand00;
 shader_body { 
  vec3 uv2_1;
  vec3 tmpvar_2;
  tmpvar_2.z = 1.0;
  tmpvar_2.xy = uv;
  vec3 tmpvar_3;
  tmpvar_3 = (tmpvar_2 + (0.02 * (
    fract((texture (sampler_rand00, uv).xyz - (time * vec3(0.32, 0.39, 0.35))))
   - 0.5)));
  uv2_1.z = tmpvar_3.z;
  uv2_1.xy = (((tmpvar_3.xy - 0.5) * tmpvar_3.z) + 0.5);
  uv2_1.xy = (uv2_1.xy + (uv - uv_orig));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ((texture (sampler_main, uv2_1.xy).xyz * 0.99) - 0.003);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1.x = tmpvar_2.x;
  ret_1.yz = (tmpvar_2.x * vec2(0.9, 0.7));
  ret_1 = (pow (ret_1, vec3(1.7, 2.0, 2.2)) * 5.0);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
