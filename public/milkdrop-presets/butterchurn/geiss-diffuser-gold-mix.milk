[preset00]
fRating=0.000000
nWaveMode=6.000000
fWaveAlpha=4.000000
fWaveScale=1.692000
fWaveSmoothing=0.180000
fWarpScale=3.138000
fZoom=1.020300
fCY=0.110000
fDX=-0.001000
fDY=-0.001000
fWarp=0.439100
fWaveY=0.520000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_samples=50.000000
wavecode_0_smoothing=0.270000
wavecode_0_b=0.800000
wavecode_0_a=0.120000
wavecode_1_enabled=0.000000
