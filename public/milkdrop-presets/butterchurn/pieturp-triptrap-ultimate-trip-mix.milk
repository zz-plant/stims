per_frame_init_8=t = 0;
per_frame_init_9=decay = 1;
per_frame_init_10=beatvol = 1.04;
per_frame_1=zoom = 1;
per_frame_2=decay = 1;
per_frame_3=maat = maat + above(bass_att, 1.5);
per_frame_4=maat = maat * below(maat, 16);
per_frame_5=val = if(0.00001 < abs(above(maat, 8)), 1, val);
per_frame_6=val = if(0.00001 < abs(above(val, 0.6)), 0.99 * val, 0.3);
per_frame_7=echo_zoom = val + 0.7;
per_frame_8=zoom = 1;
per_frame_9=ob_size = 0;
per_frame_10=ob_g = 0;
per_frame_11=ob_r = 0;
per_frame_12=ob_b = 0;
per_frame_13=ob_a = 1;
per_frame_14=zoomin = mod(0.5 * sin(time) + 0.5, 2);
per_frame_15=zval = cos(0.3 * time) * zoomin;
per_frame_16=zuse = 0.05 * zval + 1;
per_frame_17=monitor = zuse;
per_frame_18=zoom = zuse;
per_frame_19=r = above(bass, 1.3) + 0.95 * r;
per_frame_20=t = below(r, 5);
per_frame_21=q1 = t * val * 0.5;
per_pixel_1=dx = (dx - 0.05 * sin(32 * x)) * cos(8 * time) * q1;
per_pixel_2=dy = (dy - 0.05 * sin(18 * y)) * sin(8 * time) * q1;
shape_0_init1=val = 0;
shape_0_per_frame1=ang = 0.5 * sin(time) + 0.5;
shape_0_per_frame2=val = 3;
shape_0_per_frame3=a2 = 0.33 * val;
shape_0_per_frame4=a = 0.33 * val;
shape_0_per_frame5=rad = 0.4 * cos(0.3 * time) + 0.65;
shape_0_per_frame6=x = 0.25 * sin(0.25 * time) + 0.5;
shape_0_per_frame7=y = 0.25 * cos(0.45 * time) + 0.5;
shape_1_init1=val = 0;
shape_1_per_frame1=ang = 0.5 * cos(0.3 * time) + 0.5;
