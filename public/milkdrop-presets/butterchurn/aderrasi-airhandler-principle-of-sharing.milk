[preset00]
fRating=2.000000
fGammaAdj=1.350000
fDecay=1.000000
fVideoEchoZoom=0.999599
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=5.000000
bTexWrap=0.000000
bDarken=1.000000
fWaveAlpha=0.690724
fWaveScale=4.778029
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fShader=1.000000
fZoom=0.999513
fWarp=0.010100
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.005000
fOuterBorderA=0.100000
fInnerBorderSize=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_2=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_3=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_frame_4=wave_x = wave_x + 0.2 * sin(0.32 * time);
per_frame_5=wave_y = wave_y + 0.2 * cos(0.32 * time);
per_frame_6=ob_r = wave_r;
per_frame_7=ob_g = wave_g;
per_frame_8=ob_b = wave_b;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 0.0095 * (sin(24 * ang) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.5 * cos(rad)) * above(sin(time), 0);
per_pixel_5=zoom = zoom + 0.0095 * (sin(6 * ang) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.1 * cos(rad)) * below(sin(time), 0);
per_pixel_6=rot = rot + 0.08 * abs(0.746 - rad) * sin(2.2 * (0.5 - rad) + 5.7 * sin(0.1 * time));
per_pixel_7=sx = sx + 0.01 * (0.99 - rad) * sin(0.733 * time) * below(sin(time), 0);
per_pixel_8=sy = sy + 0.01 * (0.99 - rad) * cos(0.953 * time) * above(sin(time), 0);
per_pixel_9=zoom = zoom - 0.015 * (1.5 - rad) * below(rad, 1.5);
