per_pixel_1=sx = -1 + 0.2 * bass;
per_pixel_2=sy = -1 - 0.2 * treb;
per_pixel_3=cx = 0.5 + q4;
per_pixel_4=cy = 0.5 - q5;
per_pixel_5=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_6=zm = 0.98;
per_pixel_7=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_8=star = sin(6 * ag + time) * (2 - rd - ag) / 5;
per_pixel_9=zm = zm + star / 20;
per_pixel_10=sx = zm;
per_pixel_11=sy = zm;
