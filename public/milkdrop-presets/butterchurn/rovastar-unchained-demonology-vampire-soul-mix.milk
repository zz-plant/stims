per_frame_init_1=bblock = 0;
per_frame_init_2=grid = 0;
per_frame_init_3=q6 = 0;
per_frame_init_4=snee = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=tth = 0;
per_frame_init_8=tblock = 0;
per_frame_init_9=bpulse = 0;
per_frame_init_10=pulse = 0;
per_frame_init_11=mblock = 0;
per_frame_init_12=q4 = 0;
per_frame_init_13=snur = 0;
per_frame_init_14=mpulse = 0;
per_frame_init_15=mod_state = 0;
per_frame_init_16=bth = 0;
per_frame_init_17=mres = 0;
per_frame_init_18=tpulse = 0;
per_frame_init_19=tres = 0;
per_frame_init_20=le = 0;
per_frame_init_21=ccl = 0;
per_frame_init_22=q2 = 0;
per_frame_init_23=bres = 0;
per_frame_init_24=q3 = 0;
per_frame_init_25=mth = 0;
per_frame_init_26=q7 = 0;
per_frame_init_27=test = 0;
per_frame_init_28=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=le = 1.5 + 2 * sin(bass_att);
per_frame_3=bpulse = band(above(le, bth), above(le - bth, bblock));
per_frame_4=bblock = le - bth;
per_frame_5=bth = if(0.00001 < abs(above(le, bth)), le + 114 / (le + 10) - 7.407, bth + 0.07 * bth / (bth - 12) + 0.1 * below(bth, 2.7) * (2.7 - bth));
per_frame_6=bth = if(0.00001 < abs(above(bth, 6)), 6, bth);
per_frame_7=bres = bpulse * sin(pulse + 0.5 * le) + bnot(bpulse) * bres;
per_frame_8=le = 1.5 + 2 * sin(treb_att);
per_frame_9=tpulse = band(above(le, tth), above(le - tth, tblock));
per_frame_10=tblock = le - tth;
per_frame_11=tth = if(0.00001 < abs(above(le, tth)), le + 114 / (le + 10) - 7.407, tth + 0.07 * tth / (tth - 12) + 0.1 * below(tth, 2.7) * (2.7 - tth));
per_frame_12=tth = if(0.00001 < abs(above(tth, 6)), 6, tth);
per_frame_13=tres = tpulse * sin(pulse + 0.5 * le) + bnot(tpulse) * tres;
per_frame_14=le = 1.5 + 2 * sin(mid_att);
per_frame_15=mpulse = band(above(le, mth), above(le - mth, mblock));
per_frame_16=mblock = le - mth;
per_frame_17=mth = if(0.00001 < abs(above(le, mth)), le + 114 / (le + 10) - 7.407, mth + 0.07 * mth / (mth - 12) + 0.1 * below(mth, 2.7) * (2.7 - mth));
per_frame_18=mth = if(0.00001 < abs(above(mth, 6)), 6, mth);
per_frame_19=mres = mpulse * sin(pulse + 0.5 * le) + bnot(mpulse) * mres;
per_frame_20=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.003 * (bth + mth + tth));
per_frame_21=q1 = bres;
per_frame_22=q2 = tres;
per_frame_23=q3 = mres;
per_frame_24=q4 = sin(pulse);
per_frame_25=mod_state = (above(q1, 0) + above(q2, 0) + above(q3, 0)) * (1 + above(q4, 0));
per_frame_26=ccl = ccl + tpulse + mpulse - bpulse;
per_frame_27=q5 = cos(pulse * (0.5 + 0.1 * mod_state));
per_frame_28=q6 = sin(pulse * (0.5 + pow(0.25, mod_state)));
per_frame_29=q7 = mod_state;
per_frame_30=q8 = ccl;
per_frame_31=ob_r = 0.5 + 0.5 * cos(q1 + q7);
per_frame_32=ob_g = 0.5 + 0.5 * cos(3.14 * q2 + q7);
per_frame_33=ob_b = 0.5 + 0.5 * cos(2 * q3 + sin(0.0816 * time));
per_frame_34=ib_size = 0.025 + 0.02 * q2;
per_frame_35=ob_size = 0.03 + 0.02 * q3 - 0.002 * q7;
per_frame_36=wave_r = 0.5 + 0.5 * sin(q1 * q7 + 2.183 * time);
per_frame_37=wave_g = 0.5 + 0.5 * sin(3 * q2 + 1.211 * time);
per_frame_38=wave_b = 0.5 + 0.5 * sin(q3 + 1.541 * time);
per_frame_39=wave_mystery = wave_mystery + 0.2 * sin(2.18 * time + q6);
per_frame_40=wave_x = wave_x + 0.1 * sin(0.811 * time + q1) + 0.1 * mod(frame, 3) * sign(q3);
per_frame_41=wave_y = wave_y + 0.1 * sin(0.788 * time + q2) + 0.1 * mod(frame, 2) * sign(q3);
per_frame_42=wave_mode = 3 - 0.3 * q7;
per_frame_43=mv_a = bass + bass_att - 2.5;
per_pixel_1=snee = bnot(above(x, 0.5) * above(q2, 0) + above(y, 0.5) * above(q1, 0));
per_pixel_2=snur = bnot(below(x, 0.5) * above(q3, 0) + below(y, 0.5) * below(q7, 4));
per_pixel_3=grid = pow(2 * sin(6 * rad * sin(q8) + 6 * atan(ang * (1 - y) - 1.57) * q1), 1 + mod(q8, 3)) * (1 + q7);
per_pixel_4=test = below(rad, 0.5 + 0.25 * q1);
per_pixel_5=cx = if(0.00001 < abs(test), band(0, 15 * x - 0.5 * rad) * (1 / (15 - 0.5 * rad)), 0.5);
per_pixel_6=cy = if(0.00001 < abs(test), band(0, 15 * y - 0.5 * rad) * (1 / (15 - 0.5 * rad)), 0.5);
per_pixel_7=rot = if(0.00001 < abs(test), 0.1 * q1 - 0.5 * rad, snee * bnot(below(y, 0.5) * below(q7, 3)) * if(0.00001 < abs(bnot(mod(grid, q8))), 1, 0.1 * sin(3.14 * rad * q3)));
per_pixel_8=zoom = zoom - 0.031 * snur * sin(rad * q7 * q5) + snee * bnot(snur) * sin(6 * rad * q5) * 0.1;
per_pixel_9=sx = if(0.00001 < abs(test), 1, sx + 0.0361 * bnot(snee) * cos(3.14 * y * q4));
per_pixel_10=sy = if(0.00001 < abs(test), 1, sy + 0.00361 * bnot(snur) * cos(3.14 * x * q6));
per_pixel_11=zoomexp = if(0.00001 < abs(test), 1 + rad, zoom + rot);
