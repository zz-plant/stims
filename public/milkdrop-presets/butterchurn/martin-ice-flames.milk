shape_2_per_frame1=steps = q28 + 1;
shape_2_per_frame2=steps = 4;
shape_2_per_frame3=ampl = 0.2;
shape_2_per_frame4=x = 0.5 + ampl * cos(6.28 * (q27 / steps + instance / 4));
shape_2_per_frame5=y = 0.5 + ampl * sin(6.28 * (q27 / steps + instance / 4));
shape_2_per_frame6=a = 0.4;
shape_2_per_frame7=a2 = 0;
shape_2_per_frame8=trig = q24 * bnot(mod(q27, 4));
shape_2_per_frame9=red = bnot(trig) * red + randint(100) / 100 * trig;
shape_2_per_frame10=green = bnot(trig) * green + randint(100) / 100 * trig;
shape_2_per_frame11=blue = bnot(trig) * blue + randint(100) / 100 * trig;
shape_2_per_frame12=k1 = instance / num_inst;
shape_2_per_frame13=r = red * k1;
shape_2_per_frame14=g = green * (1 - k1);
shape_2_per_frame15=b = 4 * blue * k1 * (1 - k1);
shape_2_per_frame16=r = red;
shape_2_per_frame17=g = green;
shape_2_per_frame18=b = blue;
shape_2_per_frame19=r2 = r;
shape_2_per_frame20=b2 = b;
shape_2_per_frame21=g2 = g;

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = (uv - vec2(0.5, 0.5));
  vec4 tmpvar_3;
  tmpvar_3.w = 0.0;
  vec4 tmpvar_4;
  tmpvar_4 = texture (sampler_blur1, uv);
  tmpvar_3.xyz = ((tmpvar_4.xyz * scale1) + bias1);
  float tmpvar_5;
  tmpvar_5 = (dot (tmpvar_3, roam_sin) * 8.0);
  mat2 tmpvar_6;
  tmpvar_6[uint(0)].x = cos(tmpvar_5);
  tmpvar_6[uint(0)].y = -(sin(tmpvar_5));
  tmpvar_6[1u].x = sin(tmpvar_5);
  tmpvar_6[1u].y = cos(tmpvar_5);
  uv_1 = (((tmpvar_2 + 
    ((0.2 * dot ((
      (tmpvar_4.xyz * scale1)
     + bias1), vec3(0.32, 0.49, 0.29))) * (tmpvar_2 * tmpvar_6))
  ) - 0.5) + q5);
  vec2 tmpvar_7;
  tmpvar_7 = ((uv_1 * texsize.xy) * 0.02);
  vec2 tmpvar_8;
  tmpvar_8.x = (cos((tmpvar_7.y * q1)) * sin(-(tmpvar_7.y)));
  tmpvar_8.y = (sin(tmpvar_7.x) * cos((tmpvar_7.y * q2)));
  uv_1 = (uv_1 - ((tmpvar_8 * texsize.zw) * 12.0));
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = ((texture (sampler_main, uv_1).xyz * 0.99) - 0.01);
  ret = tmpvar_9.xyz;
 }

[comp_shader]
vec3 xlat_mutableret1;
vec2 xlat_mutablers;
vec2 xlat_mutableuv1;
float xlat_mutablez;
 shader_body { 
  xlat_mutableuv1 = ((uv - 0.5) * aspect.xy);
  xlat_mutablez = (8.0 / pow (xlat_mutableuv1.y, 0.05));
  xlat_mutablers.x = (xlat_mutableuv1.x * xlat_mutablez);
  xlat_mutablers.y = ((xlat_mutablez / 2.0) + time);
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_noise_hq, xlat_mutablers);
  xlat_mutableret1 = ((tmpvar_1.xyz * vec3(
    greaterThanEqual (tmpvar_1.xyz, vec3(0.0, 0.0, 0.0))
  )) - 0.5);
  vec2 tmpvar_2;
  tmpvar_2 = fract(((xlat_mutableuv1 - 0.5) - (
    (xlat_mutableret1 * 0.1)
   * 
    clamp ((xlat_mutableuv1.y * 32.0), 0.0, 1.0)
  ).xy));
  vec2 tmpvar_3;
  tmpvar_3.x = (1.0 - tmpvar_2.x);
  tmpvar_3.y = tmpvar_2.y;
  vec3 tmpvar_4;
  tmpvar_4 = (texture (sampler_main, tmpvar_2) + texture (sampler_main, tmpvar_3)).xyz;
  xlat_mutableret1 = tmpvar_4;
  xlat_mutableuv1 = (xlat_mutableuv1 * aspect.xy);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ((tmpvar_4 * (1.0 + 
    dot (tmpvar_4, vec3(0.32, 0.49, 0.29))
  )) / 3.0);
  ret = tmpvar_5.xyz;
 }
