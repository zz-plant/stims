per_frame_1=basstime = basstime + 0.03 * bass;
per_frame_2=q1 = 4 * basstime;
per_frame_3=basstime = if(0.00001 < abs(below(basstime, 1000)), 1000, basstime);
per_frame_4=basstime = basstime + 0.03 * bass_att;
per_frame_5=vol = pow(bass + mid + treb, 2);
per_frame_6=basssum = vol;
per_frame_7=stickybit = mod(time, 2);
per_frame_8=volavg = volavg + vol * equal(stickybit, 1);
per_frame_9=sample1 = sample1 + equal(stickybit, 1);
per_frame_10=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_11=sample2 = sample2 + equal(stickybit, 0);
per_frame_12=edge = bnot(equal(bit2, stickybit));
per_frame_13=volavg = volavg - volavg * edge * stickybit;
per_frame_14=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_15=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_16=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_17=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_18=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_19=q3 = diff;
per_frame_20=bit2 = mod(time, 2);
per_frame_21=difftime = difftime + 0.03 * diff;
per_frame_22=q2 = difftime;
per_frame_23=difftime = if(0.00001 < abs(above(difftime, 2000)), 0, difftime);
per_frame_24=monitor = q3;
