per_frame_init_1=ray = 0;
per_frame_init_2=q1 = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.5 * sin(33 * treb_att) + 0.3 * bass_att;
per_frame_3=wave_b = wave_b + 0.5 * sin(33 * treb_att) + 0.3 * mid_att;
per_frame_4=rot = 0.4 * (sin(time) / 2) * sin(0.1 * treb_att);
