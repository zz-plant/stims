[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_fc_main, uv).xyz * clamp (q1, 0.0, 1.0));
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (uv_orig - vec2(0.5, 0.75));
  float tmpvar_3;
  tmpvar_3 = (1.0/(tmpvar_2.y));
  vec2 tmpvar_4;
  tmpvar_4.x = ((tmpvar_2.x * tmpvar_3) * 0.25);
  tmpvar_4.y = (tmpvar_3 * 0.25);
  vec2 tmpvar_5;
  tmpvar_5 = clamp (((
    (1.0 - abs(((
      fract(((tmpvar_2 + vec2(0.5, 1.0)) * 0.5))
     * 2.0) - 1.0)))
   + vec2(0.0, -0.2)) - (
    ((texture (sampler_noise_hq, ((tmpvar_4 + 
      (vec2(0.5, 0.25) * time)
    ) / 2.0)) - 0.5) * float(int((tmpvar_2.y > 0.0))))
  .xy * 0.025)), 0.0, 1.0);
  ret_1 = (mix (texture (sampler_main, tmpvar_5).xyz, texture (sampler_main, (
    (vec2(-0.993, 0.993) * (tmpvar_5 - 0.5))
   + 0.5)).xyz, vec3(0.5, 0.5, 0.5)) * 2.4);
  vec3 tmpvar_6;
  tmpvar_6 = sqrt(ret_1);
  ret_1 = (tmpvar_6 * tmpvar_6);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_1;
  ret = tmpvar_7.xyz;
 }
