shape_0_init17=blueif = 0;
shape_0_init18=blueif = 0;
shape_0_init19=redif = 0;
shape_0_init20=greenif = 0;
shape_0_init21=blueif = 0;
shape_0_per_frame1=y = q2;
shape_0_per_frame2=x = q1;
shape_0_per_frame3=vol = 0.3333 * (bass + mid + treb_att);
shape_0_per_frame4=redsine = 0.5 + 0.15 * bass * sin(3 * time);
shape_0_per_frame5=greensine = 0.5 + 0.15 * mid * sin(2 * time);
shape_0_per_frame6=bluesine = 0.5 + 0.15 * treb * sin(time);
shape_0_per_frame7=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.985 * redif));
shape_0_per_frame8=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.985 * greenif));
shape_0_per_frame9=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.985 * blueif));
shape_0_per_frame10=border_r = redif;
shape_0_per_frame11=border_g = greenif;
shape_0_per_frame12=border_b = blueif;
shape_1_init1=ptex_ang = 0;
shape_1_init2=ptex_ang = 0;
shape_1_init3=q1 = 0;
shape_1_init4=q2 = 0;
shape_1_per_frame1=tex_ang = if(0.00001 < abs(above(treb, 1.2)), tex_ang + abs(6.28 * sin(time)), ptex_ang);
shape_1_per_frame2=ptex_ang = tex_ang;
shape_1_per_frame3=x = q1 + 0.1 * cos(0.71 * time);
shape_1_per_frame4=y = q2 + 0.1 * sin(0.66 * time);
shape_2_init1=ptex_ang = 0;
shape_2_init2=ptex_ang = 0;
shape_2_init3=q1 = 0;
shape_2_init4=q2 = 0;
shape_2_per_frame1=tex_ang = if(0.00001 < abs(above(mid, 1.1)), tex_ang + abs(6.28 * sin(0.7 * time)), ptex_ang);
shape_2_per_frame2=ptex_ang = tex_ang;
shape_2_per_frame3=x = q1 + 0.1 * sin(0.63 * time);
shape_2_per_frame4=y = q2 + 0.1 * cos(0.54 * time);
shape_3_init1=ptex_ang = 0;
shape_3_init2=ptex_ang = 0;
shape_3_init3=q1 = 0;
shape_3_init4=q2 = 0;
shape_3_per_frame1=tex_ang = if(0.00001 < abs(above(bass_att, 1)), tex_ang + abs(6.28 * sin(time)), ptex_ang);
shape_3_per_frame2=ptex_ang = tex_ang;
shape_3_per_frame3=x = q1 + 0.1 * sin(0.33 * time);
shape_3_per_frame4=y = q2 + 0.1 * cos(0.29 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_fw_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_fw_main, uv);
  float tmpvar_3;
  tmpvar_3 = ((texture (sampler_blur1, uv).xyz * scale1) + bias1).x;
  ret_1 = (tmpvar_2.xyz + (2.0 * texture (sampler_fw_main, (uv - 
    (0.35 * tmpvar_3)
  ))).xyz);
  ret_1 = (1.0 - (ret_1 * (3.5 * 
    dot (vec3((tmpvar_2.x * tmpvar_3)), vec3(0.32, 0.49, 0.29))
  )));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }
