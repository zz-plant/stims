per_frame_init_1=pi = 0;
per_frame_init_2=volsine = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q2 = 0;
per_frame_init_5=decay = 0.1;
per_frame_1=sx = 1;
per_frame_2=sy = 1;
per_frame_3=q1 = 0.5 + 0.1 * cos(0.21 * time);
per_frame_4=q2 = 0.5 + 0.1 * sin(0.32 * time);
per_pixel_1=pi = 3.14159;
per_pixel_2=volsine = 0.05 * (bass + mid + treb) * sin(time * (0.1 * bass + 0.1 * mid + 0.1 * treb));
per_pixel_3=cx = q1;
per_pixel_4=cy = q2;
per_pixel_5=rot = -0.03 * rad * sin(0.11 * time);
per_pixel_6=rot = rot + 0.01 * rad * sin(rad * time * 40);
shape_0_init1=q2 = 0;
shape_0_init2=q1 = 0;
shape_0_init3=vol = 0;
shape_0_init4=redsine = 0;
shape_0_init5=greensine = 0;
shape_0_init6=bluesine = 0;
shape_0_init7=redif = 0;
shape_0_init8=redsine = 0;
shape_0_init9=redif = 0;
shape_0_init10=redif = 0;
shape_0_init11=greenif = 0;
shape_0_init12=greensine = 0;
shape_0_init13=greenif = 0;
shape_0_init14=greenif = 0;
shape_0_init15=blueif = 0;
