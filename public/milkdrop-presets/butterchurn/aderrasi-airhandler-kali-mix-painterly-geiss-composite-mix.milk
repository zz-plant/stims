[preset00]
fRating=0.000000
fGammaAdj=2.001000
fDecay=0.950000
fVideoEchoZoom=1.000000
nWaveMode=1.000000
bTexWrap=0.000000
fWaveAlpha=3.073000
fWaveScale=1.286000
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=0.999510
fWarp=0.010100
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.005000
fOuterBorderA=0.800000
fInnerBorderSize=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_2=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_3=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_pixel_1=zoom = zoom + 0.05 * (sin(6 * ang) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.1 * cos(rad));
per_pixel_2=rot = rot + 0.5 * sin(0.5 - rad) * cos(0.02 * (0.5 - rad) + time);
per_pixel_3=sx = sx + 0.01 * (0.99 - rad) * sin(0.733 * time) * below(sin(time), 0);
per_pixel_4=sy = sy + 0.01 * (0.99 - rad) * cos(0.953 * time) * above(sin(time), 0);
per_pixel_5=zoom = zoom - 0.05 * (1 - rad) * below(rad, 0.5);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.03))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, (((uv - 0.5) * 3.0) + 0.5));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = mix (tmpvar_1.xyz, tmpvar_2.xyz, vec3(clamp ((
    dot (((tmpvar_1.xyz - tmpvar_2.xyz) + 0.15), vec3(0.32, 0.49, 0.29))
   * -99.0), 0.0, 1.0)));
  ret = tmpvar_3.xyz;
 }
