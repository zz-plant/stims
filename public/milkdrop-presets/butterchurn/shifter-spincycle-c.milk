per_frame_init_1=tic = 0;
per_frame_init_2=vt = 0;
per_frame_init_3=des = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=bt = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=xd = 0;
per_frame_init_9=mid_avg = 0;
per_frame_init_10=dis = 0;
per_frame_init_11=tt = 0;
per_frame_init_12=tin = 0;
