per_frame_1=sure = if(0.00001 < abs(equal(sure, 0)), 0.6, sure);
per_frame_2=interval = if(0.00001 < abs(equal(interval, 0)), 40, interval);
per_frame_3=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), frame - fps, lastbeat);
per_frame_4=dbass = (bass - pbass) / fps;
per_frame_5=beat = above(dbass, 0.6 * maxdbass) * above(frame - lastbeat, fps / 3);
per_frame_6=sure = if(0.00001 < abs(beat * below(abs(frame - (interval + lastbeat)), fps / 5)), min(0.095 + sure, 1), beat * (sure - 0.095) + (1 - beat) * sure * 0.9996);
per_frame_7=sure = max(0.5, sure);
per_frame_8=cheat = if(0.00001 < abs(above(frame, lastbeat + interval + floor(fps / 10)) * above(sure, 0.91)), 1, cheat);
per_frame_9=beat = if(0.00001 < abs(cheat), 1, beat);
per_frame_10=sure = if(0.00001 < abs(cheat), 0.95 * sure, sure);
per_frame_11=maxdbass = max(0.999 * maxdbass, dbass);
per_frame_12=maxdbass = max(0.012, maxdbass);
per_frame_13=maxdbass = min(0.02, maxdbass);
per_frame_14=interval = if(0.00001 < abs(beat), frame - lastbeat, interval);
per_frame_15=lastbeat = if(0.00001 < abs(beat), frame - cheat * floor(fps / 10), lastbeat);
per_frame_16=cheat = 0;
per_frame_17=pbass = bass;
per_frame_18=wave_r = 0.8 * abs(cos(0.07 * time + 0.532 + sin(0.125 * time + 0.789)));
per_frame_19=wave_g = 0.8 * abs(cos(0.092 * time + 2.1 + sin(0.045 * time + 1.52)));
per_frame_20=wave_b = 0.8 * abs(cos(0.1 * time + 1.452 + sin(0.112 * time + 2.98)));
per_frame_21=q1 = beat;
per_frame_22=ib_a = beat;
per_frame_23=ib_r = 1 - wave_r;
per_frame_24=ib_g = 1 - wave_g;
per_frame_25=ib_b = 1 - wave_b;
per_frame_26=wave_mystery = 1 - 1.5 * min((frame - lastbeat) / interval, 1);
per_frame_27=wave_a = if(0.00001 < abs(above((frame - lastbeat) / interval, 1)), 0, 1);
per_frame_28=phase = if(0.00001 < abs(equal(mod(frame, interval), 0)), phase + 1, phase);
per_frame_29=phase = if(0.00001 < abs(equal(mod(phase, 18), 17)), 0, phase);
per_frame_30=midphase = min((frame - lastbeat) / interval, 1);
per_frame_31=sx = if(0.00001 < abs(equal(phase, 15) * equal(mod(frame, interval), 0)), -1, sx);
per_frame_32=sy = if(0.00001 < abs(equal(phase, 26) * equal(mod(frame, interval), 0)), -1, sy);
per_frame_33=phase = if(0.00001 < abs(equal(mod(frame, interval), 0) * below(cos(time / 6), -0.5)), mod(phase + randint(13), 14) + 1, phase);
per_frame_34=q2 = phase;
per_frame_35=q3 = midphase;
per_pixel_1=zoom = 1 + 0.01 * sin(13.28 * rad);
per_pixel_2=zoom = zoom + equal(q2, 1) * q3 * 0.1 * (x - 0.5);
per_pixel_3=zoom = zoom + equal(q2, 2) * q3 * 0.1 * (0.5 - x);
per_pixel_4=zoom = zoom + equal(q2, 5) * q3 * 0.1 * (0.5 - y);
per_pixel_5=zoom = zoom + equal(q2, 4) * q3 * 0.1 * (y - 0.5);
per_pixel_6=rot = rot + equal(q2, 3) * q3 * 0.3;
per_pixel_7=rot = rot - equal(q2, 6) * q3 * 0.3;
per_pixel_8=sx = sx + equal(q2, 7) * q3 * 0.2;
per_pixel_9=sy = sy - equal(q2, 8) * q3 * 0.2;
per_pixel_10=sx = sx - equal(q2, 9) * q3 * 0.2;
per_pixel_11=sy = sy + equal(q2, 10) * q3 * 0.2;
per_pixel_12=dy = dy + equal(q2, 11) * abs(0.5 - x) * sign(0.5 - x) * q3 * 0.2;
per_pixel_13=dx = dx + equal(q2, 12) * abs(0.5 - y) * sign(0.5 - y) * q3 * 0.2;
per_pixel_14=dx = dx - equal(q2, 14) * abs(0.5 - y) * sign(0.5 - y) * q3 * 0.2;
per_pixel_15=dy = dy - equal(q2, 13) * abs(0.5 - x) * sign(0.5 - x) * q3 * 0.2;
