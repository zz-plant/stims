per_frame_init_13=peakbass_att = 0;
per_frame_init_14=ang2 = 0;
per_frame_init_15=dv = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=volume = 0;
per_frame_init_18=beat = 0;
per_frame_init_19=q2 = 0;
per_frame_init_20=dist = 0;
per_frame_init_21=q3 = 0;
per_frame_init_22=q8 = 0;
per_frame_init_23=oldq8 = 0;
per_frame_init_24=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=mv_r = mv_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_3=mv_g = mv_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_4=mv_b = mv_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_5=q8 = oldq8 + 0.005 * (pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_6=oldq8 = q8;
per_frame_7=q1 = 0.62 * (0.6 * sin(0.374 * q8) + 0.4 * sin(0.294 * q8));
per_frame_8=q2 = 0.62 * (0.6 * sin(0.393 * q8) + 0.4 * sin(0.223 * q8));
per_frame_9=q3 = 0.62 * (0.6 * sin(0.174 * -q8) + 0.4 * sin(0.364 * q8));
per_frame_10=q4 = 0.62 * (0.6 * sin(0.234 * q8) + 0.4 * sin(0.271 * -q8));
per_frame_11=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_12=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_13=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_14=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_15=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_16=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_17=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_18=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_19=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_20=ob_a = bnot(beat);
per_frame_21=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_22=q5_residual = 0.016 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * q5_residual;
per_frame_23=q6_residual = 0.012 * equal(bass_thresh, 2) * sin(9 * time) + (1 - equal(bass_thresh, 2)) * q6_residual;
per_frame_24=q5 = 1 - abs(4 * q5_residual);
per_frame_25=q6 = 1 - abs(4 * q5_residual);
per_frame_26=wave_a = 0;
per_frame_27=zoom = 1000;
per_frame_28=monitor = q8;
per_pixel_1=du = 2 * x - 1 - q1;
per_pixel_2=dv = 2 * y - 1 - q2;
per_pixel_3=dist = sqrt(du * du + dv * dv);
per_pixel_4=ang2 = atan2(du, dv);
per_pixel_5=mult = q5 / (dist + 0.4);
per_pixel_6=dx = mult * sin(ang2 - 1.5);
per_pixel_7=dy = mult * cos(ang2 - 1.5);
per_pixel_8=du = 2 * x - 1 - q3;
per_pixel_9=dv = 2 * y - 1 - q4;
per_pixel_10=dist = sqrt(du * du + dv * dv);
per_pixel_11=ang2 = atan2(du, dv);
per_pixel_12=mult = q6 / (dist + 0.4);
per_pixel_13=dx = dx + mult * sin(ang2 + 1.5);
per_pixel_14=dy = dy + mult * cos(ang2 + 1.5);
per_pixel_15=rot = -0.01 * rad * sin(q8);
