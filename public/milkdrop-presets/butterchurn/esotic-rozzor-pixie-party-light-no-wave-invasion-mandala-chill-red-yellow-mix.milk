per_frame_init_1=q2 = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q3 = 0;
per_frame_init_4=vol_now = 0;
per_frame_init_5=vol_mean = 0;
per_frame_init_6=beat = 0;
per_frame_init_7=slowtime = 0;
per_frame_1=mv_l = 1.21894646 * randint(floor(ob_size * zoom));
per_frame_2=wave_y = bnot(wave_y + mv_b);
per_frame_3=zoomexp = -1.9620862 * abs(1.40700197 * log10(wave_b * wave_mode));
per_frame_4=mv_b = zoom * cx;
per_frame_5=ob_g = 1.96492791 * sign(if(0.00001 < abs(equal(wave_mystery * wave_y, mv_x * ob_a)), 0.71052909 * log(ob_g * warp), wave_x * sy));
per_frame_6=dy = if(0.00001 < abs(below(sy * ob_r, mv_b * mv_x)), sigmoid(mv_l * dy, ib_size * mv_y), ob_a * mv_x);
per_frame_7=mv_l = mv_l * warp;
per_frame_8=ib_b = if(0.00001 < abs(below(decay + ib_g, cy * ob_size)), wave_mystery * warp, wave_mystery * mv_g);
per_frame_9=mv_x = 0.68256116 * abs(mv_a - mv_r);
per_frame_10=wave_y = sigmoid(sigmoid(wave_y * zoomexp, ib_a * ib_g), ib_b + mv_l);
per_frame_11=ob_b = max(-1.81535745 * log10(ob_b * ib_a), ob_r * wave_b);
per_frame_12=zoomexp = if(0.00001 < abs(below(zoomexp, 0.01)), 0.01, zoomexp);
per_frame_13=zoomexp = if(0.00001 < abs(above(zoomexp, 100)), 100, zoomexp);
per_frame_14=dy = if(0.00001 < abs(below(dy, -1)), -1, dy);
per_frame_15=dy = if(0.00001 < abs(above(dy, 1)), 1, dy);
per_frame_16=wave_y = if(0.00001 < abs(below(wave_y, 0)), 0, wave_y);
per_frame_17=wave_y = if(0.00001 < abs(above(wave_y, 1)), 1, wave_y);
per_frame_18=ob_g = if(0.00001 < abs(below(ob_g, 0)), 0, ob_g);
per_frame_19=ob_g = if(0.00001 < abs(above(ob_g, 1)), 1, ob_g);
per_frame_20=ob_b = if(0.00001 < abs(below(ob_b, 0)), 0, ob_b);
per_frame_21=ob_b = if(0.00001 < abs(above(ob_b, 1)), 1, ob_b);
per_frame_22=ib_b = if(0.00001 < abs(below(ib_b, 0)), 0, ib_b);
per_frame_23=ib_b = if(0.00001 < abs(above(ib_b, 1)), 1, ib_b);
per_frame_24=mv_b = if(0.00001 < abs(below(mv_b, 0)), 0, mv_b);
per_frame_25=mv_b = if(0.00001 < abs(above(mv_b, 1)), 1, mv_b);
per_frame_26=mv_x = if(0.00001 < abs(below(mv_x, 0)), 0, mv_x);
per_frame_27=mv_x = if(0.00001 < abs(above(mv_x, 64)), 64, mv_x);
per_frame_28=mv_l = if(0.00001 < abs(below(mv_l, 0)), 0, mv_l);
per_frame_29=mv_l = if(0.00001 < abs(above(mv_l, 5)), 5, mv_l);
per_frame_30=vol_now = 0.4 * bass + 0.1 * (bass_att + treb + mid);
per_frame_31=vol_mean = if(0.00001 < abs(equal(mod(frame, 50), 0)), vol_mean - 0.5 * (vol_mean - vol_now), 0.1 * (9 * vol_mean + vol_now));
per_frame_32=beat = if(0.00001 < abs(above(vol_now, 1.15 * vol_mean)), 1, 0);
per_frame_33=slowtime = slowtime + beat * time;
per_frame_34=q2 = sin(slowtime);
per_frame_35=ob_g = bass;
per_pixel_1=warp = 0.36676717 * pow(q2 - y, q2 * q1);
per_pixel_2=warp = 1.82335234 * pow(-0.69122636 * log10(warp * q2), q1 * x);
per_pixel_3=cx = -0.51261795 * sqrt(q3 * q1);
per_pixel_4=warp = if(0.00001 < abs(below(warp, 0.01)), 0.01, warp);
per_pixel_5=warp = if(0.00001 < abs(above(warp, 100)), 100, warp);
per_pixel_6=cx = if(0.00001 < abs(below(cx, -1)), -1, cx);
per_pixel_7=cx = if(0.00001 < abs(above(cx, 2)), 2, cx);
shape_0_init1=q2 = 0;
shape_0_init2=q2 = 0;
shape_0_init3=q2 = 0;
shape_0_init4=my_ang = 0;
shape_0_init5=my_ang = 0;
shape_0_init6=my_ang = 0;
shape_0_per_frame1=border_r = border_r + 1.5 * sin(1.13 * q2);
shape_0_per_frame2=border_b = border_b + 0.5 * sin(1.23 * q2);
shape_0_per_frame3=border_g = border_g + 0.5 * sin(1.33 * q2);
shape_0_per_frame4=my_ang = my_ang + (0.005 + 0.001 * bass);
shape_0_per_frame5=ang = my_ang;
