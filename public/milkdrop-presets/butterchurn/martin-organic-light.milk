  )) + (64.0 * xlat_mutabledz));
  float tmpvar_4;
  tmpvar_4 = clamp ((0.01 / sqrt(
    dot (xlat_mutableuv3, xlat_mutableuv3)
  )), 0.0, 1.0);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = (clamp ((
    (12.0 * ((texture (sampler_main, (tmpvar_3 + 
      (0.2 * xlat_mutabledz)
    )).xyz - (q1 * xlat_mutabledz.y)) + 0.04))
   * 
    (0.1 + max (vec3(0.0, 0.0, 0.0), ((
