 }

[comp_shader]
vec2 xlat_mutabledz;
vec2 xlat_mutableuv3;
 shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.y = 0.0;
  tmpvar_1.x = texsize.z;
  vec2 tmpvar_2;
  tmpvar_2.x = 0.0;
  tmpvar_2.y = texsize.w;
  vec2 tmpvar_3;
  tmpvar_3.x = ((uv.x - 0.5) + 0.5);
  tmpvar_3.y = uv.y;
  xlat_mutabledz.x = dot ((texture (sampler_main, (tmpvar_3 + tmpvar_1)).xyz - texture (sampler_main, (tmpvar_3 - tmpvar_1)).xyz), vec3(0.32, 0.49, 0.29));
  xlat_mutabledz.y = dot ((texture (sampler_main, (tmpvar_3 + tmpvar_2)).xyz - texture (sampler_main, (tmpvar_3 - tmpvar_2)).xyz), vec3(0.32, 0.49, 0.29));
  xlat_mutableuv3 = ((0.4 * cos(
