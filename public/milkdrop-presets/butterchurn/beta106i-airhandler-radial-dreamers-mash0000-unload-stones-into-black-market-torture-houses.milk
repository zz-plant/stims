per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_2=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_3=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_frame_4=wave_x = wave_x + 0.2 * sin(0.32 * time);
per_frame_5=wave_y = wave_y + 0.2 * cos(0.32 * time);
per_frame_6=ob_r = wave_r;
per_frame_7=ob_g = wave_g;
per_frame_8=ob_b = wave_b;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 0.0095 * (sin(50 + 25 * cos(0.2 * time) * rad) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.1 * cos(rad));
per_pixel_5=rot = rot + 0.08 * abs(0.746 - rad) * sin(2.2 * (0.5 - rad) + 5.7 * sin(0.1 * time));
per_pixel_6=sx = sx + 0.01 * (0.99 - rad) * sin(0.733 * time) * below(sin(time), 0);
per_pixel_7=sy = sy + 0.01 * (0.99 - rad) * cos(0.953 * time) * above(sin(time), 0);
per_pixel_8=zoom = zoom - 0.015 * (1.5 - rad) * below(rad, 1.5);

[warp_shader]
shader_body { 
  vec3 rsamp_1;
  vec3 ret_2;
  vec4 tmpvar_3;
  tmpvar_3 = texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy));
  vec4 tmpvar_4;
  tmpvar_4 = texture (sampler_pw_main, uv_orig);
  ret_2 = tmpvar_4.xyz;
  vec4 tmpvar_5;
  tmpvar_5 = texture (sampler_pw_main, (uv_orig + ((
    (tmpvar_3.xy - 0.5)
   * 12.0) * texsize.zw)));
  vec3 tmpvar_6;
  tmpvar_6 = tmpvar_5.xyz;
  rsamp_1 = tmpvar_6;
  float tmpvar_7;
  vec2 x_8;
  x_8 = (tmpvar_4.xy - uv_orig);
  tmpvar_7 = sqrt(dot (x_8, x_8));
  float tmpvar_9;
  vec2 x_10;
  x_10 = (tmpvar_5.xy - uv_orig);
  tmpvar_9 = sqrt(dot (x_10, x_10));
  if ((tmpvar_7 > tmpvar_9)) {
    ret_2.xy = tmpvar_6.xy;
  };
  vec4 tmpvar_11;
  tmpvar_11 = texture (sampler_pw_main, (uv_orig + ((
    (tmpvar_3.zw - 0.5)
   * 48.0) * texsize.zw)));
  rsamp_1 = tmpvar_11.xyz;
  float tmpvar_12;
  vec2 x_13;
  x_13 = (ret_2.xy - uv_orig);
  tmpvar_12 = sqrt(dot (x_13, x_13));
  float tmpvar_14;
  vec2 x_15;
  x_15 = (tmpvar_11.xy - uv_orig);
  tmpvar_14 = sqrt(dot (x_15, x_15));
  if ((tmpvar_12 > tmpvar_14)) {
    ret_2.xy = rsamp_1.xy;
  };
  ret_2.z = texture (sampler_fw_main, ret_2.xy).z;
  ret_2.z = (ret_2.z - (q1 * 0.005));
  if ((ret_2.z < 0.09)) {
    ret_2 = vec3(0.0, 0.0, 0.0);
  };
  vec4 tmpvar_16;
  tmpvar_16.w = 1.0;
  tmpvar_16.xyz = ret_2;
  ret = tmpvar_16.xyz;
 }
