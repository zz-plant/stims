per_frame_1=count = if(0.00001 < abs(below(count, 9)), count + 1, 0);
per_frame_2=q1 = 0.5;
per_frame_3=q2 = 0.5;
per_frame_4=q3 = count;
per_frame_5=q4 = aspectx;
per_frame_6=q5 = aspecty;
per_pixel_1=timer_a = 10 * sin(time);
per_pixel_2=timer_b = 10 * sin(0.5 * time);
per_pixel_3=ripple_x = cos(x * timer_a - timer_b) * bass_att;
per_pixel_4=ripple_y = cos(y * timer_a - timer_b) * treb_att;
per_pixel_5=ripple_r = cos(rad * timer_b - timer_a) * mid_att;
per_pixel_6=ripple = ripple_x + ripple_y + ripple_r;
per_pixel_7=zoom = zoom + 0.1 * ripple;
