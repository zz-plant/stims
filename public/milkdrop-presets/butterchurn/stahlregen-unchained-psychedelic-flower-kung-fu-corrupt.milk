shape_0_per_frame4=border_a = 0;
shape_0_per_frame5=instance_counter = 3.14 * instance * (2 / num_instance);
shape_0_per_frame6=x = q1 + (0.1 + 0.1 * treb_att) * (1 / q5) * sin(instance_counter);
shape_0_per_frame7=y = q2 + (0.1 + 0.1 * treb_att) * (1 / q4) * cos(instance_counter);
