per_frame_7=cy = cy + 0.07 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_pixel_1=dx = dx - 0.05 * sin(1.35 * time + 18 * (2 * x - 1));
per_pixel_2=dy = dy - 0.05 * sin(1.79 * time + 13 * (2 * y - 1));
