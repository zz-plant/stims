fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
nWaveMode=5.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.032000
fWaveScale=4.778000
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpAnimSpeed=30.965000
fWarpScale=2.572000
fZoom=1.009010
fWarp=0.000540
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_samples=16.000000
wavecode_0_thick=1.000000
wavecode_0_additive=1.000000
wavecode_1_enabled=0.000000
