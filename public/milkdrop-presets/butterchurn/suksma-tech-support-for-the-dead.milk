per_frame_init_1=vol = 0;
per_frame_init_2=q2 = 0;
per_frame_1=vol = min((5 * bass + 3 * mid_att + 2 * treb) / 10 + 0.15, 2.15);
per_frame_2=wave_r = wave_r + 0.05 * sin(3.23 * time) + 0.05 * sin(0.46 * time);
per_frame_3=wave_g = wave_g + 0.2 * sin(2.71 * time) + 0.05 * sin(0.76 * time);
per_frame_4=wave_b = wave_b + 0.15 * sin(1.132 * time) + 0.05 * sin(0.546 * time);
per_frame_5=wave_g = if(0.00001 < abs(below(wave_r + wave_g + wave_b, 0.1)), wave_g + 0.5, wave_g);
per_frame_6=wave_x = wave_x + 0.03 * vol * sin(0.727 * time);
per_frame_7=wave_y = wave_y + 0.04 * vol * sin(0.777 * time);
per_frame_8=zoom = 0.3 * vol + 0.06 * sin(0.54 * time) + 0.97;
per_frame_9=dx = dx + 0.0075 * sin(1.23 * time);
per_frame_10=dy = dy + 0.0075 * sin(1.43 * time);
per_frame_11=rot = rot + 0.05 * sin(time);
per_frame_12=q2 = bass + treb + mid;
per_pixel_1=zoom = zoom - 0.9 * rad;
wave_0_init1=q3 = 0;
wave_0_per_point1=q3 = bnot(q3);
wave_0_per_point2=x = 0.5 + equal(q3, 0) * (floor(randint(50)) - 25) * 0.02;
wave_0_per_point3=y = 0.5 + equal(q3, 0) * (floor(randint(50)) - 25) * 0.02;
wave_1_init1=cd = 0;
wave_1_init2=c = 0;
wave_1_per_point1=r = 0.05 * bass;
wave_1_per_point2=cd = cd + 0.001;
wave_1_per_point3=c = 0.62831854 * floor(randint(10));
wave_1_per_point4=c = c + cd;
wave_1_per_point5=x = 0.5 + cos(c) * r;
wave_1_per_point6=y = 0.5 + sin(c) * r;
wave_1_per_point7=r = abs(sin(0.77 * time));
wave_1_per_point8=g = 0.5 * treb;
shape_0_init1=ra = 0;
shape_0_init2=ra = 0;
shape_0_init3=ra = 0;
shape_0_per_frame1=ra = ra - 0.01 * bass_att;
shape_0_per_frame2=ang = ra;
shape_0_per_frame3=x = abs(sin(0.1 * time));
shape_0_per_frame4=y = abs(cos(0.3 * (time + 0.2)));
shape_1_init1=ra = 0;
shape_1_init2=ra = 0;
shape_1_init3=ra = 0;
shape_1_per_frame1=ra = ra + 0.025 * treb_att;
shape_1_per_frame2=ang = ra;
shape_1_per_frame3=x = abs(sin(0.2 * time));
shape_1_per_frame4=y = abs(cos(0.7 * time));
shape_2_init1=ra = 0;
shape_2_init2=ra = 0;
shape_2_init3=ra = 0;
shape_2_per_frame1=ra = ra + if(0.00001 < abs(above(treb, 0.5)), 0.03 * treb, 0.01);
shape_2_per_frame2=ang = ra;
shape_2_per_frame3=rad = rad + 0.1 * treb_att;
shape_2_per_frame4=y = abs(sin(0.23 * time));
shape_2_per_frame5=x = abs(cos(0.7 * time));
shape_3_init1=ra = 0;
shape_3_init2=ra = 0;
shape_3_init3=ra = 0;
shape_3_per_frame1=ra = ra - if(0.00001 < abs(above(bass, 1.3)), 0.02 * bass, 0.01);
shape_3_per_frame2=ang = ra;
shape_3_per_frame3=rad = rad + 0.1 * bass_att;
shape_3_per_frame4=x = abs(sin(0.25 * time));

[warp_shader]
uniform sampler2D sampler_prayerwheel;
 shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)
  ).xyz - 0.5) / 256.0));
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_prayerwheel, uv_orig);
  vec2 x_3;
  x_3 = (uv - uv_orig);
  ret_1 = (mix (ret_1, tmpvar_2.xyz, vec3(clamp (
    (1.0 - (abs((
      dot (tmpvar_2.xyz, vec3(0.32, 0.49, 0.29))
     - 
      fract((((bass + mid) + treb) * 0.2))
    )) * 33.0))
  , 0.0, 1.0))) * (0.97 + (0.03 * 
    clamp ((sqrt(dot (x_3, x_3)) * 200.0), 0.0, 1.0)
  )));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (texsize.zw * 8.0);
  vec2 tmpvar_3;
  tmpvar_3.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_2))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_2))
  ).xyz * scale1) + bias1)).y;
  tmpvar_3.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_2))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_2))
  ).xyz * scale1) + bias1)).y;
  vec2 tmpvar_4;
  tmpvar_4 = (uv + (tmpvar_3 * 0.55));
  vec3 tmpvar_5;
  tmpvar_5 = mix (ret_1, (1.0 - ret_1), ((0.7 * 
    ((texture (sampler_blur1, tmpvar_4).xyz * scale1) + bias1)
  ) + (0.2 * texture (sampler_main, uv).xyz)));
  vec3 tmpvar_6;
  tmpvar_6 = mix (tmpvar_5, ((
    (tmpvar_5 - (0.1 * ((texture (sampler_blur3, tmpvar_4).xyz * scale3) + bias3)))
   + 
    (0.1 * ((texture (sampler_blur1, (
      (tmpvar_4 * 1.25)
     - 0.125)).xyz * scale1) + bias1))
  ) + (0.42 * texture (sampler_main, tmpvar_4).xyz)), vec3(0.25, 0.25, 0.25));
  vec3 x_7;
  x_7 = (tmpvar_6 - 0.5);
  ret_1 = (tmpvar_6 * clamp ((
    sqrt(dot (x_7, x_7))
   * 5.0), 0.0, 1.0));
  ret_1 = (vec3(dot (ret_1, vec3(0.32, 0.49, 0.29))) + 1.25);
  ret_1 = (ret_1 * (ret_1 * 0.45));
  ret_1 = (ret_1 * mix (ret_1, (
    (1.3 * ret_1)
   * 
    ((((texture (sampler_blur3, uv).xyz * scale3) + bias3) - ((texture (sampler_blur1, uv).xyz * scale1) + bias1)) - (0.25 * ((texture (sampler_blur2, tmpvar_4).xyz * scale2) + bias2)))
  ), pow (hue_shader.zxy, 
    (q2 * (1.0 - ret_1))
  )));
  ret_1 = (ret_1 + 0.05);
  ret_1 = (ret_1 * (1.1 * ret_1));
  ret_1 = (ret_1 * ((hue_shader * 4.0) - 2.75));
  ret_1 = (ret_1 * (3.5 - (0.5 * 
    clamp (ret_1, 0.0, 1.0)
  )));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = ret_1;
  ret = tmpvar_8.xyz;
 }
