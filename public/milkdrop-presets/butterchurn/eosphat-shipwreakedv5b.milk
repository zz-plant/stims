per_frame_1=decay = 1;
per_frame_2=vol = 0.25 * (bass + mid + treb);
per_frame_3=vol = vol * vol;
per_frame_4=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_5=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_6=musictime = musictime + vol;
per_frame_7=q4 = 0;
per_frame_8=q5 = 0;
per_frame_9=dx = 0.07 * sin(0.1 * musictime);
per_frame_10=dy = 0.01 * cos(0.069 * musictime);
per_frame_11=q1 = 0.4 * sin(0.001 * musictime) + 0.5;
per_frame_12=q2 = 0.5 * cos(0.001 * musictime) + 0.5;
per_frame_13=q8 = musictime;
per_frame_14=zoom = 0.4;
per_frame_15=monitor = rot;
per_frame_16=musictime = musictime + mid * mid * 0.003;
per_frame_17=basstime = basstime + bass * bass * 0.03;
per_frame_18=xpos = 0.01 * sin(0.6 * musictime);
per_frame_19=ypos = 0.01 * sin(0.4 * musictime);
per_frame_20=q4 = xpos;
per_frame_21=q5 = ypos;
per_frame_22=q6 = basstime;
per_pixel_1=rot = rad + ang / 100;
wave_0_init1=n = 0;
wave_0_init2=size = 0;
wave_0_init3=flux = 0;
wave_0_init4=tm = 0;
wave_0_per_point1=n = 6.283 * sample;
wave_0_per_point2=size = 0.165;
wave_0_per_point3=x = 0;
wave_0_per_point4=y = sample;
wave_0_per_point5=flux = 0.5 * sin(2 * n - time) + 0.5;
wave_0_per_point6=flux = flux * min(10 * (1 - 2 * abs(y - 0.5)), 1);
wave_0_per_point7=tm = 0.3 * time;
wave_0_per_point8=r = 0.5 * sin(n + tm) + 0.5;
wave_0_per_point9=g = 0.5 * sin(n + 2.1 + tm) + 0.5;
wave_0_per_point10=b = 0.5 * sin(n + 4.2 + tm) + 0.5;
wave_0_per_point11=r = r * flux;
wave_0_per_point12=g = g * flux;
wave_0_per_point13=b = b * flux;
