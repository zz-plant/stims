shape_0_per_frame1=sample = instance / num_inst;
shape_0_per_frame2=rad = 0.22 * sample;
shape_0_per_frame3=r = sample;
shape_0_per_frame4=ang = (1 - sample) * time * 15;
shape_0_per_frame5=sides = 14 * (1 - sample);
shape_0_per_frame6=t1 = sample + 0.2 * time;
shape_0_per_frame7=mx = 0.4 * (0.6 * sin(7 * t1) + 0.4 * sin(4.3 * t1));
shape_0_per_frame8=my = 0.4 * (0.6 * cos(3.3 * t1) + 0.4 * cos(6.9 * t1)) * sin(-10 + 20 * sample);
shape_0_per_frame9=mz = 0.4 * (0.6 * cos(4.1 * t1) + 0.4 * cos(6.9 * t1)) * cos(-5 + 10 * sample);
shape_0_per_frame10=d = 1;
shape_0_per_frame11=zoom = 1;
shape_0_per_frame12=w1 = 0.3 * time;
shape_0_per_frame13=w2 = 0.1 * time;
shape_0_per_frame14=w3 = 0.2 * time;
shape_0_per_frame15=x1 = cos(w1) * mx + sin(w1) * my;
shape_0_per_frame16=y1 = -sin(w1) * mx + cos(w1) * my;
shape_0_per_frame17=z1 = mz;
shape_0_per_frame18=x2 = cos(w2) * x1 + sin(w2) * z1;
shape_0_per_frame19=z2 = -sin(w2) * x1 + cos(w2) * z1;
shape_0_per_frame20=y2 = y1;
shape_0_per_frame21=y3 = cos(w3) * y2 + sin(w3) * z2;
shape_0_per_frame22=z3 = -sin(w3) * y2 + cos(w3) * z2;
shape_0_per_frame23=x3 = x2;
shape_0_per_frame24=l = sqrt(x3 * x3 + y3 * y3);
shape_0_per_frame25=w = atan2(x3, y3);
shape_0_per_frame26=p = tan(asin(1) + atan2(d + z3, l));
shape_0_per_frame27=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_0_per_frame28=my_x = zoom * sin(w) * p;
shape_0_per_frame29=my_y = zoom * cos(w) * p;
shape_0_per_frame30=x = 0.5 + my_x;
shape_0_per_frame31=y = 0.5 + my_y;

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz - (roam_sin.wzy * roam_cos.zxy));
  ret_1 = (ret_1 - (ret_1 * 0.5));
  ret_1 = ((ret_1 * abs(
    (((texture (sampler_blur2, uv).xyz * scale2) + bias2) - 0.5)
  )) * 5.0);
  ret_1 = (ret_1 - 0.01);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2.xy = uv;
  tmpvar_2.z = q2;
  vec2 tmpvar_3;
  vec2 tmpvar_4;
  tmpvar_4 = (uv - 0.5);
  tmpvar_3 = ((tmpvar_4 * vec2(-1.0, 1.0)) + 0.5);
  ret_1 = (((
    (mix (texture (sampler_main, ((tmpvar_4 * 0.98) + 0.5)).xyz, texture (sampler_main, ((
      (tmpvar_3 - 0.5)
     * 0.98) + 0.5)).xyz, vec3(0.5, 0.5, 0.5)) + ((texture (sampler_blur3, uv).xyz * scale3) + bias3))
   + 
    ((texture (sampler_blur3, tmpvar_3).xyz * scale3) + bias3)
  ) + (
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1)) + ((texture (sampler_blur1, tmpvar_3).xyz * scale1) + bias1));
  ret_1 = (ret_1 * texture (sampler_noisevol_hq, (tmpvar_2 - (roam_sin.zyx * roam_cos.ywx))).xyz);
  ret_1 = (ret_1 * 2.0);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }
