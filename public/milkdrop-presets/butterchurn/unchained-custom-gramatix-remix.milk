per_frame_init_1=effect_5 = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q5 = 0;
per_frame_init_6=treb_flop = 0;
per_frame_init_7=effect_3 = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=g2 = 0;
per_frame_init_10=old_bass_flop = 0;
per_frame_init_11=treb_thresh = 0;
per_frame_init_12=pulse_cap = 0;
per_frame_init_13=pulse = 0;
per_frame_init_14=bass_changed = 0;
per_frame_init_15=mid_thresh = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=mid_changed = 0;
per_frame_init_18=entropy = 0;
per_frame_init_19=old_mid_flop = 0;
per_frame_init_20=effect_6 = 0;
per_frame_init_21=chaos = 0;
per_frame_init_22=mid_flop = 0;
per_frame_init_23=q2 = 0;
per_frame_init_24=treb_changed = 0;
per_frame_init_25=q3 = 0;
per_frame_init_26=g1 = 0;
per_frame_init_27=effect_1 = 0;
per_frame_init_28=effect_4 = 0;
per_frame_init_29=effect_2 = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(above(pulse, pulse_cap - 10 * entropy)), 1 + randint(3), entropy));
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=pulse_cap = 100 * entropy;
per_frame_17=pulse = if(0.00001 < abs(above(abs(pulse), pulse_cap)), 0 - pulse_cap, pulse + 0.1 * entropy * bor(bor(bass_changed * bnot(treb_changed), treb_changed * bnot(bass_changed)) * bnot(mid_changed), mid_changed) + (mid + bass + treb) * entropy * 0.03);
per_frame_18=q3 = sin(pulse);
per_frame_19=effect_1 = 1 + 1 * bass_flop * above(q3, 0);
per_frame_20=effect_2 = 1 + 2 * treb_flop * below(q3, 0);
per_frame_21=effect_3 = 1 + 4 * mid_flop * above(q3, 0);
per_frame_22=effect_4 = 1 + 6 * mid_flop * below(q3, 0);
per_frame_23=effect_5 = 1 + 10 * treb_flop * above(q3, 0);
per_frame_24=effect_6 = 1 + 12 * bass_flop * below(q3, 0);
per_frame_25=q1 = effect_1 * effect_2 * effect_3 * effect_4 * effect_5 * effect_6;
per_frame_26=q2 = time * q1 * entropy * chaos * 0.002;
per_frame_27=q4 = sin(0.02 * q2);
per_frame_28=q5 = entropy;
per_frame_29=wave_r = if(0.00001 < abs(treb_flop), abs(0.5 * q4), if(0.00001 < abs(bass_flop), 0.5 + 0.5 * q4, 1));
per_frame_30=wave_g = if(0.00001 < abs(treb_changed), 0, if(0.00001 < abs(mid_changed), 0, 0.49));
per_frame_31=wave_b = if(0.00001 < abs(treb_flop), 0.8 + 0.2 * q4, bass_changed * mid_changed);
per_frame_32=cx = 0.5 + 0.2 * q3;
per_frame_33=cy = 0.5 + 0.2 * q4;
per_frame_34=wave_x = cy;
per_frame_35=wave_y = cx;
per_frame_36=ob_r = if(0.00001 < abs(bass_flop), treb_flop, wave_g);
per_frame_37=ob_b = if(0.00001 < abs(treb_flop), wave_r, wave_b);
per_frame_38=ob_g = if(0.00001 < abs(mid_flop), wave_g, wave_b);
per_frame_39=ob_a = 0.07 + 0.05 * q2;
per_frame_40=ob_size = 0.01 + 0.009 * q4;
per_frame_41=ib_r = ib_r + 0.5 * sin(0.04 * time * entropy);
per_frame_42=ib_b = ib_b + 0.5 * sin(0.03 * time * entropy);
per_frame_43=ib_g = ib_g + 0.5 * sin(0.02 * time * entropy);
per_frame_44=ib_a = 0.07 + 0.05 * q3 * q4;
per_frame_45=ib_size = 0.01 + 0.009 * q3;
per_frame_46=zoom = zoom + 0.19 * q4;
per_pixel_1=g1 = sin(q2 + time * q5 * 0.01) / 2;
per_pixel_2=g2 = sin(q2 + time * q5 * 0.02) / 2;
per_pixel_3=rot = if(0.00001 < abs(above(sin(q2 + time * q5 * 0.025), 0)), g1 * rad, g2 * (1 - rad));
