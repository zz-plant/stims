per_frame_1=dec_med = pow(0.9, 30 / fps);
per_frame_2=dec_slow = pow(0.9, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.2 + avg + peak) * above(time, t0 + 0.1);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 8);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 8);
per_frame_10=q20 = avg;
per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q23 = index;
per_frame_14=q24 = is_beat;
per_frame_15=q26 = bass + mid + treb;
per_frame_16=ava = ava * dec_slow + q26 * (1 - dec_slow);
per_frame_17=k1 = is_beat * equal(mod(index, 4), 0);
per_frame_18=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_19=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_20=rott = 3.1416 * p2 / 4;
per_frame_21=q1 = cos(rott);
per_frame_22=q2 = sin(rott);
per_frame_23=q27 = 8 - index;
per_frame_24=q28 = index2 / 6;
per_frame_25=q29 = 0.1 * q27 + 0.1 * time;
per_frame_26=trig = bnot(mod(index, 4)) * q24;
per_frame_27=mov = trig * (randint(100) - 50) + (1 - trig) * mov;
per_frame_28=movez = movez + 0.02 / fps * mov;
per_frame_29=q30 = movez;
per_frame_30=trig = q24 * bnot(index);
per_frame_31=kmov = bnot(trig) * (kmov + 0.1 / fps);
per_frame_32=q31 = 82 * kmov * kmov;
per_frame_33=cont = cont + 0.2 * q1 / fps * below(index, 2);
per_frame_34=q31 = cont;
