shape_1_per_frame4=y0 = y0 * bnot(trig) + trig * (0.2 + randint(100) / 200);
shape_1_per_frame5=x0 = x0 + 0.03 * q1 * (3 + q26) / fps;
shape_1_per_frame6=y0 = y0 + 0.03 * q2 * (3 + q26) / fps;
