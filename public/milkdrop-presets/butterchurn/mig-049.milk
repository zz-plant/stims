per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_1=wave_r = 1;
per_frame_2=wave_g = 0;
per_frame_3=wave_b = 0;
per_frame_4=wave_r = sqrt(wave_r);
per_frame_5=wave_g = sqrt(wave_g);
per_frame_6=wave_b = sqrt(wave_b);
per_frame_7=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_8=cx = cx + 0.21 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_9=cy = cy + 0.21 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_10=dx = dx + 0.003 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_11=dy = dy + 0.003 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_12=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_13=dx = dx + dx_residual;
per_frame_14=dy = dy + dy_residual;
per_frame_15=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_16=dx_residual = 0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual;
per_frame_17=dy_residual = 0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual;
per_frame_18=wave_x = wave_x - 7 * dx_residual;
per_frame_19=wave_y = wave_y - 7 * dy_residual;
per_frame_20=wave_mystery = 0.03 * time;
shape_0_init1=val = 0;
shape_0_per_frame1=ang = 0.5 * sin(time) + 0.5;
shape_0_per_frame2=val = 3;
shape_0_per_frame3=a2 = 0.33 * val;
shape_0_per_frame4=a = 0.33 * val;
shape_0_per_frame5=rad = 0.4 * cos(0.3 * time) + 0.65;
shape_0_per_frame6=x = 0.25 * sin(0.25 * time) + 0.5;
shape_0_per_frame7=y = 0.25 * cos(0.45 * time) + 0.5;
shape_1_init1=val = 0;
shape_1_per_frame1=ang = 0.5 * cos(0.3 * time) + 0.5;
shape_1_per_frame2=val = 3;
shape_1_per_frame3=a2 = 0.33 * val;
shape_1_per_frame4=a = 0.33 * val;
shape_1_per_frame5=rad = 0.4 * sin(0.3 * time) + 0.65;
shape_1_per_frame6=x = 0.25 * cos(0.25 * time) + 0.5;
shape_1_per_frame7=y = 0.25 * sin(0.45 * time) + 0.5;
shape_2_init1=h2 = 0;
shape_2_init2=vr = 0;
shape_2_init3=vg = 0;
shape_2_init4=vb = 0;
shape_2_init5=dist = 0;
shape_2_init6=maat = 0;
shape_2_per_frame1=h2 = h2 + 0.8 * above(treb, 1.32) * 0.9;
shape_2_per_frame2=vr = 0.5 * sin(0.8 * h2) + 0.5;
shape_2_per_frame3=vg = 0.5 * sin(0.5 * h2) + 0.5;
shape_2_per_frame4=vb = 0.5 * sin(0.1 * h2) + 0.5;
shape_2_per_frame5=g = vg;
shape_2_per_frame6=r = vr;
shape_2_per_frame7=b = vb;
shape_2_per_frame8=g2 = g;
shape_2_per_frame9=r2 = r;
shape_2_per_frame10=b2 = b;
shape_2_per_frame11=dist = 0.01 * mod(frame, 100);
shape_2_per_frame12=maat = maat + above(bass_att, 1.5);
shape_2_per_frame13=maat = maat * below(maat, 16);
shape_2_per_frame14=x = if(0.00001 < abs(below(maat, 8)), if(0.00001 < abs(below(maat, 4)), dist, 1 - dist), x);
shape_2_per_frame15=y = if(0.00001 < abs(above(maat, 8)), if(0.00001 < abs(above(maat, 4)), dist, 1 - dist), y);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.03))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 1.333);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
