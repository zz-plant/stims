per_frame_init_24=b_i = 0;
per_frame_init_25=translation_u = 0;
per_frame_1=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_2=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_3=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_frame_4=wave_x = wave_x + 0.2 * sin(0.32 * time);
per_frame_5=wave_y = wave_y + 0.2 * cos(0.32 * time);
per_frame_6=ob_r = wave_r;
per_frame_7=ob_g = wave_g;
per_frame_8=ob_b = wave_b;
per_frame_9=scale = 1;
per_frame_10=angle = 0.2 * time;
per_frame_11=translation_x = 0;
per_frame_12=translation_y = 0.12;
per_frame_13=a_r = cos(angle) * scale;
per_frame_14=a_i = sin(angle) * scale;
per_frame_15=b_r = translation_x;
per_frame_16=b_i = translation_y;
per_frame_17=scale = 1;
per_frame_18=angle = 0.3 * sin(0.1337 * time);
per_frame_19=translation_u = 0;
per_frame_20=translation_v = -0.2;
per_frame_21=q15 = cos(angle) * scale;
per_frame_22=q16 = sin(angle) * scale;
per_frame_23=q17 = translation_u;
per_frame_24=q18 = translation_v;
per_frame_25=c_inv_r = q15 / (q15 * q15 + q16 * q16);
per_frame_26=c_inv_i = q16 / (q15 * q15 + q16 * q16);
per_frame_27=q11 = a_r * c_inv_r - a_i * c_inv_i;
per_frame_28=q12 = a_r * c_inv_i - a_i * c_inv_r;
per_frame_29=bcad_r = b_r * q15 - b_i * q16 - (a_r * q17 - a_i * q18);
per_frame_30=bcad_i = b_r * q16 - b_i * q15 - (a_r * q18 - a_i * q17);
per_frame_31=q13 = bcad_r * c_inv_r - bcad_i * c_inv_i;
per_frame_32=q14 = bcad_r * c_inv_i - bcad_i * c_inv_r;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 0.0095 * (sin(10 * ang) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.1 * cos(rad));
per_pixel_5=rot = rot + 0.08 * abs(0.746 - rad) * sin(2.2 * (0.5 - rad) + 5.7 * sin(0.1 * time));
per_pixel_6=sx = sx + 0.01 * (0.99 - rad) * sin(0.733 * time) * below(sin(time), 0);
per_pixel_7=sy = sy + 0.01 * (0.99 - rad) * cos(0.953 * time) * above(sin(time), 0);
per_pixel_8=zoom = zoom - 0.015 * (1.5 - rad) * below(rad, 1.5);

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec2 moebius_2;
  vec2 d_3;
  vec2 tmpvar_4;
  tmpvar_4.x = q11;
  tmpvar_4.y = q12;
  vec2 tmpvar_5;
  tmpvar_5.x = q17;
  tmpvar_5.y = q18;
  vec2 tmpvar_6;
  tmpvar_6 = (uv - 0.5);
  vec2 tmpvar_7;
  tmpvar_7.x = ((tmpvar_6.x * q15) - (tmpvar_6.y * q16));
  tmpvar_7.y = ((tmpvar_6.x * q16) - (tmpvar_6.y * q15));
  vec2 tmpvar_8;
  tmpvar_8 = (tmpvar_7 + tmpvar_5);
  vec2 tmpvar_9;
  tmpvar_9.x = ((q13 * tmpvar_8.x) + (q14 * tmpvar_8.y));
  tmpvar_9.y = ((q14 * tmpvar_8.x) - (q13 * tmpvar_8.y));
  moebius_2 = (0.5 + ((
    (1.0 - abs(((
      fract((((tmpvar_9 / 
        ((tmpvar_8.x * tmpvar_8.x) + (tmpvar_8.y * tmpvar_8.y))
      ) + tmpvar_4) * 0.5))
     * 2.0) - 1.0)))
   - 0.5) * 0.99));
  d_3 = (texsize.zw * 8.0);
  vec2 tmpvar_10;
  tmpvar_10.x = dot (((
    (texture (sampler_blur1, (moebius_2 + (vec2(1.0, 0.0) * d_3))).xyz * scale1)
   + bias1) - (
    (texture (sampler_blur1, (moebius_2 - (vec2(1.0, 0.0) * d_3))).xyz * scale1)
   + bias1)), vec3(0.32, 0.49, 0.29));
  tmpvar_10.y = dot (((
    (texture (sampler_blur1, (moebius_2 + (vec2(0.0, 1.0) * d_3))).xyz * scale1)
   + bias1) - (
    (texture (sampler_blur1, (moebius_2 - (vec2(0.0, 1.0) * d_3))).xyz * scale1)
   + bias1)), vec3(0.32, 0.49, 0.29));
  uv_1 = (moebius_2 - ((tmpvar_10 * texsize.zw) * 32.0));
  vec4 tmpvar_11;
  tmpvar_11.w = 1.0;
  tmpvar_11.xyz = abs(((
    ((texture (sampler_blur3, (uv_1 + (
      (((texture (sampler_noise_lq, (rand_frame.xy + 
        ((moebius_2 * texsize.xy) * texsize_noise_lq.zw)
      )) * 2.0) - 1.0).xy * texsize.zw)
     * 5.0))).xyz * scale3) + bias3)
   * 2.0) - texture (sampler_main, uv_1).xyz));
  ret = tmpvar_11.xyz;
 }
