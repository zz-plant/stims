[preset00]
fRating=0.000000
fGammaAdj=1.998000
fVideoEchoZoom=0.999609
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
nWaveMode=1.000000
fWaveAlpha=5.900000
fWaveScale=0.408000
fWaveSmoothing=0.900000
fWarpScale=2.853000
fRot=-0.010000
fWarp=0.000000
fWaveR=0.900000
fWaveG=0.450000
fWaveB=0.000000
fMotionVectorsR=0.400000
fMotionVectorsG=0.700000
fMotionVectorsB=0.700000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=mv_x_range = 0;
per_frame_init_5=mv_x_speed = 0;
per_frame_init_6=yaccel = 0;
per_frame_init_7=xamptarg = 0;
per_frame_init_8=xamp = 0;
per_frame_init_9=xspeed = 0;
per_frame_init_10=ypos = 0;
per_frame_init_11=xaccel = 0;
per_frame_init_12=att = 0;
per_frame_init_13=mv_y_range = 0;
per_frame_init_14=mv_y_amount = 0;
per_frame_init_15=vol = 0;
per_frame_init_16=mv_y_speed = 0;
per_frame_init_17=yamp = 0;
per_frame_init_18=xdir = 0;
per_frame_init_19=mv_x_amount = 0;
per_frame_init_20=yspeed = 0;
per_frame_1=wave_r = wave_r + 0.1 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.05 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=decay = decay - 0.01 * equal(mod(frame, 50), 0);
per_frame_4=vol = (bass + mid + att) / 6;
per_frame_5=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_6=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_7=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_8=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_9=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_10=xpos = xpos + 0.001 * xspeed;
per_frame_11=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_12=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_13=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_14=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_15=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_16=ypos = ypos + 0.001 * yspeed;
per_frame_17=mv_x_speed = 16;
per_frame_18=mv_y_speed = 12;
per_frame_19=mv_x_range = 0.01;
per_frame_20=mv_y_range = 0.01;
per_frame_21=mv_x_amount = 1.25;
per_frame_22=mv_y_amount = 1.25;
per_frame_23=mv_x = mv_x_amount + mv_x_range + mv_x_range * sin(mv_x_speed * ypos + (sin(0.964 * time) - 0.5 * cos(0.256 * time)));
per_frame_24=mv_y = mv_y_amount + mv_y_range + mv_y_range * sin(mv_y_speed * xpos - (cos(1.345 * time) - 0.5 * cos(0.331 * time)));
per_frame_25=mv_b = mv_b - 0.3 * sin(5.211 * time);
per_frame_26=mv_r = mv_r + 0.25 * cos(1.91 * time);
per_frame_27=mv_g = mv_g + 0.25 * cos(1.861 * time);
per_frame_28=mv_l = 100 + 100 * min(0.5 * bass + 0.5 * bass_att, 2);
per_pixel_1=zoom = 0.9615 + 0.1 * rad;
