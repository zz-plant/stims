per_frame_init_1=dx1 = 0;
per_frame_init_2=q3 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_init_5=q2 = 0;
per_frame_init_6=vol = 0;
per_frame_init_7=q4 = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.91 * (bass_thresh - 1.3) + 1.3);
per_frame_2=q2 = bass_thresh;
per_frame_3=vol = 0.25 * (bass + mid + treb);
per_frame_4=vol = vol * vol;
per_frame_5=q3 = vol;
per_frame_6=q4 = min(0.5 * vol, 1);
per_frame_7=dy = -0.005;
per_frame_8=warp = 0.0215 + 0.006 * mid;
per_frame_9=sx = 1.003;
per_pixel_1=dx1 = 0.132 * cos(y * q3 * 30);
per_pixel_2=dx = if(0.00001 < abs(above(y, 0.8)), if(0.00001 < abs(below(y, 0.83)), if(0.00001 < abs(above(x, 0.05)), if(0.00001 < abs(below(x, 0.93)), dx1 * (1 - rad + 0.1) * 1.5, 0), 0), 0), 0);
per_pixel_3=q1 = dx;
per_pixel_4=sx = 1 + 0.0075 * y * (bass - 0.25 * treb);
shape_1_init1=q4 = 0;
shape_1_per_frame1=r = r + 0.3 * (0.6 * sin(2.4 * time) + 0.4 * sin(0.34 * time));
shape_1_per_frame2=b = b + 0.3 * (0.6 * sin(1.65 * time) + 0.4 * sin(0.976 * time));
shape_1_per_frame3=g = g + 0.3 * (0.6 * sin(2.05 * time) + 0.4 * sin(0.577 * time));
shape_1_per_frame4=r = q4;
shape_1_per_frame5=b = 1 - r;
shape_1_per_frame6=g = 1 - r;
shape_1_per_frame7=r2 = r;
shape_1_per_frame8=b2 = b;
shape_1_per_frame9=g2 = g;
shape_1_per_frame10=x = (0.5 + instance) / num_inst;

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = uv.x;
  vec2 tmpvar_2;
  tmpvar_2 = fract(uv);
  tmpvar_1.y = (uv.y - pow (pow (
    (((texture (sampler_blur1, tmpvar_2).xyz * scale1) + bias1) - 0.05)
  , 
    (texture (sampler_main, tmpvar_2).xyz - 0.9)
  ).x, 0.007));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (texture (sampler_main, fract(fract(
    fract(tmpvar_1)
  ))).xyz + 0.001);
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv2_1;
  vec3 ret_2;
  uv2_1 = (uv + (vec2(1.0, 0.0) * texsize.zw));
  float tmpvar_3;
  tmpvar_3 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(-1.0, 0.0) * texsize.zw));
  float tmpvar_4;
  tmpvar_4 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(0.0, 1.0) * texsize.zw));
  float tmpvar_5;
  tmpvar_5 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(0.0, -1.0) * texsize.zw));
  vec3 tmpvar_6;
  tmpvar_6.z = 0.14;
  tmpvar_6.x = (tmpvar_3 - tmpvar_4);
  tmpvar_6.y = (tmpvar_5 - ((
    (texture (sampler_main, uv2_1).xyz + (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4))
   + 
    (((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2) * 0.15)
  ) + (
    ((texture (sampler_blur3, uv2_1).xyz * scale3) + bias3)
   * 0.1)).x);
  ret_2 = (0.5 + (0.5 * normalize(tmpvar_6)));
  vec2 x_7;
  x_7 = (ret_2.xy - 0.5);
  ret_2 = (ret_2 * clamp ((
    sqrt(dot (x_7, x_7))
   * 5.0), 0.0, 1.0));
  ret_2 = ret_2.xxy;
  ret_2 = (ret_2 + 1.0);
  ret_2 = (ret_2 * mix (ret_2, (ret_2 * 
    (((texture (sampler_blur3, uv).xyz * scale3) + bias3) - ((texture (sampler_blur1, uv).xyz * scale1) + bias1))
  ), pow (hue_shader, ret_2)));
  ret_2 = (ret_2 * hue_shader);
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = ret_2;
  ret = tmpvar_8.xyz;
 }
