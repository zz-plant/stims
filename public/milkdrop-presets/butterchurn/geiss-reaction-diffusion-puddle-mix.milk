[preset00]
fRating=5.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
bWaveThick=1.000000
fWaveAlpha=0.433000
fWaveScale=2.358000
fWaveSmoothing=0.540000
fWaveParam=0.200000
fModWaveAlphaStart=1.030000
fModWaveAlphaEnd=1.610000
fWarpAnimSpeed=1.729000
fWarpScale=2.108000
fZoom=1.009010
fWarp=0.067780
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=new_warp = 0;
per_frame_init_2=decay_rate = 0;
per_frame_init_3=my_zoom = 0;
per_frame_init_4=rg = 0;
per_frame_init_5=q9 = 0;
per_frame_init_6=bass_thresh = 0;
per_frame_init_7=new_cy = 0;
per_frame_init_8=my_rot = 0;
per_frame_init_9=prev_beat = 0;
per_frame_init_10=is_beat = 0;
per_frame_init_11=new_rot = 0;
per_frame_init_12=dx_residual = 0;
per_frame_init_13=my_cx = 0;
per_frame_init_14=beat = 0;
per_frame_init_15=my_warp = 0;
per_frame_init_16=my_cy = 0;
per_frame_init_17=new_cx = 0;
per_frame_init_18=new_zoom = 0;
per_frame_init_19=dy_residual = 0;
per_frame_init_20=q10 = 0;
per_frame_init_21=my_rot = 0;
per_frame_init_22=my_zoom = 1;
per_frame_1=wave_r = 0.85 + 0.25 * sin(0.437 * time + 1);
per_frame_2=wave_g = 0.85 + 0.25 * sin(0.544 * time + 2);
per_frame_3=wave_b = 0.85 + 0.25 * sin(0.751 * time + 3);
per_frame_4=dx = dx + 0.003 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_5=dy = dy + 0.003 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_7=dx = dx + dx_residual;
per_frame_8=dy = dy + dy_residual;
per_frame_9=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_10=dx_residual = 0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual;
per_frame_11=dy_residual = 0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual;
per_frame_12=wave_x = wave_x - 7 * dx_residual;
per_frame_13=wave_y = wave_y - 7 * dy_residual;
per_frame_14=new_rot = rot + 0.013 * (0.6 * sin(17.381 * time) + 0.4 * sin(11.579 * time));
per_frame_15=new_zoom = zoom + 0.01 * (0.6 * sin(20.1934 * time + 3) + 0.4 * sin(16.307 * time + 9));
per_frame_16=new_warp = warp + 0.34 * (0.6 * sin(13.5442 * time) + 0.4 * sin(22.543 * time));
per_frame_17=new_cx = cx + 0.31 * (0.6 * sin(16.374 * time) + 0.4 * sin(26.294 * time));
per_frame_18=new_cy = cy + 0.31 * (0.6 * sin(18.393 * time) + 0.4 * sin(37.223 * time));
per_frame_19=rg = max(0.77 * rg, 0.02 + 0.5 * min(2, 1.3 * max(0, mid_att - 1)));
per_frame_20=q9 = rg;
per_frame_21=beat = max(bass / bass_att, mid / mid_att);
per_frame_22=beat = max(beat, treb / treb_att);
per_frame_23=decay_rate = pow(0.9995, fps);
per_frame_24=beat = max(beat, prev_beat * decay_rate);
per_frame_25=wave_a = 24 * (beat - prev_beat - 0.05);
per_frame_26=is_beat = above(wave_a, 0.5);
per_frame_27=rot = (1 - is_beat) * my_rot + is_beat * new_rot;
per_frame_28=zoom = (1 - is_beat) * my_zoom + is_beat * new_zoom;
per_frame_29=warp = (1 - is_beat) * my_warp + is_beat * new_warp;
per_frame_30=cx = (1 - is_beat) * my_cx + is_beat * new_cx;
per_frame_31=cy = (1 - is_beat) * my_cy + is_beat * new_cy;
per_frame_32=prev_beat = beat;
per_frame_33=my_rot = rot;
per_frame_34=my_zoom = zoom;
per_frame_35=my_warp = warp;
per_frame_36=my_cx = cx;
per_frame_37=my_cy = cy;
per_pixel_1=zoom = zoom + 0.02 * cos(30 * rad);

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_main, uv).xyz;
  vec3 tmpvar_2;
  tmpvar_2 = ((texture (sampler_blur1, uv).xyz * scale1) + bias1);
  ret_1 = (ret_1 + (mix (
    (ret_1 - tmpvar_2)
  , 
    ((((texture (sampler_blur2, uv).xyz * scale2) + bias2) - tmpvar_2) * 2.0)
  , vec3(rad)) * 0.3));
  ret_1 = (ret_1 * 0.9);
  ret_1 = (mix (ret_1, vec3(0.5, 0.5, 0.5), vec3(0.03, 0.03, 0.03)) + (19.52 * (
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0)));
  ret_1 = mix (ret_1, ret_1.zxy, vec3(0.02, 0.02, 0.02));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (pow (texture (sampler_main, uv).xyz, vec3(1.7, 1.7, 1.7)) * 2.3);
  ret = tmpvar_1.xyz;
 }
