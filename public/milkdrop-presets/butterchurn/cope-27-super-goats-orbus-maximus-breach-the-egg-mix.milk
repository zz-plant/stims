per_frame_init_1=bass_thresh = 0;
per_frame_init_2=vol = 0;
per_frame_init_3=q5 = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.91 * (bass_thresh - 1.3) + 1.3);
per_frame_2=vol = 0.1 * (9 * vol + 0.333333 * (bass_att + mid_att + treb_att));
per_frame_3=q5 = vol;
per_frame_4=zoom = zoom - 0.01 * vol;
shape_0_init1=q1 = 0;
