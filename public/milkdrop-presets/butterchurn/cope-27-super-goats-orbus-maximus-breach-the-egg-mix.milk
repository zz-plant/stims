shape_0_per_frame1=q1 = time / 5;
shape_0_per_frame2=q2 = time / 6;
shape_0_per_frame3=rad = 0.005 + bass / 90;
shape_0_per_frame4=m5 = bass_att / 70;
shape_0_per_frame5=b2 = 0.7 * treb - bass / 2;
shape_0_per_frame6=r = instance / num_inst;
shape_0_per_frame7=g = abs(treb_att / 5 - bass);
shape_0_per_frame8=size = 0.3 + bass_att / 300 - 0.1 * (1 - q5);
shape_0_per_frame9=nc = sqrt(num_inst);
shape_0_per_frame10=xs = sin(6.28 * mod(instance, nc) / nc) * sin(3.14 * floor(instance / nc) / nc);
shape_0_per_frame11=ys = cos(6.28 * mod(instance, nc) / nc) * sin(3.14 * floor(instance / nc) / nc);
shape_0_per_frame12=zs = cos(3.14 * floor(instance / nc) / nc);
shape_0_per_frame13=y1 = ys * cos(q1) - zs * sin(q1);
shape_0_per_frame14=z1 = ys * sin(q1) + zs * cos(q1);
shape_0_per_frame15=x1 = z1 * sin(q2) + xs * cos(q2);
shape_0_per_frame16=z2 = z1 * cos(q2) - xs * sin(q2);
shape_0_per_frame17=x2 = x1 * cos(q3) - y1 * sin(q3);
shape_0_per_frame18=y2 = y1 * cos(q3) + x1 * sin(q3);
shape_0_per_frame19=x3 = x2 + q4;
shape_0_per_frame20=y3 = y2;
shape_0_per_frame21=z3 = z2 + m5;
shape_0_per_frame22=x = 0.5 + size * (x3 / (1 + z3 * size));
shape_0_per_frame23=y = 0.5 + size * (y3 / (1 + z3 * size));
shape_0_per_frame24=a = below(z3, 0);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (1.0 - uv);
  ret_1 = (texture (sampler_main, uv).xyz + (texture (sampler_main, (tmpvar_2 * 
    (1.0 - (texture (sampler_fc_main, fract(tmpvar_2)).zy * 0.24))
  )).xyz * 0.9));
  ret_1 = (ret_1 * 0.5);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((texture (sampler_blur1, uv).xyz * scale1) + bias1));
  ret_1 = (ret_1 * 1.49);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
