per_frame_1=counter1 = if(0.00001 < abs(equal(counter2, 1)), if(0.00001 < abs(equal(counter1, 1)), 0, counter1 + 0.2), 1);
per_frame_2=counter2 = if(0.00001 < abs(equal(counter1, 1)), if(0.00001 < abs(equal(counter2, 1)), 0, counter2 + 0.2), 1);
per_frame_3=cdelay1 = if(0.00001 < abs(equal(cdelay2, 1)), 1, if(0.00001 < abs(equal(mod(colorcounter, 2), 1)), if(0.00001 < abs(equal(counter1, 1)), 2, 0), if(0.00001 < abs(equal(counter2, 1)), 2, 0)));
per_frame_4=cdelay2 = if(0.00001 < abs(equal(cdelay1, 2)), 1, 0);
per_frame_5=colorcounter = if(0.00001 < abs(above(colorcounter, 7)), 0, if(0.00001 < abs(equal(cdelay1, 1)), colorcounter + 1, colorcounter));
per_frame_6=ob_r = if(0.00001 < abs(equal(colorcounter, 1)), 1, if(0.00001 < abs(equal(colorcounter, 2)), 1, if(0.00001 < abs(equal(colorcounter, 3)), 1, if(0.00001 < abs(equal(colorcounter, 4)), sin(counter2 + 2.1), if(0.00001 < abs(equal(colorcounter, 5)), 0, if(0.00001 < abs(equal(colorcounter, 6)), 0, sin(counter1)))))));
per_frame_7=ob_g = if(0.00001 < abs(equal(colorcounter, 1)), 0, if(0.00001 < abs(equal(colorcounter, 2)), sin(0.5 * counter2), if(0.00001 < abs(equal(colorcounter, 3)), sin(0.4 * (counter1 + 1.75)), if(0.00001 < abs(equal(colorcounter, 4)), 1, if(0.00001 < abs(equal(colorcounter, 5)), 1, if(0.00001 < abs(equal(colorcounter, 6)), sin(counter2 + 2), 0))))));
per_frame_8=ob_b = if(0.00001 < abs(equal(colorcounter, 1)), sin(counter1 + 2.1), if(0.00001 < abs(equal(colorcounter, 2)), 0, if(0.00001 < abs(equal(colorcounter, 3)), 0, if(0.00001 < abs(equal(colorcounter, 4)), 0, if(0.00001 < abs(equal(colorcounter, 5)), sin(counter1), exec2(equal(colorcounter, 6), 1))))));
per_frame_9=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_10=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_12=vol_thresh = bass_thresh + mid_thresh + treb_thresh;
per_frame_13=wave_r = 0.5 + 0.3 * sin(time) + 0.1 * sin(10 * time);
per_frame_14=wave_g = 0.5 + 0.3 * sin(time / 1.5) + 0.1 * sin(12 * time);
per_frame_15=wave_b = 0.5 + 0.3 * sin(time / 1.75) + 0.1 * sin(14 * time);
per_frame_16=bass_counter = 1 * equal(bass_thresh, 2) + bass_counter;
per_frame_17=treb_counter = 1 * equal(treb_thresh, 2) + treb_counter;
per_frame_18=mid_counter = 1 * equal(mid_thresh, 2) + mid_counter;
per_frame_19=vol_counter = 1 * equal(vol_thresh, 2) + vol_counter;
per_frame_20=bass_cycler = mod(bass_counter, 8);
per_frame_21=treb_cycler = mod(treb_counter, 8);
per_frame_22=mid_cycler = mod(mid_counter, 8);
per_frame_23=vol_cycler = mod(vol_cycler, 8);
per_frame_24=q1 = bass_cycler;
per_frame_25=q2 = treb_cycler;
per_frame_26=q3 = mid_cycler;
per_frame_27=q4 = bass_thresh;
per_frame_28=q5 = mid_thresh;
per_frame_29=q6 = treb_thresh;
per_frame_30=q7 = vol_cycler;
per_frame_31=q8 = vol_thresh;
per_frame_32=wave_mystery = wave_mystery + 0.1 * sin(q8) - 0.1;
per_frame_33=mv_b = bass + bass_att - 2;
per_frame_34=residual = 0.016 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * residual;
per_frame_35=ib_size = 0.01 * bass;
per_pixel_1=rad_cycle = rad * rad * x * 60 * rad * sin(q1);
per_pixel_2=rot = if(0.00001 < abs(above(q2, q8)), 0.06 * sin(rad_cycle - 3 * sin(q3) - x * ang * q3) * equal(rad, x + y) * sin(q6) - 0.3 * sin(q7), 0.02 * sin(q3));
per_pixel_3=zoom = if(0.00001 < abs(above(q2, q8)), 2 * rot * rad + 1 - 0.01 * q1 * rad - (x - 0.3 * sin(q4)) + 0.25 * x * sin(q2), 1.1);
per_pixel_4=zoomexp = 1 - 0.1 * rad;
per_pixel_5=dx = if(0.00001 < abs(above(q2, q8)), equal(x, rad) * sin(q3) / y * sin(q1), 0.009 * sin(q5) * x * rad + d * sin(q2));
per_pixel_6=dy = if(0.00001 < abs(above(q2, q8)), equal(y, rad) * sin(q2) / x * sin(q5), 0.009 * sin(q3) * y * rad + r * sin(q1));
per_pixel_7=d = above(y, sin(3 * ang + time));
per_pixel_8=r = above(y, sin(3 * ang + time));
