per_frame_1=ob_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_2=ob_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_3=ob_b = 0.5 + 0.4 * sin(2.332 * time);
per_frame_4=ib_r = 0.5 + 0.25 * sin(1.424 * time);
per_frame_5=ib_g = 0.25 + 0.25 * cos(1.871 * time);
per_frame_6=ib_b = 1 - ob_b;
per_frame_7=volume = 0.15 * (bass + bass_att + treb + treb_att + mid + mid_att);
per_frame_8=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * volume * bass_att, 0.5), xamptarg);
per_frame_9=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_10=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_11=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_12=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_13=xpos = xpos + 0.001 * xspeed;
per_frame_14=dx = 0.05 * xpos;
per_frame_15=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * volume * treb_att, 0.5), yamptarg);
per_frame_16=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_17=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_18=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_19=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_20=ypos = ypos + 0.001 * yspeed;
per_frame_21=dy = 0.05 * ypos;
per_frame_22=wave_a = 0;
per_frame_23=q8 = oldq8 + 0.0003 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_24=oldq8 = q8;
per_frame_25=q7 = 0.003 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_26=rot = 0.4 + 1.5 * sin(0.273 * time) + 0.4 * sin(0.379 * time + 3);
per_pixel_1=zoom = log(sqrt(2) - rad) - 0.24;
