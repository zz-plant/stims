per_frame_21=wave_g = 0.3 * treb;
per_frame_22=wave_b = 0.3 * mid;
per_pixel_1=zoom = if(0.00001 < abs(above(x, q1 - q3)), if(0.00001 < abs(below(x, q1 + q3)), if(0.00001 < abs(above(y, q2 - q3)), if(0.00001 < abs(below(y, q2 + q3)), 1, 0.94 + ze), 0.94 + ze), 0.94 + ze), 0.94 + ze);
per_pixel_2=zoomerx = if(0.00001 < abs(above(x, q1)), 0.01, -0.01);
per_pixel_3=zoomery = if(0.00001 < abs(above(y, q2)), 0.01, -0.01);
per_pixel_4=dx = if(0.00001 < abs(above(x, q1 - q3)), if(0.00001 < abs(below(x, q1 + q3)), if(0.00001 < abs(above(y, q2 - q3)), if(0.00001 < abs(below(y, q2 + q3)), zoomerx, 0.7 + dxe), 0.7 + dxe), 0.7 + dxe), 0.7 + dxe);
per_pixel_5=dy = if(0.00001 < abs(above(x, q1 - q3)), if(0.00001 < abs(below(x, q1 + q3)), if(0.00001 < abs(above(y, q2 - q3)), if(0.00001 < abs(below(y, q2 + q3)), zoomery, 0.7 + dye), 0.7 + dye), 0.7 + dye), 0.7 + dye);
per_pixel_6=dxe = 0.2 + 0.2 * sin(0.444 * time);
per_pixel_7=dye = 0.2 + 0.2 * cos(0.222 * time);
per_pixel_8=ze = 0.04 * sin(0.777 * time);
