wave_0_per_point1=smp = sample;
wave_0_per_point2=tm = 0.24 * time;
wave_0_per_point3=xp = 0.2 * sin(tm + smp) + 0.2 * sin(16.3 * smp);
wave_0_per_point4=yp = 0.2 * cos(tm + smp) + 0.2 * sin(tm + 17 * smp) + 0.1 * cos(54 * smp);
wave_0_per_point5=x = xp + 0.5;
wave_0_per_point6=y = yp + 0.5;
wave_0_per_point7=r = 0.3;
wave_0_per_point8=g = 0.4;
wave_0_per_point9=b = 0.5;
wave_0_per_point10=a = 0.3;
wave_0_per_point11=ends = 4 * sin(3.1415 * sample);
wave_0_per_point12=ends = if(0.00001 < abs(above(ends, 1)), 1, ends);
wave_0_per_point13=a = a * ends;
shape_0_per_frame1=rad = rad - mid * mid * 0.1;
shape_0_per_frame2=ang = treb * treb * 0.1;
shape_1_per_frame1=rad = bass * bass * 0.25;
shape_1_per_frame2=a = bass * bass * 0.12;
