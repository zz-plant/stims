    (xlat_mutabledx.x + xlat_mutabledy.x)
   + 0.5) * (
    (texture (sampler_blur3, uv).xyz * scale3)
   + bias3).x) * vec3(0.7, 0.5, 0.0));
  xlat_mutabledx = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  xlat_mutabledy = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_4;
  tmpvar_4.x = xlat_mutabledx.x;
  tmpvar_4.y = xlat_mutabledy.x;
  uv_1 = (uv - (tmpvar_4 * 0.2));
  ret_2 = (((1.0 - 
    (abs((texture (sampler_main, (uv_1 + 
      (vec2(1.0, 0.0) * xlat_mutabled)
    )).xyz - texture (sampler_main, (uv_1 - 
      (vec2(1.0, 0.0) * xlat_mutabled)
    )).xyz)).z * 4.0)
  ) * texture (sampler_main, uv_1).z) * vec3(0.2, 0.5, 0.6));
  vec3 tmpvar_5;
  tmpvar_5 = pow (mix (ret_2, vec3(3.0, 3.0, 3.0), (tmpvar_3 * 0.5)), vec3(0.9, 0.9, 0.9));
  ret_2 = tmpvar_5;
  vec4 tmpvar_6;
