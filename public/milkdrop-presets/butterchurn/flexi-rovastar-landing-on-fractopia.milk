per_frame_1=warp = 0;
per_frame_2=volume = 0.3 * (bass + mid + att);
per_frame_3=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.25 * volume * bass_att, 0.5), xamptarg);
per_frame_4=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_5=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_6=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_7=xpos = xpos + 0.001 * xspeed;
per_frame_8=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.15 * volume * treb_att, 0.5), yamptarg);
per_frame_9=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_10=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_11=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_12=ypos = ypos + 0.001 * yspeed;
per_frame_13=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_14=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_15=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_16=peakbass_att = max(bass_att, peakbass_att);
per_frame_17=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_18=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_19=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_20=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_21=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_22=wave_x = xpos + 0.5;
per_frame_23=wave_y = 1 - (ypos + 0.5);
per_frame_24=wave_mystery = -0.17 + 0.03 * (0.6 * sin(0.637 * time) + 0.4 * sin(0.949 * time));
per_frame_25=mv_r = if(0.00001 < abs(beat), 1, ib_r);
per_frame_26=mv_b = if(0.00001 < abs(beat), wave_b, ib_b);
per_frame_27=q3 = wave_mystery;
per_frame_28=q1 = wave_x;
per_frame_29=q2 = 1 - wave_y;
per_frame_30=q2 = ypos + 0.5;
per_frame_31=warp = 0;
per_frame_32=monitor = wave_y;
per_frame_33=movement = movement + 0.4 * ((bass + bass_att + 0.1 * pow(bass + 0.6 * bass_att + 0.2 * treb_att, 3)) / fps);
per_frame_34=movement = if(0.00001 < abs(above(movement, 10000)), 0, movement);
per_frame_35=rot = sin(movement);
per_frame_36=cx = wave_x;
per_frame_37=cy = y_pos + 0.5;
per_frame_38=q8 = movement;
per_pixel_1=myy = x - q1;
per_pixel_2=myx = y - q2 + 0.1;
per_pixel_3=dx = 6 * sin(0.675 * q8) * myx * myy;
per_pixel_4=dy = 3 * sin(0.675 * q8) * (myx * myx - myy * myy);

[warp_shader]
shader_body { 
  vec2 uv_z_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (1.0 - abs((
    (fract((uv * 0.5)) * 2.0)
   - 1.0)));
  ret_2.x = texture (sampler_fc_main, tmpvar_3).y;
  vec2 tmpvar_4;
  tmpvar_4 = (texsize.zw * 6.0);
  vec2 tmpvar_5;
  vec2 tmpvar_6;
  tmpvar_6 = (uv_orig - 0.5);
  tmpvar_5 = ((tmpvar_6 * 0.996) + 0.5);
  vec2 tmpvar_7;
  tmpvar_7.x = (((texture (sampler_blur1, 
    (tmpvar_5 + (vec2(1.0, 0.0) * tmpvar_4))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_5 - (vec2(1.0, 0.0) * tmpvar_4))
  ).xyz * scale1) + bias1)).z;
  tmpvar_7.y = (((texture (sampler_blur1, 
    (tmpvar_5 + (vec2(0.0, 1.0) * tmpvar_4))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_5 - (vec2(0.0, 1.0) * tmpvar_4))
  ).xyz * scale1) + bias1)).z;
  uv_z_1 = (tmpvar_5 - ((tmpvar_7 * texsize.zw) * 2.0));
  ret_2.z = max (((
    (texture (sampler_fc_main, tmpvar_3).x - 0.5)
   * 3.0) * clamp (
    (1.0 - (sqrt(dot (tmpvar_6, tmpvar_6)) * 3.2))
  , 0.0, 1.0)), texture (sampler_fc_main, uv_z_1).z);
  ret_2.z = (ret_2.z + ((texture (sampler_fc_main, uv_z_1).z - 
    ((texture (sampler_blur1, clamp (uv_z_1, 0.0, 1.0)).xyz * scale1) + bias1)
  .z) * 0.02));
  ret_2.y = (max (texture (sampler_fc_main, mix (uv, uv_orig, vec2(1.0004, 1.0004))).y, texture (sampler_fc_main, uv_orig).z) - 0.008);
  ret_2.z = (ret_2.z * (1.0 + (ret_2.y * 0.024)));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = ret_2;
  ret = tmpvar_8.xyz;
 }

[comp_shader]
float xlat_mutabled;
vec3 xlat_mutabledx;
vec3 xlat_mutabledy;
 shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  xlat_mutabled = (texsize.zw * 3.0).x;
  xlat_mutabledx = ((texture (sampler_main, (uv + 
    (vec2(1.0, 0.0) * xlat_mutabled)
  )).xyz - texture (sampler_main, (uv - 
    (vec2(1.0, 0.0) * xlat_mutabled)
  )).xyz) * 2.0);
  xlat_mutabledy = ((texture (sampler_main, (uv + 
    (vec2(0.0, 1.0) * xlat_mutabled)
  )).xyz - texture (sampler_main, (uv - 
    (vec2(0.0, 1.0) * xlat_mutabled)
  )).xyz) * 2.0);
  vec3 tmpvar_3;
