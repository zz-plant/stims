[warp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.5 + ((uv - 0.5) * 1.02));
  vec4 tmpvar_3;
  tmpvar_3 = texture (sampler_main, uv_1);
  ret_2 = (abs((tmpvar_3.xyz + 
    (dot (texture (sampler_noise_lq, ((
      (uv_orig * texsize.xy)
     * texsize_noise_lq.zw) + rand_frame.xy)).xyz, ((
      (texture (sampler_blur1, uv_1).xyz * scale1)
     + bias1) - (
      (texture (sampler_blur2, uv_1).xyz * scale2)
     + bias2))) * tmpvar_3.x)
  )) * 3.0);
  ret_2 = (ret_2 * 0.4);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_2;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * ((hue_shader * 4.3) - 3.5));
  ret_1 = (ret_1 * 1.8);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
