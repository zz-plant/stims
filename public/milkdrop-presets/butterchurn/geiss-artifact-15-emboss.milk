[preset00]
fRating=0.000000
fGammaAdj=1.998000
fVideoEchoZoom=1.421000
nWaveMode=1.000000
bAdditiveWaves=1.000000
bWaveDots=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
bDarkenCenter=1.000000
fWaveAlpha=0.220000
fWaveScale=3.436000
fWaveSmoothing=0.540000
fWaveParam=-0.400000
fModWaveAlphaStart=0.970000
fModWaveAlphaEnd=1.680000
fWarpAnimSpeed=1.348000
fWarpScale=1.160000
fZoom=1.010350
fWarp=0.089790
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fWaveX=0.600000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=t2 = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q2 = 0;
per_frame_1=wave_r = wave_r + 0.65 * (0.6 * sin(1.437 * time) + 0.4 * sin(0.97 * time));
per_frame_2=wave_g = wave_g + 0.65 * (0.6 * sin(1.344 * time) + 0.4 * sin(0.841 * time));
per_frame_3=wave_b = wave_b + 0.65 * (0.6 * sin(1.251 * time) + 0.4 * sin(1.055 * time));
per_frame_4=rot = rot + 0.01 * (0.6 * sin(0.181 * time) + 0.09 * sin(-0.279 * time));
per_frame_5=zoom = zoom + 0.01 * (0.6 * sin(0.3131 * time + 2) + 0.4 * sin(-0.479 * time + 4));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_7=t2 = 6 * time;
per_frame_8=wave_x = 0.5 + 0.3 * (0.6 * sin(0.374 * t2) + 0.4 * sin(0.294 * t2));
per_frame_9=wave_y = 0.5 + 0.3 * (0.6 * sin(0.393 * t2) + 0.4 * sin(0.223 * t2));
per_frame_10=q1 = cos(1.071 * time + 1);
per_frame_11=q2 = cos(1.27 * time * 0.7 + 2);
per_pixel_1=dx = dx + 2 * (cos(29.37 * y - 1.9 * time) / pixelsx);
per_pixel_2=dy = dy + 2 * (cos(33.21 * x - 1.7 * time) / pixelsy);
per_pixel_3=dx = dx + 1.5 * (cos(77.55 * y - 2.1 * time) / pixelsx);
per_pixel_4=dy = dy + 1.5 * (cos(78.32 * x - 2.4 * time) / pixelsy);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (max (max (
    max (max (max (texture (sampler_fw_main, uv_orig).xyz, texture (sampler_fw_main, mix (uv_orig, uv, vec2(0.2, 0.2))).xyz), texture (sampler_fw_main, mix (uv_orig, uv, vec2(0.4, 0.4))).xyz), texture (sampler_fw_main, mix (uv_orig, uv, vec2(0.6, 0.6))).xyz)
  , texture (sampler_fw_main, 
    mix (uv_orig, uv, vec2(0.8, 0.8))
  ).xyz), texture (sampler_fw_main, uv).xyz) - 0.008);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 N_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (texsize.zw * 4.0);
  N_1.x = (((
    (texture (sampler_blur2, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale2)
   + bias2) - (
    (texture (sampler_blur2, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale2)
   + bias2)).x * 0.7);
  N_1.y = (((
    (texture (sampler_blur2, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale2)
   + bias2) - (
    (texture (sampler_blur2, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale2)
   + bias2)).x * 0.7);
  N_1.x = (N_1.x + ((
    ((texture (sampler_blur1, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
   - 
    ((texture (sampler_blur1, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
  ).x * 0.3));
  N_1.y = (N_1.y + ((
    ((texture (sampler_blur1, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
   - 
    ((texture (sampler_blur1, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
  ).x * 0.3));
  N_1.z = -0.19;
  vec3 tmpvar_4;
  tmpvar_4 = normalize(N_1);
  N_1 = tmpvar_4;
  vec3 tmpvar_5;
  tmpvar_5.z = -0.8;
  tmpvar_5.x = q1;
  tmpvar_5.y = q2;
  vec3 tmpvar_6;
  tmpvar_6.z = 0.0;
  tmpvar_6.xy = ((uv_orig * 2.0) - 1.0);
  vec3 tmpvar_7;
  tmpvar_7 = normalize((tmpvar_5 - tmpvar_6));
  vec3 tmpvar_8;
  tmpvar_8 = normalize((tmpvar_6 - vec3(0.0, 0.0, 1.0)));
  ret_2 = (vec3(clamp (dot (tmpvar_4, tmpvar_7), 0.0, 1.0)) * vec3(1.2, 0.9, 0.6));
  ret_2 = (ret_2 + (pow (
    clamp (dot (normalize((tmpvar_8 + 
      ((2.0 * tmpvar_4) * dot (tmpvar_8, tmpvar_4))
    )), tmpvar_7), 0.0, 1.0)
  , 16.0) * 0.5));
  ret_2 = (ret_2 * 0.7);
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = ret_2;
  ret = tmpvar_9.xyz;
 }
