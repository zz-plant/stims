per_frame_1=q1 = 0.1 * (bass - treb);
per_frame_2=vvb = if(0.00001 < abs(below(vvb, 0)), 0, vvb);
per_frame_3=vvm = if(0.00001 < abs(below(vvm, 0)), 0, vvm);
per_frame_4=vvt = if(0.00001 < abs(below(vvt, 0)), 0, vvt);
per_frame_5=vb = 0.85 * vb + (1 - vb) * pow(bass, 2) * 0.0011;
per_frame_6=vvb = 0.95 * vvb + (1 - vvb) * vb * 0.2;
per_frame_7=wb = 0.85 * wb + (1 - wb) * vb * 0.2;
per_frame_8=vm = 0.85 * vm + (1 - vm) * pow(mid, 2) * 0.01;
per_frame_9=vvm = 0.95 * vvm + (1 - vvm) * vm * 0.2;
per_frame_10=vt = 0.85 * vt + (1 - vt) * pow(treb, 2) * 0.001;
per_frame_11=vvt = 0.95 * vvt + (1 - vvt) * vt * 0.2;
per_frame_12=wt = 0.85 * wt + (1 - wt) * vt * 0.2;
per_frame_13=q1 = 0.5 * (vvb - wb - vvt + wt);
per_frame_14=q2 = vvm;
per_frame_15=q3 = vvt;
per_frame_16=v = 0.2;
per_frame_17=d = 0;
per_frame_18=bb = bb + vvb * v - d;
