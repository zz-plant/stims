per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(equal(pulse, -20)), 1 + bass_flop + treb_flop + mid_flop + randint(2), entropy);
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(0.1 * pulse * entropy) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(0.1 * pulse * entropy) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(0.1 * pulse * entropy) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 60)), -60, pulse + 0.132 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = cos(pulse / 2 + q1);
per_frame_25=q6 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_26=q7 = entropy;
per_frame_27=q8 = sin(q6 * q1 + q7 * q2);
per_frame_28=zoom = zoom + 0.02 * q8;
per_frame_29=wave_mystery = sin(q1 + q5);
per_frame_30=wave_r = wave_r + 0.5 * sin(q1 + 2 * q2 + 2.1 * q4);
per_frame_31=wave_b = wave_b + 0.5 * sin(q2 + 2 * q3 + 2.2 * q4);
per_frame_32=wave_g = wave_g + 0.5 * sin(q3 + 2 * q1 + 2.3 * q4);
per_frame_33=ob_r = if(0.00001 < abs(bass_flop), ob_r + 0.5 * sin(q1 + 1.14 * q3 + q2), wave_b);
per_frame_34=ob_b = if(0.00001 < abs(treb_flop), ob_b + 0.5 * sin(q2 + 1.14 * q1 + q3), wave_g);
per_frame_35=ob_g = if(0.00001 < abs(mid_flop), ob_g + 0.5 * sin(q3 + 1.14 * q2 + q1), wave_r);
per_frame_36=ib_r = if(0.00001 < abs(bass_flop), ob_b, ib_r + 0.5 * cos(q5 + 2.14 * q1));
per_frame_37=ib_b = if(0.00001 < abs(treb_flop), ob_g, ib_b + 0.5 * cos(q5 + 2.14 * q2));
per_frame_38=ib_g = if(0.00001 < abs(mid_flop), ob_r, ib_g + 0.5 * cos(q5 + 2.14 * q3));
per_frame_39=mv_r = mv_r + 0.5 * sin(q4 + 1.14 * q5 * q1);
per_frame_40=mv_b = mv_b + 0.5 * sin(q4 + 1.14 * q5 * q2);
per_frame_41=mv_g = mv_g + 0.5 * sin(q5 + 1.14 * q5 * q3);
per_frame_42=ob_a = 0.25 + 0.25 * sin(q2 + 2.14 * q3);
per_frame_43=ib_a = 0.5 + 0.5 * sin(2.14 * q2 + q3);
per_frame_44=mv_a = mv_a + mv_a * sin(2.14 * q3 + q2);
per_frame_45=ob_size = 0.1 + 0.1 * sin(3 * q3 + q1);
per_frame_46=ib_size = 0.5 * ib_size + 0.25 * ib_size * sin(3 * q1 + q3);
per_frame_47=wave_mode = q6 + above(q4, 0) + above(q5, 0);
per_frame_48=wave_mystery = sin(1.14 * q3 + 1.14 * q1 + q2);
per_frame_49=mv_l = q6 * q7 * q2;
per_frame_50=wave_x = wave_x + 0.1 * q7 * q4;
per_frame_51=wave_y = wave_y + 0.1 * q6 * q5;
per_frame_52=mv_x = q6 * q7;
per_frame_53=mv_y = q6 * q7;
per_frame_54=zoom = zoom + 0.01 * q1;
per_frame_55=echo_alpha = if(0.00001 < abs(above(q2, 0.5)), 0.5, 1);
per_frame_56=echo_orient = 1.5 + q1 + q2;
per_frame_57=echo_zoom = 0.5 + 0.1 * (q1 + q2 + q3);
per_frame_58=monitor = echo_zoom;
per_frame_59=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_60=zoom = max(0.97, min(0.15 + 0.7 * bass_att, 1.75));
per_pixel_1=q2 = above(rad, 0.503);
per_pixel_2=rot = rot + if(0.00001 < abs(q2), 0, 0.5 * sin(0.7243 * time));
per_pixel_3=zoom = zoom + if(0.00001 < abs(q2), 0, rad * sin(0.734 * time) * 0.8);
per_pixel_4=warp = warp + if(0.00001 < abs(above(rad, 0.2166)), sin(ang * rad), 0);
per_pixel_5=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_6=dx_r = 0.025 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_7=dy_r = 0.025 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_8=crack = 1.34 * sin(3.12 * thresh * time) + 0.95 * sin(5 * thresh * time) + 1.73 * cos(1.66 * thresh * time) - 0.5 * sin(0.25 * thresh * time);
per_pixel_9=rip = 1.92 * cos(1.96 * thresh * time) - 0.195 * cos(3.27 * thresh * time) + 0.236 * sin(3.25 * thresh * time) + 1.5 * sin(thresh * time);
per_pixel_10=crackdown = 2 * crack * dx_r * sin(33.75 * time);
per_pixel_11=ripdown = 2 * rip * dy_r * sin(5.75 * time);
per_pixel_12=dx = dx + 25 * if(0.00001 < abs(above(crack, rip)), 2 * dx_r * crackdown, -2 * dx_r * ripdown);
per_pixel_13=dy = dy + 25 * if(0.00001 < abs(above(rip, crack)), 2 * dy_r * crackdown, -2 * dy_r * ripdown);
per_pixel_14=var = tan(time) * treb * treb;
per_pixel_15=zoom = 1 + rad / 50 + var / 50;
