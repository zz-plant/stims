wave_1_per_point1=pphase = 5671 * sample * cos(0.0001 * time);
wave_1_per_point2=pheight = 0.005 * mod(7654 * sample, 100) * sin(0.5 * time);
wave_1_per_point3=xspout = if(0.00001 < abs(below(abs(sin(0.2 * time)), 0.005)), 0.3 + 0.01 * randint(40), xspout);
wave_1_per_point4=yspout = if(0.00001 < abs(below(abs(sin(0.2 * time)), 0.005)), 0.3 + 0.01 * randint(40), yspout);
wave_1_per_point5=px = xspout + cos(time + pphase) * pheight;
wave_1_per_point6=py = yspout + sin(time + pphase) * pheight;
wave_1_per_point7=x = px;
wave_1_per_point8=y = py;
wave_1_per_point9=a = abs(0.3 * sin(0.2 * time) + 0.1 * treb_att);
wave_1_per_point10=r = 2 * treb;
wave_1_per_point11=g = 3 * bass;
wave_1_per_point12=b = 0.5 * sin(0.1876 * time) + 0.495 * (0.5 + 0.5 * sin(208 * y));
