[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=1.000000
nWaveMode=2.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
bDarkenCenter=1.000000
fWaveAlpha=1.000000
fWaveScale=0.500000
fWaveSmoothing=0.000000
fModWaveAlphaStart=1.500000
fModWaveAlphaEnd=1.000000
fWarp=0.000000
fWaveR=0.230000
fWaveG=0.200000
fWaveB=0.200000
fOuterBorderSize=0.005000
fOuterBorderA=0.400000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.300000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsDy=0.330000
nMotionVectorsLoop=5.000000
fMotionVectorsG=0.300000
fMotionVectorsB=0.100000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=sound = 0;
per_frame_init_2=beatfreq = 0;
per_frame_init_3=pulsefreq = 0;
per_frame_init_4=bt = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=lastbeat = 0;
per_frame_init_7=myrot = 0;
per_frame_init_8=pulse = 0;
per_frame_init_9=aty = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=dx_residual = 0;
per_frame_init_12=atx = 0;
per_frame_init_13=le = 0;
per_frame_init_14=btblock = 0;
per_frame_init_15=zone = 0;
per_frame_init_16=minorccl = 0;
per_frame_init_17=beat = 0;
per_frame_init_18=hccp = 0;
per_frame_init_19=ccl = 0;
per_frame_init_20=q2 = 0;
per_frame_init_21=lastpulse = 0;
per_frame_init_22=q3 = 0;
per_frame_init_23=arad = 0;
per_frame_init_24=th = 0;
per_frame_init_25=aang = 0;
per_frame_init_26=dy_residual = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.825 * time) + 0.4 * sin(0.915 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.025 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.81 * time) + 0.4 * sin(0.95 * time));
per_frame_4=wave_x = 0.5 - cos(time + dx_residual) / 3.5;
per_frame_5=wave_y = 0.5 - cos(time + dy_residual) / 2.5;
per_frame_6=cx = cx + 0.225 * (0.6 * sin(0.35 * time) + 0.4 * sin(0.35 * time));
per_frame_7=cy = cy + 0.225 * (0.6 * sin(0.35 * time) + 0.4 * sin(0.35 * time));
per_frame_8=dx = 0.005 + 0.002 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_9=dy = 0.005 + 0.002 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_10=dx_residual = max(bass, bass_att) - 1;
per_frame_11=dy_residual = min(bass, bass_att) - 1;
per_frame_12=dx = if(0.00001 < abs(above(bass_att + bass, 2.8)), 6 * dx, dx);
per_frame_13=le = 1.4 * bass_att + 0.1 * bass + 0.5 * treb;
per_frame_14=pulse = above(le, th);
per_frame_15=pulsefreq = if(0.00001 < abs(equal(pulsefreq, 0)), 2, if(0.00001 < abs(pulse), 0.8 * pulsefreq + 0.2 * (time - lastpulse), pulsefreq));
per_frame_16=lastpulse = if(0.00001 < abs(pulse), time, lastpulse);
per_frame_17=bt = (time - lastbeat) / (0.5 * beatfreq + 0.5 * pulsefreq);
per_frame_18=hccp = 0.03 / (bt + 0.2) + 0.5 * if(0.00001 < abs(band(above(bt, 0.8), below(bt, 1.2))), pow(sin(7.854 * (bt - 1)), 4) - 1, 0);
per_frame_19=beat = band(above(le, th + hccp), btblock);
per_frame_20=btblock = 1 - above(le, th + hccp);
per_frame_21=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_22=beatfreq = if(0.00001 < abs(equal(beatfreq, 0)), 2, if(0.00001 < abs(beat), 0.8 * beatfreq + 0.2 * (time - lastbeat), beatfreq));
per_frame_23=th = if(0.00001 < abs(above(le, th)), le + 114 / (le + 10) - 7.407, th + 0.07 * th / (th - 12) + 0.1 * below(th, 2.7) * (2.7 - th));
per_frame_24=th = if(0.00001 < abs(above(th, 6)), 6, th);
per_frame_25=q3 = 30 / fps;
per_frame_26=ccl = ccl + beat;
per_frame_27=minorccl = minorccl + 0.01 * le;
per_frame_28=q4 = beat;
per_frame_29=wave_r = 0.5 + 0.15 * sin(12 * ccl) + 0.35 * sin(3.62 * minorccl);
per_frame_30=wave_g = 0.5 + 0.15 * sin(14 * ccl) + 0.35 * sin(7.38 * minorccl);
per_frame_31=wave_b = 0.5 + 0.15 * sin(16 * ccl) + 0.35 * sin(5.21 * minorccl);
per_frame_32=q1 = 0.5 + 0.25 * sin(17 * ccl + minorccl);
per_frame_33=cx = if(0.00001 < abs(beat), 0.5 + 0.5 * sin(38 * ccl), q1);
per_frame_34=q2 = 0.5 + 0.25 * sin(17 * ccl + minorccl);
per_frame_35=cy = if(0.00001 < abs(beat), 0.5 + 0.5 * sin(46 * ccl), q2);
per_frame_36=mv_x = 1.25;
per_frame_37=mv_y = 1.25;
per_frame_38=mv_dx = q1 - 0.5;
per_frame_39=mv_dy = -1 * (q2 - 0.5);
per_pixel_1=myrot = 0.03 * sin(0.84 * time) - 0.013 * cos(0.784 * time) + 0.02 * sin(1 - rad);
per_pixel_2=rot = myrot;
per_pixel_3=aang = atan2(y - q2, x - q1) - 1.57;
per_pixel_4=arad = sqrt(sqr(y - q2) + sqr(x - q1));
per_pixel_5=atx = cos(aang) * arad;
per_pixel_6=aty = sin(aang) * arad;
per_pixel_7=sound = if(0.00001 < abs(below(x, 0.5)), 2 * x * mid + (1 - 2 * x) * bass, 2 * (x - 0.5) * treb + (1 - 2 * (x - 0.5)) * mid);
per_pixel_8=sound = sound * q3;
per_pixel_9=zone = below(abs(x - q1), 0.15) * below(abs(y - q2), 0.15);
per_pixel_10=rot = if(0.00001 < abs(zone), bass * bass_att * 0.2 * pow(arad, arad), myrot);
per_pixel_11=dx = if(0.00001 < abs(zone), 0, dx + 0.01 * rad * sound);
