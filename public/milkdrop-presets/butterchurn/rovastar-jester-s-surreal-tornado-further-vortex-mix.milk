[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=3.000000
nWaveMode=7.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
bDarken=1.000000
fWaveAlpha=1.000000
fWaveScale=0.010000
fWaveSmoothing=0.500000
fWaveParam=1.000000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fZoomExponent=0.999996
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveY=0.980000
fOuterBorderSize=0.014500
fOuterBorderA=1.000000
fInnerBorderSize=0.015000
fInnerBorderR=1.000000
fInnerBorderG=0.600000
fInnerBorderB=0.500000
fInnerBorderA=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=2.400000
nMotionVectorsDy=-0.100000
nMotionVectorsLoop=5.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q2 = 0;
per_frame_init_2=thresh = 0;
per_frame_init_3=dx_r = 0;
per_frame_init_4=dy_r = 0;
per_frame_1=warp = 0;
per_frame_2=ib_r = 0.6 + 0.4 * sin(3.894 * time);
per_frame_3=ib_g = 0.43 + 0.13 * sin(1.143 * time);
per_frame_4=ib_b = 0.5 + 0.33 * sin(3.465 * time);
per_frame_5=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_frame_6=dx_r = 0.004 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_frame_7=dy_r = 0.004 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_frame_8=dx = 1.1 * dx_r;
per_frame_9=dy = 1.1 * dy_r;
per_frame_10=q2 = dx + if(0.00001 < abs(above(bass + bass_att, 2.6)), 11 * dx_r, 0);
per_frame_11=mv_l = 10000;
per_frame_12=mv_y = 2;
per_frame_13=mv_dy = -0.1;
per_frame_14=mv_r = 0.7 + 0.148 * (ib_r + ib_b);
per_frame_15=mv_b = 1 - 0.2 * (ib_r + ib_b);
per_frame_16=mv_g = 0.6 + 0.19 * (ib_g + ib_r);
per_frame_17=zoom = zoom - 0.02 * thresh;
per_frame_18=wave_r = ib_r;
per_frame_19=wave_b = ib_b;
per_frame_20=wave_g = ib_g;
per_frame_21=ob_r = 1 - ib_g;
per_frame_22=ob_b = 0.5 * (ib_r + ib_g);
per_pixel_1=rot = q2 * rad * 20;
