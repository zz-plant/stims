[preset00]
fRating=3.000000
fVideoEchoZoom=1.000000
nWaveMode=1.000000
bWaveThick=1.000000
bTexWrap=0.000000
bInvert=1.000000
fWaveScale=0.500000
fWaveSmoothing=0.450000
fWarpAnimSpeed=2.217000
fWarpScale=100.000000
fZoomExponent=100.000000
fZoom=1.010000
fWarp=1.259460
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderR=1.000000
fOuterBorderG=1.000000
fOuterBorderB=1.000000
fOuterBorderA=1.000000
fInnerBorderR=1.000000
fInnerBorderG=1.000000
