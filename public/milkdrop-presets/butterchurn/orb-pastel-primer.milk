[preset00]
fRating=5.000000
fDecay=0.900000
fVideoEchoZoom=1.007000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=1.000000
bTexWrap=0.000000
bBrighten=1.000000
fWaveAlpha=0.001000
fZoom=0.960000
fRot=-18.840240
fWarp=0.000520
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderR=0.900000
fOuterBorderG=0.500000
fOuterBorderA=0.100000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=0.100000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=4.950000
fMotionVectorsR=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_spectrum=1.000000
wavecode_0_thick=1.000000
wavecode_0_additive=1.000000
wavecode_0_r=0.000000
wavecode_0_g=0.000000
wavecode_0_b=0.000000
wavecode_0_a=0.100000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=basstime = 0;
per_frame_init_2=stickybit = 0;
per_frame_init_3=volavg2 = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=sample1 = 0;
per_frame_init_6=difftime = 0;
per_frame_init_7=diff = 0;
per_frame_init_8=edge = 0;
per_frame_init_9=volavg = 0;
per_frame_init_10=bit2 = 0;
per_frame_init_11=vol = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=q3 = 0;
per_frame_init_14=basssum = 0;
per_frame_init_15=sample2 = 0;
per_frame_1=basstime = basstime + 0.06 * bass;
per_frame_2=q1 = basstime;
per_frame_3=basstime = if(0.00001 < abs(below(basstime, 1000)), 1000, basstime);
per_frame_4=vol = pow(bass + mid + treb, 2);
per_frame_5=basssum = vol;
per_frame_6=stickybit = mod(time, 2);
per_frame_7=volavg = volavg + vol * equal(stickybit, 1);
per_frame_8=sample1 = sample1 + equal(stickybit, 1);
per_frame_9=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_10=sample2 = sample2 + equal(stickybit, 0);
per_frame_11=edge = bnot(equal(bit2, stickybit));
per_frame_12=volavg = volavg - volavg * edge * stickybit;
per_frame_13=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_14=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_15=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_16=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_17=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_18=q3 = diff;
per_frame_19=bit2 = mod(time, 2);
per_frame_20=difftime = difftime + 0.03 * diff;
per_frame_21=q2 = difftime;
per_frame_22=difftime = if(0.00001 < abs(above(difftime, 2000)), 0, difftime);
per_frame_23=monitor = q1;
per_pixel_1=zoom = 0.98;
per_pixel_2=rot = 0;
wave_0_init1=q1 = 0;
wave_0_init2=speed = 0;
wave_0_init3=v = 0;
wave_0_init4=xs = 0;
wave_0_init5=ys = 0;
wave_0_per_point1=q1 = 0;
wave_0_per_point2=speed = 0.3 * bass_att;
wave_0_per_point3=v = 10000 * sample + value2 * bass * 0.1;
wave_0_per_point4=xs = xs + sin(0.1 * v + 0.1 * sin(v)) * speed * atan(1.51 * v);
wave_0_per_point5=ys = ys + sin(0.1 * v + 0.1 * cos(v)) * speed * atan(v);
wave_0_per_point6=x = 0.5 + 0.5 * sin(0.1 * xs) * cos(1 * time + ys);
wave_0_per_point7=y = 0.5 + 0.5 * sin(0.1 * ys) * cos(1.1 * time + xs);
wave_0_per_point8=r = 0.5 + 0.5 * sin(0.22 * q1);
wave_0_per_point9=g = 0.5 + 0.5 * sin(0.307 * q1) + x;
wave_0_per_point10=xs = if(0.00001 < abs(above(xs, 1000)), 0, xs);
wave_0_per_point11=ys = if(0.00001 < abs(above(ys, 1000)), 0, ys);

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec3 color_2;
  vec2 uv2_3;
  uv2_3 = (uv + q3);
  color_2 = ((texture (sampler_noise_lq, uv2_3) - 0.5).xyz + (texture (sampler_noise_mq, uv2_3) - 0.5).xyz);
  color_2 = (color_2 + (texture (sampler_noise_hq, uv2_3) - 0.5).xyz);
  uv_1 = (uv + (color_2 * 0.01).xy);
  uv_1.y = (uv_1.y + (abs(
    (color_2 * 0.01)
  ) + (bass_att * 0.01)).x);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, ((uv_1 * 0.95) + (
    ((texture (sampler_blur1, ((
      (uv_1 - 0.5)
     * 0.9) + 0.5)).xyz * scale1) + bias1)
   * 0.1).xy)).xyz - 0.01);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 2.0);
  ret = tmpvar_1.xyz;
 }
