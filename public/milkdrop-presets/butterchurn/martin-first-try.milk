bModWaveAlphaByVolume=1.000000
bDarken=1.000000
fWaveAlpha=0.330640
fWaveScale=0.897961
fWaveSmoothing=0.108000
fWaveParam=0.100000
fModWaveAlphaStart=0.720000
fModWaveAlphaEnd=1.280000
fWarpAnimSpeed=0.010000
fWarpScale=0.010000
fZoom=0.098609
fDX=1.000000
