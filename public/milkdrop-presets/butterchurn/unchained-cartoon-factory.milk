per_frame_init_1=ib_ = 0;
per_frame_init_2=bass_residual = 0;
per_frame_init_3=old_treb_flop = 0;
per_frame_init_4=bass_flop = 0;
per_frame_init_5=q6 = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=treb_flop = 0;
per_frame_init_9=bass_thresh = 0;
per_frame_init_10=old_bass_flop = 0;
per_frame_init_11=treb_thresh = 0;
per_frame_init_12=pulse = 0;
per_frame_init_13=bass_changed = 0;
per_frame_init_14=mid_thresh = 0;
per_frame_init_15=echo_orientation = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=mid_changed = 0;
per_frame_init_18=entropy = 0;
per_frame_init_19=old_mid_flop = 0;
per_frame_init_20=mid_residual = 0;
per_frame_init_21=treb_residual = 0;
per_frame_init_22=chaos = 0;
per_frame_init_23=mid_flop = 0;
per_frame_init_24=q2 = 0;
per_frame_init_25=treb_changed = 0;
per_frame_init_26=q3 = 0;
per_frame_init_27=q7 = 0;
per_frame_init_28=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(equal(pulse, -20)), 1 + bass_flop + treb_flop + mid_flop + randint(2), entropy);
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(pulse) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(pulse) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(pulse) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.032 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = cos(pulse / 2 + q1);
per_frame_25=q6 = sin(3.14 * q1 + 3.14 * q2 + 3.14 * q3);
per_frame_26=q7 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_27=q8 = entropy;
per_frame_28=wave_r = 0.5 + 0.5 * sin(q1 + abs(2.14 * q4));
per_frame_29=wave_b = 0.5 + 0.5 * sin(q2 + abs(2.14 * q5));
per_frame_30=wave_g = 0.5 + 0.5 * sin(q3 + abs(2.14 * q6));
per_frame_31=ob_r = ob_r + ob_r * sin(q1 + 2.14 * q2);
per_frame_32=ob_b = ob_b + ob_b * sin(q2 + 2.14 * q3);
per_frame_33=ob_g = ob_g + ob_g * sin(q3 + 2.14 * q1);
per_frame_34=ib_r = ib_r + ib_r * cos(q5 + 2.14 * q1);
per_frame_35=ib_b = ib_b + ib_ * cos(q5 + 2.14 * q2);
per_frame_36=ib_g = ib_g + ib_g * cos(q5 + 2.14 * q3);
per_frame_37=ob_a = 0.25 + 0.25 * sin(q2 + 2.14 * q3);
per_frame_38=ib_a = 0.25 + 0.25 * sin(2.14 * q2 + q3);
per_frame_39=ob_size = 0.1 + 0.1 * sin(3 * q3 + q1);
per_frame_40=ib_size = 0.15 + 0.05 * sin(3 * q1 + q3);
per_frame_41=mv_r = mv_r + 0.5 * sin(q4 + 6 * q5 * q1);
per_frame_42=mv_b = mv_b + 0.5 * sin(q4 + 6 * q5 * q2);
per_frame_43=mv_g = mv_g + 0.5 * sin(q5 + 6 * q5 * q3);
per_frame_44=mv_a = mv_a + mv_a * sin(q2 + q3 + 1.14 * q5);
per_frame_45=mv_l = 0.1 * q8;
per_frame_46=mv_x = q8 * q7;
per_frame_47=mv_y = q8 * q7;
per_frame_48=wave_mystery = wave_mystery + 0.25 * sin(time * q4);
per_frame_49=echo_zoom = 1 + 0.2 * q1 + 0.2 * q5 + 0.3 * q4;
per_frame_50=echo_orientation = mod(q7, 3);
per_pixel_1=dx = sin(3.14 * pow(x, 2) * q3);
per_pixel_2=dy = sin(3.14 * pow(y, 2) * q2);
per_pixel_3=rot = sin(3.14 * rad * q1);
