per_frame_init_23=sample2 = 0;
per_frame_init_24=state = 0;
per_frame_1=decay_r = 0.65 + 0.2 * abs(cos(1.56 * difftime + rarr));
per_frame_2=decay_g = 0.5 + 0.2 * abs(cos(1.36 * difftime + rarr));
per_frame_3=decay_b = 0.5 + 0.2 * abs(cos(1.2 * difftime + rarr));
per_frame_4=basstime = basstime + 0.03 * bass;
per_frame_5=basstime2 = basstime + 0.03 * bass;
per_frame_6=q1 = basstime2;
per_frame_7=basstime = if(0.00001 < abs(below(basstime, 1000)), 1000, basstime);
per_frame_8=basstime = basstime + 0.03 * bass_att;
per_frame_9=vol = pow(bass + mid + treb, 2);
per_frame_10=basssum = vol;
per_frame_11=stickybit = mod(time, 2);
per_frame_12=volavg = volavg + vol * equal(stickybit, 1);
per_frame_13=sample1 = sample1 + equal(stickybit, 1);
per_frame_14=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_15=sample2 = sample2 + equal(stickybit, 0);
per_frame_16=edge = bnot(equal(bit2, stickybit));
per_frame_17=volavg = volavg - volavg * edge * stickybit;
per_frame_18=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_19=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_20=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_21=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_22=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_23=q3 = diff;
per_frame_24=bit2 = mod(time, 2);
per_frame_25=difftime = difftime + 0.03 * diff;
per_frame_26=q2 = difftime;
per_pixel_1=saw_r = saw_r + 0.0001 * bass;
per_pixel_2=saw_r = if(0.00001 < abs(above(saw_r, 1)), 0, saw_r);
per_pixel_3=saw_g = saw_g + 0.00012 * bass;
per_pixel_4=saw_g = if(0.00001 < abs(above(saw_g, 1)), 0, saw_g);
per_pixel_5=saw_b = saw_b + 0.00011 * bass;
per_pixel_6=saw_b = if(0.00001 < abs(above(saw_b, 1)), 0, saw_b);
per_pixel_7=decay_r = 2 - y * saw_r;
per_pixel_8=decay_g = 2 - y * saw_g;
per_pixel_9=decay_b = 2 - y * saw_b;
per_pixel_10=rot = 0;
per_pixel_11=zoom = 1.02;
wave_0_init1=q1 = 0;
wave_0_init2=speed = 0;
wave_0_init3=v = 0;
wave_0_init4=xs = 0;
wave_0_init5=ys = 0;
wave_0_per_point1=q1 = 0;
wave_0_per_point2=speed = 0.6 * bass_att;
wave_0_per_point3=v = 1000000 * sample + value2 * bass * 0.1;
wave_0_per_point4=xs = xs + sin(v) * speed * atan(1.51 * v);
wave_0_per_point5=ys = ys + sin(v) * speed * atan(v);
wave_0_per_point6=x = 0.5 + 0.5 * sin(0.1 * xs) * cos(2 * time + xs);
wave_0_per_point7=y = 0.5 + 0.5 * sin(0.1 * ys) * cos(2.1 * time + xs);
wave_0_per_point8=x = 0.6 * x + 0.3;
wave_0_per_point9=y = y;
wave_0_per_point10=y = y * 0.8;
wave_0_per_point11=r = 0.5 * sin(1.22 * time + 2 * x) + 0.6;
wave_0_per_point12=g = 0.4 + 0.4 * sin(1.307 * time + 2 * y);
wave_0_per_point13=b = 0.4 + 0.4 * sin(1.959 * time + x * y);
wave_0_per_point14=xs = if(0.00001 < abs(above(xs, 1000)), 0, xs);
wave_0_per_point15=ys = if(0.00001 < abs(above(ys, 1000)), 0, ys);
wave_1_init1=q1 = 0;
