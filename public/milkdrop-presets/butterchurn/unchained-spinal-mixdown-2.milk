per_frame_init_1=bblock = 0;
per_frame_init_2=band1 = 0;
per_frame_init_3=grid = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=snee = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=tth = 0;
per_frame_init_9=tblock = 0;
per_frame_init_10=bandmove = 0;
per_frame_init_11=bpulse = 0;
per_frame_init_12=pulse = 0;
per_frame_init_13=bases = 0;
per_frame_init_14=mblock = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=snur = 0;
per_frame_init_17=mpulse = 0;
per_frame_init_18=bend = 0;
per_frame_init_19=mod_state = 0;
per_frame_init_20=bth = 0;
per_frame_init_21=mres = 0;
per_frame_init_22=tpulse = 0;
per_frame_init_23=tres = 0;
per_frame_init_24=le = 0;
per_frame_init_25=band2 = 0;
per_frame_init_26=ccl = 0;
per_frame_init_27=q2 = 0;
per_frame_init_28=basemove = 0;
per_frame_init_29=bres = 0;
per_frame_init_30=q3 = 0;
per_frame_init_31=mth = 0;
per_frame_init_32=q7 = 0;
per_frame_init_33=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=le = 1.5 + 2 * sin(bass_att);
per_frame_3=bpulse = band(above(le, bth), above(le - bth, bblock));
per_frame_4=bblock = le - bth;
per_frame_5=bth = if(0.00001 < abs(above(le, bth)), le + 114 / (le + 10) - 7.407, bth + 0.07 * bth / (bth - 12) + 0.1 * below(bth, 2.7) * (2.7 - bth));
per_frame_6=bth = if(0.00001 < abs(above(bth, 6)), 6, bth);
per_frame_7=bres = bpulse * sin(pulse + 0.5 * le) + bnot(bpulse) * bres;
per_frame_8=le = 1.5 + 2 * sin(treb_att);
per_frame_9=tpulse = band(above(le, tth), above(le - tth, tblock));
per_frame_10=tblock = le - tth;
per_frame_11=tth = if(0.00001 < abs(above(le, tth)), le + 114 / (le + 10) - 7.407, tth + 0.07 * tth / (tth - 12) + 0.1 * below(tth, 2.7) * (2.7 - tth));
per_frame_12=tth = if(0.00001 < abs(above(tth, 6)), 6, tth);
per_frame_13=tres = tpulse * sin(pulse + 0.5 * le) + bnot(tpulse) * tres;
per_frame_14=le = 1.5 + 2 * sin(mid_att);
per_frame_15=mpulse = band(above(le, mth), above(le - mth, mblock));
per_frame_16=mblock = le - mth;
per_frame_17=mth = if(0.00001 < abs(above(le, mth)), le + 114 / (le + 10) - 7.407, mth + 0.07 * mth / (mth - 12) + 0.1 * below(mth, 2.7) * (2.7 - mth));
per_frame_18=mth = if(0.00001 < abs(above(mth, 6)), 6, mth);
per_frame_19=mres = mpulse * sin(pulse + 0.5 * le) + bnot(mpulse) * mres;
per_frame_20=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.003 * (bth + mth + tth));
per_frame_21=q1 = bres;
per_frame_22=q2 = tres;
per_frame_23=q3 = mres;
per_frame_24=q4 = sin(pulse);
per_frame_25=mod_state = (above(q1, 0) + above(q2, 0) + above(q3, 0)) * (1 + above(q4, 0));
per_frame_26=ccl = ccl + tpulse + mpulse - bpulse;
per_frame_27=q5 = cos(pulse * (0.5 + 0.1 * mod_state));
per_frame_28=q6 = sin(pulse * (0.5 + pow(0.25, mod_state)));
per_frame_29=q7 = mod_state;
per_frame_30=q8 = ccl;
per_frame_31=ob_r = 0.5 + 0.5 * cos(q1 + q7);
per_frame_32=ob_g = 0.5 + 0.5 * cos(3.14 * q2 + q7);
per_frame_33=ob_b = 0.5 + 0.5 * cos(2 * q3 + sin(0.0816 * time));
per_frame_34=ib_size = 0.025 + 0.02 * q2;
per_frame_35=ob_size = 0.03 + 0.02 * q3 - 0.002 * q7;
per_frame_36=wave_r = 0.5 + 0.5 * sin(q1 * q7 + 2.183 * time);
per_frame_37=wave_g = 0.5 + 0.5 * sin(3 * q2 + 1.211 * time);
per_frame_38=wave_b = 0.5 + 0.5 * sin(q3 + 1.541 * time);
per_frame_39=ob_a = 0.8 + 0.2 * q2;
per_pixel_1=snee = bnot(above(sin(ang) - x, 0.5) * above(q2, 0) + above(y - cos(ang), 0.5) * above(q1, 0));
per_pixel_2=snur = bnot(below(x, 0.5) * above(q3, 0) + below(y, 0.5) * below(q7, 4));
per_pixel_3=grid = sin(sigmoid(sin(6.28 * y * q2), sin(6.28 * x * q6)) * (10 + q7));
per_pixel_4=rot = bnot(above(x, 0.5) + mod(y * q8, q7)) * cos(rad + 3.14 * if(0.00001 < abs(above(grid, 0)), snur, bnot(snur)) * (0.5 + 0.5 * sin(3.14 * rad * q1))) * q4;
per_pixel_5=zoom = zoom + 0.003 * sin(2 * rad + rad * q2) * sign(snee) - 0.003 * cos(2 * rad * q3);
per_pixel_6=rot = if(0.00001 < abs(rot), rot * sign(snur), q6 * sign(-snur));
per_pixel_7=cx = if(0.00001 < abs(below(x, 0.5) * above(y, 0.5)), 0.5 + 0.5 * sin(ang * q1), 0.5);
per_pixel_8=cy = if(0.00001 < abs(below(x, 0.5) * below(y, 0.5)), 0.5 + 0.5 * sin(ang * q3), 0.5);
per_pixel_9=sx = sx + 0.37 * sin(rad) * q1 * grid * (1 - abs(rot));
per_pixel_10=sy = sy + 0.37 * sin(rad) * q2 * grid * (1 - abs(rot));
per_pixel_11=grid = mod(pow(3 * x, 3 - q1), q8) + mod(pow(3 * y, 3 - q3), q8);
per_pixel_12=bend = sin(x * (9.42 - 6.28 * q2) * bnot(mod(q8, 3)) + (9.42 * rad - 6.28 * sin(time * (1.3 + 0.3 * q1))) * bnot(mod(q8, 4)) + y * (9.42 * q4 - 6.28 * q3) * bnot(mod(q8, 5)));
per_pixel_13=zoom = zoom + bend * below(y, 0.5) * below(x, 0.5) * 0.1;
per_pixel_14=sx = sx - if(0.00001 < abs(above(q7, 3)), bnot(grid) * q3 * 0.2, 0.1 * q2 * bnot(mod(q8, 5)));
per_pixel_15=sy = sy - if(0.00001 < abs(below(q7, 3)), bnot(grid) * q2 * 0.2, 0.1 * q3 * bnot(mod(q8, 2)));
per_pixel_16=rot = if(0.00001 < abs(equal(grid, 3)), rot, bnot(mod(grid, q7)) * above(x, 0.5) * above(y, 0.5) * sin(zoom * rad * 3.14));
per_pixel_17=band1 = below(x, 0.1) * above(y, abs(q1 - q3)) * below(y, 0.5 * abs(q1 + q3));
per_pixel_18=band2 = below(x, 0.1) * above(y, abs(q2 - q4)) * below(y, 0.5 * abs(q2 + q4));
per_pixel_19=bases = below(x, 0.04) * if(0.00001 < abs(above(q1, q2)), above(y, abs(q2)) * below(y, abs(q1)), above(y, abs(q1)) * below(y, abs(q2)));
per_pixel_20=bandmove = 0.009 * (abs(q5) * band1 + (1 - abs(q5)) * band2);
per_pixel_21=basemove = 0.02 * bases;
per_pixel_22=dx = 0.0015 * max(2 * bass_att, 1) + if(0.00001 < abs(above(mod(q7, 3), 0)), basemove, bandmove);
