[preset00]
fRating=0.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=2.000000
bWaveDots=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.001000
fWaveScale=0.012000
fWaveSmoothing=0.900000
fWarpScale=3.138000
fZoom=1.053000
fWarp=0.000540
fWaveR=0.500000
fWaveG=0.400000
fWaveB=0.300000
nMotionVectorsX=12.800000
nMotionVectorsY=9.600000
nMotionVectorsLoop=1.000000
fMotionVectorsR=0.410000
fMotionVectorsG=0.700000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_usedots=1.000000
wavecode_0_additive=1.000000
wavecode_0_r=0.000000
wavecode_0_g=0.000000
wavecode_0_b=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_1=wave_r = wave_r + 0.65 * (0.6 * sin(1.437 * time) + 0.4 * sin(0.97 * time));
per_frame_2=wave_g = wave_g + 0.65 * (0.6 * sin(1.344 * time) + 0.4 * sin(0.841 * time));
per_frame_3=wave_b = wave_b + 0.65 * (0.6 * sin(1.251 * time) + 0.4 * sin(1.055 * time));
per_frame_4=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.21 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.21 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=dx = dx + 0.01 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_8=dy = dy + 0.01 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_9=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_10=dx = dx + dx_residual;
per_frame_11=dy = dy + dy_residual;
per_frame_12=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_13=dx_residual = 0.9 * (0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual);
per_frame_14=dy_residual = 0.9 * (0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual);
per_frame_15=wave_x = wave_x - 7 * dx_residual;
per_frame_16=wave_y = wave_y - 7 * dy_residual;
wave_0_init1=advance = 0;
wave_0_init2=t1 = 0;
wave_0_init3=advance2 = 0;
wave_0_init4=t2 = 0;
wave_0_init5=advance = 0;
wave_0_init6=advance2 = 0;
wave_0_per_frame1=advance = advance + bass_att * bass_att * 0.002;
wave_0_per_frame2=advance = if(0.00001 < abs(above(advance, 2)), advance - 2, advance);
wave_0_per_frame3=t1 = advance;
wave_0_per_frame4=advance2 = advance2 + mid_att * mid_att * 0.005;
wave_0_per_frame5=t2 = advance2;
wave_0_per_point1=x = 0.5 + 0.5 * sample * sin(100 * sample + 10 * time) + cos(time) * x * 0.2;
wave_0_per_point2=y = 0.5 + 0.5 * sample * cos(100 * sample + 10 * time) + sin(time) * y * 0.2;
wave_0_per_point3=r = bass;
wave_0_per_point4=b = 0;
wave_0_per_point5=g = 0.5;

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (texture (sampler_main, uv_1).xyz * 4.0);
  ret_2 = (ret_2 - ((
    (texture (sampler_blur1, uv_1).xyz * scale1)
   + bias1) * 4.0));
  ret_2 = -(ret_2);
  ret_2 = ((pow (ret_2, vec3(0.5, 0.5, 0.7)) - 0.1) * 1.1);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
