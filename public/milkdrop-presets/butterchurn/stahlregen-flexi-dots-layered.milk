per_frame_init_1=count = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q2 = 0;
per_frame_init_4=q3 = 0;
per_frame_1=count = if(0.00001 < abs(below(count, 9)), count + 1, 0);
per_frame_2=q1 = 0.5;
per_frame_3=q2 = 0.5;
per_frame_4=q3 = count;
per_frame_5=zoom = 1 + 0.065 * bass_att + 0.05 * bass;
