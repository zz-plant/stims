shape_0_per_frame2=a = trans;
shape_0_per_frame3=a2 = trans;
shape_0_per_frame4=border_a = trans;
shape_0_per_frame5=x = q1 + 0.01 * randint(15) * bass_att * if(0.00001 < abs(equal(randint(2), 1)), 1, -1);
shape_0_per_frame6=y = q2 + 0.01 * randint(15) * bass_att * if(0.00001 < abs(equal(randint(2), 1)), 1, -1);
shape_0_per_frame7=rad = 0.09 + 0.002 * randint(10);
