per_frame_init_1=rd = 0;
per_frame_init_2=q4 = 0;
per_frame_init_3=q5 = 0;
per_frame_init_4=zm = 0;
per_frame_init_5=vol = 0;
per_frame_init_6=yspeed = 0;
per_frame_init_7=musictime = 0;
per_frame_init_8=zoom = 1;
per_frame_init_9=xpos = 0;
per_frame_init_10=ypos = 0;
per_frame_1=decay = 0.9;
per_frame_2=vol = 0.25 * (bass + mid + treb);
per_frame_3=vol = vol * vol;
per_frame_4=ob_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_5=ob_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_6=ob_b = 0.5 + 0.4 * sin(2.332 * time);
per_frame_7=ib_r = 0.5 + 0.25 * sin(1.424 * time);
per_frame_8=ib_g = 0.25 + 0.25 * cos(1.871 * time);
per_frame_9=ib_b = 1 - ob_b;
per_frame_10=monitor = yspeed;
per_frame_11=zoom = 1;
per_frame_12=musictime = musictime + vol * (45 / fps);
per_frame_13=q4 = 0.3 * sin(0.02 * musictime);
per_frame_14=q5 = 0.3 * sin(0.01 * musictime);
per_frame_15=dx = 0.1 * sin(0.1 * musictime);
per_frame_16=dy = 0.1 * cos(0.069 * musictime);
per_pixel_1=rd = sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5)));
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=zm = log(sqrt(2) - rd) - 0.24;
per_pixel_5=zm = max(abs(zm), 0.25) * sign(zm);
per_pixel_6=sx = zm;
per_pixel_7=sy = zm;
