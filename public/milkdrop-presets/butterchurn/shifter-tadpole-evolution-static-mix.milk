per_frame_init_17=mod = 0;
per_frame_init_18=ra = 0;
per_frame_init_19=treb_avg = 0;
per_frame_init_20=vol = 0;
per_frame_init_21=sp = 0;
per_frame_init_22=q2 = 0;
per_frame_init_23=q3 = 0;
per_frame_1=warp = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=vol = 0.333333 * (bass_att + treb_att + mid_att);
per_frame_5=ra = 0.25 * (1 / tic);
per_frame_6=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_7=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_8=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_9=vav = tic * (vav * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_10=tt = tt + tic * treb;
per_frame_11=mt = mt + tic * mid;
per_frame_12=bt = bt + tic * bass;
per_frame_13=vt = vt + tic * vav;
per_frame_14=sp = 0.1 * abs(vav - slide);
per_frame_15=slide = if(0.00001 < abs(above(slide, vav)), slide - tic * sp, slide + tic * sp) + (1 - toc) * vav * 0.2;
per_frame_16=toc = 1;
per_frame_17=q1 = 0.1 * vt;
per_frame_18=q2 = 0.5 + 0.5 * sin(4 * time);
per_frame_19=q3 = 0.05 * vav;
per_frame_20=q4 = vt;
per_pixel_1=ti = -0.6 * time;
per_pixel_2=rot = 0.01 * sin(6.2832 * (rad + ti));
per_pixel_3=mod = 0.4;
per_pixel_4=xsec = above(x, mod) * below(x, 1 - mod);
per_pixel_5=ysec = above(y, mod) * below(y, 1 - mod);
per_pixel_6=zoom = if(0.00001 < abs(xsec + ysec), zoom, 0.75);
per_pixel_7=dx = if(0.00001 < abs(xsec + ysec), dx, 0.5);
per_pixel_8=dy = if(0.00001 < abs(xsec + ysec), dy, 0.5);
per_pixel_9=sx = if(0.00001 < abs(xsec + ysec), 0.9 + q3, 1);
per_pixel_10=mod = (1 - 2 * above(x, 0.5)) * (1 - 2 * above(y, 0.5));
per_pixel_11=rot = if(0.00001 < abs(xsec + ysec), rot, q4 * mod);
wave_0_init1=sp = 0;
wave_0_init2=q1 = 0;
wave_0_init3=val = 0;
wave_0_per_point1=sp = 4.1846112 * (q1 + sample);
wave_0_per_point2=x = 0.5 + 0.1 * sin(sp) * 0.75;
wave_0_per_point3=y = 0.5 + 0.1 * cos(sp);
wave_0_per_point4=val = min(1, 4 * value1);
wave_0_per_point5=a = (1 - val) * below(sample, 0.75);
wave_1_init1=sp = 0;
wave_1_init2=q1 = 0;
wave_1_init3=val = 0;
wave_1_per_point1=sp = 4.1846112 * (q1 + sample + 0.75);
wave_1_per_point2=x = 0.5 + 0.1 * sin(sp) * 0.75;
wave_1_per_point3=y = 0.5 + 0.1 * cos(sp);
wave_1_per_point4=val = min(1, 4 * value2);
wave_1_per_point5=a = (1 - val) * below(sample, 0.75);
wave_2_init1=mod = 0;
wave_2_init2=sec = 0;
wave_2_init3=my = 0;
wave_2_init4=rad = 0;
wave_2_per_point1=x = 0.5 + value1;
wave_2_per_point2=y = 0.5 + value2;
wave_2_per_point3=mod = 0.4;
wave_2_per_point4=sec = above(x, mod) * below(x, 1 - mod) + above(y, mod) * below(y, 1 - mod);
wave_2_per_point5=my = 0.75 * (y - 0.5);
wave_2_per_point6=rad = pow(my * my + (x - 0.5) * (x - 0.5), 0.5);
wave_2_per_point7=rad = below(rad, 0.075);
wave_2_per_point8=a = sec * (1 - rad) * 0.1;
shape_0_init1=ti = 0;
shape_0_init2=ti = 0;
shape_0_init3=ti = 0;
shape_0_init4=ti = 0;
shape_0_per_frame1=ti = 0.8 * time;
shape_0_per_frame2=r = 0.5 + 0.5 * sin(ti);
shape_0_per_frame3=g = 0.5 + 0.5 * sin(ti + 1.0472);
shape_0_per_frame4=b = 0.5 + 0.5 * sin(ti + 2.0944);
shape_0_per_frame5=r2 = r;
shape_0_per_frame6=g2 = g;
shape_0_per_frame7=b2 = b;
shape_1_per_frame1=tex_ang = 0.0062832 * randint(1001);
shape_1_per_frame2=tex_ang = 0.7854 * randint(4);
shape_1_per_frame3=r2 = r;
shape_1_per_frame4=g2 = g;
shape_1_per_frame5=b2 = b;
