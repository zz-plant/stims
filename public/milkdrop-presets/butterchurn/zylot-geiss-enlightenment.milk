[preset00]
fRating=5.000000
bTexWrap=0.000000
fWaveAlpha=0.001000
fWaveScale=0.132666
fWaveParam=-0.380000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=1.000000
shapecode_0_sides=100.000000
shapecode_0_rad=0.164463
shapecode_0_g=1.000000
shapecode_0_b=1.000000
shapecode_0_r2=1.000000
shapecode_0_b2=1.000000
shapecode_0_border_a=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.4 * sin(0.333 * time) + 0.2 * bass_att;
per_frame_3=wave_g = wave_g + 0.4 * sin(0.555 * time) + 0.2 * treb_att;
per_frame_4=wave_b = wave_b + 0.4 * sin(0.444 * time) + 0.2 * mid_att;
per_pixel_1=zoom = 1 + 0.1 * (rad - 0.1);
per_pixel_2=zoom = zoom + 0.005 + 0.005 * sin(10 * ang + time);
shape_0_per_frame1=r2 = 0.5 + 0.4 * sin(time);
shape_0_per_frame2=g2 = 0.5 + 0.4 * sin(1.332244 * time);
shape_0_per_frame3=b2 = 0.5 + 0.4 * sin(65544 * time);
shape_0_per_frame4=r = 0.7 * bass;
shape_0_per_frame5=g = 0.7 * treb;
shape_0_per_frame6=b = 0.7 * mid;
shape_0_per_frame7=rad = rad + 0.05 * bass;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_fc_main, uv);
  ret_1 = (tmpvar_2.xyz + (tmpvar_2.xyz - (
    (texture (sampler_blur2, uv).xyz * scale2)
   + bias2)));
  ret_1 = ((mix (tmpvar_2.xyz, ret_1, vec3(0.07, 0.07, 0.07)) - 0.005) * 0.995);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2.z = 0.0;
  tmpvar_2.xy = texsize.zw;
  vec3 tmpvar_3;
  tmpvar_3 = (tmpvar_2 * 1.3);
  ret_1 = (texture (sampler_main, uv).xyz * 0.75);
  ret_1 = (ret_1 + (vec3(3.0, 2.1, 0.9) * (
    dot (((texture (sampler_blur1, (uv + tmpvar_3.xz)).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29))
   - 
    dot (((texture (sampler_blur1, (uv - tmpvar_3.xz)).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29))
  )));
  ret_1 = (ret_1 + (vec3(0.6, 1.5, 2.1) * (
    dot (((texture (sampler_blur1, (uv + tmpvar_3.zy)).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29))
   - 
    dot (((texture (sampler_blur1, (uv - tmpvar_3.zy)).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29))
  )));
  ret_1 = (ret_1 * 1.5);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }
