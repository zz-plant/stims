[preset00]
fRating=2.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=7.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=100.000000
fWaveScale=0.463937
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.600000
fWaveG=0.600000
fWaveB=0.600000
fWaveY=0.100000
fOuterBorderR=1.000000
fOuterBorderG=1.000000
fOuterBorderB=1.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.015000
fInnerBorderR=1.000000
fInnerBorderG=1.000000
fInnerBorderB=1.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q2 = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=kick = 0;
per_frame_init_4=dx_r = 0;
per_frame_init_5=dy_r = 0;
per_frame_1=wave_mystery = wave_mystery + 0.25 * tan(3 * bass);
per_frame_2=q1 = wave_mystery;
per_frame_3=wave_b = cos(time) + abs(cos(time));
per_frame_4=wave_g = abs(sin(time));
per_frame_5=wave_r = -1 * cos(time) + abs(-1 * cos(time)) + 0.2 * (cos(sin(time)) + (abs(cos(sin(time))) + cos(sin(time))));
per_frame_6=ob_r = if(0.00001 < abs(above(wave_r, 1)), 1, if(0.00001 < abs(above(wave_r, 0)), abs(wave_r), 0));
per_frame_7=ob_g = if(0.00001 < abs(above(wave_g, 1)), 1, if(0.00001 < abs(above(wave_g, 0)), abs(wave_g), 0));
per_frame_8=ob_b = if(0.00001 < abs(above(wave_b, 1)), 1, if(0.00001 < abs(above(wave_b, 0)), abs(wave_b), 0));
per_frame_9=ib_g = wave_g;
per_frame_10=ib_r = sin(time);
per_frame_11=kick = 2 * above(bass_att, kick) + (1 - above(bass_att, kick)) * (0.96 * (kick - 1.3) + 1.3);
per_frame_12=dx_r = 0.018 * equal(kick, 2) * sin(6 * time) + (1 - equal(kick, 2)) * dx_r;
per_frame_13=dy_r = 0.015 * equal(kick, 2) * sin(7 * time) + (1 - equal(kick, 2)) * dy_r;
per_frame_14=dy = dy + 1 * dy_r * sin(0.8 * time);
per_frame_15=dx = dx + 1 * dx_r * sin(time);
per_frame_16=warp = warp + if(0.00001 < abs(below(kick, 0)), 0.5 * treb, 0);
per_frame_17=q2 = kick;
per_pixel_1=rot = rot + 0.3 * (sin(1 - rad) - sin(0.05 * rad)) * q2;
per_pixel_2=cx = if(0.00001 < abs(above(dy, -0.5)), 1 - 2 * rot, rot * q2);
