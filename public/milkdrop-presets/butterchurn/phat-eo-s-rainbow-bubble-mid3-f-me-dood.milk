per_frame_1=wave_a = 0;
per_frame_2=ib_r = 0.5 * sin(time) + 0.5;
per_frame_3=ib_g = 0.5 * sin(time + 2.1) + 0.5;
per_frame_4=ib_b = 0.5 * sin(time + 4.2) + 0.5;
per_frame_5=ob_r = ib_r - 0.5;
per_frame_6=ob_g = ib_g - 0.5;
per_frame_7=ob_b = ib_b - 0.5;
per_frame_8=q1 = ib_r;
per_frame_9=q2 = ib_g;
per_frame_10=q3 = ib_b;
per_frame_11=decay = 0.99;
per_frame_12=musictime = musictime + mid * mid * 0.003 * (75 / fps);
per_frame_13=basstime = basstime + bass * bass * 0.03 * (75 / fps);
per_frame_14=xpos = 0.3 * sin(0.6 * musictime);
per_frame_15=ypos = 0.3 * sin(0.4 * musictime);
per_frame_16=q4 = xpos;
per_frame_17=q5 = ypos;
per_frame_18=q6 = basstime;
per_pixel_1=zoom = 1;
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=nx = 2 * (x - 0.5 - q4);
per_pixel_5=ny = 1.5 * (y - 0.5 + q5);
per_pixel_6=rd = sqrt(sqr(nx) + sqr(ny));
per_pixel_7=ag = atan(ny / nx);
per_pixel_8=zm = 1.1 - rd / 4;
per_pixel_9=shapechange = 5 * sin(0.2 * q6) + 5;
per_pixel_10=star = sin(ag * (2 + shapechange) + q6) * (1 - rad) * 0.5 + 0.5;
per_pixel_11=star = star * star * 3 - 0.4;
per_pixel_12=star = star * treb * treb * 0.5;
per_pixel_13=zm = zm + 0.1 * star;
per_pixel_14=sx = zm;
per_pixel_15=sy = zm;
per_pixel_16=rot = above(rd, 0.7) * (rd - 0.7) * sin(0.3 * time) * 0.6 * -sin(4 * ag);
