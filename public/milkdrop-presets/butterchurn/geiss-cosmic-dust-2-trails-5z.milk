[preset00]
fRating=5.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=6.000000
bAdditiveWaves=1.000000
bWaveDots=1.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=1.003000
fWaveScale=2.911000
fWaveSmoothing=0.900000
fModWaveAlphaStart=1.210000
fModWaveAlphaEnd=1.590000
fWarpScale=3.138000
fZoom=1.063000
fDY=-0.005000
fWarp=0.000540
fWaveR=0.500000
fWaveY=0.350000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q2 = 0;
per_frame_1=wave_r = wave_r + 0.65 * (0.6 * sin(1.437 * time) + 0.4 * sin(0.97 * time));
per_frame_2=wave_g = wave_g + 0.65 * (0.6 * sin(1.344 * time) + 0.4 * sin(0.841 * time));
per_frame_3=wave_b = wave_b + 0.65 * (0.6 * sin(1.251 * time) + 0.4 * sin(1.055 * time));
per_frame_4=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.21 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.21 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=dx = dx + 0.01 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_8=dy = dy + 0.01 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_9=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_10=dx = dx + dx_residual;
per_frame_11=dy = dy + dy_residual;
per_frame_12=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_13=dx_residual = 0.9 * (0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual);
per_frame_14=dy_residual = 0.9 * (0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual);
per_frame_15=wave_x = wave_x - 7 * dx_residual;
per_frame_16=wave_y = wave_y - 7 * dy_residual;
per_frame_17=zoom = zoom + 0.04 * cos(0.513 * time + 2);
per_frame_18=q1 = 0.12 * cos(0.479 * time + 1);
per_frame_19=q2 = 0.12 * cos(0.359 * time + 2);

[warp_shader]
shader_body { 
  vec2 uv_1;
  uv_1 = (uv - 0.5);
  uv_1 = (uv_1 * ((1.0 + 
    (q1 * uv_1.y)
  ) + (q2 * uv_1.x)));
  uv_1 = (uv_1 + 0.5);
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv_1);
  vec2 tmpvar_3;
  tmpvar_3.y = 0.0;
  tmpvar_3.x = (texsize.z * 3.0);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ((mix (
    max (tmpvar_2.xyz, texture (sampler_main, (uv_1 + (vec2(0.0, 13.0) * (
      (tmpvar_2.xy - 0.5)
     * texsize.zw)))).xyz)
  , texture (sampler_main, 
    (uv_orig + tmpvar_3)
  ).xyz, vec3(
    clamp ((0.2 + (0.2 * cos(
      (((uv_orig.x * 7.3) + (12.56 * ang)) + time)
    ))), 0.0, 1.0)
  )) - 0.003) * 0.98);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (abs((texture (sampler_main, uv).xyz - 
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  )) * 6.0);
  ret_1 = (ret_1 * 1.333);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
