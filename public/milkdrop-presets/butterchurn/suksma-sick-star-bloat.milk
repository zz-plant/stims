per_frame_1=wave_r = wave_r - 0.4 * bass;
per_frame_2=wave_b = wave_b - 0.4 * treb;
per_frame_3=wave_g = wave_g - 0.4 * mid;
per_frame_4=mv_l = mv_l + 0.2 * bass;
per_frame_5=mv_r = mv_r + 0.7 * wave_r;
per_frame_6=mv_b = mv_b + 0.7 * wave_b;
per_frame_7=mv_g = mv_g + 0.7 * wave_g;
per_frame_8=rot = rot + 0.8 * bass * min(0.07 * sqr(zoom / treb_att), 0.07 * sqr(zoom / bass_att));
per_pixel_1=zoom = zoom + 0.019 + 0.3 * min((0.55 - rad) * max(bass_att, bass), 0.3 * (0.55 - rad) * sin(bass));
shape_0_init1=q1 = 0;
shape_0_init2=q2 = 0;
shape_0_per_frame1=x = q1 + floor(randint(15)) * bass_att * 0.02;
shape_0_per_frame2=y = q2 + floor(randint(15)) * mid_att * 0.02;
shape_0_per_frame3=rad = 0.076 + 0.004 * floor(randint(11));
shape_0_per_frame4=b = 0.35 + 0.2 * sin(0.73 * time) + 0.001 * floor(randint(100));
shape_0_per_frame5=b2 = 0.35 + 0.2 * sin(0.73 * time) + 0.001 * floor(randint(100));
shape_0_per_frame6=g = 0.55 + 0.125 * sin(0.43 * time) + 0.001 * floor(randint(100));
shape_0_per_frame7=g2 = 0.55 + 0.125 * sin(0.43 * time) + 0.001 * floor(randint(100));
shape_1_init1=q2 = 0;
