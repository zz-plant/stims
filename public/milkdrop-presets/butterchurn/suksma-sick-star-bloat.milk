shape_1_per_frame1=x = q2 + floor(randint(15)) * mid_att * 0.02;
shape_1_per_frame2=y = 1 - q1 + floor(randint(15)) * treb_att * 0.02;
shape_1_per_frame3=rad = 0.076 + 0.004 * floor(randint(11));
shape_1_per_frame4=r = 0.4 + 0.2 * sin(0.53 * time) + 0.001 * floor(randint(100));
shape_1_per_frame5=r2 = 0.4 + 0.2 * sin(0.53 * time) + 0.001 * floor(randint(100));
shape_1_per_frame6=b = 0.55 + 0.12 * sin(0.63 * time) + 0.001 * floor(randint(100));
shape_1_per_frame7=b2 = 0.55 + 0.12 * sin(0.63 * time) + 0.001 * floor(randint(100));

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0) * 3.0));
  vec3 tmpvar_2;
  tmpvar_2 = fract((ret_1 - 0.005));
  ret_1 = tmpvar_2;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = tmpvar_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv).xxx;
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ((pow (
    mix (vec3((((texture (sampler_blur1, uv).xyz * scale1) + bias1).x + ((texture (sampler_blur3, uv).xyz * scale3) + bias3).x)), tmpvar_1, pow (tmpvar_1, vec3(0.5, 0.5, 0.5)))
  , vec3(0.5, 1.2, 8.0)) * 1.25) - 0.25);
  ret = tmpvar_2.xyz;
 }
