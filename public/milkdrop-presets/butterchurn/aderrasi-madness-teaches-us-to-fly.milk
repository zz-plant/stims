[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.890000
fVideoEchoZoom=0.999999
fVideoEchoAlpha=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bBrighten=1.000000
bDarken=1.000000
fWaveAlpha=0.003540
fWaveScale=0.721422
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fShader=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderA=1.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=0.500000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=tg3 = 0;
per_frame_init_2=rg2 = 0;
per_frame_init_3=pfdx_r = 0;
per_frame_init_4=pfthresh = 0;
per_frame_init_5=thresh = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=dy_r = 0;
per_frame_init_8=tg2 = 0;
per_frame_init_9=tg1 = 0;
per_frame_init_10=rg3 = 0;
per_frame_init_11=pfdy_r = 0;
per_frame_init_12=rg1 = 0;
per_frame_init_13=dx_r = 0;
per_frame_init_14=q2 = 0;
per_frame_init_15=q3 = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_6=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_7=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_8=rg1 = abs(sin(time));
per_frame_9=rg2 = 3 * above(rg1, 0.75) + 2 * below(rg1, 0.25) + 1 * above(rg1, 0.25) * below(rg1, 0.5) + 0 * above(rg1, 0.5) * below(rg1, 0.75);
per_frame_10=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_11=q1 = wave_r;
per_frame_12=q2 = wave_g;
per_frame_13=q3 = wave_b;
per_frame_14=ob_r = 0.5 * q2 + 0.5 * q1;
per_frame_15=ob_g = 1 - abs(q2);
per_frame_16=ob_b = 1 - abs(q3);
per_frame_17=dx = dx + 12 * pfdx_r * rg3;
per_frame_18=dy = dy + 12 * pfdy_r * rg3;
per_frame_19=ib_r = 1 - abs(ob_r);
per_frame_20=ib_g = 1 - abs(ob_g);
per_frame_21=ib_b = 1 - abs(ob_b);
per_frame_22=echo_orient = rg3;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 12 * dx_r * above(tg1, 0.5) + 12 * dy_r * below(tg1, 0.5);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_7=zoom = zoom - (0.01 + 0.8 * abs(tg3));
per_pixel_8=rot = rot + max(12 * dx_r * (0.5 - tg3), 5 * tg3);
per_pixel_9=dy = dy + tg3 * (rad - 1.2 * sin(2 * abs(1 - 2 * cos(3 * rad))));
per_pixel_10=dx = dx + tg3 * (rad - 1.2 * cos(2 * abs(1 - 2 * sin(3 * rad))));
