[preset00]
fRating=5.000000
fVideoEchoZoom=1.010000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
nWaveMode=2.000000
fWaveAlpha=7.740000
fWaveScale=0.656000
fWaveSmoothing=0.800000
fWarpScale=1.772000
fZoomExponent=1.960000
fZoom=0.980000
fWarp=0.513000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fMotionVectorsR=0.600000
fMotionVectorsG=0.700000
fMotionVectorsB=0.640000
fMotionVectorsA=0.700000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=mv_x_range = 0;
per_frame_init_5=mv_x_speed = 0;
per_frame_init_6=yaccel = 0;
per_frame_init_7=xamptarg = 0;
per_frame_init_8=xamp = 0;
per_frame_init_9=xspeed = 0;
per_frame_init_10=ypos = 0;
per_frame_init_11=xaccel = 0;
per_frame_init_12=att = 0;
per_frame_init_13=mv_y_range = 0;
per_frame_init_14=mv_y_amount = 0;
per_frame_init_15=vol = 0;
per_frame_init_16=mv_y_speed = 0;
per_frame_init_17=yamp = 0;
per_frame_init_18=xdir = 0;
per_frame_init_19=mv_x_amount = 0;
per_frame_init_20=yspeed = 0;
per_frame_1=wave_x = wave_x + 0.5 * (0.6 * sin(2.121 * time) + 0.4 * sin(1.621 * time));
per_frame_2=wave_y = wave_y + 0.5 * (0.6 * sin(1.742 * time) + 0.4 * sin(2.322 * time));
per_frame_3=wave_r = wave_r + 0.5 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_4=wave_g = wave_g + 0.5 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_5=wave_b = wave_b + 0.5 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_6=zoom = zoom + 0.07 * (0.6 * sin(0.239 * time) + 0.4 * sin(0.296 * time));
per_frame_7=rot = rot + 0.038 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.539 * time));
per_frame_8=cx = cx + 0.03 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.194 * time));
per_frame_9=cy = cy + 0.037 * (0.6 * sin(0.274 * time) + 0.4 * sin(0.394 * time));
per_frame_10=dx = dx + 0.025 * (0.6 * sin(0.334 * time) + 0.4 * sin(0.277 * time));
per_frame_11=dy = dy + 0.025 * (0.6 * sin(0.384 * time) + 0.4 * sin(0.247 * time));
per_frame_12=sx = sx + 0.015 * (0.6 * sin(0.313 * time) + 0.4 * sin(0.383 * time));
per_frame_13=decay = decay - 0.01 * equal(mod(frame, 50), 0);
per_frame_14=vol = (bass + mid + att) / 6;
per_frame_15=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_16=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_17=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_18=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_19=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_20=xpos = xpos + 0.001 * xspeed;
per_frame_21=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_22=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_23=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_24=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_25=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_26=ypos = ypos + 0.001 * yspeed;
per_frame_27=mv_x_speed = 16;
per_frame_28=mv_y_speed = 12;
per_frame_29=mv_x_range = 0.099;
per_frame_30=mv_y_range = 0.499;
per_frame_31=mv_x_amount = 1;
per_frame_32=mv_y_amount = 4;
per_frame_33=mv_x = mv_x_amount + mv_x_range + mv_x_range * sin(mv_x_speed * ypos + (sin(0.964 * time) - 0.5 * cos(0.256 * time)));
per_frame_34=mv_y = mv_y_amount + mv_y_range + mv_y_range * sin(mv_y_speed * xpos - (cos(1.345 * time) - 0.5 * cos(0.331 * time)));
per_frame_35=mv_b = mv_b - 0.3 * sin(3.511 * time);
per_frame_36=mv_r = mv_r + 0.25 * cos(0.433 * time);
per_frame_37=mv_g = mv_g + 0.25 * cos(0.568 * time);
per_frame_38=mv_l = 24 * sin(10 * ypos) + 32 * cos(10 * xpos);
per_pixel_1=rot = rot + 0.25 * rad * sin(0.3986 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.98);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_main, uv).xyz;
  vec4 tmpvar_2;
  tmpvar_2.w = 0.0;
  tmpvar_2.xyz = ret_1;
  ret_1 = ((max (tmpvar_2, texture (sampler_main, 
    (1.0 - uv)
  )).xyz * 1.5) - 0.2);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
