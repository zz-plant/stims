per_frame_init_1=dec_med = 0;
per_frame_init_2=is_beat = 0;
per_frame_init_3=dec_slow = 0;
per_frame_init_4=fr = 0;
per_frame_init_5=avg = 0;
per_frame_init_6=beat = 0;
per_frame_init_7=peak = 0;
per_frame_init_8=q2 = 0;
per_frame_init_9=t0 = 0;
per_frame_1=warp = 0.2 * bass;
per_frame_2=warp = warp + above(bass, 1) * bass * 0.2;
per_frame_3=echo_alpha = 0.9 * above(bass, 1.25);
per_frame_4=dec_med = pow(0.9, 30 / fps);
per_frame_5=dec_slow = pow(0.99, 30 / fps);
per_frame_6=beat = max(max(bass, mid), treb);
per_frame_7=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_8=is_beat = above(beat, 0.5 + avg + peak) * above(time, t0 + 0.2);
per_frame_9=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_10=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_11=fr = if(0.00001 < abs(is_beat), if(0.00001 < abs(above(fr, 0)), -1, 1), fr);
per_frame_12=q2 = q2 + above(bass, 1.3) * sin(time) * 0.02;
per_frame_13=rot = (rot + q2) * fr;
per_frame_14=zoom = zoom + above(bass, 1.3) * bass * 0.03;
per_frame_15=sy = sy + above(treb_att, 1.2) * treb_att * 0.002 * sin(time);
per_frame_16=sx = sx + above(treb_att, 1.2) * treb_att * 0.002 * sin(time);
shape_0_init1=sounds = 0;
shape_0_per_frame1=sounds = 0.3 * (bass + treb + mid);
shape_0_per_frame2=rad = rad * sounds * 0.6;
shape_0_per_frame3=r = r + sin(bass) * g;
shape_0_per_frame4=g = g + sin(mid) * g;
shape_0_per_frame5=x = x + 0.414 * cos(time * bass * 0.5);
shape_0_per_frame6=y = y + 0.414 * sin(time * bass * 0.5);
shape_0_per_frame7=r = bass_att;
shape_0_per_frame8=g = mid;
shape_0_per_frame9=b = treb;
shape_1_init1=sounds = 0;
shape_1_per_frame1=g2 = g2 + 0.09 * sin(1.23 * (treb + mid));
shape_1_per_frame2=g = g + 0.09 * cos(1.37 * (bass + mid));
shape_1_per_frame3=sounds = (bass + mid + treb) / 3;
shape_1_per_frame4=rad = rad * (treb + mid) / 3;
shape_1_per_frame5=x = x + 0.3 * sin(time * bass);
shape_1_per_frame6=y = y + 0.317 * cos(time * bass);
shape_1_per_frame7=r = treb;
shape_1_per_frame8=g = mid;
shape_1_per_frame9=b = bass_att;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_noise_lq, ((
    ((texsize.xy * texsize_noise_lq.zw).x * uv)
   / 2.0) + q23)) + 1.0).xyz;
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur1, uv).xyz * scale1) + bias1) - 0.3);
  vec2 tmpvar_4;
  tmpvar_4.x = (0.3 * tmpvar_3.x);
  tmpvar_4.y = tmpvar_3.y;
  ret_1 = ((-0.4 * (
    ((texture (sampler_blur1, ((uv / 4.0) + (0.4 * tmpvar_4))).xyz * scale1) + bias1)
   - 
    (tmpvar_2 * 0.1)
  )) + (texture (sampler_main, (uv + 
    (tmpvar_3 * 0.01)
  .xy)).xyz + (tmpvar_2 * 0.1)));
  float tmpvar_5;
  tmpvar_5 = (1.0 - ((0.01 * q28) * (q28 * rad)));
  ret_1 = (ret_1 * (0.98 * (tmpvar_5 * tmpvar_5)));
  ret_1 = (ret_1 - 0.04);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_1;
  ret = tmpvar_6.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv1_1;
  vec3 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv).xyz;
  vec2 tmpvar_3;
  tmpvar_3.y = 0.0;
  tmpvar_3.x = texsize.z;
  vec2 tmpvar_4;
  tmpvar_4.x = 0.0;
  tmpvar_4.y = texsize.w;
  vec2 tmpvar_5;
  tmpvar_5.x = (texture (sampler_main, (uv - tmpvar_3)).xyz - texture (sampler_main, (uv + tmpvar_3)).xyz).x;
  tmpvar_5.y = (texture (sampler_main, (uv - tmpvar_4)).xyz - texture (sampler_main, (uv + tmpvar_4)).xyz).x;
  uv1_1 = ((0.3 * cos(
    (((uv - 0.5) * 2.0) + 1.7)
  )) - (2.0 * tmpvar_5));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ((-(tmpvar_2) / 4.0) + ((6.0 * vec3(
    clamp ((0.03 / sqrt(dot (uv1_1, uv1_1))), 0.0, 1.0)
  )) * (-0.08 + tmpvar_2)));
  ret = tmpvar_6.xyz;
 }
