wave_0_init7=q2 = 0;
wave_0_per_point1=flen = reg00;
wave_0_per_point2=n = floor(sample * flen);
wave_0_per_point3=vol = (value1 + value2) * (1 + 0.1 / (sample + 0.03));
wave_0_per_point4=chg = min(max(vol - gmegabuf(floor(n)), -1), 1);
wave_0_per_point5=dec = if(0.00001 < abs(if(0 < chg, 1, 0)), 1 - 0.3 * chg, 1 + 0.2 * chg);
wave_0_per_point6=chg = q1 - q2;
wave_0_per_point7=dec = 0.94 - abs(chg) * if(0.00001 < abs(if(0 < chg, 1, 0)), 0.2, 0.1);
wave_0_per_point8=dec = min(max(dec, 0), 1);
wave_0_per_point9=gmegabuf(floor(n)) = gmegabuf(floor(n)) * dec + vol * (1 - dec);
wave_0_per_point10=dec = q2 / 4;
wave_0_per_point11=dec = max(min(dec, 1), 0.1);
wave_0_per_point12=gmegabuf(floor(n)) = gmegabuf(floor(n)) * dec + gmegabuf(floor(n + if(0.8 > q2, 1, 0))) * (1 - dec);
wave_0_per_point13=gmegabuf(floor(n + 10000)) = 0.2 * gmegabuf(floor(n + 10000)) + 0.8 * vol / 3;
wave_0_per_point14=a = 0;
wave_0_per_point15=x = sample;
wave_0_per_point16=y = 0.2 + 0.23 * gmegabuf(floor(n + 0));
