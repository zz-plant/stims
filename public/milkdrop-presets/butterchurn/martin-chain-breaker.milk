per_frame_init_34=n = 0;
per_frame_init_35=b = n;
per_frame_init_36=while(50000 > b, gmegabuf(floor(n)) = 0; megabuf(floor(n)) = 0; n = n + 1; b = b + 1;);
per_frame_init_37=sw1 = randint(8);
per_frame_init_38=sw2 = randint(8);
per_frame_init_39=sw3 = randint(8);
per_frame_init_40=sw4 = randint(8);
per_frame_1=flen = 512;
per_frame_2=reg00 = flen;
per_frame_3=slen = flen / 2;
per_frame_4=dec_m = pow(0.94, 30 / fps);
per_frame_5=n = 0;
per_frame_6=vol = 0;
per_frame_7=b = vol;
per_frame_8=while(b < slen, vol = vol + pow(gmegabuf(floor(n)), 2) / flen; n = n + 1; b = b + 1;);
per_frame_9=vol = sqrt(vol) / 2;
per_frame_10=vol_ = vol_ * dec_m + (1 - dec_m) * vol;
per_frame_11=lev1 = lev1 * dec_m + (1 - dec_m) * gmegabuf(1);
per_frame_12=lev2 = lev2 * dec_m + (1 - dec_m) * gmegabuf(20);
per_frame_13=lev3 = lev3 * dec_m + (1 - dec_m) * gmegabuf(50);
per_frame_14=lev4 = lev4 * dec_m + (1 - dec_m) * gmegabuf(100);
per_frame_15=sw1 = sw1 + if(0 < lev1 - gmegabuf(1), 1, 0) / fps;
per_frame_16=sw2 = sw2 + if(0 < lev2 - gmegabuf(20), 1, 0) / fps;
per_frame_17=sw3 = sw3 + if(0 < lev3 - gmegabuf(50), 1, 0) / fps;
per_frame_18=sw4 = sw4 + if(0 < lev4 - gmegabuf(100), 1, 0) / fps;
per_frame_19=dif = 16 * (1 + sin(sw3 / 4)) + 2;
per_frame_20=ofs = 8 * sin(sw2 / 3);
per_frame_21=n = 0;
per_frame_22=k1 = 0 * frame;
per_frame_23=b = 0;
per_frame_24=while(b < slen, m1 = mod(n, slen); m2 = mod(n + ofs, slen); k = mod(m1 + dif, slen); i = mod(slen + m2 - dif, slen); in1 = 1.2 * ((gmegabuf(floor(m1)) - gmegabuf(floor(k))) / pow(vol_ + 0.03, 0.8)); in2 = 1.2 * ((gmegabuf(floor(m2)) - gmegabuf(floor(i))) / pow(vol_ + 0.03, 0.8)); dec = if(0.00001 < abs(if(pow(gmegabuf(floor(2000 + n)), 2) + pow(gmegabuf(floor(2000 + flen + n)), 2) > in1 * in1 + in2 * in2, 1, 0)), 0.8, 0.94); dec = pow(dec, 30 / fps); gmegabuf(floor(2000 + n)) = gmegabuf(floor(2000 + n)) * dec + (1 - dec) * in1; gmegabuf(floor(2000 + flen + n)) = gmegabuf(floor(2000 + flen + n)) * dec + (1 - dec) * in2; n = n + 1; b = b + 1;);
per_frame_25=q1 = (bass + treb + mid) / 3;
per_frame_26=q2 = (bass_att + treb_att + mid_att) / 3;
per_frame_27=q3 = vol_;
per_frame_28=q11 = sw1;
per_frame_29=q12 = sw2;
per_frame_30=q13 = sw3;
per_frame_31=q14 = sw4;
