shape_1_per_frame1=n = instance;
shape_1_per_frame2=flen = reg00;
shape_1_per_frame3=slen = reg00 / 2;
shape_1_per_frame4=z0 = 10;
shape_1_per_frame5=y0 = gmegabuf(floor(2000 + n + flen)) / z0;
shape_1_per_frame6=x0 = gmegabuf(floor(2000 + n)) / z0;
shape_1_per_frame7=a0 = gmegabuf(floor(n + 10000));
shape_1_per_frame8=k1 = instance / num_inst - 0.5;
shape_1_per_frame9=x = 0.5 + x0 + sin(8 * k1 * sin(0.07 * q12)) * sin(0.13 * q11) * q3 * 0.7;
shape_1_per_frame10=y = 0.5 + q32 * (y0 + sin(8 * k1 * sin(0.1 * q14)) * sin(0.2 * q13) * q3 * 0.7);
shape_1_per_frame11=arg = q2 / 8;
shape_1_per_frame12=high = exp(-500 * pow(arg + 0.5 - instance / num_inst, 2));
shape_1_per_frame13=high = high + exp(-500 * pow(-arg + 0.5 - instance / num_inst, 2));
shape_1_per_frame14=exc = sqrt(pow(x - 0.5, 2) + pow(y - 0.5, 2));
shape_1_per_frame15=rad0 = above(z0, 0) * min(0.1, a0 / 60) + 0.005;
shape_1_per_frame16=rad0 = rad0 * (1 + 2 * exc) * (1 + high);
shape_1_per_frame17=p1 = 0.5 + sin(q12) / 2;
shape_1_per_frame18=p2 = 0.5 + sin(1.4 * q13) / 2;
shape_1_per_frame19=exc = pow(x - p1, 2) + pow(y - p2, 2);
shape_1_per_frame20=rad = min(rad0 * (1 + 0.004 * q3 / abs(exc)), 1);
shape_1_per_frame21=a = min(8 * a0 + 0.4, 1);
shape_1_per_frame22=k1 = 5 * (instance / num_inst) + high;
shape_1_per_frame23=w = 1 - exp(-treb_att / 2 - 0.5);
shape_1_per_frame24=g = w + (1 - w) * sin(k1);
shape_1_per_frame25=r = w + (1 - w) * sin(k1 - 6.28 / 3);
shape_1_per_frame26=b = w + (1 - w) * sin(k1 - 12.56 / 3);
shape_1_per_frame27=a2 = a / 4;
shape_1_per_frame28=g2 = 0 * g;
shape_1_per_frame29=b2 = 0 * b;
shape_1_per_frame30=r2 = 0 * r;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = ((texture (sampler_main, uv).xyz * clamp (
    (q1 - 0.8)
  , 0.0, 1.0)) * 0.92);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((texture (sampler_blur2, uv).xyz * scale2) + bias2));
  ret_1 = (ret_1 + ((0.8 * 
    (hue_shader - 0.8)
  ) * (1.0 - uv.y)));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
