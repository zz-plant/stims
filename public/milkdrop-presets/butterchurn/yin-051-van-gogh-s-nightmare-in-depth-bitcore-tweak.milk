per_frame_init_1=isrow1 = 0;
per_frame_init_2=diakrot = 0;
per_frame_init_3=q6 = 0;
per_frame_init_4=movex = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=scroll = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=row3dist = 0;
per_frame_init_9=v = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=isrow3 = 0;
per_frame_init_12=row2dist = 0;
per_frame_init_13=diakpos = 0;
per_frame_init_14=q2 = 0;
per_frame_init_15=movey = 0;
per_frame_init_16=q3 = 0;
per_frame_init_17=row2ang = 0;
per_frame_init_18=q7 = 0;
per_frame_init_19=isrow2 = 0;
per_frame_init_20=q8 = 0;
per_frame_init_21=frame = -100;
per_frame_1=wave_g = abs(cos(1.4 * time + 0.89 + sin(2.1 * time + 0.73)));
per_frame_2=wave_b = abs(cos(0.7 * time + 0.64));
per_frame_3=wave_r = abs(sin(1.526 * time + 0.321));
per_frame_4=wave_x = abs(sin(2 * time + 0.368));
per_frame_5=warp = 0;
per_frame_6=diakpos = exec2(below(mod(frame, 500), 200), 1);
per_frame_7=diakrot = if(0.00001 < abs(below(mod(frame, 500), 100)), 0, 1);
per_frame_8=diakrot = if(0.00001 < abs(above(mod(frame, 500), 400)), 0, diakrot);
per_frame_9=q1 = 0.125;
per_frame_10=q6 = diakrot * sin(time / 3 + 1.783 + cos(time + 2.814));
per_frame_11=q8 = sign(sin(2.356 * time + 0.385 + 2 * cos(0.6 * time + 2.9)));
per_frame_12=q7 = 0.375 * (1 + diakpos * sin(cos(2.31 * time + 1.972) + 1.34 * time + 1.69));
per_frame_13=q5 = 0.5 + 0.1 * diakpos * sin(time + cos(3 * time + 0.256));
per_frame_14=q4 = 0.625 + 2 * diakpos * q1 * sin(cos(0.67 * time + 0.711) + 2.1 * time + 1.314);
per_frame_15=q2 = 0.875 - 3 * diakpos * q1 * abs(sin(cos(2 * time + 1.23) + 0.8 * time + 1.72));
per_frame_16=q3 = 0.18 + (mid_att + treb_att + bass_att) / 11;
per_frame_17=monitor = mid + treb + bass;
per_frame_18=v = randint(200);
per_frame_19=sx = if(0.00001 < abs(equal(v, 9)), -1, sx);
per_frame_20=sy = if(0.00001 < abs(equal(v, 8)), -1, sy);
per_frame_21=zoom = if(0.00001 < abs(equal(v, 7)), 0.5, 1);
per_pixel_1=isrow1 = if(0.00001 < abs(below(abs(q6 * (x - 0.5) + (1 - q6) * (y - q7)) / (sqr(q6) + sqr(1 - q6)), q1)), 1, 0);
per_pixel_2=isrow2 = if(0.00001 < abs(below(abs((1 - q6) * (x - q5) + q6 * (y - q4)) / (sqr(q6) + sqr(1 - q6)), q1)), 1, 0);
per_pixel_3=q6 = q6 * 1.5;
per_pixel_4=row3dist = (-q6 * (x - 0.5) + (1 - q6) * (y - q2)) / (sqr(q6) + sqr(1 - q6));
per_pixel_5=isrow3 = if(0.00001 < abs(below(abs(row3dist), q1)), 1, 0);
per_pixel_6=scroll = sign(sin(time / 4 + 2.312));
per_pixel_7=dy = dy + 0.01 * (1 - isrow1) * (1 - isrow2) * (1 - isrow3) * scroll * q3;
per_pixel_8=movex = 0.006 * isrow1 * (sin(38 * (x - 0.5) + 3 * time) + sin(26 * (y - q7) + 1 * time));
per_pixel_9=movey = 0.006 * isrow1 * (sin(23 * (x - 0.5) + 2 * time) + sin(40 * (y - q7) + 6 * time));
per_pixel_10=dx = dx + q3 * movex;
per_pixel_11=dy = dy + q3 * movey;
per_pixel_12=zoom = zoom + 5 * q3 * (movex + movey);
per_pixel_13=row2ang = -atan2(x - q5, y - q4);
per_pixel_14=row2dist = sqrt(sqr(x - q5) + sqr(y - q4));
per_pixel_15=movex = 0.03 * isrow2 * cos(row2ang) * q8;
per_pixel_16=movey = 0.03 * isrow2 * sin(row2ang) * q8;
per_pixel_17=dx = dx + q3 * movex;
per_pixel_18=dy = dy + q3 * movey;
per_pixel_19=zoom = zoom + 0.05 * isrow2 * (1 + 0.2 * q3 * pow(-1 + row2dist, 3));
per_pixel_20=movex = 0.007 * sin(100 * time);
per_pixel_21=dx = dx + isrow3 * q3 * movex;
per_pixel_22=zoom = zoom + 0.1 * isrow3 * (row3dist / q1) * sin(3 * time) * q3;
