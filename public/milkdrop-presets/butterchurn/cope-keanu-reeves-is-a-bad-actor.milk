per_frame_8=q1 = vol;

[warp_shader]
uniform sampler2D sampler_pw_mcode1;
 shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_pc_main, uv);
  vec2 tmpvar_3;
  tmpvar_3.x = -0.3;
  tmpvar_3.y = q10;
  vec4 tmpvar_4;
  tmpvar_4 = texture (sampler_pw_mcode1, (((uv_orig * texsize.xy) * texsize_mcode1.zw) - tmpvar_3));
  ret_1 = ((tmpvar_2.xyz * clamp (
    (tmpvar_4.xyz + 0.9)
  , 0.0, 1.0)) + (dot (
    (tmpvar_4.xyz * tmpvar_2.xyz)
  , vec3(0.32, 0.49, 0.29)) * (
    (1.0 - uv.y)
   + 0.4)));
  ret_1 = (ret_1 * 0.6);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_pc_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
