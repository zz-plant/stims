per_frame_1=wave_r = wave_r + 0.5 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.5 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.5 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=zoom = zoom + 0.013 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 50), 0);
per_frame_7=zoom = zoom + 0.2 * (bass_att - 1);
shape_0_init1=q7 = 0;
shape_0_init2=q8 = 0;
shape_0_per_frame1=x = q7;
shape_0_per_frame2=y = 1 - q8;
shape_0_per_frame3=r = 0.5 + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
shape_0_per_frame4=g = 0.5 + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
shape_0_per_frame5=b = 0.5 + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
shape_0_per_frame6=r2 = 0.5 + 0.4 * (0.6 * sin(0.873 * time) + 0.4 * sin(1.124 * time));
shape_0_per_frame7=g2 = 0.5 + 0.4 * (0.6 * sin(0.947 * time) + 0.4 * sin(0.978 * time));
shape_0_per_frame8=b2 = 0.5 + 0.4 * (0.6 * sin(0.889 * time) + 0.4 * sin(0.868 * time));
shape_1_init1=q7 = 0;
shape_1_init2=q8 = 0;
