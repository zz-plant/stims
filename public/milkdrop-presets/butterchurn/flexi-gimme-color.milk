[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.500000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=3.000000
bWaveThick=1.000000
fWaveAlpha=0.002000
fWaveScale=0.010000
fWaveSmoothing=0.000000
fWaveParam=0.340000
fModWaveAlphaStart=1.000000
fModWaveAlphaEnd=1.000000
fWarpAnimSpeed=0.010000
fWarpScale=100.000000
fZoomExponent=0.199130
fWarp=0.013590
fOuterBorderSize=0.500000
fInnerBorderSize=0.500000
fInnerBorderR=1.000000
fInnerBorderG=1.000000
fInnerBorderB=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsB=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=1.000000
shapecode_0_sides=100.000000
shapecode_0_additive=1.000000
shapecode_0_thickoutline=1.000000
shapecode_0_rad=0.866440
shapecode_0_g=1.000000
shapecode_0_b=1.000000
shapecode_0_g2=0.000000
shapecode_0_border_a=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=d = 0;
per_frame_init_2=xx = 0;
per_frame_init_3=z = 0;
per_frame_init_4=w = 0;
per_frame_init_5=cz = 0;
per_frame_init_6=my = 0;
per_frame_init_7=vx = 0;
per_frame_init_8=vy = 0;
per_frame_init_9=vz = 0;
per_frame_init_10=mx = 0;
per_frame_init_11=yy = 0;
per_pixel_1=vx = 0.5 + cos(0.2 * time);
per_pixel_2=vy = 0.5 + sin(0.2 * time);
per_pixel_3=vz = 0;
per_pixel_4=z = 0 - vz;
per_pixel_5=x = x - vx;
per_pixel_6=y = y - vy;
per_pixel_7=d = 0.1 * time - treb * treb * treb * 0;
per_pixel_8=xx = sin(d) * x + cos(d) * y;
per_pixel_9=yy = cos(d) * x - sin(d) * y;
per_pixel_10=x = xx;
per_pixel_11=y = yy;
per_pixel_12=x = x + mx;
per_pixel_13=y = y + my;
per_pixel_14=z = z + vz;
per_pixel_15=cx = 0;
per_pixel_16=cy = 0;
per_pixel_17=cz = 0.5 + 0 * treb;
per_pixel_18=vx = 0;
per_pixel_19=vy = 0;
per_pixel_20=vz = 0;
per_pixel_21=zoom = 0.33;
per_pixel_22=w = 1 / zoom * (1 + sqrt(sqr(z - cz) + sqr(x - cx) + sqr(y - cy)));
per_pixel_23=dx = -(x - mx) * w;
per_pixel_24=dy = -(y - my) * w;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = vec3((texture (sampler_fc_main, (1.0 - abs(
    ((fract((uv * 0.5)) * 2.0) - 1.0)
  ))).x * 0.5));
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = ((texture (sampler_blur3, uv).xyz * scale3) + bias3).xxx;
  vec3 tmpvar_2;
  tmpvar_2 = mix (mix (mix (ret_1, vec3(1.0, 1.0, 0.6), vec3(
    (((texture (sampler_blur2, uv).xyz * scale2) + bias2).x * 2.0)
  )), vec3(1.0, 0.0, 1.0), vec3((
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  .x * 0.5))), vec3(0.0, 0.0, -0.3), texture (sampler_main, uv).xxx);
  ret_1 = tmpvar_2;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = tmpvar_2;
  ret = tmpvar_3.xyz;
 }
