[warp_shader]
shader_body { 
  vec2 v_1;
  vec3 ret_2;
  v_1 = (normalize((uv - 0.5)) * texsize.zw);
  ret_2 = (0.2 * ((
    ((texture (sampler_main, uv).xyz + texture (sampler_main, (uv - (v_1 * 2.5))).xyz) + texture (sampler_main, (uv - (v_1 * 5.5))).xyz)
   + texture (sampler_main, 
    (uv - (v_1 * 9.0))
  ).xyz) + texture (sampler_main, (uv - 
    (v_1 * 13.0)
  )).xyz));
  ret_2 = ((ret_2 - 0.01) * 0.975);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
vec3 xlat_mutableblur;
vec3 xlat_mutableret1;
 shader_body { 
  vec2 uv_1;
  vec2 uv2_2;
  vec3 ret_3;
  uv_1 = (uv - 0.5);
  uv_1 = (uv_1 * aspect.xy);
  float tmpvar_4;
  tmpvar_4 = (0.02 * q27);
  xlat_mutableblur = ((texture (sampler_blur1, (
    (uv_1 + 0.4)
   + tmpvar_4)).xyz * scale1) + bias1);
  xlat_mutableret1 = max (vec3(0.0, 0.0, 0.0), (texture (sampler_main, (
    (uv_1 + 0.4)
   + tmpvar_4)).xyz + (xlat_mutableblur * 2.0)));
  uv2_2.x = ((uv_1.x * 0.3096228) - (uv_1.y * 0.9508595));
  uv2_2.y = ((uv_1.x * 0.9508595) + (uv_1.y * 0.3096228));
  xlat_mutableblur = ((texture (sampler_blur1, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz * scale1) + bias1);
  xlat_mutableret1 = max (xlat_mutableret1, (texture (sampler_main, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz + (xlat_mutableblur * 2.0)));
  uv2_2.x = ((uv_1.x * -0.8082675) - (uv_1.y * 0.5888155));
  uv2_2.y = ((uv_1.x * 0.5888155) + (uv_1.y * -0.8082675));
  xlat_mutableblur = ((texture (sampler_blur1, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz * scale1) + bias1);
  xlat_mutableret1 = max (xlat_mutableret1, (texture (sampler_main, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz + (xlat_mutableblur * 2.0)));
  uv2_2.x = ((uv_1.x * -0.8101388) - (uv_1.y * -0.5862381));
  uv2_2.y = ((uv_1.x * -0.5862381) + (uv_1.y * -0.8101388));
  xlat_mutableblur = ((texture (sampler_blur1, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz * scale1) + bias1);
  xlat_mutableret1 = max (xlat_mutableret1, (texture (sampler_main, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz + (xlat_mutableblur * 2.0)));
  uv2_2.x = ((uv_1.x * 0.3065926) - (uv_1.y * -0.9518408));
  uv2_2.y = ((uv_1.x * -0.9518408) + (uv_1.y * 0.3065926));
  xlat_mutableblur = ((texture (sampler_blur1, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz * scale1) + bias1);
  xlat_mutableret1 = max (xlat_mutableret1, (texture (sampler_main, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz + (xlat_mutableblur * 2.0)));
  uv2_2.x = ((uv_1.x * 0.9999949) - (uv_1.y * -0.003185092));
  uv2_2.y = ((uv_1.x * -0.003185092) + (uv_1.y * 0.9999949));
  xlat_mutableblur = ((texture (sampler_blur1, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz * scale1) + bias1);
  xlat_mutableret1 = max (xlat_mutableret1, (texture (sampler_main, (
    (uv2_2 + 0.4)
   + tmpvar_4)).xyz + (xlat_mutableblur * 2.0)));
  ret_3 = ((xlat_mutableret1 - 0.0125) * 0.7);
  vec3 tmpvar_5;
  tmpvar_5 = (1.0 - ((ret_3 * 
    (1.0 - ret_3)
  ) * 4.0));
  vec3 tmpvar_6;
  tmpvar_6.xy = (tmpvar_5.xy * vec2(0.5, 0.5));
  tmpvar_6.z = tmpvar_5.z;
  ret_3 = (tmpvar_6 * 0.5);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_3;
  ret = tmpvar_7.xyz;
 }
