per_frame_init_1=myy = 0;
per_frame_init_2=myx = 0;
per_frame_init_3=movement = 0;
per_frame_init_4=q4 = 0;
per_frame_init_5=q4 = 0.249 + 0.005 * randint(100);
per_frame_init_6=q5 = 0.249 + 0.005 * randint(100);
per_frame_init_7=q6 = 0.249 + 0.005 * randint(100);
per_frame_1=wave_a = 0;
per_frame_2=movement = movement + 0.5 * ((bass + bass_att + 0.075 * pow(bass + 0.6 * bass_att + 0.2 * treb_att, 3)) / fps);
per_frame_3=movement = if(0.00001 < abs(above(movement, 10000)), 0, movement);
per_frame_4=ob_b = q4 + 0.25 * sin(3.816 * movement);
per_frame_5=ob_g = q4 + 0.25 * sin(0.744 * movement);
per_frame_6=ob_r = q4 + 0.25 * sin(0.707 * movement);
per_frame_7=wrap = above(bass + bass_att, 3);
per_frame_8=decay = 1;
per_frame_9=rot = 0;
per_frame_10=zoom = 0.98;
per_frame_11=mv_r = 0;
per_frame_12=mv_g = 0;
per_frame_13=mv_b = 0;
per_frame_14=mv_dy = 0.03 * sin(0.34 * movement);
per_frame_15=mv_dx = 0.035 * (sin(0.217 * movement) + cos(0.413 * movement) + sin(0.311 * movement));
per_frame_16=warp = 0;
per_frame_17=dx = 0.01 * sin(5 * movement);
per_frame_18=dy = 0.0005 * (bass + bass_att);
per_pixel_1=myy = y - 0.250025;
per_pixel_2=myx = x - 0.5;
per_pixel_3=dx = dx + 4 * myx * myy;
per_pixel_4=dy = dy + 2 * (myy * myy - myx * myx);
