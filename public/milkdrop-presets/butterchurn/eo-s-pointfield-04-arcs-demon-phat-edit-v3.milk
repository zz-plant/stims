per_frame_4=q2 = time;
per_frame_5=q3 = time;
per_pixel_1=rot = ang / 200 * ang * 0.5 * bass;
per_pixel_2=warp = rad / 6 + treb;
per_pixel_3=cx = bass * rad;
per_pixel_4=cy = treb * rad;
wave_0_init1=s = 0;
wave_0_init2=xp = 0;
wave_0_init3=yp = 0;
wave_0_init4=zp = 0;
wave_0_init5=t1 = 0;
wave_0_init6=x_screen = 0;
wave_0_init7=y_screen = 0;
wave_0_init8=advance = 0;
wave_0_per_frame1=advance = advance + bass_att * bass_att * 0.004;
wave_0_per_frame2=advance = if(0.00001 < abs(above(advance, 2)), advance - 2, advance);
wave_0_per_frame3=t1 = advance;
wave_0_per_point1=s = 6.28 * sample;
wave_0_per_point2=xp = sin(s) + sin(0.34 * s) + sin(7.3 * s) + sin(13.8 * s);
wave_0_per_point3=xp = xp * 0.2;
wave_0_per_point4=yp = cos(s) + sin(0.24 * s) + cos(5.4 * s) + sin(17.7 * s);
wave_0_per_point5=yp = yp * 0.2;
wave_0_per_point6=zp = cos(s) + cos(5.24 * s) + cos(14.4 * s) + cos(2.7 * s);
wave_0_per_point7=zp = zp * 0.25;
wave_0_per_point8=zp = zp + 1 - t1;
wave_0_per_point9=zp = if(0.00001 < abs(below(zp, 0)), zp + 2, zp);
wave_0_per_point10=a = 1 - 0.5 * zp;
wave_0_per_point11=zp = zp * 0.7;
wave_0_per_point12=x_screen = xp / zp + 0.5;
wave_0_per_point13=y_screen = yp / zp + 0.5;
wave_0_per_point14=x = x_screen;
wave_0_per_point15=y = y_screen;
wave_0_per_point16=r = 1;
wave_0_per_point17=g = 0.7;
wave_0_per_point18=b = 0.2;
wave_1_init1=s = 0;
wave_1_init2=xp = 0;
wave_1_init3=yp = 0;
wave_1_init4=zp = 0;
wave_1_init5=t1 = 0;
wave_1_init6=x_screen = 0;
wave_1_init7=y_screen = 0;
wave_1_init8=advance = 0;
wave_1_per_frame1=advance = advance + mid_att * mid_att * 0.003;
wave_1_per_frame2=advance = if(0.00001 < abs(above(advance, 2)), 0, advance);
wave_1_per_frame3=t1 = advance;
wave_1_per_point1=s = 6.28 * sample;
wave_1_per_point2=xp = sin(s) + sin(0.34 * s) + sin(5.3 * s) + sin(13.8 * s);
wave_1_per_point3=xp = xp * 0.2;
wave_1_per_point4=yp = cos(s) + sin(0.24 * s) + cos(7.4 * s) + sin(17.7 * s);
wave_1_per_point5=yp = yp * 0.2;
wave_1_per_point6=zp = cos(s) + cos(5.24 * s) + cos(14.4 * s) + cos(1.7 * s);
wave_1_per_point7=zp = zp * 0.25;
wave_1_per_point8=zp = zp + 1 - t1;
wave_1_per_point9=zp = if(0.00001 < abs(below(zp, 0)), zp + 2, zp);
wave_1_per_point10=a = 1 - 0.5 * zp;
wave_1_per_point11=zp = zp * 0.7;
wave_1_per_point12=x_screen = -xp / zp + 0.5;
wave_1_per_point13=y_screen = -yp / zp + 0.5;
wave_1_per_point14=x = x_screen;
wave_1_per_point15=y = y_screen;
