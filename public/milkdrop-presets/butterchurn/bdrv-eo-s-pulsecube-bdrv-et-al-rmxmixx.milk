per_frame_1=decay = 0.97;
per_frame_2=zoom = 1;
per_frame_3=q1 = 0.5 * sin(3.3 * time) + 0.5;
per_frame_4=vol = 0.2 * (bass + mid + treb);
per_frame_5=vol = vol * vol;
per_frame_6=slow = min(bass * bass, 1);
per_frame_7=mtime = mtime + 0.1 * vol * slow;
per_frame_8=q1 = min(vol, 1);
per_frame_9=q2 = mtime / 3;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom - 0.02 * tan(6 * bass_att * (1 - rad));
per_pixel_5=rot = rot - 0.35 * above(x, 0.45 + 0.75 * sin(5 * time * bass_att)) * below(x, 0.55 + 0.75 * sin(5 * time * bass_att));
per_pixel_6=num = 8;
per_pixel_7=pi = 3.141592654;
per_pixel_8=radi = 0.75 * (y - 0.5);
per_pixel_9=radi = y - 0.5;
per_pixel_10=radi = pow(radi * radi + (x - 0.5) * (x - 0.5), 0.5);
per_pixel_11=an = ang + pi + time;
per_pixel_12=an = an - 2 * pi * floor(an / (2 * pi));
per_pixel_13=mod = 0.1;
per_pixel_14=seg = ang + pi;
per_pixel_15=seg = seg / (2 * pi) * num;
per_pixel_16=seg = floor(seg);
per_pixel_17=seg = seg - equal(seg, num);
per_pixel_18=anga = ang + pi - 2 * pi / num * seg;
per_pixel_19=anga = if(0.00001 < abs(equal(mod(seg, 2), 0)), 2 * pi / num - anga, anga);
per_pixel_20=anga = anga + pi / 4;
per_pixel_21=ox = 0.5 - radi * sin(anga);
per_pixel_22=oy = 0.5 + radi * cos(anga);
per_pixel_23=dx = equal(seg, 3) * (x - ox);
per_pixel_24=dy = equal(seg, 3) * (y - oy);
per_pixel_25=dx = above(seg, 0) * (x - ox);
per_pixel_26=dy = above(seg, 0) * (y - oy);
