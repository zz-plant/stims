[preset00]
fRating=5.000000
fDecay=1.000000
nWaveMode=5.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
fWaveAlpha=0.001000
fWaveScale=4.778000
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=2.853000
fZoomExponent=0.999840
fZoom=0.999680
fWarp=0.000000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_spectrum=1.000000
wavecode_0_smoothing=0.000000
wavecode_0_r=0.000000
wavecode_0_g=0.000000
wavecode_0_b=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=1.000000
shapecode_0_sides=100.000000
shapecode_0_rad=0.364570
shapecode_0_g=1.000000
shapecode_0_b=1.000000
shapecode_0_a=0.100000
shapecode_0_g2=0.000000
shapecode_0_a2=0.100000
shapecode_0_border_a=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.1 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.1 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=mv_r = wave_r;
per_frame_5=mv_b = wave_b;
per_frame_6=mv_g = wave_g;
per_frame_7=q1 = 0.05 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_8=mv_a = if(0.00001 < abs(above(bass - 1.2, 1)), 1, bass - 1.2);
per_pixel_1=zoom = 1.01 + 0.15 * rad * q1;
wave_0_init1=xang = 0;
wave_0_init2=fov = 0;
wave_0_init3=tic = 0;
wave_0_init4=ab = 0;
wave_0_init5=tir = 0;
wave_0_init6=yang = 0;
wave_0_init7=vb = 0;
wave_0_init8=vg = 0;
wave_0_init9=dis = 0;
wave_0_init10=my = 0;
wave_0_init11=oz = 0;
wave_0_init12=ti = 0;
wave_0_init13=mz = 0;
wave_0_init14=vr = 0;
wave_0_init15=oy = 0;
wave_0_init16=ag = 0;
wave_0_init17=mx = 0;
wave_0_init18=vol = 0;
wave_0_init19=ar = 0;
wave_0_init20=sp = 0;
wave_0_init21=zang = 0;
wave_0_init22=ox = 0;
wave_0_per_frame1=tic = min(time - tir, 0.1);
wave_0_per_frame2=tir = time;
wave_0_per_frame3=ti = ti + 0.5 * tic + below(vr + vg + vb, 0.4) * tic * 8;
wave_0_per_frame4=vr = 0.75 + 0.25 * sin(1.132 * ti + 1);
wave_0_per_frame5=vg = 0.75 + 0.25 * sin(1.121 * ti + 1);
wave_0_per_frame6=vb = 0.75 + 0.25 * sin(1.187 * ti + 1);
wave_0_per_frame7=ar = vr;
wave_0_per_frame8=ag = vg;
wave_0_per_frame9=ab = vb;
wave_0_per_point1=sp = 10 * sample;
wave_0_per_point2=ti = time;
wave_0_per_point3=ox = 0.001 * randint(1001) + 0.001 * randint(1001) - 0.001 * randint(1001) - 0.001 * randint(1001);
wave_0_per_point4=oy = 0.001 * randint(1001) + 0.001 * randint(1001) - 0.001 * randint(1001) - 0.001 * randint(1001);
wave_0_per_point5=oz = 0.001 * randint(1001) + 0.001 * randint(1001) - 0.001 * randint(1001) - 0.001 * randint(1001);
wave_0_per_point6=dis = pow(ox * ox + oy * oy + oz * oz, 0.5);
wave_0_per_point7=vol = 2 * (value1 + value2);
wave_0_per_point8=ox = sign(ox) * pow(ox, 4) * vol;
wave_0_per_point9=oy = sign(oy) * pow(oy, 4) * vol;
wave_0_per_point10=oz = sign(oz) * pow(oz, 4) * vol;
wave_0_per_point11=a = 0.173205 * (3.464 - dis);
wave_0_per_point12=xang = 0.154 * time;
wave_0_per_point13=yang = 0.103 * time;
wave_0_per_point14=zang = 0.118 * time;
wave_0_per_point15=fov = 0.5;
wave_0_per_point16=mx = ox * cos(yang) + oz * sin(yang);
wave_0_per_point17=mz = -ox * sin(yang) + oz * cos(yang);
wave_0_per_point18=ox = mx;
wave_0_per_point19=oz = mz;
wave_0_per_point20=mx = ox * cos(zang) - oy * sin(zang);
wave_0_per_point21=my = ox * sin(zang) + oy * cos(zang);
wave_0_per_point22=ox = mx;
wave_0_per_point23=oy = my;
wave_0_per_point24=my = oy * cos(xang) - oz * sin(xang);
wave_0_per_point25=mz = oy * sin(xang) + oz * cos(xang);
wave_0_per_point26=oy = my;
wave_0_per_point27=oz = mz;
wave_0_per_point28=oz = 2 * (oz - 5 * floor(0.2 * oz) - 5);
wave_0_per_point29=x = ox * fov / oz + 0.5;
wave_0_per_point30=x = 0.75 * (x - 0.5) + 0.5;
wave_0_per_point31=y = oy * fov / oz + 0.5;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = ((texture (sampler_noise_lq, (rand_frame.xy + 
    ((uv * texsize_noise_lq.zw) * texsize.xy)
  )) * 2.0) - 1.0);
  ret_1 = (texture (sampler_pw_main, (uv + (
    (tmpvar_2.zw * texsize.zw)
   * 0.5))).xyz + ((0.59 - 
    (0.2 * rad)
  ) * tmpvar_2.xyz));
  vec3 tmpvar_3;
  tmpvar_3 = clamp (((
    (ret_1 - 0.5)
   * 3.0) + 0.25), 0.0, 1.0);
  ret_1.x = tmpvar_3.x;
  ret_1.yz = tmpvar_3.xx;
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }
