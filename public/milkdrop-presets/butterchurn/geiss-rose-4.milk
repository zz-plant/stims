[preset00]
fRating=5.000000
fGammaAdj=1.000000
nWaveMode=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=8.200000
fWaveScale=1.013000
fWaveSmoothing=0.900000
fWaveParam=-0.280000
fModWaveAlphaStart=1.050000
fModWaveAlphaEnd=1.650000
fZoom=1.055000
fWarp=0.023490
fWaveR=0.700000
fWaveG=0.650000
fWaveB=0.700000
nMotionVectorsX=31.200000
nMotionVectorsY=2.280000
nMotionVectorsLoop=2.500000
fMotionVectorsB=0.800000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.2 * (0.9 * sin(2.753 * time) + 0.4 * sin(2.315 * time + 1));
per_frame_2=wave_g = wave_g + 0.1 * (0.9 * sin(3.183 * time + 3) + 0.4 * sin(2.006 * time + 4));
per_frame_3=wave_b = wave_b + 0.1 * (0.9 * sin(2.393 * time + 5) + 0.4 * sin(2.733 * time + 2));
per_frame_4=zoom = zoom + 0.013 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=cx = cx + 0.003 * (0.6 * sin(0.471 * time) + 0.4 * sin(0.297 * time));
per_frame_7=cy = cy + 0.003 * (0.6 * sin(0.379 * time) + 0.4 * sin(0.351 * time));
per_frame_8=dx = dx + 0.003 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_9=rot = rot + 0.02 * (sin(2.134 * time) + sin(1.7134 * time) + sin(2.834 * time));
per_frame_10=dx = dx + 0.0025 * (sin(1.134 * time) + sin(0.7134 * time) + sin(2.334 * time));
per_frame_11=dy = dy + 0.0025 * (sin(1.8834 * time) + sin(1.0144 * time) + sin(1.334 * time));

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  float tmpvar_2;
  tmpvar_2 = dot (texsize.zw, texsize.zw);
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  tmpvar_1.xyz = (max (max (texture (sampler_main, uv).xyz, texture (sampler_main, 
    ((tmpvar_3 * (1.0 - (8.0 * 
      sqrt(tmpvar_2)
    ))) + 0.5)
  ).xyz), texture (sampler_main, (
    (tmpvar_3 * (1.0 + (8.0 * sqrt(tmpvar_2))))
   + 0.5)).xyz) - 0.02);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (mix (tmpvar_1.xyz, pow (vec3(
    dot (tmpvar_1.xyz, vec3(0.32, 0.49, 0.29))
  ), 
    (0.4 + (1.6 * rand_preset.xyz))
  ), vec3(0.7, 0.7, 0.7)) * 1.2);
  ret = tmpvar_2.xyz;
 }
