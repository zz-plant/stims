wave_0_per_frame1=basstime = basstime + bass * bass;
wave_0_per_frame2=t1 = 0.03 * basstime;
wave_0_per_point1=smp = 6.283 * sample;
wave_0_per_point2=xp = 0.1 * sin(smp);
wave_0_per_point3=yp = 0.1 * cos(smp);
wave_0_per_point4=zp = 0;
wave_0_per_point5=angy = 6.28 * sin(25.12 * sample + t1);
wave_0_per_point6=xq = xp * cos(angy) - zp * sin(angy);
wave_0_per_point7=zq = xp * sin(angy) + zp * cos(angy);
wave_0_per_point8=xp = xq;
wave_0_per_point9=zp = zq;
wave_0_per_point10=angy = 0.1 * t1;
wave_0_per_point11=xq = xp * cos(angy) - zp * sin(angy);
wave_0_per_point12=zq = xp * sin(angy) + zp * cos(angy);
wave_0_per_point13=xp = xq;
wave_0_per_point14=zp = zq;
wave_0_per_point15=axs2 = 3.3 * sin(0.1 * t1);
wave_0_per_point16=xq = xp * cos(axs2) - zp * sin(axs2);
wave_0_per_point17=zq = xp * sin(axs2) + zp * cos(axs2);
wave_0_per_point18=xp = xq;
wave_0_per_point19=zp = zq;
wave_0_per_point20=yp = yp * 1.2;
wave_0_per_point21=zp = zp + 2.1;
wave_0_per_point22=xs = xp / zp;
wave_0_per_point23=ys = yp / zp;
wave_0_per_point24=x = xs + q4;
wave_0_per_point25=y = ys + q5;
wave_0_per_point26=n2 = abs(6.283 * sample - 3.1415);
wave_0_per_point27=r = 0.5 * sin(n2 + time) + 0.5;
wave_0_per_point28=g = 0.5 * sin(n2 + 2.1 + time) + 0.5;
wave_0_per_point29=b = 0.5 * sin(n2 + 4.2 + time) + 0.5;
wave_2_init1=xs = 0;
