[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=0.995000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=3.000000
bMaximizeWaveColor=0.000000
bDarkenCenter=1.000000
fWaveAlpha=1.000000
fWaveScale=0.241456
fWaveSmoothing=0.090000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fZoomExponent=0.550448
fZoom=0.550449
fWarp=0.010000
fSx=0.999900
fSy=0.999900
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderB=0.400000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.300000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=6.400000
nMotionVectorsY=1.440001
nMotionVectorsLoop=0.000000
fMotionVectorsR=0.759900
fMotionVectorsG=0.480000
fMotionVectorsB=0.390000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=rad = 0;
per_frame_init_2=xpos = 0;
per_frame_init_3=q6 = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q5 = 0;
per_frame_init_6=mytime = 0;
per_frame_init_7=x = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=dy_r = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=dx_r = 0;
per_frame_init_12=ypos = 0;
per_frame_init_13=y = 0;
per_frame_init_14=bass_eff = 0;
per_frame_init_15=vol = 0;
per_frame_init_16=q2 = 0;
per_frame_init_17=q3 = 0;
per_frame_1=wave_r = wave_r + 0.45 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_2=wave_b = wave_b - 0.4 * (0.5 * sin(4.782 * time) + 0.5 * cos(0.722 * time));
per_frame_3=wave_g = wave_g + 0.4 * sin(1.931 * time);
per_frame_4=vol = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_5=bass_eff = max(max(bass, bass_att) - 1, 0);
per_frame_6=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_7=dx = 0.005 + 0.002 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_8=dy = 0.005 + 0.002 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_9=dx_r = if(0.00001 < abs(equal(q3, 0)), if(0.00001 < abs(above(x, xpos)), dx * q1 - xpos, dx + q2 - xpos), dx);
per_frame_10=dy_r = if(0.00001 < abs(equal(q3, 0)), if(0.00001 < abs(above(y, ypos)), dy * q1 - ypos, dy + q2 - ypos), dy);
per_frame_11=rot = rot + 0.05 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.479 * time));
per_frame_12=mytime = 0.7;
per_frame_13=xpos = 0.5 / vol;
per_frame_14=ypos = 0.5 / vol;
per_frame_15=q1 = sin(time * mytime * 4);
per_frame_16=q2 = cos(time * mytime * 2);
per_frame_17=q3 = abs(rad - 0.5) * q2 * q1;
per_frame_18=q4 = sin(0.35 * time) + dx_r * dy_r + dx * dy;
per_frame_19=q5 = sin(0.7 * time * 0.2) + dx_r * dy_r;
per_frame_20=q6 = 0.1 * atan(abs(-rad + 0.5)) * q2;
per_frame_21=wave_x = 0.5 + 0.1 * sin(time + randint(100) / 100);
per_frame_22=wave_y = 0.5 + 0.1 * cos(time + randint(100) / 100);
per_frame_23=ib_r = q3 + q2;
per_frame_24=ib_b = q2 + q1;
per_frame_25=ib_g = q1 + q3;
per_pixel_1=zoom = if(0.00001 < abs(below(q1, 0)), 0.3 * x, if(0.00001 < abs(equal(q2, 0)), 0.3 * (1 - x), if(0.00001 < abs(above(q3, 0)), 0.3 * y, 0.9 * (1 - y)))) + if(0.00001 < abs(below(q4, 0)), 0.3 * xpos, if(0.00001 < abs(equal(q5, 0)), 0.3 * (1 - xpos), if(0.00001 < abs(above(q6, 0)), 0.3 * ypos, 0.3 * (1 - ypos)))) + 0.7 - 0.03 * min(q6 + q3, 0.3);
per_pixel_2=dx = 0.01 * atan(rad / 0.1 * sin(dx_r * dy_r * 20 + 5 * time));
