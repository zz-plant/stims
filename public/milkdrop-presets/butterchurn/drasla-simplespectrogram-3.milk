[preset00]
fRating=0.000000
fGammaAdj=1.300000
fDecay=0.925000
fVideoEchoZoom=1.007000
nVideoEchoOrientation=1.000000
nWaveMode=7.000000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
fWaveAlpha=0.001000
fWaveScale=1.286000
fWaveSmoothing=0.630000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=0.999510
fWarp=0.010000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.005000
fOuterBorderR=0.010000
fOuterBorderA=1.000000
fInnerBorderSize=0.260000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_spectrum=1.000000
wavecode_0_thick=1.000000
wavecode_0_scaling=0.999900
wavecode_0_smoothing=0.010000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=dx = 1;
per_frame_1=warp = 0;
per_frame_2=decay = 1;
per_frame_3=zoom = 1;
per_frame_4=brighten = 1;
per_frame_5=solarize = 0;
per_frame_6=invert = 0;
wave_0_init1=q1 = 0;
wave_0_init2=q2 = 0;
wave_0_init3=q3 = 0;
wave_0_init4=q4 = 0;
wave_0_init5=q5 = 0;
wave_0_per_point1=q1 = (value1 + value2) / 2;
wave_0_per_point2=q1 = if(0.00001 < abs(above(q1, 1)), 1, q1);
wave_0_per_point3=q2 = log10(9 * q1 + 1);
wave_0_per_point4=q3 = 0.5;
wave_0_per_point5=q4 = if(0.00001 < abs(above(q2, q3)), (q2 - q3) / (1 - q3), 0);
wave_0_per_point6=q5 = log10(9 * q4 + 1);
wave_0_per_point7=q5 = if(0.00001 < abs(above(q5, 1)), 1, q5);
wave_0_per_point8=a = q2;
wave_0_per_point9=r = q5;
wave_0_per_point10=b = 1;
wave_0_per_point11=g = 0;
wave_0_per_point12=x = 0.99;
wave_0_per_point13=y = 1.6 * sample;

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = (uv.x + 0.003);
  tmpvar_1.y = uv.y;
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = texture (sampler_pc_main, tmpvar_1).xyz;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 1.3);
  ret = tmpvar_1.xyz;
 }
