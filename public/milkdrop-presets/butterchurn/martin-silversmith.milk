    (6.0 * q2)
   * 
    sqrt(dot (tmpvar_4, tmpvar_4))
  )) + q30);
  vec2 tmpvar_6;
  tmpvar_6 = clamp (((
    sin(theta_5)
   / 
    cos(theta_5)
  ) * -(
    normalize((1.0/(tmpvar_4)))
  )), vec2(-8.0, -8.0), vec2(8.0, 8.0));
  rs_2 = tmpvar_6;
  if ((q28 == 1.0)) {
    rs_2 = (tmpvar_6 * cos((
      (tmpvar_4.yx * 3.0)
     * q27)));
  };
  uv_1 = (uv + (rs_2 / 40.0));
  vec2 tmpvar_7;
  tmpvar_7.x = rad;
  tmpvar_7.y = sqrt(dot (tmpvar_4, tmpvar_4));
  uv6_3 = (0.5 * tmpvar_7);
  xlat_mutablemus = (vec3(clamp ((0.08 / 
    sqrt((uv6_3.y - q10))
  ), 0.0, 1.0)) * vec3(1.0, 0.84, 0.5));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = (((
    (texture (sampler_main, uv_1).xyz - (((texture (sampler_blur1, 
      fract(uv_1)
    ).xyz * scale1) + bias1) * 0.04))
   + 
    (0.05 * xlat_mutablemus)
  ) * 0.98) - 0.006);
  ret = tmpvar_8.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv1_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_main, uv) * (1.0 - rad)).xyz;
