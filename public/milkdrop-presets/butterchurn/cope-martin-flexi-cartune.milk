  tmpvar_6.y = xlat_mutabledy.y;
  vec2 x_7;
  x_7 = (tmpvar_6 * 8.0);
  ret_1 = (((texture (sampler_main, 
    ((0.5 + ((
      fract(((1.0 - abs(
        ((fract((
          (tmpvar_3 + vec2(0.5, 1.0))
         * 0.5)) * 2.0) - 1.0)
      )) - ((
        (texture (sampler_noise_hq, ((tmpvar_5 * 0.05) + (vec2(0.1, -0.05) * time))) - 0.5)
       * 
        float(int((tmpvar_3.y > 0.0)))
      ).xy * 0.025)))
     - 0.5) * 0.85)) - vec2(0.0, 0.04))
  ).x * 
    (1.0 - sqrt(dot (x_7, x_7)))
