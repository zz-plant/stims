per_pixel_11=rot = 0.1 * (above(rd, 0.7) / (rd + 2)) * bass_att / rd;
per_pixel_12=rot = rot + 0.05 * sin(13.5 * rad + 1.3 * q2 + 1.31 * q);
per_pixel_13=zoom = zoom + 0.05 * sin(10 * ang + 7.5 * rad + 1.63 * q2 + q);
per_pixel_14=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_15=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_16=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_17=a1 = 4.1 * sin(mid_att);
per_pixel_18=a2 = 4.7 * sin(treb_att);
per_pixel_19=a3 = 4.9 * sin(bass_att);
per_pixel_20=zoom = zoom + abs(0.1 * (1.2 - rad));
per_pixel_21=rot = rot + 6 * dx_r * ad;
per_pixel_22=dx = dx + dx_r * ad * 5;
per_pixel_23=dy = dy + dy_r * ad * 5;
per_pixel_24=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_25=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_26=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_27=tg1 = abs(sin(time));
per_pixel_28=tg2 = 12 * dx_r * above(tg1, 0.5) + 12 * dy_r * below(tg1, 0.5);
per_pixel_29=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_30=zoom = zoom - 0.01;
per_pixel_31=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
