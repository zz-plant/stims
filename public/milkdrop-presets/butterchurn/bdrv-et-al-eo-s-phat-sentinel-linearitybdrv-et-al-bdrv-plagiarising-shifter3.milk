per_pixel_41=an = ang + pi + time;
per_pixel_42=an = an - 2 * pi * floor(an / (2 * pi));
per_pixel_43=mod = 0.1;
per_pixel_44=seg = ang + pi;
per_pixel_45=seg = seg / (2 * pi) * num;
per_pixel_46=seg = floor(seg);
per_pixel_47=seg = seg - equal(seg, num);
per_pixel_48=anga = ang + pi - 2 * pi / num * seg;
per_pixel_49=anga = if(0.00001 < abs(equal(mod(seg, 2), 0)), 2 * pi / num - anga, anga);
per_pixel_50=anga = anga + pi / 4;
per_pixel_51=ox = 0.5 - radi * sin(anga);
per_pixel_52=oy = 0.5 + radi * cos(anga);
per_pixel_53=dx = equal(seg, 3) * (x - ox);
