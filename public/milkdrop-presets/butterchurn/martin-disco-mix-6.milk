per_frame_1=dec_med = pow(0.9, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=beat = bass + mid + treb;
per_frame_5=beat = beat * beat;
per_frame_6=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_7=is_beat = above(beat, 0.3 * avg + peak) * above(time, t0 + 0.1);
per_frame_8=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_9=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_10=index = mod(index + is_beat, 32);
per_frame_11=indexa = mod(indexa + is_beat, 5);
per_frame_12=index2 = mod(index2 + is_beat * bnot(index), 2);
