per_frame_14=q21 = beat;
per_frame_15=q22 = peak;
per_frame_16=q23 = index;
per_frame_17=q24 = is_beat;
per_frame_18=q26 = bass_att + mid_att + treb_att + 1;
per_frame_19=q27 = index + 1;
per_frame_20=q28 = -index2 + indexa / 5;
per_frame_21=q29 = index2;
per_frame_22=k1 = is_beat * equal(mod(index, 16), 0);
per_frame_23=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_24=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_25=rot1 = 3.1416 * p2 / 2;
per_frame_26=q8 = cos(rot1);
per_frame_27=rott = rott + 1 / fps * sin(time / 3.5);
per_frame_28=q1 = cos(rott);
per_frame_29=q2 = sin(rott);
per_frame_30=q3 = -q2;
per_frame_31=q4 = q1;
per_frame_32=trel = trel + 1 * (0.5 / fps);
per_frame_33=q5 = cos(time / 6 + trel) / 3;
per_frame_34=q6 = sin(trel) / 16 + 0.4;
per_frame_35=q7 = 1.02 + 0.03 * sin(rott / 3.7);
per_frame_36=ran = ran * (1 - q24) + randint(100) / 100;
per_frame_37=q10 = ran - 0.5;
per_frame_38=zoom = 1;
per_frame_39=warp = 0;

