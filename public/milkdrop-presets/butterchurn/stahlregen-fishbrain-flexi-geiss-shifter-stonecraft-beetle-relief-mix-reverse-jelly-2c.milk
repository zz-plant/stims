[preset00]
fRating=2.000000
fGammaAdj=1.900000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.001000
fWaveScale=1.286000
fWaveSmoothing=0.630000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoomExponent=1.254860
fZoom=0.970120
fWarp=0.010000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.500000
fOuterBorderR=0.010000
fInnerBorderSize=0.260000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_thick=1.000000
wavecode_1_enabled=1.000000
wavecode_1_thick=1.000000
wavecode_2_enabled=1.000000
wavecode_2_usedots=1.000000
wavecode_2_thick=1.000000
wavecode_3_enabled=1.000000
wavecode_3_thick=1.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=ea = 0;
per_frame_init_2=eo = 0;
per_frame_init_3=ez = 0;
per_frame_init_4=ez = 1.2;
per_frame_1=ea = abs(sin(0.25 * time));
per_frame_2=eo = if(0.00001 < abs(below(ea, 0.1)), floor(randint(3)), eo);
per_frame_3=ez = if(0.00001 < abs(below(ea, 0.1)), 0.5 + 0.1 * floor(randint(10)), ez);
per_frame_4=echo_alpha = ea;
per_frame_5=echo_orient = eo;
per_frame_6=echo_zoom = ez;
per_pixel_1=rot = rot + rad * sin(0.25 * time) * 0.02;
wave_0_init1=ma = 0;
wave_0_init2=mx = 0;
wave_0_init3=my = 0;
wave_0_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.01 * bass;
wave_0_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_0_per_point3=mx = mx + 0.0002 * cos(ma);
wave_0_per_point4=my = my + 0.0002 * sin(ma);
wave_0_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_0_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_0_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_0_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_0_per_point9=x = mx;
wave_0_per_point10=y = my;
wave_0_per_point11=a = above(bass + mid + treb, 0.8);
wave_1_init1=ma = 0;
wave_1_init2=mx = 0;
wave_1_init3=my = 0;
wave_1_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.05 * bass;
wave_1_per_point2=ma = ma - 3.1415 * above(mid, 1) * 0.05 * mid;
wave_1_per_point3=mx = mx + 0.0001 * cos(ma);
wave_1_per_point4=my = my + 0.0001 * sin(ma);
wave_1_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_1_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_1_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_1_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_1_per_point9=x = mx;
wave_1_per_point10=y = my;
wave_1_per_point11=a = above(bass + mid + treb, 0.1);
wave_2_init1=ma = 0;
wave_2_init2=mx = 0;
wave_2_init3=my = 0;
wave_2_per_point1=ma = ma + 3.1415 * above(mid, 1) * 0.01 * mid;
wave_2_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_2_per_point3=mx = mx + 0.0004 * cos(ma);
wave_2_per_point4=my = my + 0.0004 * sin(ma);
wave_2_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_2_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_2_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_2_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_2_per_point9=x = mx;
wave_2_per_point10=y = my;
wave_2_per_point11=a = above(bass + mid + treb, 0.3);
wave_3_init1=ma = 0;
wave_3_init2=mx = 0;
wave_3_init3=my = 0;
wave_3_per_point1=ma = ma + 3.1415 * above(bass, 0.5) * 0.02 * bass;
wave_3_per_point2=ma = ma - 3.1415 * above(treb, 0.5) * 0.02 * treb;
wave_3_per_point3=mx = mx + 0.0008 * cos(ma);
wave_3_per_point4=my = my + 0.0008 * sin(ma);
wave_3_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_3_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_3_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_3_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_3_per_point9=x = mx;
wave_3_per_point10=y = my;
wave_3_per_point11=a = above(bass + mid + treb, 0.2);

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = (1.0 - uv.x);
  tmpvar_1.y = uv.y;
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (max (texture (sampler_main, uv).xyz, texture (sampler_main, tmpvar_1).zyx) * 0.97);
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv2_1;
  vec3 ret_2;
  uv2_1 = (uv + (vec2(1.0, 0.0) * texsize.zw));
  float tmpvar_3;
  tmpvar_3 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(-1.0, 0.0) * texsize.zw));
  float tmpvar_4;
  tmpvar_4 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(0.0, 1.0) * texsize.zw));
  float tmpvar_5;
  tmpvar_5 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(0.0, -1.0) * texsize.zw));
  vec3 tmpvar_6;
  tmpvar_6.z = 0.14;
  tmpvar_6.x = (tmpvar_3 - tmpvar_4);
  tmpvar_6.y = (tmpvar_5 - ((
    (texture (sampler_main, uv2_1).xyz + (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4))
   + 
    (((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2) * 0.15)
  ) + (
    ((texture (sampler_blur3, uv2_1).xyz * scale3) + bias3)
   * 0.1)).x);
  ret_2 = (0.5 + (0.5 * normalize(tmpvar_6)));
  vec2 x_7;
  x_7 = (ret_2.xy - 0.5);
  ret_2 = (ret_2 * clamp ((
    sqrt(dot (x_7, x_7))
   * 5.0), 0.0, 1.0));
  ret_2 = (ret_2 - 1.55);
  ret_2 = (ret_2 + mix (ret_2, (ret_2 * 
    (((texture (sampler_blur1, uv).xyz * scale1) + bias1) - (((texture (sampler_blur3, uv).xyz * scale3) + bias3) * 2.25))
  ), pow (hue_shader.zxy, ret_2)));
  ret_2 = (ret_2 * ret_2);
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = ret_2;
  ret = tmpvar_8.xyz;
 }
