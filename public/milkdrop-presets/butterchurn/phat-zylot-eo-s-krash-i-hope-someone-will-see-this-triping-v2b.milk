per_pixel_1=sx = -1 + 0.2 * bass;
per_pixel_2=sy = -1 - 0.2 * treb;
per_pixel_3=cx = 0.5 + q4;
per_pixel_4=cy = 0.5 - q5;
per_pixel_5=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
