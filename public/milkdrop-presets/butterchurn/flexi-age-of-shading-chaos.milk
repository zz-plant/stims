per_frame_1=decay = 1;
per_frame_2=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_3=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_4=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_5=x1 = 0.5 + (xx1 - xx2);
per_frame_6=y1 = 0.85 + 0.3 * yy1;
per_frame_7=spring = 100;
per_frame_8=grav = 11;
per_frame_9=resist = 0.2;
per_frame_10=bounce = 0.8;
per_frame_11=dt = 0.0001;
per_frame_12=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_13=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_14=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_15=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_16=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_17=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_18=x2 = x2 + vx2;
per_frame_19=y2 = y2 + vy2;
per_frame_20=x3 = x3 + vx3;
per_frame_21=y3 = y3 + vy3;
per_frame_22=x4 = x4 + vx4;
per_frame_23=y4 = y4 + vy4;
per_frame_24=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_25=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_26=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_27=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_28=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_29=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_30=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_31=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_32=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_33=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_34=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_35=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_36=q3 = x4;
per_frame_37=q4 = x2;
per_frame_38=q7 = y4;
per_frame_39=q8 = y2;
per_frame_40=q9 = x1;
per_frame_41=q10 = y1;
per_frame_42=q11 = x3;
per_frame_43=q12 = y3;
per_frame_44=zoom = 1;
per_frame_45=bb = 0.99 * bb + 0.02 * bass;
per_frame_46=mm = 0.99 * mm + 0.02 * mid;
per_frame_47=tt = 0.99 * tt + 0.02 * treb;
per_frame_48=mx = max(max(bb, mm), tt);
per_frame_49=mn = min(min(bb, mm), tt);
per_frame_50=ob_r = (bb - mn) / (mx - mn);
per_frame_51=ob_b = (mm - mn) / (mx - mn);
per_frame_52=ob_g = (tt - mn) / (mx - mn);
per_frame_53=q2 = atan2(vx4, vy4);
per_frame_54=q13 = atan2(vx3, vy3);
per_frame_55=q1 = sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_56=q14 = sqrt(vx3 * vx3 + vy3 * vy3);
per_frame_57=q6 = atan2(vx2, vy2);
per_frame_58=q5 = sqrt(vx2 * vx2 + vy2 * vy2);
per_frame_59=a = 0.95 * a + q5;
per_frame_60=monitor = q7;
per_pixel_1=w1 = q9;
per_pixel_2=w2 = q10;
per_pixel_3=w3 = q11;
per_pixel_4=w4 = q12;
per_pixel_5=w5 = q13;
per_pixel_6=w6 = q14;
per_pixel_7=dir = -q6 + asin(1);
per_pixel_8=b1 = 0.075;
per_pixel_9=m1 = 50 * q5;
per_pixel_10=t1 = 0.1;
per_pixel_11=xx = q4;
per_pixel_12=yy = 1 - q8;
per_pixel_13=x1 = xx + cos(dir + 1.5708) * b1;
per_pixel_14=y1 = yy - sin(dir + 1.5708) * b1;
per_pixel_15=x2 = xx - cos(dir + 1.5708) * b1;
per_pixel_16=y2 = yy + sin(dir + 1.5708) * b1;
per_pixel_17=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * b1;
per_pixel_18=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_19=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * b1;
per_pixel_20=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_21=si3 = 10 * -pow(q5, 3);
per_pixel_22=dx = 2 * (si1 * sin(y1 - y) * m1 * d1 - si2 * sin(y2 - y) * m1 * d2 + si3 * cos(dir) * t1);
per_pixel_23=dy = 2 * (-si1 * sin(x1 - x) * m1 * d1 + si2 * sin(x2 - x) * m1 * d2 - si3 * sin(dir) * t1);
per_pixel_24=m = 1 - si1 - si2;
per_pixel_25=dir = -q2 + 0 * asin(1);
per_pixel_26=xx = q3;
per_pixel_27=yy = 1 - q7;
per_pixel_28=d = sqrt((x - xx) * (x - xx) + (y - yy) * (y - yy));
per_pixel_29=r = 0.05;
per_pixel_30=v = -35 * q1;
per_pixel_31=dx = dx + v * sin(dir) * (r - d) * (1 - sigmoid(d - r, 280));
per_pixel_32=dy = dy + v * cos(dir) * (r - d) * (1 - sigmoid(d - r, 280));
per_pixel_33=xx = w1;
per_pixel_34=yy = 1 - w2;
per_pixel_35=d = sqrt((x - xx) * (x - xx) + (y - yy) * (y - yy));
per_pixel_36=r = 0.1;
per_pixel_37=v = -35;
per_pixel_38=dx = dx + v * (x - xx) * (r - d) * (1 - sigmoid(d - r, 70));
per_pixel_39=dy = dy + v * (y - yy) * (r - d) * (1 - sigmoid(d - r, 70));
per_pixel_40=xx = w3;
per_pixel_41=yy = 1 - w4;
per_pixel_42=dir = w5;
per_pixel_43=d = sqrt((x - xx) * (x - xx) + (y - yy) * (y - yy));
per_pixel_44=r = 0.1;
per_pixel_45=v = 20;
per_pixel_46=v2 = w6;
per_pixel_47=dx = dx + (v * (sin(y - yy) * (d - r) - (x - xx) * (d - r / 2)) + cos(dir) * v2) * (1 - sigmoid(d - r, 180));
per_pixel_48=dy = dy + (-v * (sin(x - xx) * (d - r) + (y - yy) * (d - r / 2)) - sin(dir) * v2) * (1 - sigmoid(d - r, 180));
per_pixel_49=d = sqrt((x - 0.5) * (x - 0.5) + (y - 0.5) * (y - 0.5)) * rad;
per_pixel_50=n = 80;
per_pixel_51=t = 0 * q3 + 0 * time;
per_pixel_52=w = -q6 + asin(1) / 2;
per_pixel_53=v = 0.1 * q3;
per_pixel_54=x2 = x - 0.5;
per_pixel_55=y2 = y - 0.5;
per_pixel_56=x1 = sin(w) * x2 - cos(w) * y2;
per_pixel_57=y1 = cos(w) * x2 + sin(w) * y2;
per_pixel_58=x = x1;
per_pixel_59=y = y1;
per_pixel_60=dx1 = 0.01 * (cos((-x + y) * n + t) + sin((x + y) * n + t));
per_pixel_61=dy1 = 0.01 * (cos((x - y) * n - t) + sin((-x - y) * n - t));
per_pixel_62=dx2 = sin(-w) * dx1 - cos(-w) * dy1;
per_pixel_63=dy2 = cos(-w) * dx1 + sin(-w) * dy1;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_fc_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  float ang2_2;
  ang2_2 = (fract((0.9549295 * ang)) / 6.0);
  ang2_2 = (abs((ang2_2 - 0.08333334)) * 6.283185);
  vec2 tmpvar_3;
  tmpvar_3.x = cos(ang2_2);
  tmpvar_3.y = sin(ang2_2);
  uv_1 = (0.5 + ((
    (0.4 * (rad * sqrt(dot (texsize.xy, texsize.xy))))
   * tmpvar_3) * texsize.zw));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (1.4 * pow ((
    clamp (((texture (sampler_blur1, uv_1).xyz * scale1) + bias1), 0.0, 1.0)
   * 
    (texture (sampler_pc_main, uv_1).xyz - ((texture (sampler_blur3, uv_1).xyz * scale3) + bias3))
  ), vec3(0.5, 0.5, 0.5)));
  ret = tmpvar_4.xyz;
 }
