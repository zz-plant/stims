[preset00]
fRating=5.000000
nWaveMode=2.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
fWaveAlpha=0.230000
fWaveScale=1.694000
fWaveSmoothing=0.900000
fWarpScale=1.772000
fZoomExponent=0.090000
fZoom=0.971000
fWarp=0.513000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.000000
fOuterBorderA=0.500000
fInnerBorderA=0.020000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=blah = 0;
per_frame_1=wave_x = wave_x + 0.5 * (0.6 * sin(2.121 * time) + 0.4 * sin(1.621 * time));
per_frame_2=wave_y = wave_y + 0.5 * (0.6 * sin(1.742 * time) + 0.4 * sin(2.322 * time));
per_frame_3=wave_r = wave_r + 0.35 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_4=wave_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_5=wave_b = wave_b + 0.35 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_6=rot = rot + 0.035 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.539 * time));
per_frame_7=cx = cx + 0.03 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.194 * time));
per_frame_8=cy = cy + 0.037 * (0.6 * sin(0.274 * time) + 0.4 * sin(0.394 * time));
per_frame_9=ib_r = ib_r + 0.2 * sin(0.5413 * time);
per_frame_10=ib_g = ib_g + 0.2 * sin(0.6459 * time);
per_frame_11=ib_b = ib_b + 0.2 * sin(0.4354 * time);
per_frame_12=blah = 3 / (ib_r + ib_g + ib_b);
per_frame_13=ib_r = ib_r * blah;
per_frame_14=ib_g = ib_g * blah;
per_frame_15=ib_b = ib_b * blah;
