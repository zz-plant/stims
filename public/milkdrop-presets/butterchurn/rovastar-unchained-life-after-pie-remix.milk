[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.977000
fVideoEchoZoom=1.006596
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bMotionVectorsOn=0.000000
fWaveAlpha=4.099998
fWaveScale=3.192474
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=0.999514
fWarp=0.009091
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.500000
fOuterBorderR=0.010000
fInnerBorderSize=0.260000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=rpi = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_init_4=treb_factor = 0;
per_frame_init_5=treb_thresh = 0;
per_frame_init_6=pi = 0;
per_frame_init_7=mid_thresh = 0;
per_frame_init_8=mid_factor = 0;
per_frame_init_9=api = 0;
per_frame_init_10=q2 = 0;
per_frame_init_11=q3 = 0;
per_frame_init_12=bass_factor = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.35) + 1.3);
per_frame_2=bass_factor = equal(bass_thresh, 2) * sin(time * bass_thresh * 0.4) + (1 - equal(bass_thresh, 2)) * bass_factor;
per_frame_3=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.35) + 1.3);
per_frame_4=mid_factor = equal(mid_thresh, 2) * sin(time * mid_thresh * 0.4) + (1 - equal(mid_thresh, 2)) * mid_factor;
per_frame_5=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.35) + 1.3);
per_frame_6=treb_factor = equal(treb_thresh, 2) * sin(time * treb_thresh * 0.4) + (1 - equal(treb_thresh, 2)) * treb_factor;
per_frame_7=wave_r = 0.5 + 0.5 * bass_factor;
per_frame_8=wave_b = 0.5 + 0.5 * mid_factor;
per_frame_9=wave_g = 0.5 + 0.5 * treb_factor;
per_frame_10=wave_mystery = sin(0.7 * time) / 10;
per_frame_11=q1 = bass_factor;
per_frame_12=q2 = mid_factor;
per_frame_13=q3 = treb_factor;
per_pixel_1=pi = 22 / 7 + 0.2 - 0.2 * q1;
per_pixel_2=rpi = pi * rad;
per_pixel_3=api = (1 - rad) * pi;
per_pixel_4=zoom = if(0.00001 < abs(above(rad, abs(q2))), 1.07 + 0.04 * sin(rpi) * q2, 0.97 + 0.04 * (sin(rpi) / 10 - sin(api) / 10) * q2) + 0.07 * cos(3 * rpi * q3);
per_pixel_5=rot = if(0.00001 < abs(above(rad, abs(q2))), 0.1 * cos(2 * rad * rpi + sin(pi * pow(rad, 5))) * q1, 0.1 * (cos(api) / 25 + sin(rpi)) * q1) + 0.1 * cos(3 * api * q3);
