per_frame_1=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_2=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_3=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_4=x1 = 0.5 + 2 * (xx1 - xx2);
per_frame_5=y1 = 0.4 + yy1;
per_frame_6=x1 = max(0, min(1, x1));
