shape_2_per_frame1=bb = bb + bass * bass * 0.85 * equal(instance, 0);
shape_2_per_frame2=mm = mm + mid * mid * 0.85 * equal(instance, 0);
shape_2_per_frame3=tt = tt + treb * treb * 0.85 * equal(instance, 0);
shape_2_per_frame4=q3 = 0.012 * bb;
shape_2_per_frame5=q4 = 0.012 * mm;
shape_2_per_frame6=q5 = 0.012 * tt;
shape_2_per_frame7=rnd1 = if(0.00001 < abs(equal(instance, 0)), t1, rnd1);
shape_2_per_frame8=rnd2 = if(0.00001 < abs(equal(instance, 0)), t2, rnd2);
shape_2_per_frame9=rnd3 = if(0.00001 < abs(equal(instance, 0)), t3, rnd3);
shape_2_per_frame10=rnd4 = if(0.00001 < abs(equal(instance, 0)), t4, rnd4);
shape_2_per_frame11=rnd1 = 4 * rnd1 * (1 - rnd1);
shape_2_per_frame12=rnd2 = 4 * rnd2 * (1 - rnd2);
shape_2_per_frame13=rnd3 = 4 * rnd3 * (1 - rnd3);
shape_2_per_frame14=rnd4 = 4 * rnd4 * (1 - rnd4);
shape_2_per_frame15=t = 0.6;
shape_2_per_frame16=t = rnd1 + time * t - floor(rnd1 + time * t);
shape_2_per_frame17=t = t + 0.1 * rnd2;
shape_2_per_frame18=wh = rnd4 * asin(1) * 4;
shape_2_per_frame19=wv = 0.25 + 0.1 * rnd3;
shape_2_per_frame20=d = 1.4;
shape_2_per_frame21=zoom = 1;
shape_2_per_frame22=l = 1;
shape_2_per_frame23=w1 = q3;
shape_2_per_frame24=w2 = q4;
shape_2_per_frame25=w3 = q5;
shape_2_per_frame26=i = instance;
shape_2_per_frame27=my_x = t * cos(wh) * sin(wv) * l;
shape_2_per_frame28=my_y = (-0.5 + (t - 0.75) * (t - 0.75)) * cos(wv) * l;
shape_2_per_frame29=my_z = t * sin(wh) * sin(wv) * l;
shape_2_per_frame30=x1 = cos(w1) * my_x + sin(w1) * my_y;
shape_2_per_frame31=y1 = -sin(w1) * my_x + cos(w1) * my_y;
shape_2_per_frame32=z1 = my_z;
shape_2_per_frame33=x2 = cos(w2) * x1 + sin(w2) * z1;
shape_2_per_frame34=z2 = -sin(w2) * x1 + cos(w2) * z1;
shape_2_per_frame35=y2 = y1;
shape_2_per_frame36=y3 = cos(w3) * y2 + sin(w3) * z2;
shape_2_per_frame37=z3 = -sin(w3) * y2 + cos(w3) * z2;
shape_2_per_frame38=x3 = x2;
shape_2_per_frame39=p = tan(asin(1) + atan2(d + z3, sqrt(x3 * x3 + y3 * y3)));
shape_2_per_frame40=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_2_per_frame41=rad = rad / d;
shape_2_per_frame42=my_x = zoom * sin(atan2(x3, y3)) * p;
shape_2_per_frame43=my_y = zoom * cos(atan2(x3, y3)) * p;
shape_2_per_frame44=x = 0.5 + my_x;
shape_2_per_frame45=y = 0.5 + my_y;
shape_2_per_frame46=x = 0.5 + (x - 0.5) * q10;
shape_2_per_frame47=y = 0.5 + (y - 0.5) * q9;
