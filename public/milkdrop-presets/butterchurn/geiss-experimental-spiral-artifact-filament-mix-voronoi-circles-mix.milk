  tmpvar_5.xyz = abs(((texture (sampler_main, uv2_2).xyz * 2.65) + (
    ((texture (sampler_blur1, uv2_2).xyz * scale1) + bias1)
   * -2.0)));
  ret = tmpvar_5.xyz;
 }
