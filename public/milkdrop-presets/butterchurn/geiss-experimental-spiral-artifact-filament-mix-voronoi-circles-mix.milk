  tmpvar_5 = texture (sampler_main, (uv + tmpvar_2.zy));
  vec4 tmpvar_6;
  tmpvar_6 = texture (sampler_main, (uv - tmpvar_2.zy));
  float tmpvar_7;
  tmpvar_7 = max (max (dot (tmpvar_3.xyz, vec3(0.32, 0.49, 0.29)), dot (tmpvar_4.xyz, vec3(0.32, 0.49, 0.29))), max (dot (tmpvar_5.xyz, vec3(0.32, 0.49, 0.29)), dot (tmpvar_6.xyz, vec3(0.32, 0.49, 0.29))));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = (mix (mix (
    mix (tmpvar_3.xyz, tmpvar_4.xyz, vec3(clamp (((
      (dot (tmpvar_4.xyz, vec3(0.32, 0.49, 0.29)) - tmpvar_7)
     + 0.01) * 1000.0), 0.0, 1.0)))
  , tmpvar_5.xyz, vec3(
    clamp ((((
      dot (tmpvar_5.xyz, vec3(0.32, 0.49, 0.29))
     - tmpvar_7) + 0.01) * 1000.0), 0.0, 1.0)
  )), tmpvar_6.xyz, vec3(clamp (
    (((dot (tmpvar_6.xyz, vec3(0.32, 0.49, 0.29)) - tmpvar_7) + 0.01) * 1000.0)
