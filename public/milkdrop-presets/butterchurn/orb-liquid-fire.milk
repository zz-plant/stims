[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + texture (sampler_fc_main, ((
    (texture (sampler_blur3, uv).xyz * scale3)
   + bias3) * 2.0).xy).xyz);
  ret_1 = (ret_1 * 2.0);
  ret_1 = (ret_1 * (ret_1 - (ret_1 * 0.2)));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
