[preset00]
fRating=0.000000
fDecay=0.990000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=2.426125
fWaveScale=1.234584
fWaveSmoothing=0.360000
fModWaveAlphaStart=0.850000
fModWaveAlphaEnd=1.529999
fZoom=1.040000
fWarp=0.076000
fWaveR=0.700000
fWaveG=0.740000
fWaveB=0.670000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q2 = 0;
per_frame_init_2=q = 0;
per_frame_init_3=q1 = 0;
per_frame_1=wave_r = wave_r + (0.6 * sin(1.517 * time) + 0.4 * sin(1.58 * time));
per_frame_2=wave_g = wave_g + (0.6 * sin(1.088 * time) + 0.4 * sin(1.076 * time));
per_frame_3=wave_b = wave_b + (0.6 * sin(1.037 * time) + 0.4 * sin(0.922 * time));
per_frame_4=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=q1 = cos(1.41 * time);
per_frame_8=q2 = time + 0.3 * sin(1.47 * time);
per_pixel_1=rot = rot + 0.05 * sin(13.5 * rad + 1.3 * q2 + 1.31 * q);
per_pixel_2=zoom = zoom + 0.05 * sin(10 * ang + 7.5 * rad + 1.63 * q2 + q);

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = normalize((uv_orig - 0.5));
  float tmpvar_3;
  tmpvar_3 = (time * 7.0);
  uv_1 = (uv + ((
    (tmpvar_2 * texsize.zw)
   * 
    cos(((rad * 170.0) - tmpvar_3))
  ) * 2.0));
  uv_1 = (uv_1 + ((
    (vec2(5.0, -5.0) * texsize.zw)
   * 
    cos(((ang * 30.0) - tmpvar_3))
  ) * tmpvar_2.yx));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ((texture (sampler_main, uv_1).xyz - 0.002) * 0.99);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 2.0);
  ret = tmpvar_1.xyz;
 }
