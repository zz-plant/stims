per_frame_init_1=n = 0;
per_frame_init_2=y1 = 0;
per_frame_init_3=x1 = 0;
per_frame_init_4=dy1 = 0;
per_frame_init_5=v = 0;
per_frame_init_6=mm = 0;
per_frame_init_7=tt = 0;
per_frame_init_8=angle = 0;
per_frame_init_9=t = 0;
per_frame_init_10=mx = 0;
per_frame_init_11=mn = 0;
per_frame_init_12=dx1 = 0;
per_frame_init_13=bb = 0;
per_frame_1=wave_a = 0;
per_frame_2=warp = 0;
per_frame_3=zoom = 1;
per_frame_4=bb = 0.99 * bb + 0.02 * bass;
per_frame_5=mm = 0.99 * mm + 0.02 * mid;
per_frame_6=tt = 0.99 * tt + 0.02 * treb;
per_frame_7=mx = max(max(bb, mm), tt);
per_frame_8=mn = min(min(bb, mm), tt);
per_frame_9=ib_r = (bb - mn) / (mx - mn);
per_frame_10=ib_b = (mm - mn) / (mx - mn);
per_frame_11=ib_g = (tt - mn) / (mx - mn);
per_pixel_1=angle = asin(1) * (0.5 + sin(0.05 * time));
per_pixel_2=x1 = (x - 0.5) * aspectx;
per_pixel_3=y1 = (y - 0.5) * aspecty;
per_pixel_4=x = cos(-angle) * x1 - sin(-angle) * y1;
per_pixel_5=y = sin(-angle) * x1 + cos(-angle) * y1;
per_pixel_6=t = 0.25 * time;
per_pixel_7=v = 0.0005;
per_pixel_8=n = 11;
per_pixel_9=dx = v * sin(y * n + t);
per_pixel_10=dy = v * sin(x * n + t);
per_pixel_11=dx1 = cos(angle) * dx - sin(angle) * dy;
per_pixel_12=dy1 = sin(angle) * dx + cos(angle) * dy;
per_pixel_13=dx = dx1 * aspectx;
per_pixel_14=dy = dy1 * aspecty;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_pc_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 dz_1;
  vec3 dy_2;
  vec3 dx_3;
  vec2 d_4;
  vec3 ret_5;
  vec2 tmpvar_6;
  vec2 tmpvar_7;
  tmpvar_7 = (vec2(1.0, 0.0) * texsize.zw);
  tmpvar_6.x = (texture (sampler_main, (uv + tmpvar_7)).xyz - texture (sampler_main, (uv - tmpvar_7)).xyz).y;
  vec2 tmpvar_8;
  tmpvar_8 = (vec2(0.0, 1.0) * texsize.zw);
  tmpvar_6.y = (texture (sampler_main, (uv + tmpvar_8)).xyz - texture (sampler_main, (uv - tmpvar_8)).xyz).y;
  d_4 = -(texsize.zw);
  dx_3 = (((2.0 * 
    ((texture (sampler_blur1, (uv + (vec2(1.0, 0.0) * d_4))).xyz * scale1) + bias1)
  ) - (2.0 * 
    ((texture (sampler_blur1, (uv - (vec2(1.0, 0.0) * d_4))).xyz * scale1) + bias1)
  )) * 0.5);
  dy_2 = (((2.0 * 
    ((texture (sampler_blur1, (uv + (vec2(0.0, 1.0) * d_4))).xyz * scale1) + bias1)
  ) - (2.0 * 
    ((texture (sampler_blur1, (uv - (vec2(0.0, 1.0) * d_4))).xyz * scale1) + bias1)
  )) * 0.5);
  vec2 tmpvar_9;
  tmpvar_9.x = dx_3.y;
  tmpvar_9.y = dy_2.y;
  dz_1 = ((tmpvar_6 * 3.0) + tmpvar_9);
  ret_5 = (vec3(((
    pow ((sqrt(dot (dz_1, dz_1)) * 0.8), 0.7)
   + 
    (((texture (sampler_blur2, uv).xyz * scale2) + bias2).y * 0.4)
  ) - 0.1)) * vec3(0.5, 0.5, 0.5));
  vec2 tmpvar_10;
  tmpvar_10.x = dx_3.x;
  tmpvar_10.y = dy_2.x;
  vec3 tmpvar_11;
  tmpvar_11 = mix (mix (ret_5, vec3(0.05, 0.12, 0.0), vec3((texture (sampler_main, 
    (uv + ((tmpvar_10 * texsize.zw) * 18.0))
  ).x * 6.0))), vec3(4.0, 1.0, 0.0), vec3(((
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1).z * 0.1)));
  ret_5 = tmpvar_11;
  vec4 tmpvar_12;
  tmpvar_12.w = 1.0;
  tmpvar_12.xyz = tmpvar_11;
  ret = tmpvar_12.xyz;
 }
