per_frame_init_1=b3 = 0;
per_frame_init_2=x1 = 0;
per_frame_init_3=meanbass_att = 0;
per_frame_init_4=g3 = 0;
per_frame_init_5=r1 = 0;
per_frame_init_6=g2 = 0;
per_frame_init_7=lastbeat = 0;
per_frame_init_8=x3 = 0;
per_frame_init_9=beatrate = 0;
per_frame_init_10=peakbass_att = 0;
per_frame_init_11=r2 = 0;
per_frame_init_12=framethird = 0;
per_frame_init_13=r3 = 0;
per_frame_init_14=x2 = 0;
per_frame_init_15=volume = 0;
per_frame_init_16=b2 = 0;
per_frame_init_17=beat = 0;
per_frame_init_18=g1 = 0;
per_frame_init_19=b1 = 0;
per_frame_1=warp = 0;
per_frame_2=framethird = mod(frame, 3);
per_frame_3=x1 = 0.5 + 0.15 * sin(0.416 * time) + 0.15 * sin(0.832 * time) + 0.1 * sin(1.324 * time);
per_frame_4=x2 = 0.5 + 0.15 * sin(0.341 * time) + 0.15 * sin(0.768 * time) + 0.1 * sin(1.523 * time);
per_frame_5=x3 = 0.5 + 0.15 * sin(0.287 * time) + 0.15 * sin(0.913 * time) + 0.1 * sin(1.142 * time);
per_frame_6=r1 = 0.5 + 0.15 * sin(0.512 * time) + 0.15 * sin(0.943 * time) + 0.1 * sin(1.024 * time);
per_frame_7=r2 = 0.5 + 0.15 * sin(0.483 * time) + 0.15 * sin(0.879 * time) + 0.1 * sin(1.423 * time);
per_frame_8=r3 = 0.5 + 0.15 * sin(0.531 * time) + 0.15 * sin(0.671 * time) + 0.1 * sin(1.442 * time);
per_frame_9=g1 = 0.5 + 0.15 * sin(0.248 * time) + 0.15 * sin(0.829 * time) + 0.1 * sin(1.623 * time);
per_frame_10=g2 = 0.5 + 0.15 * sin(0.461 * time) + 0.15 * sin(0.699 * time) + 0.1 * sin(1.254 * time);
per_frame_11=g3 = 0.5 + 0.15 * sin(0.397 * time) + 0.15 * sin(0.768 * time) + 0.1 * sin(1.157 * time);
per_frame_12=b1 = 0.5 + 0.15 * sin(0.211 * time) + 0.15 * sin(0.652 * time) + 0.1 * sin(1.865 * time);
per_frame_13=b2 = 0.5 + 0.15 * sin(0.333 * time) + 0.15 * sin(0.978 * time) + 0.1 * sin(1.359 * time);
per_frame_14=b3 = 0.5 + 0.15 * sin(0.475 * time) + 0.15 * sin(0.791 * time) + 0.1 * sin(1.011 * time);
per_frame_15=wave_x = if(0.00001 < abs(equal(framethird, 0)), x1, if(0.00001 < abs(equal(framethird, 1)), x2, x3));
per_frame_16=wave_r = if(0.00001 < abs(equal(framethird, 0)), r1, if(0.00001 < abs(equal(framethird, 1)), r2, r3));
per_frame_17=wave_g = if(0.00001 < abs(equal(framethird, 0)), g1, if(0.00001 < abs(equal(framethird, 1)), g2, g3));
per_frame_18=wave_b = if(0.00001 < abs(equal(framethird, 0)), b1, if(0.00001 < abs(equal(framethird, 1)), b2, b3));
per_frame_19=volume = 0.3 * (bass + mid);
per_frame_20=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_21=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_22=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_23=peakbass_att = max(bass_att, peakbass_att);
per_frame_24=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_25=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_26=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.99 * above(time - lastbeat, 2 * beatrate) + 0.998 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_27=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_28=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_29=dx = if(0.00001 < abs(beat), 1 - 2 * randint(2), 0);
per_frame_30=ob_a = if(0.00001 < abs(beat), 0, 0.65);
per_frame_31=mv_a = if(0.00001 < abs(beat), 1, 0.05);
per_pixel_1=dy = 0.004 + 0.0005 * sin(10 * x + 0.459 * time) + 0.0005 * sin(14 * x + 0.325 * time) + 0.0005 * sin(1.231 * time);
wave_3_init1=xs = 0;
wave_3_init2=ys = 0;
wave_3_init3=n2 = 0;
wave_3_per_point1=xs = sin(6.28 * sample);
wave_3_per_point2=ys = cos(6.28 * sample);
wave_3_per_point3=xs = 0.7 * xs + 0.5;
wave_3_per_point4=ys = 0.7 * ys + 0.5;
wave_3_per_point5=xs = min(xs, 0.958);
wave_3_per_point6=xs = max(xs, 0.042);
wave_3_per_point7=ys = min(ys, 0.988);
wave_3_per_point8=ys = max(ys, 0.012);
wave_3_per_point9=x = xs;
wave_3_per_point10=y = ys;
wave_3_per_point11=n2 = abs(6.283 * sample - 3.1415);
wave_3_per_point12=r = 0.5 * sin(n2 + time) + 0.5;
wave_3_per_point13=g = 0.5 * sin(n2 + 2.1 + time) + 0.5;
wave_3_per_point14=b = 0.5 * sin(n2 + 4.2 + time) + 0.5;
