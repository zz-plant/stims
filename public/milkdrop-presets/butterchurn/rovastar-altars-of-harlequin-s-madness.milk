per_frame_init_1=oldq4 = 0;
per_frame_init_2=ratio = 0;
per_frame_init_3=meanbass_att = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=oldq2 = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=mybeat2 = 0;
per_frame_init_9=mybeat = 0;
per_frame_init_10=oldq8 = 0;
per_frame_init_11=box = 0;
per_frame_init_12=lastbeat = 0;
per_frame_init_13=beatrate = 0;
per_frame_init_14=peakbass_att = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=oldflag = 0;
per_frame_init_17=oldq6 = 0;
per_frame_init_18=oldq7 = 0;
per_frame_init_19=oldq3 = 0;
per_frame_init_20=oldq5 = 0;
per_frame_init_21=volume = 0;
per_frame_init_22=beat = 0;
per_frame_init_23=oldratio = 0;
per_frame_init_24=q2 = 0;
per_frame_init_25=q3 = 0;
per_frame_init_26=q7 = 0;
per_frame_init_27=flag = 0;
per_frame_init_28=q8 = 0;
per_frame_init_29=q8 = 0;
per_frame_1=q8 = oldq8 + 0.001 * (pow(1.2 * bass + 0.4 * bass_att + 0.2 * treb + 0.2 * treb_att + 0.2 * mid + 0.2 * mid_att, 6) / fps) + 0.1 / fps;
per_frame_2=oldq8 = q8;
per_frame_3=ob_r = 0.3 - 0.3 * (0.5 * sin(0.701 * q8) + 0.3 * cos(0.438 * q8));
per_frame_4=ob_g = 0.6 - 0.4 * sin(2.924 * q8);
per_frame_5=ob_b = 0.35 - 0.3 * cos(0.816 * q8);
per_frame_6=warp = 0;
per_frame_7=ib_size = 0.02;
per_frame_8=ib_r = ib_r + 0.5 * sin(3.034 * q8);
per_frame_9=ib_g = ib_g + 0.5 * sin(2.547 * q8);
per_frame_10=ib_b = ib_b - 0.5 * sin(1.431 * q8);
per_frame_11=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_12=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_13=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_14=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_15=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_16=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_17=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_18=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_19=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_20=mybeat = if(0.00001 < abs(beat), mybeat + 1, mybeat);
per_frame_21=mybeat = if(0.00001 < abs(above(mybeat, 7)), 0, mybeat);
per_frame_22=mybeat2 = if(0.00001 < abs(equal(mybeat, 1)), 1, 0);
per_frame_23=q7 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq7);
per_frame_24=oldq7 = q7;
per_frame_25=q6 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq6);
per_frame_26=oldq6 = q6;
per_frame_27=q5 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq5);
per_frame_28=oldq5 = q5;
per_frame_29=q4 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq4);
per_frame_30=oldq4 = q4;
per_frame_31=flag = if(0.00001 < abs(beat * mybeat2), if(0.00001 < abs(randint(2) - 1), 1, 0), oldflag);
per_frame_32=oldflag = flag;
per_frame_33=ratio = if(0.00001 < abs(beat * mybeat2), 100 + randint(60), oldratio);
per_frame_34=oldratio = ratio;
per_frame_35=q3 = if(0.00001 < abs(beat * mybeat2), if(0.00001 < abs(flag), ratio, 0.75 * ratio), oldq3);
per_frame_36=oldq3 = q3;
per_frame_37=q2 = if(0.00001 < abs(beat * mybeat2), if(0.00001 < abs(flag), 0.75 * ratio, ratio), oldq2);
per_frame_38=oldq2 = q2;
per_pixel_1=box = 0.7 * sqrt(2) - rad + mod(0.5 * abs(3 * x - 0.4 * sin(q1)), 2) + mod(0.5 * abs(3 * y + 0.4 * sin(q1)), 2);
per_pixel_2=q1 = 8.3 + (sin(x + 0.137 * q8) - cos(y + 0.213 * q8));
per_pixel_3=zoom = if(0.00001 < abs(above(box, 1)), 0.1 * q1, zoom);
per_pixel_4=rot = if(0.00001 < abs(above(box, 1)), 0.1 * rad + sin(0.385 * q8), rot);
per_pixel_5=dx = if(0.00001 < abs(above(box, 1)), dx, q4 * sin((y - 0.5) * q3) + q5 * sin((y - 0.5) * q2));
per_pixel_6=dy = if(0.00001 < abs(above(box, 1)), dy, q6 * cos((x - 0.5) * q2) + q7 * cos((x - 0.5) * q3));
