per_frame_init_1=ang2 = 0;
per_frame_init_2=redsine = 0;
per_frame_init_3=greensine = 0;
per_frame_init_4=bluesine = 0;
per_frame_init_5=redif = 0;
per_frame_init_6=greenif = 0;
per_frame_init_7=blueif = 0;
per_frame_init_8=decay = 0.1;
per_frame_1=sx = 1;
per_frame_2=sy = 1;
per_frame_3=redsine = 0.5 + 0.15 * bass * sin(3 * time);
per_frame_4=greensine = 0.5 + 0.15 * mid * sin(2 * time);
per_frame_5=bluesine = 0.5 + 0.15 * treb * sin(time);
per_frame_6=redif = 0.9 * if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.98 * redif));
per_frame_7=greenif = 0.8 * if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.8 * greenif));
per_frame_8=blueif = 0.8 * if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.8 * blueif));
per_frame_9=ib_r = redif;
per_frame_10=ib_g = greenif;
per_frame_11=ib_b = blueif;
per_pixel_1=ang2 = sin(3 * ang + time + 0.05 * sin(time * above(mid_att, 1.2)));
per_pixel_2=rot = 1.2 * ang2;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (((texture (sampler_blur1, uv).xyz * scale1) + bias1) - texture (sampler_main, uv).xyz);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (mix (texture (sampler_main, uv).xyz, texture (sampler_main, (
    (vec2(-1.003, 1.003) * (uv - 0.5))
   + 0.5)).xyz, vec3(0.5, 0.5, 0.5)) * 2.4);
  ret_1 = (ret_1 * ret_1);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
