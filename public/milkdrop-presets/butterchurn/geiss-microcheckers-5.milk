[preset00]
fRating=0.000000
fDecay=0.990000
nWaveMode=6.000000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.063000
fWaveScale=1.881000
fWaveSmoothing=0.036000
fWaveParam=-0.040000
fModWaveAlphaStart=1.070000
fModWaveAlphaEnd=1.270000
fZoom=1.310000
fRot=0.200000
fWarp=0.384140
fWaveR=0.460000
fWaveG=0.650000
fWaveB=0.830000
fMotionVectorsA=0.000000
b1n=0.400000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=q2 = 0;
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(1.517 * time) + 0.4 * sin(1.58 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(1.088 * time) + 0.4 * sin(1.076 * time));
per_frame_3=wave_b = wave_b + 0.2 * (0.6 * sin(1.037 * time) + 0.4 * sin(0.922 * time));
per_frame_4=rot = rot + 0.02 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=q1 = cos(1.41 * time);
per_frame_8=q2 = time + 0.3 * sin(1.47 * time);

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (uv_orig * texsize.xy);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (texture (sampler_main, mix (uv, (
    ((uv_orig - 0.5) * 0.97)
   + 0.5), vec2(clamp (
    (2.0 * fract(((
      (tmpvar_1.x + tmpvar_1.y)
     * 0.5) + 0.25)))
  , 0.0, 1.0)))).xyz * (0.85 + (0.15 * 
    clamp ((rad * 5.0), 0.0, 1.0)
  )));
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (mix (vec3(dot (tmpvar_1.xyz, vec3(0.32, 0.49, 0.29))), tmpvar_1.xyz, vec3(3.0, 3.0, 3.0)) * 3.0);
  ret = tmpvar_2.xyz;
 }
