wave_2_per_point15=ay = ceny + (1 - central) * q4 * 0.02 * q4 * sin(angle + 0.12 * ceny);
wave_2_per_point16=az = cenz;
wave_2_per_point17=a = central * above(t8, 0) * 0.07;
wave_2_per_point18=ox = cenx + (ax - cenx) * t7 + (az - cenz) * t2;
wave_2_per_point19=oy = ay;
wave_2_per_point20=oz = cenz + (ax - cenx) * -t2 + (az - cenz) * t7;
wave_2_per_point21=ax = ox * t7 - (oz - q3) * t2;
