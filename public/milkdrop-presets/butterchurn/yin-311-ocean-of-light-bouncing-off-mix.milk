wave_2_per_point23=az = q3 + ox * t2 + (oz - q3) * t7;
wave_2_per_point24=oz = q3 + (az - q3) * cos(q6) - (ay - q2) * sin(q6);
wave_2_per_point25=oy = q2 + (az - q3) * sin(q6) + (ay - q2) * cos(q6);
