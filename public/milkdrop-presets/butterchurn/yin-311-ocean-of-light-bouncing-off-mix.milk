wave_2_per_point6=rr = 0.075 + 0.067 * abs(sin(6.2831 * ccy));
wave_2_per_point7=ccx = ccx * (1 - t6) + (t3 + rr * cos(6.2831 * sample + 4 * time)) * t6;
wave_2_per_point8=ccz = ccz * (1 - t6) + (t4 + rr * sin(6.2831 * sample + 4 * time)) * t6;
wave_2_per_point9=cenx = (1 - ns) * cenx + ns * q4 * ccx;
