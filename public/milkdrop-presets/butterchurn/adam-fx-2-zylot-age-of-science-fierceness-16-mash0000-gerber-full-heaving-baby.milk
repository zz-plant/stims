[preset00]
fRating=1.000000
nWaveMode=1.000000
fWaveAlpha=0.001000
fWaveScale=0.133000
fWaveParam=-0.380000
fWarpScale=1.331000
fZoom=0.999510
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.000000
fOuterBorderR=0.010000
fOuterBorderA=1.000000
fInnerBorderSize=0.000000
fInnerBorderA=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_thick=1.000000
wavecode_1_enabled=1.000000
wavecode_1_thick=1.000000
wavecode_2_enabled=1.000000
wavecode_2_thick=1.000000
wavecode_3_enabled=1.000000
wavecode_3_thick=1.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=star = 0;
per_frame_init_3=cdelay1 = 0;
per_frame_init_4=cdelay2 = 0;
per_frame_init_5=b1a = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=counter2 = 0;
per_frame_init_9=ib_bb = 0;
per_frame_init_10=musictime = 0;
per_frame_init_11=ib_rr = 0;
per_frame_init_12=q4 = 0;
per_frame_init_13=ypos = 0;
per_frame_init_14=colorcounter = 0;
per_frame_init_15=zm = 0;
per_frame_init_16=rd = 0;
per_frame_init_17=b1b = 0;
per_frame_init_18=ib_gg = 0;
per_frame_init_19=ag = 0;
per_frame_init_20=q2 = 0;
per_frame_init_21=counter1 = 0;
per_frame_init_22=q3 = 0;
per_frame_init_23=b1 = 0;
per_pixel_1=zoom = 0.91;
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_5=zm = 1;
per_pixel_6=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_7=star = sin(ag / 5) * (2 - rd) + 0.1 * pow(0.5 * tan(200.96 * rd) + 0.5, 2) + rd / 3;
per_pixel_8=star = min(star, 8);
per_pixel_9=star = max(star, -8);
per_pixel_10=zm = zm + star / 20;
per_pixel_11=sx = zm;
per_pixel_12=sy = zm;
per_pixel_13=rot = 0.1 * (above(rd, 0.7) / (rd + 7)) * bass_att / rd;
per_pixel_14=dx = 0.005 * sin(50 * x) * bass * ag;
per_pixel_15=dy = 0.005 * cos(50 * y) * bass * ag;
per_pixel_16=b1a = 0.13 * mid;
per_pixel_17=b1b = 0.12 * (bass + mid + treb);
per_pixel_18=b1 = 1.1 * b1b * rd * rd * rd * rd;
per_pixel_19=zoom = 0.97 + 0.1 * b1;
wave_0_per_frame1=r = 0.8 + 0.2 * sin(1.444 * time);
wave_0_per_frame2=g = 0.8 + 0.2 * sin(1.2233 * time);
wave_0_per_frame3=b = 0.8 + 0.2 * sin(1.332211 * time);
wave_0_per_point1=x = 0.5 + 3 * sin(20 * sample) * value1;
wave_0_per_point2=y = 0.5 + 3 * cos(20 * sample) * value2;
wave_1_init1=tme = 0;
wave_1_init2=tme = 0;
wave_1_per_point1=tme = tme + 0.5 * bass;
wave_1_per_point2=x = 0.5 + 0.24 * sin(6.2831852 * sample);
wave_1_per_point3=y = 0.5 + 0.24 * cos(6.2831852 * sample);
wave_1_per_point4=r = sin(20 * sample + 0.0002 * tme);
wave_1_per_point5=g = 0;
wave_1_per_point6=b = 0;
wave_1_per_point7=a = 0.5 + sin(20 * sample + 0.0002 * tme);
wave_1_per_point8=a = if(0.00001 < abs(below(a, 0)), 0, a);
wave_2_init1=tme = 0;
wave_2_init2=tme = 0;
wave_2_per_point1=tme = tme + 0.5 * treb;
wave_2_per_point2=x = 0.5 + 0.241 * sin(6.2831852 * sample);
wave_2_per_point3=y = 0.5 + 0.241 * cos(6.2831852 * sample);
wave_2_per_point4=r = 0;
wave_2_per_point5=g = sin(20 * sample + 0.0002 * tme);
wave_2_per_point6=b = 0;
wave_2_per_point7=a = 0.5 + sin(20 * sample + 0.0002 * tme);
wave_2_per_point8=a = if(0.00001 < abs(below(a, 0)), 0, a);
wave_3_init1=tme = 0;
wave_3_per_point1=tme = tme + 0.5 * mid;
wave_3_per_point2=x = 0.5 + 0.242 * sin(6.2831852 * sample);
wave_3_per_point3=y = 0.5 + 0.242 * cos(6.2831852 * sample);
wave_3_per_point4=r = 0;
wave_3_per_point5=g = 0;
wave_3_per_point6=b = sin(20 * sample + 0.0002 * tme);
wave_3_per_point7=a = 0.5 + sin(20 * sample + 0.0002 * tme);
wave_3_per_point8=a = if(0.00001 < abs(below(a, 0)), 0, a);

[comp_shader]
uniform sampler2D sampler_smalltiled_electric_nebula;
 shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec2 tmpvar_2;
  tmpvar_2.x = ((uv.x + 0.5) + q1);
  tmpvar_2.y = ((uv.y + 0.5) + q2);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = mix ((texture (sampler_smalltiled_electric_nebula, (
    (tmpvar_2 * texsize.xy)
   * texsize_smalltiled_electric_nebula.zw)).xyz * (
    ((bass + mid) + treb)
   * 0.5)), tmpvar_1.xyz, (tmpvar_1.xyz * 2.5));
  ret = tmpvar_3.xyz;
 }
