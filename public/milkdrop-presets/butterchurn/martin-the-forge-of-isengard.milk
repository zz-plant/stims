  xlat_mutableret1 = (texture (sampler_noise_hq, (xlat_mutablers / 2.0)).xyz - 0.54);
  float tmpvar_5;
  tmpvar_5 = clamp ((32.0 * tmpvar_3.y), 0.0, 1.0);
  vec2 tmpvar_6;
