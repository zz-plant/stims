per_frame_30=q25 = q24;
per_frame_31=t_rel = 8 * time;
per_frame_32=p3 = p3 * dec_med + (1 - dec_med) * (100 * index + 0 * q26);
per_frame_33=q30 = p3;
per_frame_34=p4 = dec_med * p4 + (1 - dec_med) * q27;
per_frame_35=q31 = p4;
per_frame_36=zoom = 1;
