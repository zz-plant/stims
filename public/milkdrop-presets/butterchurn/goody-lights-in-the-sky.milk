wave_2_per_point2=sty = 0.5 - 0.01 * sin(0.45 * time + mid_att);
wave_2_per_point3=mvx = stx - 0.01 * cos(1.33 * time) + 0.001 * sin(bass);
wave_2_per_point4=mvy = sty + 0.01 * sin(0.87 * time) + 0.001 * sin(treb);
wave_2_per_point5=x = mvx + 0.05 * abs(sin(y * bass) * x + pow(cos(x * y * treb), bass_att)) * sin(y + 1.43 * time);
wave_2_per_point6=y = mvy + 0.05 * abs(cos(x * treb) * y + pow(cos(y * x * bass), treb_att)) * cos(x + 1.54 * time);
