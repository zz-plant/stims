wave_0_per_point1=stx = 0.5 + 0.05 * sin(0.22 * time + 0.05 * treb_att);
wave_0_per_point2=sty = 0.5 + 0.05 * cos(0.15 * time + 0.05 * treb_att);
wave_0_per_point3=mvx = stx + 0.05 * cos(time) + 0.05 * sin(bass);
wave_0_per_point4=mvy = sty + 0.05 * sin(time) + 0.05 * cos(treb);
wave_0_per_point5=x = mvx + 0.1 * abs(sin(y * bass) * x + pow(cos(x * y * treb), bass_att)) * sin(y + time);
wave_0_per_point6=y = mvy + 0.1 * abs(cos(x * treb) * y + pow(cos(y * x * bass), treb_att)) * cos(x + time);
