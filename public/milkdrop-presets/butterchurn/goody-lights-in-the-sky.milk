per_frame_init_1=q4 = 0;
per_frame_init_2=q5 = 0;
per_frame_init_3=decay = 0.1;
per_frame_1=sx = 1;
per_frame_2=sy = 1;
per_frame_3=q4 = 0.5 + 0.05 * cos(0.52 * time) * cos(0.39 * time);
per_frame_4=q5 = 0.5 + 0.05 * sin(0.44 * time) * cos(0.71 * time);
per_pixel_1=zoom = zoom + 0.01 + 0.75 * rad * treb_att;
