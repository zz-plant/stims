wave_0_init9=newy = 0;
wave_0_per_frame1=q1 = 0.5;
wave_0_per_frame2=q2 = 0.5;
wave_0_per_frame3=q3 = 0;
wave_0_per_frame4=a = q7;
wave_0_per_point1=temp1 = 1 - temp1;
wave_0_per_point2=newx = 0.1 * value1;
wave_0_per_point3=newy = 0.1 * value2;
wave_0_per_point4=s1 = above(temp1, 0.5);
wave_0_per_point5=s2 = 1 - s1;
wave_0_per_point6=s1 = s1 + (1 - s1) * below(q3, 0.5);
wave_0_per_point7=s2 = s2 + (1 - s2) * below(q3, 0.5);
wave_0_per_point8=s1 = 0.97 * s1 + 0.015;
wave_0_per_point9=s2 = 0.97 * s2 + 0.015;
wave_0_per_point10=x = q1 + newx;
wave_0_per_point11=y = q2 + newy;
wave_0_per_point12=q1 = x;
wave_0_per_point13=q2 = y;
wave_0_per_point14=q3 = q3 + 1;
shape_0_init1=ang2 = 0;
shape_0_init2=rad2 = 0;
shape_0_init3=rad2 = 0;
shape_0_init4=ang2 = 0;
shape_0_init5=q11 = 0;
shape_0_init6=rad2 = 0;
shape_0_init7=ang2 = 0;
