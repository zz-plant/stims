per_frame_init_12=q11 = 0;
per_frame_init_13=q4 = 0;
per_frame_init_14=min_att = 0;
per_frame_init_15=beat = 0;
per_frame_init_16=decay_to = 0;
per_frame_init_17=q2 = 0;
per_frame_init_18=q14 = 0;
per_frame_init_19=q3 = 0;
per_frame_init_20=beat_level = 0;
per_frame_init_21=q7 = 0;
per_frame_init_22=q3 = 0.5 + 0.006 * randint(100);
per_frame_init_23=q4 = 0.01 * randint(100);
per_frame_init_24=q5 = 0.01 * randint(100);
per_frame_1=wave_r = wave_r + 0.2 * (0.6 * sin(1.517 * time) + 0.4 * sin(1.58 * time));
per_frame_2=wave_g = wave_g + 0.2 * (0.6 * sin(1.088 * time) + 0.4 * sin(1.076 * time));
per_frame_3=wave_b = wave_b + 0.2 * (0.6 * sin(1.037 * time) + 0.4 * sin(0.922 * time));
per_frame_4=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=zoom = zoom + 0.037 * (0.38 * sin(0.157 * time + 1) + 0.62 * sin(0.1184 * time + 5));
per_frame_6=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_7=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_8=q1 = cos(1.41 * time);
per_frame_9=q2 = time + 0.3 * sin(1.47 * time);
per_frame_10=rg = max(0.77 * rg, 0.02 + 0.5 * min(2, 1.3 * max(0, mid_att - 1)));
per_frame_11=q9 = rg * above(rg, 2 * rg2);
per_frame_12=rg2 = max(rg, 0.8 * rg2);
per_frame_13=monitor = q9;
per_frame_14=q11 = aspectx;
per_frame_15=q12 = aspecty;
per_frame_16=q13 = wave_r;
per_frame_17=q14 = wave_g;
per_frame_18=q15 = wave_b;
per_frame_19=min_att = 2.5;
per_frame_20=decay_to = 0.8;
per_frame_21=decay_rate = pow(0.998, fps);
per_frame_22=beat = bass / max(min_att, bass_att);
per_frame_23=beat = max(beat, mid / max(min_att, mid_att));
per_frame_24=beat = max(beat, treb / max(min_att, treb_att));
per_frame_25=beat = max(beat, (prev_beat - decay_to) * decay_rate + decay_to);
per_frame_26=beat_level = 24 * (beat - prev_beat - 0.07);
per_frame_27=is_beat = above(beat_level, 0.5);
per_frame_28=warp = 22 * (beat - prev_beat);
per_frame_29=q7 = 32 * (beat - prev_beat - 0.08);
per_frame_30=prev_beat = beat;
per_pixel_1=dx = 0.02 * cos(x * pixelsx * aspectx * q3 * 0.1 + 6.28 * q4);
per_pixel_2=dy = 0.02 * cos(y * pixelsy * aspecty * q3 * 0.1 + 6.28 * q5);
wave_0_init1=q1 = 0;
wave_0_init2=newx = 0;
wave_0_init3=temp1 = 0;
wave_0_init4=q2 = 0;
wave_0_init5=q3 = 0;
wave_0_init6=s1 = 0;
wave_0_init7=s2 = 0;
