shape_0_init9=q9 = 0;
shape_0_init10=q9 = 0;
shape_0_init11=q15 = 0;
shape_0_init12=q14 = 0;
shape_0_init13=q13 = 0;
shape_0_per_frame1=ang2 = 6.28 * (instance / num_inst) + time;
shape_0_per_frame2=rad2 = 0.1;
shape_0_per_frame3=x = 0.5 + rad2 * cos(ang2) * q11;
shape_0_per_frame4=y = 0.5 + rad2 * sin(ang2) * q12;
shape_0_per_frame5=a = a * q9;
shape_0_per_frame6=a2 = a2 * q9;
shape_0_per_frame7=rad = 0.08;
shape_0_per_frame8=r = q15;
shape_0_per_frame9=g = q14;
shape_0_per_frame10=b = q13;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * (0.8 + (0.17 * 
    clamp ((rad * 5.0), 0.0, 1.0)
  )));
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 1.8);
  ret = tmpvar_1.xyz;
 }
