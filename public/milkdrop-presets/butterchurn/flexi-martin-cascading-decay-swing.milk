per_frame_init_45=q8 = 0;
per_frame_1=ib_r = 0.3 * sin(5 * time) + 0.7;
per_frame_2=ib_g = 0.3 * sin(4 * time) + 0.3;
per_frame_3=ib_b = 0.5 * sin(4 * (time / 3)) + 0.5;
per_frame_4=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_5=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_6=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_7=x1 = 0.5 + 2 * (xx1 - xx2);
per_frame_8=y1 = 0.4 + yy1;
per_frame_9=x1 = max(0, min(1, x1));
per_frame_10=y1 = max(0, min(1, y1));
per_frame_11=spring = 10;
per_frame_12=grav = 0.5;
per_frame_13=resist = 1;
per_frame_14=bounce = 0.75;
per_frame_15=dt = 0.0002 * (60 / fps);
per_frame_16=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_17=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_18=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_19=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_20=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_21=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_22=x2 = x2 + vx2;
per_frame_23=y2 = y2 + vy2;
per_frame_24=x3 = x3 + vx3;
per_frame_25=y3 = y3 + vy3;
per_frame_26=x4 = x4 + vx4;
per_frame_27=y4 = y4 + vy4;
per_frame_28=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_29=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_30=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_31=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_32=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_33=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_34=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_35=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_36=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_37=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_38=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_39=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_40=q4 = x4;
per_frame_41=q8 = y4;
per_frame_42=q1 = aspectx;
per_frame_43=q2 = aspecty;
per_frame_44=zoom = 1;
per_frame_45=warp = 0;
per_frame_46=bb = 0.99 * bb + 0.02 * bass;
per_frame_47=mm = 0.99 * mm + 0.02 * mid;
per_frame_48=tt = 0.99 * tt + 0.02 * treb;
per_frame_49=mx = max(max(bb, mm), tt);
per_frame_50=mn = min(min(bb, mm), tt);
per_frame_51=ob_r = (bb - mn) / (mx - mn);
per_frame_52=ob_b = (mm - mn) / (mx - mn);
per_frame_53=ob_g = (tt - mn) / (mx - mn);
per_frame_54=q6 = atan2(vx4, vy4);
per_frame_55=q5 = sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_56=a = 0.95 * a + q5;
per_frame_57=s = 0.9 * s + a;
per_frame_58=q3 = 0.1 * s;
per_frame_59=monitor = s;
per_frame_60=wave_a = 0;
per_pixel_1=x = 0.5 + (x - 0.5) * q1;
per_pixel_2=y = 0.5 + (y - 0.5) * q2;
per_pixel_3=dir = -q6 + 0 * asin(1);
per_pixel_4=b1 = 0.1;
per_pixel_5=m1 = 25 * q5;
per_pixel_6=t1 = 0.05;
per_pixel_7=xx = q4;
per_pixel_8=yy = 1 - q8;
per_pixel_9=dx = 0;
per_pixel_10=dy = 0;
per_pixel_11=d = sqrt((x - xx) * (x - xx) + (y - yy) * (y - yy));
per_pixel_12=r = 0.05;
per_pixel_13=v = -35 * q5;
per_pixel_14=dx = v * sin(dir) * (r - d) * (1 - sigmoid(d - r, 200)) * q2;
per_pixel_15=dy = v * cos(dir) * (r - d) * (1 - sigmoid(d - r, 200)) * q1;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  tmpvar_1.xyz = ((texture (sampler_main, clamp (
    (uv - (((vec2(0.0, 32.0) * texsize.zw) * dot (
      (tmpvar_2.xyz - 0.35)
    , vec3(0.32, 0.49, 0.29))) * (dot (tmpvar_2.xyz, vec3(0.32, 0.49, 0.29)) - 0.4)))
  , 0.0, 1.0)).xyz - 0.0011) + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 1.5)) + rand_frame.xy)
  ) - 0.5) * 0.0038).xyz);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv1_1;
  vec2 tmpvar_2;
  tmpvar_2.y = 0.0;
  tmpvar_2.x = texsize.z;
  vec2 tmpvar_3;
  tmpvar_3.x = 0.0;
  tmpvar_3.y = texsize.w;
  vec2 tmpvar_4;
  tmpvar_4.x = (texture (sampler_main, (uv - tmpvar_2)).xyz - texture (sampler_main, (uv + tmpvar_2)).xyz).x;
  tmpvar_4.y = (texture (sampler_main, (uv - tmpvar_3)).xyz - texture (sampler_main, (uv + tmpvar_3)).xyz).x;
  uv1_1 = ((0.3 * cos(
    ((uv - 0.5) * 2.0)
  )) - tmpvar_4);
  float tmpvar_5;
  tmpvar_5 = clamp ((0.04 / sqrt(
    dot (uv1_1, uv1_1)
  )), 0.0, 1.0);
  uv1_1 = ((0.3 * cos(
    (uv1_1 * 12.0)
  )) - (9.0 * tmpvar_4));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (tmpvar_5 + ((texture (sampler_main, uv).xyz * 12.0) * vec3(clamp (
    (0.04 / sqrt(dot (uv1_1, uv1_1)))
  , 0.0, 1.0))));
  ret = tmpvar_6.xyz;
 }
