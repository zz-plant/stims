wave_2_per_point17=x = 0.5 + 0.5 * (x4 / (1 + 0.5 * z4));
wave_2_per_point18=y = 0.5 + 0.5 * (y4 / (1 + 0.5 * z4));
wave_2_per_point19=r = -0.5 + sin(5 * sample + (5 * time + 9));
wave_2_per_point20=r = if(0.00001 < abs(below(r, 0)), 0, r);
