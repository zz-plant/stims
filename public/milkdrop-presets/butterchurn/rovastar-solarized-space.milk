[preset00]
fRating=0.000000
fGammaAdj=1.994000
fDecay=0.960000
bDarkenCenter=1.000000
bBrighten=1.000000
bSolarize=1.000000
bInvert=1.000000
fWaveAlpha=1.882469
fWaveScale=0.000000
fWaveSmoothing=0.630000
fWaveParam=-0.500000
fShader=1.000000
fSx=0.980296
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderSize=0.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.001500
fInnerBorderR=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=beateven = 0;
per_frame_init_2=xpos = 0;
per_frame_init_3=yamptarg = 0;
per_frame_init_4=ydir = 0;
per_frame_init_5=meanbass_att = 0;
per_frame_init_6=myx = 0;
per_frame_init_7=myy = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=lastbeat = 0;
per_frame_init_10=beatrate = 0;
per_frame_init_11=mode = 0;
per_frame_init_12=peakbass_att = 0;
per_frame_init_13=xamptarg = 0;
per_frame_init_14=xamp = 0;
per_frame_init_15=xspeed = 0;
per_frame_init_16=beatcounter = 0;
per_frame_init_17=ypos = 0;
per_frame_init_18=volume = 0;
per_frame_init_19=beat = 0;
per_frame_init_20=vol = 0;
per_frame_init_21=yamp = 0;
per_frame_init_22=xdir = 0;
per_frame_init_23=yspeed = 0;
per_frame_1=warp = 0;
per_frame_2=wave_mystery = -0.5;
per_frame_3=vol = 0.167 * (bass + mid);
per_frame_4=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_5=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_6=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_7=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_8=xpos = xpos + 0.001 * xspeed;
per_frame_9=myx = 1.25 * xpos + 0.5;
per_frame_10=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_11=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_12=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_13=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_14=ypos = ypos + 0.001 * yspeed;
per_frame_15=myy = 1.25 * ypos + 0.5;
per_frame_16=cx = 0.5 + 0.05 * sin(0.497 * time);
per_frame_17=cy = 0.5 + 0.05 * sin(0.413 * time);
per_frame_18=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_19=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_20=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_21=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_22=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_23=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_24=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_25=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_26=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_27=peakbass_att = max(if(0.00001 < abs(beat), bass_att, peakbass_att), 1.1 * meanbass_att);
per_frame_28=beatcounter = if(0.00001 < abs(above(beat, 0)), beatcounter + 1, beatcounter);
per_frame_29=beatcounter = if(0.00001 < abs(above(beatcounter, 8)), 0, beatcounter);
per_frame_30=beateven = mod(beatcounter, 4);
per_frame_31=mode = if(0.00001 < abs(beat), mod(mode + randint(3) + 1, 4), mode);
per_frame_32=beateven = if(0.00001 < abs(equal(beateven, 3)), -1, beateven);
per_frame_33=beateven = if(0.00001 < abs(equal(beateven, 0)), 0.1 * (myx + myy), beateven);
per_frame_34=beateven = if(0.00001 < abs(equal(beateven, 2)), 0.1 * (-myx - myy), beateven);
per_frame_35=dx = 0.1 * beateven * myx;
per_frame_36=dy = 0.1 * beateven * myy;
per_frame_37=monitor = beateven;
per_frame_38=wave_a = bass_thresh;
per_frame_39=zoom = 1.5 + 0.25 * myy;
per_frame_40=rot = myx * beateven;
per_frame_41=wave_x = 0.5 + 0.05 * myx;
per_frame_42=wave_y = 0.5 + 0.05 * myy;
