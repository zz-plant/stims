shape_1_per_frame1=t1 = time - floor(time);
shape_1_per_frame2=sample = instance / num_inst;
shape_1_per_frame3=t_abs = 3 * sample;
shape_1_per_frame4=t_rel = sample - time / 5;
shape_1_per_frame5=ampl = 2 * t_abs / 2;
shape_1_per_frame6=k1 = sin(time / 13);
shape_1_per_frame7=k2 = sin(time / 12);
shape_1_per_frame8=ox = ampl * sin(t_abs * (31 + 5 * k1)) + sin(time / 25) * (1 - t_abs) * 0.4;
shape_1_per_frame9=oy = ampl * cos(t_abs * (31 + 5 * k2));
shape_1_per_frame10=oz = -1;
shape_1_per_frame11=r = sqr(sin(3.4 * t_rel));
shape_1_per_frame12=g = sqr(sin(t_rel));
shape_1_per_frame13=b = sqr(cos(1.8 * t_rel));
shape_1_per_frame14=xang = time / 9.5;
shape_1_per_frame15=yang = 0 * time / 7;
shape_1_per_frame16=zang = -time / 22;
shape_1_per_frame17=fov = 0.5;
shape_1_per_frame18=mx = ox * cos(zang) - oy * sin(zang);
shape_1_per_frame19=my = ox * sin(zang) + oy * cos(zang);
shape_1_per_frame20=ox = mx;
shape_1_per_frame21=oy = my;
shape_1_per_frame22=mx = ox * cos(yang) + oz * sin(yang);
shape_1_per_frame23=mz = -ox * sin(yang) + oz * cos(yang);
shape_1_per_frame24=ox = mx;
shape_1_per_frame25=oz = mz;
shape_1_per_frame26=my = oy * cos(xang) - oz * sin(xang);
shape_1_per_frame27=mz = oy * sin(xang) + oz * cos(xang);
shape_1_per_frame28=oy = my;
shape_1_per_frame29=oz = mz;
shape_1_per_frame30=oz = oz - 6;
shape_1_per_frame31=x = ox * fov / oz + 0.5;
shape_1_per_frame32=y = oy * fov / oz + 0.5;
shape_1_per_frame33=a = 0.5 * (1 / mz);
shape_1_per_frame34=rad = 0.005 * (1 / mz);
