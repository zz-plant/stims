per_frame_init_1=q1 = 0;
per_frame_init_2=q8 = 0;
per_frame_init_3=oldq8 = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_init_5=q5_residual = 0;
per_frame_init_6=q6_residual = 0;
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.1 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.1 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=mv_r = wave_r;
per_frame_5=mv_b = wave_b;
per_frame_6=mv_g = wave_g;
per_frame_7=q8 = oldq8 + 0.0003 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_8=oldq8 = q8;
per_frame_9=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_10=q5_residual = 0.0064 * equal(bass_thresh, 2) * sin(5 * q8) + (1 - equal(bass_thresh, 2)) * q5_residual;
per_frame_11=q6_residual = 0.0048 * equal(bass_thresh, 2) * sin(6 * q8) + (1 - equal(bass_thresh, 2)) * q6_residual;
per_frame_12=dx = q5_residual;
per_frame_13=dy = q6_residual;
per_frame_14=q1 = 0.03 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_15=monitor = q1;
per_frame_16=mv_a = bass - 1.2;
per_pixel_1=zoom = 0.9 + 0.1 * q1 + 0.1 * rad;
per_pixel_2=zoomexp = 2 * zoom;
shape_0_init1=val = 0;
shape_0_init2=val = 0;
shape_0_init3=val = 0;
shape_0_per_frame1=ang = 0.5 * sin(time) + 0.5;
shape_0_per_frame2=val = 3;
shape_0_per_frame3=a2 = 0.33 * val;
shape_0_per_frame4=a = 0.33 * val;
shape_0_per_frame5=rad = 0.4 * cos(0.3 * time) + 0.65;
shape_0_per_frame6=x = 0.25 * sin(0.25 * time) + 0.5;
shape_0_per_frame7=y = 0.25 * cos(0.45 * time) + 0.5;
shape_1_init1=val = 0;
shape_1_init2=val = 0;
shape_1_init3=val = 0;
shape_1_per_frame1=ang = 0.5 * cos(0.3 * time) + 0.5;
shape_1_per_frame2=val = 3;
shape_1_per_frame3=a2 = 0.33 * val;
shape_1_per_frame4=a = 0.33 * val;
shape_1_per_frame5=rad = 0.4 * sin(0.3 * time) + 0.65;
shape_1_per_frame6=x = 0.25 * cos(0.25 * time) + 0.5;
shape_1_per_frame7=y = 0.25 * sin(0.45 * time) + 0.5;
shape_2_init1=h2 = 0;
shape_2_init2=h2 = 0;
shape_2_init3=vr = 0;
shape_2_init4=h2 = 0;
shape_2_init5=vg = 0;
shape_2_init6=h2 = 0;
shape_2_init7=vb = 0;
shape_2_init8=h2 = 0;
shape_2_init9=vg = 0;
shape_2_init10=vr = 0;
shape_2_init11=vb = 0;
shape_2_init12=dist = 0;
shape_2_init13=maat = 0;
shape_2_init14=maat = 0;
shape_2_init15=maat = 0;
shape_2_init16=maat = 0;
shape_2_init17=maat = 0;
shape_2_init18=maat = 0;
shape_2_init19=maat = 0;
shape_2_init20=dist = 0;
shape_2_init21=dist = 0;
shape_2_init22=maat = 0;
shape_2_init23=maat = 0;
shape_2_init24=dist = 0;
shape_2_init25=dist = 0;
shape_2_per_frame1=h2 = h2 + 0.8 * above(treb, 1.32) * 0.9;
shape_2_per_frame2=vr = 0.5 * sin(0.8 * h2) + 0.5;
shape_2_per_frame3=vg = 0.5 * sin(0.5 * h2) + 0.5;
shape_2_per_frame4=vb = 0.5 * sin(0.1 * h2) + 0.5;
shape_2_per_frame5=g = vg;
shape_2_per_frame6=r = vr;
shape_2_per_frame7=b = vb;
shape_2_per_frame8=g2 = g;
shape_2_per_frame9=r2 = r;
shape_2_per_frame10=b2 = b;
shape_2_per_frame11=dist = 0.01 * mod(frame, 100);
shape_2_per_frame12=maat = maat + above(bass_att, 1.5);
shape_2_per_frame13=maat = maat * below(maat, 16);
shape_2_per_frame14=x = if(0.00001 < abs(below(maat, 8)), if(0.00001 < abs(below(maat, 4)), dist, 1 - dist), x);
shape_2_per_frame15=y = if(0.00001 < abs(above(maat, 8)), if(0.00001 < abs(above(maat, 4)), dist, 1 - dist), y);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (tmpvar_2.xyz - (tmpvar_2.xyz * 0.5));
  ret_1 = ((ret_1 * abs(
    (((texture (sampler_blur2, uv).xyz * scale2) + bias2) - 0.5)
  )) * 5.0);
  ret_1 = (ret_1 - 0.01);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 5.0);
  ret_1 = (ret_1 + 1.2);
  vec3 tmpvar_2;
  tmpvar_2.x = (1.0 + (0.2 * sin(time)));
  tmpvar_2.y = (1.0 + (0.2 * sin(
    (time * 0.2233333)
  )));
  tmpvar_2.z = (1.0 + (0.2 * sin(
    (time * 0.733467)
  )));
  ret_1 = ((ret_1 * (
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1).x) * tmpvar_2);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
