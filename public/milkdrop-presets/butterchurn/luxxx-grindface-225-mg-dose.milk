shape_2_per_frame2=x = 0.5 + 0.225 * sin(time + 2.09);
shape_2_per_frame3=y = 0.5 + 0.3 * cos(time + 2.09);
shape_2_per_frame4=rad = rad * bass_att;
shape_2_per_frame5=r = 0.5 + 0.5 * sin(0.5 * frame);
shape_2_per_frame6=b = 0.5 + 0.5 * sin(0.5 * frame + 2.094);
shape_2_per_frame7=g = 0.5 + 0.5 * sin(0.5 * frame + 4.188);
shape_3_per_frame1=x = 0.5 + 0.5 * (0.3 * sin(1.1 * time) + 0.7 * sin(0.5 * time));
shape_3_per_frame2=x = 0.5 + 0.225 * sin(time + 4.19);
shape_3_per_frame3=y = 0.5 + 0.3 * cos(time + 4.19);
shape_3_per_frame4=rad = rad * treb_att;
shape_3_per_frame5=r = 0.5 + 0.5 * sin(0.5 * frame);
shape_3_per_frame6=b = 0.5 + 0.5 * sin(0.5 * frame + 2.094);
shape_3_per_frame7=g = 0.5 + 0.5 * sin(0.5 * frame + 4.188);

[warp_shader]
shader_body { 
  vec3 z_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = mix (uv_orig, uv, vec2(0.2, 0.2));
  vec4 tmpvar_4;
  tmpvar_4 = texture (sampler_main, tmpvar_3);
  float tmpvar_5;
  tmpvar_5 = ((tmpvar_4.x * tmpvar_4.y) * tmpvar_4.y);
  z_1.x = (tmpvar_4.x + ((
    (-(tmpvar_5) + (0.035 * (1.0 - tmpvar_4.x)))
   + 0.0007) * 9.0));
  z_1.y = (tmpvar_4.y + ((tmpvar_5 - 
    (0.095 * tmpvar_4.y)
  ) * 9.0));
  z_1.z = (tmpvar_4.z - 0.02);
  vec2 tmpvar_6;
  tmpvar_6 = (0.3 * texsize.zw);
  z_1.x = (z_1.x + (1.8 * (
    (0.25 * (((texture (sampler_main, 
      (tmpvar_3 + tmpvar_6)
    ).xyz + texture (sampler_main, 
      (tmpvar_3 + (tmpvar_6 * vec2(-1.0, 1.0)))
    ).xyz) + texture (sampler_main, (tmpvar_3 + 
      (tmpvar_6 * vec2(1.0, -1.0))
    )).xyz) + texture (sampler_main, (tmpvar_3 - tmpvar_6)).xyz))
   - texture (sampler_main, tmpvar_3).xyz)).x);
  ret_2.yz = z_1.yz;
  ret_2.x = (z_1.x + (0.09 * (
    (texture (sampler_noise_lq, (((uv * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz * 2.0)
   - 1.0)).x);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_2;
  ret = tmpvar_7.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur2, uv_1).xyz * scale2) + bias2)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 0.65);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
