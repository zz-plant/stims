per_frame_init_1=ying = 0;
per_frame_init_2=bblock = 0;
per_frame_init_3=yin = 0;
per_frame_init_4=yang = 0;
per_frame_init_5=grid = 0;
per_frame_init_6=q6 = 0;
per_frame_init_7=snee = 0;
per_frame_init_8=q1 = 0;
per_frame_init_9=q5 = 0;
per_frame_init_10=mytime = 0;
per_frame_init_11=tth = 0;
per_frame_init_12=tblock = 0;
per_frame_init_13=bpulse = 0;
per_frame_init_14=pulse = 0;
per_frame_init_15=mblock = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=snur = 0;
per_frame_init_18=mpulse = 0;
per_frame_init_19=mod_state = 0;
per_frame_init_20=bth = 0;
per_frame_init_21=mres = 0;
per_frame_init_22=prev_bass = 0;
per_frame_init_23=tpulse = 0;
per_frame_init_24=tres = 0;
per_frame_init_25=le = 0;
per_frame_init_26=beat = 0;
per_frame_init_27=ccl = 0;
per_frame_init_28=q2 = 0;
per_frame_init_29=bres = 0;
per_frame_init_30=q3 = 0;
per_frame_init_31=mth = 0;
per_frame_init_32=q7 = 0;
per_frame_init_33=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=le = 1.5 + 2 * sin(bass_att);
per_frame_3=bpulse = band(above(le, bth), above(le - bth, bblock));
per_frame_4=bblock = le - bth;
per_frame_5=bth = if(0.00001 < abs(above(le, bth)), le + 114 / (le + 10) - 7.407, bth + 0.07 * bth / (bth - 12) + 0.1 * below(bth, 2.7) * (2.7 - bth));
per_frame_6=bth = if(0.00001 < abs(above(bth, 6)), 6, bth);
per_frame_7=bres = bpulse * sin(pulse + 0.5 * le) + bnot(bpulse) * bres;
per_frame_8=le = 1.5 + 2 * sin(treb_att);
per_frame_9=tpulse = band(above(le, tth), above(le - tth, tblock));
per_frame_10=tblock = le - tth;
per_frame_11=tth = if(0.00001 < abs(above(le, tth)), le + 114 / (le + 10) - 7.407, tth + 0.07 * tth / (tth - 12) + 0.1 * below(tth, 2.7) * (2.7 - tth));
per_frame_12=tth = if(0.00001 < abs(above(tth, 6)), 6, tth);
per_frame_13=tres = tpulse * sin(pulse + 0.5 * le) + bnot(tpulse) * tres;
per_frame_14=le = 1.5 + 2 * sin(mid_att);
per_frame_15=mpulse = band(above(le, mth), above(le - mth, mblock));
per_frame_16=mblock = le - mth;
per_frame_17=mth = if(0.00001 < abs(above(le, mth)), le + 114 / (le + 10) - 7.407, mth + 0.07 * mth / (mth - 12) + 0.1 * below(mth, 2.7) * (2.7 - mth));
per_frame_18=mth = if(0.00001 < abs(above(mth, 6)), 6, mth);
per_frame_19=mres = mpulse * sin(pulse + 0.5 * le) + bnot(mpulse) * mres;
per_frame_20=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.003 * (bth + mth + tth));
per_frame_21=q1 = bres;
per_frame_22=q2 = tres;
per_frame_23=q3 = mres;
per_frame_24=q4 = sin(pulse);
per_frame_25=mod_state = (above(q1, 0) + above(q2, 0) + above(q3, 0)) * (1 + above(q4, 0));
per_frame_26=ccl = ccl + tpulse + mpulse - bpulse;
per_frame_27=q5 = cos(pulse * (0.5 + 0.1 * mod_state));
per_frame_28=q6 = sin(pulse * (0.5 + pow(0.25, mod_state)));
per_frame_29=q7 = mod_state;
per_frame_30=q8 = ccl;
per_frame_31=beat = if(0.00001 < abs(equal(bres, prev_bass)), 0, 1);
per_frame_32=prev_bass = bres;
per_frame_33=ying = if(0.00001 < abs(below(ying, 1)), 1, ying);
per_frame_34=ying = if(0.00001 < abs(beat), ying + bnot(mod(10 * time, 3)), ying);
per_frame_35=yin = mod(ying, 2);
per_frame_36=mytime = pulse * ying;
per_frame_37=ib_size = 0.02;
per_frame_38=ib_g = if(0.00001 < abs(bnot(mod(ying, 11))), ib_r, ib_b);
per_frame_39=ib_r = if(0.00001 < abs(bnot(mod(ying, 11))), mod(ying, 3), ob_g);
per_frame_40=ib_b = if(0.00001 < abs(bnot(mod(ying, 11))), mod(ying, 4), 1);
per_frame_41=mv_a = yin;
per_frame_42=mv_b = sin(mytime) + abs(sin(mytime));
per_frame_43=mv_r = cos(mytime);
per_frame_44=mv_g = -0.8 * sign(sin(mytime)) * abs(sin(mytime));
per_frame_45=ob_b = cos(ying) + abs(cos(ying));
per_frame_46=ob_g = abs(sin(ying));
per_frame_47=ob_r = -1 * cos(ying) + abs(-1 * cos(ying)) + 0.2 * (cos(sin(ying)) + (abs(cos(sin(ying))) + cos(sin(ying))));
per_frame_48=q3 = if(0.00001 < abs(beat), mod(10 * abs(sin(mytime)), 3) - 1, 0);
per_frame_49=ib_size = 0.025 + 0.02 * q2;
per_frame_50=ob_size = 0.03 + 0.02 * q3 - 0.002 * q7;
per_frame_51=wave_r = 0.5 + 0.5 * sin(q1 * q7 + 2.183 * mytime);
per_frame_52=wave_g = 0.5 + 0.5 * sin(3 * q2 + 1.211 * mytime);
per_frame_53=wave_b = 0.5 + 0.5 * sin(q3 + 1.541 * mytime);
per_frame_54=dx = if(0.00001 < abs(yin), dx - 0.005 * sin(0.23 * mytime), if(0.00001 < abs(equal(yin, yang)), 0, if(0.00001 < abs(below(abs(dx), 0.05)), dx - 0.001 * q3, dx)));
per_frame_55=dy = if(0.00001 < abs(yin), dy - 0.005 * sin(0.2 * mytime), if(0.00001 < abs(equal(yin, yang)), 0, if(0.00001 < abs(below(abs(dy), 0.05)), dy - 0.001 * q3, dy)));
per_frame_56=yang = bnot(yin);
per_frame_57=ob_a = 0.8 + 0.2 * q2;
per_frame_58=zoom = zoom + 0.04 * q4;
per_pixel_1=snee = bnot(above(sin(ang) - x, 0.3) * above(q2, 0) + above(y - cos(ang), 0.7) * above(q1, 0));
per_pixel_2=snur = bnot(below(x, 0.3) * above(q3, 0) + below(y, 0.7) * below(q7, 4));
per_pixel_3=grid = sin(sigmoid(sin(6.28 * y * q2), sin(6.28 * x * q6)) * (10 + q7));
per_pixel_4=rot = bnot(above(x, 0.7) + mod(y * q8, q7)) * cos(rad + 3.14 * if(0.00001 < abs(above(grid, 0)), snur, bnot(snur)) * (0.5 + 0.5 * sin(3.14 * rad * q1))) * q4;
per_pixel_5=zoom = zoom + 0.03 * sin(3.14 * rad * q2 + q5) * sign(snee);
per_pixel_6=rot = if(0.00001 < abs(rot), rot * sign(snur), q6);
per_pixel_7=cx = if(0.00001 < abs(below(x, 0.5) * below(y, 0.5)), 0.5 + 0.2 * q1, 0.5);
per_pixel_8=cy = if(0.00001 < abs(below(x, 0.5) * below(y, 0.5)), 0.5 + 0.2 * q3, 0.5);
