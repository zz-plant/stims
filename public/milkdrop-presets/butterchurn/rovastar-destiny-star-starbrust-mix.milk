per_frame_init_1=q8 = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q2 = 0;
per_frame_init_4=oldq8 = 0;
per_frame_init_5=q7 = 0;
per_frame_1=mv_r = 0.5 + 0.5 * sin(1.23 * time);
per_frame_2=mv_b = 0.5 + 0.5 * sin(1.26 * time);
per_frame_3=mv_g = 0.5 + 0.5 * sin(1.19 * time);
per_frame_4=wave_g = wave_g + 0.2 * sin(0.13 * time);
per_frame_5=wave_r = wave_r + 0.13 * sin(time);
per_frame_6=wave_b = wave_b * sin(time);
per_frame_7=wave_x = wave_x - 0.5 * sin(0.13 * time);
per_frame_8=ob_a = if(0.00001 < abs(above(mid + treb, 2.6)), 1, 0);
per_frame_9=ob_r = 0.5 + 0.4 * sin(2.87 * time);
per_frame_10=ob_b = 0.5 + 0.4 * sin(2.914 * time);
per_frame_11=ob_g = 0.5 + 0.4 * sin(2.768 * time);
per_frame_12=mv_y = 3.25;
per_frame_13=q8 = oldq8 + 0.005 * (pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_14=oldq8 = q8;
per_frame_15=q7 = 0.005 * (pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_16=zoom = zoom + 0.028 * q7 - 0.05;
per_pixel_1=rot = 0.05 * sin(q8) * rad;
per_pixel_2=q1 = sin((1000 + sin(q8)) / y) / 200;
per_pixel_3=q2 = cos((1000 + sin(q8)) / x) / 200;
per_pixel_4=rot = rot + 100 * q1 * q2;
