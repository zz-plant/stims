wave_0_per_point5=ix = mod(100 * value1, 7) - 3;
wave_0_per_point6=iy = mod(100 * value2, 7) - 3;
wave_0_per_point7=sp = bass_att + treb_att;
wave_0_per_point8=sp = sp / 3000;
wave_0_per_point9=dx = 0.99 * (dx + sp * ix);
wave_0_per_point10=dy = 0.99 * (dy + sp * iy);
wave_0_per_point11=ox = k1 * dx + (1 - k1) * ox;
wave_0_per_point12=oy = k2 * dy + (1 - k2) * oy;
wave_0_per_point13=x = ox + 0.5;
wave_0_per_point14=y = oy + 0.5;
