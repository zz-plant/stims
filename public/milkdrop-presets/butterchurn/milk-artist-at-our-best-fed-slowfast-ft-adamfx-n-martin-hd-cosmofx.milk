[preset00]
fRating=3.000000
nWaveMode=4.000000
bAdditiveWaves=1.000000
bWaveDots=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.331000
fWaveScale=0.898000
fWaveSmoothing=0.108000
fWaveParam=0.100000
fModWaveAlphaStart=0.720000
fModWaveAlphaEnd=1.280000
fZoom=1.334500
fWaveR=0.000000
fWaveG=0.500000
fWaveB=0.500000
fWaveY=0.540000
nMotionVectorsX=24.800000
nMotionVectorsDy=0.160000
nMotionVectorsLoop=1.500000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_samples=352.000000
wavecode_0_usedots=1.000000
wavecode_0_additive=1.000000
wavecode_0_scaling=0.038560
wavecode_0_smoothing=0.200000
wavecode_0_g=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=oldshift = 0;
per_frame_init_2=shift = 0;
per_frame_init_3=normalframez = 0;
per_frame_init_4=crash = 0;
per_frame_init_5=nex = 0;
per_frame_init_6=rshift = 0;
per_frame_init_7=q1 = 0;
per_frame_init_8=zoom1 = 0;
per_frame_1=dx = 0;
per_frame_2=oldshift = shift;
per_frame_3=normalframez = normalframez + 1;
per_frame_4=shift = above(bass_att, 1) * above(treb_att, 0.9);
per_frame_5=crash = abs(oldshift - shift);
per_frame_6=nex = 1 * equal(rshift, 0) + 2 * equal(rshift, 1);
per_frame_7=rshift = if(0.00001 < abs(crash), nex, rshift);
per_frame_8=monitor = rshift;
per_frame_9=wave_r = floor(randint(200)) / 200;
per_frame_10=wave_g = floor(randint(200)) / 200;
per_frame_11=wave_b = floor(randint(200)) / 200;
per_frame_12=warp = 0;
per_frame_13=q1 = above(bass_att, 1.3);
per_frame_14=zoom1 = zoom + 0.15 - 0.3 * mod(normalframez, 2);
per_frame_15=zoom = if(0.00001 < abs(shift), zoom1, 1);
per_frame_16=rot = rot - 0.1 + 0.1 * rshift;
per_pixel_1=dy = 0.007 * -below(y, 0.4) + 0.007 * above(y, 0.6);
wave_0_init1=t02 = 0;
wave_0_init2=q1 = 0;
wave_0_init3=ratio = 0;
wave_0_init4=ampl = 0;
wave_0_init5=x1 = 0;
wave_0_init6=y1 = 0;
wave_0_per_frame1=q1 = bass_att;
wave_0_per_point1=r = abs(sin(frame / 38));
wave_0_per_point2=g = 0.5 * abs(cos(frame / 45));
wave_0_per_point3=b = 0.5 * abs(sin(frame / 133));
wave_0_per_point4=a = 0.3;
wave_0_per_point5=t02 = t02 + q1 / 10;
wave_0_per_point6=ratio = sin(frame / 49);
wave_0_per_point7=ampl = 0.01 + 0.4 * sqr(sin(frame / 18) * cos(frame / 123));
wave_0_per_point8=x1 = (r - 0.5) / 15 + 0.5 + ampl * sin(6.28 * sample);
wave_0_per_point9=y1 = (b - 0.5) / 15 + 0.5 + ampl * cos(6.28 * sample);
wave_0_per_point10=x = x1 + 0.2 * (ampl + ratio) * sin(6.28 * sample * ratio * 7.3);
wave_0_per_point11=y = y1 + 0.2 * (ampl + ratio) * cos(37.68 * sample);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = ((texture (sampler_main, (uv_orig + 
    ((uv - uv_orig) * dot (texture (sampler_main, uv).xyz, vec3(0.32, 0.49, 0.29)))
  )).xyz * 0.99) - 0.002);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 2.0);
  ret_1 = (ret_1 * (1.0 - ret_1));
  ret_1 = (((1.0 - 
    pow (clamp (ret_1, 0.0, 1.0), vec3(0.5, 0.5, 0.5))
  ) * 1.5) - 0.75);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
