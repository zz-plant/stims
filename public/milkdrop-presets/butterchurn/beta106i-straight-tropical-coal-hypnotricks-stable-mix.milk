per_frame_init_18=q3 = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_6=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_7=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_8=rg1 = abs(sin(time));
per_frame_9=rg2 = 0 * above(rg1, 0.25) + 1 * below(rg1, 0.25);
per_frame_10=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_11=q1 = wave_r;
per_frame_12=q2 = wave_g;
per_frame_13=q3 = wave_b;
per_frame_14=invert = 0;
per_frame_15=echo_alpha = min(1, max(0.5, 12 * pfdy_r));
per_frame_16=echo_zoom = min(2, max(1, 1 + abs(24 * pfdx_r)));
per_frame_17=monitor = invert;
per_frame_18=cog = ocog + 0.005 * (bass + bass_att + bass * bass_att - 2);
per_frame_19=ocog = below(cog, 30000) * cog;
per_frame_20=q4 = cog;
per_frame_21=warp = 0.2;
per_frame_22=zoom = zoom + 0.08;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 12 * dx_r * above(tg1, 0.5) + 12 * dy_r * below(tg1, 0.5);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
shape_0_init1=q1 = 0;
shape_0_init2=q3 = 0;
shape_0_init3=q2 = 0;
shape_0_init4=q4 = 0;
shape_0_per_frame1=x = x - 0.1 * tan(3 * bass) * 0.2 * sin(time);
shape_0_per_frame2=y = y + 0.2 * cos(time);
shape_0_per_frame3=border_r = q1;
shape_0_per_frame4=border_g = 1 - abs(q3);
shape_0_per_frame5=border_b = q2;
shape_0_per_frame6=sides = 14 * cos(q4);
