shape_2_per_frame1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
shape_2_per_frame2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
shape_2_per_frame3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
shape_2_per_frame4=tg1 = abs(sin(time));
shape_2_per_frame5=tg2 = 0.25 * above(tg1, 0.8) - 0.25 * below(tg1, 0.2) + 0.33 * above(tg1, 0.2) * below(tg1, 0.4) - 0.33 * above(tg1, 0.4) * below(tg1, 0.6) + 0 * below(tg1, 0.8) * above(tg1, 0.6);
shape_2_per_frame6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
shape_2_per_frame7=x = x + 42 * dy_r * tg3;
