per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q23 = index;
per_frame_14=q24 = is_beat;
per_frame_15=q26 = bass + mid + treb;
per_frame_16=k1 = is_beat * equal(index, 0);
per_frame_17=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_18=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_19=rott = 3.14159265359 * p2 / 4;
per_frame_20=q27 = 8 - index;
per_frame_21=q28 = index2;
per_frame_22=q1 = cos(rott);
per_frame_23=q2 = sin(rott);
per_frame_24=q3 = -q2;
per_frame_25=q4 = q1;
per_frame_26=q5 = q1 * bnot(index2);
