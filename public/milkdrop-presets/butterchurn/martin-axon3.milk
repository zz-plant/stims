    (tmpvar_2 / 2.0)
   + 
    (time / 20.0)
  )), vec4(0.32, 0.49, 0.29, 0.0)) * 3.0);
  mat2 tmpvar_3;
  tmpvar_3[uint(0)].x = cos(rota_1);
  tmpvar_3[uint(0)].y = sin(rota_1);
  tmpvar_3[1u].x = -(sin(rota_1));
  tmpvar_3[1u].y = cos(rota_1);
  vec3 tmpvar_4;
  tmpvar_4 = ((texture (sampler_blur1, fract(uv)).xyz * scale1) + bias1);
  vec2 tmpvar_5;
  tmpvar_5.x = dot ((texture (sampler_main, (uv + vec2(0.005, 0.0))) - texture (sampler_main, (uv - vec2(0.005, 0.0)))), vec4(0.32, 0.49, 0.29, 0.0));
  tmpvar_5.y = dot ((texture (sampler_main, (uv + vec2(0.0, 0.005))) - texture (sampler_main, (uv - vec2(0.0, 0.005)))), vec4(0.32, 0.49, 0.29, 0.0));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((
    ((texture (sampler_main, (uv + (tmpvar_5 * 0.04))).xyz + (0.015 - (
      (sqrt(dot (tmpvar_5, tmpvar_5)) * tmpvar_4)
     / 2.0))) - (tmpvar_4 * 0.02))
   + 
    abs(vec3((0.01 / (sqrt(
      (tmpvar_2 * tmpvar_3)
    .y) + 0.2))))
  ) * 0.99) - 0.04);
  ret = tmpvar_6.xyz;
 }

