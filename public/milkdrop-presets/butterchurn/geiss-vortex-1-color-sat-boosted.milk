[preset00]
fRating=1.000000
fGammaAdj=1.090000
nWaveMode=2.000000
bWaveThick=1.000000
fWaveAlpha=0.216000
fWaveScale=0.948000
fWaveSmoothing=0.500000
fWarpScale=2.853000
fZoomExponent=3.600000
fZoom=1.025000
fRot=-0.240000
fWarp=1.420000
fWaveR=0.600000
fWaveG=0.600000
fWaveB=0.600000
fWaveY=0.470000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=zoom = zoom + 0.023 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.03 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 16), 0);
per_pixel_1=rot = rot + 0.1 / (rad + 0.1);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.98);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ((mix (vec3(
    dot (tmpvar_1.xyz, vec3(0.333, 0.333, 0.333))
  ), tmpvar_1.xyz, vec3(1.2, 1.2, 1.2)) * 1.2) - 0.03);
  ret = tmpvar_2.xyz;
 }
