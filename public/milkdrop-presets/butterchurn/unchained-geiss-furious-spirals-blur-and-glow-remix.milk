per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q5 = 0;
per_frame_init_6=treb_flop = 0;
per_frame_init_7=bass_thresh = 0;
per_frame_init_8=old_bass_flop = 0;
per_frame_init_9=treb_thresh = 0;
per_frame_init_10=pulse = 0;
per_frame_init_11=bass_changed = 0;
per_frame_init_12=mid_thresh = 0;
per_frame_init_13=q4 = 0;
per_frame_init_14=mid_changed = 0;
per_frame_init_15=entropy = 0;
per_frame_init_16=old_mid_flop = 0;
per_frame_init_17=mid_residual = 0;
per_frame_init_18=treb_residual = 0;
per_frame_init_19=chaos = 0;
per_frame_init_20=mid_flop = 0;
per_frame_init_21=q2 = 0;
per_frame_init_22=treb_changed = 0;
per_frame_init_23=q3 = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -20)), 1 + randint(3), entropy));
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(time * (3 - bass_thresh)) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(time * (3 - treb_thresh)) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(time * (3 - mid_thresh)) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.04 * entropy * bor(bor(bass_changed * bnot(treb_changed), treb_changed * bnot(bass_changed)) * bnot(mid_changed), mid_changed) + 0.025 * (mid + bass + treb));
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = cos(pulse);
per_frame_25=wave_r = wave_r + 0.5 * bass_residual;
per_frame_26=wave_r = wave_g + 0.5 * mid_residual;
per_frame_27=wave_r = wave_b + 0.5 * treb_residual;
per_frame_28=wave_mystery = wave_mystery + 0.23 * mid_residual;
per_frame_29=ob_r = if(0.00001 < abs(bass_flop), treb_flop, wave_r);
per_frame_30=ob_b = if(0.00001 < abs(treb_flop), mid_flop, wave_b);
per_frame_31=ob_g = if(0.00001 < abs(mid_flop), bass_flop, wave_g);
per_frame_32=ob_a = 0.03 + 0.02 * wave_r;
per_frame_33=ob_size = 0.05 + 0.04 * wave_b;
per_frame_34=ib_r = if(0.00001 < abs(bass_flop), ob_b, ob_g);
per_frame_35=ib_b = if(0.00001 < abs(treb_flop), ob_g, ob_r);
per_frame_36=ib_g = if(0.00001 < abs(mid_flop), ob_r, ob_b);
per_frame_37=ib_a = 0.03 + 0.02 * wave_g;
per_frame_38=ib_size = 0.05 + 0.04 * ob_g;
per_frame_39=zoom = zoom + 0.08 * mid_residual;
per_pixel_1=rot = if(0.00001 < abs(above(q1, 0)), 0.4 * sin(rad + q3 + q4), 0.4 * sin(rad + q2 + q5));
per_pixel_2=zoom = zoom - rot / 10;
per_pixel_3=cx = cx + 0.3 * sin(7 * x * q4);
per_pixel_4=cy = cy + 0.3 * cos(5 * y * q5);

[warp_shader]
shader_body { 
  vec2 v_1;
  vec3 ret_2;
  v_1 = (normalize((uv - 0.5)) * texsize.zw);
  ret_2 = (0.2 * ((
    ((texture (sampler_main, uv).xyz + texture (sampler_main, (uv - (v_1 * 2.5))).xyz) + texture (sampler_main, (uv - (v_1 * 5.5))).xyz)
   + texture (sampler_main, 
    (uv - (v_1 * 9.0))
  ).xyz) + texture (sampler_main, (uv - 
    (v_1 * 13.0)
  )).xyz));
  ret_2 = (ret_2 * 0.98);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (((uv - 0.5) * 0.86) + 0.5);
  ret_2 = ((texture (sampler_main, uv_1).xyz * 1.5) - 0.1);
  ret_2.y = (ret_2 * 0.7).y;
  ret_2.x = (((texture (sampler_blur1, uv_1).xyz * scale1) + bias1).x - 0.03);
  ret_2.z = (((
    (texture (sampler_blur2, uv_1).xyz * scale2)
   + bias2).z * 1.5) - 0.05);
  ret_2 = (ret_2 * 2.3);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
