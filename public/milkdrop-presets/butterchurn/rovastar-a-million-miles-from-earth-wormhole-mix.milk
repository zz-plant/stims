[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nWaveMode=7.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
bDarken=1.000000
fWaveAlpha=1.000000
fWaveScale=0.438649
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fZoomExponent=0.999996
fShader=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveY=0.976000
fOuterBorderSize=0.005000
fOuterBorderR=0.400000
fOuterBorderG=0.300000
fOuterBorderA=1.000000
fInnerBorderR=1.000000
fInnerBorderG=0.600000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=thresh = 0;
per_frame_init_3=dx_r = 0;
per_frame_init_4=dy_r = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = 0.5 + 0.3 * sin(0.894 * time);
per_frame_3=wave_g = 0.53 + 0.33 * sin(1.14 * time);
per_frame_4=wave_b = 0.2 + 0.2 * (1 - bass);
per_frame_5=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_frame_6=dx_r = 0.004 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_frame_7=dy_r = 0.004 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_frame_8=q1 = thresh;
per_frame_9=dx = 1.1 * dx_r;
per_frame_10=dy = 1.1 * dy_r;
per_frame_11=dx = dx + if(0.00001 < abs(above(bass, 1.35)), 31 * dx_r, 0);
per_frame_12=dy = if(0.00001 < abs(above(bass, 1.3)), 0, dy);
per_pixel_1=zoom = zoom - 0.01 * q1 * rad;
per_pixel_2=zoomexp = 1 + 0.2 * (rad - 0.2 * q1);
