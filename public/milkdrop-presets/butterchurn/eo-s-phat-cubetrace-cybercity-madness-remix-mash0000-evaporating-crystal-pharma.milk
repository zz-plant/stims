  vec2 tmpvar_5;
  tmpvar_5 = (mix (uv_orig, uv, vec2(0.4, 0.4)) + ((tmpvar_4 * texsize.zw) * 2.0));
  ret_1.x = (((texture (sampler_main, tmpvar_5).x - 
    ((texture (sampler_main, tmpvar_5).x - ((texture (sampler_blur3, tmpvar_5).xyz * scale3) + bias3).x) * 0.02)
  ) - 0.004) + ((texture (sampler_noise_lq, tmpvar_3).xyz - 0.5) * 0.12)).x;
  ret_1.y = (texture (sampler_main, (mix (uv_orig, uv, vec2(0.3, 0.3)) + (
    ((texture (sampler_noise_lq, tmpvar_3).xyz - 0.5).xy * texsize.zw)
   * 3.0))).y - 0.004);
  ret_1.z = texture (sampler_main, uv).z;
  ret_1.z = (ret_1.z + ((
    (ret_1.z - ((texture (sampler_blur1, uv).xyz * scale1) + bias1).z)
