per_frame_1=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_2=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_3=vol_thresh = (pfthresh + treb_thresh + mid_thresh) / 3;
per_frame_4=q6 = vol_thresh;
per_frame_5=q7 = treb_thresh;
per_frame_6=q8 = mid_thresh;
per_frame_7=q3 = 0.65 + 0.5 * sin(1.13 * time);
