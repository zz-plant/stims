per_frame_14=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_15=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_16=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_17=rg1 = abs(sin(time));
per_frame_18=rg2 = 1 * above(rg1, 0.8) + 0.9 * below(rg1, 0.2) + 0.8 * above(rg1, 0.2) * below(rg1, 0.4) + 0.7 * above(rg1, 0.4) * below(rg1, 0.6) + 0.6 * above(rg1, 0.6) * below(rg1, 0.8);
per_frame_19=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_20=wave_a = 0;
per_frame_21=echo_zoom = rg3;
per_frame_22=cog = ocog + 0.005 * (bass + bass_att + bass * bass_att - 2);
per_frame_23=ocog = below(cog, 30000) * cog;
per_frame_24=q4 = cog;
per_frame_25=rcog = orcog + 0.005 * randint(100);
per_frame_26=orcog = below(rcog, 20000) * rcog;
per_frame_27=q5 = rcog;
per_frame_28=ib_r = 0.5 * bass_att;
per_frame_29=ib_g = 0.5 * treb_att;
per_frame_30=ib_b = 0.5 * mid_att;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 12 * dx_r * above(tg1, 0.5) + 12 * dy_r * below(tg1, 0.5);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_7=dx = dx + 0.1 * tg3 * sin(q4);
per_pixel_8=dy = dy - 0.1 * tg3 * cos(q4);
per_pixel_9=cx = cx + 0.31 * cos(q4);
per_pixel_10=cy = cy + 0.31 * sin(q4);
per_pixel_11=zoom = zoom - 0.4 * sin(q4);
per_pixel_12=rot = rot + sin(1 - q4);
