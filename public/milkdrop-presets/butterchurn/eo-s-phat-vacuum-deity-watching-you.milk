per_frame_init_14=ypos = 0;
per_frame_1=decay = 0.985;
per_frame_2=vol = 0.55 * (bass + mid + treb);
per_frame_3=vol = vol;
per_frame_4=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_5=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_6=q1 = ypos;
per_frame_7=q2 = xpos;
per_frame_8=wave_a = 0;
per_frame_9=zoom = 0.9;
per_frame_10=musictime = musictime + 0.5 * vol;
per_frame_11=q4 = 0.3 * sin(0.02 * musictime);
per_frame_12=q5 = 0.3 * sin(0.01 * musictime);
per_frame_13=dx = 0.01 * sin(0.1 * musictime);
per_frame_14=dy = 0.01 * cos(0.069 * musictime);
per_frame_15=monitor = rot;
per_pixel_1=rd = sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5)));
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=zm = -5.5 * log(sqrt(2) - rd) - 0.24;
per_pixel_5=zm = max(abs(zm), 0.99) * sign(zm);
per_pixel_6=orb = below(rd, 0.4);
per_pixel_7=zm = zm * (1 - orb + rd * rd * rd * 1.52) + orb * (1 - rd * rd * rd * 1.52);
per_pixel_8=sx = zm;
per_pixel_9=sy = zm;
