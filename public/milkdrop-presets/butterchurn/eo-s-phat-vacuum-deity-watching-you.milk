wave_0_init12=x2 = 0;
wave_0_init13=y2 = 0;
wave_0_per_point1=flip = flip + 1;
wave_0_per_point2=flip = if(0.00001 < abs(above(flip, 1)), 0, flip);
wave_0_per_point3=xp = sin(6.283 * sample);
wave_0_per_point4=yp = cos(6.283 * sample);
wave_0_per_point5=scale1 = sin(18.849 * sample);
wave_0_per_point6=scale2 = sin(6.283 * sample * 9);
wave_0_per_point7=scale3 = sin(6.283 * sample * 5);
wave_0_per_point8=scale = scale1 + 0.7 * scale2 + 0.4 * scale3;
wave_0_per_point9=scale = scale * 0.5;
wave_0_per_point10=xp = xp * scale;
wave_0_per_point11=yp = yp * scale;
wave_0_per_point12=x1 = 0.25 * xp + 0.5;
wave_0_per_point13=y1 = 0.33325 * yp + 0.5;
wave_0_per_point14=x2 = 0.5 + q4;
wave_0_per_point15=y2 = 0.5 + q5;
wave_0_per_point16=x = x1 * flip + x2 * (1 - flip);
wave_0_per_point17=y = y1 * flip + y2 * (1 - flip);
wave_0_per_point18=a = 0.05 * flip;
wave_0_per_point19=r = 0.5 * sin(time) + 0.5;
wave_0_per_point20=g = 0.5 * sin(time + 2.1) + 0.5;
wave_0_per_point21=b = 0.5 * sin(time + 4.2) + 0.5;
