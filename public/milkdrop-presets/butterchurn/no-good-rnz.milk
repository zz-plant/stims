shape_3_per_frame2=a = 0.7 * sin(time);
shape_3_per_frame3=a = if(0.00001 < abs(above(bass - bass_att, 0.1)), 1, a);
shape_3_per_frame4=border_a = if(0.00001 < abs(above(bass - bass_att, 0.1)), 1, border_a);
