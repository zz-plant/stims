wave_0_per_point1=sz = 0.2 * value1;
wave_0_per_point2=sp = 37.68 * sample;
wave_0_per_point3=sw = above(sample, 0.3333);
wave_0_per_point4=ti = 2.5 * q1 + 6.28 * (0.3333 * sw + (1 - sw) * sample);
wave_0_per_point5=mx = 0.5 + 0.2 * (sin(ti * t1) + sin(ti * t3));
wave_0_per_point6=my = 0.5 + 0.2 * (sin(ti * t2) + sin(ti * t4));
wave_0_per_point7=mix = 0.5 + 0.2 * (sin(ti * t5) + sin(ti * t7));
wave_0_per_point8=miy = 0.5 + 0.2 * (sin(ti * t6) + sin(ti * t8));
wave_0_per_point9=x = mx + sw * sz * sin(sp);
wave_0_per_point10=y = my + sw * sz * cos(sp);
wave_0_per_point11=a = min(1, sample + sw);
