per_frame_1=volume = 0.3 * (bass + mid + att);
per_frame_2=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_3=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_4=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_5=peakbass_att = max(bass_att, peakbass_att);
per_frame_6=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_7=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_8=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_9=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_10=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_11=warp = 0;
per_frame_12=tic = min(time - tin, 0.1);
per_frame_13=tin = time;
per_frame_14=vol = 0.333333 * (bass_att + treb_att + mid_att);
per_frame_15=treb_avg = tic * (treb_avg * (1 / tic - 10) + 10 * treb);
per_frame_16=mid_avg = tic * (mid_avg * (1 / tic - 10) + 10 * mid);
per_frame_17=bass_avg = tic * (bass_avg * (1 / tic - 10) + 10 * bass);
per_frame_18=vav = tic * (vav * (1 / tic - 10) + 10 * (bass + treb + mid) * 0.33333);
per_frame_19=tt = tt + tic * treb;
per_frame_20=mt = mt + tic * mid;
per_frame_21=bet = min(pow(bass, 9), 4);
per_frame_22=bt = bt + tic * bet;
per_frame_23=vt = vt + tic * vav;
per_frame_24=sp = 0.1 * abs(vav - slide);
per_frame_25=slide = if(0.00001 < abs(above(slide, vav)), slide - tic * sp, slide + tic * sp) + (1 - toc) * vav * 0.2;
per_frame_26=toc = 1;
per_frame_27=tr = if(0.00001 < abs(above(st, 0)), 0.999, tr + tic * mid);
per_frame_28=tr = tr - floor(tr);
per_frame_29=st = if(0.00001 < abs(above(st, 0)), st - tic, 0.1 * above(tr, 0.9));
per_frame_30=q1 = tt;
per_frame_31=q2 = bt;
per_frame_32=q3 = 0.1 * (tt + mt);
per_frame_33=q4 = vt;
per_frame_34=br = 0.5 * beatrate;
per_frame_35=sw = above(tim, br);
per_frame_36=tim = if(0.00001 < abs(sw), tim - br, tim);
per_frame_37=tim = tim + tic;
per_frame_38=swi = if(0.00001 < abs(sw), 1 - swi, swi);
per_frame_39=monitor = beatrate;
per_pixel_1=sw = ang / 6.2832 + 1;
per_pixel_2=sw = 8 * sw + 0.1 * q4;
per_pixel_3=bl = equal(mod(floor(sw), 2), 0);
per_pixel_4=sw = sw - floor(sw);
per_pixel_5=sw = 3 * if(0.00001 < abs(bl), sw, 1 - sw);
per_pixel_6=rd = pow(0.8 * rad, 0.9);
per_pixel_7=rd = 12.5664 * rd - 3 * (q2 + sw);
per_pixel_8=zm = 0.01 + 0.01 * sin(rd);
per_pixel_9=dx = (x - 0.5) * zm;
per_pixel_10=dy = (y - 0.5) * zm;
