per_frame_init_1=counter = 0;
per_frame_init_2=meanbass_att = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=lastbeat = 0;
per_frame_init_5=myrot = 0;
per_frame_init_6=beatrate = 0;
per_frame_init_7=peakbass_att = 0;
per_frame_init_8=countertime = 0;
per_frame_init_9=volume = 0;
per_frame_init_10=beat = 0;
per_frame_init_11=q2 = 0;
per_frame_init_12=oldq1 = 0;
per_frame_init_13=q1 = 1;
per_frame_1=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_2=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_3=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_4=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_5=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_6=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_7=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_8=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_9=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_10=countertime = if(0.00001 < abs(beat), time, countertime);
per_frame_11=counter = -1 * pow(min(time - countertime - 3, 0), 3);
per_frame_12=q1 = oldq1 + 0.003 * counter;
per_frame_13=oldq1 = q1;
per_frame_14=monitor = q1;
per_frame_15=q2 = beatrate;
per_frame_16=wave_r = wave_r + 0.5 * sin(q1 * time * 1.33);
per_frame_17=wave_g = wave_g + 0.5 * sin(1.13 * q1);
per_frame_18=wave_b = wave_b + 0.5 * sin(q1 * time * 1.23);
per_frame_19=wave_x = 0.5 + 0.09 * sin(1.2 * q1);
per_frame_20=wave_y = 0.5 + 0.09 * sin(1.1 * q1);
per_frame_21=ob_r = above(beat, 0) * ob_r + 0.2 * below(beat, 1) * cos(1.1 * lastbeat) + 0.4 * sin(1.13 * q1);
per_frame_22=ob_g = above(beat, 0) * ob_g + 0.2 * below(beat, 1) * cos(1.2 * lastbeat) + 0.4 * sin(1.23 * q1);
per_frame_23=ob_b = above(beat, 0) * ob_b + 0.2 * below(beat, 1) * cos(1.3 * lastbeat) + 0.4 * sin(1.33 * q1);
per_pixel_1=myrot = sin(q1) + sin(q1);
per_pixel_2=rot = if(0.00001 < abs(above(x, 0.85)), if(0.00001 < abs(above(y, 0.85)), if(0.00001 < abs(below(x, 0.15)), if(0.00001 < abs(below(y, 0.15)), myrot, rot), rot), rot), rot);
