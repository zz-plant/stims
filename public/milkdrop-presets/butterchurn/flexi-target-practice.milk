shape_2_init45=i4 = 0;
shape_2_init46=i3 = 0;
shape_2_init47=ppo = 0;
shape_2_init48=i4 = 0;
shape_2_init49=i4 = 0;
shape_2_init50=i3 = 0;
shape_2_init51=i4 = 0;
shape_2_per_frame1=i3 = if(0.00001 < abs(equal(instance, 0)), 0, i3);
shape_2_per_frame2=i4 = if(0.00001 < abs(equal(instance, 0)), 0, i4);
shape_2_per_frame3=ppo = 4;
shape_2_per_frame4=index = i4 * q32;
shape_2_per_frame5=sample = mod(i3, ppo);
shape_2_per_frame6=size = 2 * gmegabuf(floor(index + 4));
shape_2_per_frame7=x = gmegabuf(floor(index));
shape_2_per_frame8=y = gmegabuf(floor(index + 1));
shape_2_per_frame9=ang = gmegabuf(floor(index + 9));
shape_2_per_frame10=rad = 0.05 * size;
shape_2_per_frame11=sample = sample / ppo;
shape_2_per_frame12=bending = 5 * gmegabuf(floor(index + 12)) + 5 * gmegabuf(floor(index + 10));
shape_2_per_frame13=dir = -ang + 0 * bending;
shape_2_per_frame14=ang = 1.5 * asin(1) - dir + 0.05 * bending;
shape_2_per_frame15=x = x + (0.5 * -sample * cos(dir) * size + sin(dir) * size * bending * 0);
shape_2_per_frame16=y = y + (0.5 * -sample * sin(dir) * size - cos(dir) * size * bending * 0);
shape_2_per_frame17=x = 0.5 + (x - 0.5) * q1;
shape_2_per_frame18=rad = size * (1 - sample);
shape_2_per_frame19=i3 = i3 + 1;
shape_2_per_frame20=i4 = if(0.00001 < abs(equal(mod(i3, ppo), 0)), i4 + 1, i4);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.45);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
