[preset00]
fRating=3.500000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=1.000000
bDarkenCenter=1.000000
fWaveAlpha=5.900000
fWaveScale=0.408000
fWaveSmoothing=0.900000
fWarpScale=7.532000
fZoom=1.002840
fWarp=0.055410
fWaveR=0.900000
fWaveG=0.450000
fWaveB=0.000000
fMotionVectorsR=0.400000
fMotionVectorsG=0.700000
fMotionVectorsB=0.700000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
