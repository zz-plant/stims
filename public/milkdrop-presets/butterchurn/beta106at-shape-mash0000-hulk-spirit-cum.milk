per_frame_init_1=xx = 0;
per_frame_init_2=tr = 0;
per_frame_init_3=bt = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=t3 = 0;
per_frame_init_6=mi = 0;
per_frame_init_7=beathard = 0;
per_frame_init_8=q4 = 0;
per_frame_init_9=ba = 0;
per_frame_init_10=beat = 0;
per_frame_init_11=ff = 0;
per_frame_init_12=bb = 0;
per_frame_init_13=q2 = 0;
per_frame_init_14=q3 = 0;
per_frame_init_15=yy = 0;
per_frame_1=ff = ff + 2.7;
per_frame_2=bb = bb + bass + mid + treb;
per_frame_3=bt = bb / ff;
per_frame_4=beat = above(bass, bt);
per_frame_5=beathard = if(0.00001 < abs(beat), bass - bt, 0);
per_frame_6=monitor = t3;
per_frame_7=decay = 1;
per_frame_8=q1 = beat;
per_frame_9=q2 = beathard;
per_frame_10=wrap = 1;
per_frame_11=cx = 1 - q3;
per_frame_12=cy = 1 - q4;
per_frame_13=ba = bass - 0.9;
per_frame_14=tr = treb - 0.9;
per_frame_15=mi = mid - 0.9;
per_frame_16=xx = xx + 0.01 * ba - 0.001 * tr;
per_frame_17=yy = yy + 0.01 * tr - 0.001 * ba;
per_frame_18=xx = if(0.00001 < abs(above(1, xx)), if(0.00001 < abs(below(0, xx)), xx, 1), 0);
per_frame_19=yy = if(0.00001 < abs(above(1, yy)), if(0.00001 < abs(below(0, yy)), yy, 1), 0);
per_frame_20=q3 = xx;
per_frame_21=q4 = yy;
per_pixel_1=dx = if(0.00001 < abs(below(x, q3)), 0.1 * abs(y), 0) * q1;
per_pixel_2=dy = if(0.00001 < abs(below(x, q3)), 0.1 * abs(y) * sin(3.14 * bass + 3.14 * treb), 0) * (1 - q1);
per_pixel_3=rot = if(0.00001 < abs(above(x, q3)), 0.1 * -abs(y) + x * q2 * sin(bass), rot);
shape_0_init1=aa = 0;
shape_0_init2=tr = 0;
shape_0_init3=ss = 0;
shape_0_init4=gg = 0;
shape_0_init5=t3 = 0;
shape_0_init6=mi = 0;
shape_0_init7=q4 = 0;
shape_0_init8=ba = 0;
shape_0_init9=bb = 0;
shape_0_init10=q3 = 0;
shape_0_init11=rr = 0;
shape_0_init12=t4 = 0;
shape_0_per_frame1=ba = bass - 0.9;
shape_0_per_frame2=tr = treb - 0.9;
shape_0_per_frame3=mi = mid - 0.9;
shape_0_per_frame4=rad = 0.333 * (ba + tr + mi);
shape_0_per_frame5=ss = ss + 0.5 * mi;
shape_0_per_frame6=ss = if(0.00001 < abs(above(8, ss)), if(0.00001 < abs(below(3, ss)), ss, 8), 3);
shape_0_per_frame7=aa = aa + 0.01 * (bass + bass_att + treb + treb_att - 3.5);
shape_0_per_frame8=sides = ss;
shape_0_per_frame9=ang = aa;
shape_0_per_frame10=textured = if(0.00001 < abs(below(1.3, treb)), 0, 1);
shape_0_per_frame11=rr = rr + 0.4 * ba;
shape_0_per_frame12=gg = gg + 0.4 * tr;
shape_0_per_frame13=bb = bb + 0.4 * mi;
shape_0_per_frame14=r = rr - 0.5 * gg;
shape_0_per_frame15=b = gg - 0.5 * bb;
shape_0_per_frame16=g = bb - 0.5 * rr;
shape_0_per_frame17=r2 = b;
shape_0_per_frame18=b2 = g;
shape_0_per_frame19=g2 = r;
shape_0_per_frame20=x = q3;
shape_0_per_frame21=y = q4;
shape_0_per_frame22=t3 = x;
shape_0_per_frame23=t4 = y;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = (((
    ((texture (sampler_blur2, (uv + vec2(0.01, 0.0))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.01, 0.0))).xyz * scale2) + bias2)
  ).y * 1280.0) * texsize.z);
  tmpvar_2.y = (((
    ((texture (sampler_blur2, (uv + vec2(0.0, 0.01))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.0, 0.01))).xyz * scale2) + bias2)
  ).y * 1024.0) * texsize.w);
  ret_1.y = texture (sampler_fw_main, (uv + (tmpvar_2 * 0.005))).y;
  ret_1 = (ret_1 + ((
    (ret_1 - ((texture (sampler_blur3, uv).xyz * scale3) + bias3))
   * 0.3) - 0.05));
  ret_1 = (ret_1 + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 0.25)) + rand_frame.xy)
  ).xyz - 0.5) * 0.1));
  ret_1 = mix (ret_1, vec3(dot (ret_1, vec3(0.32, 0.49, 0.29))), vec3(0.2, 0.2, 0.2));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
