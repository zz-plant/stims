per_frame_init_1=new_mid = 0;
per_frame_init_2=d_x = 0;
per_frame_init_3=treb_effect = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=bass_thresh = 0;
per_frame_init_8=treb_thresh = 0;
per_frame_init_9=vol_att = 0;
per_frame_init_10=mid_thresh = 0;
per_frame_init_11=bass_effect = 0;
per_frame_init_12=new_treb = 0;
per_frame_init_13=q4 = 0;
per_frame_init_14=vol_thresh = 0;
per_frame_init_15=vol_effect = 0;
per_frame_init_16=mid_mid_att = 0;
per_frame_init_17=vol = 0;
per_frame_init_18=d_y = 0;
per_frame_init_19=new_bass = 0;
per_frame_init_20=q2 = 0;
per_frame_init_21=new_vol = 0;
per_frame_init_22=react = 0;
per_frame_init_23=q3 = 0;
per_frame_init_24=q7 = 0;
per_frame_init_25=mid_effect = 0;
per_frame_init_26=change = 0;
per_frame_init_27=q8 = 0;
per_frame_init_28=swirl = 0;
per_frame_1=vol_att = bass_att + treb_att + mid_att;
per_frame_2=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_3=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_4=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_5=vol_thresh = bass_thresh + treb_thresh + mid_thresh;
per_frame_6=treb_effect = max(max(treb, treb_att), treb_thresh);
per_frame_7=bass_effect = max(max(bass, bass_att), bass_thresh);
per_frame_8=mid_effect = max(max(mid, mid_att), mid_thresh);
per_frame_9=vol_effect = bass_effect + treb_effect + mid_effect;
per_frame_10=react = vol;
per_frame_11=new_bass = if(0.00001 < abs(above(react, bass_effect)), band(bass, bass_att), bass_effect + bass_thresh);
per_frame_12=new_treb = if(0.00001 < abs(above(react, treb_effect)), band(treb, treb_att), treb_effect + treb_thresh);
per_frame_13=new_mid = if(0.00001 < abs(above(react, mid_effect)), band(mid, mid_att), mid_effect + mid_thresh);
per_frame_14=new_vol = new_bass + new_treb + new_mid + 0.04;
per_frame_15=change = bnot(1);
per_frame_16=q1 = new_bass;
per_frame_17=q2 = new_treb;
per_frame_18=q3 = new_mid;
per_frame_19=q4 = new_vol;
per_frame_20=q5 = bass_thresh;
per_frame_21=q6 = treb_thresh;
per_frame_22=q7 = mid_thresh;
per_frame_23=q8 = vol_thresh;
per_frame_24=wave_r = ob_r + 0.3 * sin(q3 - time);
per_frame_25=wave_b = ob_b - 0.3 * sin(q2 - time);
per_frame_26=wave_g = ob_g + 0.2 * sin(q1 - time);
per_pixel_1=d_x = band(x - 0.2 * (rad - x), x + 0.2 * sin(0.64 * time * sin(band(q2, time))));
per_pixel_2=d_y = band(y - 0.2 * (rad - y), y + 0.2 * sin(0.54 * time * sin(band(q1, time))));
per_pixel_3=dx = d_x;
per_pixel_4=dy = d_y;
per_pixel_5=swirl = rot * sin(0.4 * q1) - rot * sin(rad * q3) * rad * sin(q1 - x * y + rad) - 0.05 * x * sin(q4) - 0.05 * y * sin(q6) - rot * sin(above(q2 - 2 * rad, q3 + 2 * rad)) + 0.25 * rot * sin(above(q1 + rad, q2 - q5 * rad * 2));
per_pixel_6=rot = swirl * rad * 2;
per_pixel_7=zoom = swirl + 1;
