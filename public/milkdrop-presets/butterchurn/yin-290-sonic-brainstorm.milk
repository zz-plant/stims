wave_0_per_frame1=r = abs(cos(3.243 * time + 0.434 + sin(1.23 * time + 4.324)));
wave_0_per_frame2=g = abs(cos(2.03 * time + 1.546 + cos(3.01 * time + 1.98)));
wave_0_per_frame3=b = abs(sin(2.54 * time + 0.65 + sin(3.77 * time + 8)));
wave_0_per_frame4=t8 = -30 + 40 * q7;
wave_0_per_frame5=v = (1 - q8) * v + q8 * (-1 + 2 * mod(frame, 2)) * q6 / 50;
wave_0_per_frame6=t2 = max(1, v);
wave_0_per_frame7=sc = (1 - q8) * sc + 20 * q8 * (bass + mid + treb);
wave_0_per_frame8=t3 = min(sc, 100);
wave_0_per_point1=x1 = 0.5 * value1;
wave_0_per_point2=z1 = t8 + 2.5 * (sample + 0);
wave_0_per_point3=y1 = 3 * below(q3, 3) * sin(1.5708 * z1 - 2 * time);
wave_0_per_point4=t1 = z1 * q6 * 0.0083;
wave_0_per_point5=t7 = cos(t1);
wave_0_per_point6=t6 = sin(t1);
wave_0_per_point7=t5 = cos(100 * t1);
wave_0_per_point8=t4 = sin(100 * t1);
wave_0_per_point9=x1 = x1 - 0.05 * below(q3, 1) * sin(4.1887 * y1 + time);
wave_0_per_point10=x1 = x1 + equal(q3, -1) * sign(q3) * q4 * y1 * y1 * 0.1111;
wave_0_per_point11=x1 = x1 + 2 * equal(q3, 0) * (q4 + 1) * t7;
wave_0_per_point12=y1 = y1 + equal(q3, 0) * (q4 + 1) * 1.2 * t6;
wave_0_per_point13=x1 = x1 + 0.1 * equal(q3, 2) * (t5 - t4);
wave_0_per_point14=y1 = y1 + 0.12 * equal(q3, 2) * (t5 + t4);
wave_0_per_point15=x1 = x1 + equal(q3, 1) * (x1 - 0.5 * value1 + 0.1 * cos(209.4367 * y1));
wave_0_per_point16=x1 = x1 + equal(q3, 3) * (0.5 * q4 + value2) * cos(t2 * (6.2831 * sample + 75 * time));
wave_0_per_point17=y1 = y1 + equal(q3, 3) * (0.5 * q4 + value1) * sin(t2 * (6.2831 * sample + 75 * time));
wave_0_per_point18=ox = x1;
wave_0_per_point19=oy = y1;
wave_0_per_point20=x1 = x1 + below(q3, 3) * (-x1 + ox * cos(q5) - oy * sin(q5));
wave_0_per_point21=y1 = y1 + below(q3, 3) * (-y1 + ox * sin(q5) + oy * cos(q5));
wave_0_per_point22=x1 = x1 - q1;
wave_0_per_point23=y1 = y1 - q2;
wave_0_per_point24=x = 0.5 * (1 + x1 / (z1 - 10));
wave_0_per_point25=y = 0.5 * (1 + y1 / (z1 - 10));
wave_0_per_point26=a = below(z1, 9) * pow(1 - 0.025 * abs(z1 - 9), 2.5);
