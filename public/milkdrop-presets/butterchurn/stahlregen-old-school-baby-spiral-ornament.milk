per_frame_init_1=vol = 0;
per_frame_init_2=beat = 0;
per_frame_init_3=res = 0;
per_frame_init_4=diff = 0;
per_frame_init_5=x = 0;
per_frame_init_6=y = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.12 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(1.22 * time);
per_frame_3=wave_b = 0.25 * sin(1.32 * time);
per_frame_4=ib_r = wave_b;
per_frame_5=ib_g = wave_r;
per_frame_6=ib_b = wave_g;
per_frame_7=vol = 8 * bass + 4 * mid + 2 * treb;
per_frame_8=vol = vol * above(vol, 17);
per_frame_9=monitor = vol;
per_frame_10=beat = above(vol, res);
per_frame_11=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_12=res = beat * (vol + 2 * diff) + (1 - beat) * (res - 60 * (0.04 * diff + 0.12) / fps);
per_frame_13=res = max(0, res);
per_frame_14=monitor = res;
per_frame_15=x = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, x);
per_frame_16=y = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, y);
per_frame_17=wave_mystery = if(0.00001 < abs(above(x, y)), 0, -1);
shape_0_per_frame1=ang = ang + 0.5 * time;
shape_0_per_frame2=rad = 0.8 + 0.1 * bass_att;
