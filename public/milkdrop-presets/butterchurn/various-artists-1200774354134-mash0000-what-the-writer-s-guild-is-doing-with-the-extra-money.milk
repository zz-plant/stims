per_frame_11=vx2 = if(0.00001 < abs(below(x2, 1)), if(0.00001 < abs(above(x2, 0)), vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring, abs(vx2) * bounce), -abs(vx2) * bounce);
per_frame_12=vy2 = if(0.00001 < abs(below(y2, 1)), if(0.00001 < abs(above(y2, 0)), vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav), abs(vy2) * bounce), -abs(vy2) * bounce);
