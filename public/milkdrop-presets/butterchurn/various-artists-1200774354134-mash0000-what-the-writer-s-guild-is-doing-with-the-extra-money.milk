per_pixel_10=x2 = nxx - cos(ndir + 1.5708) * b1;
per_pixel_11=y2 = nyy + sin(ndir + 1.5708) * b1;
per_pixel_12=d1 = sqrt((x1 - nx) * (x1 - nx) + (y1 - ny) * (y1 - ny)) - 2 * b1;
per_pixel_13=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_14=d2 = sqrt((x2 - nx) * (x2 - nx) + (y2 - ny) * (y2 - ny)) - 2 * b1;
per_pixel_15=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_16=si3 = 10 * -pow(q5, 3);
per_pixel_17=dx = 2 * (si1 * sin(y1 - ny) * m1 * d1 - si2 * sin(y2 - ny) * m1 * d2 + si3 * cos(ndir) * t1) / aspectx + nv * sin(ndir) * (nr - nd) * (1 - sigmoid(nd - nr, 280)) / aspectx + nv * (nx - nxx) * (nr - nd) * (1 - sigmoid(nd - nr, 70)) / aspectx + (nv * (sin(ny - yy) * (nd - r) - (nx - xx) * (nd - r / 2)) + cos(dir) * v2) * (1 - sigmoid(nd - r, 180)) / aspectx;
per_pixel_18=dy = 2 * (-si1 * sin(x1 - nx) * m1 * d1 + si2 * sin(x2 - nx) * m1 * d2 - si3 * sin(ndir) * t1) / aspecty + nv * cos(ndir) * (nr - nd) * (1 - sigmoid(nd - nr, 280)) / aspecty + nv * (ny - nyy) * (nr - nd) * (1 - sigmoid(nd - nr, 70)) / aspecty + (-nv * (sin(nx - xx) * (nd - r) + (ny - yy) * (nd - r / 2)) - sin(dir) * v2) * (1 - sigmoid(nd - r, 180)) / aspecty;
per_pixel_19=ndir = -q2 + 0 * asin(1);
per_pixel_20=nxx = w1;
per_pixel_21=nyy = 1 - w2;

