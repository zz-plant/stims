per_frame_21=vy4 = if(0.00001 < abs(below(y4, 1)), if(0.00001 < abs(above(y4, 0)), vy4 * (1 - resist * dt) + dt * (spy4 - grav), abs(vy4) * bounce), -abs(vy4) * bounce);
