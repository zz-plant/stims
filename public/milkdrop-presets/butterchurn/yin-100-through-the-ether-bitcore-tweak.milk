shapecode_3_enabled=0.000000
per_frame_init_1=maxdbass = 0;
per_frame_init_2=f = 0;
per_frame_init_3=dbass = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=cheat = 0;
per_frame_init_6=lastbeat = 0;
per_frame_init_7=interval = 0;
per_frame_init_8=beat_avg = 0;
per_frame_init_9=q4 = 0;
per_frame_init_10=pbass = 0;
per_frame_init_11=t = 0;
per_frame_init_12=b = 0;
per_frame_init_13=trig = 0;
per_frame_init_14=beat = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=q3 = 0;
per_frame_init_17=m = 0;
per_frame_init_18=max_bass = 0;
per_frame_init_19=endframe = 0;
per_frame_init_20=sure = 0;
per_frame_init_21=max_bass = 1.2;
per_frame_1=wave_r = mv_b;
per_frame_2=wave_b = mv_g;
per_frame_3=wave_g = mv_r;
per_frame_4=b = max(bass - 1, 0);
per_frame_5=m = max(mid - 1, 0);
per_frame_6=t = max(treb - 1, 0);
per_frame_7=mv_r = 0.6 * abs(sin(2.6 * time + 1.23 + cos(4.87 * time + 2.145))) + b / 30;
per_frame_8=mv_g = 0.6 * abs(sin(4.451 * time + 2.89 + cos(3.74 * time + 0.78))) + m / 30;
per_frame_9=mv_b = 0.6 * abs(sin(3.845 * time + 1.23 + cos(2.6 * time + 3))) + t / 30;
per_frame_10=q1 = 3.14 * cos(1.45 * time + 1.54 + cos(0.1 * bass_att + time + 3.22));
per_frame_11=q2 = 3.14 * cos(2.4 * time + 2.69 + cos(0.1 * bass_att + time + 0.65));
per_frame_12=q3 = mod(time, 50);
per_frame_13=f = if(0.00001 < abs(equal(endframe, 0)), 1, 0);
per_frame_14=beat_avg = if(0.00001 < abs(equal(beat_avg, 0)), bass, beat_avg);
per_frame_15=beat_avg = (beat_avg + bass) / 2;
per_frame_16=max_bass = if(0.00001 < abs(beat * above(f * bass_att, max_bass)), 0.99 * bass_att, max_bass);
per_frame_17=max_bass = if(0.00001 < abs(equal(mod(frame, 3000), 0)), 0.8 * max_bass, 0.9999 * max_bass);
per_frame_18=max_bass = if(0.00001 < abs(above(max_bass, 10 * beat_avg)), 10 * beat_avg, max_bass);
per_frame_19=trig = if(0.00001 < abs(equal(beat, 1) * above(bass_att, max_bass)), 1, 0);
per_frame_20=endframe = if(0.00001 < abs(equal(trig, 1) * equal(endframe, 0)), frame + 4 * min(interval, fps), endframe);
per_frame_21=trig = if(0.00001 < abs(equal(frame, endframe)), 0, trig);
per_frame_22=endframe = if(0.00001 < abs(above(frame, endframe)), 0, endframe);
per_frame_23=q4 = if(0.00001 < abs(above(endframe, 0)), 1, 0);
per_frame_24=wave_a = 0;
per_frame_25=rot = 0.1 * sin(1.53 * time + cos(4.676 * time + 3.43));
per_frame_26=rot = rot * (1 + 0.4 * q4);
per_frame_27=ob_size = 0.3 + 0.7 * abs(cos(2.45 * time + 1.566 + sin(5 * time + 2.43)));
per_frame_28=ob_r = mv_r * (randint(100) / 100);
per_frame_29=ob_g = mv_g * (randint(100) / 100);
per_frame_30=ob_b = mv_b * (randint(100) / 100);
per_frame_31=ob_a = 0.05 * abs(cos(2.45 * time + 1.566 + sin(time + 2)));
per_frame_32=mv_x = if(0.00001 < abs(equal(q4, 1)), 54 + 10 * cos(10 * time), 64);
per_frame_33=zoom = if(0.00001 < abs(equal(randint(40 + 60 * q4), 25)), 1.6, zoom);
per_frame_34=sure = if(0.00001 < abs(equal(sure, 0)), 0.6, sure);
per_frame_35=interval = if(0.00001 < abs(equal(interval, 0)), 40, interval);
per_frame_36=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), frame - fps, lastbeat);
per_frame_37=dbass = (bass - pbass) / fps;
per_frame_38=beat = above(dbass, 0.6 * maxdbass) * above(frame - lastbeat, fps / 3);
per_frame_39=sure = if(0.00001 < abs(beat * below(abs(frame - (interval + lastbeat)), fps / 5)), min(0.095 + sure, 1), beat * (sure - 0.095) + (1 - beat) * sure * 0.9996);
per_frame_40=sure = max(0.5, sure);
per_frame_41=cheat = if(0.00001 < abs(above(frame, lastbeat + interval + floor(fps / 10)) * above(sure, 0.91)), 1, cheat);
per_frame_42=beat = if(0.00001 < abs(cheat), 1, beat);
per_frame_43=sure = if(0.00001 < abs(cheat), 0.95 * sure, sure);
per_frame_44=maxdbass = max(0.999 * maxdbass, dbass);
per_frame_45=maxdbass = max(0.012, maxdbass);
per_frame_46=maxdbass = min(0.02, maxdbass);
per_frame_47=interval = if(0.00001 < abs(beat), frame - lastbeat, interval);
per_frame_48=lastbeat = if(0.00001 < abs(beat), frame - cheat * floor(fps / 10), lastbeat);
per_frame_49=cheat = 0;
per_frame_50=pbass = bass;
per_frame_51=zoom = if(0.00001 < abs(equal(beat, 1)), zoom + 0.7 * bass, zoom);
per_frame_52=monitor = sx;
per_pixel_1=dx = if(0.00001 < abs(below(abs(ang - q1), 0.4 * sqrt(rad))), dx + 0.02 * (1 - q4) * rad * sin(q1), dx);
per_pixel_2=dy = if(0.00001 < abs(below(abs(ang - q1), 0.4 * sqrt(rad))), dy + 0.02 * (1 - q4) * rad * cos(q1), dy);
per_pixel_3=zoom = if(0.00001 < abs(below(abs(ang - q1), 0.4 * sqrt(rad))), zoom + 0.2 * (1 - q4) * rad * bass, zoom);
per_pixel_4=dx = if(0.00001 < abs(below(abs(ang - q2), 0.4 * sqrt(rad))), dx + 0.02 * (1 - q4) * rad * sin(q2), dx);
per_pixel_5=dy = if(0.00001 < abs(below(abs(ang - q2), 0.4 * sqrt(rad))), dy + 0.02 * (1 - q4) * rad * cos(q2), dy);
per_pixel_6=zoom = if(0.00001 < abs(below(abs(ang - q2), 0.4 * sqrt(rad))), zoom + 0.2 * (1 - q4) * rad * bass, zoom);
per_pixel_7=zoom = zoom - 0.04 * (1 - q4) * rad + 0.1 * q4;
