fModWaveAlphaStart=2.000000
fModWaveAlphaEnd=2.000000
fShader=1.000000
fZoom=0.999902
fWarp=0.078303
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.500000
fInnerBorderSize=0.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=5.000000
fMotionVectorsA=0.100000
wavecode_0_enabled=0.000000
