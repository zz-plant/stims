[preset00]
fRating=0.000000
fGammaAdj=2.050001
fDecay=0.975000
fVideoEchoZoom=0.996630
nVideoEchoOrientation=3.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bDarken=1.000000
fWaveAlpha=100.000000
