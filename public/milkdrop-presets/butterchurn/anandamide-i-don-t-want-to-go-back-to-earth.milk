per_frame_init_1=tic = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=mid_avg = 0;
per_frame_init_4=tin = 0;
per_frame_init_5=bass_avg = 0;
per_frame_init_6=vav = 0;
per_frame_init_7=q4 = 0;
per_frame_init_8=rd = 0;
per_frame_init_9=mt = 0;
per_frame_init_10=ra = 0;
per_frame_init_11=treb_avg = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=q3 = 0;
per_frame_init_14=q7 = 0;
per_frame_init_15=rb = 0;
per_frame_init_16=q8 = 0;
per_frame_init_17=zoom = 1;
per_frame_init_18=xpos = 0;
per_frame_init_19=ypos = 0;
per_frame_1=warp = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=ra = 10;
per_frame_5=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_6=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_7=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_8=rb = 1;
per_frame_9=vav = tic * (vav * (1 / tic - rb) + rb * (bass + treb + mid) * 0.33333);
per_frame_10=q1 = treb_avg;
per_frame_11=q2 = mid_avg;
per_frame_12=q3 = bass_avg;
per_frame_13=q4 = vav;
per_frame_14=mt = (mt + tic * vav * 100) * below(mt, 10000);
per_frame_15=q7 = 0.1 * sin(0.02 * mt);
per_frame_16=q8 = 0.1 * sin(0.01 * mt);
per_frame_17=dx = 0.09 * cos(0.1 * mt);
per_frame_18=dy = 0.09 * sin(0.069 * mt);
per_frame_19=monitor = mt;
per_pixel_1=rd = sqrt(sqr(1.5 * (y + 2 - q7)) * sqr(1.5 * (x + 3 + q8)));
per_pixel_2=zoom = rad * rad * 0.1 * treb + rd;
shape_0_per_frame1=ang = time + 0.05 * (bass + treb);
shape_0_per_frame2=rad = 0.7 + 0.15 * mid;
shape_0_per_frame3=x = 0.3 * sin(time) + 0.45;
shape_1_per_frame1=tex_ang = cos(time);
shape_1_per_frame2=ang = time;
shape_1_per_frame3=x = 0.3 * sin(time) + 0.5;
shape_2_per_frame1=y = 0.3 * sin(time) + 0.5;
shape_2_per_frame2=x = 0.3 * sin(time) + 0.4;
shape_3_init1=d = 0;
shape_3_per_frame1=d = abs(x - 0.5) + abs(y - 0.5);
shape_3_per_frame2=tex_ang = time;
shape_3_per_frame3=r = bass;
shape_3_per_frame4=ang = 6.28 * (0.5 * cos(time) + 0.5);
shape_3_per_frame5=tex_zoom = 0.066 + 0.1 * treb;
shape_3_per_frame6=x = 0.3 * sin(time) + 0.5;

[warp_shader]
shader_body { 
  vec3 ret_1;
  float tmpvar_2;
  tmpvar_2 = (rad * rad);
  ret_1 = (texture (sampler_main, uv).xyz + (1.7 + (
    (rad - (tmpvar_2 * (treb * 0.5)))
   * 0.8)));
  ret_1 = (ret_1 - ((1.0 + 
    ((tmpvar_2 * rad) * ((tmpvar_2 * tmpvar_2) * rad))
  ) + (bass * 0.01)));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, (uv * cos(
    (texture (sampler_main, uv).xyz * 0.7)
  ).xy)).xyz + ((
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1) - 0.7));
  ret_1 = (ret_1 * vec3(1.3, 0.8, 0.5));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
