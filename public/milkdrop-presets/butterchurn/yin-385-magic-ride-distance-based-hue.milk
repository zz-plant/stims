wave_3_per_point4=mx = cos(t) * sin(0.43 + 2 * t + 3.1415 * sin(2.98 + 2 * t));
wave_3_per_point5=my = cos(1.9 + 0.7 * t) * sin(t);
wave_3_per_point6=mz = cos(1.54 + 2 * t) * sin(2 * t + 3.1415 * cos(1.01 + 2 * t));
wave_3_per_point7=fdx = 2 * cos(t) * (1 + 3.1415 * cos(2.98 + 2 * t)) * cos(0.43 + 2 * t + 3.1415 * sin(2.98 + 2 * t)) - sin(t) * sin(0.43 + 2 * t + 3.1415 * sin(2.98 + 2 * t));
