wave_3_per_point10=invfdmag = 1 / sqrt(fdx * fdx + fdy * fdy + fdz * fdz);
wave_3_per_point11=sdx = -4 * cos(0.43 + 2 * t + 3.1415 * sin(2.98 + 2 * t)) * (sin(t) + 3.1415 * sin(2.98 + 3 * t)) - cos(t) * (5 + 25.132 * cos(2.98 + 2 * t) + 39.4761 * sqr(cos(2.98 + 2 * t))) * sin(0.43 + 2 * t + 3.1415 * sin(2.98 + 2 * t));
wave_3_per_point12=sdy = -1.4 * cos(t) * sin(1.9 + 0.7 * t) - 1.49 * cos(1.9 + 0.7 * t) * sin(t);
wave_3_per_point13=sdz = -12.566 * cos(1.01 + 2 * t) * cos(1.54 + 2 * t) * cos(2 * t + 3.1415 * cos(1.01 + 2 * t)) + 8 * cos(2 * t + 3.1415 * cos(1.01 + 2 * t)) * (-1 + 3.1415 * sin(1.01 + 2 * t)) * sin(1.54 + 2 * t) - 4 * cos(1.54 + 2 * t) * (2 - 6.2831 * sin(1.01 + 2 * t) + 9.869 * sqr(sin(1.01 + 2 * t))) * sin(2 * t + 3.1415 * cos(1.01 + 2 * t));
wave_3_per_point14=snx = fdy * sdz - sdy * fdz;
