wave_3_per_point22=fdy = fdy * invfdmag;
wave_3_per_point23=fdz = fdz * invfdmag;
wave_3_per_point24=fnx = sny * fdz - fdy * snz;
wave_3_per_point25=fny = snz * fdx - snx * fdz;
wave_3_per_point26=fnz = snx * fdy - sny * fdx;
wave_3_per_point27=angl = 6.2831 * cos(628.3185 * sample + 2.54 + 40 * sin(62.8318 * sample + 0.56));
