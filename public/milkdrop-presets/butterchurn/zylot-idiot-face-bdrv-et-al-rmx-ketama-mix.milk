per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=warp = 0;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 1.2 * abs(3 * dy_r * sin(2 * bass_att) * (0.5 - rad) * sin(8 * ang) * bass_att * 4);
per_pixel_5=zoom = zoom - 1.2 * abs(3 * dx_r * sin(4 * bass_att) * (1 - rad) * sin(8 * ang) * bass_att * 4);
per_pixel_6=rot = rot + 5 * dy_r * (0.5 * cos(3 * bass_att) - rad * sin(12 * rad)) * bass_att;
wave_0_per_point1=y = 0.3 + pow(0.01 * value1, 0.2);
wave_0_per_point2=r = 0.1 * randint(10);
wave_0_per_point3=g = 0.1 * randint(10);
wave_0_per_point4=b = 0.1 * randint(10);
wave_0_per_point5=x = if(0.00001 < abs(equal(mod(frame, 2), 0)), 0.6 + 0.45 * -sample, 0.4 + 0.45 * sample);
wave_0_per_point6=x = if(0.00001 < abs(above(sample, 0.2)), x, -1);
wave_1_per_point1=x = if(0.00001 < abs(equal(mod(frame, 2), 0)), 0.6 + 0.45 * -sample, 0.4 + 0.45 * sample);
wave_1_per_point2=y = 0.5 - pow(0.01 * value2, 0.2);
wave_1_per_point3=r = 0.1 * randint(10);
wave_1_per_point4=g = 0.1 * randint(10);
wave_1_per_point5=b = 0.1 * randint(10);
wave_1_per_point6=x = if(0.00001 < abs(above(sample, 0.2)), x, -1);
shape_0_per_frame1=x = 0.2 + 0.02 * sin(3 * time);
shape_0_per_frame2=y = 0.7 + 0.02 * sin(4 * time);
shape_0_per_frame3=rad = rad + 0.03 * sin(bass);
shape_1_per_frame1=x = 0.8 + 0.02 * sin(3 * time);
shape_1_per_frame2=y = 0.7 + 0.02 * sin(4 * time);
shape_1_per_frame3=rad = rad + 0.03 * sin(bass);
shape_2_per_frame1=ang = 1.57 + 0.2 * sin(6 * time);
shape_2_per_frame2=rad = rad + 0.08 * sin(3 * time);
shape_2_per_frame3=y = 0.63;
