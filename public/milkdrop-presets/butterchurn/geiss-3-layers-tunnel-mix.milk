[preset00]
fRating=5.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=2.929000
fWaveScale=0.530000
fWaveSmoothing=0.000000
fWaveParam=-0.260000
fModWaveAlphaStart=1.150000
fModWaveAlphaEnd=1.330000
fWarpScale=3.138000
fZoomExponent=2.006760
fZoom=1.033000
fWarp=0.042980
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fWaveY=0.480000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_1=wave_r = 1;
per_frame_2=wave_g = 0;
per_frame_3=wave_b = 0;
per_frame_4=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=dx = dx + 0.0015 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_8=dy = dy + 0.0015 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_9=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_10=dx = dx + 0.5 * dx_residual;
per_frame_11=dy = dy + 0.5 * dy_residual;
per_frame_12=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_13=dx_residual = 0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual;
per_frame_14=dy_residual = 0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual;
per_frame_15=wave_x = wave_x - 7 * dx_residual;
per_frame_16=wave_y = wave_y - 7 * dy_residual;

[warp_shader]
shader_body { 
  vec3 xfer_1;
  vec3 ret_2;
  vec4 tmpvar_3;
  vec2 tmpvar_4;
  tmpvar_4 = (uv - 0.5);
  tmpvar_3 = texture (sampler_main, (tmpvar_4 + 0.5));
  ret_2 = (tmpvar_3.xyz / ((tmpvar_3.x + tmpvar_3.y) + tmpvar_3.z));
  ret_2 = texture (sampler_main, ((tmpvar_4 * dot (ret_2, vec3(1.0, 0.975, 0.95))) + 0.5)).xyz;
  vec3 tmpvar_5;
  tmpvar_5 = clamp (((ret_2 - 0.05) * 99.0), 0.0, 1.0);
  xfer_1.x = tmpvar_5.x;
  xfer_1.yz = (tmpvar_5.yz * clamp ((
    (0.1 - ret_2.xy)
   * 99.0), 0.0, 1.0));
  ret_2 = (ret_2 + (vec3(-0.014, 0.014, 0.0) * tmpvar_5.xxx));
  ret_2 = (ret_2 + (vec3(0.0, -0.08, 0.08) * xfer_1.yyy));
  ret_2 = (ret_2 + (vec3(0.0, 0.0, -0.02) * xfer_1.zzz));
  ret_2 = (ret_2 + (vec3(5.0, 15.0, 40.0) * (
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_2;
  ret = tmpvar_6.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (tmpvar_1.xyz * (vec3(5.4, 1.53, 2.7) * dot (tmpvar_1.xyz, vec3(0.32, 0.49, 0.29))));
  ret = tmpvar_2.xyz;
 }
