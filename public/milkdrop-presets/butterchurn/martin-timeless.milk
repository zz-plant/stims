per_frame_1=dec_med = pow(0.96, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.5 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 8);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 7);
per_frame_10=q20 = avg;
per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q23 = index;
per_frame_14=q24 = is_beat;
per_frame_15=vol = bass_att + treb_att;
per_frame_16=v2 = v2 * dec_med + vol * (1 - dec_med);
per_frame_17=q26 = max(atan(vol - v2), 0) + 0.2;
per_frame_18=q27 = index + 1;
per_frame_19=sw = sw * dec_med + (1 - dec_med) * mod(index2, 2);
per_frame_20=q28 = sw;
per_frame_21=kiss = kiss * dec_med + (1 - dec_med) * bnot(index2) * below(index, 4);
per_frame_22=q29 = kiss;
per_frame_23=k1 = is_beat * bnot(index);
per_frame_24=k2 = is_beat * bnot(index);
per_frame_25=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_26=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_27=rott = 3.1416 * p2 / 2;
per_frame_28=monitor = k1;
per_frame_29=q1 = cos(rott);
per_frame_30=q2 = sin(rott);
per_frame_31=q3 = -q2;
per_frame_32=q4 = q1;
per_frame_33=vis = vis * dec_med + (1 - dec_med) * mod(index2, 2);
per_frame_34=q10 = vis;
per_frame_35=zoom = 1;
per_frame_36=rot = -0;
per_frame_37=movez = movez + 0.3 / fps;
per_frame_38=q30 = movez;
per_frame_39=q31 = cos(time / 32) * cos(time / 32);
per_frame_40=monitor = vis;
per_pixel_1=warp = 1.2;
wave_0_per_point1=x = sample;
wave_0_per_point2=y = 0.5;
wave_0_per_point3=r = 0.5 + 0.5 * sin(time / 7);
wave_0_per_point4=g = 0.5 + 0.5 * sin(time / 11);
wave_0_per_point5=b = 0.5 + 0.5 * sin(time / 5);
