per_frame_1=dx = dx + 0.002 * sin(time);
per_pixel_1=zoom = zoom + abs(sin(time)) * rad * 0.04;
wave_0_per_frame1=a = 0.5 * bass;
wave_0_per_point1=x = 0.5 * sin(3.1415 * mod(100 * sample, 10) * bass * 0.02) + 0.5 * sin(treb);
wave_0_per_point2=r = 0.25 - y;
wave_0_per_point3=g = 0.5 * treb;
wave_0_per_point4=b = y - 0.5;
wave_1_per_point1=x = 0.5 * cos(mod(100 * sample, 20)) + 0.5;
shape_0_per_frame1=ang = 3.1415 * sin(time) + bass - treb;
shape_0_per_frame2=rad = treb;
shape_1_per_frame1=x = 0.5 * sin(0.2 * time) + 0.5;
shape_1_per_frame2=y = sin(time);
shape_1_per_frame3=rad = sin(0.23 * time);
shape_1_per_frame4=ang = sin(0.5 * time);
shape_2_per_frame1=ang = above(bass, 1) * sin(time) + cos(time);
shape_2_per_frame2=x = 0.1 * randint(10);
shape_2_per_frame3=y = 0.1 * randint(10);
