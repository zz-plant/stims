shape_2_init4=t2 = 0.01 * randint(100);
shape_2_per_frame1=x = x + 0.05 * sin(2.17 * time);
shape_2_per_frame2=y = y + 0.03 * sin(1.83 * time);
shape_2_per_frame3=ang = time * (0.3 + 0.1 * t1);
shape_2_per_frame4=rad = rad * (0.9 + 0.2 * t2);
shape_2_per_frame5=r = min(1, max(0, r + 0.1 * sin(0.417 * time + 1)));
shape_2_per_frame6=g = min(1, max(0, g + 0.1 * sin(0.391 * time + 2)));
shape_2_per_frame7=b = min(1, max(0, b + 0.1 * sin(0.432 * time + 4)));
shape_2_per_frame8=r2 = min(1, max(0, r2 + 0.1 * sin(0.457 * time + 3)));
shape_2_per_frame9=g2 = min(1, max(0, g2 + 0.1 * sin(0.437 * time + 5)));
shape_2_per_frame10=b2 = min(1, max(0, b2 + 0.1 * sin(0.484 * time + 6)));
shape_3_per_frame1=x = x + 0.2 * sin(1.14 * time);
shape_3_per_frame2=y = y + 0.1 * sin(0.93 * time + 2);

[warp_shader]
shader_body { 
  vec2 my_uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = ((uv - 0.5) * vec2((1.0 + q1)));
  vec2 tmpvar_3;
  tmpvar_3.x = ((tmpvar_2.x * tmpvar_2.x) - (tmpvar_2.y * tmpvar_2.y));
  tmpvar_3.y = ((2.0 * tmpvar_2.x) * tmpvar_2.y);
  vec2 tmpvar_4;
  tmpvar_4.x = ((tmpvar_3.x * -0.12) - (tmpvar_3.y * 0.74));
  tmpvar_4.y = ((tmpvar_3.x * 0.74) + (-0.12 * tmpvar_3.y));
  vec2 tmpvar_5;
  tmpvar_5.x = ((tmpvar_3.x * (tmpvar_4.x + 1.0)) + (tmpvar_3.y * tmpvar_4.y));
  tmpvar_5.y = ((tmpvar_3.y * (tmpvar_4.x + 1.0)) - (tmpvar_3.x * tmpvar_4.y));
  my_uv_1 = (tmpvar_5 * (1.0/((
    ((tmpvar_4.x + 1.0) * (tmpvar_4.x + 1.0))
   + 
    (tmpvar_4.y * tmpvar_4.y)
  ))));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (texture (sampler_fc_main, (my_uv_1 - floor(my_uv_1))) * 0.94).xyz;
  ret = tmpvar_6.xyz;
 }
