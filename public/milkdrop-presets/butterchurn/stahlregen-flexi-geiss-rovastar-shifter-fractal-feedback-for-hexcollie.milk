shape_1_per_frame5=r = min(1, max(0, r + 0.1 * sin(0.417 * time + 1)));
shape_1_per_frame6=g = min(1, max(0, g + 0.1 * sin(0.391 * time + 2)));
shape_1_per_frame7=b = min(1, max(0, b + 0.1 * sin(0.432 * time + 4)));
shape_1_per_frame8=r2 = min(1, max(0, r2 + 0.1 * sin(0.457 * time + 3)));
shape_1_per_frame9=g2 = min(1, max(0, g2 + 0.1 * sin(0.437 * time + 5)));
shape_1_per_frame10=b2 = min(1, max(0, b2 + 0.1 * sin(0.484 * time + 6)));
