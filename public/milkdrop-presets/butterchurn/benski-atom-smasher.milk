shape_3_per_frame22=y = t * (0.5 - q8) * 0.1617 + q8;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (uv - 0.5);
  ret_1.x = texture (sampler_main, (tmpvar_2 + 0.5)).x;
  ret_1.y = texture (sampler_main, ((tmpvar_2 * 0.9) + 0.5)).y;
  ret_1.z = texture (sampler_main, ((tmpvar_2 * 1.15) + 0.5)).z;
  ret_1 = (ret_1 * 0.75);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_main, uv).xyz;
  vec4 tmpvar_2;
  tmpvar_2.w = 0.0;
  tmpvar_2.xyz = ret_1;
  vec2 tmpvar_3;
  tmpvar_3.x = (1.0 - uv.x);
  tmpvar_3.y = uv.y;
  ret_1 = (max (tmpvar_2, texture (sampler_main, tmpvar_3)).xyz + ((
    (texture (sampler_blur1, (1.0 - uv)).xyz * scale1)
   + bias1) * 2.0));
  ret_1 = (ret_1 + ((
    (texture (sampler_blur3, -(uv)).xyz * scale3)
   + bias3) * 0.5));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }
