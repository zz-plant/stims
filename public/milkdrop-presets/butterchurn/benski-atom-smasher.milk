shape_3_per_frame17=ang = 2 * equal(mod(t, 2), 0) * an;
shape_3_per_frame18=ang = if(0.00001 < abs(equal(t, 6)), -ang, ang);
shape_3_per_frame19=d = sqrt(sqr(q7 - 0.5) + sqr(q8 - 0.5));
shape_3_per_frame20=a = above(1 - d, 0) * sqrt(1 - d);
