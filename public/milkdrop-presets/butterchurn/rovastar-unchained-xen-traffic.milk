per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=treb_effect = 0;
per_frame_init_4=bass_flop = 0;
per_frame_init_5=grid = 0;
per_frame_init_6=q6 = 0;
per_frame_init_7=q1 = 0;
per_frame_init_8=q5 = 0;
per_frame_init_9=treb_flop = 0;
per_frame_init_10=bass_thresh = 0;
per_frame_init_11=old_bass_flop = 0;
per_frame_init_12=treb_thresh = 0;
per_frame_init_13=pulse = 0;
per_frame_init_14=bass_changed = 0;
per_frame_init_15=mid_thresh = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=mid_changed = 0;
per_frame_init_18=entropy = 0;
per_frame_init_19=old_mid_flop = 0;
per_frame_init_20=mid_residual = 0;
per_frame_init_21=treb_residual = 0;
per_frame_init_22=beat = 0;
per_frame_init_23=chaos = 0;
per_frame_init_24=mid_flop = 0;
per_frame_init_25=q2 = 0;
per_frame_init_26=treb_changed = 0;
per_frame_init_27=q3 = 0;
per_frame_init_28=mid_effect = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(beat);
per_frame_6=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -3.14)), 1 + randint(3), entropy));
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(0.1 * pulse * entropy) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(0.1 * pulse * entropy) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(0.1 * pulse * entropy) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.052 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_20=beat = if(0.00001 < abs(above(abs(beat), 3.14)), -3.14, beat + 0.01 * (bass + treb + mid));
per_frame_21=q1 = mid_residual;
per_frame_22=q2 = bass_residual;
per_frame_23=q3 = treb_residual;
per_frame_24=q4 = sin(pulse);
per_frame_25=q5 = sin(beat);
per_frame_26=mv_r = mv_r + 0.5 * bass_residual;
per_frame_27=mv_g = mv_g + 0.5 * mid_residual;
per_frame_28=mv_b = mv_b + 0.5 * treb_residual;
per_frame_29=mv_a = 1.1 - (ob_a + ib_a) * chaos * 0.5;
per_frame_30=mv_x = abs(10 * beat) * entropy;
per_frame_31=mv_y = abs(10 * pulse) * entropy;
per_frame_32=mv_l = entropy * (q4 - q5);
per_frame_33=wave_r = 0.8 + 0.2 * bass_flop * mv_g;
per_frame_34=wave_g = 0.3 + 0.3 * mid_flop * mv_b;
per_frame_35=wave_b = 0.4 + 0.03 * treb_flop * mv_r;
per_frame_36=ob_r = 0.1 + 0.1 * sin(1.143 * time) + 0.2 * mv_g;
per_frame_37=ob_g = 0.3 + 0.3 * sin(0.897 * time) + 0.3 * mv_b;
per_frame_38=ob_b = 0.2 + 0.5 * mv_r;
per_frame_39=treb_effect = max(max(treb, treb_att) - 1.2, 0);
per_frame_40=mid_effect = max(max(mid, mid_att) - 1.2, 0);
per_frame_41=ib_r = 1 - ob_b;
per_frame_42=ib_g = 1 - mv_g;
per_frame_43=ib_b = 0.5 * mv_b + 0.5 * ob_b;
per_frame_44=ib_a = if(0.00001 < abs(above(treb_effect, 0)), if(0.00001 < abs(above(mid_effect, 0)), 1, 0), 0);
per_frame_45=q6 = max(max(bass, bass_att) - 1.18, 0);
per_pixel_1=grid = mod(10 * rad, above(q1, q4) + above(q2, q5) + above(q3, q4)) + mod(10 * (sqrt(2) - rad), above(q1, q5) + above(q2, q4) + above(q3, q5)) * q1;
per_pixel_2=rot = if(0.00001 < abs(grid), 0.12 * cos(3.14 * rad + x * q1 * 3.14 + y * q2 * 3.14) * (q5 + q4), 0);
per_pixel_3=zoom = zoom - bnot(grid) * atan2(x * q3 * 3.14, y * q5 * 3.14) * 0.14 * (2 * x - 1) + 0.12 * q6;
per_pixel_4=sx = sx + 0.2 * q1 * sin(1.6 * x) * -grid;
per_pixel_5=sy = sy + 0.2 * q2 * sin(1.6 * y) * (1 - grid);
