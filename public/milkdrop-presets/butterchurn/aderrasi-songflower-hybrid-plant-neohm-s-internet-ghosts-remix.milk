per_frame_init_22=leafset = 3;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=pfthresh = 3 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_6=pfdx_r = 0.015 * equal(pfthresh, 3) * sin(5 * time) + (1 - equal(pfthresh, 3)) * pfdx_r;
per_frame_7=pfdy_r = 0.015 * equal(pfthresh, 3) * sin(6 * time) + (1 - equal(pfthresh, 3)) * pfdy_r;
per_frame_8=q1 = wave_r;
per_frame_9=q2 = wave_g;
per_frame_10=q3 = wave_b;
per_frame_11=ob_r = 1 - 0.75 * abs(q1);
per_frame_12=ob_g = 1 - 0.75 * abs(q2);
per_frame_13=ob_b = 1 - 0.75 * abs(q3);
per_frame_14=echo_zoom = echo_zoom - min(max(0.75, 50 * pfdx_r), 1);
per_frame_15=echo_orient = echo_orient + 16 * pfdy_r;
per_frame_16=dx = dx + 12.1 * pfdx_r;
per_frame_17=dy = dy + 12.1 * pfdy_r;
per_frame_18=cog = ocog + 0.005 * (bass + bass_att + bass * bass_att - 2);
per_frame_19=ocog = below(cog, 30000) * cog;
per_frame_20=q4 = cog;
per_frame_21=ob_r = q2;
per_frame_22=ob_g = q3;
per_frame_23=ob_b = q1;
per_frame_24=rcog = orcog + 0.005 * floor(randint(100));
per_frame_25=orcog = below(rcog, 20000) * rcog;
per_frame_26=q5 = rcog;
per_frame_27=ib_r = 1 - abs(q1) * sin(q4);
per_frame_28=ib_g = 0.75 * cos(q4);
per_frame_29=ib_b = 1 - abs(q3) * cos(q5);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 4 * dy_r * above(tg1, 0.5) + 4 * dx_r * below(tg1, 0.5);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_7=ladder = abs(sin(1 * time));
per_pixel_8=leaf = 5 * below(ladder, 0.2) + 8 * above(ladder, 0.2) * below(ladder, 0.4) + 12 * above(ladder, 0.4) * below(ladder, 0.6) + 18 * above(ladder, 0.6) * below(ladder, 0.8) + 24 * above(ladder, 0.8);
per_pixel_9=leafset = if(0.00001 < abs(equal(thresh, 2)), leaf, leafset);
per_pixel_10=zoom = zoom + 0.05 * (0.75 - sin(5 * leafset)) * (1 - rad);
per_pixel_11=zoom = zoom - abs(0.05 * (0.75 - cos(4 * ang)));
per_pixel_12=zoom = zoom + tg3 * tan(4 * q4) * below(zoom, 0.22) * above(zoom, -0.22);
per_pixel_13=zoom = zoom + 0.0095 * (sin(10 * ang) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.1 * cos(rad));
per_pixel_14=rot = rot + 0.08 * abs(0.746 - rad) * sin(2.2 * (0.5 - rad) + 5.7 * sin(0.1 * time));
per_pixel_15=sx = sx + 0.01 * (0.99 - rad) * sin(0.733 * time) * below(sin(time), 0);
per_pixel_16=sy = sy + 0.01 * (0.99 - rad) * cos(0.953 * time) * above(sin(time), 0);
per_pixel_17=zoom = zoom - 0.015 * (1.5 - rad) * below(rad, 1.5);
shape_0_init1=q4 = 0;
