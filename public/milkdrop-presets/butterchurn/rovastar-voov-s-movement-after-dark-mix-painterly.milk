[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nWaveMode=7.000000
bWaveThick=1.000000
bDarken=1.000000
fWaveAlpha=1.000000
fWaveScale=1.186471
fWaveSmoothing=0.000000
fZoomExponent=0.351767
fZoom=0.980296
fWaveG=0.700000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderR=1.000000
fOuterBorderG=1.000000
fOuterBorderB=1.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=1.280000
nMotionVectorsY=1.248000
nMotionVectorsLoop=5.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=newang = 0;
per_frame_init_2=meanbass_att = 0;
per_frame_init_3=q6 = 0;
per_frame_init_4=framehalf = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=newrad = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=oldq8 = 0;
per_frame_init_9=lastbeat = 0;
per_frame_init_10=beatrate = 0;
per_frame_init_11=mode = 0;
per_frame_init_12=peakbass_att = 0;
per_frame_init_13=q4 = 0;
per_frame_init_14=newx = 0;
per_frame_init_15=volume = 0;
per_frame_init_16=beat = 0;
per_frame_init_17=newzoom = 0;
per_frame_init_18=q2 = 0;
per_frame_init_19=q3 = 0;
per_frame_init_20=q7 = 0;
per_frame_init_21=newy = 0;
per_frame_init_22=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=framehalf = mod(frame, 2);
per_frame_3=volume = 0.3 * (bass + mid);
per_frame_4=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_5=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_6=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_7=peakbass_att = max(bass_att, peakbass_att);
per_frame_8=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_9=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_10=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.99 * above(time - lastbeat, 2 * beatrate) + 0.998 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_11=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_12=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_13=mode = if(0.00001 < abs(beat), abs(mode - 1), mode);
per_frame_14=q8 = oldq8 + 0.003 * (pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 5) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 4) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 3) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 2) / fps + (1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att) / fps) + 1 / (5 * fps);
per_frame_15=oldq8 = q8;
per_frame_16=q1 = 0.5 + 0.15 * sin(0.416 * q8) + 0.15 * sin(0.832 * q8) + 0.1 * sin(1.324 * q8);
per_frame_17=q2 = 0.5 + 0.15 * sin(0.341 * q8) + 0.15 * sin(0.768 * q8) + 0.1 * sin(1.523 * q8);
per_frame_18=q6 = 0.5 + 0.15 * sin(0.287 * q8) + 0.15 * sin(0.913 * q8) + 0.1 * sin(1.142 * q8);
per_frame_19=q7 = 0.5 + 0.15 * sin(0.531 * q8) + 0.15 * sin(0.671 * q8) + 0.1 * sin(1.442 * q8);
per_frame_20=ob_size = 0.05 * beat;
per_frame_21=ob_r = sin(20 * (q1 + q2));
per_frame_22=ob_g = sin(25 * (q6 + q7));
per_frame_23=q4 = 8 + 0.2 * sin(0.385 * q8) + 0.2 * sin(0.641 * q8) + 0.2 * sin(0.846 * q8);
per_frame_24=q5 = 12 + 0.2 * sin(0.385 * q8) + 0.2 * sin(0.641 * q8) + 0.2 * sin(0.846 * q8);
per_frame_25=q3 = mode;
per_frame_26=wave_a = 0.4;
per_frame_27=wave_r = if(0.00001 < abs(framehalf), 0.5 + 0.15 * sin(0.512 * time) + 0.15 * sin(0.943 * time) + 0.1 * sin(1.024 * time), 0.5 + 0.15 * sin(0.483 * time) + 0.15 * sin(0.879 * time) + 0.1 * sin(1.423 * time));
per_frame_28=wave_g = if(0.00001 < abs(framehalf), 0.5 + 0.15 * sin(0.248 * time) + 0.15 * sin(0.829 * time) + 0.1 * sin(1.623 * time), 0.5 + 0.15 * sin(0.461 * time) + 0.15 * sin(0.699 * time) + 0.1 * sin(1.254 * time));
per_frame_29=wave_b = if(0.00001 < abs(framehalf), 0.5 + 0.15 * sin(0.211 * time) + 0.15 * sin(0.652 * time) + 0.1 * sin(1.865 * time), 0.5 + 0.15 * sin(0.333 * time) + 0.15 * sin(0.978 * time) + 0.1 * sin(1.359 * time));
per_pixel_1=newx = x - q1;
per_pixel_2=newy = y - q6;
per_pixel_3=newrad = min(2 * sqrt(newx * newx + 0.5625 * newy * newy), sqrt(2));
per_pixel_4=newang = atan2(newx, newy);
per_pixel_5=newzoom = pow(0.995 + 0.05 * sin(q4 * (newang + q3)), pow(sin(newrad * newrad), newrad));
per_pixel_6=dx = newx * newzoom - newx;
per_pixel_7=dy = newy * newzoom - newy;
per_pixel_8=newx = x - q2;
per_pixel_9=newy = y - q7;
per_pixel_10=newrad = min(2 * sqrt(newx * newx + 0.5625 * newy * newy), sqrt(2));
per_pixel_11=newang = atan2(newx, newy);
per_pixel_12=newzoom = pow(0.995 + 0.05 * sin(q5 * newang), pow(sin(newrad * newrad), newrad));
per_pixel_13=dx = dx + newx * newzoom - newx;
per_pixel_14=dy = dy + newy * newzoom - newy;
per_pixel_15=newx = x - 0.33 * (q1 + q2 + q6);
per_pixel_16=newy = y - 0.33 * (3 - q2 - q6 - q7);
per_pixel_17=newrad = min(2 * sqrt(newx * newx + 0.5625 * newy * newy), sqrt(2));
per_pixel_18=newang = atan2(newx, newy);
per_pixel_19=newzoom = pow(1.04 + 0.05 * sin(0.5 * (q4 + q5) * newang), pow(sin(newrad * newrad), newrad));
per_pixel_20=dx = dx + newx * newzoom - newx;
per_pixel_21=dy = dy + newy * newzoom - newy;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.03))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_main, uv).xyz;
  ret_1 = (ret_1 * 1.28);
  ret_1 = (ret_1 * ret_1);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
