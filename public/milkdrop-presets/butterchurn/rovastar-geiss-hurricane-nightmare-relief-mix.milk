per_frame_init_1=q8 = 0;
per_frame_init_2=oldq8 = 0;
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=q8 = oldq8 + if(0.00001 < abs(above(bass + bass_att, 1.8)), q8 + 0.0005 * pow(bass + bass_att - 1, 9), 0);
per_frame_5=oldq8 = q8;
per_frame_6=monitor = q8;
per_frame_7=zoom = zoom + 0.023 * (0.6 * sin(0.339 * q8) + 0.4 * sin(0.276 * q8));
per_frame_8=rot = rot + 0.03 * (0.6 * sin(0.381 * q8) + 0.4 * sin(0.579 * q8));
per_frame_9=mv_r = wave_r;
per_frame_10=mv_b = wave_b;
per_frame_11=mv_g = wave_g;
per_frame_12=mv_x = 1.25;
per_frame_13=mv_y = 1.25;
per_frame_14=mv_dx = 0.1 * sin(1.1 * time);
per_frame_15=mv_dy = 0.1 * cos(1.112 * time);
per_pixel_1=rot = rot + 1 / (10 * (rad + 0.2 + 0.1 * sin(q8)));

[comp_shader]
shader_body { 
  vec2 uv2_1;
  uv2_1 = (uv + (vec2(1.0, 0.0) * texsize.zw));
  float tmpvar_2;
  tmpvar_2 = ((texture (sampler_main, uv2_1).x + (
    ((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1)
  .x * 0.3)) + ((
    (texture (sampler_blur2, uv2_1).xyz * scale2)
   + bias2).x * 0.1));
  uv2_1 = (uv + (vec2(-1.0, 0.0) * texsize.zw));
  float tmpvar_3;
  tmpvar_3 = ((texture (sampler_main, uv2_1).x + (
    ((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1)
  .x * 0.3)) + ((
    (texture (sampler_blur2, uv2_1).xyz * scale2)
   + bias2).x * 0.1));
  uv2_1 = (uv + (vec2(0.0, 1.0) * texsize.zw));
  float tmpvar_4;
  tmpvar_4 = ((texture (sampler_main, uv2_1).x + (
    ((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1)
  .x * 0.3)) + ((
    (texture (sampler_blur2, uv2_1).xyz * scale2)
   + bias2).x * 0.1));
  uv2_1 = (uv + (vec2(0.0, -1.0) * texsize.zw));
  vec3 tmpvar_5;
  tmpvar_5.z = 0.06;
  tmpvar_5.x = (tmpvar_2 - tmpvar_3);
  tmpvar_5.y = (tmpvar_4 - ((texture (sampler_main, uv2_1).x + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1).x * 0.3)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
  .x * 0.1)));
  vec3 tmpvar_6;
  tmpvar_6 = normalize(tmpvar_5);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ((vec3(0.9, 1.17, 0.8099999) * clamp (
    dot (tmpvar_6, vec3(0.804518, 0.5229367, 0.2815813))
  , 0.0, 1.0)) + (vec3(0.54, 0.63, 0.8099999) * clamp (
    dot (tmpvar_6, vec3(0.3137279, -0.9411837, 0.1254912))
  , 0.0, 1.0)));
  ret = tmpvar_7.xyz;
 }
