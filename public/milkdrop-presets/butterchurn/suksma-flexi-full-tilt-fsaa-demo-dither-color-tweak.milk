wave_0_per_point2=pi = asin(1);
wave_0_per_point3=n = 180;
wave_0_per_point4=rd = 0.075;
wave_0_per_point5=xx = 0.5 * sin(sample * pi * 4 + (t7 + 1) * t8) + cos(sample * pi * n) * rd * sin(sample * pi * 4 + (t7 + 1) * t8);
wave_0_per_point6=yy = 0.5 * cos(sample * pi * 4 + (t7 + 1) * t8) + cos(sample * pi * n) * rd * cos(sample * pi * 4 + (t7 + 1) * t8);
wave_0_per_point7=zz = sin(sample * pi * n) * rd;
wave_0_per_point8=d = sqrt(xx * xx + yy * yy + zz * zz);
wave_0_per_point9=d1 = 1;
wave_0_per_point10=xx = xx * d1;
wave_0_per_point11=yy = yy * d1;
wave_0_per_point12=zz = zz * d1;
wave_0_per_point13=w = -d * t5 * 0;
wave_0_per_point14=s1 = sin(1 * t2 + w);
wave_0_per_point15=s2 = sin(1 * t3 + w);
wave_0_per_point16=s3 = sin(1 * t4 + w);
wave_0_per_point17=c1 = cos(1 * t2 + w);
wave_0_per_point18=c2 = cos(1 * t3 + w);
wave_0_per_point19=c3 = cos(1 * t4 + w);
wave_0_per_point20=z = (c3 * s1 * c2 + s3 * s2) * xx - (c3 * s1 * s2 - s3 * c2) * yy + c3 * c1 * zz;
wave_0_per_point21=x1 = c1 * c2 * xx + c1 * s2 * yy - s1 * zz;
wave_0_per_point22=y1 = (s3 * s1 * c2 - c3 * s2) * xx + (s3 * s1 * s2 + c3 * c2) * yy + s3 * c1 * zz;
wave_0_per_point23=d = sqrt(x1 * x1 + y1 * y1);
wave_0_per_point24=w = atan2(x1, y1);
wave_0_per_point25=a = 1;
wave_0_per_point26=zoom = 0.5 * atan2(a, a + z) * d;
wave_0_per_point27=x = 0.5 + zoom * sin(w);
wave_0_per_point28=y = 0.5 + zoom * cos(w);
wave_0_per_point29=pi3 = 2.09418562716;
wave_0_per_point30=t = 6 * sample + 2 * t3;
wave_0_per_point31=c = 0.5015;
wave_0_per_point32=r = (sin(t) + 1) * c;
wave_0_per_point33=g = (sin(t - pi3) + 1) * c;
wave_0_per_point34=b = (sin(t - 2 * pi3) + 1) * c;
wave_0_per_point35=a = 1;

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = ((texture (sampler_blur3, (0.5 + 
    (((uv + (texsize.zw * 2.0)) - 0.5) * 0.94)
  )).xyz * scale3) + bias3);
  ret_1 = (ret_1 - 0.024);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 myblur_1;
  myblur_1 = ((texture (sampler_main, uv).xyz * 3.0) + (texture (sampler_main, (uv - texsize.zw)) * 0.75).xyz);
  myblur_1 = (myblur_1 + (texture (sampler_main, (uv + texsize.zw)) * 0.75).xyz);
  myblur_1 = (myblur_1 + (texture (sampler_main, (uv + 
    (vec2(1.0, -1.0) * texsize.zw)
  )) * 0.75).xyz);
  myblur_1 = (myblur_1 + (texture (sampler_main, (uv + 
    (vec2(-1.0, 1.0) * texsize.zw)
  )) * 0.75).xyz);
  myblur_1 = (myblur_1 + texture (sampler_main, (uv + (vec2(0.0, -1.0) * texsize.zw))).xyz);
  myblur_1 = (myblur_1 + texture (sampler_main, (uv + (vec2(0.0, 1.0) * texsize.zw))).xyz);
  myblur_1 = (myblur_1 + texture (sampler_main, (uv + (vec2(-1.0, 0.0) * texsize.zw))).xyz);
  myblur_1 = (myblur_1 + texture (sampler_main, (uv + (vec2(1.0, 0.0) * texsize.zw))).xyz);
  myblur_1 = (myblur_1 * 0.1);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ((myblur_1 * myblur_1) * myblur_1);
  ret = tmpvar_2.xyz;
 }
