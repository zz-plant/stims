shapecode_3_enabled=0.000000
per_pixel_1=dy = if(0.00001 < abs(above(0.5, y)), -0.01, 0.01);
wave_0_per_point1=r = 1 - sample;
wave_0_per_point2=g = mid;
wave_0_per_point3=b = sample;
wave_0_per_point4=x = 10.4 * pow(value1, 1.81) / pow(value1, 1.8) - 9.7;
wave_0_per_point5=y = 13.5 * pow(sample, 0.01) - 12.645;
wave_1_per_point1=r = 1 - sample;
wave_1_per_point2=g = mid;
wave_1_per_point3=b = sample;
wave_1_per_point4=x = -10.4 * pow(value2, 1.81) / pow(value2, 1.8) + 10.7;
wave_1_per_point5=y = 13.5 * pow(sample, 0.01) - 12.645;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  float tmpvar_2;
  tmpvar_2 = dot (texsize.zw, texsize.zw);
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  tmpvar_1.xyz = ((max (
    max (texture (sampler_main, uv).xyz, texture (sampler_main, ((tmpvar_3 * (1.0 - 
      (8.0 * sqrt(tmpvar_2))
    )) + 0.5)).xyz)
  , texture (sampler_main, 
    ((tmpvar_3 * (1.0 + (8.0 * 
      sqrt(tmpvar_2)
    ))) + 0.5)
  ).xyz) - 0.03) * 0.98);
  ret = tmpvar_1.xyz;
 }
