per_frame_init_1=du = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=mult = 0;
per_frame_init_4=ang2 = 0;
per_frame_init_5=dv = 0;
per_frame_init_6=q4 = 0;
per_frame_init_7=q2 = 0;
per_frame_init_8=dist = 0;
per_frame_init_9=q3 = 0;
per_frame_1=mv_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=mv_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=mv_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=q1 = 2 * cx - 1 + 0.62 * (0.6 * sin(0.474 * time) + 0.4 * sin(0.394 * time));
per_frame_5=q2 = 2 * cy - 1 + 0.62 * (0.6 * sin(0.413 * time) + 0.4 * sin(0.323 * time));
per_frame_6=q3 = 2 * cx - 1 + 0.62 * (0.6 * sin(0.274 * -time) + 0.4 * sin(0.464 * time));
per_frame_7=q4 = 2 * cy - 1 + 0.62 * (0.6 * sin(0.334 * time) + 0.4 * sin(0.371 * -time));
per_frame_8=decay = decay - 0.01 * equal(mod(frame, 5), 0);
per_frame_9=cy = cy + 0.1 * sin(0.245 * time);
per_frame_10=cx = cx + 0.1 * cos(341 * time);
per_frame_11=wave_mystery = 2;
per_frame_12=warp = warp * pow(2, 0.6 * sin(0.194 * time));
per_pixel_1=du = 2 * x - 1 - q1;
per_pixel_2=dv = 2 * y - 1 - q2;
per_pixel_3=dist = sqrt(du * du + dv * dv);
per_pixel_4=ang2 = atan2(du, dv);
per_pixel_5=mult = 0.008 / (dist + 0.4);
per_pixel_6=dx = mult * sin(ang2 - 1.5) * aspectx;
per_pixel_7=dy = mult * cos(ang2 - 1.5) * aspecty;
per_pixel_8=du = 2 * x - 1 - q3;
per_pixel_9=dv = 2 * y - 1 - q4;
per_pixel_10=dist = sqrt(du * du + dv * dv);
per_pixel_11=ang2 = atan2(du, dv);
per_pixel_12=mult = 0.008 / (dist + 0.7);
per_pixel_13=dx = dx + mult * sin(ang2 + 1.5) * aspectx;
per_pixel_14=dy = dy + mult * cos(ang2 + 1.5) * aspecty;
