per_frame_init_28=q3 = 0;
per_frame_init_29=q7 = 0;
per_frame_init_30=q8 = 0;
per_frame_1=volume = 0.3 * (bass + mid);
per_frame_2=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_3=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_4=meanbass_att = 0.05 * (19 * meanbass_att + bass_att);
per_frame_5=peakbass_att = max(bass_att, peakbass_att);
per_frame_6=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_7=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_8=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.96 * above(time - lastbeat, 2 * beatrate) + 0.996 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_9=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_10=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_11=tim = if(0.00001 < abs(beat), time, tim);
per_frame_12=q5 = below(time - tim, 0.1);
per_frame_13=warp = 0;
per_frame_14=tic = min(time - tin, 0.1);
per_frame_15=tin = time;
per_frame_16=ra = 0.25 * (1 / tic);
per_frame_17=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_18=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_19=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_20=vav = tic * (vav * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_21=tt = tt + tic * treb;
per_frame_22=mt = mt + tic * mid;
per_frame_23=bt = bt + tic * bass;
per_frame_24=vt = vt + tic * vav;
per_frame_25=q1 = treb_avg;
per_frame_26=q2 = mid_avg;
per_frame_27=q3 = bass_avg;
per_frame_28=monitor = q5;
per_frame_29=mx = if(0.00001 < abs(beat), 0.0005 * randint(1001) + 0.0005 * randint(1001), mx);
per_frame_30=my = if(0.00001 < abs(beat), 0.0005 * randint(1001) + 0.0005 * randint(1001), my);
per_frame_31=cx = mx;
per_frame_32=cy = my;
per_frame_33=mox = mx - 0.5;
per_frame_34=moy = my - 0.5;
per_frame_35=an = atan(moy / mox) + if(0.00001 < abs(above(mox, 0)), 6.2832 * above(moy, 0), 3.1416);
per_frame_36=dis = pow(mox * mox + moy * moy, 0.5);
per_frame_37=dis = max(0.17, dis);
per_frame_38=q7 = 0.5 + dis * cos(an);
per_frame_39=q8 = 0.5 + dis * sin(an);
per_pixel_1=mx = x - q7;
per_pixel_2=my = y - q8;
per_pixel_3=an = ang;
per_pixel_4=ra = pow(mx * mx + my * my, 0.5);
per_pixel_5=rot = 0.02 * sin(12.5664 * ra - 4 * time) * (mid + treb) * (mid + treb) * 0.5;
shape_0_per_frame1=ang = 0.0062832 * randint(1001);
shape_0_per_frame2=tex_ang = tex_ang + ang;
shape_0_per_frame3=tex_zoom = tex_zoom * (1 / rad);
shape_1_per_frame1=ang = 0.0062832 * randint(1001);
shape_1_per_frame2=tex_ang = tex_ang + ang;
shape_1_per_frame3=tex_zoom = tex_zoom * (1 / rad);
