per_frame_init_1=index2 = 0;
per_frame_init_2=index = 0;
per_frame_init_3=q22 = 0;
per_frame_init_4=q21 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=dec_med = 0;
per_frame_init_7=index3 = 0;
per_frame_init_8=rott = 0;
per_frame_init_9=is_beat = 0;
per_frame_init_10=q31 = 0;
per_frame_init_11=q23 = 0;
per_frame_init_12=k1 = 0;
per_frame_init_13=q24 = 0;
per_frame_init_14=dec_slow = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=q26 = 0;
per_frame_init_17=p2 = 0;
per_frame_init_18=avg = 0;
per_frame_init_19=stag = 0;
per_frame_init_20=beat = 0;
per_frame_init_21=p1 = 0;
per_frame_init_22=peak = 0;
per_frame_init_23=q2 = 0;
per_frame_init_24=q27 = 0;
per_frame_init_25=drot = 0;
per_frame_init_26=p3 = 0;
per_frame_init_27=q3 = 0;
per_frame_init_28=t0 = 0;
per_frame_init_29=q32 = 0;
per_frame_init_30=q28 = 0;
per_frame_init_31=q30 = 0;
per_frame_init_32=q20 = 0;
per_frame_init_33=p4 = 0;
per_frame_1=dec_med = pow(0.9, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.4 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 12);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=index3 = mod(index3 + is_beat * bnot(index) * bnot(index2), 3);
per_frame_11=q20 = avg;
per_frame_12=q21 = beat;
per_frame_13=q22 = peak;
per_frame_14=q23 = index;
per_frame_15=q24 = is_beat;
per_frame_16=q26 = bass + mid + treb;
per_frame_17=q27 = index + 1;
per_frame_18=q28 = index2;
per_frame_19=k1 = is_beat * equal(mod(index, 2), 0);
per_frame_20=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_21=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_22=rott = 3.1416 * p2 / 4;
per_frame_23=q1 = cos(rott);
per_frame_24=q2 = sin(rott);
per_frame_25=q3 = -q2;
per_frame_26=q4 = q1;
per_frame_27=drot = 30 * (mod(index, 4) - 2) / fps;
per_frame_28=p3 = p3 * dec_slow + 30 * (1 - dec_slow) / fps * drot;
per_frame_29=q30 = p3;
per_frame_30=stag = q27 + 1 * index2;
per_frame_31=stag = max(stag, 1);
per_frame_32=p4 = dec_med * p4 + (1 - dec_med) * stag;
per_frame_33=q31 = p4;
per_frame_34=zoom = 1 + 0.05 * q1;
per_frame_35=rot = -0.007 * index;
per_frame_36=q32 = pow(0.996, 30 / fps);
per_frame_37=monitor = index2;
shape_0_init1=vol = 0;
shape_0_init2=bob = 0;
shape_0_init3=bob = 0;
shape_0_init4=bob = 0;
