per_frame_1=vb = 0.95 * vb + (1 - vb) * pow(bass_att, 2) * 0.02;
per_frame_2=vvb = 0.95 * vvb + (1 - vvb) * vb * 0.01;
per_frame_3=vm = 0.95 * vm + (1 - vm) * pow(mid_att, 2) * 0.02;
per_frame_4=vvm = 0.95 * vvm + (1 - vvm) * vm * 0.01;
per_frame_5=vt = 0.95 * vt + (1 - vt) * pow(treb_att, 2) * 0.02;
