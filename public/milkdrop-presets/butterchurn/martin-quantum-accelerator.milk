per_frame_5=beat = beat * beat;
per_frame_6=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_7=is_beat = above(beat, -1.2 * avg + peak) * above(time, t0 + 0.1);
per_frame_8=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_9=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_10=index = mod(index + is_beat, 16);
per_frame_11=index2 = mod(indexa + is_beat, 8);
