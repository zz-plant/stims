per_frame_22=k1 = is_beat * equal(mod(index, 2), 0);
per_frame_23=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_24=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_25=rott = 3.1416 * p2 / 4;
per_frame_26=q1 = cos(rott);
