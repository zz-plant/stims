[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 uv6_2;
  vec2 tmpvar_3;
  tmpvar_3 = ((uv - 0.5) * aspect.xy);
  float x_4;
  x_4 = (tmpvar_3.x * tmpvar_3.y);
  float tmpvar_5;
  tmpvar_5 = (124.0 * sqrt((x_4 * x_4)));
  uv_1 = (uv + ((0.02 * 
    dot (((texture (sampler_blur1, uv).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29))
  ) * rad));
  uv_1 = (uv_1 - (clamp (
    ((sin(tmpvar_5) / cos(tmpvar_5)) * normalize(tmpvar_3))
  , vec2(-2.0, -2.0), vec2(2.0, 2.0)) / 20.0));
  uv6_2 = (0.4 * sin((
    (uv_1 * 8.0)
   + 
    (rand_frame * 6.0)
  .xy)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((texture (sampler_main, 
    (((uv_1 - 0.5) * (1.0 + (0.2 / tmpvar_5))) + 0.5)
  ).xyz + 
    (0.1 * (vec3((0.1 / sqrt(
      dot (uv6_2, uv6_2)
    ))) * (0.3 * (1.0 + roam_cos)).xyz))
  ) * 0.99) - 0.02);
  ret = tmpvar_6.xyz;
 }

[comp_shader]
vec3 xlat_mutableret1;
 shader_body { 
  vec2 uv_1;
  vec2 uv2_2;
  uv_1 = (uv - 0.5);
  uv_1 = (uv_1 * aspect.xy);
  xlat_mutableret1 = max (vec3(0.0, 0.0, 0.0), texture (sampler_main, (uv_1 + 0.5)).xyz);
  uv2_2.x = ((uv_1.x * 0.0007962743) - (uv_1.y * 0.9999997));
  uv2_2.y = ((uv_1.x * 0.9999997) + (uv_1.y * 0.0007962743));
  xlat_mutableret1 = max (xlat_mutableret1, texture (sampler_main, (uv2_2 + 0.5)).xyz);
  uv2_2.x = ((uv_1.x * -0.9999987) - (uv_1.y * 0.001592548));
  uv2_2.y = ((uv_1.x * 0.001592548) + (uv_1.y * -0.9999987));
  xlat_mutableret1 = max (xlat_mutableret1, texture (sampler_main, (uv2_2 + 0.5)).xyz);
  uv2_2.x = ((uv_1.x * -0.00238894) - (uv_1.y * -0.9999971));
  uv2_2.y = ((uv_1.x * -0.9999971) + (uv_1.y * -0.00238894));
  xlat_mutableret1 = max (xlat_mutableret1, texture (sampler_main, (uv2_2 + 0.5)).xyz);
  uv2_2.x = ((uv_1.x * 0.9999949) - (uv_1.y * -0.003185092));
  uv2_2.y = ((uv_1.x * -0.003185092) + (uv_1.y * 0.9999949));
  xlat_mutableret1 = max (xlat_mutableret1, texture (sampler_main, (uv2_2 + 0.5)).xyz);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (xlat_mutableret1 * 2.0);
  ret = tmpvar_3.xyz;
 }
