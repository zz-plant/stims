per_frame_init_1=zoom_fade = 0;
per_frame_init_2=rot_fade = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q5 = 0;
per_frame_init_5=bass_thresh = 0;
per_frame_init_6=treb_thresh = 0;
per_frame_init_7=pulse = 0;
per_frame_init_8=bass_changed = 0;
per_frame_init_9=mid_thresh = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=mid_changed = 0;
per_frame_init_12=entropy = 0;
per_frame_init_13=beat = 0;
per_frame_init_14=chaos = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=treb_changed = 0;
per_frame_init_17=q3 = 0;
per_frame_1=warp = 0;
per_frame_2=chaos = 0.9 + 0.1 * sin(pulse - beat);
per_frame_3=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -20) * above(beat, 0)), 1 + randint(5), entropy));
per_frame_4=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_5=bass_changed = abs(bass_changed - equal(bass_thresh, 2));
per_frame_6=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_7=treb_changed = abs(treb_changed - equal(treb_thresh, 2));
per_frame_8=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_9=mid_changed = abs(mid_changed - equal(mid_thresh, 2));
per_frame_10=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.025 * (mid + bass + treb));
per_frame_11=beat = if(0.00001 < abs(above(abs(beat), 20)), -20, beat + 0.1 * chaos * bor(bor(bass_changed, treb_changed), mid_changed));
per_frame_12=q3 = sin(pulse);
per_frame_13=q2 = sin(pulse + beat);
per_frame_14=q4 = sin(beat);
per_frame_15=q5 = entropy;
per_frame_16=q1 = (1 + 1 * above(q2, 0)) * (1 + 2 * above(q3, 0)) * (1 + 4 * mid_changed * above(q3, 0)) * (1 + 6 * above(q4, 0)) * (1 + 10 * bass_changed * above(q4, 0)) * (1 + 12 * above(q5, 3)) * (1 + 16 * treb_changed * above(q2, 0));
per_frame_17=wave_r = 0.5 + 0.2 * bnot(mod(q1, 2)) - 0.2 * bnot(mod(q1, 3)) + 0.3 * q3 * bnot(mod(q1, 13));
per_frame_18=wave_g = 0.5 + 0.2 * bnot(mod(q1, 5)) - 0.2 * bnot(mod(q1, 13)) + 0.3 * q4 * bnot(mod(q1, 7));
per_frame_19=wave_b = if(0.00001 < abs(bnot(mod(q1, 6))), 0.8 + 0.2 * q4, 0.5 + 0.5 * q2);
per_frame_20=ob_r = ob_r + 0.2 * q2 + 0.3 * bnot(mod(q1, 13)) * q3;
per_frame_21=ob_b = ob_b - 0.1 * bnot(mod(q1, 105)) - 0.4 * q2;
per_frame_22=ob_g = ob_g + 0.5 * sin(0.4 * pulse * entropy);
per_frame_23=ob_a = 0.07 + 0.05 * q3;
per_frame_24=ob_size = 0.01 * entropy * bnot(mod(q1, 6));
per_frame_25=ib_r = ib_r + 0.2 * q1 - 0.3 * bnot(mod(q1, 3)) * q4;
per_frame_26=ib_b = ib_b - 0.2 * bnot(mod(q1, 17)) - 0.3 * q2 + 0.2 * bnot(mod(q1, 11));
per_frame_27=ib_g = ib_g + 0.5 * sin(0.35 * pulse * entropy);
per_frame_28=ib_a = 0.07 + 0.05 * q3 * q4;
per_frame_29=ib_size = 0.005 + 0.005 * q3;
per_frame_30=zoom_fade = if(0.00001 < abs(bnot(mod(q1, 2))), zoom_fade - (zoom_fade - 0.97) / 2, zoom_fade - 0.02 * bnot(mod(q1, 5)) * q4 + 0.02 * bnot(mod(q1, 2)) * q3 - 0.04 * bnot(mod(q1, 11)) * q2);
per_frame_31=zoom = zoom_fade;
per_frame_32=rot_fade = if(0.00001 < abs(bnot(mod(q1, 7))), rot_fade - (rot_fade - 0.1 * q3) / 2 - 0.03 * bnot(mod(q1, 13)), rot_fade - 0.02 * bnot(mod(q1, 11)) + 0.02 * bnot(mod(q1, 3)) + 0.03 * bnot(mod(q1, 35)));
per_frame_33=rot = rot_fade;
per_frame_34=cx = cx + 0.1 * bnot(mod(q1, 39)) + 0.07 * bnot(mod(q1, 13)) * q3 - 0.2 * bnot(mod(q1, 55)) * q4;
per_frame_35=wave_x = wave_x + 0.1 * q3 + 0.2 * q4 * bnot(mod(q1, 2));
