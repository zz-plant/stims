per_frame_init_1=bass_effect = 0;
per_frame_init_2=wrap_s = 0;
per_frame_init_3=dx_residual = 0;
per_frame_init_4=dy_residual = 0;
per_frame_init_5=bass_thresh = 0;
per_frame_1=dx = dx - 0.0005;
per_frame_2=dy = dy - 0.0035;
per_frame_3=mv_l = 3000;
per_frame_4=mv_r = 0.5 + 0.499 * sin(1.12 * time);
per_frame_5=mv_g = 0.5 + 0.123 * cos(1.83 * time);
per_frame_6=mv_b = 0.4 + 0.79 * cos(0.45 * time);
per_frame_7=bass_effect = max(max(bass, bass_att) - 1.3, 0);
per_frame_8=decay = if(0.00001 < abs(above(bass_effect, 0)), 0.96, 0.996);
per_frame_9=wave_x = 0.6 + 0.3 * sin(0.724 * time);
per_frame_10=warp = warp + 2 * sin(0.75 * time);
per_frame_11=wrap_s = wrap_s + 0.5 * sin(0.1 * time);
per_frame_12=wave_r = 0.5 + (sin(time / 2) - cos(0.22 * time)) / 2;
per_frame_13=wave_g = 0.5 - sin(0.877 * time) / 2;
per_frame_14=wave_b = 0.5 - cos(time) / 2;
per_frame_15=dx = dx + dx_residual;
per_frame_16=dy = dy + dy_residual;
per_frame_17=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_18=dx_residual = 0.016 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * dx_residual;
per_frame_19=dy_residual = 0.012 * equal(bass_thresh, 2) * sin(9 * time) + (1 - equal(bass_thresh, 2)) * dy_residual;
