wave_0_init11=q4 = 0;
wave_0_init12=rx = 0;
wave_0_init13=ba = 0;
wave_0_init14=x2 = 0;
wave_0_init15=t2 = 0;
wave_0_init16=y2 = 0;
wave_0_init17=q2 = 0;
wave_0_init18=yy = 0;
wave_0_per_frame1=ba = bass - 0.9;
wave_0_per_frame2=tr = treb - 0.9;
wave_0_per_frame3=mi = mid - 0.9;
wave_0_per_frame4=xx = xx + 0.01 * ba - 0.001 * tr;
wave_0_per_frame5=yy = yy + 0.01 * tr - 0.001 * ba;
wave_0_per_frame6=xx = xx + 0.05 * cos(6.28 * frame + bass - 1) * q2;
wave_0_per_frame7=yy = yy + 0.05 * sin(3.14 * time * q6) * q4;
wave_0_per_frame8=xx = if(0.00001 < abs(above(1, xx)), if(0.00001 < abs(below(0, xx)), xx, 1), 0);
wave_0_per_frame9=yy = if(0.00001 < abs(above(1, yy)), if(0.00001 < abs(below(0, yy)), yy, 1), 0);
wave_0_per_frame10=t1 = xx;
wave_0_per_frame11=t2 = yy;
wave_0_per_point1=x1 = cos(360 * sample / 6.28) * sin(360 * sample / 6.28) + 0.5;
wave_0_per_point2=y1 = sin(360 * sample / 6.28) * sin(360 * sample / 6.28);
wave_0_per_point3=x2 = x1;
wave_0_per_point4=y2 = y1;
wave_0_per_point5=ry = 0.5 + (treb - q5);
wave_0_per_point6=rx = 0.5 + (bass - q5);
wave_0_per_point7=y1 = y1 * ry + 0.25;
wave_0_per_point8=x1 = x1 * rx + 0.25;
wave_0_per_point9=y1 = y1 + (t1 - 0.5);
wave_0_per_point10=x1 = x1 + (t2 - 0.5);
wave_0_per_point11=x1 = if(0.00001 < abs(above(1, x1)), exec2(below(0, x1), x1), x1);
wave_0_per_point12=y1 = if(0.00001 < abs(above(1, y1)), exec2(below(0, y1), y1), y1);
wave_0_per_point13=y = y1;
wave_0_per_point14=x = x1;
wave_0_per_point15=r = 0.5 * sin(sample * value2);
wave_0_per_point16=g = 0.5 * sin(bass + treb + q2 + q4 + q6 + value1 * bass);
wave_0_per_point17=bt = bt + 0.002 * value1;
wave_0_per_point18=b = 0.5 * sin(bt * q2 + value1);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_noise_lq, ((
    ((texsize.xy * texsize_noise_lq.zw).x * uv)
   / 2.0) + q23)) + 1.0).xyz;
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur1, uv).xyz * scale1) + bias1) - 0.3);
  vec2 tmpvar_4;
  tmpvar_4.x = (0.3 * tmpvar_3.x);
  tmpvar_4.y = tmpvar_3.y;
  ret_1 = ((-0.4 * (
    ((texture (sampler_blur1, ((uv / 4.0) + (0.4 * tmpvar_4))).xyz * scale1) + bias1)
   - 
    (tmpvar_2 * 0.1)
  )) + (texture (sampler_main, (uv + 
    (tmpvar_3 * 0.01)
  .xy)).xyz + (tmpvar_2 * 0.1)));
  float tmpvar_5;
  tmpvar_5 = (1.0 - ((0.01 * q28) * (q28 * rad)));
  ret_1 = (ret_1 * (0.98 * (tmpvar_5 * tmpvar_5)));
  ret_1 = (ret_1 - 0.04);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_1;
  ret = tmpvar_6.xyz;
 }
