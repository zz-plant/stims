per_frame_init_13=q2 = 0;
per_frame_init_14=q3 = 0;
per_frame_1=beatb = above(bass, bass_att);
per_frame_2=beatbhard = if(0.00001 < abs(beatb), bass - 0.9 * bass_att, beatbhard);
per_frame_3=beatm = above(mid, mid_att);
per_frame_4=beatmhard = if(0.00001 < abs(beatm), mid - 0.9 * mid_att, beatmhard);
per_frame_5=beatt = above(treb, treb_att);
per_frame_6=beatthard = if(0.00001 < abs(beatt), treb - 0.9 * treb_att, beatthard);
per_frame_7=vol = bass + mid + treb;
per_frame_8=vol_att = bass_att + mid_att + treb_att;
per_frame_9=q1 = beatb;
per_frame_10=q2 = beatbhard;
per_frame_11=q3 = beatm;
per_frame_12=q4 = beatmhard;
per_frame_13=q5 = beatt;
per_frame_14=q6 = beatthard;
per_frame_15=decay = 0.999;
per_frame_16=wrap = 1;
per_pixel_1=zoom = 1 + 0.01 * sin(6.28 * ang + time * q6);
per_pixel_2=rot = (q2 - q6) * (rad * q3 - ang * q1) * 0.1;
wave_0_init1=y1 = 0;
wave_0_init2=xx = 0;
wave_0_init3=t1 = 0;
wave_0_init4=x1 = 0;
wave_0_init5=tr = 0;
wave_0_init6=q6 = 0;
wave_0_init7=bt = 0;
wave_0_init8=q5 = 0;
wave_0_init9=mi = 0;
