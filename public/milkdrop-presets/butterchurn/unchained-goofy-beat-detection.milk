per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=treb_flop = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=old_bass_flop = 0;
per_frame_init_10=treb_thresh = 0;
per_frame_init_11=pulse = 0;
per_frame_init_12=bass_changed = 0;
per_frame_init_13=mid_thresh = 0;
per_frame_init_14=q4 = 0;
per_frame_init_15=mid_changed = 0;
per_frame_init_16=entropy = 0;
per_frame_init_17=old_mid_flop = 0;
per_frame_init_18=mid_residual = 0;
per_frame_init_19=treb_residual = 0;
per_frame_init_20=chaos = 0;
per_frame_init_21=mid_flop = 0;
per_frame_init_22=q2 = 0;
per_frame_init_23=treb_changed = 0;
per_frame_init_24=q3 = 0;
per_frame_init_25=q7 = 0;
per_frame_init_26=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(equal(pulse, -20)), 1 + bass_flop + treb_flop + mid_flop + randint(2), entropy);
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.6) * chaos + 1.6);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.6) * chaos + 1.6);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.6) * chaos + 1.6);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(3 * pulse) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(3 * pulse) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(3 * pulse) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.018 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = cos(pulse * (0.5 + 0.1 * entropy));
per_frame_25=q6 = sin(pulse * (0.5 + pow(0.25, entropy)));
per_frame_26=q7 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_27=q8 = entropy;
per_frame_28=ob_r = 0.4 + 0.4 * sin(2.157 * time + q6);
per_frame_29=ob_b = 0.8 + 0.2 * sin(1.689 * time + q5);
per_frame_30=ob_g = 0.6 + 0.4 * sin(0.413 * time + q4);
per_frame_31=ib_r = 0.5 + 0.5 * cos(1.2 * time + 0.1 * q1);
per_frame_32=ib_b = 0.4 + 0.4 * cos(2.811 * time + 0.1 * q2);
per_frame_33=ib_g = 0.4 + 0.4 * cos(1.666 * time + 0.1 * q3);
per_frame_34=ib_size = 0.05 + 0.03 * q2;
per_frame_35=ob_size = 0.03 + 0.02 * sin(2.321 * time + 0.2 * q2);
per_frame_36=ob_a = 0.6 + 0.4 * q3;
per_frame_37=ib_a = 0.9 + 0.1 * sin(0.3 * q2 + q4 + 0.5 * q1);
per_frame_38=mv_r = mv_r + 0.5 * sin(q4 + 0.678 * time);
per_frame_39=mv_b = mv_b + 0.5 * sin(q4 + 0.789 * time);
per_frame_40=mv_g = mv_g + 0.5 * sin(q5 + 0.456 * time);
per_frame_41=mv_a = 0.2 + 0.2 * sin(1.178 * time + 1.14 * q5);
per_frame_42=rot = 0;
per_frame_43=wave_r = 0.6 + 0.4 * sin(q1 + 2.183 * time);
per_frame_44=wave_b = 0.6 + 0.4 * sin(q2 + 1.211 * time);
per_frame_45=wave_g = 0.6 + 0.4 * sin(q3 + 1.541 * time);
per_frame_46=wave_mystery = wave_mystery + 0.5 * sin(2.18 * time + q6);
per_frame_47=wave_x = wave_x + 0.3 * sin(0.811 * time) + 0.005 * mod(frame, 3);
per_frame_48=wave_y = wave_y + 0.3 * sin(0.788 * time) + 0.005 * mod(frame, 3);
per_frame_49=wave_a = 3 + sin(1.414 * time) + q3;
per_frame_50=wave_mode = q7;
per_frame_51=zoom = 1 + 0.7 * sin(1.51 * time);
per_pixel_1=rot = if(0.00001 < abs(above(q4, 0)), 0.2 * rad * q5, sin(rad * (q4 + q3)));
per_pixel_2=zoom = if(0.00001 < abs(above(q2, 0)), zoom + (1 - zoom) * rot * cos(3.14 * rad * q2), if(0.00001 < abs(above(q3, 0) * above(x, 0.5 + 0.5 * q5)), zoom + (1 - zoom) * sin(q1 * rot * 3.14), zoom + (1 - zoom) * cos(10 * rad * q6)));
per_pixel_3=dx = above(q1, 0) * sin(0.5 * rad * q2);
per_pixel_4=dy = above(q3, 0) * sin(0.5 * rad * q3);
