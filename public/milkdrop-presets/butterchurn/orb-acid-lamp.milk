per_frame_init_1=basstime = 0;
per_frame_init_2=q2 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q4 = 0;
per_frame_init_5=q5 = 0;
per_frame_1=basstime = basstime + 0.0003 * bass;
per_frame_2=q2 = basstime;
per_frame_3=q1 = 0.00001 * basstime;
per_frame_4=q4 = cos(basstime);
per_frame_5=q5 = sin(basstime);
per_pixel_1=zoom = 1;
per_pixel_2=rot = 0;
shape_0_init1=basstime = 0;
shape_0_init2=basstime = 0;
