shape_0_init6=basstime = 0;
shape_0_init7=ob_b = 0;
shape_0_init8=basstime = 0;
shape_0_per_frame1=ang = basstime;
shape_0_per_frame2=tex_ang = sin(basstime);
shape_0_per_frame3=ob_r = 0.5 * sin(1.12 * basstime);
shape_0_per_frame4=ob_g = 0.5 * sin(1.5 * basstime);
shape_0_per_frame5=ob_b = 0.5 * sin(2.12 * basstime);
shape_1_init1=tex_capture = 0;
shape_1_per_frame1=tex_capture = above(bass, 1);

[warp_shader]
shader_body { 
  float final_noise_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)].x = q4;
  tmpvar_2[uint(0)].y = -(q5);
  tmpvar_2[1u].x = q5;
  tmpvar_2[1u].y = q4;
  vec3 tmpvar_3;
  tmpvar_3.xy = uv;
  tmpvar_3.z = (q2 * 10.0);
  final_noise_1 = ((texture (sampler_noisevol_lq, tmpvar_3) * 2.0) - 1.0).x;
  final_noise_1 = (final_noise_1 + (0.5 * (
    (texture (sampler_noisevol_lq, (tmpvar_3 * 2.0)) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.25 * (
    (texture (sampler_noisevol_lq, (tmpvar_3 * 4.0)) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.125 * (
    (texture (sampler_noisevol_lq, (tmpvar_3 * 8.0)) * 2.0)
   - 1.0)).x);
  final_noise_1 = ((final_noise_1 + 1.0) * 0.5);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = texture (sampler_main, (((
    ((uv - 0.5) * tmpvar_2)
   * 
    (1.0 - (rad * 0.01))
  ) * final_noise_1) + 0.5)).xyz;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 retp_1;
  vec3 ret_2;
  ret_2 = (mix (texture (sampler_main, uv).xyz, texture (sampler_main, (
    (0.5 - uv)
   + 0.5)).xyz, vec3(0.5, 0.5, 0.5)) * 2.0);
  vec3 tmpvar_3;
  tmpvar_3 = (1.0 - ((ret_2 * 
    (1.0 - ret_2)
  ) * 2.0));
  vec3 tmpvar_4;
  tmpvar_4.x = tmpvar_3.x;
  tmpvar_4.yz = (tmpvar_3.yz * vec2(1.2, 1.2));
  retp_1 = (1.0 - (tmpvar_4 * 0.5));
  retp_1 = (1.0 - (retp_1 * (1.0 - retp_1)));
  vec3 tmpvar_5;
  tmpvar_5.x = (retp_1.z * 5.0);
  tmpvar_5.y = retp_1.y;
  tmpvar_5.z = ret_2.x;
  ret_2 = (1.0 - tmpvar_5);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_2;
  ret = tmpvar_6.xyz;
 }
