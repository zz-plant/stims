per_frame_init_1=tic = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=mid_avg = 0;
per_frame_init_4=tin = 0;
per_frame_init_5=bass_avg = 0;
per_frame_init_6=vav = 0;
per_frame_init_7=q4 = 0;
per_frame_init_8=rd = 0;
per_frame_init_9=mt = 0;
per_frame_init_10=ra = 0;
per_frame_init_11=treb_avg = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=q3 = 0;
per_frame_init_14=q7 = 0;
per_frame_init_15=rb = 0;
per_frame_init_16=q8 = 0;
per_frame_init_17=zoom = 1;
per_frame_init_18=xpos = 0;
per_frame_init_19=ypos = 0;
per_frame_1=warp = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=ra = 10;
per_frame_5=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_6=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_7=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_8=rb = 1;
per_frame_9=vav = tic * (vav * (1 / tic - rb) + rb * (bass + treb + mid) * 0.33333);
per_frame_10=q1 = treb_avg;
per_frame_11=q2 = mid_avg;
per_frame_12=q3 = bass_avg;
per_frame_13=q4 = vav;
per_frame_14=mt = (mt + tic * vav * 100) * below(mt, 10000);
per_frame_15=q7 = 0.1 * sin(0.02 * mt);
per_frame_16=q8 = 0.1 * sin(0.01 * mt);
per_frame_17=dx = 0.07 * cos(0.1 * mt);
per_frame_18=dy = 0.07 * cos(0.069 * mt);
per_frame_19=monitor = mt;
per_pixel_1=rd = sqrt(sqr(1.5 * (x - 0.5 - q7)) + sqr(1.5 * (x + 0.3 + q8)));
per_pixel_2=zoom = rd * rad * rad + 0.01 * treb;
shape_0_init1=q7 = 0;
shape_0_init2=q8 = 0;
shape_0_per_frame1=x = 0.5 + q7;
shape_0_per_frame2=y = 0.5 + q8;
shape_0_per_frame3=ang = time;
shape_1_init1=q5 = 0;
shape_1_per_frame1=tex_zoom = 0.2 * (0.5 * sin(time) + 0.5);
shape_1_per_frame2=y = 0.1 - q5;
shape_2_init1=q7 = 0;
shape_2_init2=q8 = 0;
shape_2_per_frame1=x = 0.5 + q7;
shape_2_per_frame2=y = 0.5 + q8;
shape_2_per_frame3=a = 0.5 * cos(time) + 0.5;
shape_3_init1=q7 = 0;
shape_3_init2=q8 = 0;
shape_3_init3=d = 0;
shape_3_per_frame1=x = 0.5 - q7;
shape_3_per_frame2=y = 0.5 - q8;
shape_3_per_frame3=d = abs(x - 0.5) + abs(y - 0.5);
shape_3_per_frame4=tex_ang = time;
shape_3_per_frame5=r = bass;
shape_3_per_frame6=ang = 6.28 * (0.5 * cos(time) + 0.5);

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, fract(uv)).xyz + (0.34 + rad));
  float tmpvar_2;
  tmpvar_2 = (rad * rad);
  ret_1 = (ret_1 - (0.55 + (tmpvar_2 * 
    (tmpvar_2 * rad)
  )));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (uv + texture (sampler_pw_noise_lq, ((
    (floor((uv * vec2(10.0, 10.0))) * 0.1)
   + rand_preset.xy) * aspect.xy)).xy);
  ret_2 = -(((rand_preset.xyz * vec3(0.0, 1.5, 0.5)) * (
    (texture (sampler_blur1, fract(uv_1)).xyz * scale1)
   + bias1).yyy));
  ret_2 = (ret_2 - mix (ret_2, (rand_preset.xyz * vec3(1.8, 0.5, 2.0)), (
    (texture (sampler_blur2, fract(uv_1)).xyz * scale2)
   + bias2).zzz));
  vec3 tmpvar_3;
  tmpvar_3 = mix (mix (ret_2, (rand_preset.yyy * vec3(-0.45, 0.25, 0.5)), texture (sampler_main, fract(uv_1)).yyy), (rand_preset.zzz * vec3(1.15, 0.75, -0.2)), texture (sampler_main, fract(uv_1)).zzz);
  ret_2 = (tmpvar_3 - ((1.25 * tmpvar_3) * (vec3(1.0, 1.0, 1.0) + 
    (0.15 - (0.8 * texture (sampler_main, uv).xzy))
  )));
  vec3 tmpvar_4;
  tmpvar_4 = pow (ret_2, (rand_preset.xyz - ret_2));
  ret_2 = (tmpvar_4 * tmpvar_4);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_2;
  ret = tmpvar_5.xyz;
 }
