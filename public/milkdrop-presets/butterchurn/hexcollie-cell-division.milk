per_frame_8=oldy = if(0.00001 < abs(equal(mod(colorcounter, 2), 1)), if(0.00001 < abs(equal(counter1, 0.95)), ry, oldy), if(0.00001 < abs(equal(counter2, 0.95)), ry, oldy));
