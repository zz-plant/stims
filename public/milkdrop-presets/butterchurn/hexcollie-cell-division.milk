[comp_shader]
shader_body { 
  vec3 orig_1;
  vec3 ret_2;
  float tmpvar_3;
  tmpvar_3 = fract(((
    (ang / 6.28)
   * 9.0) + (time * 0.05)));
  vec2 tmpvar_4;
  tmpvar_4.x = cos(tmpvar_3);
  tmpvar_4.y = sin(tmpvar_3);
  vec4 tmpvar_5;
  tmpvar_5 = texture (sampler_main, (0.5 + ((1.75 * 
    (rad * rad)
  ) * tmpvar_4)));
  ret_2 = tmpvar_5.xyz;
  orig_1 = ret_2;
  ret_2.yz = vec2(dot (tmpvar_5.xyz, vec3(0.32, 0.49, 0.29)));
  ret_2.x = orig_1.x;
  ret_2 = (-0.3 + (1.6 * ret_2));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_2;
  ret = tmpvar_6.xyz;
 }
