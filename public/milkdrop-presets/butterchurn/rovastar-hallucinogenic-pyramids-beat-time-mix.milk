[preset00]
fRating=0.000000
nWaveMode=6.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=11.940000
fWaveScale=1.599182
fWaveSmoothing=0.700000
fWaveParam=1.000000
fWarpScale=1.772000
fZoomExponent=1.001000
fZoom=1.007000
fWarp=0.000000
