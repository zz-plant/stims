shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=ok_to_change = 0;
per_frame_init_2=beat_time = 0;
per_frame_init_3=bass_effect = 0;
per_frame_init_4=effect = 0;
per_frame_init_5=treb_effect = 0;
per_frame_init_6=mid_effect = 0;
per_frame_1=wave_r = wave_r + 0.2 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_2=wave_g = wave_g + 0.5 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_3=wave_b = wave_b + 0.5 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_4=decay = decay - 0.03 * equal(mod(frame, 30), 0);
per_frame_5=treb_effect = max(max(treb, treb_att) - 1.25, 0);
per_frame_6=mid_effect = max(max(mid, mid_att) - 1.25, 0);
per_frame_7=ob_size = ob_size + 0.005 * treb_effect;
per_frame_8=ib_size = ib_size + 0.005 * mid_effect;
per_frame_9=ob_r = ob_r - 0.2 * treb_effect + 0.2 * mid_effect;
per_frame_10=ib_g = ib_g + 0.2 * mid_effect - 0.2 * treb_effect;
per_pixel_1=ok_to_change = if(0.00001 < abs(above(time, beat_time + 5)), 1, 0);
per_pixel_2=bass_effect = max(bass, bass_att) - 1;
per_pixel_3=beat_time = if(0.00001 < abs(above(bass_effect, 0.5)), if(0.00001 < abs(ok_to_change), time, beat_time), beat_time);
per_pixel_4=effect = if(0.00001 < abs(equal(time, beat_time)), abs(effect - 1), effect);
per_pixel_5=bass_effect = max(max(bass, bass_att) - 1.34, 0);
per_pixel_6=zoom = if(0.00001 < abs(above(effect, 0)), 0.4 * x, 0.4 * y) + 0.6 - 0.13 * min(bass_effect, 0.3);
