fWaveG=0.300000
fWaveB=0.300000
fWaveX=0.000000
fOuterBorderSize=0.005000
fOuterBorderR=0.400000
fOuterBorderG=0.300000
fOuterBorderA=0.700000
fInnerBorderSize=0.005000
fInnerBorderR=0.650000
