per_frame_16=q8 = 3.3;
per_frame_17=q9 = cos(-w + asin(1)) * d * aspectx;
per_frame_18=q10 = sin(-w + asin(1)) * d * aspecty;
per_frame_19=q11 = cos(-a + 0 * ww);
per_frame_20=q12 = sin(-a + 0 * ww);
per_frame_21=q13 = q8;
per_frame_22=q14 = cos(-w + asin(1)) * d * aspectx;
per_frame_23=q15 = sin(-w + asin(1)) * d * aspecty;
per_frame_24=bb = 0.97 * bb + 0.04 * bass;
per_frame_25=tt = 0.97 * tt + 0.04 * treb;
per_frame_26=w1 = w1 + ww1 * sqrt(vx * vx + vy * vy) * a * 2;
per_frame_27=ww1 = 0.94 * ww1 + 0.1 * y1;
per_frame_28=q16 = 0.2 * (bb - tt);
per_frame_29=y1 = y1 + 0.1 * v1;
per_frame_30=y2 = y2 + 0.2 * v2;
per_frame_31=v1 = 0.95 * v1 - 0.1 * (y1 - q16);
per_frame_32=v2 = 0.99 * v2 - 0.2 * (y2 - y1);
per_frame_33=a = 2.2 * abs(y2 - y1) / fps;
per_frame_34=q17 = sin(w) * a;
per_frame_35=q18 = -cos(w) * a;
per_frame_36=v = 0.25;
per_frame_37=x = x + vx * v;
per_frame_38=x = min(1, max(-1, x));
per_frame_39=y = y + vy * v;
per_frame_40=y = min(1, max(-1, y));
per_frame_41=vx = 0.97 * vx + sin(w) * a + 0.2 * (equal(x, -1) - equal(x, 1));
per_frame_42=vy = 0.97 * vy - cos(w) * a + 0.2 * (equal(y, -1) - equal(y, 1));
per_frame_43=q19 = 0.5 * x;
per_frame_44=q20 = 0.5 * y;
shape_3_init1=vx = 0;

[warp_shader]
vec2 xlat_mutablefactorA;
 shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2 = (uv_orig - 0.5);
  xlat_mutablefactorA = (tmpvar_2 * aspect.xy);
  vec2 tmpvar_3;
  tmpvar_3.x = ((xlat_mutablefactorA.x * q1) - (xlat_mutablefactorA.y * q2));
  tmpvar_3.y = ((xlat_mutablefactorA.x * q2) + (xlat_mutablefactorA.y * q1));
  vec2 tmpvar_4;
  tmpvar_4.x = q4;
  tmpvar_4.y = q5;
  vec2 tmpvar_5;
  tmpvar_5.x = ((xlat_mutablefactorA.x * q6) - (xlat_mutablefactorA.y * q7));
  tmpvar_5.y = ((xlat_mutablefactorA.x * q7) + (xlat_mutablefactorA.y * q6));
  vec2 tmpvar_6;
  tmpvar_6.x = q9;
  tmpvar_6.y = q10;
  vec2 tmpvar_7;
  tmpvar_7.x = ((xlat_mutablefactorA.x * q11) - (xlat_mutablefactorA.y * q12));
  tmpvar_7.y = ((xlat_mutablefactorA.x * q12) + (xlat_mutablefactorA.y * q11));
  vec2 tmpvar_8;
  tmpvar_8.x = q14;
  tmpvar_8.y = q15;
  ret_1.x = (max (texture (sampler_main, clamp (
    ((0.5 + ((tmpvar_3 * aspect.zw) * q3)) + (tmpvar_4 * aspect.zw))
  , 0.0, 1.0)).x, max (texture (sampler_main, 
    clamp (((0.5 + (
      (tmpvar_5 * aspect.zw)
     * q8)) + tmpvar_6), 0.0, 1.0)
  ).x, texture (sampler_main, 
    clamp (((0.5 + (
      (tmpvar_7 * aspect.zw)
     * q13)) + tmpvar_8), 0.0, 1.0)
  ).x)) - 0.015);
  vec2 tmpvar_9;
  tmpvar_9 = (tmpvar_2 * vec2(1.8, 1.8));
  vec2 tmpvar_10;
  tmpvar_10.x = ((tmpvar_9.x * tmpvar_9.x) - (tmpvar_9.y * tmpvar_9.y));
  tmpvar_10.y = ((2.0 * tmpvar_9.x) * tmpvar_9.y);
  ret_1.y = texture (sampler_fc_main, (tmpvar_10 + vec2(0.5, 0.71))).y;
  ret_1.z = max (texture (sampler_main, (uv + vec2(-0.1, -0.1))).y, (texture (sampler_main, (uv + 
    (vec2(2.0, 1.0) * texsize.zw)
  )).z - 0.0038));
  vec4 tmpvar_11;
  tmpvar_11.w = 1.0;
  tmpvar_11.xyz = ret_1;
  ret = tmpvar_11.xyz;
 }

[comp_shader]
vec2 xlat_mutabled;
vec3 xlat_mutabledx;
vec3 xlat_mutabledy;
 shader_body { 
  xlat_mutabled = (texsize.zw * 4.0);
  xlat_mutabledx = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv + (vec2(-1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  xlat_mutabledy = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv + (vec2(0.0, -1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_1;
  tmpvar_1.x = xlat_mutabledx.z;
  tmpvar_1.y = xlat_mutabledy.z;
  vec2 tmpvar_2;
  tmpvar_2.x = q19;
  tmpvar_2.y = q20;
  vec2 tmpvar_3;
  tmpvar_3 = clamp (((0.5 + 
    (uv - 0.5)
  ) + (tmpvar_2 * vec2(-1.0, 1.0))), 0.0, 1.0);
  xlat_mutabled = (texsize.zw * 3.0);
  xlat_mutabledx = (((texture (sampler_blur1, 
    (tmpvar_3 + (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_3 + (vec2(-1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  xlat_mutabledy = (((texture (sampler_blur1, 
    (tmpvar_3 + (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_3 + (vec2(0.0, -1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_4;
  tmpvar_4.x = xlat_mutabledx.x;
  tmpvar_4.y = xlat_mutabledy.x;
  vec2 tmpvar_5;
  tmpvar_5.x = xlat_mutabledx.x;
  tmpvar_5.y = xlat_mutabledy.x;
  vec2 tmpvar_6;
  tmpvar_6.x = xlat_mutabledx.x;
  tmpvar_6.y = xlat_mutabledy.x;
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = mix (mix (mix (vec3(
    (((texture (sampler_blur2, (
      fract((uv + (tmpvar_1 * 1.6)))
     - tmpvar_5)).xyz * scale2) + bias2).z * 0.6)
  ), 
    ((vec3(1.0, -0.2, 0.3) * uv.y) + (vec3(1.0, 1.0, -0.2) * (1.0 - uv.y)))
  , texture (sampler_main, 
    (uv - (tmpvar_6 * 0.4))
  ).zzz), vec3(1.0, 1.0, 1.0), (
    (texture (sampler_blur1, (tmpvar_3 - (tmpvar_4 * 0.4))).xyz * scale1)
   + bias1).xxx), ((vec3(0.5, 0.0, 0.5) * uv.x) + (vec3(0.0, 1.0, 1.0) * 
    (1.0 - uv.x)
  )), texture (sampler_main, tmpvar_3).xxx);
  ret = tmpvar_7.xyz;
 }
