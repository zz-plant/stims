shape_1_per_frame1=bv = 0.1 * treb + 0.7 * bv;
shape_1_per_frame2=tt = tt + 0.05 * bv;
shape_1_per_frame3=r = r + 0.2 * sin(1.4 * tt + 5);
shape_1_per_frame4=g = g + 0.2 * sin(1.6 * tt + 3);
shape_1_per_frame5=b = b + 0.2 * sin(1.8 * tt + 1);
shape_1_per_frame6=r2 = r;
shape_1_per_frame7=b2 = b;
shape_1_per_frame8=g2 = g;
shape_1_per_frame9=x = 0.5 + 0.3 * sin(tt) + 0.1 * sin(time);
shape_1_per_frame10=y = 0.5 + 0.3 * cos(tt) + 0.1 * cos(time);
