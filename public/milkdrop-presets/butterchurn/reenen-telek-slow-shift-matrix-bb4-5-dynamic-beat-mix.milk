shape_0_per_frame1=btime = btime + min(0.1 * bass, 0.05);
shape_0_per_frame2=ang = 0.1 * btime;
shape_0_per_frame3=r = abs(sin(1.4 * time + 5));
shape_0_per_frame4=g = abs(sin(1.6 * time + 3));
shape_0_per_frame5=b = abs(sin(1.8 * time + 1));
shape_0_per_frame6=bt = btime * sign(sin(time / fps));
shape_0_per_frame7=x = ox + 0.01 * sin(bt) + 0.005 * sin(bt + bass);
shape_0_per_frame8=x = if(0.00001 < abs(above(x, 1)), 1 + (1 - x), x);
shape_0_per_frame9=y = oy + 0.01 * cos(bt) + 0.005 * cos(bt + bass);
shape_0_per_frame10=y = if(0.00001 < abs(above(y, 1)), 1 + (1 - y), y);
shape_0_per_frame11=x = if(0.00001 < abs(below(x, 0)), -x, x);
shape_0_per_frame12=y = if(0.00001 < abs(below(y, 0)), -y, y);
shape_0_per_frame13=ox = x;
shape_0_per_frame14=oy = y;
