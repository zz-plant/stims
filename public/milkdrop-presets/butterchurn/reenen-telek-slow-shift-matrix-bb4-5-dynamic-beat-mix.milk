per_frame_init_7=bthresh2 = 0;
per_frame_init_8=ow = 0;
per_frame_init_9=tt = randint(10000);
per_frame_1=warp = 0;
per_frame_2=rate = fps / (fps + 2);
per_frame_3=bv = 0.1 * bass + 0.7 * bv;
per_frame_4=tt = tt + 0.05 * bv;
per_frame_5=beat = above(bass * bass_att, bthresh);
per_frame_6=bthresh = 15 * beat + (1 - beat) * ((bthresh - 4.5) * rate + 4.5);
per_frame_7=beat2 = above(mid, bthresh2);
per_frame_8=bthresh2 = 15 * beat2 + (1 - beat2) * ((bthresh2 - 1.5) * rate + 1.5);
per_frame_9=warp = 3 * beat2 + (1 - beat2) * ow;
per_frame_10=ow = warp * rate * rate;
per_frame_11=tt = if(0.00001 < abs(beat), randint(32768), tt);
per_frame_12=wave_x = -1;
per_frame_13=dx = 0.3 * sin(0.12 * tt) + 10 * sin(0.015 * tt);
per_frame_14=dy = 0.39 * sin(0.21 * tt) + 20 * sin(0.041 * tt);
per_frame_15=rot = sin(0.15 * tt);
per_frame_16=cx = 0.5 * sin(0.16 * tt) + 0.5;
per_frame_17=cy = 0.5 * cos(0.46 * tt) + 0.5;
per_frame_18=ib_r = 0.5 * sin(0.51 * tt) + 0.5;
per_frame_19=ib_g = 0.5 * sin(0.71 * tt) + 0.5;
per_frame_20=ib_b = 0.5 * sin(0.81 * tt) + 0.5;
per_frame_21=ib_a = 1 - pow(0.5, (mid_att + bass_att + treb_att) / 3);
per_frame_22=monitor = 1 - pow(0.5, mid_att + bass_att + treb_att);
per_pixel_1=zoom = 0.8 - 0.2 * pow(1 - rad, 1);
