per_frame_1=scale = 1;
per_frame_2=angle = 0.2 * time;
per_frame_3=translation_x = 0;
per_frame_4=translation_y = 0.1;
per_frame_5=iscale = 1;
per_frame_6=iangle = 0.2;
per_frame_7=itranslation_u = 0;
per_frame_8=itranslation_v = 0;
per_frame_9=a_r = cos(angle) * scale;
per_frame_10=a_i = sin(angle) * scale;
per_frame_11=b_r = translation_x;
per_frame_12=b_i = translation_y;
per_frame_13=c_r = -cos(iangle) * iscale;
per_frame_14=c_i = -sin(iangle) * iscale;
per_frame_15=d_r = itranslation_u;
per_frame_16=d_i = itranslation_v;
per_frame_17=c_inv_r = c_r / (c_r * c_r + c_i * c_i);
per_frame_18=c_inv_i = c_i / (c_r * c_r + c_i * c_i);
per_frame_19=ac_r = a_r * c_inv_r - a_i * c_inv_i;
per_frame_20=ac_i = a_r * c_inv_i - a_i * c_inv_r;
per_frame_21=bcad_r = b_r * c_r - b_i * c_i - (a_r * d_r - a_i * d_i);
per_frame_22=bcad_i = b_r * c_i - b_i * c_r - (a_r * d_i - a_i * d_r);
per_frame_23=mu_r = bcad_r * c_inv_r - bcad_i * c_inv_i;
per_frame_24=mu_i = bcad_r * c_inv_i - bcad_i * c_inv_r;
per_frame_25=q1 = ac_r;
per_frame_26=q2 = ac_i;
per_frame_27=q3 = mu_r;
per_frame_28=q4 = mu_i;
per_frame_29=q5 = c_r;
per_frame_30=q6 = c_i;
per_frame_31=q7 = d_r;
per_frame_32=q8 = d_i;
per_frame_33=monitor = bcad_r;

[warp_shader]
uniform sampler2D sampler_rand00;
 shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_rand00, uv_orig).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = q1;
  tmpvar_1.y = q2;
  vec2 tmpvar_2;
  tmpvar_2.x = q7;
  tmpvar_2.y = q8;
  vec2 tmpvar_3;
  tmpvar_3 = ((uv - 0.5) * aspect.wz);
  vec2 tmpvar_4;
  tmpvar_4.x = ((tmpvar_3.x * q5) - (tmpvar_3.y * q6));
  tmpvar_4.y = ((tmpvar_3.x * q6) - (tmpvar_3.y * q5));
  vec2 tmpvar_5;
  tmpvar_5 = ((tmpvar_4 * aspect.yx) + tmpvar_2);
  vec2 tmpvar_6;
  tmpvar_6.x = ((q3 * tmpvar_5.x) + (q4 * tmpvar_5.y));
  tmpvar_6.y = ((q4 * tmpvar_5.x) - (q3 * tmpvar_5.y));
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = texture (sampler_fc_main, (0.5 + ((
    (1.0 - abs(((
      fract((((tmpvar_6 / 
        ((tmpvar_5.x * tmpvar_5.x) + (tmpvar_5.y * tmpvar_5.y))
      ) + tmpvar_1) * 0.5))
     * 2.0) - 1.0)))
   - 0.5) * 0.99))).xyz;
  ret = tmpvar_7.xyz;
 }
