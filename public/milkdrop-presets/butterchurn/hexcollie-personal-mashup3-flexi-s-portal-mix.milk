shape_0_init30=spi = 0;
shape_0_init31=tm = 0;
shape_0_init32=bob = 1.5;
shape_0_init33=ro = 0;
shape_0_init34=red = randint(20);
shape_0_per_frame1=vol = 1 + 0.2 * ((bass_att + treb_att + mid_att) / 3);
shape_0_per_frame2=bob = bob * above(bob, 0.01) - 0.01 + (1 - above(bob, 0.01));
shape_0_per_frame3=bob = 0.4 + 0.4 * sin(0.8 * time);
shape_0_per_frame4=bob = bob * vol;
shape_0_per_frame5=rad = bob;
shape_0_per_frame6=border_1 = 0.4;
shape_0_per_frame7=sides = 30;
shape_0_per_frame8=ro = ro + 0.02;
shape_0_per_frame9=ang = ro;
shape_0_per_frame10=rad = 0.6;
shape_0_per_frame11=sp = 0.025 * red;
shape_0_per_frame12=spi = 0.5 - sp;
shape_0_per_frame13=tm = 0.1 * time;
shape_0_per_frame14=border_r = 0.5 + sp * sin(0.6 * tm) + spi * cos(1.46 * tm);
shape_0_per_frame15=border_g = 0.5 + sp * sin(1.294 * tm) + spi * cos(0.87 * tm);
shape_0_per_frame16=border_b = 0.5 + sp * sin(1.418 * tm) + spi * cos(0.76 * tm);
shape_1_per_frame1=x = 0.5 + 0.5 * (0.3 * sin(1.1 * time) + 0.7 * sin(0.5 * time));
shape_1_per_frame2=x = 0.5 + 0.225 * sin(time);
shape_1_per_frame3=y = 0.5 + 0.3 * cos(time);
shape_1_per_frame4=rad = rad * mid_att;
shape_1_per_frame5=r = 0.5 + 0.5 * sin(0.5 * frame);
shape_1_per_frame6=b = 0.5 + 0.5 * sin(0.5 * frame + 2.094);
shape_1_per_frame7=g = 0.5 + 0.5 * sin(0.5 * frame + 4.188);
shape_2_per_frame1=x = 0.5 + 0.5 * (0.3 * sin(1.1 * time) + 0.7 * sin(0.5 * time));
shape_2_per_frame2=x = 0.5 + 0.225 * sin(time + 2.09);
shape_2_per_frame3=y = 0.5 + 0.3 * cos(time + 2.09);
shape_2_per_frame4=rad = rad * bass_att;
shape_2_per_frame5=r = 0.5 + 0.5 * sin(0.5 * frame);
shape_2_per_frame6=b = 0.5 + 0.5 * sin(0.5 * frame + 2.094);
shape_2_per_frame7=g = 0.5 + 0.5 * sin(0.5 * frame + 4.188);
shape_3_per_frame1=x = 0.5 + 0.5 * (0.3 * sin(1.1 * time) + 0.7 * sin(0.5 * time));
shape_3_per_frame2=x = 0.5 + 0.225 * sin(time + 4.19);
shape_3_per_frame3=y = 0.5 + 0.3 * cos(time + 4.19);
shape_3_per_frame4=rad = rad * treb_att;
shape_3_per_frame5=r = 0.5 + 0.5 * sin(0.5 * frame);
shape_3_per_frame6=b = 0.5 + 0.5 * sin(0.5 * frame + 2.094);
shape_3_per_frame7=g = 0.5 + 0.5 * sin(0.5 * frame + 4.188);

[comp_shader]
shader_body { 
  float ang2_1;
  float tmpvar_2;
  tmpvar_2 = ((rad * sqrt(
    dot (texsize.xy, texsize.xy)
  )) * 0.5);
  ang2_1 = ((ang * 0.1591549) + ((time * 0.015) - (tmpvar_2 * 0.0002)));
  ang2_1 = (fract((ang2_1 * 7.0)) / 7.0);
  ang2_1 = (abs((ang2_1 - 0.07142857)) * 6.283185);
  vec2 tmpvar_3;
  tmpvar_3.x = cos(ang2_1);
  tmpvar_3.y = sin(ang2_1);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, (0.5 + (
    ((tmpvar_2 * 0.8) * tmpvar_3)
   * texsize.zw))).xyz * 1.333);
  ret = tmpvar_4.xyz;
 }
