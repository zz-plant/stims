per_frame_init_1=beatfreq = 0;
per_frame_init_2=dle = 0;
per_frame_init_3=pulsefreq = 0;
per_frame_init_4=bccl = 0;
per_frame_init_5=bt = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=lastbeat = 0;
per_frame_init_8=pulse = 0;
per_frame_init_9=q4 = 0;
per_frame_init_10=dqv = 0;
per_frame_init_11=le = 0;
per_frame_init_12=btblock = 0;
per_frame_init_13=leccl = 0;
per_frame_init_14=beat = 0;
per_frame_init_15=hccp = 0;
per_frame_init_16=q2 = 0;
per_frame_init_17=lastpulse = 0;
per_frame_init_18=q3 = 0;
per_frame_init_19=eo = 0;
per_frame_init_20=th = 0;
per_frame_init_21=thccl = 0;
per_frame_init_22=dle = 1;
per_frame_1=le = 1.4 * bass_att + 0.1 * bass + 0.5 * treb;
per_frame_2=pulse = above(le, th);
per_frame_3=pulsefreq = if(0.00001 < abs(equal(pulsefreq, 0)), 2, if(0.00001 < abs(pulse), 0.8 * pulsefreq + 0.2 * (time - lastpulse), pulsefreq));
per_frame_4=lastpulse = if(0.00001 < abs(pulse), time, lastpulse);
per_frame_5=bt = (time - lastbeat) / (0.5 * beatfreq + 0.5 * pulsefreq);
per_frame_6=hccp = 0.03 / (bt + 0.2) + 0.5 * if(0.00001 < abs(band(above(bt, 0.8), below(bt, 1.2))), pow(sin(7.854 * (bt - 1)), 4) - 1, 0);
per_frame_7=beat = band(above(le, th + hccp), btblock);
per_frame_8=btblock = 1 - above(le, th + hccp);
per_frame_9=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_10=beatfreq = if(0.00001 < abs(equal(beatfreq, 0)), 2, if(0.00001 < abs(beat), 0.8 * beatfreq + 0.2 * (time - lastbeat), beatfreq));
per_frame_11=th = if(0.00001 < abs(above(le, th)), le + 114 / (le + 10) - 7.407, th + 0.07 * th / (th - 12) + 0.1 * below(th, 2.7) * (2.7 - th));
per_frame_12=th = if(0.00001 < abs(above(th, 6)), 6, th);
per_frame_13=thccl = thccl + (th - 2.5144);
per_frame_14=q1 = le;
per_frame_15=q2 = thccl + 0.2 * leccl;
per_frame_16=leccl = leccl + dle * le;
per_frame_17=dle = if(0.00001 < abs(beat), -dle, dle);
per_frame_18=bccl = bccl + beat;
per_frame_19=wave_r = 0.1 + 0.8 * sqr(sin(0.011 * thccl)) + 0.1 * sin(0.061 * leccl);
per_frame_20=wave_g = 0.1 + 0.8 * sqr(sin(0.013 * thccl)) + 0.1 * cos(0.067 * leccl);
per_frame_21=wave_b = 0.1 + 0.8 * sqr(cos(0.017 * thccl)) + 0.1 * sin(0.065 * leccl);
per_frame_22=ib_r = ib_r + 0.1 * sin(1.3 * time + 0.012 * leccl);
per_frame_23=ib_g = ib_g + 0.1 * sin(1.7 * time + 0.019 * leccl);
per_frame_24=ib_b = ib_b + 0.1 * sin(1.9 * time + 0.017 * leccl);
per_frame_25=mv_r = 0.5 * (ib_r + wave_r);
per_frame_26=mv_g = 0.5 * (ib_g + wave_g);
per_frame_27=mv_b = 0.5 * (ib_b + wave_b);
per_frame_28=mv_a = 0.5 * sqr(sin(0.01 * leccl + bccl));
per_frame_29=echo_alpha = 0.5 + 0.2 * cos(0.07 * leccl + 0.02 * thccl);
per_frame_30=eo = if(0.00001 < abs(band(equal(mod(bccl, 3), 0), beat)), randint(4), eo);
per_frame_31=q3 = (equal(eo, 2) + equal(eo, 1)) * equal(mod(bccl, 2), 0);
per_frame_32=q4 = (equal(eo, 0) + equal(eo, 3)) * equal(mod(bccl, 2), 0);
per_frame_33=echo_orient = eo;
per_pixel_1=dqv = above(x, 0.5) - above(y, 0.5);
per_pixel_2=rot = sin(sin(rad * (13 + 5 * sin(0.01 * q2)) + 0.06 * q2) * q1 * 0.01);
per_pixel_3=zoom = 1 + 0.1 * if(0.00001 < abs(q3), dqv, 1) * sin(7 * ang + 0.03 * q2);
per_pixel_4=zoom = if(0.00001 < abs(q4), if(0.00001 < abs(below(rad, 0.8 * sqr(sin(0.016 * q2)))), 0.75 + 0.4 * cos(0.021 * q2), zoom), zoom);
shape_0_init1=vol = 0;
shape_0_init2=bob = 0;
shape_0_init3=bob = 0;
shape_0_init4=bob = 0;
shape_0_init5=bob = 0;
shape_0_init6=bob = 0;
shape_0_init7=bob = 0;
shape_0_init8=bob = 0;
