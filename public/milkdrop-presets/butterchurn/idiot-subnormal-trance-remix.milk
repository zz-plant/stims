per_frame_init_1=d = 0;
per_frame_init_2=rady = 0;
per_frame_init_3=q6 = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q5 = 0;
per_frame_init_6=snare = 0;
per_frame_init_7=q4 = 0;
per_frame_init_8=rad_cycle = 0;
per_frame_init_9=r = 0;
per_frame_init_10=x2 = 0;
per_frame_init_11=smear = 0;
per_frame_init_12=y2 = 0;
per_frame_init_13=q2 = 0;
per_frame_init_14=q3 = 0;
per_frame_init_15=radx = 0;
per_frame_init_16=q7 = 0;
per_frame_init_17=q8 = 0;
per_frame_1=q1 = band(bass, 0.43 * time);
per_frame_2=q2 = band(bass_att, 0.63 * time);
per_frame_3=q3 = band(treb, 0.76 * time);
per_frame_4=q4 = band(treb_att, 0.61 * time);
per_frame_5=q5 = band(mid, 0.27 * time);
per_frame_6=q6 = band(mid_att, 0.23 * time);
per_frame_7=q7 = if(0.00001 < abs(above(below(q1, q3), below(q3, q1))), q3 - q2 * sin(q1), q2 - q1 * sin(q3));
per_frame_8=q8 = if(0.00001 < abs(above(below(q2, q3), below(q2, q1))), q2 - q1 * sin(q5), q5 - q6 * sin(q7));
per_frame_9=wave_r = wave_r + 0.6 * sin(q1);
per_frame_10=wave_b = wave_b + 0.3 * sin(q2);
per_frame_11=wave_g = wave_g * sin(q7);
per_frame_12=ob_r = wave_r;
per_frame_13=ob_b = wave_b;
per_frame_14=ob_g = wave_g;
per_frame_15=ib_r = wave_r;
per_frame_16=ib_g = wave_b;
per_frame_17=ib_b = wave_g;
per_pixel_1=rad_cycle = rad * rad * x * 60 * rad * sin(q6) + 1;
per_pixel_2=d = 0.03 * sin(3.14 * rad * sin(q3)) + 1;
per_pixel_3=r = d - 0.03 * sin(3.14 * ang * sin(q2));
per_pixel_4=radx = below(0.3 - rad + x, 0.3 + rad - x);
per_pixel_5=rady = below(0.3 - rad + y, 0.3 + rad - y);
per_pixel_6=snare = below(1 * rad - x - y, x - rad - 0.3 - x - y * d * r) * sin(q1 - d + r) * d * r + 0.01;
per_pixel_7=x2 = above(x, rad) + 0.01;
per_pixel_8=y2 = above(y, rad) + 0.01;
per_pixel_9=smear = if(0.00001 < abs(equal(rad - 0.03, ang * rad)), smear * sin(q1), rot - 0.1 * ang / 2 / 2 / 2 / 2 * rad * sin(rad) * sin(q3) * sin(rad_cycle + 0.3 * sin(q1) + 0.1) + 0.03 * sin(q2)) + 0.01 * sin(rad_cycle);
per_pixel_10=zoom = zoom - 0.05 * sin(ang * rad * 3.14 * sin(q1)) - 0.05 * sin(3.14 * rad * sin(q2)) + 0.05 * sin(3.14 * ang * sin(q3));
per_pixel_11=rot = rot + 0.03 * sin(3.14 * ang) * rad + 0.02 * sin(q1 - rad * x * 3.14) * sin(q1);
