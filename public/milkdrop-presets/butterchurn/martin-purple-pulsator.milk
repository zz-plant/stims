[warp_shader]
vec3 xlat_mutablemus;
 shader_body { 
  vec2 uv_1;
  uv_1 = uv;
  vec2 rs_2;
  vec2 uv6_3;
  vec2 tmpvar_4;
  tmpvar_4 = ((uv - 0.5) * aspect.xy);
  uv6_3 = tmpvar_4;
  float tmpvar_5;
  tmpvar_5 = (((q27 * 0.05) * sqrt(
    dot (tmpvar_4, tmpvar_4)
  )) + q30);
  vec2 tmpvar_6;
  tmpvar_6 = clamp (((
    sin(tmpvar_5)
   / 
    cos(tmpvar_5)
  ) * normalize(tmpvar_4)), vec2(-8.0, -8.0), vec2(8.0, 8.0));
  rs_2 = tmpvar_6;
  if ((q28 == 1.0)) {
    rs_2 = (tmpvar_6 * sin((uv * 5.0)));
  };
  uv_1 = (uv + ((rs_2 * 
    dot (rs_2, rs_2)
  ) / 60.0));
  uv6_3 = ((uv_1 - 0.5) * (1.0 + (q1 * q27)));
  xlat_mutablemus = (abs(vec3((0.1 / 
    sqrt((uv6_3.y - 0.2))
  ))) * vec3(0.8, 0.6, 1.0));
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = (((
    (texture (sampler_main, uv_1).xyz - (((texture (sampler_blur1, 
      fract(uv_1)
    ).xyz * scale1) + bias1) * 0.05))
   + 
    (0.06 * xlat_mutablemus)
  ) * 0.99) - 0.01);
  ret = tmpvar_7.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (((uv - 0.5) * aspect.xy) + 0.5);
  vec2 tmpvar_3;
  tmpvar_3 = (1.0 - uv_1);
  ret_2 = ((texture (sampler_main, uv_1).xyz + (2.0 * 
    ((texture (sampler_blur2, uv_1).xyz * scale2) + bias2)
  )) + (texture (sampler_main, tmpvar_3).xyz + (2.0 * 
    ((texture (sampler_blur2, tmpvar_3).xyz * scale2) + bias2)
  )));
  ret_2 = (ret_2 * 1.4);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_2;
  ret = tmpvar_4.xyz;
 }
