  tmpvar_8.y = tmpvar_5.z;
  ret_1.z = texture (sampler_fc_main, (tmpvar_2 + ((tmpvar_8 * texsize.zw) * 4.0))).z;
  ret_1 = (ret_1 - ((
    (ret_1.yzx + ret_1.zxy)
   * 0.16) + 0.002));
  ret_1 = (ret_1 + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 1.2)) + rand_frame.xy)
  ).xyz - 0.5) * 0.04));
  vec4 tmpvar_9;
