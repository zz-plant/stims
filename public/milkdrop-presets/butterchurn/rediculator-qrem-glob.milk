per_frame_30=monitor = q13;
per_frame_31=q4 = sin(0.03 * atime);
per_frame_32=q5 = cos(0.030383824 * atime);
per_frame_33=q6 = tan(0.029384834 * atime);
per_frame_34=dec_med = pow(0.7, 30 / fps);
per_frame_35=dec_slow = pow(0.9, 30 / fps);
per_frame_36=beat = max(max(bass, mid), treb);
per_frame_37=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_38=is_beat = above(beat, -0.5 + avg + peak) * above(time, t0 + 0.1);
per_frame_39=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_40=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_41=index = mod(index + is_beat, 64);
per_frame_42=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_43=q20 = avg;
per_frame_44=q21 = beat;
per_frame_45=q22 = peak;
per_frame_46=q24 = is_beat;
per_frame_47=q29 = 2 * (mod(index2, 2) - 0.5);
per_frame_48=q25 = min(1, q22 / 2);
per_frame_49=k1 = is_beat * equal(mod(index, 4), 0);
per_frame_50=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_51=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_52=rott = 3.1416 * p2 / 4;
per_frame_53=q1 = cos(rott);
per_frame_54=q2 = sin(rott);
per_frame_55=q3 = -q2;
per_frame_56=q4 = q1;
per_frame_57=q26 = 8 + 8 * index2;
per_frame_58=q27 = index;
per_frame_59=q28 = index2;
per_frame_60=trot = 6.28 * index / 4;
per_frame_61=q5 = cos(trot);
per_frame_62=q6 = sin(trot);
per_frame_63=q7 = -q6;
per_frame_64=q8 = q5;
per_frame_65=q29 = sin(time / 4);
per_frame_66=wave_mystery = q29 / 2;
per_frame_67=q30 = 0.03 * mod(index, 32) / 32;
per_frame_68=monitor = q30;
per_pixel_1=zoom = 1 + 0.02 * rad;
