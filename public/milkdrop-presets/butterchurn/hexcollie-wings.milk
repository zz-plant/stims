per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_init_4=six = 0;
per_frame_1=wave_r = wave_r + 0.35 * sin(1.14 * time) + 0.16 * sin(1.5 * time);
per_frame_2=wave_g = wave_g + 0.36 * sin(1.27 * time) + 0.15 * sin(1.11 * time);
per_frame_3=wave_b = wave_b + 0.37 * sin(1.284 * time) + 0.15 * sin(1.3 * time);
per_frame_4=warp = 0;
per_frame_5=ob_r = ob_r + wave_b * above(sin(0.1 * time), 0);
per_frame_6=ob_b = ob_b + wave_g * above(sin(0.1 * time), 0);
per_frame_7=ob_g = ob_g + wave_r * above(sin(0.1 * time), 0);
per_frame_8=ob_r = ob_r + wave_g * below(sin(0.1 * time), 0);
per_frame_9=ob_b = ob_b + wave_r * below(sin(0.1 * time), 0);
per_frame_10=ob_g = ob_g + wave_b * below(sin(0.1 * time), 0);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.15 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.165 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=six = sin(x);
per_pixel_5=dx = dx + 0.014 * sin(abs(18 * y)) * sin(time);
per_pixel_6=dy = dy + 0.014 * sin(abs(18 * x)) * cos(time);
per_pixel_7=dx = dx + 0.02975 * pow(rad, 2 * x) * sin(time);
per_pixel_8=dy = dy + 0.02975 * pow(rad, 2 * y) * cos(time);
per_pixel_9=zoom = zoom - 0.0825 * pow(rad, 6 * x) * cos(12 * ang);
per_pixel_10=rot = rot - 0.525 * 0.75 * sin(1.25 * time) * pow(rad, x) * sin(1.45 * time) * sin(time);
wave_0_init1=n = 0;
wave_0_init2=size = 0;
wave_0_init3=flux = 0;
wave_0_init4=tm = 0;
wave_0_per_point1=n = 6.283 * sample;
wave_0_per_point2=size = 0.165;
wave_0_per_point3=x = 0;
wave_0_per_point4=y = sample;
wave_0_per_point5=flux = 0.5 * sin(2 * n - time) + 0.5;
wave_0_per_point6=flux = flux * min(10 * (1 - 2 * abs(y - 0.5)), 1);
wave_0_per_point7=tm = 0.3 * time;
wave_0_per_point8=r = 0.5 * sin(n + tm) + 0.5;
wave_0_per_point9=g = 0.5 * sin(n + 2.1 + tm) + 0.5;
wave_0_per_point10=b = 0.5 * sin(n + 4.2 + tm) + 0.5;
wave_0_per_point11=r = r * flux;
wave_0_per_point12=g = g * flux;
wave_0_per_point13=b = b * flux;
wave_1_init1=n = 0;
wave_1_init2=size = 0;
wave_1_per_point1=n = 6.283 * sample;
wave_1_per_point2=size = 0.165;
wave_1_per_point3=x = 0.999;
wave_1_per_point4=y = sample;
wave_1_per_point5=r = 0;
wave_1_per_point6=g = 0;
wave_1_per_point7=b = 0;
shape_1_per_frame1=tex_ang = 6.28 * sin(time / 10);
shape_3_per_frame1=tex_ang = 6.28 * sin(time / 5);
