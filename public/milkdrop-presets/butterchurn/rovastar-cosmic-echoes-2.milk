[preset00]
fRating=5.000000
fGammaAdj=1.840000
fDecay=0.900000
fVideoEchoZoom=2.215847
nWaveMode=6.000000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bMotionVectorsOn=0.000000
fWaveAlpha=4.099998
fWaveScale=0.130388
fWaveSmoothing=0.540000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=0.999514
fWarp=0.010000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fWaveX=0.000000
fOuterBorderSize=0.500000
fOuterBorderR=0.010000
fInnerBorderSize=0.260000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=blue = 0;
per_frame_init_2=red_aim = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_init_4=bass_on = 0;
per_frame_init_5=treb_thresh = 0;
per_frame_init_6=treb_on = 0;
per_frame_init_7=green = 0;
per_frame_init_8=red = 0;
per_frame_init_9=blue_aim = 0;
per_frame_init_10=swapcolour = 0;
per_frame_init_11=green_aim = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.85 * (bass_thresh - 1.4) + 1.4);
per_frame_2=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.75 * (treb_thresh - 1.5) + 1.5);
per_frame_3=bass_on = above(bass_thresh, 1.8);
per_frame_4=treb_on = above(treb_thresh, 1.9);
per_frame_5=swapcolour = bass_on - treb_on;
per_frame_6=red_aim = if(0.00001 < abs(equal(swapcolour, 1)), 1, if(0.00001 < abs(equal(swapcolour, 0)), 1, 0));
per_frame_7=green_aim = if(0.00001 < abs(equal(swapcolour, 1)), 0, if(0.00001 < abs(equal(swapcolour, 0)), 0.5, 0.25));
per_frame_8=blue_aim = if(0.00001 < abs(equal(swapcolour, 1)), 0, if(0.00001 < abs(equal(swapcolour, 0)), 0, 1));
per_frame_9=red = red + (red_aim - red) * if(0.00001 < abs(equal(swapcolour, 1)), 0.65, 0.45);
per_frame_10=green = green + 0.5 * (green_aim - green);
per_frame_11=blue = blue + (blue_aim - blue) * if(0.00001 < abs(equal(swapcolour, 1)), 0.45, 0.65);
per_frame_12=wave_r = red;
per_frame_13=wave_g = green;
per_frame_14=wave_b = blue;
per_pixel_1=dy = if(0.00001 < abs(above(y, 0.5)), sin(0.5 - y) / 10, log10(1 / y) / 35);
