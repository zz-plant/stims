wave_3_per_point8=alp = alp * alp;
wave_3_per_point9=a = alp * (1 - t1) + t1;
wave_3_per_point10=zran = 0.001 * zran * offran;
wave_3_per_point11=xran = 0.001 * xran * offran;
wave_3_per_point12=yran = 0.001 * yran * offran;
wave_3_per_point13=xseed = sin(3.14 * sample + 15 * time) + 0.4 * sin(11 * sample);
wave_3_per_point14=yseed = cos(3.14 * sample + 9 * time) + 0.4 * sin(17 * sample + time);
wave_3_per_point15=t2 = t2 + xseed * sparkcycle;
