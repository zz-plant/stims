shape_1_per_frame1=rate = fps / (fps + 1 / 2);
shape_1_per_frame2=beat = above(bass, bassthresh);
shape_1_per_frame3=bassthresh = 4 * beat + (1 - beat) * ((bassthresh - 1.5) * rate + 1.5);
shape_1_per_frame4=ran = randint(8) + 4;
shape_1_per_frame5=poly = if(0.00001 < abs(beat), if(0.00001 < abs(equal(ran, poly)), poly + 1, ran), poly);
shape_1_per_frame6=sides = poly;
shape_1_per_frame7=rate2 = fps / (fps + 10);
shape_1_per_frame8=out = (1 - beat) * rate2 * out + beat;
shape_1_per_frame9=border_a = out;
shape_1_per_frame10=te = bass / fps / 2 + te;
shape_1_per_frame11=x = x + 0.056 * sin(1.67 * te);
shape_1_per_frame12=y = y + 0.043 * sin(1.23 * te);
shape_1_per_frame13=ang = 3 * sin(0.67 * -te) + 3 * cos(0.4 * te);
shape_1_per_frame14=rad = rad * (0.9 + 0.2 * t2) - 0.1 * sin(1.51 * te);
shape_1_per_frame15=r = min(1, max(0, r + 0.3 * sin(0.427 * time + 1)));
shape_1_per_frame16=g = min(1, max(0, g + 0.3 * sin(0.401 * time + 2)));
