per_frame_1=wave_r = 0 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = 0 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = 0 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
