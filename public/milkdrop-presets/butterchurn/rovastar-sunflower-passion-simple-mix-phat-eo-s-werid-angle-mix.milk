per_frame_13=wave_a = 0;
per_frame_14=decay = 1;
per_frame_15=q8 = oldq8 + 0.0005 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_16=oldq8 = q8;
per_frame_17=mybass = mybass + 0.01 * (bass + bass_att);
per_frame_18=rot = 1 + 0.15 * sin(0.1789 * mybass);
per_frame_19=zoom = 1.6 + 0.1 * sin(0.786 * mybass);
per_frame_20=musictime = musictime + mid * mid * mid * 0.01;
per_frame_21=xpos = 0.1 * sin(0.6 * musictime);
per_frame_22=ypos = 0.1 * sin(0.4 * musictime);
per_frame_23=q4 = xpos;
per_frame_24=q5 = ypos;
per_pixel_1=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_2=myx = 2 * (x - q1);
per_pixel_3=myy = 2 * (y - q2);
per_pixel_4=myrad = myx * myx / (6 * ag) + myy * myy / (6 * ag);
per_pixel_5=dx = 0.1 * (myy / (myrad + 1));
per_pixel_6=dy = -0.1 * (myx / (myrad + 1));
