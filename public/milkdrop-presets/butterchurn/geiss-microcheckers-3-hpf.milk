[preset00]
fRating=0.000000
fDecay=0.990000
nWaveMode=7.000000
bAdditiveWaves=1.000000
fWaveAlpha=1.000000
fWaveScale=1.372000
fWaveSmoothing=0.171000
fWaveParam=-0.160000
fModWaveAlphaStart=0.850000
fModWaveAlphaEnd=1.530000
fWarpAnimSpeed=0.556000
fWarpScale=0.451000
fZoom=0.970000
fRot=-0.020000
fWarp=2.372480
fWaveR=0.860000
fWaveG=0.610000
fWaveB=0.290000
fWaveY=0.450000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=q2 = 0;
per_frame_1=wave_r = wave_r + 0.2 * (0.6 * sin(1.517 * time) + 0.4 * sin(1.58 * time));
per_frame_2=wave_g = wave_g + 0.2 * (0.6 * sin(1.088 * time) + 0.4 * sin(1.076 * time));
per_frame_3=wave_b = wave_b + 0.2 * (0.6 * sin(1.037 * time) + 0.4 * sin(0.922 * time));
per_frame_4=rot = rot + 0.02 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=q1 = cos(1.41 * time);
per_frame_8=q2 = time + 0.3 * sin(1.47 * time);

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (uv_orig * texsize.xy);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (texture (sampler_main, mix (uv, (
    ((uv_orig - 0.5) * 0.91)
   + 0.5), vec2(clamp (
    (2.0 * fract(((
      (tmpvar_1.x + tmpvar_1.y)
     * 0.5) + 0.25)))
  , 0.0, 1.0)))).xyz * (0.8 + (0.17 * 
    clamp ((rad * 5.0), 0.0, 1.0)
  )));
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz - ((texture (sampler_blur1, uv).xyz * scale1) + bias1));
  ret_1 = (abs(ret_1) * 3.8);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
