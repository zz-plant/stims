shape_0_per_frame1=pigtemp = floor(pow(4, bass + treb + mid));
shape_0_per_frame2=num_inst = if(0.00001 < abs(above(pigtemp, 1024)), 1024, pigtemp);
shape_0_per_frame3=t1 = time / 5;
shape_0_per_frame4=t2 = time / 6;
shape_0_per_frame5=rad = 0.005 + bass / 100;
shape_0_per_frame6=t3 = bass_att / 70;
shape_0_per_frame7=b2 = 0.7 * treb - bass / 2;
shape_0_per_frame8=r = instance / num_inst;
shape_0_per_frame9=g = abs(treb_att / 5 - bass);
shape_0_per_frame10=size = 0.3 + bass_att / 300;
shape_0_per_frame11=nc = sqrt(num_inst);
shape_0_per_frame12=xs = sin(6.28 * mod(instance, nc) / nc) * sin(3.14 * floor(instance / nc) / nc);
shape_0_per_frame13=ys = cos(6.28 * mod(instance, nc) / nc) * sin(3.14 * floor(instance / nc) / nc);
shape_0_per_frame14=zs = cos(3.14 * floor(instance / nc) / nc);
shape_0_per_frame15=y1 = ys * cos(t1) - zs * sin(t1);
shape_0_per_frame16=z1 = ys * sin(t1) + zs * cos(t1);
shape_0_per_frame17=x1 = z1 * sin(t2) + xs * cos(t2);
shape_0_per_frame18=z2 = z1 * cos(t2) - xs * sin(t2);
shape_0_per_frame19=x2 = x1 * cos(t3) - y1 * sin(t3);
shape_0_per_frame20=y2 = y1 * cos(t3) + x1 * sin(t3);
shape_0_per_frame21=x3 = x2;
shape_0_per_frame22=y3 = y2;
shape_0_per_frame23=z3 = z2;
shape_0_per_frame24=x = 0.5 + size * (x3 / (1 + z3 * size));
shape_0_per_frame25=y = 0.5 + size * (y3 / (1 + z3 * size));
shape_0_per_frame26=a = below(z3, 0);

[warp_shader]
vec2 xlat_mutablec;
vec2 xlat_mutabletmp;
vec2 xlat_mutablezz;
 shader_body { 
  vec3 ret_1;
  xlat_mutablec = (((uv_orig - 0.5) * 4.0) + vec2(-0.5, 0.0));
  xlat_mutablezz.x = ((xlat_mutablec.x * xlat_mutablec.x) - (xlat_mutablec.y * xlat_mutablec.y));
  xlat_mutablezz.y = ((2.0 * xlat_mutablec.x) * xlat_mutablec.y);
  xlat_mutablezz = (xlat_mutablezz + xlat_mutablec);
  xlat_mutabletmp = xlat_mutablezz;
  xlat_mutablezz.x = ((xlat_mutablezz.x * xlat_mutablezz.x) - (xlat_mutablezz.y * xlat_mutablezz.y));
  xlat_mutablezz.y = ((2.0 * xlat_mutabletmp.x) * xlat_mutabletmp.y);
  xlat_mutablezz = (xlat_mutablezz + xlat_mutablec);
  xlat_mutabletmp = xlat_mutablezz;
  xlat_mutablezz.x = ((xlat_mutablezz.x * xlat_mutablezz.x) - (xlat_mutablezz.y * xlat_mutablezz.y));
  xlat_mutablezz.y = ((2.0 * xlat_mutabletmp.x) * xlat_mutabletmp.y);
  xlat_mutablezz = (xlat_mutablezz + xlat_mutablec);
  xlat_mutabletmp = xlat_mutablezz;
  xlat_mutablezz.x = ((xlat_mutablezz.x * xlat_mutablezz.x) - (xlat_mutablezz.y * xlat_mutablezz.y));
  xlat_mutablezz.y = ((2.0 * xlat_mutabletmp.x) * xlat_mutabletmp.y);
  xlat_mutablezz = (xlat_mutablezz + xlat_mutablec);
  xlat_mutabletmp = xlat_mutablezz;
  xlat_mutablezz.x = ((xlat_mutablezz.x * xlat_mutablezz.x) - (xlat_mutablezz.y * xlat_mutablezz.y));
  xlat_mutablezz.y = ((2.0 * xlat_mutabletmp.x) * xlat_mutabletmp.y);
  xlat_mutablezz = (xlat_mutablezz + xlat_mutablec);
  xlat_mutabletmp = xlat_mutablezz;
  xlat_mutablezz.x = ((xlat_mutablezz.x * xlat_mutablezz.x) - (xlat_mutablezz.y * xlat_mutablezz.y));
  xlat_mutablezz.y = ((2.0 * xlat_mutabletmp.x) * xlat_mutabletmp.y);
  xlat_mutablezz = (xlat_mutablezz + xlat_mutablec);
  ret_1 = (((texture (sampler_noise_lq, 
    (abs(xlat_mutablezz) / 12.0)
  ) * 0.15) / (
    dot (xlat_mutablezz, xlat_mutablezz)
   + 2.0)).xyz + texture (sampler_fc_main, (uv + (xlat_mutablezz * q18))).xyz);
  ret_1 = ((ret_1 * 0.99) - 0.01);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
vec2 xlat_mutabledz;
vec3 xlat_mutableneu;
vec3 xlat_mutableret1;
vec2 xlat_mutableuv3;
 shader_body { 
  vec2 uv2_1;
  vec2 tmpvar_2;
  tmpvar_2.y = 0.0;
  tmpvar_2.x = texsize.z;
  vec2 tmpvar_3;
  tmpvar_3.x = 0.0;
  tmpvar_3.y = texsize.w;
  xlat_mutabledz.x = dot ((texture (sampler_main, (uv + tmpvar_2)).xyz - texture (sampler_main, (uv - tmpvar_2)).xyz), vec3(0.32, 0.49, 0.29));
  xlat_mutabledz.y = dot ((texture (sampler_main, (uv + tmpvar_3)).xyz - texture (sampler_main, (uv - tmpvar_3)).xyz), vec3(0.32, 0.49, 0.29));
  uv2_1 = (uv - 0.5);
  xlat_mutableuv3 = ((0.2 * uv2_1) + 0.5);
  float tmpvar_4;
  tmpvar_4 = (time / 2.0);
  xlat_mutableuv3 = ((0.2 * cos(
    ((42.0 * fract(xlat_mutableuv3)) + tmpvar_4)
  )) + (99.0 * xlat_mutabledz));
  float tmpvar_5;
  tmpvar_5 = clamp ((0.01 / sqrt(
    dot (xlat_mutableuv3, xlat_mutableuv3)
  )), 0.0, 1.0);
  xlat_mutableneu = ((0.1 * vec3(tmpvar_5)) + (0.9 * dot (vec3(tmpvar_5), vec3(0.32, 0.49, 0.29))));
  xlat_mutableret1 = max (vec3(0.0, 0.0, 0.0), (xlat_mutableneu * 1.252262));
  xlat_mutableuv3 = ((0.2 * uv2_1) + 0.5);
  xlat_mutableuv3 = ((0.2 * cos(
    ((42.0 * fract(xlat_mutableuv3)) + tmpvar_4)
  )) + (99.0 * xlat_mutabledz));
  float tmpvar_6;
  tmpvar_6 = clamp ((0.01 / sqrt(
    dot (xlat_mutableuv3, xlat_mutableuv3)
  )), 0.0, 1.0);
  xlat_mutableneu = ((0.1 * vec3(tmpvar_6)) + (0.9 * dot (vec3(tmpvar_6), vec3(0.32, 0.49, 0.29))));
  xlat_mutableret1 = max (xlat_mutableret1, (xlat_mutableneu * 1.252262));
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = (xlat_mutableret1 + clamp ((
    (16.0 * ((0.5 * texture (sampler_main, (uv + 
      (0.1 * xlat_mutabledz)
    )).xyz) + 0.01))
   * 
    (0.1 + xlat_mutableret1)
  ), 0.0, 1.0));
  ret = tmpvar_7.xyz;
 }
