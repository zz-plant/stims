[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=2.000000
nWaveMode=2.000000
bWaveThick=1.000000
fWaveAlpha=100.000000
fWaveScale=0.796897
fWaveSmoothing=0.900000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.100000
fOuterBorderA=0.100000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 0.25 * sin(1.4 * time) + 0.25 * sin(2.25 * time);
per_frame_2=wave_g = wave_g + 0.25 * sin(1.7 * time) + 0.25 * sin(2.11 * time);
per_frame_3=wave_b = wave_b + 0.25 * sin(1.84 * time) + 0.25 * sin(2.3 * time);
per_frame_4=warp = 0;
per_frame_5=wave_x = wave_x + 0.051 * sin(1.23 * time) - 0.08 * sin(0.2 * time);
per_frame_6=wave_y = wave_y + 0.01 * cos(1.24 * time) - 0.05 * cos(0.1 * time);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 0.2 * sin(ang * (0.5 - rad) * rad);
per_pixel_5=dx = dx + 5 * dx_r * rad * sin(time + cos(12 * ang) * (0.5 - rad)) * cos(bass) * sin(time);
per_pixel_6=dy = dy + 5 * dy_r * rad * cos(time + sin(12 * ang) * (0.5 - rad)) * sin(bass);
per_pixel_7=sy = sy + 0.7 * rad * cos(2 - 12 * ang * sin(time) / treb) * dx_r;
per_pixel_8=sx = sx + 0.7 * rad * sin(2 - 12 * ang * cos(time) / treb) * dy_r;
