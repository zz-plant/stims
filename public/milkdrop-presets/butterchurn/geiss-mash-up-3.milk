[preset00]
fRating=0.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169360
nWaveMode=3.000000
bAdditiveWaves=1.000000
fWaveAlpha=0.001645
fWaveScale=0.899719
fWaveSmoothing=0.630000
fWaveParam=1.000000
fModWaveAlphaStart=2.000000
fModWaveAlphaEnd=2.000000
fWarpScale=2.593743
fZoom=1.004960
fWarp=0.278033
fSx=0.999666
fSy=0.999900
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
nMotionVectorsX=0.000000
nMotionVectorsY=48.000000
nMotionVectorsDx=-0.941273
nMotionVectorsDy=0.426319
nMotionVectorsLoop=5.000000
fMotionVectorsR=0.315997
fMotionVectorsG=0.078173
fMotionVectorsB=0.941976
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=du = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=mult = 0;
per_frame_init_4=ang2 = 0;
per_frame_init_5=dv = 0;
per_frame_init_6=q4 = 0;
per_frame_init_7=q2 = 0;
per_frame_init_8=dist = 0;
per_frame_init_9=q3 = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=q1 = 2 * cx - 1 + 0.62 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_5=q2 = 2 * cy - 1 + 0.62 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_6=q3 = 2 * cx - 1 + 0.62 * (0.6 * sin(0.174 * -time) + 0.4 * sin(0.364 * time));
per_frame_7=q4 = 2 * cy - 1 + 0.62 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.271 * -time));
per_frame_8=decay = decay - 0.01 * equal(mod(frame, 5), 0);
per_pixel_1=du = 2 * x - 1 - q1;
per_pixel_2=dv = 2 * y - 1 - q2;
per_pixel_3=dist = sqrt(du * du + dv * dv);
per_pixel_4=ang2 = atan2(du, dv);
per_pixel_5=mult = 0.008 / (dist + 0.4);
per_pixel_6=dx = mult * sin(ang2 - 1.5);
per_pixel_7=dy = mult * cos(ang2 - 1.5);
per_pixel_8=du = 2 * x - 1 - q3;
per_pixel_9=dv = 2 * y - 1 - q4;
per_pixel_10=dist = sqrt(du * du + dv * dv);
per_pixel_11=ang2 = atan2(du, dv);
per_pixel_12=mult = 0.008 / (dist + 0.4);
per_pixel_13=dx = dx + mult * sin(ang2 + 1.5);
per_pixel_14=dy = dy + mult * cos(ang2 + 1.5);

[warp_shader]
uniform sampler2D sampler_cells;
 shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)
  ).xyz - 0.5) / 256.0));
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_cells, (uv_orig * aspect.xy));
  vec2 x_3;
  x_3 = (uv - uv_orig);
  ret_1 = (mix (ret_1, tmpvar_2.xyz, vec3(clamp (
    ((1.0 - (abs(
      (((dot (tmpvar_2.xyz, vec3(0.32, 0.49, 0.29)) * 0.8) + 0.1) - (0.5 + (roam_cos.y * 0.25)))
    ) * (3.0 + 
      (9.0 * rand_preset.x)
    ))) - ((texture (sampler_noise_lq, (
      (uv * 0.1)
     + 
      (time * 0.01)
    )).x * 6.0) - 2.0))
  , 0.0, 1.0))) * (0.97 + (0.03 * 
    clamp ((sqrt(dot (x_3, x_3)) * 200.0), 0.0, 1.0)
  )));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = vec3(dot (texture (sampler_main, uv).xyz, vec3(0.32, 0.49, 0.29)));
  ret = tmpvar_1.xyz;
 }
