[preset00]
fRating=0.000000
fVideoEchoZoom=1.001825
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
nWaveMode=2.000000
bAdditiveWaves=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bMotionVectorsOn=0.000000
fWaveAlpha=0.976151
fWaveScale=0.931000
fWaveSmoothing=0.180000
fWaveParam=-0.320000
fZoomExponent=2.300000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderR=0.500000
fOuterBorderG=0.500000
fOuterBorderB=0.500000
fOuterBorderA=1.000000
fInnerBorderR=0.500000
fInnerBorderG=0.500000
fInnerBorderB=0.500000
fInnerBorderA=1.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=old_treb_flop = 0;
per_frame_init_2=bass_flop = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=treb_flop = 0;
per_frame_init_5=bass_thresh = 0;
per_frame_init_6=old_bass_flop = 0;
per_frame_init_7=treb_thresh = 0;
per_frame_init_8=pulse = 0;
per_frame_init_9=bass_changed = 0;
per_frame_init_10=mid_thresh = 0;
per_frame_init_11=q4 = 0;
per_frame_init_12=mid_changed = 0;
per_frame_init_13=old_mid_flop = 0;
per_frame_init_14=mid_flop = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=treb_changed = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_6=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_7=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_8=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_9=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_10=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_11=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_12=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_13=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_14=pulse = if(0.00001 < abs(above(abs(pulse), 5000)), -5000, pulse + 0.1 * mid_att * bor(bor(bass_changed * bnot(treb_changed), treb_changed * bnot(bass_changed)) * bnot(mid_changed), mid_changed));
per_frame_15=wave_b = if(0.00001 < abs(treb_changed), 1, if(0.00001 < abs(mid_changed), 0.45, -0.45)) * q4;
per_frame_16=wave_g = if(0.00001 < abs(bass_changed), 0.1, bass_flop);
per_frame_17=wave_r = if(0.00001 < abs(mid_flop), 1, 0.5 * q2 * treb_flop);
per_frame_18=ib_b = ib_b + 0.5 * sin(pulse);
per_frame_19=ib_g = ib_g + 5 * sin(0.8 * pulse);
per_frame_20=ib_r = ib_r + 5 * sin(0.8 * pulse);
per_frame_21=ob_b = wave_r;
per_frame_22=ob_g = wave_b;
per_frame_23=ob_r = wave_g;
per_frame_24=wave_mystery = sin(pulse);
per_frame_25=q1 = pulse;
per_pixel_1=zoom = zoom - 0.1 * cos(10 * x * sin(time + 0.9 * q1) - 10 * sin(time + q1)) - 0.1 * sin(10 * rad * sin(time + 0.5 * q1));
per_pixel_2=rot = rot + abs(1 - zoom) * sin(time + q1) * 2;
