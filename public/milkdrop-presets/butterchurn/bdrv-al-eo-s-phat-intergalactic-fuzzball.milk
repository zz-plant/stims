per_frame_1=decay = 1;
per_frame_2=vol = vol;
per_frame_3=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_4=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_5=zoom = 1;
per_frame_6=musictime = musictime + vol;
per_frame_7=q4 = 0.3 * sin(0.02 * musictime);
per_frame_8=q5 = 0.3 * sin(0.01 * musictime);
