per_frame_10=dy = 0.01 * cos(0.069 * musictime);
per_frame_11=monitor = rot;
per_pixel_1=dist = sqrt(du * du + dv * dv);
per_pixel_2=ang2 = atan2(du, dv) + 0.15 * time;
per_pixel_3=mult = 0.65 * sin(0.05 * dist);
per_pixel_4=dx = mult * sin(2 * ang2 - 1.5);
per_pixel_5=dy = mult * cos(2 * ang2 - 1.5);
per_pixel_6=rot = 0.1 * pow(-ang, 3) - 1.18 * sin(ang);
per_pixel_7=zoom = 2 * sin(-rad) + 1.3 + sin(rad);
per_pixel_8=dx = dx + 0.09 * sin(0.785 * q8);
per_pixel_9=dy = dy + 0.09 * sin(0.675 * q8);
per_pixel_10=zoom = zoom + q7;
per_pixel_11=zoom = zoom + 0.2 * (0.05 + 0.04 * sin(time)) * sin(ang * time);
per_pixel_12=rot = rot + 0.005 * cos(5 * ang * bass * time);
per_pixel_13=dx = dx + 0.1 * above(rad, 0.25) * dx_r;
