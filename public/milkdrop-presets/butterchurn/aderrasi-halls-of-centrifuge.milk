per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 0.25 * sin(1.4 * time) + 0.25 * sin(2.25 * time);
per_frame_2=wave_g = wave_g + 0.25 * sin(1.7 * time) + 0.25 * sin(2.11 * time);
per_frame_3=wave_b = wave_b + 0.25 * sin(1.84 * time) + 0.25 * sin(2.3 * time);
per_frame_4=warp = 0;
per_frame_5=ib_r = wave_b;
per_frame_6=ib_g = wave_r;
per_frame_7=ib_b = wave_g;
per_frame_8=ob_r = wave_r * sin(wave_b);
per_frame_9=ob_g = wave_g * sin(wave_r);
per_frame_10=ob_b = wave_b * sin(wave_g);
per_frame_11=zoom = zoom - 0.05;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=rot = rot + rad * (1.1 * sin(time) - rad) * 1.25;
per_pixel_5=rot = rot + 0.1 * above(rad, 0.7 - 0.2 * sin(bass));
per_pixel_6=zoom = zoom - above(rad, 0.5 + 0.1 * sin(1 - rad * cos(time))) * below(0.5 * sin(time) - rad, 0.5) * 0.09 * rad;
per_pixel_7=zoom = zoom + 0.025 * below(rad, 0.75 + 0.5 * sin(bass * time));
per_pixel_8=zoom = zoom - 0.02 * (sin(time) - rad - rad);
per_pixel_9=zoom = zoom + 0.03 * (0.1 + (1 + rad)) * below(rad, 0.1) * above(bass, 1);
