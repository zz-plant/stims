shape_3_per_frame1=meanbass = 0.01 * (99 * meanbass + bass);
shape_3_per_frame2=meantreb = 0.01 * (99 * meantreb + treb);
shape_3_per_frame3=meanmid = 0.01 * (99 * meanmid + mid);
shape_3_per_frame4=bassdiff = 15 * (bass - meanbass);
shape_3_per_frame5=trebdiff = 15 * (treb - meantreb);
shape_3_per_frame6=middiff = 15 * (mid - meanmid);
shape_3_per_frame7=bassdiff = bassdiff * above(bassdiff, 0);
shape_3_per_frame8=trebdiff = trebdiff * above(trebdiff, 0);
shape_3_per_frame9=middiff = middiff * above(middiff, 0);
shape_3_per_frame10=g = min(1, max(0, 0.2 * trebdiff));
shape_3_per_frame11=r = min(1, max(0, 0.2 * middiff));
shape_3_per_frame12=b = min(1, max(0, 0.2 * bassdiff));
shape_3_per_frame13=g2 = min(1, max(0, 0.2 * trebdiff));
shape_3_per_frame14=r2 = min(1, max(0, 0.2 * middiff));
shape_3_per_frame15=b2 = min(1, max(0, 0.2 * bassdiff));
shape_3_per_frame16=x = x + 0.06 * sin(0.7 * time);
shape_3_per_frame17=y = y + 0.06 * sin(0.5 * time);
shape_3_per_frame18=ang = sin(time);
shape_3_per_frame19=rad = rad - 0.4 + 0.05 * bass;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.03))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  uv_1 = (uv * 0.5);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (max (max (
    max (texture (sampler_main, uv_1).xyz, texture (sampler_main, (uv_1 + vec2(0.5, 0.0))).xyz)
  , texture (sampler_main, 
    (uv_1 + vec2(0.0, 0.5))
  ).xyz), texture (sampler_main, (uv_1 + vec2(0.5, 0.5))).xyz) * 1.3);
  ret = tmpvar_2.xyz;
 }
