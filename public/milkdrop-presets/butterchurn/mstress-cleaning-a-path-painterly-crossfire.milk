per_frame_init_19=bassdiff = 0;
per_frame_init_20=oldy = 0.4;
per_frame_1=ib_g = 0.2 * abs(sin(0.1 * time));
per_frame_2=ib_b = 0.2 * abs(sin(0.3 * time));
per_frame_3=ib_r = 0.2 * abs(sin(0.7 * time));
per_frame_4=ob_b = abs(sin(100 * time + time));
per_frame_5=ob_r = abs(sin(512 * time + time));
per_frame_6=ob_g = abs(sin(10 * time + time));
per_frame_7=ib_b = abs(sin(10 * time + time));
per_frame_8=ib_r = abs(sin(512 * time + time));
per_frame_9=ib_g = abs(sin(100 * time + time));
per_frame_10=meanbass = 0.01 * (99 * meanbass + bass);
per_frame_11=meantreb = 0.01 * (99 * meantreb + treb);
per_frame_12=meanmid = 0.01 * (99 * meanmid + mid);
per_frame_13=bassdiff = 15 * (bass - meanbass);
per_frame_14=trebdiff = 15 * (treb - meantreb);
per_frame_15=middiff = 15 * (mid - meanmid);
per_frame_16=bassdiff = bassdiff * above(bassdiff, 0);
per_frame_17=trebdiff = trebdiff * above(trebdiff, 0);
per_frame_18=middiff = middiff * above(middiff, 0);
per_frame_19=ob_g = min(1, max(0, 0.2 * trebdiff));
per_frame_20=ob_r = min(1, max(0, 0.2 * middiff));
per_frame_21=ob_b = min(1, max(0, 0.2 * bassdiff));
per_frame_22=volume = 0.3 * bass + mid;
per_frame_23=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_24=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_25=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_26=runmeanbass = (2 * runmeanbass + bass_att) / 3;
per_frame_27=peakbass_att = max(bass_att, peakbass_att);
per_frame_28=beat = above(volume, 0.8) * above(bass_att, 1.1 * runmeanbass) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_29=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_30=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_31=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_32=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_33=q1 = beat;
per_frame_34=temp = y;
per_frame_35=y = if(0.00001 < abs(beat), oldy, y);
per_frame_36=oldy = if(0.00001 < abs(beat), temp, oldy);
per_frame_37=monitor = y;
per_pixel_1=sq = above(x, 0.3) * below(x, 0.6) * above(y, 0.4) * below(y, 0.6);
per_pixel_2=cx = sin(10 * x + time + bass);
per_pixel_3=cy = sin(10 * y + time + treb);
per_pixel_4=rot = rot + 0.012;
per_pixel_5=zoom = zoom - 0.7 * sqq;
shape_0_init1=flag1 = 0;
shape_0_init2=flag1 = 0;
