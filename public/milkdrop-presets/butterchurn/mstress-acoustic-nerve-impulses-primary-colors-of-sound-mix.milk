shape_0_init9=flag = 0;
shape_0_per_frame1=flag1 = floor(abs(flag1 - q1));
shape_0_per_frame2=flag = floor(abs(flag - q1 * flag1));
shape_0_per_frame3=ang = ang + if(0.00001 < abs(flag), 0, -0.4) + 0.4 * abs(sin(bass)) * if(0.00001 < abs(flag), 1, -1);
shape_0_per_frame4=x = x + 0.06 * sin(0.7 * time);
shape_0_per_frame5=y = y + 0.06 * sin(0.5 * time);
