per_frame_init_1=volume = 0;
per_frame_init_2=beatrate = 0;
per_frame_init_3=lastbeat = 0;
per_frame_init_4=meanbass_att = 0;
per_frame_init_5=runmeanbass = 0;
per_frame_init_6=peakbass_att = 0;
per_frame_init_7=beat = 0;
per_frame_init_8=q1 = 0;
per_frame_init_9=oldy = 0.4;
per_frame_1=volume = 0.3 * bass + mid;
per_frame_2=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_3=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_4=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_5=runmeanbass = (2 * runmeanbass + bass_att) / 3;
per_frame_6=peakbass_att = max(bass_att, peakbass_att);
per_frame_7=beat = above(volume, 0.8) * above(bass_att, 1.1 * runmeanbass) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_8=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_9=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_10=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_11=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_12=q1 = beat;
