per_frame_init_1=fleem = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.33 * sin(1.2 * time);
per_frame_3=wave_g = wave_g + 0.33 * sin(0.888 * time);
per_frame_4=wave_b = wave_g + 0.33 * sin(0.999 * time);
per_pixel_1=fleem = if(0.00001 < abs(above(bass_att, 1)), -4, 8) + if(0.00001 < abs(above(treb_att, 1)), 8, -4);
per_pixel_2=zoom = zoom + 0.07 * cos(rad * -fleem - rad);
per_pixel_3=sx = 1 + sin(rad) / 9;
per_pixel_4=sy = 1 + sin(rad) / 8;
