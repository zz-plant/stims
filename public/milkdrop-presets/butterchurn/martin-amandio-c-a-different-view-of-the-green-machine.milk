shape_1_per_frame3=y1 = gmegabuf(floor(4 * n + 1));
shape_1_per_frame4=z1 = gmegabuf(floor(4 * n + 2)) + 0.7;
shape_1_per_frame5=dist = sqrt(pow(x1 - x1_, 2) + pow(y1 - y1_, 2) + pow(z1 - z1_, 2));
shape_1_per_frame6=x = 0.5 + x1 / z1;
shape_1_per_frame7=y = 0.5 + y1 / z1 * q6;
shape_1_per_frame8=dx = x1 - x1_;
shape_1_per_frame9=dy = y1 - y1_;
shape_1_per_frame10=ang1 = atan2(dy, dx);
shape_1_per_frame11=k1 = 3.14 * instance / num_inst + time / 13;
shape_1_per_frame12=b = 0.6 + 0.4 * sin(ang1 + k1);
shape_1_per_frame13=r = 0.6 + 0.4 * sin(k1 + 0.3 * treb);
shape_1_per_frame14=g = 0.6 + 0.4 * sin(k1 - 0.3 * treb);
shape_1_per_frame15=rad = 6 * dist / z1 + q24 * if(0.00001 > abs(n - 0), 1, 0);
shape_1_per_frame16=rad = rad * ((2 + sin(ang1 + time)) / 3);
shape_1_per_frame17=rad = min(rad, 0.2);
shape_1_per_frame18=bri = sqrt(r * r + b * b + g * g);
shape_1_per_frame19=r = r / bri;
shape_1_per_frame20=g = g / bri;
shape_1_per_frame21=b = b / bri;
shape_1_per_frame22=b2 = b / 6;
shape_1_per_frame23=g2 = g / 6;
shape_1_per_frame24=r2 = r / 6;
shape_1_per_frame25=x1_ = x1;
shape_1_per_frame26=y1_ = y1;
shape_1_per_frame27=z1_ = z1;
shape_1_per_frame28=a = 1;
shape_1_per_frame29=a2 = min(0.5, abs(0.02 / rad));
