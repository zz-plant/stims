per_frame_init_56=frm = if(5 <= randint(10), 1, 0);
per_frame_1=dec_m = pow(0.8, 30 / fps);
per_frame_2=dec_s = pow(0.9, 30 / fps);
per_frame_3=vol = (bass + mid + treb) / 3;
per_frame_4=vol_ = dec_m * vol_ + (1 - dec_m) * vol;
per_frame_5=avg = avg * dec_s + vol * (1 - dec_s);
per_frame_6=is_beat = above(vol, 1 * avg + 2 * peak) * above(time, t0 + 0.2);
per_frame_7=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_8=peak = is_beat * vol + (1 - is_beat) * peak * dec_m;
per_frame_9=index = mod(index + is_beat, 8);
per_frame_10=index2 = mod(index2 + is_beat * bnot(index), 8);
per_frame_11=trig = is_beat * if(0.00001 > abs(index - 0), 1, 0);
per_frame_12=t1 = t1 + trig;
per_frame_13=ran1 = dec_m * ran1 + (1 - dec_m) * cos(3.14 / 6 * t1);
per_frame_14=ran2 = dec_m * ran2 + (1 - dec_m) * sin(3.14 / 6 * t1);
per_frame_15=ran3 = dec_m * ran3 + (1 - dec_m) * sin(3.14 / 5 * t1);
per_frame_16=q1 = ran1;
per_frame_17=q2 = ran2;
per_frame_18=q3 = ran3;
