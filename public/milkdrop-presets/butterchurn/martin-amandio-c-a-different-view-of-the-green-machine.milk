per_frame_27=vol2 = sqrt(vol);
per_frame_28=k5 = 1 / (randint(10) + 0.2);
per_frame_29=b = 0;
per_frame_30=while(b < shapes, sa = n / shapes; p1 = p1 + 0.15 * sin(sa * (vol - 1) * 200 + 0.1 * time) * vol; p2 = p2 - p1 * vol * k5; x1 = x1 + sin(p2) * sa * 0.006 * vol; y1 = y1 + cos(p2) * sa * 0.006 * vol; z1 = z1 + 0.005 * cos(0.03 * p1) * vol; mx = mx + x1; my = my + y1; mz = mz + z1; x1 = 16 * atan(x1 / 16); y1 = 16 * atan(y1 / 16); z1 = 16 * atan(z1 / 16); gmegabuf(floor(4 * n)) = x1; gmegabuf(floor(4 * n + 1)) = y1; gmegabuf(floor(4 * n + 2)) = z1; n = n + 1; b = b + 1;);
per_frame_31=trel = trel + 0.3 * (vol_ / fps);
per_frame_32=q4 = -0.2 * min(max(0, 4 * sin(trel)), 1);
per_frame_33=mzoom = if(0.00001 < abs(trig), 0.1 * vol2 * if(3 <= randint(10), 1, 0), mzoom);
per_frame_34=mzoom_ = mzoom_ * dec_m + (1 - dec_m) * mzoom;
per_frame_35=q4 = mzoom_;
per_frame_36=q5 = if(vol >= vol_, 1, 0);
per_frame_37=monitor = q5;
per_frame_38=q6 = aspecty;
per_frame_39=q27 = index;
per_frame_40=q28 = index2;
per_frame_41=q24 = is_beat;
per_frame_42=q30 = min(1, 0.05 / mzoom);
per_frame_43=trig1 = is_beat * mod(index, 2);
per_frame_44=pk = if(0.00001 < abs(trig1), 1, pk * dec_m);
per_frame_45=ran5 = if(0.00001 < abs(trig1), randint(1), ran5);
per_frame_46=q22 = pk * pk * mod(frame, 2);
per_frame_47=q22 = if(0.00001 > abs(pk - 1), 1, 0);
per_frame_48=q23 = ran5;
per_pixel_1=x1 = x - 0.5 * abs(q1);
per_pixel_2=y1 = y - 0.5 * abs(q2);
per_pixel_3=k1 = q3 / 2;
per_pixel_4=len = sqrt(pow(x1, 3) * k1 - pow(y1, 3) * (1 - k1)) - 0.05;
per_pixel_5=zoom = 1 + len * q4;
per_pixel_6=dx = 0 * q1 * (y - 0.5);
per_pixel_7=dy = 0 * q2 * (x - 0.5);
per_pixel_8=warp = 0;
per_pixel_9=rot = 0.01 * (x1 - y1) * q1;
