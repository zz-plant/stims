per_frame_1=decay = 0.9999;
per_frame_2=zoom = -0.999;
per_frame_3=rot = 0.02 * sin(time / 10);
per_frame_4=ib_b = sin(time / 20) + 0.25;
per_frame_5=ib_g = 0.3 * cos(time / 15) + 0.25;
per_frame_6=ib_r = 0.3 * sin(time / 17) + 0.25;
