per_pixel_1=xtc = 10 * sin(time / 10);
per_pixel_2=speed = 40 - 15 * above(bass, 0.9);
per_pixel_3=speed = speed + xtc;
per_pixel_4=acid = x * sin(time / 10);
per_pixel_5=morphine = y * cos(time / 10);
per_pixel_6=dmt = 0.01 * above(treb * treb * treb / 3, 2.5);
per_pixel_7=saliva = 0.01 * above(treb, 0.9);
per_pixel_8=cx = dmt * rad * 0.1;
per_pixel_9=cy = saliva * rad * 0.1;
per_pixel_10=dx = 0.01 * sin(y * speed);
per_pixel_11=dy = 0.01 * cos(x * speed);
per_pixel_12=zoom = cos(0.1 * x * sin(time / 10)) + 0.1 * y * cos(time / 10);
per_pixel_13=warp = -3 * (0.5 * sin(time / 2) + 0.5) * x + 3 * (0.5 * cos(time / 2) + 0.5) * y;
