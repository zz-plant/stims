per_frame_init_1=q4 = 0;
per_frame_init_2=q5 = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_5=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 20), 0);
per_frame_7=zoom = zoom + 0.3 * (0.01 * cos(0.317 * time + 1) + 0.01 * cos(0.1132 * time + 4));
per_frame_8=rot = rot + 0.5 * (0.01 * cos(0.214 * time + 3) + 0.01 * cos(0.2732 * time + 2));
per_frame_9=wave_mystery = 0.05 * time;
per_frame_10=q4 = cos(6.2831854 * wave_mystery);
per_frame_11=q5 = sin(6.2831854 * wave_mystery);

[warp_shader]
shader_body { 
  vec2 uv_1;
  uv_1 = (uv - 0.5);
  uv_1 = (uv_1 * (1.0 + (
    ((q4 * uv_1.y) + (q5 * uv_1.x))
   * 0.1)));
  uv_1 = (uv_1 + 0.5);
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv_1);
  vec2 tmpvar_3;
  tmpvar_3.x = q5;
  tmpvar_3.y = -(q4);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ((max (tmpvar_2.xyz, texture (sampler_main, 
    (uv_1 + (((
      (tmpvar_2.xy - 0.5)
     * texsize.zw) * 13.0) * tmpvar_3))
  ).xyz) - 0.003) * 0.98);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (mix (tmpvar_1.xyz, vec3(dot (tmpvar_1.xyz, vec3(0.32, 0.49, 0.29))), vec3(-0.5, -0.5, -0.5)) * 1.3);
  ret = tmpvar_2.xyz;
 }
