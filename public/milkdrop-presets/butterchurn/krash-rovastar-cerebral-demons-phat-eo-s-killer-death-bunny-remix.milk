per_frame_init_24=q8 = 0;
per_frame_init_25=yspeed = 0;
per_frame_init_26=dy_residual = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.45 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_3=wave_b = wave_b - 0.4 * (0.5 * sin(4.782 * time) + 0.5 * cos(0.722 * time));
per_frame_4=wave_g = wave_g + 0.4 * sin(1.931 * time);
per_frame_5=wave_r = 0.2125 * wave_r + 0.7154 * wave_g + 0.0721 * wave_b;
per_frame_6=wave_g = wave_r;
per_frame_7=wave_b = wave_r;
per_frame_8=vol = 0.167 * (bass + mid);
per_frame_9=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_10=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_11=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_12=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_13=xpos = xpos + 0.001 * xspeed;
per_frame_14=wave_x = 1.25 * xpos + 0.5;
per_frame_15=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_16=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_17=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_18=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_19=ypos = ypos + 0.001 * yspeed;
per_frame_20=wave_y = 1.25 * ypos + 0.5;
per_frame_21=dx = dx + dx_residual;
per_frame_22=dy = dy + dy_residual;
per_frame_23=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_24=dx_residual = 0.003 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * dx_residual;
per_frame_25=dy_residual = 0.001 * equal(bass_thresh, 2) * sin(9 * time) + (1 - equal(bass_thresh, 2)) * dy_residual;
per_frame_26=rot = 0.1;
per_frame_27=vol = 0.25 * (bass + mid + treb);
per_frame_28=vol = vol * vol;
per_frame_29=mtime = mtime + 0.01 * vol * (75 / fps);
per_frame_30=q8 = mtime;
per_frame_31=q1 = sin(mtime) * sin(3 * mtime) * 0.4 + 0.5;
per_frame_32=q2 = cos(1.3 * mtime) * sin(5.4 * mtime) * 0.4 + 0.5;
per_frame_33=ib_r = tan(time);
per_frame_34=ib_r = min(1, max(ib_r, 0));
per_frame_35=ib_g = tan(time + 2.1);
per_frame_36=ib_g = min(1, max(ib_g, 0));
per_frame_37=ib_b = tan(time + 4.2);
per_frame_38=ib_b = min(1, max(ib_b, 0));
per_frame_39=q3 = 10 + 8 * (0.6 * sin(0.223 * time) + 0.4 * sin(0.153 * time));
per_frame_40=q4 = 1 / q3;
per_frame_41=q5 = 0.5 * sign(xpos);
per_frame_42=q6 = 0.5 * sign(ypos);
per_frame_43=monitor = q4;
per_pixel_1=cx = (band(0, x * q3 - q5) + q5) * q4;
per_pixel_2=cy = (band(0, y * q3 - q6) + q6) * q4;
per_pixel_3=newx = q1 - x;
per_pixel_4=newy = q2 - y;
per_pixel_5=newrad = 2 * sqrt(newx * newx + 0.5625 * newy * newy);
per_pixel_6=newzoom = pow(1.05 + 0.03 * newrad, pow(0.01 + sin(newrad * newrad), 2 * newrad - 1));
per_pixel_7=dx = newx * newzoom - newx;
per_pixel_8=dy = newy * newzoom - newy;
per_pixel_9=dx = dx * 0.1;
per_pixel_10=dy = dy * 0.1;
per_pixel_11=rot = 2 * newrad * (0.5 * (0.5 - rad) + 0.1);
per_pixel_12=rot = rot * sin(time) * 0.2;
wave_1_init1=n = 0;
wave_1_init2=xp = 0;
wave_1_init3=n2 = 0;
wave_1_init4=yp = 0;
wave_1_init5=xran = 0;
wave_1_init6=yof = 0;
wave_1_init7=yran = 0;
wave_1_init8=tx = 0;
wave_1_init9=tm = 0;
wave_1_init10=xof = 0;
wave_1_init11=ty = 0;
wave_1_init12=q8 = 0;
wave_1_per_point1=n = 6.283 * sample;
wave_1_per_point2=n2 = 6 * (sample - q8 - 0.1 * time);
wave_1_per_point3=xp = sin(n);
wave_1_per_point4=yp = cos(n);
wave_1_per_point5=tm = q8 - sample;
wave_1_per_point6=tx = sin(13 * n2) * sin(5 * n2) * sample * 0.05;
wave_1_per_point7=ty = cos(13 * n2) * sin(7 * n2) * sample * 0.05;
wave_1_per_point8=xof = sin(tm) * sin(3 * tm) * 0.4 + 0.5 + tx;
wave_1_per_point9=yof = cos(1.3 * tm) * sin(5.4 * tm) * 0.4 + 0.5 + ty;
wave_1_per_point10=xran = 0.0005 * (randint(10) - 5);
wave_1_per_point11=xran = xran * sample;
wave_1_per_point12=yran = 0.0005 * (randint(10) - 5);
wave_1_per_point13=yran = yran * sample;
wave_1_per_point14=x = xof + xran;
wave_1_per_point15=y = 1 - yof + yran;
wave_1_per_point16=a = 1 - sample;
wave_1_per_point17=g = g * (1 - sample);
wave_1_per_point18=b = b * (1 - sample);
