wave_2_per_point1=n = 6.283 * sample;
wave_2_per_point2=n2 = 6 * (sample - q8 - 0.1 * time);
wave_2_per_point3=xp = sin(n);
wave_2_per_point4=yp = cos(n);
wave_2_per_point5=tm = q8 - sample;
wave_2_per_point6=tx = sin(13 * n2) * sin(5 * n2) * sample * 0.05;
wave_2_per_point7=ty = cos(13 * n2) * sin(7 * n2) * sample * 0.05;
wave_2_per_point8=xof = sin(tm) * sin(3 * tm) * 0.4 + 0.5 + tx;
wave_2_per_point9=yof = cos(1.3 * tm) * sin(5.4 * tm) * 0.4 + 0.5 + ty;
wave_2_per_point10=xran = 0.0005 * (randint(10) - 5);
wave_2_per_point11=xran = xran * sample;
wave_2_per_point12=yran = 0.0005 * (randint(10) - 5);
wave_2_per_point13=yran = yran * sample;
wave_2_per_point14=x = xof + xran;
wave_2_per_point15=y = 1 - yof + yran;
wave_2_per_point16=a = 1 - sample;
wave_2_per_point17=g = g * (1 - sample);
wave_2_per_point18=b = b * (1 - sample);
shape_0_init1=q1 = 0;
shape_0_init2=q2 = 0;
shape_0_per_frame1=x = q1;
shape_0_per_frame2=y = 1 - q2;
shape_0_per_frame3=ang = time;
