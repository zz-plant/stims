per_frame_init_17=newzoom = 0;
per_frame_init_18=q2 = 0;
per_frame_init_19=yamp = 0;
per_frame_init_20=q3 = 0;
per_frame_init_21=xdir = 0;
per_frame_init_22=newy = 0;
