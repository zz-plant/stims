[preset00]
fRating=5.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=1.000000
bWaveDots=1.000000
bWaveThick=1.000000
fWaveAlpha=1.347000
fWaveScale=1.910000
fWaveSmoothing=0.900000
fWaveParam=-0.100000
fWarpScale=3.138000
fZoom=1.022250
fWarp=0.000540
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.300000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=lum = 0;
per_frame_init_2=dx_residual = 0;
per_frame_init_3=dy_residual = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_1=wave_r = wave_r + 0.65 * (0.6 * sin(31.437 * time) + 0.4 * sin(20.97 * time));
per_frame_2=wave_g = wave_g + 0.65 * (0.6 * sin(31.344 * time) + 0.4 * sin(20.841 * time));
per_frame_3=wave_b = wave_b + 0.65 * (0.6 * sin(31.251 * time) + 0.4 * sin(21.055 * time));
per_frame_4=lum = 0.3 * wave_r + 0.5 * wave_g + 0.2 * wave_b;
per_frame_5=wave_r = 0.2 * wave_r + 0.8 * lum;
per_frame_6=wave_g = 0.2 * wave_g + 0.8 * lum;
per_frame_7=wave_b = 0.2 * wave_b + 0.8 * lum;
per_frame_8=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_9=cx = cx + 0.21 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_10=cy = cy + 0.21 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_11=dx = dx + 0.001 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_12=dy = dy + 0.001 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_13=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_14=dx = dx + 0.01 * dx_residual;
per_frame_15=dy = dy + 0.01 * dy_residual;
per_frame_16=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_17=dx_residual = 0.9 * (0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual);
per_frame_18=dy_residual = 0.9 * (0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual);
per_frame_19=wave_x = wave_x - 7 * dx_residual;
per_frame_20=wave_y = wave_y - 7 * dy_residual;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.02))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  float tmpvar_1;
  tmpvar_1 = abs(((
    fract((((ang / 6.28) * 7.0) + (time * 0.05)))
   * 2.0) - 1.0));
  vec2 tmpvar_2;
  tmpvar_2.x = cos(tmpvar_1);
  tmpvar_2.y = sin(tmpvar_1);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (-0.3 + (1.7 * texture (sampler_main, (0.5 + 
    ((pow (rad, 0.5) * 0.5) * tmpvar_2)
  )).xyz));
  ret = tmpvar_3.xyz;
 }
