wave_0_per_point1=sp = 1607.68 * sample;
wave_0_per_point2=vol = 0.33 * (bass_att + mid_att + treb_att);
wave_0_per_point3=vol = 0.2 + 0.5 * (value1 + value2);
wave_0_per_point4=vol = 0.2;
wave_0_per_point5=mod = if(0.00001 < abs(below(mid_att, 1.8)), mid_att + 0.2, 2);
wave_0_per_point6=ox = 0.5 * sin(sp) * sin(3.14 * sample) * vol;
wave_0_per_point7=oy = (sample - 0) * mod;
wave_0_per_point8=oz = 0.5 * cos(sp) * sin(3.14 * sample) * vol;
