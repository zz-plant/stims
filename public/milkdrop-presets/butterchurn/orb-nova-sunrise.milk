shape_2_init6=q1 = 0;
shape_2_per_frame1=x = 0.5 + 0.02 * sin(time);
shape_2_per_frame2=y = 0.5 + 0.02 * cos(time);
shape_2_per_frame3=r = 0.1 + 0.5 * sin(0.01 * q1);
shape_2_per_frame4=g = 0.1 + 0.5 * sin(0.09878 * q1);
shape_2_per_frame5=b = 0.1 + 0.5 * sin(0.0897 * q1);
shape_2_per_frame6=r2 = 0.1 + 0.5 * sin(0.035 * q1);
shape_2_per_frame7=g2 = 0.1 + 0.5 * sin(0.09878 * q1);
shape_2_per_frame8=b2 = 0.1 + 0.5 * sin(0.0897 * q1);

[warp_shader]
uniform sampler2D sampler_cells;
 shader_body { 
  vec3 final_noise_1;
  vec2 tmpvar_2;
  tmpvar_2 = (uv - 0.5);
  final_noise_1 = texture (sampler_cells, ((tmpvar_2 * (1.0 - 
    (bass_att * 0.1)
  )) + 0.5)).xyz;
  final_noise_1 = (1.0 - (final_noise_1 * 0.25));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = texture (sampler_main, (((tmpvar_2 * 
    (1.0 - (bass_att * 0.01))
  ) * final_noise_1.xy) + 0.5)).xyz;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 2.0);
  vec3 tmpvar_2;
  tmpvar_2 = sqrt(ret_1);
  ret_1 = (1.0 - ((tmpvar_2 * 
    (1.0 - tmpvar_2)
  ) * 4.0));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
