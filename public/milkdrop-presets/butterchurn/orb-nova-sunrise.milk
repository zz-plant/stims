wave_2_init2=pi = 0;
wave_2_init3=samp = 0;
wave_2_init4=xx = 0;
wave_2_init5=q1 = 0;
wave_2_init6=yy = 0;
wave_2_init7=zz = 0;
wave_2_per_point1=zs = if(0.00001 < abs(below(zs, 100)), 100, zs);
wave_2_per_point2=zs = if(0.00001 < abs(above(zs, 10100)), 100, zs);
wave_2_per_point3=zs = if(0.00001 < abs(above(zs, 1100)), 1, zs);
wave_2_per_point4=pi = 3.141592;
wave_2_per_point5=samp = sample;
wave_2_per_point6=xx = cos(q1 * samp + q1);
wave_2_per_point7=yy = sin(q1 * samp + 0.9 * q1);
wave_2_per_point8=zz = 0.25 * samp;
wave_2_per_point9=x = xx * zz * 4;
wave_2_per_point10=y = yy * zz * 4;
wave_2_per_point11=x = 0.5 * x + 0.5;
wave_2_per_point12=y = 0.5 * y + 0.5;
wave_2_per_point13=r = 0.5 + 0.5 * cos(0.2 * q1) * sin(0.1 * q1);
wave_2_per_point14=g = 0.5 + 0.5 * sin(0.2 * q1) * sin(0.1 * q1);
wave_2_per_point15=b = 0.5 + 0.5 * cos(q1);
shape_0_init1=q1 = 0;
shape_0_init2=q1 = 0;
shape_0_init3=q1 = 0;
shape_0_per_frame1=r = 0.1 + 0.5 * sin(q1);
shape_0_per_frame2=g = 0.1 + 0.5 * sin(0.9878 * q1);
shape_0_per_frame3=b = 0.1 + 0.5 * sin(0.897 * q1);
