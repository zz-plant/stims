[preset00]
fRating=0.000000
nWaveMode=6.000000
fWaveParam=1.000000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.499900
fWaveX=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=1.000000
wavecode_2_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=warp = 0;
per_frame_2=sy = 0.9;
per_frame_3=sx = 1.02;
per_frame_4=wave_r = wave_r + 0.25 * sin(0.444 * time);
per_frame_5=wave_g = wave_g + 0.25 * sin(0.333 * time);
per_frame_6=wave_b = wave_b + 0.25 * sin(0.222 * time);
per_frame_7=wave_r = wave_r + 0.1 * bass;
per_frame_8=wave_g = wave_g + 0.1 * treb;
per_frame_9=wave_b = wave_b + 0.1 * mid;
per_pixel_1=sy = 0.9;
per_pixel_2=zoom = zoom - 0.1 * rad;
wave_1_per_point1=y = 0.5 + 0.2 * sin(value2 * time);
wave_1_per_point2=x = 0.5 + 10 * value1;
wave_1_per_point3=a = if(0.00001 < abs(above(abs(y - 0.5), 0.17)), abs(y - 0.5), 0);
