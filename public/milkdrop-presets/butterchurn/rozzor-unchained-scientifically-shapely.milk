per_frame_init_25=ccl = 0;
per_frame_init_26=q2 = 0;
per_frame_init_27=bres = 0;
per_frame_init_28=q3 = 0;
per_frame_init_29=mth = 0;
per_frame_init_30=q7 = 0;
per_frame_init_31=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=le = 1.5 + 2 * sin(bass_att);
per_frame_3=bpulse = band(above(le, bth), above(le - bth, bblock));
per_frame_4=bblock = le - bth;
per_frame_5=bth = if(0.00001 < abs(above(le, bth)), le + 114 / (le + 10) - 7.407, bth + 0.07 * bth / (bth - 12) + 0.1 * below(bth, 2.7) * (2.7 - bth));
per_frame_6=bth = if(0.00001 < abs(above(bth, 6)), 6, bth);
per_frame_7=bres = bpulse * sin(pulse + 0.5 * le) + bnot(bpulse) * bres;
per_frame_8=le = 1.5 + 2 * sin(treb_att);
per_frame_9=tpulse = band(above(le, tth), above(le - tth, tblock));
per_frame_10=tblock = le - tth;
per_frame_11=tth = if(0.00001 < abs(above(le, tth)), le + 114 / (le + 10) - 7.407, tth + 0.07 * tth / (tth - 12) + 0.1 * below(tth, 2.7) * (2.7 - tth));
per_frame_12=tth = if(0.00001 < abs(above(tth, 6)), 6, tth);
per_frame_13=tres = tpulse * sin(pulse + 0.5 * le) + bnot(tpulse) * tres;
per_frame_14=le = 1.5 + 2 * sin(mid_att);
per_frame_15=mpulse = band(above(le, mth), above(le - mth, mblock));
per_frame_16=mblock = le - mth;
per_frame_17=mth = if(0.00001 < abs(above(le, mth)), le + 114 / (le + 10) - 7.407, mth + 0.07 * mth / (mth - 12) + 0.1 * below(mth, 2.7) * (2.7 - mth));
per_frame_18=mth = if(0.00001 < abs(above(mth, 6)), 6, mth);
per_frame_19=mres = mpulse * sin(pulse + 0.5 * le) + bnot(mpulse) * mres;
per_frame_20=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.003 * (bth + mth + tth));
per_frame_21=q1 = bres;
per_frame_22=q2 = tres;
per_frame_23=q3 = mres;
per_frame_24=q4 = sin(pulse);
per_frame_25=mod_state = (above(q1, 0) + above(q2, 0) + above(q3, 0)) * (1 + above(q4, 0));
per_frame_26=ccl = ccl + tpulse + mpulse - bpulse;
per_frame_27=q5 = cos(pulse * (0.5 + 0.1 * mod_state));
per_frame_28=q6 = sin(pulse * (0.5 + pow(0.25, mod_state)));
per_frame_29=q7 = mod_state;
per_frame_30=q8 = ccl;
per_frame_31=ib_size = 0.025 + 0.02 * q2;
per_frame_32=ob_size = 0.03 + 0.02 * q3 - 0.002 * q7;
per_frame_33=wave_mystery = wave_mystery + sin(2.18 * time + q6);
per_frame_34=wave_x = wave_x + 0.15 * sin(0.811 * time + q1) + 0.02 * (mod(frame, 12) + q7) * sign(q5);
per_frame_35=wave_y = wave_y + 0.15 * sin(0.788 * time + q2) + 0.02 * (mod(frame, 11) + q7) * sign(q3);
per_frame_36=cy = 0.5 + 0.5 * q4 + sin(0.086 * time);
per_frame_37=decay = 0.997 + 0.0015 * q3 + 0.0015 * q1;
per_frame_38=slowtime = slowtime + mpulse * time;
per_frame_39=temp_b = cos(slowtime) + abs(cos(slowtime));
per_frame_40=temp_g = abs(sin(slowtime));
per_frame_41=temp_r = -1 * cos(slowtime) + abs(-1 * cos(slowtime)) + 0.2 * (cos(sin(slowtime)) + (abs(cos(sin(slowtime))) + cos(sin(slowtime))));
per_frame_42=ob_r = if(0.00001 < abs(above(temp_r, 1)), 1, if(0.00001 < abs(above(temp_r, 0)), abs(temp_r), 0));
per_frame_43=ob_g = if(0.00001 < abs(above(temp_g, 0.5)), 0.5, if(0.00001 < abs(above(temp_g, 0)), abs(temp_g), 0));
per_frame_44=ob_b = if(0.00001 < abs(above(temp_b, 1)), 1, if(0.00001 < abs(above(temp_b, 0)), abs(temp_b), 0));
per_frame_45=ib_r = 1 - if(0.00001 < abs(above(temp_r, 1)), 1, if(0.00001 < abs(above(temp_r, 0)), abs(temp_r), 0));
per_frame_46=ib_g = 1 - if(0.00001 < abs(above(temp_g, 1)), 1, if(0.00001 < abs(above(temp_g, 0)), abs(temp_g), 0));
per_frame_47=ib_b = 1 - if(0.00001 < abs(above(temp_b, 1)), 1, if(0.00001 < abs(above(temp_b, 0)), abs(temp_b), 0));
per_frame_48=wave_b = temp_b;
per_frame_49=wave_g = 1 - temp_g;
per_frame_50=wave_r = 1 - equal(ob_b, 1) * temp_r;
per_frame_51=ob_a = 0.8 + 0.2 * q2;
per_pixel_1=snee = bnot(above(sin(ang) - x, 0.5) * above(q2, 0) + above(y - cos(ang), 0.5) * above(q1, 0));
per_pixel_2=snur = bnot(below(x, 0.5) * above(q3, 0) + below(y, 0.5) * below(q7, 4));
per_pixel_3=grid = sin(sigmoid(sin(6.28 * y * q2), sin(6.28 * x * q6)) * (10 + q7));
per_pixel_4=rot = bnot(above(x, 0.5) + mod(y * q8, q7)) * cos(rad + 3.14 * if(0.00001 < abs(above(grid, 0)), snur, bnot(snur)) * (0.5 + 0.5 * sin(3.14 * rad * q1))) * q4;
per_pixel_5=zoom = zoom + 0.1 * sin(0.0314 * rad * meshx * q2 + q5) * sign(snee);
per_pixel_6=rot = if(0.00001 < abs(rot), rot * sign(snur), q6);
per_pixel_7=cx = if(0.00001 < abs(below(x, 0.5) * below(y, 0.5)), 0.5 + 0.001 * meshx * q1, 0.5);
per_pixel_8=cy = if(0.00001 < abs(below(x, 0.5) * below(y, 0.5)), 0.5 + 0.001 * meshy * q3, 0.5);
per_pixel_9=sx = sx + 0.01 * sin(2.13 * time * meshx * x);
per_pixel_10=sy = sy + 0.01 * sin(2.33 * time * meshy * x);
