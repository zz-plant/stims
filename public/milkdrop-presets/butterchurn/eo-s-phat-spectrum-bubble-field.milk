per_frame_init_10=ypos = 0;
per_frame_1=decay = 1;
per_frame_2=vol = 0.25 * (bass + mid + treb);
per_frame_3=vol = vol * vol;
per_frame_4=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_5=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_6=musictime = musictime + vol;
per_frame_7=q4 = 0;
per_frame_8=q5 = 0;
per_frame_9=q1 = 0.4 * sin(0.001 * musictime) + 0.5;
per_frame_10=q2 = 0.5 * cos(0.001 * musictime) + 0.5;
per_frame_11=q8 = musictime;
per_frame_12=monitor = rot;
per_frame_13=zoom = 1;
per_frame_14=dx = 0;
per_frame_15=dy = 0;
per_frame_16=cx = sin(0.25 * time) + 0.5;
per_frame_17=cy = sin(0.125 * time) + 0.5;
per_frame_18=sy = 0.5 + 0.25 * (0.5 * sin(0.5 * time) + 0.5);
per_frame_19=sx = 0.95 * sy;
per_frame_20=rot = 0.6 * sin(0.31 * time);
wave_0_init1=n = 0;
wave_0_init2=size = 0;
wave_0_init3=flux = 0;
wave_0_per_point1=n = 6.283 * sample;
wave_0_per_point2=size = 0.165;
wave_0_per_point3=x = sin(n) * size + 0.5;
wave_0_per_point4=y = cos(n) * size * 1.3333 + 0.5;
wave_0_per_point5=flux = 0.5 * sin(2 * n - time) + 0.5;
wave_0_per_point6=r = 0.5 * sin(n) + 0.5;
wave_0_per_point7=g = 0.5 * sin(n + 2.1) + 0.5;
wave_0_per_point8=b = 0.5 * sin(n + 4.2) + 0.5;
wave_0_per_point9=r = r * flux;
wave_0_per_point10=g = g * flux;
wave_0_per_point11=b = b * flux;
