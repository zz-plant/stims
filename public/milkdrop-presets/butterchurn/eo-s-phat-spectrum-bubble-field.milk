shape_1_per_frame2=x = 0.5 + 0.003 * sin(time);
shape_1_per_frame3=y = 0.5 + 0.003 * cos(3 * time);
shape_1_per_frame4=spl = spl - 0.01;
shape_1_per_frame5=spl = if(0.00001 < abs(below(spl, 0)), 1, spl);
shape_1_per_frame6=tex_zoom = 1 + (1 - spl * spl);
shape_1_per_frame7=a = min(1, 3 * spl);
shape_2_init1=sn = 0;
shape_2_init2=sn = 0;
shape_2_init3=thick = 0;
shape_2_per_frame1=tex_ang = sin(0.5 * time);
