shape_2_per_frame1=ang = 0.45 * cos(0.6 * time + 0.34 + sin(2.54 * time + 1.02));
shape_2_per_frame2=additive = below(mod(frame, 5), 4);
shape_2_per_frame3=r2 = 0.3 * abs(cos(0.543 * time + 7.34 + sin(0.123 * time + 1.75)));
shape_2_per_frame4=g2 = 0.3 * abs(sin(0.543 * time + 7.34 + sin(0.123 * time + 1.75)));
