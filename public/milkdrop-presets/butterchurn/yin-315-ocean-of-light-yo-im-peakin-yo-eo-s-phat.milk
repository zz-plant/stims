per_frame_1=sure = if(0.00001 < abs(equal(sure, 0)), 0.6, sure);
per_frame_2=interval = if(0.00001 < abs(equal(interval, 0)), 40, interval);
per_frame_3=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), frame - fps, lastbeat);
per_frame_4=dbass = (bass - pbass) / fps;
per_frame_5=beat = above(dbass, 0.6 * maxdbass) * above(frame - lastbeat, fps / 3);
per_frame_6=sure = if(0.00001 < abs(beat * below(abs(frame - (interval + lastbeat)), fps / 5)), min(0.095 + sure, 1), beat * (sure - 0.095) + (1 - beat) * sure * 0.9996);
per_frame_7=sure = max(0.5, sure);
per_frame_8=cheat = if(0.00001 < abs(above(frame, lastbeat + interval + floor(fps / 10)) * above(sure, 0.91)), 1, cheat);
per_frame_9=beat = if(0.00001 < abs(cheat), 1, beat);
per_frame_10=sure = if(0.00001 < abs(cheat), 0.95 * sure, sure);
per_frame_11=maxdbass = max(0.999 * maxdbass, dbass);
per_frame_12=maxdbass = max(0.012, maxdbass);
per_frame_13=maxdbass = min(0.02, maxdbass);
per_frame_14=interval = if(0.00001 < abs(beat), frame - lastbeat, interval);
per_frame_15=lastbeat = if(0.00001 < abs(beat), frame - cheat * floor(fps / 10), lastbeat);
per_frame_16=cheat = 0;
per_frame_17=pbass = bass;
per_frame_18=warp = 0;
per_frame_19=zoom = 1.04;
per_frame_20=rnd = equal(mod(frame, 400), 0);
per_frame_21=offy = (1 - rnd) * offy + rnd * (-3 + randint(600) / 100);
per_frame_22=offz = (1 - rnd) * offz + rnd * (-80 - 0 * randint(1000) / 1000);
per_frame_23=sc = (1 - rnd) * sc + rnd * (1 + randint(500) / 100);
per_frame_24=offx = 0;
per_frame_25=offy = -3.1;
per_frame_26=offz = -300 + 160 * pow(contvol, 0.25);
per_frame_27=sc = 4;
per_frame_28=q2 = offy;
per_frame_29=q3 = offz;
per_frame_30=q4 = sc;
per_frame_31=q5 = 3.1415 * cos(0.05 * time + 0.84 + sin(0.1 * time + 6.43));
per_frame_32=q6 = 0.2;
per_frame_33=q5 = 0;
per_frame_34=q6 = 0;
per_frame_35=stime = if(0.00001 < abs(equal(stime, 0)), time, stime);
per_frame_36=mytime = time - stime;
per_frame_37=phase = 0.1 * mytime - floor(0.1 * mytime);
per_frame_38=tilex = if(0.00001 < abs(below(phase, 0.025)), 1 + randint(4), tilex);
per_frame_39=tilez = if(0.00001 < abs(below(phase, 0.025)), 1 + randint(4), tilez);
per_frame_40=q7 = tilex;
per_frame_41=contvol = 0.006666 * (bass + mid + att) + 0.98 * contvol;
per_frame_42=contvol = min(1, contvol);
per_frame_43=zoom = 1.01 + 0.05 * contvol;
per_frame_44=darken = above(mod(frame, 3), 0);
per_frame_45=c1 = above(contvol, 0.7) * min(contvol - 0.7, 0.3);
per_frame_46=dx = 0.05 * c1 * (-10 + randint(20));
per_frame_47=dy = 0.05 * c1 * (-10 + randint(20));
per_frame_48=solarize = 0;
per_frame_49=darken = mod(frame, 2);
per_frame_50=brighten = 1 - darken;
per_frame_51=monitor = gamma;
per_frame_52=q8 = min((frame - lastbeat) / interval, 1);
per_frame_53=q1 = 0.05 * cos(1.943 * time + 2.43 + sin(1.83 * time + 2.01));
per_frame_54=sx = 1 - 2 * beat * above(contvol, 0.8);
per_frame_55=sy = 1 - 2 * beat * above(contvol, 0.8);
per_frame_56=invert = beat * above(contvol, 0.8);
