wave_0_per_point16=az = cenz;
wave_0_per_point17=a = central * above(t8, 0) * 0.07 * above(ceny, q2);
wave_0_per_point18=invz = 1 / (az + 100);
wave_0_per_point19=x = 0.5 + 5 * ax * invz;
wave_0_per_point20=y = 0.5 + 5 * ay * invz;
wave_0_per_point21=t8 = mod(t8 + 1, t1);
