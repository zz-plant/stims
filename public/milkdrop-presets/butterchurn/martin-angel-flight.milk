wave_0_per_point13=zang = t1;
wave_0_per_point14=fov = 0.12;
wave_0_per_point15=mx = ox * cos(zang) - oy * sin(zang);
wave_0_per_point16=my = ox * sin(zang) + oy * cos(zang);
wave_0_per_point17=ox = mx;
wave_0_per_point18=oy = my;
wave_0_per_point19=mx = ox * cos(yang) + oz * sin(yang);
wave_0_per_point20=mz = -ox * sin(yang) + oz * cos(yang);
wave_0_per_point21=ox = mx;
wave_0_per_point22=oz = mz;
wave_0_per_point23=my = oy * cos(xang) - oz * sin(xang);
wave_0_per_point24=mz = oy * sin(xang) + oz * cos(xang);
wave_0_per_point25=oy = my;
