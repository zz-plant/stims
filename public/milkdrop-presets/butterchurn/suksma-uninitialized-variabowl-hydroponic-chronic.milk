shape_0_per_frame34=w = atan2(x3, y3);
shape_0_per_frame35=p = tan(asin(1) + atan2(d + z3, l));
shape_0_per_frame36=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_0_per_frame37=rad = rad / d;
shape_0_per_frame38=my_x = zoom * sin(w) * p;
shape_0_per_frame39=my_y = zoom * cos(w) * p;
shape_0_per_frame40=x = 0.5 + my_x;
