shape_0_per_frame23=my_z = t * sin(wh) * sin(wv) * l;
shape_0_per_frame24=x1 = cos(w1) * my_x + sin(w1) * my_y;
shape_0_per_frame25=y1 = -sin(w1) * my_x + cos(w1) * my_y;
