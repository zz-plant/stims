[preset00]
fRating=0.000000
fDecay=0.942000
fVideoEchoZoom=1.006500
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=7.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
bTexWrap=0.000000
fWaveAlpha=0.302958
fWaveScale=1.718927
fWaveSmoothing=0.522000
fModWaveAlphaStart=0.950000
fModWaveAlphaEnd=1.470000
fZoomExponent=0.940320
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.600000
fWaveG=0.700000
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderSize=0.000000
fInnerBorderR=0.800000
fInnerBorderA=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=turn = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 1.56 * sin(12 * treb) * time / 5;
per_frame_2=wave_b = wave_b + 1.585 * sin(12 * bass) * time / 5;
per_frame_3=wave_g = wave_g + 1.61 * sin(12 * mid) * time / 5;
per_frame_4=wave_x = wave_x + 0 * sin(0.8 * time);
per_frame_5=wave_y = wave_y + 0 * sin(0.5 * time);
per_frame_6=turn = 2 * above(bass_att, turn) + (1 - above(bass_att, turn)) * (0.96 * (turn - 1.3) + 1.3);
per_frame_7=dx_r = 0.016 * equal(turn, 2) * sin(7 * time) + (1 - equal(turn, 2)) * dx_r;
per_frame_8=dy_r = 0.013 * equal(turn, 2) * sin(8 * time) + (1 - equal(turn, 2)) * dy_r;
per_frame_9=dx = dx + 0.25 * dx_r;
per_frame_10=dy = dy + 0.25 * dy_r;
per_pixel_1=zoom = zoom - if(0.00001 < abs(below(rad, 0.61)), 0.05, 0.01);

[warp_shader]
shader_body { 
  vec2 v_1;
  vec3 ret_2;
  v_1 = ((normalize(
    (uv - 0.5)
  ) * aspect.xy) * (texsize.zw * 3.0));
  ret_2 = (0.25 * ((
    (texture (sampler_main, uv).xyz + texture (sampler_main, (uv + (v_1 * 2.5))).xyz)
   + texture (sampler_main, 
    (uv + (v_1 * 5.5))
  ).xyz) + texture (sampler_main, (uv + 
    (v_1 * -4.0)
  )).xyz));
  ret_2 = (ret_2 - 0.01);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  float ang2_1;
  ang2_1 = ((ang * 0.1591549) + (time * 0.025));
  float tmpvar_2;
  tmpvar_2 = (3.0 + floor((rand_preset.z * 5.95)));
  ang2_1 = (fract((ang2_1 * tmpvar_2)) / tmpvar_2);
  ang2_1 = (abs((ang2_1 - 
    (0.5 / tmpvar_2)
  )) * 6.283185);
  vec2 tmpvar_3;
  tmpvar_3.x = cos(ang2_1);
  tmpvar_3.y = sin(ang2_1);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, (0.5 + (
    ((0.4 * (rad * sqrt(
      dot (texsize.xy, texsize.xy)
    ))) * tmpvar_3)
   * texsize.zw))).xyz * 1.333);
  ret = tmpvar_4.xyz;
 }
