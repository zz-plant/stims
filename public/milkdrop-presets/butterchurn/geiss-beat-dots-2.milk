[preset00]
fRating=5.000000
fDecay=0.990000
nWaveMode=7.000000
bAdditiveWaves=1.000000
fWaveAlpha=0.451000
fWaveScale=1.111000
fWaveSmoothing=0.000000
fWaveParam=-0.160000
