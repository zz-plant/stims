per_frame_init_18=c_y = 0.5;
per_frame_1=q1 = aspectx;
per_frame_2=q2 = aspecty;
per_frame_3=rot = 0;
per_frame_4=zoom = 1;
per_frame_5=warp = 0;
per_frame_6=vol = 8 * bass + 5 * mid + 3 * treb;
per_frame_7=m = 0.96 * m + 0.06 * vol;
per_frame_8=monitor = vol - m;
per_frame_9=beat = above(vol, res) * above(vol, m) * above(vol, 10);
per_frame_10=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_11=res = beat * (vol + 0.15 * m) + (1 - beat) * (res - 60 * (0.15 + 0.03 * diff) / fps);
per_frame_12=res = max(0, res);
per_frame_13=r = if(0.00001 < abs(beat), 0.0002 * (randint(200) - 100), r);
per_frame_14=rot = r;
per_frame_15=c_x = if(0.00001 < abs(beat), 0.5 + 0.005 * (randint(200) - 100), c_x);
per_frame_16=c_y = if(0.00001 < abs(beat), 0.5 + 0.005 * (randint(200) - 100), c_y);
per_frame_17=v = if(0.00001 < abs(beat), 0.035 + 0.00025 * (randint(200) - 100), v);
per_frame_18=q3 = c_x;
per_frame_19=q4 = c_y;
per_frame_20=q5 = v;
per_frame_21=q6 = beat;
per_pixel_1=d = pow(sqrt(sqr(x - q3) + sqr(y - q4)), 0.5) - 0;
per_pixel_2=v = q5;
per_pixel_3=dx = v * (x - q3) * d;
per_pixel_4=dy = v * (y - q4) * d;
wave_0_init1=ma = 0;
wave_0_init2=mx = 0;
wave_0_init3=my = 0;
wave_0_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.01 * bass;
wave_0_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_0_per_point3=mx = mx + 0.0002 * cos(ma);
wave_0_per_point4=my = my + 0.0002 * sin(ma);
wave_0_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_0_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_0_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_0_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_0_per_point9=x = mx;
wave_0_per_point10=y = my;
