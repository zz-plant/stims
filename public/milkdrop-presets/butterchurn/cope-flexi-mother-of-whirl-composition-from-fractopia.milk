per_frame_init_14=wr = 0;
per_frame_init_15=q7 = 0;
per_frame_init_16=q8 = 0;
per_frame_init_17=q1 = 1 / asin(1);
per_frame_1=wave_r = wave_r + 0.3 * sin(50 * vol);
per_frame_2=wave_b = wave_b + 0.3 * sin(20 * vol);
per_frame_3=wave_g = wave_g + 0.5 * sin(35 * vol);
per_frame_4=q8 = wave_r;
per_frame_5=q7 = wave_b;
per_frame_6=q6 = wave_g;
per_frame_7=wr = 0.5 + 0.4 * (0.6 * sin(1.1 * time) + 0.4 * sin(0.8 * time));
per_frame_8=wb = 0.5 + 0.4 * (0.6 * sin(1.6 * time) + 0.4 * sin(0.5 * time));
per_frame_9=wg = 0.5 + 0.4 * (0.6 * sin(1.34 * time) + 0.4 * sin(0.4 * time));
per_frame_10=monitor = wg;
per_frame_11=q10 = wr;
per_frame_12=q11 = wb;
per_frame_13=q12 = wg;
per_frame_14=q18 = 0.007 * sin(0.1 * time);
per_frame_15=q17 = -0.007 * sin(0.254 * time);
per_frame_16=q2 = bass_thresh;
per_frame_17=vol = 0.25 * (bass + mid + treb);
per_frame_18=vol = vol * vol;
per_frame_19=q3 = vol;
per_frame_20=warp = 0;
per_frame_21=t = t - 1 / fps;
per_frame_22=t = if(0.00001 < abs(above(t, 2)), t - 2, t);
per_frame_23=q2 = t;

[warp_shader]
shader_body { 
  vec3 noise3_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_main, uv).xyz + ((texture (sampler_blur1, uv).xyz * scale1) + bias1));
  vec2 tmpvar_3;
  tmpvar_3 = (0.5 + ((
    (uv - vec2(0.0, 1.0))
   - 0.5) * (1.0 + 
    (tmpvar_2.y * 0.03)
  )));
  vec2 tmpvar_4;
  tmpvar_4.x = (tmpvar_3.x + pow (tmpvar_2.x, 0.0));
  tmpvar_4.y = (tmpvar_3.y + pow (tmpvar_2.x, 0.005));
  noise3_1 = (texture (sampler_noise_lq, ((
    (uv_orig * texsize.xy)
   * texsize_noise_lq.zw) + rand_frame.xy)).xyz * fract(q15));
  vec3 tmpvar_5;
  tmpvar_5 = (noise3_1 * (vec3(1.0, 1.0, 1.0) - vec3(fract(
    (q3 * 0.5)
  ))));
  noise3_1 = tmpvar_5;
  vec4 tmpvar_6;
  tmpvar_6 = texture (sampler_main, fract(tmpvar_4));
  vec3 tmpvar_7;
  tmpvar_7.x = q10;
  tmpvar_7.y = q11;
  tmpvar_7.z = q12;
  vec3 tmpvar_8;
  tmpvar_8 = mix (tmpvar_5, tmpvar_7, tmpvar_6.xxx);
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = (tmpvar_6.xyz + clamp ((
    (tmpvar_6.yzx * tmpvar_8.zxy)
   - 
    (tmpvar_6.zxy * tmpvar_8.yzx)
  ), 0.0, 1.0));
  ret = tmpvar_9.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (texsize.zw * 2.0);
  vec3 tmpvar_2;
  tmpvar_2 = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1));
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_4;
  tmpvar_4.x = tmpvar_2.x;
  tmpvar_4.y = tmpvar_3.x;
  vec2 tmpvar_5;
  tmpvar_5.x = tmpvar_2.z;
  tmpvar_5.y = tmpvar_3.z;
  vec2 tmpvar_6;
  tmpvar_6.x = tmpvar_2.z;
  tmpvar_6.y = tmpvar_3.z;
  vec2 tmpvar_7;
  tmpvar_7.x = tmpvar_2.x;
  tmpvar_7.y = tmpvar_3.x;
  vec4 tmpvar_8;
  tmpvar_8 = texture (sampler_blur1, uv);
  vec4 tmpvar_9;
  tmpvar_9 = texture (sampler_main, uv);
  vec4 tmpvar_10;
  tmpvar_10 = texture (sampler_blur3, uv);
  vec4 tmpvar_11;
  tmpvar_11.w = 1.0;
  tmpvar_11.xyz = mix (clamp (mix (
    mix (mix (mix (mix (
      (vec3(0.0, 1.0, 0.0) * vec3(sqrt(dot (tmpvar_6, tmpvar_6))))
    , vec3(1.0, 0.0, 0.0), vec3(
      (tmpvar_9.z * clamp ((1.0 - (
        ((tmpvar_10.xyz * scale3) + bias3)
      .y * 8.0)), 0.0, 1.0))
    )), vec3(1.0, 1.0, 1.0), vec3((
      ((((texture (sampler_blur1, 
        (uv - tmpvar_5)
      ).xyz * scale1) + bias1).x * ((tmpvar_8.xyz * scale1) + bias1).z) * 2.0)
     * 
      (1.0 - (((tmpvar_8.xyz * scale1) + bias1).y * 4.0))
    ))), vec3(0.8, 0.0, 1.5), vec3(sqrt(dot (tmpvar_7, tmpvar_7)))), vec3(1.0, 1.0, 0.0), vec3((tmpvar_9.x * clamp ((1.0 - 
      (((tmpvar_10.xyz * scale3) + bias3).y * 8.0)
    ), 0.0, 1.0))))
  , vec3(1.0, 1.0, 1.0), vec3(
    ((((
      (texture (sampler_blur1, (uv - tmpvar_4)).xyz * scale1)
     + bias1).z * (
      (tmpvar_8.xyz * scale1)
     + bias1).x) * 2.0) * (1.0 - ((
      (tmpvar_8.xyz * scale1)
     + bias1).y * 4.0)))
  )), 0.0, 1.0), vec3(1.0, 1.0, 1.0), tmpvar_9.yyy);
  ret = tmpvar_11.xyz;
 }
