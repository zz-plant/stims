per_frame_88=vx3 = if(0.00001 < abs(bounce), sin(ref_ang) * v2 * cos(w2 - ref_ang) + 0.1 * (v2r - vr - sin(ref_ang) * v2 * cos(w2 - ref_ang)) + sin(ref_ang + asin(1)) * v1 * cos(w1 - ref_ang - asin(1)), vx3);
per_frame_89=vy3 = if(0.00001 < abs(bounce), cos(ref_ang) * v2 * cos(w2 - ref_ang) + 0.1 * (v2r - vr - cos(ref_ang) * v2 * cos(w2 - ref_ang)) + cos(ref_ang + asin(1)) * v1 * cos(w1 - ref_ang - asin(1)), vy3);
