per_frame_122=q12 = vr3;
per_frame_123=q13 = atan2((x1 + x2 + x3) / 3 - 0.5, (y1 + y2 + y3) / 3 - 0.5);
per_frame_124=q14 = 0.2 * sigmoid(sqrt(sqr((x1 + x2 + x3) / 3 - 0.5) + sqr((y1 + y2 + y3) / 3 - 0.5)), 2);
per_pixel_1=du = 2 * x - 1 - 2 * (q4 + q7 + q10 - 1.5) / 3;
per_pixel_2=dv = 2 * y - 1 + 2 * (q5 + q8 + q11 - 1.5) / 3;
per_pixel_3=dist = sqrt(du * du + dv * dv);
per_pixel_4=ang2 = atan2(du, dv);
per_pixel_5=mult = 0.4 * sin(0.05 * dist) * q14;
per_pixel_6=dx = mult * sin(2 * ang2 + q13) * aspectx;
per_pixel_7=dy = mult * cos(2 * ang2 + q13) * aspecty;
