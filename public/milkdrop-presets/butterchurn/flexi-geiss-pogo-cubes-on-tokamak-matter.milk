per_frame_69=vx1 = if(0.00001 < abs(bounce), sin(ref_ang) * v1 * cos(w1 - ref_ang) + 0.1 * (vr - v2r - sin(ref_ang) * v1 * cos(w1 - ref_ang)) + sin(ref_ang + asin(1)) * v2 * cos(w2 - ref_ang - asin(1)), vx1);
per_frame_70=vy1 = if(0.00001 < abs(bounce), cos(ref_ang) * v1 * cos(w1 - ref_ang) + 0.1 * (vr - v2r - cos(ref_ang) * v1 * cos(w1 - ref_ang)) + cos(ref_ang + asin(1)) * v2 * cos(w2 - ref_ang - asin(1)), vy1);
