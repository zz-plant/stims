per_pixel_4=var1 = above(10 * sin(16 * time), 9) * sin(2 * time) * 0.09;
per_pixel_5=var2 = above(sin(12 * ang + 2 * time), 0.6);
per_pixel_6=rot = var1 * var2 * rad * rad;
