wave_0_init7=y_screen = 0;
wave_0_init8=advance = 0;
wave_0_per_frame1=advance = advance + 0.005;
wave_0_per_frame2=advance = if(0.00001 < abs(above(advance, 2)), 0, advance);
wave_0_per_frame3=t1 = advance;
wave_0_per_point1=s = 6.28 * sample;
wave_0_per_point2=xp = sin(s) + sin(0.34 * s) + sin(24.3 * s) + sin(13.8 * s);
wave_0_per_point3=xp = xp * 0.2;
wave_0_per_point4=yp = cos(s) + sin(0.24 * s) + cos(17.4 * s) + sin(37.7 * s);
wave_0_per_point5=yp = yp * 0.2;
wave_0_per_point6=zp = cos(s) + cos(5.24 * s) + cos(47.4 * s) + cos(27.7 * s);
wave_0_per_point7=zp = zp * 0.25;
wave_0_per_point8=zp = zp + 1 - t1;
wave_0_per_point9=zp = if(0.00001 < abs(below(zp, 0)), zp + 2, zp);
wave_0_per_point10=a = 1 - 0.5 * zp;
wave_0_per_point11=zp = zp * 0.7;
wave_0_per_point12=x_screen = xp / zp + 0.5;
wave_0_per_point13=y_screen = yp / zp + 0.5;
wave_0_per_point14=x = x_screen;
wave_0_per_point15=y = y_screen;
