per_frame_15=decay = 1 - 0.01 * (0.5 * sin(0.25 * mtime) + 0.5);
per_pixel_1=flux = 2 * sin(0.3 * time);
per_pixel_2=zoom = -1.02 + rad * (9 + flux);
