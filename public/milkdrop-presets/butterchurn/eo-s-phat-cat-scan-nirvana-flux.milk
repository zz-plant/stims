per_frame_1=vol = 0.25 * (bass + mid + treb);
per_frame_2=vol = vol * vol;
per_frame_3=mtime = mtime + 0.018 * vol;
per_frame_4=q7 = mtime;
per_frame_5=q8 = vol;
per_frame_6=r = 0.5 * sin(0.3 * mtime) + 0.5;
per_frame_7=g = 0.5 * sin(0.3 * mtime + 2.1) + 0.5;
