per_frame_1=decay = 0.999;
per_frame_2=ib_b = sin(time / 20) + 0.5;
per_frame_3=ib_g = 0.3 * cos(time / 15) + 0.25;
per_frame_4=ib_r = 0.3 * sin(time / 17) + 0.25;
per_frame_5=invert = above(sin(time), 0);
per_frame_6=solarize = above(sin(time / 2), 0);
per_frame_7=flip = flip + 0.1 * below(flip, 1.1);
per_frame_8=q1 = flip;
per_pixel_1=tmmod = sin(time / 1);
per_pixel_2=tmmodb = cos(time / 3 + tmmod);
per_pixel_3=tm = 0.2 * sin(time / 2 + tmmod) + 0.31;
per_pixel_4=stm = sin(tm);
per_pixel_5=mir = 0.45 + q1;
per_pixel_6=nx = if(0.00001 < abs(above(x, mir)), -(x - mir) + mir, x);
per_pixel_7=warp = -6 * (0.5 * dtm + 0.5) * nx + 3 * (0.5 * stm + 0.5) * y;
per_pixel_8=zoom = stm * rad;
per_pixel_9=dx = if(0.00001 < abs(above(x, mir)), 0.3 * -stm * y, 0.3 * stm * y);
per_pixel_10=sx = if(0.00001 < abs(above(x, mir)), -sin(tm / 5) + 3 * rad, sin(tm / 5) + 3 * rad);
per_pixel_11=sy = cos(tm / 5) + 3 * rad;
per_pixel_12=rot = 1.5 * sin(rad * sin(3 * ang) + tm + time / 2);
shape_0_init1=var = 0;
shape_0_init2=var = 0;
shape_0_init3=var = 0;
shape_0_per_frame1=ang = 6 * sin(time);
shape_0_per_frame2=var = 0.12 - 0.2 * above(bass, 0.8);
shape_0_per_frame3=x = sin(time) * var + 0.5;
shape_0_per_frame4=y = cos(time) * var + 0.5;
shape_0_per_frame5=g = 0.2 * sin(time / 10);
shape_0_per_frame6=r = 0.3 * cos(time / 12);
shape_0_per_frame7=b = 0.4 * sin(time / 15);
shape_0_per_frame8=g2 = 0.3 * cos(time / 15);
shape_0_per_frame9=r2 = 0.1 * sin(time / 20);
shape_0_per_frame10=b2 = 0.2 * cos(time / 10);
shape_0_per_frame11=rad = 7 * (0.5 * sin(time / 3) + 0.5) - 0.3;
