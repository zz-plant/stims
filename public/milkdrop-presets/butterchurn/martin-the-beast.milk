per_frame_30=q2 = sin(rott);
per_frame_31=q3 = -q2;
per_frame_32=q4 = q1;
per_frame_33=t_rel = t_rel + 0.6 / fps * q1 * q1;
per_frame_34=q5 = cos(t_rel);
per_frame_35=q6 = sin(t_rel);
per_frame_36=q7 = -q6;
per_frame_37=q8 = q5;
per_frame_38=puls1 = puls1 * dec_med + q24 * (1 - dec_med);
per_frame_39=puls2 = puls2 * dec_med + puls1 * (1 - dec_med);
per_frame_40=q25 = puls2;
per_frame_41=roty = roty + 0.09 / fps;
per_frame_42=q29 = roty;
