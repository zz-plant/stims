shape_0_init6=t2 = 0.01 * floor(randint(100));
shape_0_per_frame1=x = x + 0.2 * sin(5 * q4);
shape_0_per_frame2=y = y + 0.2 * cos(5 * q4);
shape_0_per_frame3=ang = 4 * time * (0.3 + 0.1 * t1);
shape_0_per_frame4=rad = rad * (0.9 + 0.2 * t2);
