per_frame_init_31=q28 = 0;
per_frame_init_32=q30 = 0;
per_frame_init_33=q20 = 0;
per_frame_init_34=p1 = floor(randint(16));
per_frame_init_35=p2 = p1;
per_frame_1=dec_med = pow(0.96, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.4 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 8);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=index3 = mod(index3 + is_beat * bnot(index) * bnot(index2), 3);
per_frame_11=q20 = avg;
per_frame_12=q21 = beat;
per_frame_13=q22 = peak;
per_frame_14=q23 = index;
per_frame_15=q24 = is_beat;
per_frame_16=q26 = bass + mid + treb;
per_frame_17=k1 = is_beat * equal(index, 0);
per_frame_18=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_19=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_20=rott = 3.14159265359 * p2 / 4;
per_frame_21=q27 = 8 - index;
per_frame_22=q28 = sin(time / 7);
per_frame_23=q29 = index4;
per_frame_24=q1 = cos(rott);
per_frame_25=q2 = sin(rott);
per_frame_26=q3 = -q2;
per_frame_27=q4 = q1;
per_frame_28=mv_a = 0.5 * q1;
per_frame_29=movez = movez + 0.3 / fps;
per_frame_30=q29 = movez;
per_frame_31=movex = movex + 0.09 / fps * q2;
per_frame_32=q30 = movex;
per_frame_33=q31 = sqr(sin(time / 17));
per_frame_34=q32 = sqr(cos(time / 17));
per_frame_35=zoom = 1;
per_frame_36=rot = 0;
per_frame_37=dx = 0;
per_frame_38=warp = 0.2;
wave_0_init1=q1 = 0;
wave_0_init2=speed = 0;
wave_0_init3=v = 0;
wave_0_init4=xs = 0;
wave_0_init5=ys = 0;
wave_0_per_point1=q1 = 0;
wave_0_per_point2=speed = 0.3 * bass_att;
wave_0_per_point3=v = 10000 * sample + value2 * bass * 0.1;
wave_0_per_point4=xs = xs + sin(0.1 * v + 0.1 * sin(v)) * speed * atan(1.51 * v);
wave_0_per_point5=ys = ys + sin(0.1 * v + 0.1 * cos(v)) * speed * atan(v);
wave_0_per_point6=x = 0.5 + 0.5 * sin(0.1 * xs) * cos(1 * time + ys);
wave_0_per_point7=y = 0.5 + 0.5 * sin(0.1 * ys) * cos(1.1 * time + xs);
wave_0_per_point8=r = 0.5 + 0.5 * sin(0.22 * q1);
wave_0_per_point9=g = 0.5 + 0.5 * sin(0.307 * q1) + x;
wave_0_per_point10=xs = if(0.00001 < abs(above(xs, 1000)), 0, xs);
wave_0_per_point11=ys = if(0.00001 < abs(above(ys, 1000)), 0, ys);

[warp_shader]
shader_body { 
  vec2 zz_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)] = _qa.xy;
  tmpvar_2[1u] = _qa.zw;
  zz_1 = (((
    (uv - vec2(0.5, 0.5))
   * texsize.xy) * 0.01) * tmpvar_2);
  zz_1 = -(zz_1.yx);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ((texture (sampler_main, (uv + 
    (((clamp (
      (sin(zz_1.yx) / cos(zz_1.yx))
    , vec2(-8.0, -8.0), vec2(8.0, 8.0)) * cos(
      (4.0 * zz_1)
    )) * texsize.zw) * 16.0)
  )).xyz * 0.99) - 0.01);
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = cos((13.5 * uv.y));
  tmpvar_1.y = sin((19.5 * uv.x));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = max (texture (sampler_main, uv).xyz, texture (sampler_main, (uv + (0.06 * tmpvar_1))).xyz);
  ret = tmpvar_2.xyz;
 }
