per_pixel_9=y2 = yy + cos(dir) * b1;
per_pixel_10=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * b1;
per_pixel_11=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * b1;
per_pixel_12=si1 = sigmoid(-d1, 1000);
per_pixel_13=si2 = sigmoid(-d2, 1000);
