[preset00]
fRating=4.000000
fGammaAdj=1.000000
fDecay=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.207000
fWaveScale=0.397000
fWaveSmoothing=0.000000
fWaveParam=0.240000
fModWaveAlphaEnd=1.170000
fWarpScale=2.853000
fZoom=1.064000
fWarp=0.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsR=0.350000
fMotionVectorsG=0.350000
fMotionVectorsB=0.350000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=zoom = zoom + 0.003 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.004 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 2), 0);
per_pixel_1=zoom = zoom + (2 * y - 1) * (0.06 + 0.12 * sin(0.351 * time)) - (2 * x - 1) * (0.06 + 0.12 * cos(0.351 * time));
per_pixel_2=rot = rot + 0.16 * (zoom - 1);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (tmpvar_2.xyz + ((tmpvar_2.xyz - 
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
  ) * 0.3));
  ret_1 = (ret_1 * 0.9);
  ret_1 = (ret_1 + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 0.4)) + rand_frame.xy)).xyz - 0.5)
   / 256.0) * 112.0));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (1.0 - pow ((
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
   / bass_att), vec3((1.0 - 
    dot (clamp (pow ((
      ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
     / treb_att), vec3((1.0 - 
      dot (clamp (texture (sampler_main, uv).xyz, 0.0, 1.0), vec3(0.32, 0.49, 0.29))
    ))), 0.0, 1.0), vec3(0.32, 0.49, 0.29))
  ))));
  ret = tmpvar_1.xyz;
 }
