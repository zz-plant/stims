per_frame_init_1=more = 0;
per_frame_init_2=new_mid = 0;
per_frame_init_3=treb_effect = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=no_effect = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=treb_thresh = 0;
per_frame_init_10=vol_att = 0;
per_frame_init_11=normal = 0;
per_frame_init_12=mid_thresh = 0;
per_frame_init_13=bass_effect = 0;
per_frame_init_14=new_treb = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=vol_thresh = 0;
per_frame_init_17=vol_effect = 0;
per_frame_init_18=less = 0;
per_frame_init_19=mid_mid_att = 0;
per_frame_init_20=new_bass = 0;
per_frame_init_21=q2 = 0;
per_frame_init_22=new_vol = 0;
per_frame_init_23=react = 0;
per_frame_init_24=q3 = 0;
per_frame_init_25=q7 = 0;
per_frame_init_26=mid_effect = 0;
per_frame_init_27=change = 0;
per_frame_init_28=wave_myster = 0;
per_frame_init_29=q8 = 0;
per_frame_1=vol_att = bass_att + treb_att + mid_att;
per_frame_2=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_3=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_4=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_5=vol_thresh = bass_thresh + treb_thresh + mid_thresh;
per_frame_6=treb_effect = max(max(treb, treb_att), react);
per_frame_7=bass_effect = max(max(bass, bass_att), react);
per_frame_8=mid_effect = max(max(mid, mid_att), react);
per_frame_9=vol_effect = bass_effect + treb_effect + mid_effect;
per_frame_10=normal = 5;
per_frame_11=more = bass_effect;
per_frame_12=less = 7;
per_frame_13=react = less;
per_frame_14=new_bass = if(0.00001 < abs(above(bass, bass_effect)), band(bass, bass_att), bass_effect + bass_thresh);
per_frame_15=new_treb = if(0.00001 < abs(above(treb, treb_effect)), band(treb, treb_att), treb_effect + treb_thresh);
per_frame_16=new_mid = if(0.00001 < abs(above(mid, mid_effect)), band(mid, mid_att), mid_effect + mid_thresh);
per_frame_17=new_vol = new_bass + new_treb + new_mid + 0.04;
per_frame_18=change = bnot(1);
per_frame_19=q1 = new_bass;
per_frame_20=q2 = new_treb;
per_frame_21=q3 = new_mid;
per_frame_22=q4 = new_vol;
per_frame_23=q5 = if(0.00001 < abs(above(q2, q3)), above(q1, q3), -above(q1, q3));
per_frame_24=q6 = if(0.00001 < abs(above(q1, q3)), above(q2, q4), -above(q2, q3));
per_frame_25=q7 = if(0.00001 < abs(above(q5, q6)), q5, -q6);
per_frame_26=q8 = if(0.00001 < abs(above(q6, q7)), q6, -q7);
per_frame_27=wave_r = 0.5 * sin(above(q1, q2));
per_frame_28=wave_b = sin(above(q3, q2));
per_frame_29=wave_g = wave_g * sin(q4);
per_frame_30=wave_myster = wave_myster - 0.2 * sin(above(q3, q5));
per_pixel_1=rot = if(0.00001 < abs(above(no_effect, 5)), rot * sin(-ang + ang - 0.4 * q1) - rot * sin(ang + -ang * q3) * rad * sin(q1 - rad) - 0.05 * x * sin(q4) - 0.05 * y * sin(q6 - x + y * rad) - rot * sin(equal(q1, q2)), 0.1 * rad);
per_pixel_2=zoom = if(0.00001 < abs(above(no_effect, 5)), zoom + 0.03 * rad * sin(q2 + q5) - 0.05 * x * sin(q4 + q6) + 0.025 * y * sin(q5 - q3), 1 + 0.1 * sin(rad));
per_pixel_3=no_effect = q1 - q3 * sin(above(q1, q2));
