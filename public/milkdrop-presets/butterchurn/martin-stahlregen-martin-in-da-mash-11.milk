per_frame_1=dec_med = pow(0.8, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.4 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 4);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=q20 = avg;
per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q23 = index;
per_frame_14=q24 = is_beat;
per_frame_15=q26 = bass_att + mid_att + treb_att;
per_frame_16=ready = is_beat * bnot(ready) + bnot(is_beat2) * ready;
per_frame_17=is_beat2 = ready * above(time, t0 + 0.2);
per_frame_18=q19 = is_beat2;
per_frame_19=k1 = is_beat * equal(index, 0);
per_frame_20=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_21=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_22=rott = 3.14159265359 * p2 / 2;
per_frame_23=q27 = index + 1;
per_frame_24=q28 = index2 + 1;
per_frame_25=q1 = cos(rott);
per_frame_26=q2 = sin(rott);
per_frame_27=q3 = -q2;
per_frame_28=q4 = q1;
per_frame_29=movex = movex + 0.06 / fps;
per_frame_30=q30 = movex;
per_frame_31=alt = alt * (1 - dec_med) + q26 * dec_med;
per_frame_32=q26 = q26 - alt;
per_frame_33=step = step + max(q26, 0) + q24 - floor(step);
per_frame_34=q30 = step;
per_frame_35=q30 = movex;
per_frame_36=lx = lx + 0.03 / fps;
per_frame_37=ly = ly + 0.3 / fps * q2;
per_frame_38=q10 = lx;
per_frame_39=q11 = 0;
per_frame_40=zoom = 1 + 0 * rad;
per_frame_41=dx = 0;
per_frame_42=dy = 0;
per_frame_43=rot = 0.1 * q1;

