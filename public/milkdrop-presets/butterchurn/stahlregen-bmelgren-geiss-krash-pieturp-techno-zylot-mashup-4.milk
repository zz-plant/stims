shape_0_per_frame3=a2 = 0.33 * val;
shape_0_per_frame4=a = 0.33 * val;
shape_0_per_frame5=rad = 0.4 * cos(0.3 * time) + 0.65;
shape_0_per_frame6=x = 0.25 * sin(0.25 * time) + 0.5;
shape_0_per_frame7=y = 0.25 * cos(0.45 * time) + 0.5;
