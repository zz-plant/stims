[preset00]
fRating=0.000000
fGammaAdj=1.980000
fDecay=0.940000
bDarken=1.000000
fWaveAlpha=0.001000
fWaveScale=2.987793
fShader=1.000000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=1.000000
shapecode_0_enabled=1.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=warp = 0;
per_pixel_1=zoom = if(0.00001 < abs(above(abs(x - 0.5), 0.04)), if(0.00001 < abs(above(abs(y - 0.5), 0.04)), 1.2, 1), 1);
per_pixel_2=dx = if(0.00001 < abs(above(x - 0.5, 0.025)), if(0.00001 < abs(below(abs(y - 0.5), 0.025)), 0.02, 0), 0);
per_pixel_3=dx = if(0.00001 < abs(below(x - 0.5, -0.025)), if(0.00001 < abs(below(abs(y - 0.5), 0.025)), -0.02, dx), dx);
per_pixel_4=dy = if(0.00001 < abs(above(y - 0.5, 0.025)), if(0.00001 < abs(below(abs(x - 0.5), 0.02)), 0.02, 0), 0);
per_pixel_5=dy = if(0.00001 < abs(below(y - 0.5, -0.025)), if(0.00001 < abs(below(abs(x - 0.5), 0.02)), -0.02, dy), dy);
wave_2_init1=t1 = 0;
wave_2_per_point1=x = 0.5 + 0.1 * sin(10 * sample) * 0.1 * randint(10) * bass;
wave_2_per_point2=y = 0.5 + 0.1 * cos(10 * sample) * 0.1 * randint(10) * treb;
wave_2_per_point3=a = abs(y - 0.5) * abs(x - 0.5) * 60;
shape_0_per_frame1=r = 0.5 + 0.2 * sin(1.3 * time);
shape_0_per_frame2=g = 0.5 + 0.2 * sin(1.1 * time);
shape_0_per_frame3=b = 0.5 + 0.2 * sin(0.9 * time);
shape_0_per_frame4=a = bass;
shape_0_per_frame5=r2 = r;
shape_0_per_frame6=g2 = g;
shape_0_per_frame7=b2 = b;
shape_0_per_frame8=border_a = if(0.00001 < abs(above(bass, 1.5)), 1, 0);
shape_0_per_frame9=rad = 0.1 * bass;
shape_0_per_frame10=rad = rad * if(0.00001 < abs(above(bass, 1.7)), 5, 1);
