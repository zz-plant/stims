per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_5=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 20), 0);
per_frame_7=zoom = zoom + 1.2 * (0.01 * cos(0.317 * time + 1) + 0.01 * cos(0.1132 * time + 4));
per_frame_8=rot = rot + 0.5 * (0.01 * cos(0.214 * time + 3) + 0.01 * cos(0.2732 * time + 2));
per_frame_9=wave_mystery = -0.1 + 0.3 * cos(3 * time * 17.3214);

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = normalize((uv_orig - 0.5));
  float tmpvar_3;
  tmpvar_3 = (time * 7.0);
  uv_1 = (uv + ((
    (tmpvar_2 * texsize.zw)
   * 
    cos(((rad * 170.0) - tmpvar_3))
  ) * 2.0));
  uv_1 = (uv_1 + ((
    (vec2(5.0, -5.0) * texsize.zw)
   * 
    cos(((ang * 30.0) - tmpvar_3))
  ) * tmpvar_2.yx));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ((texture (sampler_main, uv_1).xyz - 0.002) * 0.99);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 2.5);
  ret = tmpvar_1.xyz;
 }
