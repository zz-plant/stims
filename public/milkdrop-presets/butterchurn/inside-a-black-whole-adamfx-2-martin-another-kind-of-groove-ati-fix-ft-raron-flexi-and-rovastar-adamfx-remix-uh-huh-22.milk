per_frame_1=dec_med = pow(0.9, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.5 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 4);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=index3 = mod(index3 + is_beat * bnot(index) * bnot(index2), 3);
per_frame_11=q20 = avg;
per_frame_12=q21 = beat;
per_frame_13=q22 = max(peak, 4);
per_frame_14=q23 = index;
per_frame_15=q24 = is_beat;
per_frame_16=q26 = max(bass + mid + treb, 3);
per_frame_17=movez = movez + 3 * (1 + 0.3 * q26) / fps;
per_frame_18=q30 = movez;
per_frame_19=k1 = is_beat * equal(index, 0);
per_frame_20=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_21=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_22=p3 = dec_med * p3 + (1 - dec_med) * p2;
per_frame_23=rott = 3.1416 * p3 / 2;
per_frame_24=q1 = cos(rott);
per_frame_25=q2 = sin(rott);
per_frame_26=q3 = -q2;
per_frame_27=q4 = q1;
per_frame_28=str = str * dec_slow + (1 - dec_slow) * index3;
per_frame_29=q27 = 4 - str;
per_frame_30=mv_a = equal(index2, 2) * bnot(index) * 0.5;
per_frame_31=rot1 = dec_med * rot1 + (1 - dec_med) * bnot(index2);
per_frame_32=q28 = rot1;
per_frame_33=copy = copy * dec_slow + (1 - dec_slow) * index3;
per_frame_34=q29 = 0.3 * copy;
per_pixel_1=dx = 0.04 * q28;
per_pixel_2=rot = 0.06 * q2;
per_pixel_3=zoom = 0.96 + 0.1 * sin(time / 7);
