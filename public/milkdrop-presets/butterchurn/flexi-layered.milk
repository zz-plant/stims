per_frame_1=vb = 0.95 * vb + (1 - vb) * pow(bass, 2) * 0.02;
per_frame_2=vvb = 0.95 * vvb + (1 - vvb) * vb * 0.01;
per_frame_3=vm = 0.95 * vm + (1 - vm) * pow(mid, 2) * 0.02;
per_frame_4=vvm = 0.95 * vvm + (1 - vvm) * vm * 0.01;
per_frame_5=vt = 0.95 * vt + (1 - vt) * pow(treb, 2) * 0.02;
per_frame_6=vvt = 0.95 * vvt + (1 - vvt) * vt * 0.01;
per_frame_7=vvb = min(1, max(0, vvb));
per_frame_8=vvm = min(1, max(0, vvm));
per_frame_9=vvt = min(1, max(0, vvt));
per_frame_10=q1 = 2 * vvb;
