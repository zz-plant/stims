per_frame_13=v = 2;
per_frame_14=bb = bb - vvb * v;
per_frame_15=mm = mm - vvm * v;
per_frame_16=tt = tt - vvt * v;
per_frame_17=q4 = bb;
per_frame_18=q5 = mm;
per_frame_19=q6 = tt;
per_frame_20=q7 = 1.81;
per_frame_21=q8 = 0.448 + 0.3 * (vm - vt);
per_frame_22=q9 = 0.701 + 0.3 * (vb - vm);
per_pixel_1=pi = asin(1);
per_pixel_2=x = x - 0.5;
per_pixel_3=y = y - 0.5;
per_pixel_4=d = 0.4 * (q4 - q6) + (rad - 0.3) * (q1 - q3) * 2 + pi;
per_pixel_5=xx = sin(d) * x - cos(d) * y;
per_pixel_6=yy = cos(d) * x + sin(d) * y;
per_pixel_7=x = xx;
per_pixel_8=y = yy;
per_pixel_9=t = 0 * time;
per_pixel_10=xh = x;
per_pixel_11=yh = y;
per_pixel_12=w = 0.8 * (q4 - q6);
per_pixel_13=m = -1 + 2 * q2;
per_pixel_14=wv = pi - sin(w) * m;
per_pixel_15=wh = pi - cos(w) * m;
per_pixel_16=d = 6 * sqrt(q2);
per_pixel_17=ww = 1.1;
per_pixel_18=ddx = sin(2 * pi - wv - x * ww);
per_pixel_19=ddy = sin(2 * pi - wh - y * ww);
per_pixel_20=rx = if(0.00001 < abs(above(ddx * ddy, 0)), sin(wv) / ddx, 0);
per_pixel_21=ry = if(0.00001 < abs(above(ddy * ddy, 0)), sin(wh) / ddy, 0);
per_pixel_22=v = 0.04 * -q2 * (d / ww) * 1728 / (meshx * meshy);
per_pixel_23=ax = ax + sin(w) * v;
per_pixel_24=ay = ay + cos(w) * v;
per_pixel_25=vx = if(0.00001 < abs(equal(rx * ry, 0)), 0, ax);
per_pixel_26=vy = if(0.00001 < abs(equal(rx * ry, 0)), 0, ay);
per_pixel_27=dx = -xh * rx * ry * d + 0.001 * vx;
per_pixel_28=dy = -yh * rx * ry * d + 0.001 * vy;

[warp_shader]
shader_body { 
  vec2 uv_z_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (1.0 - abs((
    (fract((uv * 0.5)) * 2.0)
   - 1.0)));
  ret_2.x = texture (sampler_fc_main, tmpvar_3).y;
  vec2 tmpvar_4;
  tmpvar_4 = (texsize.zw * 6.0);
  vec2 tmpvar_5;
  vec2 tmpvar_6;
  tmpvar_6 = (uv_orig - 0.5);
  tmpvar_5 = ((tmpvar_6 * 0.996) + 0.5);
  vec2 tmpvar_7;
  tmpvar_7.x = (((texture (sampler_blur1, 
    (tmpvar_5 + (vec2(1.0, 0.0) * tmpvar_4))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_5 - (vec2(1.0, 0.0) * tmpvar_4))
