per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=newrad = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=xamptarg = 0;
per_frame_init_9=xamp = 0;
per_frame_init_10=xspeed = 0;
per_frame_init_11=q4 = 0;
per_frame_init_12=ypos = 0;
per_frame_init_13=newx = 0;
per_frame_init_14=vol = 0;
per_frame_init_15=newzoom = 0;
per_frame_init_16=q2 = 0;
per_frame_init_17=yamp = 0;
per_frame_init_18=q3 = 0;
per_frame_init_19=xdir = 0;
per_frame_init_20=newy = 0;
per_frame_init_21=yspeed = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.45 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_3=wave_b = wave_b - 0.4 * (0.5 * sin(4.782 * time) + 0.5 * cos(0.722 * time));
per_frame_4=wave_g = wave_g + 0.4 * sin(1.931 * time);
per_frame_5=vol = 0.167 * (bass + mid);
per_frame_6=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_7=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_8=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_9=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_10=xpos = xpos + 0.001 * xspeed;
per_frame_11=wave_x = 1.25 * xpos + 0.5;
per_frame_12=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_13=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_14=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_15=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_16=ypos = ypos + 0.001 * yspeed;
per_frame_17=wave_y = 1.25 * ypos + 0.5;
per_frame_18=q2 = 1.1 * xpos + 0.25 * ypos + 0.5;
per_frame_19=q1 = 1.1 * ypos + 0.25 * xpos + 0.5;
per_frame_20=ib_r = 0.3 + xpos;
per_frame_21=ib_b = 0.06 * bass;
per_frame_22=ib_g = 0.25 + ypos;
per_frame_23=q3 = 10 + 8 * (0.6 * sin(0.423 * time) + 0.4 * sin(0.253 * time));
per_frame_24=q4 = 1 / q3;
per_frame_25=q5 = 0.5 * sign(xpos);
per_frame_26=q6 = 0.5 * sign(ypos);
per_frame_27=monitor = rot;
per_pixel_1=cx = (band(0, x * q3 - q5) + q5) * q4;
per_pixel_2=cy = (band(0, y * q3 - q6) + q6) * q4;
per_pixel_3=newx = q1 - x;
per_pixel_4=newy = q2 - y;
per_pixel_5=newrad = 2 * sqrt(newx * newx + 0.5625 * newy * newy);
per_pixel_6=newzoom = pow(1.05 + 0.03 * newrad, pow(0.01 + sin(newrad * newrad), 2 * newrad - 1));
per_pixel_7=dx = newx * newzoom - newx;
per_pixel_8=dy = newy * newzoom - newy;
per_pixel_9=dx = dx * 0.1;
per_pixel_10=dy = dy * 0.1;
per_pixel_11=rot = 2 * newrad * (0.5 * (0.5 - rad) + 0.1);
