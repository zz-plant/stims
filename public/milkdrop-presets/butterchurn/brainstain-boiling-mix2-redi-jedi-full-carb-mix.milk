per_frame_init_13=beatb2 = 0;
per_frame_init_14=bool = 0;
per_frame_init_15=ph = 0;
per_frame_init_16=const = 0;
per_frame_init_17=q4 = 0;
per_frame_init_18=lbass = 0;
per_frame_init_19=mtime3 = 0;
per_frame_init_20=mtime4 = 0;
per_frame_init_21=rawbeatb = 0;
per_frame_init_22=db = 0;
per_frame_init_23=vol = 0;
per_frame_init_24=bc = 0;
per_frame_init_25=q2 = 0;
per_frame_init_26=ltreb = 0;
per_frame_init_27=phase = 0;
per_frame_init_28=q3 = 0;
per_frame_init_29=q7 = 0;
per_frame_init_30=mtime = 0;
per_frame_init_31=q8 = 0;
per_frame_init_32=avgdb = 0;
per_frame_init_33=db = 0.001;
per_frame_init_34=dt = 0.001;
per_frame_init_35=avgdb = bass - bass_att;
per_frame_init_36=avgdt = treb - treb_att;
per_frame_init_37=lbass = 0;
per_frame_init_38=ltreb = 0;
per_frame_init_39=avgbbeatrate = 0.5;
per_frame_init_40=beatb = 0;
per_frame_init_41=beatb2 = 0;
per_frame_init_42=lbbtime2 = time;
per_frame_init_43=rawbeatb = 0;
per_frame_init_44=lbbtime = time;
per_frame_init_45=avgdb = 0.01;
per_frame_init_46=vol = 0;
per_frame_init_47=avgvol = 1;
per_frame_init_48=ph = 0;
per_frame_init_49=phase = 0;
per_frame_init_50=bool = 0;
per_frame_init_51=const = 0.01;
per_frame_init_52=mtime = 100 + 1000 * bass_att;
per_frame_init_53=mtime2 = 100 + 1000 * treb_att;
per_frame_init_54=mtime4 = 1000 + 1000 * treb;
per_frame_init_55=mtime3 = 1000 + 1000 * bass;
per_frame_1=db = (bass - lbass) * fps;
per_frame_2=dt = (treb - ltreb) * fps;
per_frame_3=ltreb = treb;
per_frame_4=lbass = bass;
per_frame_5=avgdb = 0.9 * avgdb + 0.1 * abs(db);
per_frame_6=avgdt = 0.9 * avgdt + 0.1 * abs(dt);
per_frame_7=rawbeatb = above(abs(db), avgdt);
per_frame_8=beatb = rawbeatb * above(time - lbbtime, 0.75 * avgbbeatrate);
per_frame_9=beatb2 = beatb * above(abs(dt), avgdb);
per_frame_10=beatbhard = beatb2 * (abs(db) - 3 * avgdb);
per_frame_11=avgbbeatrate = beatb * (0.99 * avgbbeatrate + 0.01 * (time - lbbtime)) + (1 - beatb) * (avgbbeatrate + 0.00001 * (3 - avgbbeatrate));
per_frame_12=lbbtime2 = time * beatb2 + (1 - beatb2) * lbbtime2;
per_frame_13=lbbtime = time * beatb + (1 - beatb) * lbbtime;
per_frame_14=ph = (time - lbbtime2) * (60 / avgbbeatrate) * const;
per_frame_15=phase = max(min(ph, 1), 0);
per_frame_16=const = const * (1 - beatb2) + beatb2 * (const + 0.001 * bool);
per_frame_17=bool = below(phase, 0.98) * (0.99 - ph) - 0.5 * above(phase, 0.98) * ph;
per_frame_18=bc = bc + beatb + beatb2;
per_frame_19=vol = rawbeatb * abs(db) * 0.001;
per_frame_20=avgvol = 0.999 * avgvol + 0.01 * vol;
per_frame_21=mtime = mtime + (min(0.01 * avgdt, 0.25) - 0.01 * beatbhard * dt) * (1 / fps);
per_frame_22=mtime2 = mtime2 + (min(0.01 * avgdb, 0.25) + 0.01 * beatbhard * db) * (1 / fps);
per_frame_23=mtime3 = mtime3 + avgvol * abs(db) * q4 * 0.0001 * (1 / fps);
per_frame_24=mtime4 = mtime4 + avgvol * abs(dt) * q4 * 0.0001 * (1 / fps);
per_frame_25=q3 = bc;
per_frame_26=q4 = 60 / avgbbeatrate;
per_frame_27=q5 = mtime;
per_frame_28=q6 = mtime2;
per_frame_29=q7 = mtime3;
per_frame_30=q8 = mtime4;
per_frame_31=wave_r = wave_r + 0.5 * (0.5 * sin(0.05 * (q7 - q5) * q4) + 0.4 * sin(0.916 * time));
per_frame_32=wave_g = wave_g + 0.5 * (0.5 * sin(0.05 * (q6 - q8) * q4) + 0.4 * sin(1.023 * time));
per_frame_33=wave_b = wave_b + 0.5 * (0.5 * sin(0.05 * (q5 - q7) * q4) + 0.4 * sin(0.949 * time));
per_frame_34=decay = decay - 0 * equal(mod(frame, 30), 0);
per_frame_35=q1 = 10 * sin(mtime3);
per_frame_36=q2 = 10 * sin(mtime2);
shape_0_init1=q1 = 0;
shape_0_init2=tex_capture = 0;
shape_0_init3=q3 = 0;
shape_0_per_frame1=ang = ang + q1;
shape_0_per_frame2=tex_capture = 1 - equal(mod(q3 + 8, 16), 0);
shape_1_init1=q2 = 0;
shape_1_init2=tex_capture = 0;
shape_1_init3=q3 = 0;
shape_1_per_frame1=ang = ang + q2;
shape_1_per_frame2=tex_capture = 1 - equal(mod(q3, 16), 0);
