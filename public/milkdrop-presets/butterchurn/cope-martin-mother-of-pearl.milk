per_frame_1=wave_r = wave_r + 0.3 * sin(50 * vol);
per_frame_2=wave_b = wave_b + 0.3 * sin(20 * vol);
per_frame_3=wave_g = wave_g + 0.5 * sin(35 * vol);
per_frame_4=q8 = wave_r;
per_frame_5=q7 = wave_b;
per_frame_6=q6 = wave_g;
per_frame_7=wr = 0.5 + 0.4 * (0.6 * sin(1.1 * time) + 0.4 * sin(0.8 * time));
per_frame_8=wb = 0.5 + 0.4 * (0.6 * sin(1.6 * time) + 0.4 * sin(0.5 * time));
per_frame_9=wg = 0.5 + 0.4 * (0.6 * sin(1.34 * time) + 0.4 * sin(0.4 * time));
