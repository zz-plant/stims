[preset00]
fRating=5.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=7.000000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.001000
fWaveScale=1.286000
fWaveSmoothing=0.630000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpAnimSpeed=1.530000
fWarpScale=1.731000
fZoomExponent=1.208150
fZoom=1.000220
fWarp=0.263000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.301000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_thick=1.000000
wavecode_1_enabled=1.000000
wavecode_1_thick=1.000000
wavecode_2_enabled=1.000000
wavecode_2_usedots=1.000000
wavecode_2_thick=1.000000
wavecode_3_enabled=1.000000
wavecode_3_thick=1.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=rot = rot + 0.03 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.479 * time));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=zoom = zoom + 0.05 + 0.05 * sin(0.133 * time);
per_frame_8=decay = decay - 0.01 * mod(frame, 2);
per_frame_9=dx = dx + dx_residual;
per_frame_10=dy = dy + dy_residual;
per_frame_11=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_12=dx_residual = 0.016 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * dx_residual;
per_frame_13=dy_residual = 0.012 * equal(bass_thresh, 2) * sin(9 * time) + (1 - equal(bass_thresh, 2)) * dy_residual;
per_pixel_1=zoom = (zoom - 1) * rad + 1;
wave_0_init1=ma = 0;
wave_0_init2=mx = 0;
wave_0_init3=my = 0;
wave_0_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.01 * bass;
wave_0_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_0_per_point3=mx = mx + 0.0002 * cos(ma);
wave_0_per_point4=my = my + 0.0002 * sin(ma);
wave_0_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_0_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_0_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_0_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_0_per_point9=x = mx;
wave_0_per_point10=y = my;
wave_0_per_point11=a = above(bass + mid + treb, 0.8);
wave_1_init1=ma = 0;
wave_1_init2=mx = 0;
wave_1_init3=my = 0;
wave_1_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.05 * bass;
wave_1_per_point2=ma = ma - 3.1415 * above(mid, 1) * 0.05 * mid;
wave_1_per_point3=mx = mx + 0.0001 * cos(ma);
wave_1_per_point4=my = my + 0.0001 * sin(ma);
wave_1_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_1_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_1_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_1_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_1_per_point9=x = mx;
wave_1_per_point10=y = my;
wave_1_per_point11=a = above(bass + mid + treb, 0.1);
wave_2_init1=ma = 0;
wave_2_init2=mx = 0;
wave_2_init3=my = 0;
wave_2_per_point1=ma = ma + 3.1415 * above(mid, 1) * 0.01 * mid;
wave_2_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_2_per_point3=mx = mx + 0.0004 * cos(ma);
wave_2_per_point4=my = my + 0.0004 * sin(ma);
wave_2_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_2_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_2_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_2_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_2_per_point9=x = mx;
wave_2_per_point10=y = my;
wave_2_per_point11=a = above(bass + mid + treb, 0.3);
wave_3_init1=ma = 0;
wave_3_init2=mx = 0;
wave_3_init3=my = 0;
wave_3_per_point1=ma = ma + 3.1415 * above(bass, 0.5) * 0.02 * bass;
wave_3_per_point2=ma = ma - 3.1415 * above(treb, 0.5) * 0.02 * treb;
wave_3_per_point3=mx = mx + 0.0008 * cos(ma);
wave_3_per_point4=my = my + 0.0008 * sin(ma);
wave_3_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_3_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_3_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_3_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_3_per_point9=x = mx;
wave_3_per_point10=y = my;
wave_3_per_point11=a = above(bass + mid + treb, 0.2);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  float tmpvar_2;
  tmpvar_2 = dot (texsize.zw, texsize.zw);
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  tmpvar_1.xyz = (max (max (texture (sampler_main, uv).xyz, texture (sampler_main, 
    ((tmpvar_3 * (1.0 - (8.0 * 
      sqrt(tmpvar_2)
    ))) + 0.5)
  ).xyz), texture (sampler_main, (
    (tmpvar_3 * (1.0 + (8.0 * sqrt(tmpvar_2))))
   + 0.5)).xyz) - 0.03);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
float xlat_mutablea;
float xlat_mutableb;
float xlat_mutablec;
 shader_body { 
  vec2 uv_1;
  uv_1 = (uv * 2.0);
  vec2 tmpvar_2;
  tmpvar_2 = floor((fract(
    (uv_1 * 0.5)
  ) * 2.0));
  uv_1 = ((fract(uv_1) * (1.0 - tmpvar_2)) + (tmpvar_2 * fract(
    (1.0 - uv_1)
  )));
  uv_1 = ((0.5 + (
    (uv_1 - 0.5)
   * vec2(0.75, -0.9))) - vec2(0.0, 0.05));
  vec3 tmpvar_3;
  tmpvar_3 = (((
    (((texture (sampler_blur3, uv_1).xyz * scale3) + bias3) + ((texture (sampler_blur2, uv_1).xyz * scale2) + bias2))
   + 
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
  ) + texture (sampler_main, uv_1).xyz) + 0.04);
  xlat_mutablea = (tmpvar_3.x / 4.0);
  xlat_mutableb = (tmpvar_3.y / 4.0);
  xlat_mutablec = (tmpvar_3.z / 4.0);
  xlat_mutablec = ((xlat_mutablec + xlat_mutableb) - (xlat_mutablec * xlat_mutableb));
  xlat_mutablea = ((xlat_mutablea + xlat_mutablec) - (xlat_mutablea * xlat_mutablec));
  vec3 tmpvar_4;
  tmpvar_4 = vec3((1.4 * xlat_mutablea));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ((vec3(4.0, 2.8, 0.0) * (
    (tmpvar_4 * (1.0 - tmpvar_4))
   * 
    (1.0 - tmpvar_4)
  )) + ((tmpvar_4 * tmpvar_4) * vec3(-0.3, 0.2, 0.6)));
  ret = tmpvar_5.xyz;
 }
