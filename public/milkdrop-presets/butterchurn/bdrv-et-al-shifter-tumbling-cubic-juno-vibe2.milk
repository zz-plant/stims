per_frame_init_13=q3 = 0;
per_frame_init_14=q8 = 0;
per_frame_1=wave_a = 0;
per_frame_2=vol = 0.1 * (9 * vol + 0.333333 * (bass_att + mid_att + treb_att));
per_frame_3=q1 = 0.7 * vol;
per_frame_4=q1 = min(q1, 2);
per_frame_5=tic = time - tin;
per_frame_6=tin = time;
per_frame_7=tm = tm + tic * (bass_att + mid_att + treb_att) * 0.333333;
per_frame_8=q2 = tm;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 0.2 * abs(0.3 * cos(4 * rad)) * cos(12 * ang);
per_pixel_5=sx = sx - 11 * dx_r * sin(4 * sin(6 * rad) * cos(6 * rad));
per_pixel_6=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.999 * (thresh - 1.3) + 1.31);
per_pixel_7=tg1 = abs(sin(time));
per_pixel_8=tg2 = 12 * above(tg1, 0.8) + 4 * below(tg1, 0.2) + 6 * above(tg1, 0.2) * below(tg1, 0.4) + 8 * above(tg1, 0.4) * below(tg1, 0.6) + 10 * above(tg1, 0.6) * below(tg1, 0.8);
per_pixel_9=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_10=zoom = zoom + 0.6 - 1.5 * abs(25 * dx_r * cos(tg3 * ang) - 0.2 * sin(22 * dy_r * rad) - rad);
per_pixel_11=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_12=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_13=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_14=zoom = zoom + 0.01;
per_pixel_15=zoom = zoom + 0.2 * (0.05 + 0.04 * sin(time)) * sin(ang * time);
per_pixel_16=rot = rot + 0.005 * cos(5 * ang * bass * time);
per_pixel_17=dx = dx + 0.1 * above(rad, 0.25) * dx_r;
per_pixel_18=dy = dy + 0.1 * above(rad, 0.25) * dy_r;
per_pixel_19=rot = 0.1 * pow(-ang, 3) - 1.18 * sin(ang);
per_pixel_20=zoom = 1.45 * sin(-rad) + 1.3 + sin(rad);
per_pixel_21=dx = dx + 0.09 * sin(0.785 * q8);
per_pixel_22=dy = dy + 0.09 * sin(0.675 * q8);
per_pixel_23=zoom = 1 + 0.01 * sin(13.28 * rad);
per_pixel_24=zoom = zoom + equal(q2, 1) * q3 * 0.1 * (x - 0.5);
per_pixel_25=zoom = zoom + equal(q2, 2) * q3 * 0.1 * (0.5 - x);
per_pixel_26=zoom = zoom + equal(q2, 5) * q3 * 0.1 * (0.5 - y);
per_pixel_27=zoom = zoom + equal(q2, 4) * q3 * 0.1 * (y - 0.5);
per_pixel_28=rot = rot + equal(q2, 3) * q3 * 0.3;
per_pixel_29=rot = rot - equal(q2, 6) * q3 * 0.3;
per_pixel_30=sx = sx + equal(q2, 7) * q3 * 0.2;
per_pixel_31=sy = sy - equal(q2, 8) * q3 * 0.2;
per_pixel_32=sx = sx - equal(q2, 9) * q3 * 0.2;
per_pixel_33=sy = sy + equal(q2, 10) * q3 * 0.2;
per_pixel_34=dy = dy + equal(q2, 11) * abs(0.5 - x) * sign(0.5 - x) * q3 * 0.2;
per_pixel_35=dx = dx + equal(q2, 12) * abs(0.5 - y) * sign(0.5 - y) * q3 * 0.2;
per_pixel_36=dx = dx - equal(q2, 14) * abs(0.5 - y) * sign(0.5 - y) * q3 * 0.2;
per_pixel_37=dy = dy - equal(q2, 13) * abs(0.5 - x) * sign(0.5 - x) * q3 * 0.2;
per_pixel_38=zoom = zoom + 0.5;
per_pixel_39=zoom = if(0.00001 < abs(below(rad, 0.2)), 0.31 + sin(rad - time) / 5, if(0.00001 < abs(above(rad, 0.4)), 1.6 + sin(1 - rad) / 10, 0.95 + sin(rad) / 10));
per_pixel_40=zoom = zoom * 1.28;
