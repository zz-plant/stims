per_frame_init_18=dcsp = 0;
per_frame_1=decay = 0.999;
per_frame_2=ib_b = sin(time / 20) + 0.5;
per_frame_3=ib_g = 0.3 * cos(time / 15) + 0.25;
per_frame_4=ib_r = 0.3 * sin(time / 17) + 0.25;
per_frame_5=flip = flip + 0.1 * below(flip, 1.1);
per_frame_6=q1 = flip;
per_pixel_1=tmmod = sin(time / 1);
per_pixel_2=tm = 0.24;
per_pixel_3=stm = sin(tm);
per_pixel_4=mir = 0.45 + q1;
per_pixel_5=nx = if(0.00001 < abs(above(x, mir)), -(x - mir) + mir, x);
per_pixel_6=warp = 1 + (bass + mid + treb) / 3 + if(0.00001 < abs(above(rad, 0.56 + 0.05 * sin(tmm))), 0.5 * sin(rad), 0);
per_pixel_7=zoom = -stm * (rad + 0.01);
per_pixel_8=sx = if(0.00001 < abs(above(x, mir)), -sin(tm / 5) + 3 * rad, sin(tm / 5) + 3 * rad);
per_pixel_9=sy = cos(tm / 5) + 3 * (rad + 0.1);
per_pixel_10=rot = sin(time / 3);
shape_0_init1=var = 0;
shape_0_init2=var = 0;
shape_0_init3=var = 0;
shape_0_per_frame1=ang = 6 * sin(time);
shape_0_per_frame2=var = 0.12 - 0.2 * above(bass, 0.8);
shape_0_per_frame3=x = sin(time) * var + 0.5;
shape_0_per_frame4=y = cos(time) * var + 0.5;

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_main, uv).xyz;
  ret_1 = (ret_1 + ((
    (ret_1 - mix (((texture (sampler_blur2, uv).xyz * scale2) + bias2), ((texture (sampler_blur1, uv).xyz * scale1) + bias1), uv_orig.xxx))
   * 0.3) - (0.00666 * 
    (((bass + treb) + mid) - 0.5)
  )));
  ret_1 = (ret_1 * 0.95);
  ret_1 = (ret_1 + ((
    ((texture (sampler_noise_lq, ((
      (uv_orig * texsize.xy)
     * 
      (texsize_noise_lq.zw * 0.4)
    ) + rand_frame.xy)).xyz - 0.5) / 256.0)
   * 122.0) * clamp (
    (treb_att - 1.0)
  , 0.0, 1.0)));
  ret_1 = mix (ret_1, vec3(dot (ret_1, vec3(0.32, 0.49, 0.29))), vec3(0.2, 0.2, 0.2));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
