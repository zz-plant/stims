[preset00]
fRating=0.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nWaveMode=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=1.000000
fWaveScale=0.504218
fWaveParam=0.240000
fWarpAnimSpeed=9.860800
fWarpScale=16.217400
fZoomExponent=1.503744
fZoom=1.020100
fWarp=0.819544
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=0.200000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=0.060000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=zoom_exp = 0;
per_frame_init_5=yaccel = 0;
per_frame_init_6=xamptarg = 0;
per_frame_init_7=xamp = 0;
per_frame_init_8=xspeed = 0;
per_frame_init_9=ypos = 0;
per_frame_init_10=xaccel = 0;
per_frame_init_11=att = 0;
per_frame_init_12=vol = 0;
per_frame_init_13=yamp = 0;
per_frame_init_14=xdir = 0;
per_frame_init_15=yspeed = 0;
per_frame_1=dx = -0.0005;
per_frame_2=dy = -0.0005;
per_frame_3=vol = (bass + mid + att) / 6;
per_frame_4=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_5=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_6=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_7=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_8=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_9=xpos = xpos + 0.001 * xspeed;
per_frame_10=wave_x = xpos + 0.5;
per_frame_11=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_12=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_13=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_14=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_15=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_16=ypos = ypos + 0.001 * yspeed;
per_frame_17=wave_y = ypos + 0.5;
per_frame_18=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_19=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_20=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_21=rot = rot + 0.03 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.479 * time));
per_frame_22=cx = cx + 0.41 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_23=cy = cy + 0.41 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_24=wave_mystery = wave_mystery + 0.15 * (0.6 * sin(0.629 * time) + 0.4 * sin(1.826 * time));
per_frame_25=warp = warp * vol;
per_frame_26=zoom = zoom - 0.02 * zoom * bass_att;
per_frame_27=zoom_exp = 1.5 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.479 * time));
per_frame_28=ob_a = 1 - 2 * vol;
per_frame_29=monitor = zoom_exp;
