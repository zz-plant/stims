per_frame_1=ob_r = 0.3 - 0.3 * (0.5 * sin(0.901 * time) + 0.3 * cos(1.438 * time));
per_frame_2=ob_g = 0.4 - 0.4 * sin(3.924 * time);
per_frame_3=ob_b = 0.35 - 0.3 * cos(2.816 * time);
per_frame_4=cx = cx - 0.1 * sin(0.342 * time);
per_frame_5=cy = cy + 0.1 * sin(0.453 * time);
per_frame_6=warp = 0;
per_frame_7=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_8=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_9=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_10=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_11=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_12=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_13=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_14=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_15=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_16=peakbass_att = max(if(0.00001 < abs(beat), bass_att, peakbass_att), 1.1 * meanbass_att);
per_frame_17=q5 = if(0.00001 < abs(beat), 0.1 * randint(1000), oldq5);
per_frame_18=oldq5 = q5;
per_frame_19=q3 = if(0.00001 < abs(beat), 0.1 * randint(1000), oldq3);
per_frame_20=oldq3 = q3;
per_frame_21=ib_size = 0.005 + 0.02 * sin(0.963 * time);
per_frame_22=ob_size = 0.02 * abs(sin(0.7834 * time));
per_frame_23=mv_r = mv_r + 0.3 * sin(3.034 * time);
per_frame_24=mv_g = mv_g + 0.3 * sin(2.547 * time);
per_frame_25=mv_b = mv_b - 0.3 * sin(1.731 * time);
per_frame_26=wave_r = wave_r + 0.5 * sin(0.734 * time);
per_frame_27=wave_b = wave_b + 0.5 * sin(0.615 * time);
per_frame_28=wave_b = wave_b + 0.5 * sin(0.714 * time);
per_frame_29=ib_r = ib_r + 0.5 * sin(0.734 * time);
per_frame_30=ib_g = ib_g + 0.5 * sin(1.215 * time);
per_frame_31=ib_b = ib_b + 0.5 * sin(1.414 * time);
per_frame_32=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * volume * bass_att, 0.5), xamptarg);
per_frame_33=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_34=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_35=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_36=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_37=xpos = xpos + 0.001 * xspeed;
per_frame_38=dx = 0.1 * xpos;
per_frame_39=q2 = xpos;
per_frame_40=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * volume * treb_att, 0.5), yamptarg);
per_frame_41=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_42=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_43=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_44=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_45=ypos = ypos + 0.001 * yspeed;
per_frame_46=dy = 0.1 * ypos;
per_frame_47=q4 = ypos;
per_frame_48=ib_a = if(0.00001 < abs(beat), 1, 0);
per_frame_49=ob_a = if(0.00001 < abs(beat), 1, 0);
per_pixel_1=box = 0.05 + mod(2 * x, 2) + mod(2 * y, 2);
per_pixel_2=q1 = 6.4 + 1.4 * (sin(x + 0.6 * time) - cos(y + 0.432 * time));
per_pixel_3=zoom = if(0.00001 < abs(above(box, 1)), 0.1 * q1, zoom);
per_pixel_4=rot = if(0.00001 < abs(above(box, 1)), 3.5 + abs(sin(3 * (q2 + q4))) * (0.3 * sin(0.385 * time) + 0.4 * sin(0.254 * time) + 0.3 * cos(0.311 * time)), rot);
per_pixel_5=dx = if(0.00001 < abs(above(box, 1)), 4 * q4, dx);
per_pixel_6=dy = if(0.00001 < abs(above(box, 1)), 4 * q2, dy);
