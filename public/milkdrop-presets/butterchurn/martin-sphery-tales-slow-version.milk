[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (((
    (texture (sampler_blur2, uv).xyz * scale2)
   + bias2) * exp(
    (-2.0 * dot (((texture (sampler_blur2, uv_orig).xyz * scale2) + bias2), vec3(0.32, 0.49, 0.29)))
  )) - 0.003);
