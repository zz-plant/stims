  ret_1 = tmpvar_2;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = tmpvar_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
float sw1;
vec2 xlat_mutableuv2;
 shader_body { 
  sw1 = float((rand_preset.x >= 0.4));
