  tmpvar_6.y = uv.y;
  ret_2 = (texture (sampler_main, uv).xyz + texture (sampler_main, tmpvar_6).xyz);
  uv_1 = (uv + ((
    (((sw1 * rad) * (tmpvar_5.xy - 0.5)) / 2.0)
   * 
    float((tmpvar_5.x <= rand_preset.y))
  ) * sw1));
  vec2 tmpvar_7;
  tmpvar_7.x = (1.0 - uv_1.x);
  tmpvar_7.y = uv_1.y;
  ret_2 = (ret_2 + ((
    ((((texture (sampler_blur2, uv_1).xyz * scale2) + bias2) + ((texture (sampler_blur2, tmpvar_7).xyz * scale2) + bias2)) * min ((0.5 + (treb_att / 4.0)), 2.0))
   * 
    (1.0 + sw1)
  ) * clamp (
    (1.0 - (dot (ret_2, vec3(0.32, 0.49, 0.29)) / 2.0))
  , 0.0, 1.0)));
  ret_2 = (ret_2 + (float(
    !(bool(sw1))
  ) * vec3((0.2 * 
    ((0.5 + ((uv.x - 0.5) * q1)) + ((uv.y - 0.5) * q2))
  ))));
  vec3 tmpvar_8;
  tmpvar_8 = mix ((ret_2 * (
    (hue_shader * 2.0)
   - 1.0)), ret_2, vec3(dot (ret_2, vec3(0.32, 0.49, 0.29))));
  ret_2 = tmpvar_8;
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = tmpvar_8;
