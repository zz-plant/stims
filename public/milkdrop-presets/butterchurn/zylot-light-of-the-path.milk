[preset00]
fRating=0.000000
nWaveMode=3.000000
bMotionVectorsOn=0.000000
fWaveParam=-0.440000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fWaveX=0.070000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=zoomlv = 0;
per_frame_1=dx = dx - 0.001;
per_frame_2=dy = dy - 0.001;
per_frame_3=warp = 0;
per_frame_4=wave_r = wave_r + 0.2 * sin(1.33 * time) + 0.3 * bass;
per_frame_5=wave_g = wave_g + 0.2 * sin(time) + 0.3 * treb;
per_frame_6=wave_b = wave_b + 0.2 * sin(0.988 * time) + 0.3 * mid;
per_pixel_1=zoomlv = 0.1 * sin(1000 * ang + time) + 0.05;
per_pixel_2=zoom = zoom + zoomlv;
per_pixel_3=dx = zoomlv;
