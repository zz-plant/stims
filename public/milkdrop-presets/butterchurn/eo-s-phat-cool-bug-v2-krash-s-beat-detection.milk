per_frame_init_1=meanbass_att = 0;
per_frame_init_2=q5 = 0;
per_frame_init_3=flip = 0;
per_frame_init_4=lastbeat = 0;
per_frame_init_5=musictime = 0;
per_frame_init_6=beatrate = 0;
per_frame_init_7=mode = 0;
per_frame_init_8=peakbass_att = 0;
per_frame_init_9=beatcounter = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=att = 0;
per_frame_init_12=volume = 0;
per_frame_init_13=beat = 0;
per_frame_init_14=vol = 0;
per_frame_init_15=zoom = 1;
per_frame_init_16=xpos = 0;
per_frame_init_17=ypos = 0;
per_frame_1=decay = 1;
per_frame_2=vol = 0.55 * (bass + mid + treb);
per_frame_3=vol = vol;
per_frame_4=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_5=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_6=zoom = 0.9;
per_frame_7=musictime = musictime + vol * (75 / fps);
per_frame_8=q4 = 0.3 * sin(0.02 * musictime);
per_frame_9=q5 = 0.3 * sin(0.01 * musictime);
per_frame_10=dx = 0.01 * sin(0.1 * musictime);
per_frame_11=dy = 0.01 * cos(0.069 * musictime);
per_frame_12=monitor = rot;
per_frame_13=volume = 0.3 * (bass + mid + att);
per_frame_14=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_15=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_16=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_17=peakbass_att = max(bass_att, peakbass_att);
per_frame_18=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_19=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_20=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_21=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_22=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_23=beatcounter = beatcounter + beat;
per_frame_24=mode = if(0.00001 < abs(beat * equal(mod(beatcounter, 2), 0)), 1 - mode, mode);
per_frame_25=flip = 2 * mode - 1;
per_frame_26=flip = 0.5 * flip + 0.5;
per_frame_27=rot = -time / 4 * flip;
shape_0_init1=q4 = 0;
shape_0_init2=q5 = 0;
shape_0_per_frame1=x = 0.5 + q4;
shape_0_per_frame2=y = 0.5 + q5;
shape_1_init1=q4 = 0;
shape_1_init2=q5 = 0;
shape_1_per_frame1=tex_ang = 0.01;
shape_1_per_frame2=x = 0.5 + q4;
shape_1_per_frame3=y = 0.5 + q5;
shape_1_per_frame4=ang = time / 5;
