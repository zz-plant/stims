shape_2_init7=t2 = 0.01 * randint(100);
shape_2_per_frame1=x = x + 0.05 * sin(0.017 * q1);
shape_2_per_frame2=y = y + 0.09 * sin(0.013 * q1);
shape_2_per_frame3=tex_ang = q1 * (0.02 + 0.0001 * t1);
shape_2_per_frame4=rad = rad * (0.9 + 0.2 * t2);
shape_2_per_frame5=r = min(1, max(0, r + 0.01 * sin(0.417 * time + 1)));
shape_2_per_frame6=g = min(1, max(0, g + 0.01 * sin(0.391 * time + 2)));
shape_2_per_frame7=b = min(1, max(0, b + 0.01 * sin(0.432 * time + 4)));
shape_2_per_frame8=r2 = min(1, max(0, r2 + 0.01 * sin(0.457 * time + 3)));
shape_2_per_frame9=g2 = min(1, max(0, g2 + 0.01 * sin(0.437 * time + 5)));
shape_2_per_frame10=b2 = min(1, max(0, b2 + 0.01 * sin(0.484 * time + 6)));
shape_3_init1=q1 = 0;
shape_3_init2=q1 = 0;
shape_3_per_frame1=x = x + 0.08 * sin(0.25 * q1);
shape_3_per_frame2=y = y + 0.1 * sin(0.5 * q1 + 2);
shape_3_per_frame3=ang = time;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.01))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv2_1;
  vec3 ret_2;
  uv2_1 = (uv + (vec2(1.0, 0.0) * texsize.zw));
  float tmpvar_3;
  tmpvar_3 = texture (sampler_main, uv2_1).x;
  uv2_1 = (uv + (vec2(-1.0, 0.0) * texsize.zw));
  float tmpvar_4;
  tmpvar_4 = texture (sampler_main, uv2_1).x;
  uv2_1 = (uv + (vec2(0.0, 1.0) * texsize.zw));
  float tmpvar_5;
  tmpvar_5 = texture (sampler_main, uv2_1).x;
  uv2_1 = (uv + (vec2(0.0, -1.0) * texsize.zw));
  vec3 tmpvar_6;
  tmpvar_6.z = 0.08;
  tmpvar_6.x = (tmpvar_3 - tmpvar_4);
  tmpvar_6.y = (tmpvar_5 - texture (sampler_main, uv2_1).x);
  ret_2 = (vec3(1.95, 1.35, 0.9) * clamp (dot (
    normalize(tmpvar_6)
  , vec3(0.9070111, -0.3930381, 0.1511685)), 0.0, 1.0));
  ret_2 = (ret_2 * ((hue_shader * 1.5) - 0.4));
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_2;
  ret = tmpvar_7.xyz;
 }
