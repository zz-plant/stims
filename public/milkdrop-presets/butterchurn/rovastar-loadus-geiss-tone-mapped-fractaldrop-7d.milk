per_frame_init_1=movement = 0;
per_frame_init_2=q1 = 0;
per_frame_1=movement = movement + 0.1 * max(0, bass + bass_att - 2) + 0.15 * pow(bass, 3) + 0.005;
per_frame_2=q1 = movement;
per_frame_3=monitor = q1;
shape_0_init1=q1 = 0;
shape_0_init2=t1 = 0;
shape_0_init3=t1 = 0.01 * randint(100);
shape_0_init4=t2 = 0.01 * randint(100);
shape_0_per_frame1=ang = q1 * (0.303 + 0.01 * t1);
shape_0_per_frame2=r = min(1, max(0, 0.1 * sin(0.417 * time + 1)));
shape_0_per_frame3=g = min(1, max(0, 0.1 * sin(0.391 * time + 2)));
shape_0_per_frame4=b = min(1, max(0, 0.1 * sin(0.432 * time + 4)));
shape_0_per_frame5=r2 = min(1, max(0, r2 + 0.02 * sin(0.657 * time + 3)));
shape_0_per_frame6=g2 = min(1, max(0, g2 + 0.02 * sin(0.737 * time + 5)));
shape_0_per_frame7=b2 = min(1, max(0, b2 + 0.02 * sin(0.884 * time + 6)));
shape_0_per_frame8=additive = 0.5 + 0.15 * (bass + bass_att);
