wave_0_per_point1=sp = 1607.68 * sample;
wave_0_per_point2=it = it + 1;
wave_0_per_point3=it = it * above(sample, 0);
wave_0_per_point4=sz = q1;
wave_0_per_point5=ss = 2 * sample;
wave_0_per_point6=ox = 0.5 * sz * pow(-1, it) * below(ss, 1) + 0.5 * pow(-1, it) * above(ss, 1) * sz;
wave_0_per_point7=oy = (ss - 0.5) * sz * below(ss, 1) + 0.5 * sz * above(ss, 1);
wave_0_per_point8=oz = 0.5 * -sz * below(ss, 1) + (ss - 1 - 0.5) * sz * above(ss, 1);
wave_0_per_point9=xang = 0.132 * q2;
wave_0_per_point10=axang = 0;
wave_0_per_point11=yang = 0.153 * q2;
wave_0_per_point12=ayang = 0;
wave_0_per_point13=zang = 2.1 * q2;
wave_0_per_point14=azang = 0;
wave_0_per_point15=fov = 0.6 + 0.2 * sin(time);
wave_0_per_point16=fov = 0.3;
wave_0_per_point17=mx = ox * cos(zang) - oy * sin(zang);
wave_0_per_point18=my = ox * sin(zang) + oy * cos(zang);
wave_0_per_point19=ox = mx;
wave_0_per_point20=oy = my;
wave_0_per_point21=mx = ox * cos(yang) + oz * sin(yang);
wave_0_per_point22=mz = -ox * sin(yang) + oz * cos(yang);
wave_0_per_point23=ox = mx;
wave_0_per_point24=oz = mz;
wave_0_per_point25=my = oy * cos(xang) - oz * sin(xang);
wave_0_per_point26=mz = oy * sin(xang) + oz * cos(xang);
wave_0_per_point27=oy = my;
wave_0_per_point28=oz = mz;
wave_0_per_point29=aa = 0.5 * (oz - 1);
wave_0_per_point30=a = 0.05;
wave_0_per_point31=oz = oz - 2;
wave_0_per_point32=x = ox * fov / oz + 0.5;
wave_0_per_point33=x = 0.75 * (x - 0.5) + 0.5;
wave_0_per_point34=y = oy * fov / oz + 0.5;
wave_0_per_point35=g = 1 + sin(sp);
wave_0_per_point36=b = 0.5 + 0.5 * sin(1.57 * sample);
wave_0_per_point37=r = 0.5 + 0.5 * cos(1.57 * sample);
