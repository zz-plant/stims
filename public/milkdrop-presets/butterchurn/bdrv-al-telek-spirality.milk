per_frame_init_1=xx = 0;
per_frame_init_2=z = 0;
per_frame_init_3=qqq = 0;
per_frame_init_4=q = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=x = 0;
per_frame_init_7=nn = 0;
per_frame_init_8=qq = 0;
per_frame_init_9=y = 0;
per_frame_init_10=beat = 0;
per_frame_init_11=q2 = 0;
per_frame_init_12=q3 = 0;
per_frame_1=xx = 0.5 * sin(0.13 * time) + 0.5;
per_frame_2=beat = above(bass * bass_att, 3) + bnot(xx);
per_frame_3=x = if(0.00001 < abs(beat), max(min(0.2 * randint(2) - 0.1 + x, 1), 0), x);
per_frame_4=y = if(0.00001 < abs(beat), max(min(0.2 * randint(2) - 0.1 + y, 1), 0), y);
per_frame_5=z = 0.8 * (z - 0.15 * beat) + 0.2;
per_frame_6=wave_x = x;
per_frame_7=wave_y = y;
per_frame_8=wave_mystery = 1.7 * xx - 0.5;
per_frame_9=ob_a = beat;
per_frame_10=wave_r = 0.5 * sin(0.197 * time) + 0.5;
per_frame_11=wave_g = 0.5 * cos(0.201 * time) + 0.5;
per_frame_12=wave_b = 0.5 * sin(0.215 * time) + 0.5;
per_frame_13=xx = 0.5 * sin(62.82 * xx) + 0.5;
per_frame_14=wave_r = xx + (1 - xx) * wave_r;
per_frame_15=wave_g = xx + (1 - xx) * wave_g;
per_frame_16=wave_b = xx + (1 - xx) * wave_b;
per_frame_17=monitor = zoom;
per_frame_18=q = if(0.00001 < abs(beat), randint(100), q + 0.01);
per_frame_19=q1 = q;
per_frame_20=qq = if(0.00001 < abs(beat), randint(100), q - 0.01);
per_frame_21=q2 = qq;
per_frame_22=qqq = if(0.00001 < abs(beat), randint(3), 0.95 * q);
per_frame_23=q3 = qqq;
per_pixel_1=nn = mod(0.2 * time, 7) + 1;
per_pixel_2=nn = 7;
per_pixel_3=cx = (floor(x * nn) + 0.5) / nn;
per_pixel_4=cy = (floor(y * nn) + 0.5) / nn;
per_pixel_5=dx = 0.0001 * (q1 + floor(x * nn - 2));
per_pixel_6=dy = 0.0001 * (q2 + floor(y * nn - 2));
per_pixel_7=dx = 0.01 * sin(q1 + floor(x * nn) * (q2 + 1));
per_pixel_8=dy = 0.01 * sin(q2 + floor(y * nn) * (q1 + 1));
per_pixel_9=rot = 0.06 * floor(2 * sin(q3 + 10 * (cx + cy)));
per_pixel_10=rot = rot + if(0.00001 < abs(equal(tan(2 * ang), 0)), -rot, rad);
per_pixel_11=zoom = zoom + 0.1 * sin(rad + 0.4 * time + 5);
