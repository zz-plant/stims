per_frame_init_40=p = 3.14159265;
per_frame_init_41=p2 = 2 * p;
per_frame_init_42=p3 = 180 / p;
per_frame_init_43=dir = 1;
per_frame_1=rot = rot - 0.0125 * bass * sin(time + bass);
per_pixel_1=vt = sin(i * p2 * 4) * (v + 1) / 2;
per_pixel_2=x1 = sin(i * p2 * 2);
per_pixel_3=y1 = if(0.00001 < abs(below(i, 0.5)), vt, 0);
per_pixel_4=z1 = if(0.00001 < abs(above(i, 0.5)), vt, 0);
per_pixel_5=y2 = y1 * xc - z1 * xs;
per_pixel_6=z2 = y1 * xs + z1 * xc;
per_pixel_7=x2 = z2 * ys + x1 * yc;
per_pixel_8=z3 = z2 * yc - x1 * ys;
per_pixel_9=x3 = x2 * zc - y2 * zs;
per_pixel_10=y3 = y2 * zc + x2 * zs;
per_pixel_11=x4 = mx + x3;
per_pixel_12=y4 = my + y3;
per_pixel_13=z4 = mz + z3;
per_pixel_14=x = x4 / (1 + z4 / dst);
per_pixel_15=y = y4 / (1 + z4 / dst);
shape_0_init1=dir = 0;
shape_0_init2=d = 0;
