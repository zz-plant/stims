shape_0_init4=n = 1024;
shape_0_init5=dir = 1;
shape_0_per_frame1=dir = dir * if(0.00001 < abs(above(bass, 1.3)), -1, 1);
shape_0_per_frame2=d = 0.2 * instance / n;
shape_0_per_frame3=r = mid * time * 3.1824 * treb;
shape_0_per_frame4=x = 0.5 + dir * cos(r) * d * 0.005 - dir * sin(-d + 0.5 * mid * time) * d * 10;
shape_0_per_frame5=y = 0.5 + dir * sin(r) * d * 0.005 + dir * cos(-d + 0.5 * mid * time) * d * 10;
shape_1_per_frame1=a = bass;
shape_1_per_frame2=rad = (bass + mid + treb) / 3;
shape_1_per_frame3=x = if(0.00001 < abs(below(bass, 1.2)), 0.1 * randint(10) * treb, 0.5);
shape_1_per_frame4=y = if(0.00001 < abs(below(bass, 1.2)), 0.1 * randint(10) * mid, 0.5);
shape_1_per_frame5=r = 1 - (0.7 + 0.5 * abs(sin(0.05 * time + 0.5 * bass)));
shape_1_per_frame6=g = 1 - (0.5 + 0.5 * abs(cos(0.05 * time - 0.4 * mid)));
shape_1_per_frame7=b = 1 - (0.5 + 0.5 * abs(sin(0.05 * time + 0.6 * treb)));
