per_frame_1=warp = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=vol = 0.333333 * (bass_att + treb_att + mid_att);
per_frame_5=ra = 0.1 * (1 / tic);
per_frame_6=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_7=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_8=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_9=vav = tic * (vav * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_10=tt = tt + tic * treb;
per_frame_11=mt = mt + tic * mid;
per_frame_12=bt = bt + tic * bass;
per_frame_13=vt = vt + tic * vav;
per_frame_14=sp = 0.1 * abs(vav - slide);
per_frame_15=slide = if(0.00001 < abs(above(slide, vav)), slide - tic * sp, slide + tic * sp) + (1 - toc) * vav * 0.2;
per_frame_16=toc = 1;
per_frame_17=q1 = 0;
per_frame_18=q2 = 0.5 * bt + 5;
per_frame_19=q3 = 0.5 * mt + 3;
per_frame_20=q4 = 0.5 * tt;
per_frame_21=q5 = 0.1 + 0.2 * (treb_avg + mid_avg);
per_frame_22=zoom = 1 - 0.2 * bass_avg;
per_frame_23=monitor = q5;
per_pixel_1=coy = (coy + below(y, oy)) * above(q1, 0);
per_pixel_2=cox = (cox + 1) * above(q1, 0) * equal(coy, ocoy);
per_pixel_3=moy = max(coy, moy);
per_pixel_4=mox = max(cox, mox);
per_pixel_5=nu = 4;
per_pixel_6=pox = (cox / nu - floor(cox / nu)) * nu;
per_pixel_7=poy = (coy / nu - floor(coy / nu)) * nu;
per_pixel_8=mod = (1 - 2 * above(x, 0.5)) * (1 - 2 * above(y, 0.5));
per_pixel_9=dx = 0.001 * if(0.00001 < abs(equal(mod(coy, 2), 0)), -equal(pox, 1) + equal(pox, 2), equal(pox, 0) - equal(pox, 3));
per_pixel_10=dy = 0.001 * if(0.00001 < abs(equal(mod(coy, 2), 0)), -equal(pox, 1) + equal(pox, 2), equal(pox, 0) - equal(pox, 3)) * mod;
per_pixel_11=dis = x + (1 - y);
per_pixel_12=mod = if(0.00001 < abs(above(dis, 1)), dis - 1, 1 - dis);
per_pixel_13=mod = below(mod, 0.2) + (1 - min(1, 4 * (mod - 0.2))) * above(mod, 0.2);
per_pixel_14=zm = q5;
per_pixel_15=modx = if(0.00001 < abs(above(dis, 1)), zm, -zm);
per_pixel_16=mody = if(0.00001 < abs(above(dis, 1)), -zm, zm);
per_pixel_17=dx = dx * mod + (1 - mod) * modx;
per_pixel_18=dy = dy * mod + (1 - mod) * mody;
per_pixel_19=rot = 0.3 * mod;
per_pixel_20=oy = y;
per_pixel_21=ocoy = coy;
per_pixel_22=q1 = q1 + 1;
