per_frame_1=dec_med = pow(0.85, 30 / fps);
per_frame_2=dec_slow = pow(0.96, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, -0.5 + avg + peak) * above(time, t0 + 0.1);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 32);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=q22 = peak;
per_frame_11=q27 = index;
per_frame_12=q28 = index2 + 1;
per_frame_13=q24 = is_beat;
per_frame_14=trig = is_beat * equal(mod(index, 2), 0);
per_frame_15=p1 = trig * (p1 + 1) + (1 - trig) * p1;
per_frame_16=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_17=rott = 3.1416 * p2 / 4;
per_frame_18=q1 = cos(rott);
per_frame_19=q2 = sin(rott);
per_frame_20=trig = is_beat * equal(mod(index, 24), 0);
per_frame_21=ran1 = if(0.00001 < abs(trig), 2 * (randint(100) / 100 - 0.5), ran1);
per_frame_22=trig = is_beat * equal(mod(index, 16), 0);
per_frame_23=ran2 = if(0.00001 < abs(trig), 2 * (randint(100) / 100 - 0.5), ran2);
per_frame_24=trig = is_beat * equal(mod(index, 12), 0);
per_frame_25=ran3 = if(0.00001 < abs(trig), 2 * (randint(100) / 100 - 0.5), ran3);
per_frame_26=ran1_ = dec_med * ran1_ + (1 - dec_med) * ran1;
per_frame_27=ran2_ = dec_med * ran2_ + (1 - dec_med) * ran2;
per_frame_28=ran3_ = dec_med * ran3_ + (1 - dec_med) * ran3;
per_frame_29=q11 = ran1_;
per_frame_30=q12 = ran2_;
per_frame_31=dx = 0.02 * ran1_;
per_frame_32=dy = 0.02 * ran2_;
per_frame_33=zoom = 1 + 0.05 * ran3_;
per_frame_34=peak_ = dec_med * peak_ + (1 - dec_med) * peak;
per_frame_35=peak__ = dec_slow * peak__ + (1 - dec_slow) * peak_;
per_frame_36=ma = ma + 50 * (peak_ - peak__) / fps * bnot(mod(index, 2));
per_frame_37=mx = mx * dec_slow + (1 - dec_slow) * cos(1.3 * ma);
per_frame_38=my = my * dec_slow + (1 - dec_slow) * sin(ma);
per_frame_39=q15 = mx;
per_frame_40=q16 = 0.8 * my;
per_frame_41=q17 = 0.8 * ma;
per_frame_42=q32 = aspecty;
per_frame_43=monitor = dx;
