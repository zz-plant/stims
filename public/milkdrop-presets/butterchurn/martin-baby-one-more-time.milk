shape_2_init7=q12 = 0;
shape_2_per_frame1=k1 = 6.3 * (instance / num_inst);
shape_2_per_frame2=x = 0.5 + q15 * cos(k1 + q17) + -0.2 * q11;
shape_2_per_frame3=y = 0.5 + q16 * q32 * sin(k1 + q17 + time) + 0.2 * q12;
shape_2_per_frame4=a = 0.5;
shape_2_per_frame5=a2 = 0.1;
shape_2_per_frame6=r = 0.5;
