[preset00]
fRating=0.000000
fDecay=0.950000
bWaveDots=1.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
fWaveAlpha=1.704175
fWaveScale=0.044484
fWaveSmoothing=0.000000
fWaveParam=-0.480000
fShader=1.000000
fZoom=0.999998
fSx=0.980296
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.000000
fOuterBorderR=1.000000
fOuterBorderG=1.000000
fOuterBorderB=1.000000
fInnerBorderSize=0.500000
fInnerBorderR=1.000000
fInnerBorderG=1.000000
fInnerBorderB=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=q2 = 0;
per_frame_1=warp = 0;
per_frame_2=mv_r = 0.7 + 0.3 * sin(0.5683 * time);
per_frame_3=mv_b = 0.8 + 0.2 * sin(0.7832 * time);
per_frame_4=mv_g = 0.82 + 0.15 * sin(1.103 * time);
per_frame_5=q1 = max(max(bass, bass_att) - 1.15, 0);
per_frame_6=q2 = max(max(treb, treb_att) - 1.15, 0);
per_frame_7=rot = abs(0.05 * sin(time)) - 1.3 * q1;
per_pixel_1=zoom = 0.4 + atan(1.5 * atan(rad) * rad) + 2.5 * q1;
per_pixel_2=zoomexp = max(10 * (1 + q1 - q2), 0.2);

[warp_shader]
shader_body { 
  vec2 uv3_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  uv3_1.x = (((
    (tmpvar_3.x * q1)
   + 
    (tmpvar_3.y * q2)
  ) * 0.97) + 0.5);
  uv3_1.y = (((
    (tmpvar_3.x * -(q2))
   + 
    (tmpvar_3.y * q1)
  ) * 0.97) + 0.5);
  ret_2.x = texture (sampler_main, uv).x;
  ret_2.y = texture (sampler_main, mix (uv, uv3_1, vec2(0.5, 0.5))).y;
  ret_2.z = texture (sampler_main, uv3_1).z;
  vec3 tmpvar_4;
  tmpvar_4.x = -(ret_2.x);
  tmpvar_4.y = (ret_2.x - ret_2.y);
  tmpvar_4.z = (ret_2.y - ret_2.z);
  ret_2 = (ret_2 + (tmpvar_4 * 0.03));
  ret_2 = (ret_2 + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0) * 3.0));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_2;
  ret = tmpvar_5.xyz;
 }

[comp_shader]
uniform sampler2D sampler_seaweed;
 shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ((texture (sampler_seaweed, (0.4 + 
    (0.6 * tmpvar_1.xy)
  )) * tmpvar_1.z) * 3.0).xyz;
  ret = tmpvar_2.xyz;
 }
