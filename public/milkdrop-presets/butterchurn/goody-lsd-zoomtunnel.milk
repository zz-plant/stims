per_frame_init_1=pi = 0;
per_frame_init_2=volsine = 0;
per_frame_init_3=decay = 0.1;
per_frame_1=sx = 1;
per_frame_2=sy = 1;
per_pixel_1=pi = 3.14159;
per_pixel_2=volsine = 0.05 * (bass + mid + treb) * sin(time * (0.1 * bass + 0.1 * mid + 0.1 * treb));
per_pixel_3=zoom = zoom + above(rad, 0.38) * atan(rad * rad);
per_pixel_4=rot = atan(4 * rot * ang * 0.1 * sin(16 * ang) * above(rad, 0.5));
shape_1_init1=ptex_ang = 0;
shape_1_init2=ptex_ang = 0;
shape_1_init3=py = 0;
shape_1_init4=py = 0;
shape_1_init5=py = 0;
shape_1_init6=px = 0;
