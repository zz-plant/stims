shape_1_init24=greenif = 0;
shape_1_init25=blueif = 0;
shape_1_per_frame1=tex_ang = if(0.00001 < abs(above(treb, 1.2)), tex_ang + abs(6.28 * sin(time)), ptex_ang);
shape_1_per_frame2=ptex_ang = tex_ang;
shape_1_per_frame3=y = if(0.00001 < abs(above(treb, 1.2)), y + abs(0.02 * sin(time)), py);
shape_1_per_frame4=py = y;
shape_1_per_frame5=x = if(0.00001 < abs(above(treb, 1.2)), x + abs(0.008 * sin(0.8 * time)), py);
shape_1_per_frame6=px = x;
shape_1_per_frame7=vol = 0.3333 * (bass + mid + treb_att);
shape_1_per_frame8=redsine = 0.5 + 0.15 * bass * sin(3 * time);
shape_1_per_frame9=greensine = 0.5 + 0.15 * mid * sin(2 * time);
shape_1_per_frame10=bluesine = 0.5 + 0.15 * treb * sin(time);
shape_1_per_frame11=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.85 * redif));
shape_1_per_frame12=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.85 * greenif));
shape_1_per_frame13=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.85 * blueif));
shape_1_per_frame14=border_r = redif;
shape_1_per_frame15=border_g = greenif;
shape_1_per_frame16=border_b = blueif;
shape_1_per_frame17=border_a = above(bass, 1);
