per_frame_1=wave_r = wave_r + 0.3 * (0.6 * sin(0.633 * time) + 0.4 * sin(0.845 * time));
per_frame_2=wave_g = wave_g + 0.3 * (0.6 * sin(0.37 * time) + 0.4 * sin(0.656 * time));
per_frame_3=wave_b = wave_b + 0.3 * (0.6 * sin(0.74 * time) + 0.4 * sin(0.52 * time));
