[preset00]
fRating=3.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=3.000000
nWaveMode=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=100.000000
fWaveScale=1.175613
fWaveSmoothing=0.306000
fWaveParam=-0.460000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoomExponent=0.854653
fWarp=0.010000
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderSize=0.500000
fOuterBorderR=0.190000
fOuterBorderG=0.120000
fInnerBorderSize=0.015000
fInnerBorderA=1.000000
nMotionVectorsX=7.679999
nMotionVectorsY=11.519997
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.340000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=vol_now = 0;
per_frame_init_2=redneg = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=slowtime = 0;
per_frame_init_5=blueneg = 0;
per_frame_init_6=greenneg = 0;
per_frame_init_7=beat = 0;
per_frame_init_8=q2 = 0;
per_frame_init_9=vol_mean = 0;
per_frame_1=slowtime = slowtime + beat * time;
per_frame_2=vol_now = 0.4 * bass + 0.1 * (bass_att + treb + mid);
per_frame_3=vol_mean = if(0.00001 < abs(equal(mod(frame, 50), 0)), vol_mean - 0.5 * (vol_mean - vol_now), 0.1 * (9 * vol_mean + vol_now));
per_frame_4=beat = if(0.00001 < abs(above(vol_now, 1.5 * vol_mean)), 1, 0);
per_frame_5=ib_r = -abs(cos(time));
per_frame_6=ib_g = sin(time);
per_frame_7=ib_b = cos(time) * sign(cos(time));
per_frame_8=mv_r = abs(sin(time));
per_frame_9=mv_g = sin(slowtime);
per_frame_10=mv_b = cos(slowtime) * sign(cos(slowtime));
per_frame_11=redneg = if(0.00001 < abs(below(mv_r, 0)), 1, 0);
per_frame_12=greenneg = if(0.00001 < abs(below(mv_g, 0)), 1, 0);
per_frame_13=blueneg = if(0.00001 < abs(below(mv_b, 0)), 1, 0);
per_frame_14=wave_r = if(0.00001 < abs(redneg), if(0.00001 < abs(bor(greenneg, blueneg)), 1, 1 + mv_r), mv_r);
per_frame_15=wave_g = if(0.00001 < abs(greenneg), if(0.00001 < abs(equal(greenneg + blueneg, 2)), 1, 1 + mv_g), mv_g);
per_frame_16=wave_b = if(0.00001 < abs(blueneg), 1 + mv_b, mv_b);
per_frame_17=dx = 0.0125 * sin(1.234 * slowtime);
per_frame_18=dy = 0.0125 * cos(0.9666 * slowtime);
per_frame_19=q1 = sin(slowtime);
per_frame_20=q2 = wave_b;
per_pixel_1=zoom = 1 + 0.1 * above(sin(1.7 * q2), -0.5) * sin(2 * q2 + 0.027 * q1 + 4 * (1 + sin(0.7 * time + q2)) * sin(0.05 * q2 + time) * rad);
per_pixel_2=rot = 0.1 * sin(q2) * sin(2.3 * q2 + 0.027 * q1 + 2 * sin(0.07 * q1 + 1.2 * time) * (rad + sin(time + 4 * above(sin(q2), 0) * sin(q2) * ang)));
per_pixel_3=rot = rot * above(sin(1.2 * q2 + 1.3), -0.5);
