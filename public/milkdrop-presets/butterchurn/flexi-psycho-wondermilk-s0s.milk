per_frame_17=q2 = 0.1 * n;
per_frame_18=q3 = 0.1 * -n1;
per_frame_19=q4 = 0.15 * n2;
per_frame_20=k = 0.995 * k + sqr(2 * mid_att);
per_frame_21=q5 = 0.001 * -k;
per_pixel_1=d = sqrt((x - 0.5) * (x - 0.5) + (y - 0.5) * (y - 0.5)) * rad;
per_pixel_2=n = 15;
per_pixel_3=t = sin(time) * q5 * 5;
per_pixel_4=w = 0.7 * q5 * cos(time);
per_pixel_5=v = 10;
per_pixel_6=x2 = x - 0.5;
per_pixel_7=y2 = y - 0.5;
per_pixel_8=x1 = sin(w) * x2 - cos(w) * y2;
per_pixel_9=y1 = cos(w) * x2 + sin(w) * y2;
per_pixel_10=x = x1;
per_pixel_11=y = y1;
per_pixel_12=dx1 = 0.01 * (cos((-x + y) * n + t) + sin((x + y) * n + t));
per_pixel_13=dy1 = 0.01 * (cos((x - y) * n - t) + sin((-x - y) * n - t));
per_pixel_14=dx2 = sin(-w) * dx1 - cos(-w) * dy1;
per_pixel_15=dy2 = cos(-w) * dx1 + sin(-w) * dy1;
per_pixel_16=dx = v * dx2;
per_pixel_17=dy = v * dy2;
