wave_0_per_point1=s8 = 383 * sample;
wave_0_per_point2=dir = 0.19634375 * s8;
wave_0_per_point3=v = 0.0005;
wave_0_per_point4=t1 = 0;
wave_0_per_point5=d = 1;
wave_0_per_point6=xx = sin(dir + 10 * time) * (sample * d + t1);
wave_0_per_point7=yy = cos(dir + 10 * time) * (sample * d + t1);
wave_0_per_point8=zz = 0 * cos(1000 * sample + 5 * time);
wave_0_per_point9=v = 0.001;
wave_0_per_point10=w = 1 - (sample - 0.5) * t6;
wave_0_per_point11=s1 = sin(t2 * w);
wave_0_per_point12=s2 = sin(t3 * w);
wave_0_per_point13=s3 = sin(t4 * w);
wave_0_per_point14=c1 = cos(t2 * w);
wave_0_per_point15=c2 = cos(t3 * w);
wave_0_per_point16=c3 = cos(t4 * w);
wave_0_per_point17=z = (c3 * s1 * c2 + s3 * s2) * xx - (c3 * s1 * s2 - s3 * c2) * yy + c3 * c1 * zz;
wave_0_per_point18=x1 = c1 * c2 * xx + c1 * s2 * yy - s1 * zz;
wave_0_per_point19=y1 = (s3 * s1 * c2 - c3 * s2) * xx + (s3 * s1 * s2 + c3 * c2) * yy + s3 * c1 * zz;
wave_0_per_point20=a = 2;
wave_0_per_point21=zoom = 0.5 * atan2(a - z, a);
wave_0_per_point22=x = 0.5 + zoom * x1;
wave_0_per_point23=y = 0.5 + zoom * y1;
wave_0_per_point24=pi3 = 2.0941239;
wave_0_per_point25=t = 1.2 * -z + 20 * t5;
wave_0_per_point26=c = 10;
wave_0_per_point27=r = sin(t) * c;
wave_0_per_point28=g = sin(t + pi3) * c;
wave_0_per_point29=b = sin(t - pi3) * c;
wave_0_per_point30=j = 0.71;
wave_0_per_point31=r = if(0.00001 < abs(above(r, 1)), 1, r);
wave_0_per_point32=r = if(0.00001 < abs(below(r, 0)), 0, r);
wave_0_per_point33=g = if(0.00001 < abs(above(g, 1)), 1, g);
wave_0_per_point34=g = if(0.00001 < abs(below(g, 0)), 0, g);
wave_0_per_point35=b = if(0.00001 < abs(above(b, 1)), 1, b);
wave_0_per_point36=b = if(0.00001 < abs(below(b, 0)), 0, b);
wave_0_per_point37=a = 1 * sigmoid(-z, 2);
