per_frame_34=q22 = y;
per_frame_35=wave_x = q1;
per_frame_36=wave_y = 1 - q2;
per_pixel_1=cx = q21;
per_pixel_2=cy = q22;
per_pixel_3=d = pow(sqrt(sqr(x - cx) + sqr(y - cy)), 0.8);
per_pixel_4=r = 0.2;
per_pixel_5=v = 0.2;
per_pixel_6=dx = (x - cx) * v * (d - r);
per_pixel_7=dy = (y - cy) * v * (d - r);
shape_0_init1=vx = 0;
shape_0_init2=vy = 0;

