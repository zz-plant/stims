per_frame_26=beat = above(vol, res);
per_frame_27=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_28=res = beat * (vol + 2 * diff) + (1 - beat) * (res - 60 * (0.04 * diff + 0.12) / fps);
per_frame_29=res = max(0, res);
per_frame_30=monitor = res;
per_frame_31=x = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, x);
per_frame_32=y = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, y);
