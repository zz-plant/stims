per_frame_init_1=q1 = 0;
per_frame_init_2=q3 = 0;
per_frame_init_3=q8 = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_init_5=vol = 0;
per_frame_init_6=q2 = 0;
per_frame_init_7=temp = 0;
per_frame_init_8=q6 = 0;
per_frame_init_9=q8 = 1;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.91 * (bass_thresh - 1.3) + 1.3);
per_frame_2=vol = 0.1 * (9 * vol + 0.333333 * (bass_att + mid_att + treb_att));
per_frame_3=q1 = vol;
per_frame_4=q2 = bass_thresh;
per_frame_5=temp = temp + (1.5 * above(vol, 1.1) + 1 * below(vol, 1.1));
per_frame_6=q8 = temp;
per_frame_7=q3 = q3 + -0.5 * below(vol, 1.1) + 2 * above(vol, 1.1);
per_frame_8=q3 = 1;
per_frame_9=cx = cx + 0.4 * sin(q3 * sin(q8 / (8 * q3)));
per_frame_10=q6 = cx;
per_pixel_1=cy = cy - cos(rad * q1 * sin(0.6 * time));
per_pixel_2=cx = cx + 1.5 * sin(rad * q3 * sin(q8 / (8 * q3)));
shape_0_init1=q2 = 0;
shape_0_init2=q6 = 0;
shape_0_per_frame1=r = r + 0.3 * (0.6 * sin(1.22 * time) + 0.4 * sin(0.888 * time));
shape_0_per_frame2=g = g + 0.3 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.1 * time));
shape_0_per_frame3=b = b + 0.3 * (0.6 * sin(1.12 * time) + 0.4 * sin(0.98 * time));
shape_0_per_frame4=rad = rad + 0.5 * equal(q2, 2);
shape_0_per_frame5=y = y - 0.1 * q6;
shape_1_init1=q2 = 0;
shape_1_init2=q6 = 0;
shape_1_per_frame1=r = r + 0.3 * (0.6 * sin(2.52 * time) + 0.4 * sin(2.588 * time));
shape_1_per_frame2=g = g + 0.3 * (0.6 * sin(2.7 * time) + 0.4 * sin(2.7 * time));
shape_1_per_frame3=b = b + 0.3 * (0.6 * sin(2.32 * time) + 0.4 * sin(2.18 * time));
shape_1_per_frame4=rad = rad + 0.5 * equal(q2, 2);
shape_1_per_frame5=y = y - 0.15 * q6;
shape_2_init1=q2 = 0;
shape_2_init2=q6 = 0;
shape_2_per_frame1=r = r + 0.3 * (0.6 * sin(3.22 * time) + 0.4 * sin(3.888 * time));
shape_2_per_frame2=g = g + 0.3 * (0.6 * sin(3.9 * time) + 0.4 * sin(3.1 * time));
shape_2_per_frame3=b = b + 0.3 * (0.6 * sin(3.12 * time) + 0.4 * sin(3.98 * time));
shape_2_per_frame4=rad = rad + 0.5 * equal(q2, 2);
shape_2_per_frame5=y = y - 0.1 * q6;
shape_3_init1=q2 = 0;
shape_3_init2=q6 = 0;
shape_3_per_frame1=r = r + 0.3 * (0.6 * sin(4.22 * time) + 0.4 * sin(4.888 * time));
shape_3_per_frame2=g = g + 0.3 * (0.6 * sin(4.9 * time) + 0.4 * sin(4.1 * time));
shape_3_per_frame3=b = b + 0.3 * (0.6 * sin(4.12 * time) + 0.4 * sin(4.98 * time));
shape_3_per_frame4=rad = rad + 1 * equal(q2, 2);
shape_3_per_frame5=y = y - 0.1 * q6;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_fc_main, uv).xyz * 0.95);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = (1.0 - uv.x);
  tmpvar_2.y = uv.y;
  ret_1 = (texture (sampler_main, tmpvar_2).xyz + texture (sampler_main, uv).xyz);
  ret_1 = (ret_1 * 1.42);
  ret_1 = (ret_1 * ret_1);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
