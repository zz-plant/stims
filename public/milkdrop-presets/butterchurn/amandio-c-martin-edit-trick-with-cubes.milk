shape_0_per_frame1=i = instance;
shape_0_per_frame2=sa = i / 972;
shape_0_per_frame3=sa1 = mod(i / 162, 6) / 6;
shape_0_per_frame4=t1 = 6.28 * sa1 + q1;
shape_0_per_frame5=z1 = 0.1 + 0.07 * sin(0.3 * q1) + 0.6 * (instance / num_inst);
shape_0_per_frame6=x1 = z1 * sin(t1) * sin(0.5 * q1);
shape_0_per_frame7=y1 = z1 * cos(1.1 * t1);
shape_0_per_frame8=w = atan2(y1, x1) + 0.32 * q3;
shape_0_per_frame9=x20 = mod(i / 6, 27) / 27;
shape_0_per_frame10=y20 = mod(i / 6, 9) / 9;
shape_0_per_frame11=z20 = mod(i / 6, 3) / 3;
shape_0_per_frame12=x2 = 0.4 * x20 - y20 + 0.7 * z20;
shape_0_per_frame13=y2 = 1.2 * sin(time) * x20 - 1.3 * cos(0.4 * time) * y20 - 1.7 * sin(1.2 * time) * z20;
shape_0_per_frame14=t2 = w;
shape_0_per_frame15=mx2 = x2 * sin(t2) + y2 * cos(t2);
shape_0_per_frame16=my2 = y2 * sin(t2) - x2 * cos(t2);
shape_0_per_frame17=z2 = 0.7 * z1;
shape_0_per_frame18=x2 = mx2 * z2;
shape_0_per_frame19=y2 = my2 * z2;
shape_0_per_frame20=t3 = 1017.36 * sa + 0.5 * sa + q1;
shape_0_per_frame21=z3 = 0.13 * z2;
shape_0_per_frame22=x3 = z3 * sin(t3);
shape_0_per_frame23=y3 = z3 * cos(t3);
shape_0_per_frame24=x = 0.5 + (x1 + x2 + x3) / q6;
shape_0_per_frame25=y = 0.5 + (y1 + y2 + y3);
shape_0_per_frame26=rad = 2 * z3;
shape_0_per_frame27=ang = 3.14 / 4 + t3;
shape_0_per_frame28=t1 = 0.5 + 0.4 * sin(4.71 * y20);
shape_0_per_frame29=r = 0.1 + mod(0.25 * (i / 2), 3);
shape_0_per_frame30=r = r * t1;
shape_0_per_frame31=r2 = r;
shape_0_per_frame32=g = r * r;
shape_0_per_frame33=g2 = g;
shape_0_per_frame34=b = z1;
shape_0_per_frame35=b2 = b;

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_blur1, uv);
  ret_1 = (vec3(2.0, 2.0, 0.0) * mix (texture (sampler_main, uv).xyz, (
    (tmpvar_2.xyz * scale1)
   + bias1), vec3((1.0 - 
    exp((-7.0 * abs((
      (1.0 - ((tmpvar_2.xyz * scale1) + bias1).z)
     - 0.9))))
  ))));
  ret_1 = (ret_1 + ((
    (1.0 - uv.y)
   * vec3(0.3, 0.0, 0.5)) * clamp (
    (1.0 - (3.0 * ((tmpvar_2.xyz * scale1) + bias1).z))
  , 0.0, 1.0)));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
