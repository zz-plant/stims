[preset00]
fRating=0.000000
fDecay=0.960000
fVideoEchoZoom=0.999900
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
fWaveAlpha=1.000000
fWaveScale=25.080072
fWaveParam=-1.000000
fZoomExponent=1.008100
fShader=0.300000
fZoom=0.122270
fRot=0.240000
fCX=2.000000
fCY=-1.000000
fWarp=0.010000
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderSize=0.005000
fOuterBorderR=1.000000
fOuterBorderA=0.100000
fInnerBorderSize=0.003000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=1.000000
fInnerBorderA=0.600000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.050000
fMotionVectorsR=0.000000
fMotionVectorsG=0.700000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=grid = 0;
per_frame_init_2=snee = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=myg = 0;
per_frame_init_5=block = 0;
per_frame_init_6=pulse = 0;
per_frame_init_7=myb = 0;
per_frame_init_8=avg = 0;
per_frame_init_9=le = 0;
per_frame_init_10=myr = 0;
per_frame_init_11=ccl = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=th = 0;
per_frame_1=le = 1.4 * bass_att + 0.1 * bass + 0.5 * treb;
per_frame_2=pulse = band(above(le, th), above(le - th, block));
per_frame_3=block = le - th;
per_frame_4=th = if(0.00001 < abs(above(le, th)), le + 114 / (le + 10) - 7.407, th + 0.07 * th / (th - 12) + 0.1 * below(th, 2.7) * (2.7 - th));
per_frame_5=th = if(0.00001 < abs(above(th, 5.2)), 4, th);
per_frame_6=q1 = 0.12 * th;
per_frame_7=ccl = if(0.00001 < abs(pulse), ccl + 1, ccl);
per_frame_8=q2 = ccl;
per_frame_9=ob_r = ob_r + time * sin(bass);
per_frame_10=ob_b = ob_b + time * sin(treb + 1);
per_frame_11=ob_g = ob_g + time * sin(mid / 1.5);
per_frame_12=zoomexp = q1;
per_frame_13=myb = cos(time) + abs(cos(time));
per_frame_14=myg = abs(sin(time));
per_frame_15=myr = -1 * cos(time) + abs(-1 * cos(time)) + 0.2 * (cos(sin(time)) + (abs(cos(sin(time))) + cos(sin(time))));
per_frame_16=avg = 0.9 * avg + 0.1 * le;
per_frame_17=wave_r = if(0.00001 < abs(below(avg, 1.8)), myr, 0);
per_frame_18=wave_b = if(0.00001 < abs(below(avg, 1.8)), myb, 0);
per_frame_19=wave_g = if(0.00001 < abs(below(avg, 1.8)), myg, 0);
per_frame_20=monitor = avg;
per_pixel_1=grid = sign(pow(2 * sin(ang * q2 + x * y * q1), 1 + mod(q2, 4))) - 0.5;
per_pixel_2=snee = 0.5 * sin(q2 * q1);
per_pixel_3=rot = bnot(mod(grid, mod(q2, 10) + 2)) * above(x, 0.5 + snee) * above(y, 0.5 - snee);
per_pixel_4=sx = sx - sin((q2 + 0.5) * x) * band(rot, snee) * 0.003;
per_pixel_5=sy = sy - cos((q2 + 3.4) * y) * band(rot, snee) * 0.003;
per_pixel_6=zoom = 1 + 0.1 * sin(3 * (q1 - q2)) + 0.2 * cos(1.6 * sin(time) + 6.28 * rad * q1) * below(x, 0.5 + snee) * below(y, 0.5 - snee);
