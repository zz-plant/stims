per_frame_init_7=madtreb = 0;
per_frame_1=wave_r = sin(5 * ff / bass) / 2 + 0.5;
per_frame_2=wave_g = cos(ff / mid) / 2 + 0.5;
per_frame_3=wave_b = cos(3 * ff / treb) / 2 + 0.5;
per_frame_4=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_5=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_6=ib_r = ib_r + 0.2 * sin(0.5413 * time);
per_frame_7=ib_g = ib_g + 0.2 * sin(0.6459 * time);
per_frame_8=ib_b = ib_b + 0.2 * sin(0.4354 * time);
per_frame_9=ob_r = wave_r;
per_frame_10=ob_g = wave_g;
per_frame_11=ob_b = wave_b;
per_frame_12=mv_x = 30 * lastingbass + 24;
per_frame_13=mv_y = 48 * madtreb + 8;
per_frame_14=mv_r = 0.7 - bass_att;
per_frame_15=mv_b = 0.6 - treb_att;
per_frame_16=mv_g = 0.5 - mid_att;
per_frame_17=ff = frame / 100;
per_frame_18=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_19=zoom = max(0.98, min(0.15 + 1.1 * bass_att, 1.75));
per_pixel_1=zoom = zoom + if(0.00001 < abs(q2), 0, rad * sin(0.6969 * time) * 1.2969);
per_pixel_2=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_3=dx_r = 0.315 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_4=dy_r = 0.315 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_5=zoom = zoom - 0.4;
