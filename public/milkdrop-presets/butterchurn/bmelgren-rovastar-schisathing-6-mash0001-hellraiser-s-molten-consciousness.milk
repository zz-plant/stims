[preset00]
fRating=0.000000
fGammaAdj=1.980000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=7.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
bDarken=1.000000
fWaveAlpha=25.000000
fWaveScale=1.555000
fWaveSmoothing=0.000000
fShader=1.000000
fZoom=0.970590
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fWaveY=0.340000
nMotionVectorsX=64.000000
nMotionVectorsY=2.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=warp = 0;
per_frame_2=wave_r = 0.8 + sin(1.12 * time) / 5;
per_frame_3=wave_g = 0.7 + 0.3 * sin(1.23 * time);
per_frame_4=wave_b = 0.7 + sin(1.333 * time) / 3;
per_frame_5=rot = rot + 0.01 * (0.5 * sin(0.4 * time) + 0.4 * sin(0.6 * time));
per_frame_6=zoomexp = zoomexp + 50 * mid_att;
per_frame_7=mv_y = 2.25;
per_pixel_1=cx = tan(ang + 0.8 * mid_att) / 4 + 1;
per_pixel_2=cy = sin(ang + 0.8 * mid_att) / 4 + 1;
per_pixel_3=sy = 1 + sin(1 - rad) / 60;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (tmpvar_2.xyz + ((tmpvar_2.xyz - 
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  ) * 0.2));
  ret_1 = (ret_1 * 0.9);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
