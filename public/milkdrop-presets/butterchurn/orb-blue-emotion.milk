per_frame_init_1=basstime = 0;
per_frame_init_2=stickybit = 0;
per_frame_init_3=volavg2 = 0;
per_frame_init_4=prev_edge = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=decay_r = 0;
per_frame_init_8=sample1 = 0;
per_frame_init_9=difftime = 0;
per_frame_init_10=diff = 0;
per_frame_init_11=decay_b = 0;
per_frame_init_12=edge = 0;
per_frame_init_13=tex_saw = 0;
per_frame_init_14=zoomy = 0;
per_frame_init_15=saw_g = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=volavg = 0;
per_frame_init_18=bit2 = 0;
per_frame_init_19=saw_b = 0;
per_frame_init_20=state = 0;
per_frame_init_21=vol = 0;
per_frame_init_22=lock = 0;
per_frame_init_23=state_echo = 0;
per_frame_init_24=q2 = 0;
per_frame_init_25=q3 = 0;
per_frame_init_26=basssum = 0;
per_frame_init_27=decay_g = 0;
per_frame_init_28=flag = 0;
per_frame_init_29=saw_r = 0;
per_frame_init_30=sample2 = 0;
per_frame_init_31=zoom_in = 0;
per_frame_init_32=q8 = 0;
per_frame_init_33=zoomy = 1;
per_frame_1=basstime = basstime + 0.03 * bass;
per_frame_2=q1 = basstime;
per_frame_3=basstime = if(0.00001 < abs(below(basstime, 450)), 450, basstime);
per_frame_4=basstime = if(0.00001 < abs(above(basstime, 495)), 450, basstime);
per_frame_5=basstime = basstime + 0.03 * bass_att;
per_frame_6=vol = pow(bass + mid + treb, 2);
per_frame_7=basssum = vol;
per_frame_8=stickybit = mod(time, 2);
per_frame_9=volavg = volavg + vol * equal(stickybit, 1);
per_frame_10=sample1 = sample1 + equal(stickybit, 1);
per_frame_11=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_12=sample2 = sample2 + equal(stickybit, 0);
per_frame_13=edge = bnot(equal(bit2, stickybit));
per_frame_14=volavg = volavg - volavg * edge * stickybit;
per_frame_15=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_16=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_17=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_18=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_19=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_20=q3 = diff;
per_frame_21=bit2 = mod(time, 2);
per_frame_22=state = if(0.00001 < abs(above(state, 5)), 0, state);
per_frame_23=state = state + above(diff, 3);
per_frame_24=q4 = state;
per_frame_25=difftime = difftime + 0.03 * diff;
per_frame_26=q2 = difftime;
per_frame_27=difftime = if(0.00001 < abs(above(difftime, 2000)), 0, difftime);
per_frame_28=zoom_in = zoom_in + above(diff, 4);
per_frame_29=zoom_in = if(0.00001 < abs(above(zoom_in, 2)), 0, zoom_in);
per_frame_30=q5 = zoom_in;
per_frame_31=tex_saw = tex_saw - 0.002 * diff;
per_frame_32=flag = below(tex_saw, 0.1);
per_frame_33=tex_saw = if(0.00001 < abs(below(tex_saw, 0.1)), 0.6, tex_saw);
per_frame_34=state_echo = state_echo + flag;
per_frame_35=q8 = tex_saw;
per_frame_36=monitor = tex_saw;
per_frame_37=lock = if(0.00001 < abs(equal(lock, 0)), bnot(equal(flag, prev_edge)), 1);
per_frame_38=lock = if(0.00001 < abs(equal(state_echo, 0)), 0, lock);
per_frame_39=lock = if(0.00001 < abs(equal(state_echo, 1)), 0, lock);
per_frame_40=lock = if(0.00001 < abs(equal(state_echo, 2) * below(zoomy, 0.3505)), 0, lock);
per_frame_41=lock = if(0.00001 < abs(equal(state_echo, 3) * below(zoomy, 0.205)), 0, lock);
per_frame_42=zoomy = zoomy - 0.02 * zoomy * lock;
per_frame_43=zoomy = 1.05 * equal(state_echo, 4) + bnot(equal(state_echo, 4)) * zoomy;
per_frame_44=echo_zoom = zoomy;
per_frame_45=monitor = tex_saw;
per_frame_46=state_echo = if(0.00001 < abs(above(state_echo, 3)), 0, state_echo);
per_frame_47=prev_edge = flag;
per_pixel_1=zoom = 1 - 0.1 * equal(q5, 0) * q3 + 0.1 * equal(q5, 1) * q3;
per_pixel_2=saw_r = saw_r + 0.0001 * bass;
per_pixel_3=saw_r = if(0.00001 < abs(above(saw_r, 1)), 0, saw_r);
per_pixel_4=saw_g = saw_g + 0.00012 * bass;
per_pixel_5=saw_g = if(0.00001 < abs(above(saw_g, 1)), 0, saw_g);
per_pixel_6=saw_b = saw_b + 0.00011 * bass;
per_pixel_7=saw_b = if(0.00001 < abs(above(saw_b, 1)), 0, saw_b);
per_pixel_8=decay_r = 5 - x * y * saw_r;
per_pixel_9=decay_g = 5 - y * x * saw_g;
per_pixel_10=decay_b = 5 - x * y * saw_b;
per_pixel_11=rot = 0;
per_pixel_12=zoom = 1;
shape_0_init1=q1 = 0;
shape_0_init2=tex_capture = 0;
shape_0_init3=q8 = 0;
shape_0_init4=tex_saw = 0.4;
shape_0_per_frame1=ang = 0.2 * q1;
shape_0_per_frame2=tex_capture = 1;
shape_0_per_frame3=tex_zoom = q8;
shape_1_init1=q1 = 0;
shape_1_init2=tex_capture = 0;
shape_1_init3=q3 = 0;
shape_1_init4=tex_saw = 0.4;
shape_1_per_frame1=ang = 0.2 * q1;
shape_1_per_frame2=tex_capture = above(q3, 2);
shape_1_per_frame3=tex_zoom = 0.6;
shape_2_init1=q1 = 0;
shape_2_init2=tex_capture = 0;
shape_2_init3=q3 = 0;
shape_2_init4=tex_saw = 0.4;
shape_2_per_frame1=ang = 0.2 * q1;
shape_2_per_frame2=tex_capture = above(q3, 1);
shape_2_per_frame3=tex_zoom = 0.4;
shape_3_init1=q1 = 0;
shape_3_per_frame1=x = 0.5 + 0.4 * sin(0.45 * q1);
shape_3_per_frame2=y = 0.5 + 0.4 * sin(0.5 * q1);
shape_3_per_frame3=r2 = 0.5 + 0.5 * sin(0.458 * q1);
shape_3_per_frame4=g2 = 0.5 + 0.5 * sin(0.858 * q1);
shape_3_per_frame5=b2 = 0.5 + 0.5 * sin(0.658 * q1);
