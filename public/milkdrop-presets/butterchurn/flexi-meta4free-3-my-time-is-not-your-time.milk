shape_0_per_frame1=t1 = time - floor(time);
shape_0_per_frame2=sample = instance / num_inst;
shape_0_per_frame3=t_abs = 3 * sample;
shape_0_per_frame4=t_rel = sample - time / 5;
shape_0_per_frame5=vol = bass + mid + treb;
shape_0_per_frame6=ampl = 2 * t_abs / 2 * vol * 0.5;
shape_0_per_frame7=k1 = sin(time / 13);
shape_0_per_frame8=k2 = sin(time / 12);
shape_0_per_frame9=ox = ampl * sin(t_abs * (31 + 5 * k1)) + sin(time / 25) * (1 - t_abs) * 0.4;
shape_0_per_frame10=oy = ampl * cos(t_abs * (31 + 5 * k2));
shape_0_per_frame11=oz = -1;
shape_0_per_frame12=r = sqr(sin(3.4 * t_rel));
