shape_0_per_frame21=ox = mx;
shape_0_per_frame22=oy = my;
shape_0_per_frame23=mx = ox * cos(yang) + oz * sin(yang);
shape_0_per_frame24=mz = -ox * sin(yang) + oz * cos(yang);
shape_0_per_frame25=ox = mx;
shape_0_per_frame26=oz = mz;
shape_0_per_frame27=my = oy * cos(xang) - oz * sin(xang);
shape_0_per_frame28=mz = oy * sin(xang) + oz * cos(xang);
shape_0_per_frame29=oy = my;
shape_0_per_frame30=oz = mz;
shape_0_per_frame31=oz = oz - 6;
shape_0_per_frame32=x = ox * fov / oz + 0.5;
shape_0_per_frame33=y = oy * fov / oz + 0.5;
