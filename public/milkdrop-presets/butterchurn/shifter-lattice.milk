wave_2_per_point1=ra = if(0.00001 < abs(ra), ra, 0.1 + 0.0008 * randint(1001));
wave_2_per_point2=rb = if(0.00001 < abs(rb), rb, 0.1 + 0.0008 * randint(1001));
wave_2_per_point3=rc = if(0.00001 < abs(rc), rc, 0.1 + 0.0008 * randint(1001));
wave_2_per_point4=rd = if(0.00001 < abs(rd), rd, 0.1 + 0.0008 * randint(1001));
wave_2_per_point5=vol = 0.5 * (value1 + value2);
wave_2_per_point6=vol = 0;
wave_2_per_point7=it = it * above(sample, 0);
wave_2_per_point8=it = it + 1;
wave_2_per_point9=sp = 20 * sample;
wave_2_per_point10=ti = q1;
wave_2_per_point11=ox = 0.5 * sin(ti * t7 + sp * t1) + 0.5 * sin(ti * rb + sp * t4);
wave_2_per_point12=oy = 0.5 * sin(ti * t8 + sp * t2) + 0.5 * sin(ti * rc + sp * t5);
wave_2_per_point13=oz = 0.5 * sin(ti * ra + sp * t3) + 0.5 * sin(ti * rd + sp * t6);
wave_2_per_point14=ox = ox * q5;
wave_2_per_point15=oy = oy * q5;
wave_2_per_point16=oz = oz * q5;
wave_2_per_point17=xang = q2;
wave_2_per_point18=yang = q3;
wave_2_per_point19=zang = q4;
wave_2_per_point20=fov = 0.5;
wave_2_per_point21=mx = ox * cos(yang) + oz * sin(yang);
wave_2_per_point22=mz = -ox * sin(yang) + oz * cos(yang);
wave_2_per_point23=ox = mx;
wave_2_per_point24=oz = mz;
wave_2_per_point25=mx = ox * cos(zang) - oy * sin(zang);
wave_2_per_point26=my = ox * sin(zang) + oy * cos(zang);
wave_2_per_point27=ox = mx;
wave_2_per_point28=oy = my;
wave_2_per_point29=my = oy * cos(xang) - oz * sin(xang);
wave_2_per_point30=mz = oy * sin(xang) + oz * cos(xang);
wave_2_per_point31=oy = my;
wave_2_per_point32=oz = mz;
wave_2_per_point33=oz = 2 * (oz - 5 * floor(0.2 * oz) - 5);
wave_2_per_point34=x = ox * fov / oz + 0.5;
wave_2_per_point35=x = 0.75 * (x - 0.5) + 0.5;
wave_2_per_point36=y = oy * fov / oz + 0.5;
