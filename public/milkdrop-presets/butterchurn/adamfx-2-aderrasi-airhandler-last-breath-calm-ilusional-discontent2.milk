wave_0_init7=wa = 0;
wave_0_per_point1=branch = floor(randint(2));
wave_0_per_point2=wx = if(0.00001 < abs(equal(sc, 0)), 0.5, wx);
wave_0_per_point3=wy = if(0.00001 < abs(equal(sc, 0)), 0, wy);
wave_0_per_point4=wx = if(0.00001 < abs(equal(sc, 1)), 0.5, wx);
wave_0_per_point5=wy = if(0.00001 < abs(equal(sc, 1)), 0.1, wy);
wave_0_per_point6=d = if(0.00001 < abs(below(sc, 2)), 0.3, 0.7 * d);
wave_0_per_point7=wainc = if(0.00001 < abs(equal(branch, 1)), 0.2 + sin(time), -0.2);
wave_0_per_point8=wa = if(0.00001 < abs(below(sc, 2)), 1.57079635, wa + wainc);
wave_0_per_point9=wx = if(0.00001 < abs(above(sc, 2)), wx + cos(wa) * d, wx);
wave_0_per_point10=wy = if(0.00001 < abs(above(sc, 2)), wy + sin(wa) * d, wy);
wave_0_per_point11=sc = if(0.00001 < abs(equal(sc, 11)), 0, sc + 1);
wave_0_per_point12=a = if(0.00001 < abs(below(sc, 2)), 0, 0.1);
wave_0_per_point13=x = wx;
wave_0_per_point14=y = wy;
