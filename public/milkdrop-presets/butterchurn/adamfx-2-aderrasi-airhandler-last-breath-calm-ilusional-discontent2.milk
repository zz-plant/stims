shape_0_per_frame1=ang = 0.1 * time;
shape_0_per_frame2=sides = floor(abs(7 * sin(0.5 * time)));
shape_1_per_frame1=ang = 0.1 * time;
shape_1_per_frame2=r = 0.7 + 0.3 * sin(time);
shape_1_per_frame3=g = 0.7 + 0.3 * cos(time);
shape_1_per_frame4=b = 0.7 + 0.3 * sin(time + 0.12);
shape_1_per_frame5=rad = rad + treb_att * bass_att * 0.5;
shape_1_per_frame6=x = 0.5 + 0.5 * sin(time);
shape_2_per_frame1=ang = 0.25 * time;
shape_2_per_frame2=g = 0.7 + 0.3 * sin(time);
shape_2_per_frame3=b = 0.7 + 0.3 * cos(time);
shape_2_per_frame4=r = 0.7 + 0.3 * sin(time + 0.12);
shape_2_per_frame5=r2 = 0.7 + 0.3 * sin(time);
shape_2_per_frame6=g2 = 0.7 + 0.3 * cos(time);
shape_2_per_frame7=b2 = 0.7 + 0.3 * sin(time + 0.12);
shape_2_per_frame8=rad = rad + treb_att * bass_att * 0.5;
shape_2_per_frame9=y = 0.5 + 0.25 * sin(time);

[warp_shader]
shader_body { 
  vec3 tmpvar_1;
  tmpvar_1 = max (texture (sampler_fc_main, uv).xyz, (texture (sampler_fc_main, mix (uv, uv_orig, vec2(0.33, 0.33))).xyz * 0.95));
  vec2 x_2;
  x_2 = (uv - uv_orig);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (((
    mix (tmpvar_1, (floor((
      (tmpvar_1 * vec3(7.0, 6.0, 8.0))
     + 0.25)) / vec3(7.0, 6.0, 8.0)), vec3(0.1, 0.1, 0.1))
   * 0.99) - 0.0025) - ((1.0 - 
    clamp ((sqrt(dot (x_2, x_2)) * 40.0), 0.0, 1.0)
  ) * 0.003));
  ret = tmpvar_3.xyz;
 }
