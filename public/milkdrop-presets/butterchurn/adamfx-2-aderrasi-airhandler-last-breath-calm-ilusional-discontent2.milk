wave_1_per_point6=d = if(0.00001 < abs(below(sc, 2)), 0.3, 0.7 * d);
wave_1_per_point7=wainc = if(0.00001 < abs(equal(branch, 1)), 0.2 + sin(time), -0.2);
wave_1_per_point8=wa = if(0.00001 < abs(below(sc, 2)), 4.71238905, wa + wainc);
