[preset00]
fRating=5.000000
fDecay=0.983000
fVideoEchoZoom=1.006596
nVideoEchoOrientation=3.000000
nWaveMode=3.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
fWaveScale=2.047093
fZoomExponent=3.394161
fZoom=1.008148
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderA=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=timer_base = 0;
per_frame_init_2=sx_temp = 0;
per_frame_init_3=grid = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=sy_temp = 0;
per_frame_init_6=centerx = 0;
per_frame_init_7=wave_size = 0;
per_frame_init_8=crad = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=q3 = 0;
per_frame_init_11=centery = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + if(0.00001 < abs(above(bass_att, 1.4)), 1, 0.49 * sin(2 * time));
per_frame_3=wave_g = wave_g + if(0.00001 < abs(above(bass_att, 1.4)), 0, if(0.00001 < abs(above(treb_att, 1.4)), 1, 0.49 * sin(3 * time)));
per_frame_4=wave_b = wave_b + if(0.00001 < abs(above(treb_att, 1.4)), 0, 0.49 * sin(time));
per_frame_5=timer_base = 0.5;
per_frame_6=q1 = sin(time * timer_base * 4);
per_frame_7=q2 = sin(time * timer_base * 2);
per_frame_8=q3 = sin(time * timer_base);
per_frame_9=rot = if(0.00001 < abs(above(q1, 0)), if(0.00001 < abs(above(q2, 0)), 0.1, -0.1), 0);
per_frame_10=zoom = zoom + 0.05 * q2 + 0.05 * q1;
per_frame_11=wave_mystery = wave_mystery + 0.7 * q1 + 0.3 * q2;
per_frame_12=wave_size = wave_size + 0.5 * q3;
per_frame_13=cx = cx + 0.2 * q1;
per_frame_14=cy = cy + 0.2 * q3;
per_pixel_1=centerx = 0.5;
per_pixel_2=centery = 0.5;
per_pixel_3=crad = abs(rad - 0.5) * q2;
per_pixel_4=grid = mod(abs(10 * x - 5), 2) + mod(abs(10 * y - 5), 2);
per_pixel_5=sx_temp = if(0.00001 < abs(equal(grid, 0)), if(0.00001 < abs(above(x, centerx)), sx - crad - centerx, sx + crad - centerx), sx);
per_pixel_6=sy_temp = if(0.00001 < abs(equal(grid, 0)), if(0.00001 < abs(above(y, centery)), sy - crad - centery, sy + crad - centery), sy);
per_pixel_7=sx = if(0.00001 < abs(below(q1, 0)), sx - sx_temp * q2 * 0.1, sx);
per_pixel_8=sy = if(0.00001 < abs(below(q1, 0)), sy - sx_temp * q2 * 0.1, sy);
