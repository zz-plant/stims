per_frame_init_1=angval = 0;
per_frame_init_2=ff = 0;
per_frame_1=ff = frame / 100;
per_frame_2=wave_r = sin(5 * ff / 2) / 2 + 0.5;
per_frame_3=wave_g = cos(ff / 3) / 2 + 0.5;
per_frame_4=wave_b = cos(3 * ff / 2) / 2 + 0.5;
per_frame_5=zoom = zoom - if(0.00001 < abs(below(zoom, 0.96)), 0, 0.008);
per_frame_6=zoom = zoom + 0.15 * bass_att;
per_pixel_1=angval = ang + abs(3.14 * sin(0.345 * time) + 3.14 * sin(0.234 * time));
per_pixel_2=rot = (2 * abs(sin(time) - 0.5) - angval) / 1;
wave_1_init1=y3 = 0;
wave_1_init2=z2 = 0;
wave_1_init3=y1 = 0;
wave_1_init4=t5 = 0;
wave_1_init5=t1 = 0;
wave_1_init6=x1 = 0;
wave_1_init7=z4 = 0;
wave_1_init8=nsample = 0;
wave_1_init9=t8 = 0;
wave_1_init10=z3 = 0;
wave_1_init11=t3 = 0;
wave_1_init12=rotz = 0;
wave_1_init13=x3 = 0;
wave_1_init14=x4 = 0;
wave_1_init15=tvar = 0;
wave_1_init16=x2 = 0;
wave_1_init17=t2 = 0;
wave_1_init18=y2 = 0;
wave_1_init19=svar = 0;
wave_1_init20=fvar = 0;
wave_1_init21=z1 = 0;
wave_1_init22=roty = 0;
wave_1_init23=t4 = 0;
wave_1_init24=y4 = 0;
wave_1_init25=rotx = 0;
wave_1_init26=t8 = 3.14159265;
wave_1_init27=t5 = 1;
wave_1_per_frame1=rotx = rotx + bass;
wave_1_per_frame2=roty = roty + mid;
wave_1_per_frame3=rotz = rotz + treb;
wave_1_per_frame4=t1 = t8 * rotx / 180;
wave_1_per_frame5=t2 = t8 * roty / 180;
wave_1_per_frame6=t3 = t8 * rotz / 180;
wave_1_per_frame7=t4 = 3 * sin(time + 0.66 * t8);
wave_1_per_frame8=t5 = 10 + 8 * cos(time + 0.66 * t8);
wave_1_per_point1=fvar = 512 * sample;
wave_1_per_point2=svar = 128 * fvar;
wave_1_per_point3=tvar = band(0, svar);
wave_1_per_point4=nsample = 4.5 * tvar;
wave_1_per_point5=x1 = -0.75 + 1.5 * sin(sample);
wave_1_per_point6=y1 = cos(t8 * nsample);
wave_1_per_point7=z1 = sin(t8 * nsample);
wave_1_per_point8=y2 = y1 * cos(t1) - z1 * sin(t1);
wave_1_per_point9=z2 = y1 * sin(t1) + z1 * cos(t1);
wave_1_per_point10=x2 = z2 * sin(t2) + x1 * cos(t2);
wave_1_per_point11=z3 = z2 * cos(t2) - x1 * sin(t2);
wave_1_per_point12=x3 = x2 * cos(t3) - y2 * sin(t3);
wave_1_per_point13=y3 = y2 * cos(t3) + x2 * sin(t3);
wave_1_per_point14=x4 = x3;
wave_1_per_point15=y4 = y3;
wave_1_per_point16=z4 = z3 + 5;
wave_1_per_point17=x = 0.5 + 0.5 * (x4 / (1 + 0.5 * z4));
wave_1_per_point18=y = 0.5 + 0.5 * (y4 / (1 + 0.5 * z4));
wave_1_per_point19=a = -0.9 + sin(nsample + time);
wave_1_per_point20=a = if(0.00001 < abs(below(a, 0)), 0, a);
