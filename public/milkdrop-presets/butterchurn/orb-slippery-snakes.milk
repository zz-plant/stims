per_frame_1=basstime = basstime + 0.03 * bass_att;
per_frame_2=vol = pow(bass + mid + treb, 2);
per_frame_3=basssum = vol;
per_frame_4=stickybit = mod(time, 2);
per_frame_5=volavg = volavg + vol * equal(stickybit, 1);
per_frame_6=sample1 = sample1 + equal(stickybit, 1);
per_frame_7=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_8=sample2 = sample2 + equal(stickybit, 0);
per_frame_9=edge = bnot(equal(bit2, stickybit));
per_frame_10=volavg = volavg - volavg * edge * stickybit;
per_frame_11=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_12=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_13=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_14=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_15=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_16=diff = diff;
per_frame_17=bit2 = mod(time, 2);
per_frame_18=q1 = diff;
per_frame_19=difftime = difftime + 0.03 * diff;
per_frame_20=q2 = difftime;
per_frame_21=difftime = if(0.00001 < abs(above(difftime, 2000)), 0, difftime);
per_frame_22=monitor = q2;
per_frame_23=gx = if(0.00001 < abs(below(gx, 1)), 1, gx);
per_frame_24=gy = if(0.00001 < abs(below(gy, 1)), 1, gy);
per_frame_25=gx = if(0.00001 < abs(above(gx, 1300)), 1, gx);
per_frame_26=gy = if(0.00001 < abs(above(gy, 1200)), 1, gy);
per_frame_27=speed = 0.05 * (0.1 * diff + bass + 0.5);
per_frame_28=gx = gx + 1.2 * sin(difftime) * speed;
per_frame_29=gy = gy + sin(diff) * speed;
per_frame_30=q5 = 0.5 + 0.5 * sin(gx);
per_frame_31=q6 = 0.5 + 0.5 * sin(gy);
per_pixel_1=zoom = 1 - 0.1 * q1;
per_pixel_2=rot = (rad - q1) * q1 * 0.1;
per_pixel_3=sx = 1 + 0.1 * q5 * q1;
per_pixel_4=sy = 1 + 0.1 * q5 * q1;
