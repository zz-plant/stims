[preset00]
fRating=0.000000
fGammaAdj=1.000000
nWaveMode=2.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.125000
fWaveScale=1.013000
fWaveSmoothing=0.900000
fModWaveAlphaStart=1.250000
fModWaveAlphaEnd=1.650000
fZoom=1.135000
fWarp=0.016050
fWaveR=0.000000
fWaveG=0.600000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_g = wave_g + 0.1 * (0.9 * sin(0.583 * time) + 0.1 * sin(1.006 * time));
per_frame_2=wave_b = wave_b + 0.1 * (0.9 * sin(0.993 * time) + 0.1 * sin(0.933 * time));
per_frame_3=zoom = zoom + 0.013 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_4=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.003 * (0.6 * sin(0.471 * time) + 0.4 * sin(0.297 * time));
per_frame_6=cy = cy + 0.003 * (0.6 * sin(0.379 * time) + 0.4 * sin(0.351 * time));
per_frame_7=dx = dx + 0.003 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_8=rot = rot + 0.02 * (sin(2.134 * time) + sin(1.7134 * time) + sin(2.834 * time));
per_frame_9=dx = dx + 0.01 * (sin(1.134 * time) + sin(0.7134 * time) + sin(2.334 * time));
per_frame_10=dy = dy + 0.01 * (sin(1.8834 * time) + sin(1.0144 * time) + sin(1.334 * time));

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_noise_lq, ((uv_orig * texsize.xy) * texsize_noise_lq.zw)).xyz * 2.0)
   - 1.0) * 0.0017));
  ret_1 = (ret_1 * 0.993);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2.z = 0.0;
  tmpvar_2.xy = texsize.zw;
  ret_1 = -(texture (sampler_main, uv).xyz);
  ret_1 = (ret_1 + (clamp (
    ((dot (texture (sampler_main, (uv + tmpvar_2.xz)).xyz, vec3(0.32, 0.49, 0.29)) - dot (texture (sampler_main, (uv - tmpvar_2.xz)).xyz, vec3(0.32, 0.49, 0.29))) * 64.0)
  , 0.0, 1.0) * vec3(1.0, 0.6, 0.1)));
  ret_1 = (ret_1 + (clamp (
    ((dot (texture (sampler_main, (uv + tmpvar_2.zy)).xyz, vec3(0.32, 0.49, 0.29)) - dot (texture (sampler_main, (uv - tmpvar_2.zy)).xyz, vec3(0.32, 0.49, 0.29))) * 64.0)
  , 0.0, 1.0) * vec3(0.2, 0.5, 0.7)));
  ret_1 = (ret_1 - clamp ((
    (((texture (sampler_blur1, uv).xyz * scale1) + bias1) * 4.0)
   - 1.0), 0.0, 1.0));
  ret_1 = (ret_1 * 1.5);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
