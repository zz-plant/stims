per_frame_15=b = 0;
per_frame_16=while(b < reg01, sum = sum + gmegabuf(floor(ind + 30000)) / reg01; amp = amp + pow(gmegabuf(floor(ind + 30000)), 2); ind = ind + 1; b = b + 1;);
per_frame_17=ind = 0;
per_frame_18=amp_ = amp_ * dec_med + 600 * ((1 - dec_med) * sqrt(amp) / reg01);
per_frame_19=b = 0;
per_frame_20=while(b < reg01, megabuf(floor(ind + 30000)) = (gmegabuf(floor(ind + 30000)) - sum) / amp_; ind = ind + 1; b = b + 1;);
per_frame_21=index2 = 0;
per_frame_22=b = index2;
per_frame_23=while(b < flen, index = 0; real = 0; imag = 0; c = imag; while(c < flen, real = real + cos(6.28 * (index / flen) * index2) * megabuf(floor(index * reg01 / 8 + 30002)); imag = imag + sin(6.28 * (index / flen) * index2) * megabuf(floor(index * reg01 / 8 + 30002)); index = index + 1; c = c + 1;); megabuf(floor(10000 + index2)) = megabuf(floor(10000 + index2)) * dec_f + real; megabuf(floor(15000 + index2)) = megabuf(floor(15000 + index2)) * dec_f + imag; index2 = index2 + 1; b = b + 1;);
per_frame_24=ind = 1;
per_frame_25=b = 0;
per_frame_26=while(b < flen / 2, cx = megabuf(floor(10000 + ind)); cy = megabuf(floor(15000 + ind)); yind = -1; c = 0; while(3 > c, xind = -1; d = 0; while(3 > d, ox = mod((cx + 0.5) * xlen + xind, xlen); oy = mod((cy + 0.5) * ylen + yind, ylen); amp = cx * cx + cy * cy; megabuf(floor(oy * ylen + ox)) = megabuf(floor(oy * ylen + ox)) - 60 / fps * sqrt(amp) * above(amp, 0.02) / (1 + xind * xind + yind * yind); xind = xind + 1; d = d + 1;); yind = yind + 1; c = c + 1;); ind = ind + 1; b = b + 1;);
per_frame_27=yind = 0;
per_frame_28=b = yind;
per_frame_29=while(b < ylen, xind = 0; c = xind; while(c < xlen, megabuf(floor(yind * ylen + xind + 5000)) = dec_med * ((gmegabuf(floor(yind * ylen + mod(xind + 1, xlen))) + gmegabuf(floor(yind * ylen + mod(xlen + xind - 1, xlen))) + gmegabuf(floor(mod(yind + 1, ylen) * ylen + xind)) + gmegabuf(floor(mod(yind + ylen - 1, ylen) * ylen + xind)) + gmegabuf(floor(yind * ylen + xind)) * smooth * 4) / (2 + 2 * smooth) - megabuf(floor(yind * ylen + xind))); xind = xind + 1; c = c + 1;); yind = yind + 1; b = b + 1;);
