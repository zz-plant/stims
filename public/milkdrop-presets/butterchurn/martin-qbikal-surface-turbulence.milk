wave_0_init5=q30 = 0;
wave_0_per_point1=n = floor((reg00 + 0.5) * sample);
wave_0_per_point2=m = 30001 + n / (reg00 / reg01);
wave_0_per_point3=gmegabuf(floor(m)) = gmegabuf(floor(m)) * q30 + (1 - q30) / 2 * (value1 + value2);
