per_frame_34=q2 = sin(xang);
per_frame_35=q3 = cos(yang);
per_frame_36=q4 = sin(yang);
per_frame_37=q5 = cos(zang);
per_frame_38=q6 = sin(zang);
per_frame_39=fov = 0.8;
per_frame_40=yind = 0;
per_frame_41=b = yind;
per_frame_42=while(b < ylen, xind = 0; c = xind; while(c < xlen, ind = yind * ylen + xind; megabuf(floor(ind)) = gmegabuf(floor(ind)); gmegabuf(floor(ind)) = megabuf(floor(ind + 5000)); oz = yind - ylen / 2 + 0 * sin(2 * time); ox = if(0.00001 < abs(bnot(mod(yind, 2))), xind, xlen - xind - 1); oy = gmegabuf(floor(yind * ylen + ox)); oy0 = oy; ox = ox - xlen / 2; mx = ox * q5 - oy * q6; my = ox * q6 + oy * q5; ox = mx; oy = my; mx = ox * q3 + oz * q4; mz = -ox * q4 + oz * q3; ox = mx; oz = mz; my = oy * q1 - oz * q2; mz = oy * q2 + oz * q1; oy = my; oz = mz; gmegabuf(floor(10000 + ind)) = fov * ox / (oz + 60 * fov) + 0.5; gmegabuf(floor(15000 + ind)) = fov * oy / (oz + 60 * fov) + 0.6; gmegabuf(floor(20000 + ind)) = max(min(0.5 + oy0 / 4, 1), 0); gmegabuf(floor(25000 + ind)) = oy0 / 16 + 0.5; xind = xind + 1; c = c + 1;); yind = yind + 1; b = b + 1;);
