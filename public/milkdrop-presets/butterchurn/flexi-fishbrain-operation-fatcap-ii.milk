per_frame_13=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_14=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_15=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
