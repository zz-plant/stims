per_frame_1=wave_r = wave_r + 0.35 * sin(1.14 * time) + 0.16 * sin(1.5 * time);
per_frame_2=wave_g = wave_g + 0.36 * sin(1.27 * time) + 0.15 * sin(1.11 * time);
per_frame_3=wave_b = wave_b + 0.37 * sin(1.284 * time) + 0.15 * sin(1.3 * time);
per_frame_4=warp = 0;
per_frame_5=ob_r = wave_g;
per_frame_6=ob_b = wave_r;
per_frame_7=ob_g = wave_b;
per_frame_8=ib_r = wave_r;
per_frame_9=ib_b = wave_g;
per_frame_10=ib_g = wave_r;
per_frame_11=scale = 4;
per_frame_12=angle = 0.2 * time;
per_frame_13=translation_x = 0;
per_frame_14=translation_y = 0.2;
per_frame_15=iscale = 6;
per_frame_16=iangle = 0.3 * sin(0.1337 * time);
per_frame_17=itranslation_u = 0;
per_frame_18=itranslation_v = 0.2;
per_frame_19=a_r = cos(angle) * scale;
per_frame_20=a_i = sin(angle) * scale;
per_frame_21=b_r = translation_x;
per_frame_22=b_i = translation_y;
per_frame_23=c_r = -cos(iangle) * iscale;
per_frame_24=c_i = -sin(iangle) * iscale;
per_frame_25=d_r = itranslation_u;
per_frame_26=d_i = itranslation_v;
per_frame_27=c_inv_r = c_r / (c_r * c_r + c_i * c_i);
per_frame_28=c_inv_i = c_i / (c_r * c_r + c_i * c_i);
per_frame_29=ac_r = a_r * c_inv_r - a_i * c_inv_i;
per_frame_30=ac_i = a_r * c_inv_i - a_i * c_inv_r;
per_frame_31=bcad_r = b_r * c_r - b_i * c_i - (a_r * d_r - a_i * d_i);
per_frame_32=bcad_i = b_r * c_i - b_i * c_r - (a_r * d_i - a_i * d_r);
per_frame_33=mu_r = bcad_r * c_inv_r - bcad_i * c_inv_i;
per_frame_34=mu_i = bcad_r * c_inv_i - bcad_i * c_inv_r;
per_frame_35=q1 = ac_r;
per_frame_36=q2 = ac_i;
per_frame_37=q3 = mu_r;
per_frame_38=q4 = mu_i;
per_frame_39=q5 = c_r;
per_frame_40=q6 = c_i;
per_frame_41=q7 = d_r;
per_frame_42=q8 = d_i;
per_pixel_1=dy = dy + if(0.00001 < abs(below(abs(q1 - x), 0.01)), if(0.00001 < abs(below(y, q2)), max(0.02 - abs(q1 - x), 0), 0.001), 0.001);
per_pixel_2=cx = 8.13988973 * sqr(warp - x);
per_pixel_3=cx = if(0.00001 < abs(below(cx, -1)), -1, cx);
per_pixel_4=cx = if(0.00001 < abs(above(cx, 2)), 2, cx);
per_pixel_5=dy = if(0.00001 < abs(below(dy, -1)), -1, dy);
per_pixel_6=dy = if(0.00001 < abs(above(dy, 1)), 1, dy);
per_pixel_7=num = 8;
per_pixel_8=pi = 3.141592654;
per_pixel_9=radi = 0.75 * (y - 0.5);
per_pixel_10=radi = y - 0.5;
per_pixel_11=radi = pow(radi * radi + (x - 0.5) * (x - 0.5), 0.5);
per_pixel_12=an = ang + pi + time;
per_pixel_13=an = an - 2 * pi * floor(an / (2 * pi));
per_pixel_14=mod = 0.1;
per_pixel_15=seg = ang + pi;
per_pixel_16=seg = seg / (2 * pi) * num;
per_pixel_17=seg = floor(seg);
per_pixel_18=seg = seg - equal(seg, num);
per_pixel_19=anga = ang + pi - 2 * pi / num * seg;
per_pixel_20=anga = if(0.00001 < abs(equal(mod(seg, 2), 0)), 2 * pi / num - anga, anga);
per_pixel_21=anga = anga + pi / 4;
per_pixel_22=ox = 0.5 - radi * sin(anga);
per_pixel_23=oy = 0.5 + radi * cos(anga);
per_pixel_24=dx = equal(seg, 3) * (x - ox);
per_pixel_25=dy = equal(seg, 3) * (y - oy);
per_pixel_26=dx = above(seg, 0) * (x - ox);
per_pixel_27=dy = above(seg, 0) * (y - oy);
per_pixel_28=dx = dx + 0.003 * sin(64 * (2 * y - 1)) + 0.001 * sin(96 * (2 * y - 1));
per_pixel_29=dy = dy + 0.004 * cos(64 * (2 * x - 1)) + 0.002 * cos(96 * (2 * x - 1));

[comp_shader]
shader_body { 
  vec2 moebius_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3.x = q1;
  tmpvar_3.y = q2;
  vec2 tmpvar_4;
  tmpvar_4.x = q7;
  tmpvar_4.y = q8;
  vec2 tmpvar_5;
  tmpvar_5 = ((uv - 0.5) * aspect.xy);
  vec2 tmpvar_6;
  tmpvar_6.x = ((tmpvar_5.x * q5) - (tmpvar_5.y * q6));
  tmpvar_6.y = ((tmpvar_5.x * q6) - (tmpvar_5.y * q5));
  vec2 tmpvar_7;
  tmpvar_7 = (tmpvar_6 + tmpvar_4);
  vec2 tmpvar_8;
  tmpvar_8.x = ((q3 * tmpvar_7.x) + (q4 * tmpvar_7.y));
  tmpvar_8.y = ((q4 * tmpvar_7.x) - (q3 * tmpvar_7.y));
  moebius_1 = (0.5 + ((
    (1.0 - abs(((
      fract((((tmpvar_8 / 
        ((tmpvar_7.x * tmpvar_7.x) + (tmpvar_7.y * tmpvar_7.y))
      ) + tmpvar_3) * 0.5))
     * 2.0) - 1.0)))
   - 0.5) * 0.99));
  ret_2 = (texture (sampler_main, moebius_1).xyz * 4.0);
  ret_2 = (ret_2 - ((
    (texture (sampler_blur1, moebius_1).xyz * scale1)
   + bias1) * 3.0));
  ret_2 = (ret_2 * (1.0 + (0.12 * 
    ((texture (sampler_noise_lq, (rand_frame.xy + (
      (moebius_1 * texsize.xy)
     * texsize_noise_lq.zw))).xxx * 2.0) - 1.0)
  )));
  ret_2 = ((pow (ret_2, vec3(0.5, 0.5, 0.7)) - 0.1) * 1.1);
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = ret_2;
  ret = tmpvar_9.xyz;
 }
