per_frame_11=dy = 0.01 * cos(0.069 * musictime);
per_frame_12=monitor = rot;
per_pixel_1=rd = sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5)));
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=zm = -5.5 * log(sqrt(2) - rd) - 0.24;
per_pixel_5=zm = max(abs(zm), 0.99) * sign(zm);
per_pixel_6=nx = 2 * (x - 0.5 - q4);
per_pixel_7=ny = 1.5 * (y - 0.5 + q5);
per_pixel_8=rd = sqrt(sqr(nx) + sqr(ny));
per_pixel_9=ag = atan(ny / nx);
