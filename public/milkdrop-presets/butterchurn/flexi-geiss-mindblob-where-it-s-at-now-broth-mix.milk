per_frame_init_47=x1 = 0.9;
per_frame_init_48=y1 = 0.5;
per_frame_init_49=x2 = 0.5;
per_frame_init_50=y2 = 0.5;
per_frame_init_51=x3 = 0.5;
per_frame_init_52=y3 = 0.5;
per_frame_init_53=x4 = 0.5;
per_frame_init_54=y4 = 0.5;
per_frame_1=decay = 1;
per_frame_2=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_3=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_4=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_5=x1 = 0.5 + xx1 - xx2;
per_frame_6=y1 = 0.5 + yy1;
per_frame_7=spring = 18;
per_frame_8=grav = 1;
per_frame_9=resist = 0.2;
per_frame_10=bounce = 0.9;
per_frame_11=dt = 0.0003;
per_frame_12=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_13=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_14=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_15=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_16=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_17=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_18=x2 = x2 + vx2;
per_frame_19=y2 = y2 + vy2;
per_frame_20=x3 = x3 + vx3;
per_frame_21=y3 = y3 + vy3;
per_frame_22=x4 = x4 + vx4;
per_frame_23=y4 = y4 + vy4;
per_frame_24=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_25=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_26=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_27=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_28=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_29=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_30=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_31=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_32=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_33=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_34=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_35=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_36=q1 = x1;
per_frame_37=q2 = x2;
per_frame_38=q3 = x3;
per_frame_39=q4 = x4;
per_frame_40=q5 = y1;
per_frame_41=q6 = y2;
per_frame_42=q7 = y3;
per_frame_43=q8 = y4;
per_frame_44=zoom = 1;
per_frame_45=bb = 0.99 * bb + 0.02 * bass;
per_frame_46=mm = 0.99 * mm + 0.02 * mid;
per_frame_47=tt = 0.99 * tt + 0.02 * treb;
per_frame_48=q6 = atan2(vx4, vy4);
per_frame_49=q5 = sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_50=rot = 0.01 + 0.007 * cos(0.417 * time);
per_frame_51=q9 = 2.5 * cos(1.31 * time);
per_frame_52=q10 = sin(2.81 * time + 2);
per_pixel_1=dir = -q6 + asin(1);
per_pixel_2=b1 = 0.08;
per_pixel_3=m1 = 45 * q5;
per_pixel_4=t1 = 0.5;
per_pixel_5=xx = 0.5 + (q4 - 0.5) / aspectx;
per_pixel_6=yy = 1 - (0.5 + (q8 - 0.5) / aspecty);
per_pixel_7=x1 = xx + cos(dir + 1.5708) * b1;
per_pixel_8=y1 = yy - sin(dir + 1.5708) * b1;
per_pixel_9=x2 = xx - cos(dir + 1.5708) * b1;
per_pixel_10=y2 = yy + sin(dir + 1.5708) * b1;
per_pixel_11=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * b1;
per_pixel_12=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_13=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * b1;
per_pixel_14=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_15=si3 = 0 * -pow(q5, 3);
per_pixel_16=dx = 2 * (si1 * sin(y1 - y) * m1 * d1 - si2 * sin(y2 - y) * m1 * d2 + si3 * cos(dir) * t1) / aspectx;
per_pixel_17=dy = 2 * (-si1 * sin(x1 - x) * m1 * d1 + si2 * sin(x2 - x) * m1 * d2 - si3 * sin(dir) * t1) / aspecty;

[warp_shader]
uniform sampler2D sampler_cells;
 shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)
  ).xyz - 0.5) / 256.0));
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_cells, (uv_orig * aspect.xy));
  vec2 x_3;
  x_3 = (uv - uv_orig);
  ret_1 = (mix (ret_1, tmpvar_2.xyz, vec3((
    clamp ((1.0 - (abs(
      (((dot (tmpvar_2.xyz, vec3(0.32, 0.49, 0.29)) * 0.8) + 0.1) - (0.5 + (roam_cos.y * 0.25)))
    ) * 43.0)), 0.0, 1.0)
   * 0.07))) * (0.97 + (0.03 * 
    clamp ((sqrt(dot (x_3, x_3)) * 200.0), 0.0, 1.0)
  )));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 N_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (vec2(1.0, 0.0) * texsize.zw);
  N_1.x = ((texture (sampler_main, (uv_orig + tmpvar_3)).xyz - texture (sampler_main, (uv_orig - tmpvar_3)).xyz).x * 0.5);
  vec2 tmpvar_4;
  tmpvar_4 = (vec2(0.0, 1.0) * texsize.zw);
  N_1.y = ((texture (sampler_main, (uv_orig + tmpvar_4)).xyz - texture (sampler_main, (uv_orig - tmpvar_4)).xyz).x * 0.5);
  N_1.x = (N_1.x + ((
    ((texture (sampler_blur1, (uv_orig + tmpvar_3)).xyz * scale1) + bias1)
   - 
    ((texture (sampler_blur1, (uv_orig - tmpvar_3)).xyz * scale1) + bias1)
  ).x * 0.5));
  N_1.y = (N_1.y + ((
    ((texture (sampler_blur1, (uv_orig + tmpvar_4)).xyz * scale1) + bias1)
   - 
    ((texture (sampler_blur1, (uv_orig - tmpvar_4)).xyz * scale1) + bias1)
  ).x * 0.5));
  N_1.z = -0.077;
  vec3 tmpvar_5;
  tmpvar_5 = normalize(N_1);
  N_1 = tmpvar_5;
  vec3 tmpvar_6;
  tmpvar_6.z = -0.8;
  tmpvar_6.x = q9;
  tmpvar_6.y = q10;
  vec3 tmpvar_7;
  tmpvar_7.z = 0.0;
  tmpvar_7.xy = ((uv_orig * 2.0) - 1.0);
  vec3 tmpvar_8;
  tmpvar_8 = normalize((tmpvar_6 - tmpvar_7));
  vec3 tmpvar_9;
  tmpvar_9 = normalize((tmpvar_7 - vec3(0.0, 0.0, 1.0)));
  ret_2 = (vec3(clamp (dot (tmpvar_5, tmpvar_8), 0.0, 1.0)) * vec3(1.2, 0.9, 0.7));
  ret_2 = (ret_2 + (pow (
    clamp (dot (normalize((tmpvar_9 + 
      ((2.0 * tmpvar_5) * dot (tmpvar_9, tmpvar_5))
    )), tmpvar_8), 0.0, 1.0)
  , 32.0) * 0.5));
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = ret_2;
  ret = tmpvar_10.xyz;
 }
