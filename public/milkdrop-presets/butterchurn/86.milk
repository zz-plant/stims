per_frame_1=dec_med = pow(0.7, 30 / fps);
per_frame_2=dec_slow = pow(0.96, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.2 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 8);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=index3 = mod(index3 + is_beat * bnot(index) * bnot(index2), 3);
per_frame_11=q20 = avg;
per_frame_12=q21 = beat;
per_frame_13=q22 = peak;
per_frame_14=q23 = index;
per_frame_15=q24 = is_beat;
per_frame_16=q26 = bass_att + mid_att + treb_att;
per_frame_17=q27 = index + 1;
per_frame_18=q28 = index2;
per_frame_19=k1 = is_beat * equal(mod(index, 2), 0);
per_frame_20=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_21=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_22=rott = 3.1416 * p2 / 2;
per_frame_23=q1 = cos(rott);
per_frame_24=q2 = sin(rott);
per_frame_25=q3 = -q2;
per_frame_26=q4 = q1;
per_frame_27=vol = vol * dec_slow + q26 * (1 - dec_slow) + q24 * q1;
per_frame_28=q10 = q27 * q28;
per_frame_29=movex = movex + 0.03 * 30 / fps;
per_frame_30=q29 = movex;
per_frame_31=movez = movez + 2.1 / fps;
per_frame_32=q30 = movez;
per_frame_33=crawl = crawl + 0.03 * (2 + q22) / fps;
per_frame_34=q31 = crawl;
per_frame_35=q32 = 2 + sin(time / 7);
per_frame_36=monitor = index2;
per_frame_37=zoom = 1 + 0.01 * q1;
per_frame_38=dy = 0.005;
per_frame_39=dx = 0;
per_frame_40=warp = 0;
per_frame_41=rot = 0;
