[preset00]
fRating=0.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=5.000000
bAdditiveWaves=1.000000
bWaveDots=1.000000
fWaveAlpha=3.300000
fWaveScale=1.694000
fWaveSmoothing=0.900000
fWarpScale=3.138000
fZoom=1.053000
fWarp=0.179630
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.800000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=decay_rate = 0;
per_frame_init_2=bass_thresh = 0;
per_frame_init_3=prev_beat = 0;
per_frame_init_4=is_beat = 0;
per_frame_init_5=dx_residual = 0;
per_frame_init_6=min_att = 0;
per_frame_init_7=beat = 0;
per_frame_init_8=decay_to = 0;
per_frame_init_9=beat_level = 0;
per_frame_init_10=dy_residual = 0;
per_frame_init_11=dx_residual = 0;
per_frame_init_12=dy_residual = 0;
per_frame_1=wave_r = wave_r + 0.65 * (0.6 * sin(1.437 * time) + 0.4 * sin(0.97 * time));
per_frame_2=wave_g = wave_g + 0.65 * (0.6 * sin(1.344 * time) + 0.4 * sin(0.841 * time));
per_frame_3=wave_b = wave_b + 0.65 * (0.6 * sin(1.251 * time) + 0.4 * sin(1.055 * time));
per_frame_4=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.21 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.21 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=dx = dx + 0.01 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_8=dy = dy + 0.01 * (0.6 * sin(0.284 * time) + 0.4 * sin(0.247 * time));
per_frame_9=decay = decay - 0.01 * equal(mod(frame, 6), 0);
per_frame_10=dx = dx + 0.01 * dx_residual;
per_frame_11=dy = dy + 0.01 * dy_residual;
per_frame_12=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_13=decay_rate = pow(0.993, fps);
per_frame_14=min_att = 2.5;
per_frame_15=decay_to = 1;
per_frame_16=beat = bass / max(min_att, bass_att);
per_frame_17=beat = max(beat, mid / max(min_att, mid_att));
per_frame_18=beat = max(beat, treb / max(min_att, treb_att));
per_frame_19=beat = max(beat, (prev_beat - decay_to) * decay_rate + decay_to);
per_frame_20=beat_level = 24 * (beat - prev_beat - 0.1);
per_frame_21=is_beat = above(beat_level, 0.5);
per_frame_22=prev_beat = beat;
per_frame_23=dx_residual = dx_residual * (1 - is_beat) + is_beat * (0.02 * randint(100) - 1);
per_frame_24=dy_residual = dy_residual * (1 - is_beat) + is_beat * (0.02 * randint(100) - 1);

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_noise_lq, ((uv * texsize.xy) * texsize_noise_lq.zw)).xxx * 2.0)
   - 1.0) * 0.05));
  ret_1 = (ret_1 * 0.97);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 1.333);
  ret = tmpvar_1.xyz;
 }
