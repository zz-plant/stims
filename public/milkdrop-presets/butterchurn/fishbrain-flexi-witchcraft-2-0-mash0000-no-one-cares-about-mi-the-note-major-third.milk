[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (texsize.zw * 6.0);
  vec2 tmpvar_2;
  tmpvar_2.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  tmpvar_2.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = mix (mix ((vec3(0.4, 0.2, 0.9) * texture (sampler_fc_main, 
    (uv - (tmpvar_2 * 0.6))
  ).x), vec3(2.0, 2.0, 2.0), vec3((
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  .y * 0.35))), vec3(1.0, 0.7, 0.0), vec3((texture (sampler_main, (0.5 + 
    ((uv - 0.5) * 0.9)
  )).z * 0.8)));
  ret = tmpvar_3.xyz;
 }
