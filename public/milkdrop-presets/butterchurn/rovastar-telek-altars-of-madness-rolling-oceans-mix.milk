[preset00]
fRating=5.000000
fGammaAdj=1.980000
fDecay=1.000000
fVideoEchoZoom=1.006596
nWaveMode=5.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
fWaveAlpha=4.099998
fWaveScale=0.660126
fWaveSmoothing=0.000000
fWaveParam=0.300000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderSize=0.005000
fInnerBorderA=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.500000
fMotionVectorsR=0.150000
fMotionVectorsG=0.450000
fMotionVectorsB=0.650000
fMotionVectorsA=0.200000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=oldq8 = 0;
per_frame_init_6=xamptarg = 0;
per_frame_init_7=xamp = 0;
per_frame_init_8=xspeed = 0;
per_frame_init_9=green = 0;
per_frame_init_10=ypos = 0;
per_frame_init_11=amp = 0;
per_frame_init_12=wang = 0;
per_frame_init_13=beat = 0;
per_frame_init_14=vol = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=trebcap = 0;
per_frame_init_17=yamp = 0;
per_frame_init_18=q3 = 0;
per_frame_init_19=frametest = 0;
per_frame_init_20=xdir = 0;
per_frame_init_21=in = 0;
per_frame_init_22=q8 = 0;
per_frame_init_23=yspeed = 0;
per_frame_init_24=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=ib_a = 0.2 * bass;
per_frame_3=wave_r = wave_r + 0.45 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_4=wave_b = wave_b - 0.4 * (0.5 * sin(4.782 * time) + 0.5 * cos(0.522 * time));
per_frame_5=wave_g = wave_g + 0.4 * sin(1.731 * time);
per_frame_6=decay = decay - 0.1 * equal(mod(frame, 100), 0);
per_frame_7=vol = 0.167 * (bass + mid);
per_frame_8=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_9=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_10=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_11=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_12=xpos = xpos + 0.001 * xspeed;
per_frame_13=wave_x = 1.5 * xpos + 0.5;
per_frame_14=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_15=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_16=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_17=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_18=ypos = ypos + 0.001 * yspeed;
per_frame_19=wave_y = 1.5 * ypos + 0.5;
per_frame_20=zoom = 0.995;
per_frame_21=frametest = mod(frame, 2);
per_frame_22=wave_x = if(0.00001 < abs(frametest), 1 - wave_x, wave_x);
per_frame_23=wave_y = if(0.00001 < abs(frametest), 1 - wave_y, wave_y);
per_frame_24=wave_r = if(0.00001 < abs(frametest), wave_r, wave_g);
per_frame_25=wave_g = if(0.00001 < abs(frametest), wave_g, wave_b);
per_frame_26=wave_b = if(0.00001 < abs(frametest), wave_b, wave_r);
per_frame_27=monitor = green;
per_frame_28=q8 = oldq8 + 0.0005 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_29=oldq8 = q8;
per_frame_30=mv_g = 0.5 + 0.1 * bass_att;
per_frame_31=beat = if(0.00001 < abs(above(bass * bass_att, 4.5)), 1 - beat, beat);
per_frame_32=q1 = 2 * beat - 1;
per_frame_33=amp = 0.8 * amp + 0.06 * (bass_att + mid_att + treb_att);
per_frame_34=q2 = min(amp, 1);
per_frame_35=trebcap = 0.7 * trebcap + 0.16 * treb;
per_frame_36=q3 = 2 * trebcap;
per_frame_37=monitor = q3;
per_pixel_1=dx = dx + 0.008 * sin((2 * y - 1) * (48 + 12 * sin(0.412 * q8))) + 0.008 * sin((2 * (y + sin(0.163 * time)) - 1) * (3 + sin(0.241 * q8)));
per_pixel_2=dy = dy + 0.008 * cos((2 * x - 1) * (64 + 18 * sin(0.376 * q8))) + 0.008 * sin((2 * (x + sin(0.282 * q8)) - 1) * (3 + sin(0.349 * q8)));
per_pixel_3=wang = (3 + q3) * x + 1.7 * time + 0.1 * bass;
per_pixel_4=in = 0;
per_pixel_5=in = in + below(abs(x - 0.25), 0.05) * below(abs(y - 0.5), 0.25);
per_pixel_6=in = below(abs(y - (0.5 + 0.5 * sin(wang) * q2)), 0.1);
per_pixel_7=in = bnot(bnot(in));
per_pixel_8=dx = dx + 0.02 * in;
per_pixel_9=dy = dy + 0.08 * cos(wang) * q2 * in;
per_pixel_10=dx = dx + 0.005 * bnot(in) * q1;
per_pixel_11=dy = dy + bnot(in) * cos(wang) * -0.01 * q1;
