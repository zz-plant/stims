per_frame_1=warp = 0;
per_frame_2=zoom = 1;
per_frame_3=bb = 0.99 * bb + 0.02 * bass;
per_frame_4=mm = 0.99 * mm + 0.02 * mid;
per_frame_5=tt = 0.99 * tt + 0.02 * treb;
per_frame_6=mx = max(max(bb, mm), tt);
per_frame_7=mn = min(min(bb, mm), tt);
per_frame_8=ib_r = (bb - mn) / (mx - mn);
per_frame_9=ib_b = (mm - mn) / (mx - mn);
per_frame_10=ib_g = (tt - mn) / (mx - mn);
per_pixel_1=angle = 0.5 * asin(1) + sin(0.05 * time) * asin(1);
per_pixel_2=x1 = (x - 0.5) * aspectx;
per_pixel_3=y1 = (y - 0.5) * aspecty;
per_pixel_4=x = cos(-angle) * x1 - sin(-angle) * y1;
per_pixel_5=y = sin(-angle) * x1 + cos(-angle) * y1;
per_pixel_6=t = 0.25 * time;
per_pixel_7=v = 0.0005;
per_pixel_8=n = 11;
per_pixel_9=dx = v * sin(y * n + t);
per_pixel_10=dy = v * sin(x * n + t);
per_pixel_11=dx1 = cos(angle) * dx - sin(angle) * dy;
per_pixel_12=dy1 = sin(angle) * dx + cos(angle) * dy;
per_pixel_13=dx = dx1 * aspectx;
per_pixel_14=dy = dy1 * aspecty;

[warp_shader]
