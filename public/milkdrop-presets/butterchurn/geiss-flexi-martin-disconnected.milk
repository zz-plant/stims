wave_0_per_point13=x1 = cos(w1) * my_x + sin(w1) * my_y;
wave_0_per_point14=y1 = -sin(w1) * my_x + cos(w1) * my_y;
wave_0_per_point15=z1 = my_z;
wave_0_per_point16=x2 = cos(w2) * x1 + sin(w2) * z1;
wave_0_per_point17=z2 = -sin(w2) * x1 + cos(w2) * z1;
wave_0_per_point18=y2 = y1;
