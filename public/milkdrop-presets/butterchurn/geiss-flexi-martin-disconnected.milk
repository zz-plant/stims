wave_0_per_point4=rd = 0.075;
wave_0_per_point5=my_x = 0.5 * sin(sample * pi * 4 + (t7 + 1) * t8) + cos(sample * pi * n) * rd * sin(sample * pi * 4 + (t7 + 1) * t8);
wave_0_per_point6=my_y = 0.5 * cos(sample * pi * 4 + (t7 + 1) * t8) + cos(sample * pi * n) * rd * cos(sample * pi * 4 + (t7 + 1) * t8);
wave_0_per_point7=my_z = sin(sample * pi * n) * rd;
