wave_0_per_point21=x3 = x2;
wave_0_per_point22=l = sqrt(x3 * x3 + y3 * y3);
wave_0_per_point23=w = atan2(x3, y3);
wave_0_per_point24=p = tan(asin(1) + atan2(d + z3, l));
wave_0_per_point25=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
wave_0_per_point26=my_x = zoom * sin(w) * p;
wave_0_per_point27=my_y = zoom * cos(w) * p;
wave_0_per_point28=x = 0.5 + my_x;
wave_0_per_point29=y = 0.5 + my_y;
wave_0_per_point30=b = -z3 + 0.5;
