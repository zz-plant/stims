[warp_shader]
shader_body { 
  vec2 uv6_1;
  vec2 uv1_2;
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  float x_4;
  x_4 = (abs(tmpvar_3.x) - abs(tmpvar_3.y));
  float tmpvar_5;
  tmpvar_5 = (12.0 * sqrt((x_4 * x_4)));
  uv1_2 = (tmpvar_3 - (clamp (
    ((sin(tmpvar_5) / cos(tmpvar_5)) * normalize(tmpvar_3))
  , vec2(-3.0, -3.0), vec2(3.0, 3.0)) / 40.0));
  uv6_1 = (0.4 * cos((
    (uv1_2 * 14.0)
   + time)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((texture (sampler_main, 
    ((uv1_2 * ((0.95 - 
      (q28 / 16.0)
    ) + (0.4 * tmpvar_5))) + 0.5)
  ).xyz + vec3(
    (0.004 / sqrt(dot (uv6_1, uv6_1)))
  )) * 0.99) - 0.03);
  ret = tmpvar_6.xyz;
 }

[comp_shader]
vec3 xlat_mutablenoise;
vec2 xlat_mutablers;
 shader_body { 
  xlat_mutablers.x = ((1.0/(rad)) + (time * 4.0));
  xlat_mutablers.y = ang;
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_pw_noise_lq, ((xlat_mutablers / 3.0) / q27));
  xlat_mutablenoise = (tmpvar_1.xyz * vec3(greaterThanEqual (tmpvar_1.xyz, vec3(0.8, 0.8, 0.8))));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (((1.0 + q22) * texture (sampler_main, (uv + 
    (xlat_mutablenoise.xy * xlat_mutablers)
  )).xyz) - (0.2 * xlat_mutablenoise));
  ret = tmpvar_2.xyz;
 }
