wave_1_per_point2=explode_time = 1;
wave_1_per_point3=state = if(0.00001 < abs(below(timestart + explode_time - time * fire, 0)), 0, 1);
wave_1_per_point4=timestart = if(0.00001 < abs(below(timestart + explode_time - time * fire, 0)), time, timestart);
wave_1_per_point5=xpos = if(0.00001 < abs(equal(state, 0)), 0.5 + 0.3 * sin(randint(1000)), xpos);
wave_1_per_point6=ypos = if(0.00001 < abs(equal(state, 0)), 0.5 + 0.3 * sin(randint(1000)), ypos);
wave_1_per_point7=explode = if(0.00001 < abs(equal(state, 0)), 0.0000001 * randint(100), explode);
wave_1_per_point8=size = if(0.00001 < abs(equal(state, 1)), size + 0.00001 + explode, 0);
wave_1_per_point9=x = xpos + size * cos(10 * sample);
wave_1_per_point10=y = ypos + size * sin(10 * sample);
wave_1_per_point11=r = 0.5 + 0.5 * sin(1.24 * q2 + x + x);
wave_1_per_point12=g = 0.5 + 0.5 * sin(1.35 * q2 + x + y);
wave_1_per_point13=b = 0.5 + 0.5 * sin(1.4666 * q2 + y + y);
