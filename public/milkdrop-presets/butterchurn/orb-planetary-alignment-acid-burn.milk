wave_2_per_point3=state = if(0.00001 < abs(below(timestart + explode_time - time * fire, 0)), 0, 1);
wave_2_per_point4=timestart = if(0.00001 < abs(below(timestart + explode_time - time * fire, 0)), time, timestart);
wave_2_per_point5=xpos = if(0.00001 < abs(equal(state, 0)), 0.5 + 0.3 * sin(randint(1000)), xpos);
wave_2_per_point6=ypos = if(0.00001 < abs(equal(state, 0)), 0.5 + 0.3 * sin(randint(1000)), ypos);
wave_2_per_point7=explode = if(0.00001 < abs(equal(state, 0)), 0.0000001 * randint(100), explode);
wave_2_per_point8=size = if(0.00001 < abs(equal(state, 1)), size + 0.00001 + explode, 0);
wave_2_per_point9=x = xpos + size * cos(10 * sample);
wave_2_per_point10=y = ypos + size * sin(10 * sample);
wave_2_per_point11=r = 0.5 + 0.5 * sin(1.14 * q2 + x + x);
wave_2_per_point12=g = 0.5 + 0.5 * sin(1.55 * q2 + x + y);
wave_2_per_point13=b = 0.5 + 0.5 * sin(1.7666 * q2 + y + y);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  vec2 tmpvar_2;
  tmpvar_2 = (uv - 0.5);
  tmpvar_1.xyz = (texture (sampler_main, ((
    ((((tmpvar_2 * 
      (0.97 + (rad * 0.02))
    ) + 0.5) + ((
      (texture (sampler_blur1, ((tmpvar_2 * 0.9) + 0.5)).xyz * scale1)
     + bias1) * 0.1).xy) - 0.5)
   * 0.98) + 0.5)).xyz - 0.002);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 2.0);
  ret = tmpvar_1.xyz;
 }
