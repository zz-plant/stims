per_frame_1=ob_r = 0.21 - 0.2 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_2=ob_g = 0.5 - 0.46 * sin(1.724 * time);
per_frame_3=ob_b = 0.65 - 0.3 * cos(1.816 * time);
per_frame_4=warp = 0;
per_frame_5=ib_size = 0.025;
per_frame_6=ib_r = ib_r + 0.2 * (0.6 * sin(3.034 * time) + 0.4 * cos(2.14 * time));
per_frame_7=ib_g = ib_g + 0.5 * (0.6 * sin(3.147 * time) + 0.4 * cos(2.015 * time));
per_frame_8=ib_b = ib_b - 0.5 * (0.6 * sin(3.431 * time) + 0.4 * cos(1.842 * time));
per_frame_9=dx = dx + 0.001 + abs(0.003 * (0.6 * sin(0.234 * time) + 0.4 * cos(0.437 * time)));
per_frame_10=dy = dy + abs(0.003 * (0.7 * sin(0.213 * time) + 0.3 * cos(0.315 * time)));
per_frame_11=volume = 0.15 * (bass + bass_att + treb + treb_att + mid + mid_att);
per_frame_12=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * volume * bass_att, 0.5), xamptarg);
per_frame_13=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_14=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_15=xaccel = xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_16=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_17=xpos = xpos + 0.001 * xspeed;
per_frame_18=q2 = xpos;
per_frame_19=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * volume * treb_att, 0.5), yamptarg);
per_frame_20=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_21=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_22=yaccel = ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_23=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_24=ypos = ypos + 0.001 * yspeed;
per_frame_25=q4 = ypos;
per_frame_26=bass_effect = max(max(bass, bass_att) - 1.2, 0);
per_frame_27=echo_zoom = 1.32 + 0.3 * (0.59 * sin(q4 + 0.865 * time) + 0.41 * cos(q2 + 1.192 * time)) + 0.05 * bass_effect;
per_frame_28=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_29=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_30=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_31=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_32=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_33=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_34=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_35=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_36=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_37=peakbass_att = max(if(0.00001 < abs(beat), bass_att, peakbass_att), 1.1 * meanbass_att);
per_frame_38=beatcounter = if(0.00001 < abs(above(beat, 0)), beatcounter + 1, beatcounter);
per_frame_39=beatcounter = if(0.00001 < abs(above(beatcounter, 7)), 0, beatcounter);
per_frame_40=beateven = mod(beatcounter, 2);
per_frame_41=mode = if(0.00001 < abs(beat), mod(mode + randint(3) + 1, 4), mode);
per_frame_42=echo_orient = mode;
per_frame_43=wave_a = if(0.00001 < abs(beat), 1, 0);
per_frame_44=wave_r = wave_r + 0.2 * sin(0.7854 * time) - 0.2 * beateven;
per_frame_45=wave_b = wave_b + 0.1 * sin(0.8254 * time) + 0.2 * beateven;
per_frame_46=wave_g = wave_g + 0.1 * sin(0.854 * time) + 0.2 * beateven;
per_frame_47=q6 = beat;
per_frame_48=wave_mode = if(0.00001 < abs(beateven), 7, 0);
per_frame_49=mv_a = if(0.00001 < abs(beat), if(0.00001 < abs(equal(beatcounter, 6)), 1, 0), 0);
per_frame_50=mv_r = if(0.00001 < abs(mv_a), randint(2), 0);
per_frame_51=mv_b = if(0.00001 < abs(mv_a), randint(2), 0);
per_frame_52=mv_g = if(0.00001 < abs(mv_a), randint(2), 0);
per_pixel_1=box = 0.5 + 0.8 * (mod(2 * x, 4) + mod(2 * y, 2));
per_pixel_2=q1 = 8.45 + 0.3 * (sin(pow(x, 3) + 0.177 * time) - cos(pow(y, 3) + 0.223 * time));
per_pixel_3=q7 = above(box, 1);
per_pixel_4=zoom = if(0.00001 < abs(q7), 0.1 * q1 + 6 * q6, zoom);
per_pixel_5=rot = if(0.00001 < abs(q7), 0.63 * sin(0.385 * time + 0.12 * sin(0.67 * time) + 0.1 * q4 + 0.12 * q2 + 50 * q6), rot);
per_pixel_6=cx = cx - 0.15 * sin(2 * q4);
per_pixel_7=cy = cy + 0.14 * sin(2 * q2);
per_pixel_8=sx = if(0.00001 < abs(q7), sx + 18 * q6, sx);
per_pixel_9=sy = if(0.00001 < abs(q7), sy + 18 * q6, sy);
shape_0_init1=q4 = 0;
shape_0_init2=q5 = 0;
shape_0_per_frame1=x = 0.5 + q4;
shape_0_per_frame2=y = 0.5 + q5;
shape_0_per_frame3=a = bass_att + mid_att + treb_att;
shape_0_per_frame4=a = a * 0.25;
shape_0_per_frame5=a = a * a * 1.5;
shape_0_per_frame6=r2 = 0.5 * sin(1.31 * bass);
shape_0_per_frame7=g2 = 0.5 * sin(1.32 * bass);
shape_0_per_frame8=b2 = 0.5 * sin(1.33 * bass);
shape_0_per_frame9=r = bass + 1.31 * time;
shape_0_per_frame10=g = bass + 1.32 * time / 2;
shape_0_per_frame11=b = bass + 1.33 * time / 3;
shape_0_per_frame12=rad = sin(bass);

[warp_shader]
vec3 xlat_mutablemus;
 shader_body { 
  vec3 crisp_1;
  vec2 uv6_2;
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  float tmpvar_4;
  tmpvar_4 = (dot (texture (sampler_noise_hq, (uv / 4.0)), vec4(0.32, 0.49, 0.29, 0.0)) * q31);
  mat2 tmpvar_5;
  tmpvar_5[uint(0)].x = cos(tmpvar_4);
  tmpvar_5[uint(0)].y = sin(tmpvar_4);
  tmpvar_5[1u].x = -(sin(tmpvar_4));
  tmpvar_5[1u].y = cos(tmpvar_4);
  uv6_2 = (tmpvar_3 * tmpvar_5);
  uv6_2 = (uv6_2 + sin((q32 * tmpvar_3)));
  xlat_mutablemus = (vec3((0.2 / (
    sqrt(uv6_2.x)
   + 0.2))) * vec3(1.1, 1.0, 0.95));
  xlat_mutablemus = (xlat_mutablemus * (0.9 + (0.1 * texture (sampler_noise_hq, uv))).xyz);
  vec3 tmpvar_6;
  tmpvar_6 = ((texture (sampler_blur1, fract(uv)).xyz * scale1) + bias1);
  vec2 tmpvar_7;
  tmpvar_7.x = dot ((texture (sampler_main, (uv + vec2(0.005, 0.0))) - texture (sampler_main, (uv - vec2(0.005, 0.0)))), vec4(0.32, 0.49, 0.29, 0.0));
  tmpvar_7.y = dot ((texture (sampler_main, (uv + vec2(0.0, 0.005))) - texture (sampler_main, (uv - vec2(0.0, 0.005)))), vec4(0.32, 0.49, 0.29, 0.0));
  crisp_1 = (texture (sampler_main, (uv + (tmpvar_7 * 0.02))).xyz + (texture (sampler_main, uv).xyz / 2.0));
  crisp_1 = (crisp_1 * 0.67);
  crisp_1 = (crisp_1 + ((0.08 * xlat_mutablemus) - (
    sqrt(dot (tmpvar_7, tmpvar_7))
   * tmpvar_6)));
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = (((crisp_1 - 
    (dot (tmpvar_6, vec3(0.32, 0.49, 0.29)) * 0.04)
  ) * 0.99) - 0.04);
  ret = tmpvar_8.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1.x = tmpvar_2.x;
  ret_1.yz = (tmpvar_2.x * vec2(0.9, 0.7));
  ret_1 = (pow (ret_1, vec3(1.7, 2.0, 2.2)) * 5.0);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
