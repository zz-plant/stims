[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=3.000000
nWaveMode=1.000000
bWaveThick=1.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
fWaveAlpha=0.300000
fWaveScale=0.881000
fWaveSmoothing=0.500000
fWaveParam=-1.000000
fWarpScale=2.853000
fZoomExponent=3.600000
fZoom=1.021090
fRot=-0.160000
fWarp=0.309000
fWaveR=0.600000
fWaveG=0.600000
fWaveB=0.600000
fWaveY=0.470000
nMotionVectorsLoop=1.750000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q8 = 0;
per_frame_init_2=oldq8 = 0;
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=q8 = oldq8 + if(0.00001 < abs(above(bass + bass_att, 1.8)), q8 + 0.0005 * pow(bass + bass_att - 1, 9), 0);
per_frame_5=oldq8 = q8;
per_frame_6=monitor = q8;
per_frame_7=zoom = zoom + 0.023 * (0.6 * sin(0.339 * q8) + 0.4 * sin(0.276 * q8));
per_frame_8=rot = rot + 0.03 * (0.6 * sin(0.381 * q8) + 0.4 * sin(0.579 * q8));
per_frame_9=mv_r = wave_r;
per_frame_10=mv_b = wave_b;
per_frame_11=mv_g = wave_g;
per_frame_12=mv_x = 1.25;
per_frame_13=mv_y = 1.25;
per_frame_14=mv_dx = 0.1 * sin(1.1 * time);
per_frame_15=mv_dy = 0.1 * cos(1.112 * time);
per_pixel_1=rot = rot + 1 / (10 * (rad + 0.2 + 0.1 * sin(q8)));

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (tmpvar_1.xyz * (1.0 + (
    (abs((fract(
      (tmpvar_1.xyz * 8.0)
    ) - 0.5)) - 0.25)
   * 0.4)));
  ret = tmpvar_2.xyz;
 }
