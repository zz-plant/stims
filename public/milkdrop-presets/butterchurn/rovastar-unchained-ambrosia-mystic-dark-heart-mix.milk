[preset00]
fRating=0.000000
fDecay=0.942000
fVideoEchoZoom=1.006500
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=5.000000
bWaveThick=1.000000
fWaveAlpha=0.799900
fWaveScale=1.549220
fZoom=1.040604
fCX=0.470000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=state_scalar = 0;
per_frame_init_2=q8 = 0;
per_frame_init_3=location = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.143 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(0.896 * time);
per_frame_3=q8 = 0.5 * (bass + bass_att);
per_pixel_1=state_scalar = if(0.00001 < abs(equal(q8, 3)), -0.1, if(0.00001 < abs(equal(q8, 2)), 2, 1));
per_pixel_2=location = sin(10 * ang + time + abs(pow(1 + rad, q8) + mod(10 * x, 5)));
per_pixel_3=zoom = zoom + 0.08 * state_scalar * location;
per_pixel_4=rot = rot + 0.02 * state_scalar * location;
per_pixel_5=zoomexp = 1 / pow(q8, 10 * q8);
per_pixel_6=zoomexp = if(0.00001 < abs(above(rad, 0.8)), 1, zoomexp);
