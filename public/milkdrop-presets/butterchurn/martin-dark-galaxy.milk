per_frame_17=ready = is_beat * bnot(ready) + bnot(is_beat2) * ready;
per_frame_18=is_beat2 = ready * above(time, t0 + 0.2);
per_frame_19=q19 = is_beat2;
per_frame_20=k1 = is_beat * equal(index, 0);
per_frame_21=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_22=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_23=rott = 3.14159265359 * p2 / 4;
per_frame_24=q27 = index + 1;
per_frame_25=q28 = index2 + 1;
per_frame_26=q29 = 4 * index3 + 1;
per_frame_27=q30 = index4;
per_frame_28=q1 = cos(rott);
per_frame_29=q2 = sin(rott);
per_frame_30=q3 = -q2;
per_frame_31=q4 = q1;
per_frame_32=movex = movex + 0.06 / fps;
per_frame_33=q30 = movex;
per_frame_34=fade = dec_med * fade + (1 - dec_med);
per_frame_35=q32 = fade;
per_frame_36=zoom = 0.98;
per_frame_37=dx = 0.04 * q2 * bnot(index2);
per_frame_38=dy = 0.04 * q1 * bnot(index2);
per_frame_39=rot = 0.02;

