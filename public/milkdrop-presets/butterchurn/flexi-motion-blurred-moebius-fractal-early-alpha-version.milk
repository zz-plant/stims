per_frame_init_9=q15 = 0;
per_frame_init_10=c_inv_r = 0;
per_frame_init_11=angle = 0;
per_frame_init_12=q11 = 0;
per_frame_init_13=bcad_r = 0;
per_frame_init_14=b_r = 0;
per_frame_init_15=q16 = 0;
per_frame_init_16=bcad_i = 0;
per_frame_init_17=q17 = 0;
per_frame_init_18=q14 = 0;
per_frame_init_19=translation_y = 0;
per_frame_init_20=translation_v = 0;
per_frame_init_21=b_i = 0;
per_frame_init_22=translation_u = 0;
per_frame_1=scale = 1;
per_frame_2=angle = 0.2 * time;
per_frame_3=translation_x = 0;
per_frame_4=translation_y = 0.12;
per_frame_5=a_r = cos(angle) * scale;
per_frame_6=a_i = sin(angle) * scale;
per_frame_7=b_r = translation_x;
per_frame_8=b_i = translation_y;
per_frame_9=scale = 1;
per_frame_10=angle = 0.3 * sin(0.1337 * time);
per_frame_11=translation_u = 0;
per_frame_12=translation_v = -0.2;
per_frame_13=q15 = cos(angle) * scale;
per_frame_14=q16 = sin(angle) * scale;
per_frame_15=q17 = translation_u;
per_frame_16=q18 = translation_v;
per_frame_17=c_inv_r = q15 / (q15 * q15 + q16 * q16);
per_frame_18=c_inv_i = q16 / (q15 * q15 + q16 * q16);
per_frame_19=q11 = a_r * c_inv_r - a_i * c_inv_i;
per_frame_20=q12 = a_r * c_inv_i - a_i * c_inv_r;
per_frame_21=bcad_r = b_r * q15 - b_i * q16 - (a_r * q17 - a_i * q18);
per_frame_22=bcad_i = b_r * q16 - b_i * q15 - (a_r * q18 - a_i * q17);
per_frame_23=q13 = bcad_r * c_inv_r - bcad_i * c_inv_i;
per_frame_24=q14 = bcad_r * c_inv_i - bcad_i * c_inv_r;

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = q11;
  tmpvar_1.y = q12;
  vec2 tmpvar_2;
  tmpvar_2.x = q17;
  tmpvar_2.y = q18;
  vec2 tmpvar_3;
  tmpvar_3 = (uv_orig - 0.5);
  vec2 tmpvar_4;
  tmpvar_4.x = ((tmpvar_3.x * q15) - (tmpvar_3.y * q16));
  tmpvar_4.y = ((tmpvar_3.x * q16) - (tmpvar_3.y * q15));
  vec2 tmpvar_5;
  tmpvar_5 = ((tmpvar_4 * aspect.yx) + tmpvar_2);
  vec2 tmpvar_6;
  tmpvar_6.x = ((q13 * tmpvar_5.x) + (q14 * tmpvar_5.y));
  tmpvar_6.y = ((q14 * tmpvar_5.x) - (q13 * tmpvar_5.y));
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = mix ((texture (sampler_fc_main, fract(
    ((tmpvar_6 / ((tmpvar_5.x * tmpvar_5.x) + (tmpvar_5.y * tmpvar_5.y))) + tmpvar_1)
  )) * 0.94).xyz, texture (sampler_main, uv_orig).xyz, vec3(0.75, 0.75, 0.75));
  ret = tmpvar_7.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
