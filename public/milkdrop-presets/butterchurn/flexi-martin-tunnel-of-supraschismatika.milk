per_frame_1=decay = 1;
per_frame_2=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_3=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_4=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_5=x1 = 0.5 + xx1 - xx2;
per_frame_6=y1 = 0.5 + yy1;
per_frame_7=spring = 28;
per_frame_8=grav = 2;
per_frame_9=resist = 0.2;
per_frame_10=bounce = 0.94;
per_frame_11=dt = 0.0001;
per_frame_12=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_13=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_14=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_15=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_16=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_17=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_18=x2 = x2 + vx2;
per_frame_19=y2 = y2 + vy2;
per_frame_20=x3 = x3 + vx3;
per_frame_21=y3 = y3 + vy3;
per_frame_22=x4 = x4 + vx4;
per_frame_23=y4 = y4 + vy4;
per_frame_24=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_25=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_26=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_27=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_28=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_29=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_30=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_31=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_32=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_33=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_34=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_35=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_36=q1 = aspectx;
per_frame_37=q2 = aspecty;
per_frame_38=q4 = x4;
per_frame_39=q8 = y4;
per_frame_40=zoom = 1;
per_frame_41=warp = 0;
per_frame_42=bb = 0.99 * bb + 0.02 * bass;
per_frame_43=mm = 0.99 * mm + 0.02 * mid;
per_frame_44=tt = 0.99 * tt + 0.02 * treb;
per_frame_45=ob_r = (bb - min(min(bb, mm), tt)) / (max(max(bb, mm), tt) - min(min(bb, mm), tt));
per_frame_46=ob_b = (mm - min(min(bb, mm), tt)) / (max(max(bb, mm), tt) - min(min(bb, mm), tt));
per_frame_47=ob_g = (tt - min(min(bb, mm), tt)) / (max(max(bb, mm), tt) - min(min(bb, mm), tt));
per_frame_48=q6 = atan2(vx4, vy4);
per_frame_49=q5 = sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_50=wave_a = 0;
per_frame_51=a = 0.98 * a - 0.01 * (bass - treb);
per_frame_52=q15 = a;
per_frame_53=v = 0.96 * v + 0.12 * a;
per_frame_54=q16 = v;
per_frame_55=w = w - 0.01 * v;
per_frame_56=q18 = w;
per_frame_57=q19 = 0.5 - 0.15 * (bass_att - treb_att);
per_frame_58=d = d + 0.6 * (bass_att - 0.5) / fps;
per_frame_59=d2 = d2 + 0.36 * (treb_att - 0.5) / fps;
per_frame_60=q20 = d;
per_frame_61=q21 = d2;
per_frame_62=monitor = d2;
per_pixel_1=x = 0.5 + (x - 0.5) * q1;
per_pixel_2=y = 0.5 + (y - 0.5) * q2;
per_pixel_3=dir = -q6 + asin(1);
per_pixel_4=b1 = 0.1;
per_pixel_5=m1 = 25 * q5;
per_pixel_6=t1 = 0.05;
per_pixel_7=xx = q4;
per_pixel_8=yy = 1 - q8;
per_pixel_9=x1 = xx + cos(dir + 1.5708) * b1;
per_pixel_10=y1 = yy - sin(dir + 1.5708) * b1;
per_pixel_11=x2 = xx - cos(dir + 1.5708) * b1;
per_pixel_12=y2 = yy + sin(dir + 1.5708) * b1;
per_pixel_13=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * b1;
per_pixel_14=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_15=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * b1;
per_pixel_16=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_17=si3 = 0 * -pow(q5, 3);
per_pixel_18=dx = 2 * (si1 * sin(y1 - y) * m1 * d1 - si2 * sin(y2 - y) * m1 * d2 + si3 * cos(dir) * t1);
per_pixel_19=dy = 2 * (-si1 * sin(x1 - x) * m1 * d1 + si2 * sin(x2 - x) * m1 * d2 - si3 * sin(dir) * t1);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_fc_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
vec2 xlat_mutablers;
 shader_body { 
  vec2 uv_1;
  uv_1 = (0.5 + ((uv - 0.5) * aspect.xy));
  xlat_mutablers.x = (((ang / 3.14) + (rad * 
    (q15 - q16)
  )) - q18);
  vec2 x_2;
  x_2 = (uv_1 - 0.5);
  xlat_mutablers.y = ((0.1 / (0.05 + 
    (sqrt(dot (x_2, x_2)) * 1.4)
  )) + q21);
  vec2 tmpvar_3;
  tmpvar_3 = fract(xlat_mutablers);
  vec2 tmpvar_4;
  tmpvar_4.y = 0.0;
  tmpvar_4.x = texsize.z;
  vec2 tmpvar_5;
  tmpvar_5 = (tmpvar_4 * 4.0);
  vec2 tmpvar_6;
  tmpvar_6.x = 0.0;
  tmpvar_6.y = texsize.w;
  vec2 tmpvar_7;
  tmpvar_7 = (tmpvar_6 * 4.0);
  vec2 tmpvar_8;
  tmpvar_8.x = dot (((
    (texture (sampler_blur1, (tmpvar_3 - tmpvar_5)).xyz * scale1)
   + bias1) - (
    (texture (sampler_blur1, (tmpvar_3 + tmpvar_5)).xyz * scale1)
   + bias1)), vec3(0.32, 0.49, 0.29));
  tmpvar_8.y = dot (((
    (texture (sampler_blur1, (tmpvar_3 - tmpvar_7)).xyz * scale1)
   + bias1) - (
    (texture (sampler_blur1, (tmpvar_3 + tmpvar_7)).xyz * scale1)
   + bias1)), vec3(0.32, 0.49, 0.29));
  uv_1 = ((0.4 * cos(
    ((12.56 * tmpvar_3) - (vec2(0.0, 10.0) * (q21 + q20)))
  )) - (4.0 * tmpvar_8));
  vec3 tmpvar_9;
  tmpvar_9 = pow (((
    (2.0 * (clamp ((0.02 / 
      sqrt(dot (uv_1, uv_1))
    ), 0.0, 1.0) * hue_shader))
   * 
    ((texture (sampler_main, tmpvar_3) * 4.0).xyz + 1.0)
  ) - 0.04), vec3(0.8, 0.8, 0.8));
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = mix (tmpvar_9, tmpvar_9.zxy, vec3(q19)).zxy;
  ret = tmpvar_10.xyz;
 }
