per_frame_1=db = 0.6 * db + 0.25 * bass_att;
per_frame_2=dm = 0.6 * dm + 0.25 * mid_att;
per_frame_3=dt = 0.6 * dt + 0.25 * treb_att;
per_frame_4=dbmt = 0.5 * dbmt + 0.33 * (db + dm + dt);
per_frame_5=vv = vv + 0.1 * dbmt;
per_frame_6=bb = bb + 0.1 * db;
per_frame_7=mm = mm + 0.1 * dm;
per_frame_8=tt = tt + 0.1 * tt;
per_frame_9=q1 = 0.5 * vv;
per_frame_10=q2 = sin(q1);
per_frame_11=q3 = cos(q1);
per_frame_12=q4 = tt - bb + 0.15 * vv;
per_frame_13=q5 = bb - tt + 0.15 * vv;
per_frame_14=q6 = 0.5 + 0.5 * sin(0.15 * q1);
per_frame_15=q7 = 0.5 + 0.5 * cos(0.21 * q1);
per_frame_16=q8 = 0.5 + 0.3 * sin(0.05 * q1) + 0.2 * cos(0.3 * q1);
per_frame_17=q9 = 0.4 + 0.6 * sin(0.27 * q1);
per_pixel_1=vx = 0.5 + cos(0.2 * q4);
per_pixel_2=vy = 0.5 + sin(0.2 * q5);
per_pixel_3=vz = 0;
per_pixel_4=z = 0 - vz;
per_pixel_5=x = x - vx;
per_pixel_6=y = y - vy;
per_pixel_7=d = 0.1 * time - treb * treb * treb * 0;
per_pixel_8=xx = sin(d) * x + cos(d) * y;
per_pixel_9=yy = cos(d) * x - sin(d) * y;
per_pixel_10=x = xx;
per_pixel_11=y = yy;
per_pixel_12=x = x + mx;
per_pixel_13=y = y + my;
per_pixel_14=z = z + vz;
per_pixel_15=cx = 0;
per_pixel_16=cy = 0;
per_pixel_17=cz = 0.5 + 0 * treb;
per_pixel_18=vx = 0;
per_pixel_19=vy = 0;
per_pixel_20=vz = 0;
per_pixel_21=zoom = 0.33;
per_pixel_22=w = 1 / zoom * (1 + sqrt(sqr(z - cz) + sqr(x - cx) + sqr(y - cy)));
per_pixel_23=dx = -(x - mx) * w;
per_pixel_24=dy = -(y - my) * w;

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1.x = (texture (sampler_fc_main, (1.0 - abs(
    ((fract((uv * 0.5)) * 2.0) - 1.0)
  ))).x * 0.5);
  vec2 tmpvar_2;
  tmpvar_2 = ((uv_orig - 0.5) * vec2(1.8, 1.8));
  vec2 tmpvar_3;
  tmpvar_3.x = ((tmpvar_2.x * tmpvar_2.x) - (tmpvar_2.y * tmpvar_2.y));
  tmpvar_3.y = ((2.0 * tmpvar_2.x) * tmpvar_2.y);
  ret_1.y = texture (sampler_fc_main, (tmpvar_3 + vec2(0.44, 0.734))).y;
  ret_1 = ((ret_1 - 0.02) * 0.98);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = ret_1;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv2_1;
  vec3 ret_2;
  vec4 tmpvar_3;
  tmpvar_3.x = q6;
  tmpvar_3.y = q7;
  tmpvar_3.z = q8;
  tmpvar_3.w = q9;
  ret_2 = ((texture (sampler_blur3, uv).xyz * scale3) + bias3).xxx;
  vec2 tmpvar_4;
  tmpvar_4 = (uv - 0.5);
  vec2 tmpvar_5;
  tmpvar_5.x = ((tmpvar_4.x * q3) - (tmpvar_4.y * q2));
  tmpvar_5.y = ((tmpvar_4.x * q2) + (tmpvar_4.y * q3));
  uv2_1 = (tmpvar_5 + 0.5);
  vec4 tmpvar_6;
  tmpvar_6.w = 0.0;
  tmpvar_6.xyz = mix (mix (mix (
    mix (ret_2, tmpvar_3.yzx, vec3((((texture (sampler_blur2, uv).xyz * scale2) + bias2).x * 2.0)))
  , 
    max ((tmpvar_3.yxz * 2.0), vec3(1.0, 1.0, 1.0))
  , vec3(
    (((texture (sampler_blur1, uv).xyz * scale1) + bias1).x * 0.5)
  )), (-0.1 * tmpvar_3.zwy), texture (sampler_main, uv).xxx), vec3(1.0, 1.0, 1.0), texture (sampler_main, uv2_1).yyy);
  vec4 tmpvar_7;
  tmpvar_7.w = 0.0;
  tmpvar_7.xyz = mix (tmpvar_6, tmpvar_3, vec4(((
    (texture (sampler_blur2, uv2_1).xyz * scale2)
   + bias2).y * 2.0))).xyz;
  vec3 tmpvar_8;
  tmpvar_8 = mix (mix (tmpvar_7, max (
    (tmpvar_3 * 2.0)
  , vec4(1.2, 1.2, 1.2, 1.2)), vec4((
    ((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1)
  .y * 0.5))).xyz, (-0.01 * tmpvar_3.xyw), texture (sampler_main, uv2_1).yyy);
  ret_2 = tmpvar_8;
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = tmpvar_8;
  ret = tmpvar_9.xyz;
 }
