per_frame_init_26=out_y = 0;
per_frame_init_27=oldx = 0;
per_frame_init_28=xmovn = 0;
per_frame_init_29=oldx = 0.5;
per_frame_init_30=oldy = 0.5;
per_frame_1=warp = 0;
per_frame_2=wave_r = min(1, max(0, 0.3 * bass));
per_frame_3=wave_g = min(1, max(0, 0.3 * mid));
per_frame_4=wave_b = min(1, max(0, 0.3 * treb));
per_frame_5=counter1 = if(0.00001 < abs(equal(counter2, 1)), if(0.00001 < abs(equal(counter1, 1)), 0, counter1 + 0.2), 1);
per_frame_6=counter2 = if(0.00001 < abs(equal(counter1, 1)), if(0.00001 < abs(equal(counter2, 1)), 0, counter2 + 0.2), 1);
per_frame_7=cdelay1 = if(0.00001 < abs(equal(cdelay2, 1)), 1, if(0.00001 < abs(equal(mod(colorcounter, 2), 1)), if(0.00001 < abs(equal(counter1, 1)), 2, 0), if(0.00001 < abs(equal(counter2, 1)), 2, 0)));
per_frame_8=cdelay2 = if(0.00001 < abs(equal(cdelay1, 2)), 1, 0);
per_frame_9=colorcounter = if(0.00001 < abs(above(colorcounter, 7)), 0, if(0.00001 < abs(equal(cdelay1, 1)), colorcounter + 1, colorcounter));
per_frame_10=ob_r = if(0.00001 < abs(equal(colorcounter, 1)), 1, if(0.00001 < abs(equal(colorcounter, 2)), 1, if(0.00001 < abs(equal(colorcounter, 3)), 1, if(0.00001 < abs(equal(colorcounter, 4)), sin(counter2 + 2.1), if(0.00001 < abs(equal(colorcounter, 5)), 0, if(0.00001 < abs(equal(colorcounter, 6)), 0, sin(counter1)))))));
per_frame_11=ob_g = if(0.00001 < abs(equal(colorcounter, 1)), 0, if(0.00001 < abs(equal(colorcounter, 2)), sin(0.5 * counter2), if(0.00001 < abs(equal(colorcounter, 3)), sin(0.4 * (counter1 + 1.75)), if(0.00001 < abs(equal(colorcounter, 4)), 1, if(0.00001 < abs(equal(colorcounter, 5)), 1, if(0.00001 < abs(equal(colorcounter, 6)), sin(counter2 + 2), 0))))));
per_frame_12=ob_b = if(0.00001 < abs(equal(colorcounter, 1)), sin(counter1 + 2.1), if(0.00001 < abs(equal(colorcounter, 2)), 0, if(0.00001 < abs(equal(colorcounter, 3)), 0, if(0.00001 < abs(equal(colorcounter, 4)), 0, if(0.00001 < abs(equal(colorcounter, 5)), sin(counter1), exec2(equal(colorcounter, 6), 1))))));
per_frame_13=mbass = max(bass_att, 3);
per_frame_14=xmovn = 0.1 * randint(10) * mbass * 0.015 * (1 - 2 * above(randint(10), 5));
per_frame_15=ymovn = pow(pow(0.015 * mbass, 2) - pow(xmovn, 2), 1 / 2) * (1 - 2 * above(randint(10), 5));
per_frame_16=xmov = if(0.00001 < abs(beat), xmovn, 0.9 * xmov);
per_frame_17=ymov = if(0.00001 < abs(beat), ymovn, 0.9 * ymov);
per_frame_18=q1 = oldx;
per_frame_19=q2 = oldy;
per_frame_20=out_x = bor(above(q1 + xmov, 0.9), below(q1 + xmov, 0.1));
per_frame_21=out_y = bor(above(q2 + ymov, 0.9), below(q2 + ymov, 0.1));
per_frame_22=xmov = xmov + -2 * xmov * out_x;
per_frame_23=ymov = ymov + -2 * ymov * out_y;
per_frame_24=wave_x = q1 + xmov;
per_frame_25=wave_y = q2 + ymov;
per_frame_26=q1 = wave_x;
per_frame_27=q2 = wave_y;
per_frame_28=oldx = q1;
per_frame_29=oldy = q2;
per_frame_30=decay = decay - 0.91 * treble;
per_frame_31=volume = 0.3 * bass + mid;
per_frame_32=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_33=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_34=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_35=runmeanbass = (2 * runmeanbass + bass_att) / 3;
per_frame_36=peakbass_att = max(bass_att, peakbass_att);
per_frame_37=beat = above(volume, 0.8) * above(bass_att, 1.1 * runmeanbass) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_38=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_39=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_40=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_41=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_42=q3 = volume + treb;
per_frame_43=monitor = meanbass_att;
per_pixel_1=mx = x - q1;
per_pixel_2=my = y - (1 - q2);
per_pixel_3=mrad = pow(pow(mx, 2) + pow(my, 2), 0.5) * pow(2, 0.5);
per_pixel_4=cx = q1;
per_pixel_5=cy = 1 - q2;
per_pixel_6=rot = rot + 0.5 * below(mrad - 0.18, 0) * sin(40 * mrad) * (mrad - 0.1) * 40 - 0.3 * above(mrad - 0.18, 0) * sin(2 * mrad) * (mrad - 0.1) * sin((cx - 0.5) * (cy - 0.5) * 6.28) * q3;
per_pixel_7=zoom = zoom - 0.05 * above(mrad - 0.18, 0) * mrad * q3;
per_pixel_8=dx = dx + 0.015 * below(mrad - 0.18, 0) * (mx / mrad);
per_pixel_9=dy = dy + 0.015 * below(mrad - 0.18, 0) * (my / mrad);
