per_frame_1=wave_r = wave_r + 0.2 * (0.9 * sin(2.753 * time) + 0.4 * sin(2.315 * time + 1));
per_frame_2=wave_g = wave_g + 0.1 * (0.9 * sin(3.183 * time + 3) + 0.4 * sin(2.006 * time + 4));
per_frame_3=wave_b = wave_b + 0.1 * (0.9 * sin(2.393 * time + 5) + 0.4 * sin(2.733 * time + 2));
per_frame_4=zoom = zoom + 0.019 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.01 * (0.6 * sin(0.691 * time) + 0.4 * sin(0.449 * time));
per_frame_6=rot = rot + 0.01 * (sin(0.834 * time + 2) + sin(1.7134 * time + 1) + sin(1.334 * time));
per_frame_7=cx = cx + 0.003 * (0.6 * sin(0.471 * time) + 0.4 * sin(0.297 * time));
per_frame_8=cy = cy + 0.003 * (0.6 * sin(0.379 * time) + 0.4 * sin(0.351 * time));
per_frame_9=dx = dx + 0.003 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.277 * time));
per_frame_10=dx = dx + 0.0025 * (sin(1.134 * time) + sin(0.7134 * time) + sin(2.334 * time));
per_frame_11=dy = dy + 0.0025 * (sin(1.8834 * time) + sin(1.0144 * time) + sin(1.334 * time));
shape_0_per_frame1=x = 0.2 + 0.006 * randint(100);
shape_0_per_frame2=y = 0.2 + 0.006 * randint(100);
shape_0_per_frame3=r = 0.01 * randint(100);
shape_0_per_frame4=g = 0.01 * randint(100);
shape_0_per_frame5=b = 0.01 * randint(100);
shape_0_per_frame6=r2 = 0.01 * randint(100);
shape_0_per_frame7=g2 = 0.01 * randint(100);
shape_0_per_frame8=b2 = 0.01 * randint(100);
shape_0_per_frame9=a = max(0, bass_att - 1.3);
shape_0_per_frame10=a2 = a;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  float tmpvar_2;
  tmpvar_2 = dot (texsize.zw, texsize.zw);
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  tmpvar_1.xyz = (max (max (texture (sampler_main, uv).xyz, texture (sampler_main, 
    ((tmpvar_3 * (1.0 - (8.0 * 
      sqrt(tmpvar_2)
    ))) + 0.5)
  ).xyz), texture (sampler_main, (
    (tmpvar_3 * (1.0 + (8.0 * sqrt(tmpvar_2))))
   + 0.5)).xyz) * 0.987);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 c_1;
  vec3 ret_2;
  ret_2 = (texture (sampler_main, uv).xyz * 0.6);
  vec3 tmpvar_3;
  tmpvar_3.z = 0.0;
  tmpvar_3.xy = texsize.zw;
  vec2 tmpvar_4;
  tmpvar_4.x = (dot (texture (sampler_main, (uv + tmpvar_3.xz)).xyz, vec3(0.32, 0.49, 0.29)) - dot (texture (sampler_main, (uv - tmpvar_3.xz)).xyz, vec3(0.32, 0.49, 0.29)));
  tmpvar_4.y = (dot (texture (sampler_main, (uv + tmpvar_3.zy)).xyz, vec3(0.32, 0.49, 0.29)) - dot (texture (sampler_main, (uv - tmpvar_3.zy)).xyz, vec3(0.32, 0.49, 0.29)));
  c_1 = ((clamp (
    ((fract((tmpvar_4 * 20.0)) - 0.5) * 999.0)
  , 0.0, 1.0) * 2.0) - 1.0);
  vec2 tmpvar_5;
  tmpvar_5 = (c_1 * (vec2(1.0, 1.0) - vec2(clamp (
    ((dot ((
      (texture (sampler_blur2, uv).xyz * scale2)
     + bias2), vec3(0.32, 0.49, 0.29)) * 30.0) - 17.0)
  , 0.0, 1.0))));
  c_1 = tmpvar_5;
  ret_2 = (ret_2 + (0.104 * tmpvar_5.x));
  ret_2 = (ret_2 + (0.104 * tmpvar_5.y));
  ret_2 = (mix (ret_2, vec3(dot (ret_2, vec3(0.32, 0.49, 0.29))), vec3(-1.0, -1.0, -1.0)) * 2.0);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_2;
  ret = tmpvar_6.xyz;
 }
