wave_0_per_point28=head = above(a, trailsize);
wave_0_per_point29=tail = 1 - head;
wave_0_per_point30=r = 1 * head + 0.5 * tail;
wave_0_per_point31=g = 0.8 * head + 0.3 * tail;
wave_0_per_point32=b = 0.5 * head;
wave_0_per_point33=a = a * 0.25;

[warp_shader]
shader_body { 
  vec2 uv_1;
