per_frame_1=vol = 8 * bass + 5 * mid + 3 * treb;
per_frame_2=m = 0.97 * m + 0.08 * vol;
per_frame_3=monitor = vol;
per_frame_4=beat = above(vol, res) * above(vol, m) * above(vol, 16);
per_frame_5=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_6=res = beat * (vol + 0.1 * m) + (1 - beat) * (res - 60 * (0.1 + 0.02 * diff) / fps);
per_frame_7=res = max(0, res);
per_frame_8=x = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, x);
per_frame_9=y = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, y);
per_frame_10=q1 = x;
per_frame_11=q2 = y;
per_frame_12=q4 = aspectx;
per_frame_13=q5 = aspecty;
per_frame_14=wave_x = q1;
per_frame_15=wave_y = 1 - q2;
per_pixel_1=cx = q1;
per_pixel_2=cy = q2;
per_pixel_3=d = pow(sqrt(sqr(x - cx) + sqr(y - cy)), 0.8);
per_pixel_4=r = 0.2;
per_pixel_5=v = 0.2;
per_pixel_6=dx = (x - cx) * v * (d - r);
per_pixel_7=dy = (y - cy) * v * (d - r);
shape_0_per_frame1=x = randint(1000) / 1000;
shape_0_per_frame2=y = randint(1000) / 1000;
shape_0_per_frame3=ang = randint(150) / 100;
