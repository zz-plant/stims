shape_1_init7=q4 = 0;
shape_1_init8=instance_counter = 0;
shape_1_per_frame1=instance_counter = 6.28 * instance / num_instance;
shape_1_per_frame2=x = q1 + 0.1 * (1 / q5) * bass_att * sin(instance_counter);
shape_1_per_frame3=y = 1 - q2 + 0.1 * (1 / q4) * bass_att * cos(instance_counter);
shape_2_init1=instance_counter = 0;
