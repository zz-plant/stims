shape_0_per_frame1=d = 1.1;
shape_0_per_frame2=zoom = 0.7;
shape_0_per_frame3=w1 = q3;
shape_0_per_frame4=w2 = q4;
shape_0_per_frame5=w3 = q5;
shape_0_per_frame6=i = instance + 0.001;
shape_0_per_frame7=my_x = mod(i / 32, 32) / 32 - 0.5;
shape_0_per_frame8=my_y = mod(i, 32) / 32 - 0.5;
shape_0_per_frame9=my_z = 0;
shape_0_per_frame10=x1 = cos(w1) * my_x + sin(w1) * my_y;
shape_0_per_frame11=y1 = -sin(w1) * my_x + cos(w1) * my_y;
shape_0_per_frame12=z1 = my_z;
shape_0_per_frame13=x2 = cos(w2) * x1 + sin(w2) * z1;
shape_0_per_frame14=z2 = -sin(w2) * x1 + cos(w2) * z1;
shape_0_per_frame15=y2 = y1;
shape_0_per_frame16=y3 = cos(w3) * y2 + sin(w3) * z2;
shape_0_per_frame17=z3 = -sin(w3) * y2 + cos(w3) * z2;
shape_0_per_frame18=x3 = x2;
shape_0_per_frame19=l = sqrt(x3 * x3 + y3 * y3);
shape_0_per_frame20=w = atan2(x3, y3);
shape_0_per_frame21=p = tan(asin(1) + atan2(d + z3, l));
shape_0_per_frame22=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_0_per_frame23=rad = rad / d;
shape_0_per_frame24=my_x = zoom * sin(w) * p;
shape_0_per_frame25=my_y = zoom * cos(w) * p;
shape_0_per_frame26=x = 0.5 + my_x;
shape_0_per_frame27=y = 0.5 + my_y;
shape_0_per_frame28=x = 0.5 + (x - 0.5) / q2;
shape_0_per_frame29=y = 0.5 + (y - 0.5) / q1;

[comp_shader]
uniform sampler2D sampler_manyfish;
 shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (texsize.zw * 4.0);
  vec2 tmpvar_2;
  tmpvar_2.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  tmpvar_2.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = mix (texture (sampler_manyfish, (uv - (tmpvar_2 * 0.4))), vec4(0.0, 0.0, 0.4, 0.0), vec4((texture (sampler_main, uv).y * 0.7))).xyz;
  ret = tmpvar_3.xyz;
 }
