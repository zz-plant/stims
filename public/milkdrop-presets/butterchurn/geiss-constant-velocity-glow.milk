[preset00]
fRating=5.000000
fGammaAdj=1.900000
nWaveMode=3.000000
bWaveThick=1.000000
fWaveScale=1.981000
fWaveSmoothing=0.900000
fWarpScale=2.853000
fZoom=1.010000
fWarp=2.635501
fWaveR=0.600000
fWaveG=0.600000
fWaveB=0.600000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_pixel_1=dx = 0.01 * cos(ang + 1.57);
per_pixel_2=dy = -0.01 * sin(ang + 1.57);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv_orig + (
    (normalize((uv - uv_orig)) * texsize.zw)
   * 2.0))).xyz * 0.98);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (abs((
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
   - texture (sampler_main, uv).xyz)) * 4.0);
  ret = tmpvar_1.xyz;
 }
