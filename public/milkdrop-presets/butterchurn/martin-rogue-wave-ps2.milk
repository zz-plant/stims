per_frame_15=q24 = is_beat;
per_frame_16=q26 = bass + mid + treb;
per_frame_17=k1 = is_beat * equal(index, 0);
per_frame_18=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_19=p2 = dec_slow * p2 + (1 - dec_slow) * p1;
per_frame_20=rott = 3.14159265359 * p2 / 2;
per_frame_21=q27 = 8 - index;
per_frame_22=q28 = index3;
per_frame_23=q29 = index4;
per_frame_24=q1 = cos(rott);
per_frame_25=q2 = sin(rott);
per_frame_26=q3 = -q2;
per_frame_27=q4 = q1;
per_frame_28=warp = 0.2 * sin(6.28 * ((index + index2) / 8));
per_pixel_1=rot = -0.04 * q2 * (1 - rad);
per_pixel_2=dx = 0;
per_pixel_3=zoom = 1.002 + 0.04 * rad;

[warp_shader]
shader_body { 
  vec2 dz_1;
  vec2 tmpvar_2;
  tmpvar_2.x = dot ((texture (sampler_main, (uv + vec2(0.002, 0.0))) - texture (sampler_main, (uv - vec2(0.002, 0.0)))), vec4(0.32, 0.49, 0.29, 0.0));
  tmpvar_2.y = dot ((texture (sampler_main, (uv + vec2(0.0, 0.002))) - texture (sampler_main, (uv - vec2(0.0, 0.002)))), vec4(0.32, 0.49, 0.29, 0.0));
  dz_1 = (sqrt(tmpvar_2) / 8.0);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ((texture (sampler_main, (
    (uv - (dz_1 * 0.01))
   + 
    ((((texture (sampler_blur1, uv).xyz * scale1) + bias1) * 0.01) * q22)
  .xy)).xyz - (
    sqrt(dot (dz_1, dz_1))
   * 0.5)) + ((0.02 * vec3(
    (dot (texture (sampler_noise_lq, uv), vec4(0.32, 0.49, 0.29, 0.0)) - 0.2)
  )) * (1.0 - rad)));
  ret = tmpvar_3.xyz;
 }

[comp_shader]
vec2 xlat_mutablers;
vec2 xlat_mutablers0;
vec2 xlat_mutableuv3;
 shader_body { 
  vec2 uv_1;
  uv_1.x = uv.x;
  float z_2;
  uv_1.y = (uv.y - 0.1);
  vec2 tmpvar_3;
