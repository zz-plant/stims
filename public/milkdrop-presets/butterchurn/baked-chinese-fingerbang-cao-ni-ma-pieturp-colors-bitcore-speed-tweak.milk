per_frame_1=wave_a = 0;
per_frame_2=bos = bass;
per_frame_3=tos = treb;
per_frame_4=cy = cx + 0.0045 * (cx / cx / (bos / tos));
per_frame_5=cx = cy + 0.005 * (cy / cy / (bos / tos));
per_frame_6=rot = 0.18 * time;
per_frame_7=dx = sin(0.2 * time);
per_frame_8=dy = 0.0009 * bass + 2 * sin(0.18 * time);
per_frame_9=decay = 1;
per_frame_10=s = 1;
per_frame_11=mt = mt + pow(bass + mid, 2);
per_frame_12=h = 0.5 * sin(0.008 * mt) + 0.5;
per_frame_13=l = 1;
per_frame_14=s = 1;
per_frame_15=cc = 6 * h;
per_frame_16=cc = if(0.00001 < abs(below(cc, 1)), 0, if(0.00001 < abs(below(cc, 2)), 1, if(0.00001 < abs(below(cc, 3)), 2, if(0.00001 < abs(below(cc, 4)), 3, if(0.00001 < abs(below(cc, 5)), 4, 5)))));
per_frame_17=zf = 6 * h - cc;
per_frame_18=zm = l;
per_frame_19=zp = l * (1 - s);
per_frame_20=zq = l * (1 - s * zf);
per_frame_21=zt = l * (1 - s * (1 - zf));
per_frame_22=rr = if(0.00001 < abs(equal(cc, 0)), zm, if(0.00001 < abs(equal(cc, 1)), zq, if(0.00001 < abs(equal(cc, 2)), zp, if(0.00001 < abs(equal(cc, 3)), zp, if(0.00001 < abs(equal(cc, 4)), zt, zm)))));
per_frame_23=gg = if(0.00001 < abs(equal(cc, 0)), zt, if(0.00001 < abs(equal(cc, 1)), zm, if(0.00001 < abs(equal(cc, 2)), zm, if(0.00001 < abs(equal(cc, 3)), zq, exec2(equal(cc, 4), zp)))));
per_frame_24=bb = if(0.00001 < abs(equal(cc, 0)), zp, if(0.00001 < abs(equal(cc, 1)), zp, if(0.00001 < abs(equal(cc, 2)), zt, if(0.00001 < abs(equal(cc, 3)), zm, if(0.00001 < abs(equal(cc, 4)), zm, zq)))));
per_frame_25=rr = if(0.00001 < abs(equal(s, 0)), l, rr);
per_frame_26=gg = if(0.00001 < abs(equal(s, 0)), l, gg);
per_frame_27=bb = if(0.00001 < abs(equal(s, 0)), l, bb);
per_frame_28=ob_r = rr;
per_frame_29=ob_g = gg;
per_frame_30=ob_b = bb;
per_frame_31=ib_r = abs(rr - 0.25);
per_frame_32=ib_g = abs(gg - 0.25);
per_frame_33=ib_b = abs(bb - 0.25);
per_frame_34=zoom = 0.905;
per_frame_35=warp = 0.905 * (1 - 0.01 * bass);
