shape_0_per_frame1=xi = xi - dx * q22 / 200;
shape_0_per_frame2=yi = yi - dy * q23 / 200;
shape_0_per_frame3=low = 0;
shape_0_per_frame4=high = 1;
shape_0_per_frame5=k0x = below(xi, low);
shape_0_per_frame6=k1x = above(xi, high);
shape_0_per_frame7=k0y = below(yi, low);
shape_0_per_frame8=k1y = above(yi, high);
shape_0_per_frame9=dx = 1 * k0x + -1 * k1x;
shape_0_per_frame10=dy = 1 * k0y + -1 * k1y;
shape_0_per_frame11=x = xi;
shape_0_per_frame12=y = yi;
shape_0_per_frame13=trel = time / 2 + q20;
shape_0_per_frame14=x = 0.5 + sin(2 * trel);
shape_0_per_frame15=y = 0.5 + cos(1.3 * trel + q28 / 3);
shape_0_per_frame16=a = q26 / 4 + 0.2;
shape_2_init1=q21 = 0;
shape_2_per_frame1=x = randint(10) / 10;
shape_2_per_frame2=y = randint(10) / 10;
shape_2_per_frame3=r = randint(4) / 3;
shape_2_per_frame4=g = randint(4) / 3;
shape_2_per_frame5=b = randint(4) / 3;
shape_2_per_frame6=a = min(q21 / 2, 0.9);
shape_2_per_frame7=rad = a * a / 3;

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = ((uv * texsize.xy) * 0.08);
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_main, (uv - (
    ((sin(tmpvar_1) / cos(tmpvar_1)) * texsize.zw)
   * 3.0))).xyz + (vec3(dot (texture (sampler_noise_lq, 
    ((((texsize.xy * texsize_noise_lq.zw).x * uv) * 0.02) + (0.1 * rand_frame).xy)
  ), vec4(0.32, 0.49, 0.29, 0.0))) / 30.0));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ((mix (tmpvar_2, 
    (1.0 - tmpvar_2.zyx)
  , vec3(0.01, 0.01, 0.01)) - 0.03) - (0.2 * pow (
    (1.0 - rad)
  , 18.0)));
  ret = tmpvar_3.xyz;
 }

[comp_shader]
vec2 xlat_mutabledz;
vec2 xlat_mutableuv3;
 shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.y = 0.0;
  tmpvar_1.x = texsize.z;
  vec2 tmpvar_2;
  tmpvar_2.x = 0.0;
  tmpvar_2.y = texsize.w;
  vec2 tmpvar_3;
  tmpvar_3.x = ((uv.x - 0.5) + 0.5);
  tmpvar_3.y = uv.y;
  xlat_mutabledz.x = dot ((texture (sampler_main, (tmpvar_3 + tmpvar_1)).xyz - texture (sampler_main, (tmpvar_3 - tmpvar_1)).xyz), vec3(0.32, 0.49, 0.29));
  xlat_mutabledz.y = dot ((texture (sampler_main, (tmpvar_3 + tmpvar_2)).xyz - texture (sampler_main, (tmpvar_3 - tmpvar_2)).xyz), vec3(0.32, 0.49, 0.29));
  xlat_mutableuv3 = ((0.4 * cos(
    (42.0 * uv3)
  )) + (64.0 * xlat_mutabledz));
  float tmpvar_4;
  tmpvar_4 = clamp ((0.01 / sqrt(
    dot (xlat_mutableuv3, xlat_mutableuv3)
  )), 0.0, 1.0);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = (clamp ((
    (12.0 * ((texture (sampler_main, (tmpvar_3 + 
      (0.2 * xlat_mutabledz)
    )).xyz - (q1 * xlat_mutabledz.y)) + 0.04))
   * 
    (0.1 + max (vec3(0.0, 0.0, 0.0), ((
      (0.1 * vec3(tmpvar_4))
     + 
      (0.9 * dot (vec3(tmpvar_4), vec3(0.32, 0.49, 0.29)))
    ) * 1.252262)))
  ), 0.0, 1.0) - 0.05);
  ret = tmpvar_5.xyz;
 }
