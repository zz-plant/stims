[preset00]
fRating=0.000000
fDecay=0.960000
fVideoEchoZoom=0.999836
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=1.000000
fWaveScale=0.010000
fWaveParam=0.500100
fZoom=0.999900
fRot=0.100000
fWaveR=0.500000
