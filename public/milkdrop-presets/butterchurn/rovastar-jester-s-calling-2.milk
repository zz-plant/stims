fWaveB=0.500000
fOuterBorderSize=0.000000
fOuterBorderA=0.500000
fInnerBorderSize=0.005000
fInnerBorderR=0.500000
fInnerBorderG=0.500000
fInnerBorderB=0.500000
fInnerBorderA=0.300000
nMotionVectorsLoop=5.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xpos = 0;
per_frame_init_2=yamptarg = 0;
per_frame_init_3=ydir = 0;
per_frame_init_4=meanbass_att = 0;
per_frame_init_5=q6 = 0;
per_frame_init_6=old_eff_size = 0;
per_frame_init_7=q1 = 0;
per_frame_init_8=q5 = 0;
per_frame_init_9=lastbeat = 0;
per_frame_init_10=beatrate = 0;
per_frame_init_11=peakbass_att = 0;
per_frame_init_12=xamptarg = 0;
per_frame_init_13=xamp = 0;
per_frame_init_14=xspeed = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=eff_test = 0;
per_frame_init_17=ypos = 0;
per_frame_init_18=volume = 0;
per_frame_init_19=beat = 0;
per_frame_init_20=vol = 0;
per_frame_init_21=q2 = 0;
per_frame_init_22=yamp = 0;
per_frame_init_23=q3 = 0;
per_frame_init_24=eff_size = 0;
per_frame_init_25=q7 = 0;
per_frame_init_26=xdir = 0;
per_frame_init_27=q8 = 0;
per_frame_init_28=yspeed = 0;
per_frame_init_29=eff_test = 1;
per_frame_init_30=eff_size = 400;
per_frame_1=warp = 0;
per_frame_2=vol = 0.167 * (bass + mid);
per_frame_3=xamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.5 * vol * bass_att, 0.5), xamptarg);
per_frame_4=xamp = xamp + 0.5 * (xamptarg - xamp);
per_frame_5=xdir = if(0.00001 < abs(above(abs(xpos), xamp)), -sign(xpos), if(0.00001 < abs(below(abs(xspeed), 0.1)), 2 * above(xpos, 0) - 1, xdir));
per_frame_6=xspeed = xspeed + xdir * xamp - xpos - 0.055 * xspeed * below(abs(xpos), xamp);
per_frame_7=xpos = xpos + 0.001 * xspeed;
per_frame_8=yamptarg = if(0.00001 < abs(equal(mod(frame, 15), 0)), min(0.3 * vol * treb_att, 0.5), yamptarg);
per_frame_9=yamp = yamp + 0.5 * (yamptarg - yamp);
per_frame_10=ydir = if(0.00001 < abs(above(abs(ypos), yamp)), -sign(ypos), if(0.00001 < abs(below(abs(yspeed), 0.1)), 2 * above(ypos, 0) - 1, ydir));
per_frame_11=yspeed = yspeed + ydir * yamp - ypos - 0.055 * yspeed * below(abs(ypos), yamp);
per_frame_12=ypos = ypos + 0.001 * yspeed;
per_frame_13=ib_r = ib_r + 2 * sin(4.132 * time) * xpos;
per_frame_14=ib_b = ib_b + 2 * sin(4.042 * time) * ypos;
per_frame_15=ib_g = ib_g + 0.3 * sin(0.631 * time);
per_frame_16=ob_g = beat * treb * 0.5;
per_frame_17=ob_a = 0.5 + 0.5 * beat;
per_frame_18=ob_size = ob_size + 0.01 * beat;
per_frame_19=mv_dx = 0.15 * xpos;
per_frame_20=mv_dy = 0.15 * ypos;
per_frame_21=mv_l = 0.15;
per_frame_22=mv_r = 1 - ib_r;
per_frame_23=mv_b = 1 - ib_g;
per_frame_24=mv_g = 1 - ib_b;
per_frame_25=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_26=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_27=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_28=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_29=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_30=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_31=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_32=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_33=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_34=peakbass_att = max(if(0.00001 < abs(beat), bass_att, peakbass_att), 1.1 * meanbass_att);
per_frame_35=eff_test = if(0.00001 < abs(below(200 * eff_size, 500)), 1, 0);
per_frame_36=eff_size = if(0.00001 < abs(beat), 2.5 * eff_test + 0.0025 * randint(500), old_eff_size);
per_frame_37=old_eff_size = eff_size;
per_frame_38=q5 = eff_size;
per_frame_39=mv_l = if(0.00001 < abs(eff_test), 3 * q5, mv_l);
per_frame_40=q6 = 3 * xpos;
per_frame_41=q4 = 3 * ypos;
per_frame_42=decay = decay + if(0.00001 < abs(eff_test), 0, 0.04);
per_frame_43=wave_r = 1 - ib_g;
per_frame_44=wave_g = 1 - ib_b;
per_frame_45=wave_b = 1 - ib_b;
per_pixel_1=q1 = 0.4 * rad;
per_pixel_2=q2 = 0.3 * rad;
per_pixel_3=q3 = below(rad, 0.1 * q5 + 0.3);
per_pixel_4=q7 = if(0.00001 < abs(q3), 0, 10 + floor(1 * rad));
per_pixel_5=q8 = if(0.00001 < abs(q3), 0, 10 + floor(1 * rad));
per_pixel_6=cx = if(0.00001 < abs(q3), 0.5, band(0, x * q7 - q1) * (1 / q7) + 0.1 * q1);
per_pixel_7=cy = if(0.00001 < abs(q3), 0.5, band(0, y * q8 - q2) * (1 / q8) + 0.1 * q2);
per_pixel_8=rot = if(0.00001 < abs(q3), 2 * q6 * rad, 0.1 * rad + 0.1 * bass + 0 * cx * cy);
per_pixel_9=zoom = if(0.00001 < abs(q3), 0.3 + 0.1 * q5 + 0.5 * q4, zoom);
