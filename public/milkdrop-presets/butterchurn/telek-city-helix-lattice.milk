per_frame_init_1=warp = 0;
per_frame_init_2=zoom = 1;
per_frame_init_3=rot = 0.01;
per_frame_1=wave_b = if(0.00001 < abs(below(treb, 2)), 1, 0);
per_frame_2=decay = if(0.00001 < abs(equal(mod(frame, 20), 0)), 0.99, 1);
per_frame_3=dx = if(0.00001 < abs(equal(mod(frame, 100), 0)), 0.001, 0);
per_frame_4=rot = 0.05 * cos(0.4 * time);
per_frame_5=wave_x = (wave_x - 0.45) * sin(0.4 * time) + wave_x;
per_frame_6=wave_y = (wave_y - 0.45) * sin(0.4 * time) + wave_y;
per_frame_7=zoom = 1 - 0.05 * cos(0.4 * time);
per_frame_8=wave_x = 0.5 + (wave_x - 0.5) * cos(5 * time);
per_frame_9=wave_y = 0.5 + (wave_y - 0.5) * sin(5 * time);
per_frame_10=ib_a = -0.5 * cos(0.4 * time) + 0.5;
per_frame_11=ob_a = ib_a;
