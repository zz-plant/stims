per_frame_init_1=new_mid = 0;
per_frame_init_2=myzoomexp = 0;
per_frame_init_3=treb_effect = 0;
per_frame_init_4=new_bass_thresh = 0;
per_frame_init_5=q6 = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=treb_thresh = 0;
per_frame_init_10=vol_att = 0;
per_frame_init_11=box = 0;
per_frame_init_12=mid_thresh = 0;
per_frame_init_13=bass_effect = 0;
per_frame_init_14=new_treb = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=a = 0;
per_frame_init_17=vol_thresh = 0;
per_frame_init_18=vol_effect = 0;
per_frame_init_19=myzoom = 0;
per_frame_init_20=b = 0;
per_frame_init_21=r = 0;
per_frame_init_22=mid_mid_att = 0;
per_frame_init_23=new_treb_thresh = 0;
per_frame_init_24=g = 0;
per_frame_init_25=new_bass = 0;
per_frame_init_26=q2 = 0;
per_frame_init_27=new_vol = 0;
per_frame_init_28=new_mid_thresh = 0;
per_frame_init_29=react = 0;
per_frame_init_30=q3 = 0;
per_frame_init_31=q7 = 0;
per_frame_init_32=mid_effect = 0;
per_frame_init_33=change = 0;
per_frame_init_34=q8 = 0;
per_frame_1=vol_att = bass_att + treb_att + mid_att;
per_frame_2=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_3=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_4=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_5=vol_thresh = bass_thresh + treb_thresh + mid_thresh;
per_frame_6=new_bass_thresh = bass_thresh + bass_effect - 0.2 * sin(bass_thresh - new_bass_thresh + 1);
per_frame_7=new_treb_thresh = treb_thresh + treb_effect - 0.2 * sin(treb_thresh - new_treb_thresh + 1);
per_frame_8=new_mid_thresh = mid_thresh + mid_effect - 0.2 * sin(mid_thresh - new_mid_thresh + 1);
per_frame_9=treb_effect = max(max(treb, treb_att), treb_thresh);
per_frame_10=bass_effect = max(max(bass, bass_att), bass_thresh);
per_frame_11=mid_effect = max(max(mid, mid_att), mid_thresh);
per_frame_12=vol_effect = bass_effect + treb_effect + mid_effect;
per_frame_13=react = if(0.00001 < abs(equal(new_vol, change)), 1, 0);
per_frame_14=new_bass = if(0.00001 < abs(above(react, bass_effect)), bass_thresh, new_bass_thresh);
per_frame_15=new_treb = if(0.00001 < abs(above(react, treb_effect)), treb_thresh, new_treb_thresh);
per_frame_16=new_mid = if(0.00001 < abs(above(react, mid_effect)), mid_thresh, new_mid_thresh);
per_frame_17=new_vol = new_bass + new_treb + new_mid + 0.04;
per_frame_18=change = bnot(1);
per_frame_19=q1 = new_bass;
per_frame_20=q2 = new_treb;
per_frame_21=q3 = new_mid;
per_frame_22=q4 = new_vol;
per_frame_23=q5 = if(0.00001 < abs(above(q2, q3)), above(q1, q3), -above(q1, q3));
per_frame_24=q6 = if(0.00001 < abs(above(q1, q3)), above(q2, q4), -above(q2, q3));
per_frame_25=q7 = if(0.00001 < abs(above(q5, q6)), q5, -q6);
per_frame_26=q8 = if(0.00001 < abs(above(q6, q7)), q6, -q7);
per_frame_27=r = 0.2 * sin(0.13 * time);
per_frame_28=b = 0.3 * sin(q1 - 0.12 * time);
per_frame_29=g = 0.6 * sin(0.64 * time - 0.2);
per_frame_30=wave_b = g;
per_frame_31=wave_r = r;
per_frame_32=wave_g = b;
per_frame_33=ob_r = r + 0.3;
per_frame_34=ob_b = b + 0.3;
per_frame_35=ob_g = g - 0.3;
per_pixel_1=rot = if(0.00001 < abs(above(q1, q2)), rot + 0.2 * sin(q1 - q2 * rad * 0.25), 0) * if(0.00001 < abs(above(rad, x)), rad - 0.25 * x, rad);
per_pixel_2=box = if(0.00001 < abs(above(q1, q3)), band(rad, rad + 0.2 - x - 0.25 * y * sin(q3)), band(rad, rad - 0.4));
per_pixel_3=myzoomexp = if(0.00001 < abs(above(q1, q2)), box * box * rad * 5, box);
per_pixel_4=myzoom = if(0.00001 < abs(above(q1, q2)), if(0.00001 < abs(above(q2, q3)), 1 - y + 0.3 * sin(q1) + 0.3, zoom - 0.2), 1);
per_pixel_5=a = if(0.00001 < abs(above(q3, q2)), pow(myzoom - x, pow(myzoomexp, 2 * rad - 0.22 - box - x + 0.2 * sin(q1 - q3))) + 0.05, 1);
per_pixel_6=dx = (x - 0.5) * a + 0.5 - x + box;
per_pixel_7=dy = (y - 0.5) * a + 0.5 - y + box;
