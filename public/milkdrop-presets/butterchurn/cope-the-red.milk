per_frame_15=q17 = -0.01 * sin(0.254 * time);
per_frame_16=q2 = bass_thresh;
per_frame_17=vol = 0.25 * (bass + mid + treb);
per_frame_18=vol = vol * vol;
per_frame_19=q3 = vol;
per_frame_20=mtime = mtime + 0.01 * vol;
per_frame_21=q2 = 0.25 * mtime;
per_frame_22=wave_x = wave_x + 0.5 * sin(mtime);
per_frame_23=wave_y = wave_y - 0.5 * cos(1.4 * mtime);
shape_0_init1=q3 = 0;
shape_0_per_frame1=rad = rad + 0.1 * q3;

[warp_shader]
shader_body { 
  vec3 noise2_1;
  vec3 ret_2;
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur2, uv).xyz * scale2) + bias2) + texture (sampler_main, uv).xyz);
  vec2 tmpvar_4;
  tmpvar_4 = (0.5 + ((uv - 0.5) * (1.0 + 
    (tmpvar_3.y * 0.05)
  )));
  vec2 tmpvar_5;
  tmpvar_5.x = (tmpvar_4.x + pow (tmpvar_3.x, q17));
  tmpvar_5.y = (tmpvar_4.y + pow (tmpvar_3.x, q18));
  vec4 tmpvar_6;
  tmpvar_6 = texture (sampler_fc_main, fract(tmpvar_5));
  vec3 tmpvar_7;
  tmpvar_7.x = q8;
  tmpvar_7.y = q7;
  tmpvar_7.z = q6;
  vec3 tmpvar_8;
  tmpvar_8.x = q10;
  tmpvar_8.y = q11;
  tmpvar_8.z = q12;
  noise2_1 = (texture (sampler_noise_lq, ((
    (uv_orig * texsize.xy)
   * texsize_noise_lq.zw) + rand_frame.xy)).xyz + mix (tmpvar_7, tmpvar_8, vec3(rad)));
  vec3 a_9;
  a_9 = (1.0 - tmpvar_6.xyz);
  ret_2 = (tmpvar_6.xyz + (0.3 * clamp (
    ((a_9.yzx * noise2_1.zxy) - (a_9.zxy * noise2_1.yzx))
  , 0.0, 1.0)));
  ret_2 = (ret_2 * 0.97);
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = ret_2;
  ret = tmpvar_10.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * vec3(0.8, 0.2, 0.4));
  ret_1 = (ret_1 * 1.14);
  ret_1 = (ret_1 * ret_1);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
