per_frame_init_13=ypos = 0;
per_frame_1=decay = 1;
per_frame_2=vol = 0.25 * (bass + mid + treb);
per_frame_3=vol = vol * vol;
per_frame_4=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_5=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_6=musictime = musictime + vol;
per_frame_7=q4 = 0;
per_frame_8=q5 = 0;
per_frame_9=dx = 0.07 * sin(0.1 * musictime);
per_frame_10=dy = 0.07 * cos(0.069 * musictime);
per_frame_11=q1 = 0.4 * sin(0.001 * musictime) + 0.5;
per_frame_12=q2 = 0.5 * cos(0.001 * musictime) + 0.5;
per_frame_13=q8 = musictime;
per_frame_14=monitor = rot;
per_pixel_1=rd = sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5))) + 0.001;
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=cx = 0.07 * sin(113.04 * (ang - 0.5) * q1 + q8time) + 0.5;
per_pixel_5=cy = 0.07 * cos(113.04 * (rad - 0.5) * q2 + q8time) + 0.5;
per_pixel_6=zoom = 1;
per_pixel_7=zm = pow(rd, sin(q8) + 3.5) / 10.5 + 0.5;
per_pixel_8=zm = zm * 5;
per_pixel_9=sx = zm;
per_pixel_10=sy = zm;
