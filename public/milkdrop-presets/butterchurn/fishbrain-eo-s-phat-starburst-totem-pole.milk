per_frame_init_8=rd = 0;
per_frame_init_9=qx = 0;
per_frame_1=decay = 0.99;
per_frame_2=zoom = 1;
per_frame_3=basstime = basstime + bass_att * bass_att * 0.02;
per_frame_4=midtime = midtime + mid_att * mid_att * 0.01;
per_frame_5=qx = 0.2 * sin(0.2 * basstime);
per_frame_6=cx = 0.5 + qx;
per_frame_7=q4 = qx;
per_frame_8=qy = 0.2 * sin(0.2 * midtime);
per_frame_9=cy = 0.5 - qy;
per_frame_10=q5 = qy;
per_frame_11=monitor = q4;
per_pixel_1=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_2=var = tan(rd * (1 + bass));
per_pixel_3=var = var * var;
per_pixel_4=zm = 1 + 0.001 * var * rd;
per_pixel_5=zm = zm * 1.003;
per_pixel_6=sx = zm;
per_pixel_7=sy = zm;
per_pixel_8=sx = 1.005;
wave_0_init1=typ1 = 0;
wave_0_init2=q5 = 0;
wave_0_init3=txp2 = 0;
wave_0_init4=v = 0;
wave_0_init5=tri_point = 0;
wave_0_init6=zero = 0;
wave_0_init7=q4 = 0;
