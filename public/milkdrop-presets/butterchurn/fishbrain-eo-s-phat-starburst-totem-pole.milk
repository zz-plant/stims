wave_0_init9=txp1 = 0;
wave_0_init10=t_x = 0;
wave_0_init11=typ2 = 0;
wave_0_per_point1=zero = zero + 1;
wave_0_per_point2=zero = if(0.00001 < abs(above(zero, 1)), 0, zero);
wave_0_per_point3=tri_point = randint(3);
wave_0_per_point4=txp1 = 0;
wave_0_per_point5=txp2 = 1;
wave_0_per_point6=typ1 = 0.2;
wave_0_per_point7=typ2 = 0.2;
wave_0_per_point8=t_x = t_x + 0.5 * equal(tri_point, 0) * (0.5 - t_x);
wave_0_per_point9=t_y = t_y + 0.5 * equal(tri_point, 0) * (0.8 - t_y);
wave_0_per_point10=t_x = t_x + 0.5 * equal(tri_point, 1) * (txp1 - t_x);
wave_0_per_point11=t_y = t_y + 0.5 * equal(tri_point, 1) * (typ1 - t_y);
wave_0_per_point12=t_x = t_x + 0.5 * equal(tri_point, 2) * (txp2 - t_x);
wave_0_per_point13=t_y = t_y + 0.5 * equal(tri_point, 2) * (typ2 - t_y);
wave_0_per_point14=x = 0.55 * (t_x - 0.5) + 0.5 + q4;
wave_0_per_point15=y = t_y + q5 + 0.1;
wave_0_per_point16=x = if(0.00001 < abs(zero), 0.5, x);
wave_0_per_point17=y = if(0.00001 < abs(zero), 0.5, y);
wave_0_per_point18=v = min(bass * bass * 0.78, 1);
wave_0_per_point19=r = v;
wave_0_per_point20=g = v;
wave_0_per_point21=b = v;
wave_0_per_point22=a = 0.01;
