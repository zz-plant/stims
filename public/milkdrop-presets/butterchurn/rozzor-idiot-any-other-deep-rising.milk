per_frame_init_1=ying = 0;
per_frame_init_2=vol_now = 0;
per_frame_init_3=redneg = 0;
per_frame_init_4=yin = 0;
per_frame_init_5=yang = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=slowtime = 0;
per_frame_init_8=q5 = 0;
per_frame_init_9=new_x = 0;
per_frame_init_10=blueneg = 0;
per_frame_init_11=greenneg = 0;
per_frame_init_12=solipsist = 0;
per_frame_init_13=beat = 0;
per_frame_init_14=new_y = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=beatcount = 0;
per_frame_init_17=q3 = 0;
per_frame_init_18=vol_mean = 0;
per_frame_init_19=warp = 0;
per_frame_init_20=beatcount = 0;
per_frame_1=slowtime = slowtime + beat * time;
per_frame_2=ying = if(0.00001 < abs(below(ying, 1)), 1, ying);
per_frame_3=ying = if(0.00001 < abs(beat), ying + bnot(mod(10 * time, 3)), ying);
per_frame_4=yin = mod(ying, 2);
per_frame_5=vol_now = 0.4 * bass + 0.1 * (bass_att + treb + mid);
per_frame_6=vol_mean = if(0.00001 < abs(equal(mod(frame, 50), 0)), vol_mean - 0.5 * (vol_mean - vol_now), 0.1 * (9 * vol_mean + vol_now));
per_frame_7=beat = if(0.00001 < abs(above(vol_now, 1.5 * vol_mean)), 1, 0);
per_frame_8=beatcount = if(0.00001 < abs(bnot(mod(time, 5000))), 0, beatcount);
per_frame_9=beatcount = beatcount + 0.05 * beat;
per_frame_10=yang = bnot(mod(beatcount, 2));
per_frame_11=ib_r = 0;
per_frame_12=ib_g = pow(abs(sign(sin(slowtime))), 2) * sin(slowtime);
per_frame_13=ib_b = cos(slowtime) * sign(cos(slowtime)) * pow(abs(sign(sin(slowtime))), 2);
per_frame_14=mv_g = sin(slowtime) * (sign(sin(slowtime)) - 1) * sign(sin(slowtime));
per_frame_15=mv_b = -1 * abs(cos(slowtime)) + 1;
per_frame_16=mv_r = 0.8;
per_frame_17=redneg = if(0.00001 < abs(below(ib_r, 0)), 1, 0);
per_frame_18=greenneg = if(0.00001 < abs(below(ib_g, 0)), 1, 0);
per_frame_19=blueneg = if(0.00001 < abs(below(ib_b, 0)), 1, 0);
per_frame_20=wave_r = if(0.00001 < abs(redneg), if(0.00001 < abs(bor(greenneg, blueneg)), 1, 1 + ib_r), ib_r);
per_frame_21=wave_g = if(0.00001 < abs(greenneg), if(0.00001 < abs(equal(greenneg + blueneg, 2)), 1, 1 + ib_g), ib_g);
per_frame_22=wave_b = if(0.00001 < abs(blueneg), 1 + ib_b, ib_b);
per_frame_23=q1 = if(0.00001 < abs(yin), sin(slowtime), q1);
per_frame_24=q2 = if(0.00001 < abs(yin), cos(slowtime), 0);
per_frame_25=q3 = sin(beatcount);
per_frame_26=dx = if(0.00001 < abs(yin), 0.01 * sin(slowtime), if(0.00001 < abs(equal(yin, yang)), 0, dx));
per_frame_27=dy = if(0.00001 < abs(yin), 0.01 * cos(slowtime), 0);
per_frame_28=q5 = if(0.00001 < abs(bnot(yin)), abs(cos(time)), dx);
per_frame_29=wave_mystery = wave_mystery - sin(0.65 * time * sin(q3));
per_frame_30=wave_mode = randint(mod(slowtime, 12));
per_pixel_1=solipsist = if(0.00001 < abs(equal(q3, 0)), 0, 0.01 * (rad - q3 * x + pow(q3, 4) * y));
per_pixel_2=rot = rot + sin(rad) - 5 * solipsist - 1.5 * q5;
per_pixel_3=sy = if(0.00001 < abs(equal(q3, 0)), sy, 1 - solipsist);
per_pixel_4=new_x = 0.05 * rad - x;
per_pixel_5=new_y = 0.05 * rad - y;
per_pixel_6=zoom = zoom + 0.01 * sin(ang - 3.14 * rad * sin(if(0.00001 < abs(above(q2, q1)), 0.5, -0.5) * sin(new_x * new_y))) * sin(if(0.00001 < abs(above(q3, q1)), 0.5, -0.5)) - 0.03 * sin(5 * ang - rad * sin(if(0.00001 < abs(above(q3, q2)), 0.5, -0.5)));
