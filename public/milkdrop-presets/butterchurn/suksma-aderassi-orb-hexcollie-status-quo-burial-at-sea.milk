per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q2 = 0;
per_frame_init_6=q3 = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=ob_r = wave_r;
per_frame_6=ob_g = wave_g;
per_frame_7=ob_b = wave_b;
per_frame_8=wave_x = wave_x + 0.21 * above(bass_att, 0.1) * sin(6.1 * time);
per_frame_9=wave_y = wave_y + 0.21 * above(bass_att, 0.1) * cos(6.1 * time);
per_frame_10=q1 = wave_r;
per_frame_11=q2 = wave_g;
per_frame_12=q3 = wave_b;
per_frame_13=mv_r = 1 - abs(wave_r);
per_frame_14=mv_g = 1 - abs(wave_g);
per_frame_15=mv_b = 1 - abs(wave_b);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom - 0.01;
per_pixel_5=dx = dx - dy_r * above(bass_att, 1.1) * 5.62 * (0.5 - rad * sin(time) * x) * tan(14 * time);
per_pixel_6=dy = dy - dx_r * above(bass_att, 1.1) * 5.62 * (0.5 - rad * cos(time) * y) * tan(14 * time);
per_pixel_7=dx = dx + dx_r * above(mid_att, 1) * 0.41 * tan(24 * time);
per_pixel_8=dy = dy + dy_r * above(mid_att, 1) * 0.41 * tan(24 * time);
per_pixel_9=rot = rot + 2.41 * above(treb_att, 1.2) * tan(42 * time);
per_pixel_10=zoom = zoom + 0.21 * above(bass_att, 1.2) * tan(12 * time);
shape_0_per_frame1=ang = 3 + 3.62 * cos(0.73 * time);
shape_1_init1=thresh = 0;
shape_1_init2=thresh = 0;
shape_1_init3=thresh = 0;
