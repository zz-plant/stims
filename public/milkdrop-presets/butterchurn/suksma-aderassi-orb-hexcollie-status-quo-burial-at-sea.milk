shape_1_init37=q3 = 0;
shape_1_per_frame1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
shape_1_per_frame2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
shape_1_per_frame3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
shape_1_per_frame4=tg1 = abs(sin(time));
shape_1_per_frame5=tg2 = 0.25 * sin(time) * above(tg1, 0.8) - 0.25 * cos(time) * below(tg1, 0.2) + 0.33 * sin(time) * above(tg1, 0.2) * below(tg1, 0.4) - 0.33 * cos(time) * above(tg1, 0.4) * below(tg1, 0.6) + 0 * below(tg1, 0.8) * above(tg1, 0.6);
shape_1_per_frame6=tg3 = if(0.00001 < abs(above(thresh, 1.3)), tg2, tg3);
shape_1_per_frame7=x = x + 42 * dy_r * tg3;
shape_1_per_frame8=y = y + 42 * dx_r * tg3;
shape_1_per_frame9=ang = 0.6 * q4 + 0.4;
shape_1_per_frame10=r = q1;
shape_1_per_frame11=g = q2;
shape_1_per_frame12=b = 1 - abs(q3);
shape_1_per_frame13=r2 = q2;
shape_1_per_frame14=g2 = q1;
shape_1_per_frame15=b2 = q3;

[warp_shader]
shader_body { 
  float final_noise_1;
  vec3 tmpvar_2;
  tmpvar_2.xy = uv;
  tmpvar_2.z = (q2 * 10.0);
  final_noise_1 = ((texture (sampler_noisevol_hq, tmpvar_2) * 2.0) - 1.0).x;
  final_noise_1 = (final_noise_1 + (0.5 * (
    (texture (sampler_noisevol_hq, (tmpvar_2 * 2.0)) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.25 * (
    (texture (sampler_noisevol_hq, (tmpvar_2 * 4.0)) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.125 * (
    (texture (sampler_noisevol_hq, (tmpvar_2 * 8.0)) * 2.0)
   - 1.0)).x);
  final_noise_1 = ((final_noise_1 + 1.0) * 0.5);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (texture (sampler_main, ((
    ((uv - 0.5) * final_noise_1)
   * 2.0) + 0.5)).xyz - 0.1);
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur2, uv_1).xyz * scale2) + bias2)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 0.85);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
