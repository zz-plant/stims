per_frame_init_1=ib_ = 0;
per_frame_init_2=bass_residual = 0;
per_frame_init_3=gridx = 0;
per_frame_init_4=old_treb_flop = 0;
per_frame_init_5=bass_flop = 0;
per_frame_init_6=fleem = 0;
per_frame_init_7=q6 = 0;
per_frame_init_8=q1 = 0;
per_frame_init_9=q5 = 0;
per_frame_init_10=treb_flop = 0;
per_frame_init_11=bass_thresh = 0;
per_frame_init_12=old_bass_flop = 0;
per_frame_init_13=treb_thresh = 0;
per_frame_init_14=pulse = 0;
per_frame_init_15=bass_changed = 0;
per_frame_init_16=mid_thresh = 0;
per_frame_init_17=q4 = 0;
per_frame_init_18=mid_changed = 0;
per_frame_init_19=entropy = 0;
per_frame_init_20=c2 = 0;
per_frame_init_21=old_mid_flop = 0;
per_frame_init_22=mid_residual = 0;
per_frame_init_23=checkx = 0;
per_frame_init_24=c3 = 0;
per_frame_init_25=treb_residual = 0;
per_frame_init_26=chaos = 0;
per_frame_init_27=mid_flop = 0;
per_frame_init_28=q2 = 0;
per_frame_init_29=gridy = 0;
per_frame_init_30=treb_changed = 0;
per_frame_init_31=q3 = 0;
per_frame_init_32=radix = 0;
per_frame_init_33=q7 = 0;
per_frame_init_34=c1 = 0;
per_frame_init_35=checky = 0;
per_frame_init_36=q8 = 0;
per_frame_1=old_bass_flop = bass_flop;
per_frame_2=old_treb_flop = treb_flop;
per_frame_3=old_mid_flop = mid_flop;
per_frame_4=chaos = 0.5 + 0.5 * sin(pulse);
per_frame_5=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.6) * chaos + 1.6);
per_frame_6=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_7=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.6) * chaos + 1.6);
per_frame_8=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_9=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.6) * chaos + 1.6);
per_frame_10=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_11=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_12=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_13=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_14=bass_residual = bass_changed * sin(3 * pulse) + bnot(bass_changed) * bass_residual;
per_frame_15=treb_residual = treb_changed * sin(3 * pulse) + bnot(treb_changed) * treb_residual;
per_frame_16=mid_residual = mid_changed * sin(3 * pulse) + bnot(mid_changed) * mid_residual;
per_frame_17=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.005 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_18=entropy = if(0.00001 < abs(bass_changed * mid_changed * treb_changed), (1 + bass_flop + treb_flop + mid_flop) * (1 + randint(3)), entropy);
per_frame_19=q1 = mid_residual;
per_frame_20=q2 = bass_residual;
per_frame_21=q3 = treb_residual;
per_frame_22=q4 = sin(pulse);
per_frame_23=q5 = cos(pulse * (0.5 + 0.1 * entropy));
per_frame_24=q6 = sin(pulse * (0.5 + pow(0.25, entropy)));
per_frame_25=q7 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_26=q8 = entropy;
per_frame_27=wave_r = 0.5 + 0.5 * q1;
per_frame_28=wave_b = 0.5 + 0.5 * q2;
per_frame_29=wave_g = 0.5 + 0.5 * q3;
per_frame_30=ob_r = ob_r + ob_r * sin(q1 + 2.18 * time);
per_frame_31=ob_b = ob_b + ob_b * sin(q2 + 1.73 * time);
per_frame_32=ob_g = ob_g + ob_g * sin(q3 + 2.09 * time);
per_frame_33=ib_r = ib_r + ib_r * cos(q4 + 2.14 * q1);
per_frame_34=ib_b = ib_b + ib_ * cos(q4 + 2.14 * q2);
per_frame_35=ib_g = ib_g + ib_g * cos(q4 + 2.14 * q3);
per_frame_36=ob_a = 0.25 + 0.25 * sin(q2 + 2.14 * q3);
per_frame_37=ib_a = 0.5 + 0.5 * sin(2.14 * q2 + q3);
per_frame_38=ob_size = 0.1 + 0.1 * sin(3 * q3 + q1);
per_frame_39=ib_size = 0.1 + 0.1 * sin(3 * q1 + q3);
per_frame_40=wave_mystery = 0.5 * q6;
per_frame_41=warp = 0;
per_frame_42=wave_x = wave_x + 0.04 * sin(2.8 * time);
per_frame_43=wave_y = wave_y + 0.04 * sin(2.3 * time);
per_frame_44=wave_mode = mod(q8, 8);
per_pixel_1=c1 = x * q1;
per_pixel_2=c2 = y * q2;
per_pixel_3=c3 = abs(x - y) * q3;
per_pixel_4=radix = if(0.00001 < abs(above(q5, 0)), min(c1, c2), max(c1, c2));
per_pixel_5=radix = if(0.00001 < abs(above(q6, 0)), min(radix, c3), max(radix, c3));
per_pixel_6=radix = if(0.00001 < abs(above(q4, 0)), min(radix * q1, radix * q2), max(radix * q1, radix * q3));
per_pixel_7=checkx = bor(above(abs(q1), x) * below(abs(q2), x), above(abs(q2), x) * below(abs(q1), x));
per_pixel_8=checky = bor(above(abs(q1), y) * below(abs(q2), y), above(abs(q2), y) * below(abs(q1), y));
per_pixel_9=sx = sx - if(0.00001 < abs(bnot(mod(q7, 2))), if(0.00001 < abs(bnot(checky)), 0.3 * q3, 0.3 * q2 * sin(radix)), 0.1 * q4 * below(q7, 3));
per_pixel_10=sy = sy - if(0.00001 < abs(above(q7, 3)), if(0.00001 < abs(bnot(checkx)), 0.3 * q2, 0.3 * q3 * sin(radix)), 0.1 * q1 * mod(q7, 2));
per_pixel_11=gridx = bnot(mod(x * q8, q7));
per_pixel_12=gridy = bnot(mod(y * q8, q7));
per_pixel_13=rot = 0.5 * gridy * cos(3.14 * radix * q5) + rot * gridx * 0.5 * cos(3.14 * radix * q6);
per_pixel_14=fleem = sin(0.005 * (q7 - 3) * bnot(bor(above(x, 0.8) * above(y, 0.8), below(x, 0.2) * below(y, 0.2))) * sin(radix) * q8);
per_pixel_15=dx = dx + fleem;
per_pixel_16=dy = dy + if(0.00001 < abs(mod(q8, 2)), fleem, -fleem);
