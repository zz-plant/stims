per_frame_22=q11 = a_r * c_inv_r - a_i * c_inv_i;
per_frame_23=q12 = a_r * c_inv_i - a_i * c_inv_r;
per_frame_24=bcad_r = b_r * q15 - b_i * q16 - (a_r * q17 - a_i * q18);
per_frame_25=bcad_i = b_r * q16 - b_i * q15 - (a_r * q18 - a_i * q17);
per_frame_26=q13 = bcad_r * c_inv_r - bcad_i * c_inv_i;
per_frame_27=q14 = bcad_r * c_inv_i - bcad_i * c_inv_r;
