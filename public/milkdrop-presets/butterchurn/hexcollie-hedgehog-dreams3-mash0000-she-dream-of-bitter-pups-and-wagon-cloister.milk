shapecode_3_enabled=0.000000
per_frame_init_1=blah = 0;
per_frame_1=wave_x = wave_x + 0.29 * (0.6 * sin(2.121 * time) + 0.4 * sin(1.621 * time));
per_frame_2=wave_y = wave_y + 0.29 * (0.6 * sin(1.742 * time) + 0.4 * sin(2.322 * time));
per_frame_3=wave_r = wave_r + 0.35 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_4=wave_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_5=wave_b = wave_b + 0.35 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_6=blah = 0.5 / (wave_r + wave_g + wave_b);
per_frame_7=wave_r = wave_r * blah;
per_frame_8=wave_g = wave_g * blah;
per_frame_9=wave_b = wave_b * blah;
per_frame_10=rot = rot + 0.12 * (0.6 * sin(0.21 * time) + 0.4 * sin(0.339 * time));
per_frame_11=cx = cx + 0.3 * (0.6 * sin(0.374 * time) + 0.14 * sin(0.194 * time));
per_frame_12=cy = cy + 0.37 * (0.6 * sin(0.274 * time) + 0.1 * sin(0.394 * time));
per_frame_13=ib_r = ib_r + 0.2 * sin(0.5413 * time);
per_frame_14=ib_g = ib_g + 0.2 * sin(0.6459 * time);
per_frame_15=ib_b = ib_b + 0.2 * sin(0.7354 * time);
per_frame_16=blah = 3 * (0.4 / (ib_r + ib_g + ib_b));
per_frame_17=ib_r = ib_r * blah;
per_frame_18=ib_g = ib_g * blah;
per_frame_19=ib_b = ib_b * blah;
per_frame_20=dx = 0.01 * cos(0.27934 * time + 5);
per_frame_21=dy = 0.01 * sin(0.23142 * time + 2);
wave_0_init1=cang = 0;
wave_0_init2=n = 0;
wave_0_init3=yq = 0;
wave_0_init4=xp = 0;
wave_0_init5=cc_ad_a = 0;
wave_0_init6=t5 = 0;
wave_0_init7=xs = 0;
wave_0_init8=yp = 0;
wave_0_init9=t1 = 0;
wave_0_init10=cc_int = 0;
wave_0_init11=q1 = 0;
wave_0_init12=cc_ramp = 0;
wave_0_init13=cc_b = 0;
wave_0_init14=xq = 0;
wave_0_init15=sang = 0;
wave_0_init16=t3 = 0;
wave_0_init17=bias_i = 0;
wave_0_init18=ys = 0;
wave_0_init19=pi = 0;
wave_0_init20=ang2 = 0;
wave_0_init21=zq = 0;
wave_0_init22=phs = 0;
wave_0_init23=cc_ad_b = 0;
wave_0_init24=ang = 0;
wave_0_init25=cc_a = 0;
wave_0_init26=t2 = 0;
wave_0_init27=zp = 0;
wave_0_init28=bias = 0;
wave_0_init29=q2 = 0;
wave_0_init30=t4 = 0;
wave_0_init31=cc = 0;
wave_0_init32=pi2 = 0;
wave_0_init33=t2 = 0;
wave_0_per_frame1=t1 = 13 * time;
wave_0_per_frame2=t2 = 0.5 * sin(3 * time) + 0.5;
wave_0_per_frame3=t2 = 0.3 * t2 + 0.1;
wave_0_per_frame4=t2 = 0.003 * q2 + 0.06;
wave_0_per_frame5=t3 = q1;
wave_0_per_frame6=t4 = time / 8;
wave_0_per_frame7=t5 = 0.5 * sin(time / 4) + 0.5;
wave_0_per_frame8=t5 = 17 * t5 + 1.3;
wave_0_per_point1=n = 6.283 * sample;
wave_0_per_point2=pi = 3.1415;
wave_0_per_point3=pi2 = 6.283;
wave_0_per_point4=phs = t1 + 9 * sample;
wave_0_per_point5=bias = t5;
wave_0_per_point6=bias_i = bias - 1;
wave_0_per_point7=cc = phs / 3;
wave_0_per_point8=cc_int = floor(cc);
wave_0_per_point9=cc_ramp = cc - cc_int;
wave_0_per_point10=cc_ad_a = (cc_ramp * bias - 1) / bias_i;
wave_0_per_point11=cc_ad_a = if(0.00001 < abs(below(cc_ad_a, 0)), 0, cc_ad_a);
wave_0_per_point12=cc_ad_b = cc_ramp * bias;
wave_0_per_point13=cc_ad_b = if(0.00001 < abs(above(cc_ad_b, 1)), 1, cc_ad_b);
wave_0_per_point14=cc_a = cc_ad_a + cc_int;
wave_0_per_point15=cc_b = cc_ad_b + cc_int;
wave_0_per_point16=xp = t2 * above(cc_ad_a, 0);
wave_0_per_point17=yp = 1;
wave_0_per_point18=zp = 0;
wave_0_per_point19=ang = 100.528 * cc_a;
wave_0_per_point20=sang = sin(ang);
wave_0_per_point21=cang = cos(ang);
wave_0_per_point22=xq = sang * xp + cang * zp;
wave_0_per_point23=yq = yp;
wave_0_per_point24=zq = cang * xp - sang * zp;
wave_0_per_point25=xp = xq;
wave_0_per_point26=yp = yq;
wave_0_per_point27=zp = zq;
wave_0_per_point28=ang2 = cc_b + t4;
wave_0_per_point29=sang = sin(ang2);
wave_0_per_point30=cang = cos(ang2);
wave_0_per_point31=xq = xp;
wave_0_per_point32=yq = sang * yp + cang * zp;
wave_0_per_point33=zq = cang * yp - sang * zp;
wave_0_per_point34=xp = xq;
wave_0_per_point35=yp = yq;
wave_0_per_point36=zp = zq;
wave_0_per_point37=ang2 = 3.13 * cc_b + t4;
wave_0_per_point38=sang = sin(ang2);
wave_0_per_point39=cang = cos(ang2);
wave_0_per_point40=xq = sang * xp + cang * yp;
wave_0_per_point41=yq = cang * xp - sang * yp;
wave_0_per_point42=zq = zp;
wave_0_per_point43=xp = xq;
wave_0_per_point44=yp = yq;
wave_0_per_point45=zp = zq;
wave_0_per_point46=ang2 = 1.43 * cc_b + t4;
wave_0_per_point47=sang = sin(ang2);
wave_0_per_point48=cang = cos(ang2);
wave_0_per_point49=xq = sang * xp + cang * zp;
wave_0_per_point50=yq = yp;
wave_0_per_point51=zq = cang * xp - sang * zp;
wave_0_per_point52=xp = xq;
wave_0_per_point53=yp = yq;
wave_0_per_point54=zp = zq;
wave_0_per_point55=zp = zp + 3.1;
wave_0_per_point56=xs = xp / zp + 0.5;
wave_0_per_point57=ys = 1.333 * (yp / zp) + 0.5;
wave_0_per_point58=x = xs;
wave_0_per_point59=y = ys;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (tmpvar_2.xyz + ((tmpvar_2.xyz - 
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
  ) * 0.3));
  ret_1 = (ret_1 * 0.9);
  ret_1 = (ret_1 + ((
    ((texture (sampler_noise_lq, ((
      (uv_orig * texsize.xy)
     * 
      (texsize_noise_lq.zw * 0.4)
    ) + rand_frame.xy)).xyz - 0.5) / 256.0)
   * 122.0) * clamp (
    (treb_att - 1.0)
  , 0.0, 1.0)));
  vec3 tmpvar_3;
  tmpvar_3 = mix (ret_1, vec3(dot (ret_1, vec3(0.32, 0.49, 0.29))), vec3(0.2, 0.2, 0.2));
  ret_1 = tmpvar_3;
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = tmpvar_3;
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur2, uv_1).xyz * scale2) + bias2)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 0.65);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
