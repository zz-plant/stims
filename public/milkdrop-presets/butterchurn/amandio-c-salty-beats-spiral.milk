shape_3_per_frame14=y = y + 0.3 * q2;
shape_3_per_frame15=ang = 3.14 / 4 + t - mod((2 * t + 3.14) * y, 2) - mod(2 * t * x, 2) + mod(mod(4 * t * x, 2) * y, 2);
shape_3_per_frame16=x = (x - floor(x) - mod(x, 2)) * pow(-1, floor(x));
shape_3_per_frame17=y = (y - floor(y) - mod(y, 2)) * pow(-1, floor(y));
