shape_2_per_frame2=sa = i / 1014;
shape_2_per_frame3=sample = mod(i / 6, 169) / 169;
shape_2_per_frame4=c = below(sample, 0.5);
shape_2_per_frame5=my_x = if(0.00001 < abs(mod(169 * sample, 2)), -0.05, 0.05) + 0.12 * sin(633 * sample + 0.2 * time);
shape_2_per_frame6=my_y = if(0.00001 < abs(c), -0.035, 0.035) + 0.05 * sin(853 * sample + 0.14 * time);
shape_2_per_frame7=my_z1 = 100 * sample - q10;
shape_2_per_frame8=my_z1 = if(0.00001 < abs(above(0, my_z1)), my_z1 + 50, my_z1);
shape_2_per_frame9=my_z2 = -50 + 100 * sample + q10;
shape_2_per_frame10=my_z2 = if(0.00001 < abs(above(my_z2, 50)), my_z2 - 50, my_z2);
