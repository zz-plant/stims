shape_3_per_frame4=x1 = 0.5 * t1 * sin(16 * t1);
shape_3_per_frame5=y1 = 0.5 * t1 * cos(16 * t1);
shape_3_per_frame6=t = 1061.32 * sa + 16 * t1 + 0.5 * sa + 3 * q3 + ang;
shape_3_per_frame7=z = 0.05 + 0.05 * t1;
shape_3_per_frame8=x = z * sin(t);
shape_3_per_frame9=y = z * cos(t);
