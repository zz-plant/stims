shape_2_per_frame17=x1 = cos(w1) * my_x + sin(w1) * my_y;
shape_2_per_frame18=y1 = -sin(w1) * my_x + cos(w1) * my_y;
shape_2_per_frame19=z1 = my_z;
shape_2_per_frame20=x2 = cos(w2) * x1 + sin(w2) * z1;
