shape_2_per_frame23=y3 = cos(w3) * y2 + sin(w3) * z2;
shape_2_per_frame24=z3 = -sin(w3) * y2 + cos(w3) * z2;
shape_2_per_frame25=x3 = x2;
shape_2_per_frame26=l = sqrt(x3 * x3 + y3 * y3);
shape_2_per_frame27=w = atan2(x3, y3);
shape_2_per_frame28=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_2_per_frame29=p = tan(asin(1) + atan2(d + z3, l));
shape_2_per_frame30=my_x = zoom * sin(w) * p;
shape_2_per_frame31=my_y = zoom * cos(w) * p;
shape_2_per_frame32=x = 0.5 + my_x / q6;
shape_2_per_frame33=y = 0.5 + my_y;
shape_2_per_frame34=t = 1061.32 * sa + 2 * d;
shape_2_per_frame35=z1 = 0.025;
shape_2_per_frame36=x2 = z1 * sin(t) / d;
shape_2_per_frame37=y2 = z1 * cos(t) / d;
shape_2_per_frame38=x = x + x2 / q6;
shape_2_per_frame39=y = y + y2;
shape_2_per_frame40=rad = rad * (10 * z1 / d);
shape_2_per_frame41=ang = 3.14 / 4 + t;
