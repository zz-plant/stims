[preset00]
fRating=5.000000
fGammaAdj=1.900000
fVideoEchoZoom=1.169000
nWaveMode=3.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.207000
fWaveScale=1.074000
fWaveSmoothing=0.000000
fWaveParam=0.240000
fModWaveAlphaEnd=1.170000
fWarpAnimSpeed=0.335000
fWarpScale=3.521000
fZoomExponent=2.100000
fZoom=1.000020
fWarp=0.927530
fOuterBorderSize=0.000000
fOuterBorderA=0.500000
fInnerBorderSize=0.029000
fInnerBorderR=0.340000
fInnerBorderG=0.340000
fInnerBorderB=0.340000
fInnerBorderA=0.100000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsR=0.350000
fMotionVectorsG=0.350000
fMotionVectorsB=0.350000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=blah = 0;
per_frame_1=wave_x = wave_x + 0.29 * (0.6 * sin(2.121 * time) + 0.4 * sin(1.621 * time));
per_frame_2=wave_y = wave_y + 0.29 * (0.6 * sin(1.742 * time) + 0.4 * sin(2.322 * time));
per_frame_3=wave_r = wave_r + 0.35 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_4=wave_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_5=wave_b = wave_b + 0.35 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_6=blah = 0.5 / (wave_r + wave_g + wave_b);
per_frame_7=wave_r = wave_r * blah;
per_frame_8=wave_g = wave_g * blah;
per_frame_9=wave_b = wave_b * blah;
per_frame_10=rot = rot + 0.035 * (0.6 * sin(0.21 * time) + 0.3 * sin(0.339 * time));
per_frame_11=cx = cx + 0.3 * (0.6 * sin(0.374 * time) + 0.14 * sin(0.194 * time));
per_frame_12=cy = cy + 0.37 * (0.6 * sin(0.274 * time) + 0.1 * sin(0.394 * time));
per_frame_13=dx = dx + 0.01 * (0.6 * sin(0.324 * time) + 0.4 * sin(0.234 * time));
per_frame_14=dy = dy + 0.01 * (0.6 * sin(0.244 * time) + 0.4 * sin(0.264 * time));
per_frame_15=ib_r = ib_r + 0.2 * sin(0.5413 * time);
per_frame_16=ib_g = ib_g + 0.2 * sin(0.6459 * time);
per_frame_17=ib_b = ib_b + 0.2 * sin(0.7354 * time);
per_frame_18=blah = 3 * (12.4 / (ib_r + ib_g + ib_b));
per_frame_19=ib_r = ib_r * blah;
per_frame_20=ib_g = ib_g * blah;
per_frame_21=ib_b = ib_b * blah;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.03))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 1.333);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
