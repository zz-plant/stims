per_frame_5=echo_zoom = echo_zoom + above(bass, 1.3) * bass * 0.1;
per_pixel_1=rot = ang * sin(time) * 0.02;
per_pixel_2=zoom = zoom + above(y, 0.4) * below(y, 0.6) * bass * 0.1 * rad;
