wave_0_init5=mx = 0.5;
wave_0_init6=my = 0.4;
wave_0_init7=md = 3;
wave_0_per_point1=oldmd = md;
wave_0_per_point2=md = mod(md + randint(4), 4);
wave_0_per_point3=md = if(0.00001 < abs(equal(md, oldmd)), mod(md + 1, 4), md);
wave_0_per_point4=mx = mx + 0.002 * equal(md, 0) * bass;
wave_0_per_point5=mx = mx - 0.002 * equal(md, 1) * bass;
wave_0_per_point6=my = my + 0.002 * equal(md, 2) * treb;
wave_0_per_point7=my = my - 0.002 * equal(md, 3) * treb;
wave_0_per_point8=mx = if(0.00001 < abs(above(mx, 0.9)), 0.5, mx);
wave_0_per_point9=mx = if(0.00001 < abs(below(mx, 0.1)), 0.5, mx);
wave_0_per_point10=my = if(0.00001 < abs(above(my, 0.9)), 0.5, my);
wave_0_per_point11=my = if(0.00001 < abs(below(my, 0.1)), 0.5, my);
wave_0_per_point12=x = mx;
wave_0_per_point13=y = my;
wave_0_per_point14=a = cos(tan(treb + 0.1 * bass));
