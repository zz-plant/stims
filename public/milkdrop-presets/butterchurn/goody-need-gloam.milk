per_frame_1=vol = 0.3333 * (bass + mid + treb_att);
per_frame_2=redsine = 0.5 + 0.15 * bass * sin(3 * time);
per_frame_3=greensine = 0.5 + 0.15 * mid * sin(2 * time);
per_frame_4=bluesine = 0.5 + 0.15 * treb * sin(time);
per_frame_5=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.85 * redif));
per_frame_6=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.85 * greenif));
per_frame_7=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.85 * blueif));
