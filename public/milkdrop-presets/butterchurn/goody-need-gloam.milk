per_frame_10=q4 = 0.5 + 0.5 * sin(0.52 * time) * cos(0.39 * time);
per_frame_11=q5 = 0.5 + 0.05 * sin(0.44 * time) * cos(0.71 * time);
per_pixel_1=zoom = zoom + 0.015 * rad + 0.025 * treb_att * rad;
per_pixel_2=sy = sy + 0.1 * cos(sin(40 * y + time) - 0.5 * sin(20 * x + time) * treb_att);
per_pixel_3=sx = sx + 0.025 * sin(cos(40 * x + time) + 0.5 * cos(20 * y + time) * treb_att);
