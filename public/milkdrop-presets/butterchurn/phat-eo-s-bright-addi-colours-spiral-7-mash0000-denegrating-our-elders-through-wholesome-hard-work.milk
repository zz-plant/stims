per_frame_init_1=inv_rad = 0;
per_frame_init_2=tm = 0;
per_frame_init_3=rays = 0;
per_frame_init_4=rads = 0;
per_frame_init_5=q5 = 0;
per_frame_1=wave_r = wave_r + 9.35 * sin(0.4 * time) + 0.16 * sin(0.5 * time);
per_frame_2=wave_g = wave_g + 5.36 * sin(0.7 * time) + 0.15 * sin(0.11 * time);
per_frame_3=wave_b = wave_b + 3.37 * sin(0.84 * time) + 0.15 * sin(0.3 * time);
per_frame_4=warp = sin(time);
per_frame_5=ob_r = wave_r;
per_frame_6=ob_g = wave_g;
per_frame_7=ob_b = wave_b;
per_frame_8=ib_r = wave_g;
per_frame_9=ib_b = wave_r;
per_frame_10=ib_g = wave_b;
per_frame_11=sy = 0.982;
per_frame_12=sx = sy;
per_pixel_1=inv_rad = 2.2 - rad;
per_pixel_2=tm = time + 4 * inv_rad * bass_att;
per_pixel_3=rays = 0.5 * sin(2 * rad + tm) + 0.5;
per_pixel_4=rads = 0.5 * cos(4 * ang + tm) + 0.5;
per_pixel_5=zoom = 1 + 0.037 * pow(rays, 64);
per_pixel_6=zoom = zoom + 0.04 * pow(rads, 32) * treb_att;
per_pixel_7=sx = sx + 0.1 * pow(rays, 10) * mid_att;
per_pixel_8=q5 = rays;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_noise_lq, ((
    ((texsize.xy * texsize_noise_lq.zw).x * uv)
   / 2.0) + q23)) + 1.0).xyz;
  vec3 tmpvar_3;
  tmpvar_3 = (((texture (sampler_blur1, uv).xyz * scale1) + bias1) - 0.3);
  vec2 tmpvar_4;
  tmpvar_4.x = (0.3 * tmpvar_3.x);
  tmpvar_4.y = tmpvar_3.y;
  ret_1 = ((-0.4 * (
    ((texture (sampler_blur1, ((uv / 4.0) + (0.4 * tmpvar_4))).xyz * scale1) + bias1)
   - 
    (tmpvar_2 * 0.1)
  )) + (texture (sampler_main, (uv + 
    (tmpvar_3 * 0.01)
  .xy)).xyz + (tmpvar_2 * 0.1)));
  float tmpvar_5;
  tmpvar_5 = (1.0 - ((0.01 * q28) * (q28 * rad)));
  ret_1 = (ret_1 * (0.98 * (tmpvar_5 * tmpvar_5)));
  ret_1 = (ret_1 - 0.04);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_1;
  ret = tmpvar_6.xyz;
 }
