per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=grid = 0;
per_frame_init_5=q6 = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=treb_flop = 0;
per_frame_init_9=bass_thresh = 0;
per_frame_init_10=old_bass_flop = 0;
per_frame_init_11=treb_thresh = 0;
per_frame_init_12=pulse = 0;
per_frame_init_13=bass_changed = 0;
per_frame_init_14=mid_thresh = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=mid_changed = 0;
per_frame_init_17=entropy = 0;
per_frame_init_18=bend = 0;
per_frame_init_19=old_mid_flop = 0;
per_frame_init_20=mid_residual = 0;
per_frame_init_21=treb_residual = 0;
per_frame_init_22=chaos = 0;
per_frame_init_23=mid_flop = 0;
per_frame_init_24=q2 = 0;
per_frame_init_25=treb_changed = 0;
per_frame_init_26=q3 = 0;
per_frame_init_27=q7 = 0;
per_frame_init_28=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=rot = 0;
per_frame_3=old_bass_flop = bass_flop;
per_frame_4=old_treb_flop = treb_flop;
per_frame_5=old_mid_flop = mid_flop;
per_frame_6=chaos = 0.1 + 0.1 * sin(pulse);
per_frame_7=bass_thresh = if(0.00001 < abs(above(bass_att, bass_thresh)), 3, bass_thresh - chaos);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 3));
per_frame_9=treb_thresh = if(0.00001 < abs(above(treb_att, treb_thresh)), 3, treb_thresh - chaos);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 3));
per_frame_11=mid_thresh = if(0.00001 < abs(above(mid_att, mid_thresh)), 3, mid_thresh - chaos);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 3));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(3 * pulse) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(3 * pulse) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(3 * pulse) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.032 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_20=entropy = if(0.00001 < abs(equal(pulse, -3.14)), bass_flop + mid_flop + treb_flop + randint(5), entropy);
per_frame_21=q1 = mid_residual;
per_frame_22=q2 = bass_residual;
per_frame_23=q3 = treb_residual;
per_frame_24=q4 = sin(pulse);
per_frame_25=q5 = cos(pulse * (0.5 + 0.1 * entropy));
per_frame_26=q6 = sin(pulse * (0.5 + pow(0.25, entropy)));
per_frame_27=q7 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_28=q8 = entropy;
per_frame_29=ob_r = 0.2 + 0.1 * sin(2.157 * time + q6);
per_frame_30=ob_b = 0.2 + 0.1 * sin(1.689 * time + q5);
per_frame_31=ob_g = 0.2 + 0.1 * sin(0.413 * time + q4);
per_frame_32=ib_r = 0.8 + 0.2 * cos(1.2 * time + 0.1 * q1);
per_frame_33=ib_b = 0.2 + 0.2 * cos(2.811 * time + 0.1 * q2);
per_frame_34=ib_g = 0.7 + 0.3 * cos(1.666 * time + 0.1 * q3);
per_frame_35=ib_size = 0.03 + 0.02 * q2;
per_frame_36=ob_size = 0.03 + 0.02 * sin(2.321 * time + 0.2 * q2);
per_frame_37=ob_a = 0.75 + 0.25 * q3;
per_frame_38=ib_a = 0.8 + 0.2 * sin(0.3 * q2 + q4 + 0.5 * q1);
per_frame_39=mv_r = mv_r + 0.5 * sin(q4 + 0.678 * time);
per_frame_40=mv_b = mv_b + 0.5 * sin(q4 + 0.789 * time);
per_frame_41=mv_g = mv_g + 0.5 * sin(q5 + 0.456 * time);
per_frame_42=mv_a = 0.2 + 0.2 * sin(1.178 * time + 1.14 * q5);
per_frame_43=wave_r = if(0.00001 < abs(treb_changed), 0.5 + 0.5 * q3, if(0.00001 < abs(bass_changed), 0.5 + 0.5 * q4, 1));
per_frame_44=wave_g = 0.5 + 0.2 * bnot(mod(q8, 2)) - 0.2 * bnot(mod(q8, 3)) + 0.2 * bnot(mod(q8, 4)) - 0.2 * bnot(mod(q8, 5));
per_frame_45=wave_b = if(0.00001 < abs(bnot(mod(q8, 6))), 0.8 + 0.2 * q1, bass_changed * mid_changed);
per_frame_46=wave_mode = q8 - bass_changed + mid_changed + treb_changed;
per_frame_47=wave_mystery = mod(frame, 2);
per_pixel_1=grid = mod(pow(3 * x, 3 - q1), q8) + mod(pow(3 * y, 3 - q3), q8);
per_pixel_2=bend = sin(x * (9.42 - 6.28 * q2) * bnot(mod(q8, 3)) + (9.42 * rad - 6.28 * sin(time * (1.3 + 0.3 * q1))) * bnot(mod(q8, 4)) + y * (9.42 * q4 - 6.28 * q3) * bnot(mod(q8, 5)));
per_pixel_3=zoom = zoom + 0.1 * bend;
per_pixel_4=sx = sx - if(0.00001 < abs(above(q1, 2)), bnot(grid) * q3 * 0.2, 0.1 * q2 * bnot(mod(q8, 5)));
per_pixel_5=sy = sy - if(0.00001 < abs(above(q1, 3)), bnot(grid) * q2 * 0.2, 0.1 * q3 * bnot(mod(q8, 2)));
per_pixel_6=rot = equal(grid, 3) * q3 + bnot(mod(grid, q7)) * cos(zoom * grid * q1 * 0.01);
