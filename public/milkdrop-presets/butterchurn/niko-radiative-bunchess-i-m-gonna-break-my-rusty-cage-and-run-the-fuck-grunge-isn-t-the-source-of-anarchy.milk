per_frame_init_1=tic = 0;
per_frame_init_2=slide = 0;
per_frame_init_3=toc = 0;
per_frame_init_4=vt = 0;
per_frame_init_5=q6 = 0;
per_frame_init_6=bt = 0;
per_frame_init_7=q1 = 0;
per_frame_init_8=q5 = 0;
per_frame_init_9=mid_avg = 0;
per_frame_init_10=dis = 0;
per_frame_init_11=tt = 0;
per_frame_init_12=my = 0;
per_frame_init_13=tin = 0;
per_frame_init_14=bass_avg = 0;
per_frame_init_15=vav = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=a = 0;
per_frame_init_18=zm = 0;
per_frame_init_19=mt = 0;
per_frame_init_20=q1sgn = 0;
per_frame_init_21=b = 0;
per_frame_init_22=ra = 0;
per_frame_init_23=tm = 0;
per_frame_init_24=mx = 0;
per_frame_init_25=treb_avg = 0;
per_frame_init_26=sp = 0;
per_frame_init_27=q2 = 0;
per_frame_init_28=q3 = 0;
per_frame_init_29=rmod = 0;
per_frame_init_30=q7 = 0;
per_frame_init_31=rb = 0;
per_frame_init_32=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=q1 = sin(time);
per_frame_3=q1sgn = sign(q1);
per_frame_4=q1 = abs(q1);
per_frame_5=q1 = pow(q1, 6);
per_frame_6=q1 = q1 * q1sgn;
per_frame_7=q1 = 0.4 * q1 + 0.5;
per_frame_8=q2 = 0.5 + 0.1 * sin(0.548 * time);
per_frame_9=tic = min(time - tin, 0.1);
per_frame_10=tin = time;
per_frame_11=ra = 1;
per_frame_12=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_13=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_14=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_15=rb = 1;
per_frame_16=vav = tic * (vav * (1 / tic - rb) + rb * (bass + treb + mid) * 0.33333);
per_frame_17=tt = tt + tic * treb_avg;
per_frame_18=mt = mt + tic * mid_avg;
per_frame_19=bt = bt + tic * bass_avg;
per_frame_20=vt = vt + tic * (treb_avg + mid_avg + bass_avg) * 0.33333;
per_frame_21=sp = 0.1 * abs(vav - slide);
per_frame_22=slide = if(0.00001 < abs(above(slide, vav)), slide - tic * sp, slide + tic * sp) + (1 - toc) * vav;
per_frame_23=toc = 1;
per_frame_24=q3 = 0.3333 * (treb + bass + mid);
per_frame_25=q3 = q3 * q3 * 0.5 + 0.1;
per_frame_26=q4 = mt;
per_frame_27=q5 = bt;
per_frame_28=cx = q1;
per_frame_29=cy = q2;
per_frame_30=rmod = 0.01 * (0.5 * (treb_avg + mid_avg) - 0.5 * bass_avg);
per_frame_31=rmod = 0.14 * pow(rmod / 0.02, 2);
per_frame_32=rmod = min(0.001, max(rmod, -0.001));
per_frame_33=rmod = rmod * pow(1.1 * sin(time), 2);
per_frame_34=rot = 0.8 * pow(rmod / 0.02, 2);
per_frame_35=q6 = rmod;
per_frame_36=q7 = slide - below(q3, 0.5) * (6 + 2 * sin(24 * time)) * pow(min(1, 2 * (0.5 - q3)), 5);
per_frame_37=q8 = if(0.00001 < abs(above(sin(0.5 * time), 0)), -1, 1);
per_frame_38=ib_size = 0.05 - 0.01 * bass;
per_pixel_1=tm = time / rad;
per_pixel_2=a = q1;
per_pixel_3=b = q2;
per_pixel_4=mx = x - a;
per_pixel_5=my = y - b;
per_pixel_6=zm = -0.45;
per_pixel_7=zm = if(0.00001 < abs(above(sin(2.1 * time), 0.95)), 0.45, zm);
per_pixel_8=dis = 0.70710678 * pow(mx * mx + my * my, 0.5);
per_pixel_9=rot = rot * (1 - dis);
per_pixel_10=rot = 20 * rot * q8;
per_pixel_11=dx = zm * mx * dis * cos(3.14 * my) * q3;
per_pixel_12=dy = zm * my * dis * cos(3.14 * mx) * q3;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = (((
    ((texture (sampler_blur2, (uv + vec2(0.024, 0.0))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.024, 0.0))).xyz * scale2) + bias2)
  ).y * 1280.0) * texsize.z);
  tmpvar_2.y = (((
    ((texture (sampler_blur2, (uv + vec2(0.0, 0.024))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.0, 0.024))).xyz * scale2) + bias2)
  ).y * 1024.0) * texsize.w);
  vec2 tmpvar_3;
  tmpvar_3 = (uv - (tmpvar_2 * 0.05));
  ret_1.y = texture (sampler_fc_main, (tmpvar_3 - floor(tmpvar_3))).y;
  ret_1.y = (ret_1.y + ((
    ((ret_1.y - ((texture (sampler_blur1, 
      (tmpvar_3 - floor(tmpvar_3))
    ).xyz * scale1) + bias1).y) - 0.1)
   * 0.1) + 0.02));
  ret_1.z = (((texture (sampler_main, uv_orig).y - ret_1.y) * 2.0) + 0.5);
  vec2 tmpvar_4;
  tmpvar_4.x = (((
    ((texture (sampler_blur2, (uv + vec2(0.01, 0.0))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.01, 0.0))).xyz * scale2) + bias2)
  ).x * 1280.0) * texsize.z);
  tmpvar_4.y = (((
    ((texture (sampler_blur2, (uv + vec2(0.0, 0.01))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.0, 0.01))).xyz * scale2) + bias2)
  ).x * 1024.0) * texsize.w);
  ret_1.x = texture (sampler_fw_main, (uv + (tmpvar_4 * 0.01))).x;
  ret_1.x = (ret_1.x + ((
    (ret_1.x - ((texture (sampler_blur3, uv).xyz * scale3) + bias3).x)
   - 0.02) * 0.5));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (mix (mix (vec3(0.0, 0.0, 0.1), vec3(0.0, 1.0, 0.0), vec3(
    ((tmpvar_2.y * 1.4) - 0.5)
  )), mix (vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 1.0), tmpvar_2.yyy), vec3((
    (1.0 - tmpvar_2.x)
   - tmpvar_2.z))) * (1.0 - (
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  .z * 1.2)));
  ret_1 = (ret_1 + (mix (
    mix (vec3(1.0, 0.6, -0.5), vec3(0.2, -0.2, 0.4), vec3((1.0 - tmpvar_2.x)))
  , vec3(-1.0, 0.0, 1.5), tmpvar_2.yyy) * tmpvar_2.z));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
