per_frame_init_7=rot3 = 0;
per_frame_init_8=rot1 = 0;
per_frame_init_9=rot4 = 0;
per_frame_1=cx = 0.6 * (treb + bass);
per_pixel_1=rot1 = above(treb, 1) * rad * treb_att * 0.01;
per_pixel_2=rot2 = above(treb, 1.1) * rad * bass * 0.01;
per_pixel_3=rot3 = above(treb, 1.2) * rad * bass * sin(time) * 0.01;
per_pixel_4=rot4 = above(treb, 1.3) * rad * treb * 0.1;
per_pixel_5=rot5 = above(treb, 1.4) * rad * bass_att * treb_att * 0.1;
per_pixel_6=rot = max(rot1, max(rot2, max(rot3, max(rot4, rot5))));
per_pixel_7=zoom1 = above(bass, 1) * rad * 0.1;
per_pixel_8=zoom2 = above(bass, 1.1) * rad * bass_att * -0.1;
per_pixel_9=zoom3 = above(bass, 1.2) * rad * bass_att * sin(time) * 0.1;
per_pixel_10=zoom4 = above(bass, 1.4) * ang * bass_att * -0.1;
per_pixel_11=dy = max(zoom1, max(zoom2, max(zoom3, zoom4)));
wave_0_init1=ma = 0;
wave_0_init2=mx = 0;
wave_0_init3=my = 0;
wave_0_per_point1=ma = randint(100);
wave_0_per_point2=mx = mx + 0.002 * cos(ma);
wave_0_per_point3=my = my + 0.02 * sin(ma);
wave_0_per_point4=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_0_per_point5=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_0_per_point6=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_0_per_point7=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_0_per_point8=x = mx;
wave_0_per_point9=y = my;
wave_0_per_point10=a = above(bass + mid + treb, 0.8);
wave_0_per_point11=g = 0.6 * treb;
wave_1_init1=ma = 0;
wave_1_init2=mx = 0;
wave_1_init3=my = 0;
wave_1_per_point1=ma = randint(100);
wave_1_per_point2=mx = mx + 0.004 * cos(ma);
wave_1_per_point3=my = my + 0.004 * sin(ma);
wave_1_per_point4=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_1_per_point5=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_1_per_point6=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_1_per_point7=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_1_per_point8=x = mx;
wave_1_per_point9=y = my;
wave_1_per_point10=r = 0.6 * bass;
