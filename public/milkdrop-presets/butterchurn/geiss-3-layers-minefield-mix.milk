  ret_1 = (((vec3(1.1, 0.8, 0.7) * tmpvar_2.x) + (vec3(0.4, 0.6, 0.55) * tmpvar_2.y)) + (vec3(0.7, 0.6, 0.9) * tmpvar_2.z));
  ret_1 = ((ret_1 * ret_1) * (1.3 + (
    (clamp (((
      cos(((tmpvar_3 * 27.0) + 3.0))
     * 30.0) - 26.0), 0.0, 1.0) * clamp (((
      cos(((tmpvar_3 * 27.0) + 3.0))
     * 30.0) - 26.0), 0.0, 1.0))
   * 5.0)));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
