per_frame_5=wave_g = sqrt(wave_g);
per_frame_6=wave_b = sqrt(wave_b);
per_frame_7=wave_x = 0.01 * randint(100);
per_frame_8=wave_y = 0.25 + 0.005 * randint(100);
per_frame_9=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_10=cx = cx + 0.21 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
