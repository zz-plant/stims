per_frame_15=dx = dx + dx_residual;
per_frame_16=dy = dy + dy_residual;
per_frame_17=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_18=dx_residual = 0.016 * equal(bass_thresh, 2.13) * sin(7 * time) + (1 - equal(bass_thresh, 2.13)) * dx_residual;
per_frame_19=dy_residual = 0.012 * equal(bass_thresh, 2.13) * sin(9 * time) + (1 - equal(bass_thresh, 2.13)) * dy_residual;
per_frame_20=wave_x = wave_x - 7 * dx_residual;
per_frame_21=wave_y = wave_y - 7 * dy_residual;
per_frame_22=wave_mystery = 0.03 * time;

[warp_shader]
