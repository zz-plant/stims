per_pixel_1=rot = rot + 0.05 * sin(rad - (0.1 * time + bas));
per_pixel_2=bas = 2.5 * bass;
per_pixel_3=tos = treb;
per_pixel_4=bos = bass;
per_pixel_5=warp = 0.1 * (bos + bass + bass);
per_pixel_6=cx = 0.5 * (cx + treb);
per_pixel_7=q2 = q4 * (bass + 0.25);
per_pixel_8=warp = q4 - q2;
per_pixel_9=cx = 1.5 * (bos - bass / bos);
per_pixel_10=cy = tos - treb / tos * (cx / cx / (bos / tos));
per_pixel_11=dx = dy + 0.01;
per_pixel_12=dy = dx - 0.01;
per_pixel_13=basstemp = bass + bass_att + bass_thresh;
per_pixel_14=trebtemp = treb + treb_att + treb_thresh;
per_pixel_15=trasstemp = max(basstemp, trebtemp);
per_pixel_16=trassave = trasstemp / 3;
per_pixel_17=basst = max(bass + bass_att, treb + treb_att);
per_pixel_18=trebb = min(basst + bass_thresh, basst + treb_thresh);
per_pixel_19=midbeat = trebb / 3;
per_pixel_20=midtb = max(midbeat + mid, midbeat + mid_att);
per_pixel_21=mtb = midtb / 2.25;
per_pixel_22=beeta = (max(treb, bass) + min(treb_att, bass_att)) / 2;
per_pixel_23=beetb = (max(mid, beeta) + min(mid_att, 0.5 * beeta)) / 2;
per_pixel_24=beetab = (beeta + beetb) / 2;
per_pixel_25=beetc = (max(mid, treb) + min(mid_att, treb_att)) / 2;
per_pixel_26=beetd = (max(bass, beetc) + min(bass_att, 0.5 * beetc)) / 2;
per_pixel_27=beetcd = (beetc + beetd) / 2;
per_pixel_28=beet = (beetab + beetcd) / 2;
per_pixel_29=madbeat = (trassave + mtb + beet) / 3;
shape_1_per_frame1=ang = ang + 0.2 * bass + 0.4 * time;
