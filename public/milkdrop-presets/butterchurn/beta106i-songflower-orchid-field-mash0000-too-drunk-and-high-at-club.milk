per_frame_init_1=pfdx_r = 0;
per_frame_init_2=pfthresh = 0;
per_frame_init_3=ocog = 0;
per_frame_init_4=thresh = 0;
per_frame_init_5=ladder = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=leafset = 0;
per_frame_init_9=cog = 0;
per_frame_init_10=dy_r = 0;
