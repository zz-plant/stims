shape_3_per_frame5=r = min(1, max(0, r + 0.1 * sin(0.117 * time + 1)));
shape_3_per_frame6=g = min(1, max(0, g + 0.1 * sin(0.191 * time + 2)));
shape_3_per_frame7=b = min(1, max(0, b + 0.1 * sin(0.132 * time + 4)));
shape_3_per_frame8=r2 = min(1, max(0, r2 + 0.1 * sin(0.457 * time + 3)));
shape_3_per_frame9=g2 = min(1, max(0, g2 + 0.1 * sin(0.437 * time + 5)));
shape_3_per_frame10=b2 = min(1, max(0, b2 + 0.1 * sin(0.484 * time + 6)));

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = normalize((uv_orig - 0.5));
  float tmpvar_3;
  tmpvar_3 = (time * 7.0);
  uv_1 = (mix (uv_orig, uv, vec2((
    clamp ((((bass / bass_att) - 0.9) * 13.0), 0.0, 1.0)
   * 0.3))) + ((
    (tmpvar_2 * texsize.zw)
   * 
    cos(((rad * 170.0) - tmpvar_3))
  ) * 2.0));
  uv_1 = (uv_1 + ((
    (vec2(5.0, -5.0) * texsize.zw)
   * 
    cos(((ang * 30.0) - tmpvar_3))
  ) * tmpvar_2.yx));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_pw_main, uv_1).xyz - 0.004);
  ret = tmpvar_4.xyz;
 }
