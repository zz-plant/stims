wave_0_per_point1=t8 = -t8;
wave_0_per_point2=d = sqrt(1 - sqr(2 * (sample - 0.5)));
wave_0_per_point3=z = 0.4 * sample - 0.2;
wave_0_per_point4=x = sin(100 * sample) * d * 0.2;
wave_0_per_point5=y = cos(100 * sample) * d * 0.2;
wave_0_per_point6=p = 0.1;
wave_0_per_point7=x = x * (1 + t8 * p);
wave_0_per_point8=y = y * (1 + t8 * p);
wave_0_per_point9=z = z * (1 + t8 * p);
wave_0_per_point10=dir = 0.4 * (t4 - t6) + (t1 - t3) * (t8 + 1) * 0.2;
wave_0_per_point11=d = 2 + pow(t2, 3);
wave_0_per_point12=w = 0.4 * t5 + (t8 + 1) * t2 * 0.2;
wave_0_per_point13=zz = z;
wave_0_per_point14=yy = y;
wave_0_per_point15=y = cos(w) * yy - sin(w) * zz;
wave_0_per_point16=z = sin(w) * yy + cos(w) * zz;
wave_0_per_point17=xx = cos(dir) * x - sin(dir) * y;
wave_0_per_point18=yy = sin(dir) * x + cos(dir) * y;
wave_0_per_point19=d = 0.5;
wave_0_per_point20=zoom = 2 - 1.1 * sqrt(t2);
wave_0_per_point21=zm = sqrt(x * x + y * y + sqr(z + d)) / d;
wave_0_per_point22=x = 0.5 + zoom * xx * 0.55 / zm;
wave_0_per_point23=y = 0.5 + zoom * yy * 0.55 / zm;
wave_0_per_point24=a = sigmoid(-z + 0.1, 25);
