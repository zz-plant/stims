    ((sin(tmpvar_5) / cos(tmpvar_5)) * normalize(tmpvar_3))
  , vec2(-2.0, -2.0), vec2(2.0, 2.0)) / 20.0));
  uv6_2 = (0.4 * sin((
    (uv_1 * 14.0)
   + rand_frame.xy)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = (((texture (sampler_main, 
    (((uv_1 - 0.5) * (0.95 + (0.2 * tmpvar_5))) + 0.5)
  ).xyz + 
    (vec3((0.01 / sqrt(dot (uv6_2, uv6_2)))) * (0.3 * (1.0 + roam_cos)).xyz)
  ) * 0.99) - 0.025);
