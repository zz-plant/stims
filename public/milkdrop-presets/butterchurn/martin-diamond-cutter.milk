per_frame_19=k1 = is_beat * equal(mod(index, 2), 0);
per_frame_20=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_21=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_22=rott = 3.1416 * p2 / 2;
per_frame_23=q1 = cos(rott);
per_frame_24=q2 = sin(rott);
per_frame_25=q3 = -q2;
per_frame_26=q4 = q1;
per_frame_27=vol = vol * dec_slow + q26 * (1 - dec_slow) + q24 * q1;
per_frame_28=q10 = q27 * q28;
per_frame_29=movex = movex + 0.03 * 30 / fps;
per_frame_30=q29 = movex;
per_frame_31=movez = movez + 2.1 / fps;
