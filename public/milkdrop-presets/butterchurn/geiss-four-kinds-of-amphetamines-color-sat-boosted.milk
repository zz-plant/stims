[preset00]
fRating=3.000000
fGammaAdj=1.280000
fDecay=0.950000
nWaveMode=2.000000
bAdditiveWaves=1.000000
fWaveAlpha=0.109000
fWaveScale=1.053000
fWaveSmoothing=0.700000
fZoomExponent=1.488000
fShader=1.000000
fZoom=1.316000
fWarp=0.350000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.742 * time) + 0.4 * sin(1.021 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.703 * time) + 0.4 * sin(0.969 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(1.09 * time) + 0.4 * sin(0.963 * time));
per_frame_4=zoom = zoom + 0.033 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_7=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.95);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz * 1.28);
  ret_1 = (ret_1 * hue_shader);
  vec3 tmpvar_2;
  tmpvar_2 = mix (vec3(dot (ret_1, vec3(0.3333, 0.3333, 0.3333))), ret_1, vec3(2.8, 2.8, 2.8));
  ret_1 = tmpvar_2;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = tmpvar_2;
  ret = tmpvar_3.xyz;
 }
