[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.986000
fVideoEchoZoom=0.999993
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
bWaveDots=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=1.741913
fWaveScale=2.468550
fWaveSmoothing=0.360000
fWaveParam=-0.180000
fZoom=0.999999
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderSize=0.005000
fOuterBorderA=0.920000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=grid = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=treb_flop = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=old_bass_flop = 0;
per_frame_init_10=treb_thresh = 0;
per_frame_init_11=pulse = 0;
per_frame_init_12=bass_changed = 0;
per_frame_init_13=mid_thresh = 0;
per_frame_init_14=q4 = 0;
per_frame_init_15=mid_changed = 0;
per_frame_init_16=entropy = 0;
per_frame_init_17=old_mid_flop = 0;
per_frame_init_18=mid_residual = 0;
per_frame_init_19=treb_residual = 0;
per_frame_init_20=beat = 0;
per_frame_init_21=chaos = 0;
per_frame_init_22=mid_flop = 0;
per_frame_init_23=q2 = 0;
per_frame_init_24=treb_changed = 0;
per_frame_init_25=q3 = 0;
per_frame_1=warp = 0;
per_frame_2=dx = -0.0005;
per_frame_3=dy = -0.0005;
per_frame_4=old_bass_flop = bass_flop;
per_frame_5=old_treb_flop = treb_flop;
per_frame_6=old_mid_flop = mid_flop;
per_frame_7=chaos = 0.9 + 0.1 * sin(beat);
per_frame_8=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -3.14)), 1 + randint(3), entropy));
per_frame_9=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_10=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_11=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_12=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_13=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_14=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_15=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_16=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_17=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_18=bass_residual = bass_changed * sin(0.1 * pulse * entropy) + bnot(bass_changed) * bass_residual;
per_frame_19=treb_residual = treb_changed * sin(0.1 * pulse * entropy) + bnot(treb_changed) * treb_residual;
per_frame_20=mid_residual = mid_changed * sin(0.1 * pulse * entropy) + bnot(mid_changed) * mid_residual;
per_frame_21=pulse = if(0.00001 < abs(above(abs(pulse), 3.14)), -3.14, pulse + 0.052 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_22=beat = if(0.00001 < abs(above(abs(beat), 3.14)), -3.14, beat + 0.01 * (bass + treb + mid));
per_frame_23=q1 = mid_residual;
per_frame_24=q2 = bass_residual;
per_frame_25=q3 = treb_residual;
per_frame_26=q4 = sin(pulse);
per_frame_27=q5 = sin(beat);
per_frame_28=mv_r = mv_r + 0.5 * bass_residual;
per_frame_29=mv_g = mv_g + 0.5 * mid_residual;
per_frame_30=mv_b = mv_b + 0.5 * treb_residual;
per_frame_31=mv_a = 1 - (ob_a + ib_a) * chaos * 0.5;
per_frame_32=mv_x = abs(10 * beat) * entropy;
per_frame_33=mv_y = abs(10 * pulse) * entropy;
per_frame_34=mv_l = entropy * (q4 - q5);
per_frame_35=wave_r = bass_flop * mv_g;
per_frame_36=wave_g = mid_flop * mv_b;
per_frame_37=wave_b = treb_flop * mv_r;
per_frame_38=ob_r = wave_r;
per_frame_39=ob_g = wave_g;
per_frame_40=ob_b = wave_b;
per_pixel_1=grid = mod(100 * x, above(q1, q4) + above(q2, q5) + above(q3, q4)) + mod(100 * y, above(q1, q5) + above(q2, q4) + above(q3, q5)) * randint(10);
per_pixel_2=rot = if(0.00001 < abs(grid), 0.12 * cos(3.14 * rad + x * q1 * 3.14 + y * q2 * 3.14) * (q5 + q4), 0);
per_pixel_3=zoom = zoom - bnot(grid) * sin(x * q3 * 3.14 + y * q5 * 3.14) * 0.1;
