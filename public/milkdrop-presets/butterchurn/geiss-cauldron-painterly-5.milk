[preset00]
fRating=0.000000
fGammaAdj=2.700000
nWaveMode=5.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=1.714000
fWaveScale=1.139000
fWaveSmoothing=0.100000
fWarpScale=1.331000
fZoom=1.004000
fRot=-0.014000
fWarp=0.029440
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=ang = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q2 = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(3.98 * time) + 0.4 * sin(11.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_5=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_6=dx = dx + 0.005 * (0.6 * sin(0.173 * time) + 0.4 * sin(0.223 * time));
per_frame_7=decay = decay - 0.01 * equal(mod(frame, 20), 0);
per_frame_8=wave_x = 0.5 + 0.25 * cos(2 * time) / aspecty;
per_frame_9=wave_y = 0.5 + 0.25 * sin(2 * time) / aspectx;
per_frame_10=ang = 2 * time;
per_frame_11=q1 = cos(ang);
per_frame_12=q2 = sin(ang);

[warp_shader]
shader_body { 
  vec2 uv2_1;
  vec2 tmpvar_2;
  tmpvar_2.x = bass;
  tmpvar_2.y = treb;
  vec2 tmpvar_3;
  tmpvar_3 = ((texture (sampler_main, (
    mix (uv, uv_orig, vec2(-1.0, -1.0))
   + texsize.zw)).xy - 0.37) * (0.005 + (0.045 * 
    clamp ((tmpvar_2 - 1.0), 0.0, 1.0)
  )));
  uv2_1.x = (uv.x + ((tmpvar_3.x * q1) + (tmpvar_3.y * q2)));
  uv2_1.y = (uv.y + ((tmpvar_3.x * q2) - (tmpvar_3.y * q1)));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, uv2_1).xyz - 0.004);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
