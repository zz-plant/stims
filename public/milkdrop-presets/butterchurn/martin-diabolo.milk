wave_0_per_point8=b = q13;
wave_0_per_point9=g = q14;
wave_0_per_point10=xang = t2 + t3 / 3;
wave_0_per_point11=yang = t1 * t2 - t3 / 4;
wave_0_per_point12=zang = t3;
wave_0_per_point13=fov = min(max(0.2 * q20, 0.1), 0.4);
wave_0_per_point14=mx = ox * cos(zang) - oy * sin(zang);
wave_0_per_point15=my = ox * sin(zang) + oy * cos(zang);
wave_0_per_point16=ox = mx;
wave_0_per_point17=oy = my;
wave_0_per_point18=mx = ox * cos(yang) + oz * sin(yang);
wave_0_per_point19=mz = -ox * sin(yang) + oz * cos(yang);
wave_0_per_point20=ox = mx;
wave_0_per_point21=oz = mz;
wave_0_per_point22=my = oy * cos(xang) - oz * sin(xang);
wave_0_per_point23=mz = oy * sin(xang) + oz * cos(xang);
wave_0_per_point24=oy = my;
wave_0_per_point25=oz = mz;
wave_0_per_point26=oz = oz - 7;
wave_0_per_point27=x = ox * fov / oz + 0.5;
wave_0_per_point28=y = oy * fov / oz + 0.5;

[warp_shader]
float xlat_mutableq25;
 shader_body { 
  vec2 uv_1;
