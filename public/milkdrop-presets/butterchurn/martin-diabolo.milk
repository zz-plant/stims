wave_0_per_frame3=t3 = q29 / 3;
wave_0_per_point1=t_abs = sample;
wave_0_per_point2=t_rel = sample - time / 6;
wave_0_per_point3=ampl = abs(sin(3 * t_abs) - mod(q28, 2)) + 0.5;
wave_0_per_point4=ox = 3 * sin(4 * q30) + ampl * sin(500 * t_rel);
wave_0_per_point5=oy = 3 * cos(q30) + ampl * cos(t_rel * (480 + 4 * q28));
wave_0_per_point6=oz = 3 * t_abs;
