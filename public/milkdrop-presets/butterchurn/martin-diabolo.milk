per_frame_1=dec_med = pow(0.8, 30 / fps);
per_frame_2=dec_slow = pow(0.98, 30 / fps);
per_frame_3=beat = (bass + mid + treb) / 3;
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.2 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 8);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 8);
per_frame_10=q20 = avg;
per_frame_11=q21 = beat;
per_frame_12=q22 = peak;
per_frame_13=q23 = bass + mid + treb - (bass_att + mid_att + treb_att);
per_frame_14=q23 = beat - avg;
per_frame_15=q24 = is_beat;
per_frame_16=q27 = index;
per_frame_17=q28 = index2;
per_frame_18=q19 = index;
per_frame_19=k1 = is_beat * equal(index, 0);
per_frame_20=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_21=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_22=rott = 3.14159265359 * p2 / 2;
per_frame_23=q1 = cos(rott);
per_frame_24=q2 = sin(rott);
per_frame_25=pulse = pulse * dec_slow + (1 - dec_slow) * peak;
per_frame_26=winkel = winkel + 30 * (pulse / fps);
per_frame_27=q29 = winkel;
per_frame_28=trel = trel + (bass_ + mid_ + treb_) / fps / 3;
per_frame_29=trel_ = trel_ * dec_med + (1 - dec_med) * trel;
per_frame_30=q30 = trel_;
per_frame_31=q31 = 12 * sin(trel_ / 4);
per_frame_32=dec_slow = pow(0.94, 30 / fps);
per_frame_33=bass_ = bass_ * dec_slow + (1 - dec_slow) * bass_att;
per_frame_34=mid_ = mid_ * dec_slow + (1 - dec_slow) * mid_att;
per_frame_35=treb_ = treb_ * dec_slow + (1 - dec_slow) * treb_att;
per_frame_36=q12 = sigmoid(4 * (bass_ - treb_), 1);
per_frame_37=q13 = sigmoid(4 * (mid_ - bass_), 1);
per_frame_38=q14 = sigmoid(4 * (treb_ - mid_), 1);
per_frame_39=q15 = above(q20, 1.3);
per_frame_40=rota = rota * dec_med + (1 - dec_med) * q22 / 2;
per_frame_41=zoom = 1 + 2 * q1 / fps;
per_frame_42=cx = 0.5 + 0.2 * sin(12 * trel_) * bnot(mod(q28, 3));
per_frame_43=cy = 0.5 + 0.4 * cos(6 * trel_) * bnot(mod(q28, 3));
per_frame_44=rot = 50 * (0.04 * q1 + rota / 8 * q2) / fps;
per_frame_45=dx = 0.6 * q1 / fps * avg;
per_frame_46=dy = 0.6 * q2 / fps * avg;
