per_frame_init_1=treb_mem = 0;
per_frame_init_2=q32 = 0;
per_frame_init_3=q31 = 0;
per_frame_init_4=q30 = 0;
per_frame_1=treb_mem = 0.25 * treb_mem + 0.25 * treb_att;
per_frame_2=wave_r = 0.7 + 0.4 * sin(0.133 * (time + treb_mem));
per_frame_3=wave_g = 0.7 + 0.4 * sin(0.2333 * (time + treb_mem));
per_frame_4=wave_b = 0.7 + 0.4 * cos(0.3533 * (time + treb_mem));
per_frame_5=ib_r = wave_r;
per_frame_6=ib_g = wave_g;
per_frame_7=ib_b = wave_b;
per_frame_8=q32 = wave_r;
per_frame_9=q31 = wave_g;
per_frame_10=q30 = wave_b;
wave_0_init1=ma = 0;
wave_0_init2=mx = 0;
wave_0_init3=my = 0;
wave_0_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.01 * bass;
wave_0_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_0_per_point3=mx = mx + 0.0002 * cos(ma);
wave_0_per_point4=my = my + 0.0002 * sin(ma);
wave_0_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_0_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_0_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_0_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_0_per_point9=x = mx;
wave_0_per_point10=y = my;
wave_0_per_point11=a = above(bass + mid + treb, 0.8);
wave_1_init1=ma = 0;
wave_1_init2=mx = 0;
wave_1_init3=my = 0;
wave_1_per_point1=ma = ma + 3.1415 * above(bass, 1) * 0.05 * bass;
wave_1_per_point2=ma = ma - 3.1415 * above(mid, 1) * 0.05 * mid;
wave_1_per_point3=mx = mx + 0.0001 * cos(ma);
wave_1_per_point4=my = my + 0.0001 * sin(ma);
wave_1_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_1_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_1_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_1_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_1_per_point9=x = mx;
wave_1_per_point10=y = my;
wave_1_per_point11=a = above(bass + mid + treb, 0.1);
wave_2_init1=ma = 0;
wave_2_init2=mx = 0;
wave_2_init3=my = 0;
wave_2_per_point1=ma = ma + 3.1415 * above(mid, 1) * 0.01 * mid;
wave_2_per_point2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
wave_2_per_point3=mx = mx + 0.0004 * cos(ma);
wave_2_per_point4=my = my + 0.0004 * sin(ma);
wave_2_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_2_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_2_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_2_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_2_per_point9=x = mx;
wave_2_per_point10=y = my;
wave_2_per_point11=a = above(bass + mid + treb, 0.3);
wave_3_init1=ma = 0;
wave_3_init2=mx = 0;
wave_3_init3=my = 0;
wave_3_per_point1=ma = ma + 3.1415 * above(bass, 0.5) * 0.02 * bass;
wave_3_per_point2=ma = ma - 3.1415 * above(treb, 0.5) * 0.02 * treb;
wave_3_per_point3=mx = mx + 0.0008 * cos(ma);
wave_3_per_point4=my = my + 0.0008 * sin(ma);
wave_3_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_3_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_3_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_3_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_3_per_point9=x = mx;
wave_3_per_point10=y = my;
wave_3_per_point11=a = above(bass + mid + treb, 0.2);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  float tmpvar_2;
  tmpvar_2 = dot (texsize.zw, texsize.zw);
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  tmpvar_1.xyz = (max (max (texture (sampler_main, uv).xyz, texture (sampler_main, 
    ((tmpvar_3 * (1.0 - (8.0 * 
      sqrt(tmpvar_2)
    ))) + 0.5)
  ).xyz), texture (sampler_main, (
    (tmpvar_3 * (1.0 + (8.0 * sqrt(tmpvar_2))))
   + 0.5)).xyz) - 0.024);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret1_2;
  vec2 uv2_3;
  uv_1 = (uv - 0.5);
  uv_1 = (uv_1 * aspect.xy);
  ret1_2 = vec3(0.0, 0.0, 0.0);
  vec4 tmpvar_4;
  tmpvar_4.w = 0.0;
  tmpvar_4.xyz = ret1_2;
  float tmpvar_5;
  tmpvar_5 = (0.1 * q1);
  ret1_2 = max (tmpvar_4, texture (sampler_main, ((uv_1 + 0.5) + tmpvar_5))).xyz;
  uv2_3.x = ((uv_1.x * 0.3096228) - (uv_1.y * 0.9508595));
  uv2_3.y = ((uv_1.x * 0.9508595) + (uv_1.y * 0.3096228));
  vec4 tmpvar_6;
  tmpvar_6.w = 0.0;
  tmpvar_6.xyz = ret1_2;
  ret1_2 = max (tmpvar_6, texture (sampler_main, ((uv2_3 + 0.5) + tmpvar_5))).xyz;
  uv2_3.x = ((uv_1.x * -0.8082675) - (uv_1.y * 0.5888155));
  uv2_3.y = ((uv_1.x * 0.5888155) + (uv_1.y * -0.8082675));
  vec4 tmpvar_7;
  tmpvar_7.w = 0.0;
  tmpvar_7.xyz = ret1_2;
  ret1_2 = max (tmpvar_7, texture (sampler_main, ((uv2_3 + 0.5) + tmpvar_5))).xyz;
  uv2_3.x = ((uv_1.x * -0.8101388) - (uv_1.y * -0.5862381));
  uv2_3.y = ((uv_1.x * -0.5862381) + (uv_1.y * -0.8101388));
  vec4 tmpvar_8;
  tmpvar_8.w = 0.0;
  tmpvar_8.xyz = ret1_2;
  ret1_2 = max (tmpvar_8, texture (sampler_main, ((uv2_3 + 0.5) + tmpvar_5))).xyz;
  uv2_3.x = ((uv_1.x * 0.3065926) - (uv_1.y * -0.9518408));
  uv2_3.y = ((uv_1.x * -0.9518408) + (uv_1.y * 0.3065926));
  vec4 tmpvar_9;
  tmpvar_9.w = 0.0;
  tmpvar_9.xyz = ret1_2;
  ret1_2 = max (tmpvar_9, texture (sampler_main, ((uv2_3 + 0.5) + tmpvar_5))).xyz;
  uv2_3.x = ((uv_1.x * 0.9999949) - (uv_1.y * -0.003185092));
  uv2_3.y = ((uv_1.x * -0.003185092) + (uv_1.y * 0.9999949));
  vec4 tmpvar_10;
  tmpvar_10.w = 0.0;
  tmpvar_10.xyz = ret1_2;
  ret1_2 = max (tmpvar_10, texture (sampler_main, ((uv2_3 + 0.5) + tmpvar_5))).xyz;
  ret1_2 = ((ret1_2 - (rad / 2.0)) * (1.0 + (slow_roam_cos.xyz / 2.0)));
  vec3 tmpvar_11;
  tmpvar_11.x = q32;
  tmpvar_11.y = q31;
  tmpvar_11.z = q30;
  vec3 tmpvar_12;
  tmpvar_12 = max ((ret1_2 * tmpvar_11), ((
    ((hue_shader * 4.0) - 2.8)
   * 
    dot ((texture (sampler_noise_hq, ((uv_1 * 8.0) + (
      dot (ret1_2, vec3(0.32, 0.49, 0.29))
     / 8.0))) + 0.15).xyz, vec3(0.32, 0.49, 0.29))
  ) / 6.0));
  ret1_2 = tmpvar_12;
  vec4 tmpvar_13;
  tmpvar_13.w = 1.0;
  tmpvar_13.xyz = ((tmpvar_12 * 2.25) - 0.05);
  ret = tmpvar_13.xyz;
 }
