per_pixel_1=zoom = 0.97;
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_5=zm = 1;
per_pixel_6=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_7=star = sin(ag / 5) * (2 - rd) + 0.1 * pow(0.5 * tan(200.96 * rd) + 0.5, 2) + rd / 3;
per_pixel_8=star = min(star, 8);
per_pixel_9=star = max(star, -8);
per_pixel_10=zm = zm + star / 20;
per_pixel_11=sx = zm;
per_pixel_12=sy = zm;
per_pixel_13=rot = 0.1 * (above(rd, 0.7) / (rd + 7)) * bass_att / rd;
per_pixel_14=dx = 0.005 * sin(50 * x) * bass * ag;
per_pixel_15=dy = 0.005 * cos(50 * y) * bass * ag;
