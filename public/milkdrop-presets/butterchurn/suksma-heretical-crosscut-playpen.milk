shape_3_init3=q2 = 0;
shape_3_init4=q3 = 0;
shape_3_per_frame1=x = 0.5 + 0.07 * cos(0.5 * q4) + 0.31 * sin(3.5 * time);
shape_3_per_frame2=y = 0.5 + 0.07 * sin(0.5 * q4) + 0.31 * cos(3.5 * time);
shape_3_per_frame3=r = 0.5 + 0.5 * sin(1.013 * time + 2);
shape_3_per_frame4=g = 0.5 + 0.5 * sin(0.863 * time + 3);
shape_3_per_frame5=b = 0.5 + 0.5 * sin(1.054 * time + 1);
