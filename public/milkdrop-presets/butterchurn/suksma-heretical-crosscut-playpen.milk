per_frame_1=dec_med = pow(0.96, 30 / fps);
per_frame_2=dec_slow = pow(0.999, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, 0.5 + avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 8);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 2);
per_frame_10=index3 = mod(index3 + is_beat * bnot(index) * bnot(index2), 2);
per_frame_11=q20 = avg;
per_frame_12=q21 = beat;
per_frame_13=q22 = peak;
per_frame_14=q23 = index;
per_frame_15=q24 = is_beat;
per_frame_16=vol = bass_att + treb_att;
per_frame_17=v2 = v2 * dec_med + vol * (1 - dec_med);
per_frame_18=q26 = max(atan(vol - v2), 0);
per_frame_19=q27 = index + 1;
per_frame_20=sw = sw * dec_med + (1 - dec_med) * mod(index2, 2);
per_frame_21=q28 = sw;
per_frame_22=kiss = kiss * dec_med + (1 - dec_med) * bnot(index2) * below(index, 4);
per_frame_23=q29 = kiss;
per_frame_24=k1 = is_beat * bnot(index);
per_frame_25=k2 = is_beat * bnot(index);
per_frame_26=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_27=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_28=rott = 3.1416 * p2 / 2;
per_frame_29=monitor = k1;
per_frame_30=q1 = cos(rott);
per_frame_31=q2 = sin(rott);
per_frame_32=q3 = -q2;
per_frame_33=q4 = q1;
per_frame_34=q5 = cos(time / 4);
per_frame_35=q6 = -sin(time / 4);
per_frame_36=q7 = -q6;
per_frame_37=q8 = q5;
per_frame_38=zoom = 1;
per_frame_39=rot = -0;
per_frame_40=dt = 3 / fps;
per_frame_41=m = 1;
per_frame_42=x0 = 0;
per_frame_43=y0 = 0;
per_frame_44=ax = -(xk - x0) / m + sign(vx + 0.001) * dt * bass / 40;
per_frame_45=ay = -(yk - y0) / m + sign(vy + 0.001) * dt * treb / 40;
per_frame_46=monitor = index3;
per_frame_47=vx = vx * dec_slow + ax * dt;
per_frame_48=vy = vy * dec_slow + ay * dt;
per_frame_49=xk = xk + vx * dt;
per_frame_50=yk = yk + vy * dt;
per_frame_51=q9 = xk;
per_frame_52=q10 = yk;
shape_0_init1=q1 = 0;
shape_0_init2=q2 = 0;
shape_0_init3=q3 = 0;
shape_0_per_frame1=x = x + 0.13 * sin(0.9 * time);
