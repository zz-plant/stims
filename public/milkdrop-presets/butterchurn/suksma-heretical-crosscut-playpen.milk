shape_1_init1=q1 = 0;
shape_1_init2=q2 = 0;
shape_1_init3=q3 = 0;
shape_1_per_frame1=rad = rad - 0.2 + 0.2 * bass_att;
shape_1_per_frame2=r = r + 0.25 * sin(1.1 * time) + 0.2 * sin(0.25 * time);
shape_1_per_frame3=g = g + 0.25 * cos(1.5 * time) + 0.22 * cos(0.24 * time);
shape_1_per_frame4=b = b + 0.25 * sin(0.6 * time) + 0.27 * cos(0.7 * time);
shape_1_per_frame5=r2 = 1 - abs(r);
shape_1_per_frame6=g2 = 1 - abs(g);
shape_1_per_frame7=b2 = 1 - abs(b);
shape_1_per_frame8=ang = ang + 3 * abs(tan(1 * time));
shape_1_per_frame9=x = x + 0.14 * cos(time) + 0.2 * sin(0.42 * time);
shape_1_per_frame10=y = y + 0.16 * sin(1.2 * time) + 0.15 * sin(0.8 * time) + 0.21 * cos(0.45 * time);
shape_1_per_frame11=border_r = q1;
shape_1_per_frame12=border_b = q2;
shape_1_per_frame13=border_g = q3;
shape_2_init1=q1 = 0;
shape_2_init2=q2 = 0;
shape_2_init3=q3 = 0;
shape_2_per_frame1=ang = 2.4 * time;
shape_2_per_frame2=x = 0.5 + 0.22 * cos(3.3 * time) + 0.14 * cos(1.2 * time);
shape_2_per_frame3=y = 0.5 + 0.26 * sin(3.1 * time) + 0.13 * sin(1.7 * time);
shape_2_per_frame4=r = 0.5 + 0.5 * sin(1.013 * time + 5);
shape_2_per_frame5=g = 0.5 + 0.5 * sin(1.063 * time + 2);
shape_2_per_frame6=b = 0.5 + 0.5 * sin(1.054 * time + 1);
shape_2_per_frame7=r2 = 0.5 + 0.5 * sin(1.085 * time + 3);
shape_2_per_frame8=g2 = 0.5 + 0.5 * sin(1.056 * time + 1);
shape_2_per_frame9=b2 = 0.5 + 0.5 * sin(1.038 * time + 4);
shape_2_per_frame10=border_r = q1;
shape_2_per_frame11=border_b = q2;
shape_2_per_frame12=border_g = q3;
shape_3_init1=q4 = 0;
