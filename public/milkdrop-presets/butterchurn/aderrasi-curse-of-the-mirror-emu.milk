[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=5.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bDarken=1.000000
fWaveAlpha=100.000000
fWaveScale=0.653092
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=0.200000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=rg2 = 0;
per_frame_init_2=pfdx_r = 0;
per_frame_init_3=pfthresh = 0;
per_frame_init_4=thresh = 0;
per_frame_init_5=xbar = 0;
per_frame_init_6=dy_r = 0;
per_frame_init_7=rg3 = 0;
per_frame_init_8=pfdy_r = 0;
per_frame_init_9=rg1 = 0;
per_frame_init_10=dx_r = 0;
per_frame_init_11=ybar = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=wave_x = wave_x + 0.1 * cos(1.2 * time) * sin(1.1 * time) + 0.1 * sin(0.61 * time);
per_frame_6=wave_y = wave_y + 0.1 * sin(1.2 * time) * cos(4.1 * time) + 0.11 * cos(1.1 * time);
per_frame_7=ob_r = 1 - abs(wave_r);
per_frame_8=ob_b = 1 - abs(wave_b);
per_frame_9=ob_g = 1 - abs(wave_g);
per_frame_10=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_11=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_12=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_13=rg1 = abs(sin(time));
per_frame_14=rg2 = 0 * above(rg1, 0.75) + 3 * below(rg1, 0.25) + 1 * above(rg1, 0.25) * below(rg1, 0.5) + 2 * above(rg1, 0.5) * below(rg1, 0.75);
per_frame_15=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_16=echo_orient = rg3;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=xbar = above(sin(2 * dx_r * time), 0) * abs(4 - x * tan(4 * cos(y * time))) + below(sin(2 * dx_r * time), 0) * sin(3 * x * sin(3 * cos(dx_r * y * time)));
per_pixel_5=ybar = above(cos(1.2 * dy_r * time), 0) * abs(4 - y * tan(4 * cos(x * time))) + below(cos(1.2 * dy_r * time), 0) * sin(3 * y * sin(3 * cos(dy_r * x * time)));
per_pixel_6=dx = dx + dx_r * cos(1.6 * xbar);
per_pixel_7=dy = dy + dy_r * cos(1.6 * ybar);
per_pixel_8=zoom = zoom - 0.03 * (xbar / ybar);
per_pixel_9=rot = rot + 0.02 * (ybar + xbar) * cos(1.52 * time);
per_pixel_10=cx = cx + 2 * xbar * dx_r;
per_pixel_11=cy = cy + 2 * ybar * dy_r;
