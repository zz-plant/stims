[preset00]
fRating=0.000000
fGammaAdj=1.700000
fDecay=0.902000
fVideoEchoZoom=0.913970
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=6.000000
bAdditiveWaves=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bBrighten=1.000000
fWaveAlpha=4.099998
