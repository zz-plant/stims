fWaveSmoothing=0.630000
fWaveParam=1.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoomExponent=0.999995
fShader=1.000000
fZoom=0.999500
fWarp=0.010000
fSx=0.999997
fSy=0.999999
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fWaveX=0.000000
fOuterBorderSize=0.005000
fOuterBorderR=1.000000
fOuterBorderA=0.260000
fInnerBorderSize=0.500000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=blue = 0;
per_frame_init_2=ying = 0;
per_frame_init_3=red_aim = 0;
per_frame_init_4=yin = 0;
per_frame_init_5=yang = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=slowtime = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=bass_on = 0;
per_frame_init_10=treb_thresh = 0;
per_frame_init_11=treb_on = 0;
per_frame_init_12=green = 0;
per_frame_init_13=red = 0;
per_frame_init_14=blue_aim = 0;
per_frame_init_15=swapcolour = 0;
per_frame_init_16=mid_on = 0;
per_frame_init_17=green_aim = 0;
per_frame_init_18=any_on = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.85 * (bass_thresh - 1.4) + 1.4);
per_frame_2=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.75 * (treb_thresh - 1.5) + 1.5);
per_frame_3=bass_on = above(bass_thresh, 1.8);
per_frame_4=treb_on = above(treb_thresh, 1.9);
per_frame_5=swapcolour = bass_on - treb_on;
per_frame_6=red_aim = if(0.00001 < abs(equal(swapcolour, 1)), 1, if(0.00001 < abs(equal(swapcolour, 0)), 1, 0));
per_frame_7=green_aim = if(0.00001 < abs(equal(swapcolour, 1)), 0, if(0.00001 < abs(equal(swapcolour, 0)), 0.5, 0.25));
per_frame_8=blue_aim = if(0.00001 < abs(equal(swapcolour, 1)), 0, if(0.00001 < abs(equal(swapcolour, 0)), 0, 1));
per_frame_9=red = red + (red_aim - red) * if(0.00001 < abs(equal(swapcolour, 1)), 0.65, 0.45);
per_frame_10=green = green + 0.5 * (green_aim - green);
per_frame_11=blue = blue + (blue_aim - blue) * if(0.00001 < abs(equal(swapcolour, 1)), 0.45, 0.65);
per_frame_12=wave_r = red + 0.2 * green;
per_frame_13=wave_g = 0.15 * green;
per_frame_14=wave_b = green + blue;
per_frame_15=slowtime = slowtime + bnot(mod(100 * time, 41)) + 0.001;
per_frame_16=rot = 0.1 * sin(slowtime);
per_frame_17=ying = if(0.00001 < abs(below(ying, 1)), 1, ying);
per_frame_18=any_on = bnot(mod(bass_on + mid_on + treb_on, 3));
per_frame_19=ying = if(0.00001 < abs(any_on), ying + bnot(mod(10 * time, 3)), ying);
per_frame_20=yin = mod(ying, 2);
per_frame_21=ob_r = -1 * cos(ying) + abs(-1 * cos(ying));
per_frame_22=ob_b = cos(ying) + abs(cos(ying));
per_frame_23=ob_g = abs(sin(ying));
per_frame_24=mv_r = 0.7 - 0.2 * sin(0.683 * time);
per_frame_25=mv_b = 0.9 + 0.1 * sin(0.832 * time);
per_frame_26=mv_g = 0.2 + 0.17 * sin(1.03 * time);
per_frame_27=mv_r = 0.7 + 0.148 * (ib_r + ib_b);
per_frame_28=mv_b = 1 - 0.2 * (ib_r + ib_b);
per_frame_29=mv_g = 0.6 + 0.19 * (ib_g + ib_r);
per_frame_30=q1 = 0.32 + (bass + 2 * bass_att) / 20;
per_frame_31=dx = if(0.00001 < abs(yin), sin(slowtime), if(0.00001 < abs(equal(yin, yang)), 0, dx));
per_frame_32=dy = if(0.00001 < abs(yin), 0.01 * cos(slowtime), 0);
per_frame_33=yang = bnot(yin);
per_frame_34=monitor = any_on;
per_pixel_1=dx = if(0.00001 < abs(above(x, q1)), sin(1.1 * q1 - x) / 5, log10(1 / x) / 15);
per_pixel_2=cx = cx - 0.75 * sin(rad + q1);
