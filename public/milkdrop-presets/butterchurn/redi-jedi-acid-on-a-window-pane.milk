per_frame_init_1=lbbtime = 0;
per_frame_init_2=cx1 = 0;
per_frame_init_3=sw6 = 0;
per_frame_init_4=sw2 = 0;
per_frame_init_5=cy1 = 0;
per_frame_init_6=beatb = 0;
per_frame_init_7=t1 = 0;
per_frame_init_8=sw3 = 0;
per_frame_init_9=sw5 = 0;
per_frame_init_10=avgbeatrate = 0;
per_frame_init_11=q1 = 0;
per_frame_init_12=myx = 0;
per_frame_init_13=avgvol = 0;
per_frame_init_14=ccc = 0;
per_frame_init_15=myy = 0;
per_frame_init_16=ax = 0;
per_frame_init_17=t3 = 0;
per_frame_init_18=beatrate = 0;
per_frame_init_19=mrot = 0;
per_frame_init_20=hue = 0;
per_frame_init_21=bool = 0;
per_frame_init_22=ph = 0;
per_frame_init_23=const = 0;
per_frame_init_24=beathard = 0;
per_frame_init_25=q4 = 0;
per_frame_init_26=lbass = 0;
per_frame_init_27=ay = 0;
per_frame_init_28=mrad = 0;
per_frame_init_29=rawbeatb = 0;
per_frame_init_30=db = 0;
per_frame_init_31=t2 = 0;
per_frame_init_32=vol = 0;
per_frame_init_33=mang = 0;
per_frame_init_34=bc = 0;
per_frame_init_35=q2 = 0;
per_frame_init_36=h = 0;
per_frame_init_37=sw1 = 0;
per_frame_init_38=phase = 0;
per_frame_init_39=q3 = 0;
per_frame_init_40=c = 0;
per_frame_init_41=sw4 = 0;
per_frame_init_42=cc = 0;
per_frame_init_43=mtime = 0;
per_frame_init_44=avgdb = 0;
per_frame_init_45=db = 0.01;
per_frame_init_46=beatrate = 1;
per_frame_init_47=avgbeatrate = 2;
per_frame_init_48=lbbtime = time;
per_frame_init_49=avgdb = 0.01;
per_frame_init_50=vol = 1;
per_frame_init_51=avgvol = 0.2;
per_frame_init_52=phase = 0;
per_frame_init_53=bool = 0;
per_frame_init_54=const = 0.02;
per_frame_init_55=mtime = 1000 + 1000 * bass_att;
per_frame_init_56=t1 = 500 + 500 * bass;
per_frame_init_57=t2 = 500 + 500 * treb;
per_frame_init_58=t3 = 500 + 500 * mid;
per_frame_1=db = (bass - lbass) * fps;
per_frame_2=lbass = bass;
per_frame_3=avgdb = 0.99 * avgdb + 0.01 * abs(db);
per_frame_4=avgvol = 0.99 * avgvol + 0.0033 * (bass + mid + treb);
per_frame_5=rawbeatb = above(abs(db), avgdb * avgvol * 4);
per_frame_6=beatb = rawbeatb * above(time - lbbtime, 0.5 * avgbeatrate);
per_frame_7=beathard = beatb * (abs(db) - 4 * avgdb);
per_frame_8=beatrate = beatb * (time - lbbtime) + (1 - beatb) * beatrate;
per_frame_9=avgbeatrate = beatb * (0.9 * avgbeatrate + 0.1 * beatrate) + (1 - beatb) * avgbeatrate;
per_frame_10=lbbtime = time * beatb + (1 - beatb) * lbbtime;
per_frame_11=ph = (time - lbbtime) * (60 / avgbeatrate) * const;
per_frame_12=phase = max(min(ph, 1), 0);
per_frame_13=const = const * (1 - beatb) + beatb * (const + 0.01 * bool);
per_frame_14=bool = below(phase, 0.98) * (0.99 - ph) - 0.5 * above(phase, 0.98) * ph;
per_frame_15=bc = bc + beatb;
per_frame_16=vol = rawbeatb * (abs(db) - avgdb) * 0.01;
per_frame_17=avgvol = 0.999 * avgvol + 0.001 * vol;
per_frame_18=mtime = mtime + min(0.5 * avgvol, 0.25) * (60 / fps);
per_frame_19=decay = 1;
per_frame_20=warp = 0;
per_frame_21=wrap = 1;
per_frame_22=hue = 0.01 * mtime + 0.5 * phase;
per_frame_23=h = 6 * (hue - floor(hue));
per_frame_24=sw1 = below(h, 1);
per_frame_25=sw2 = (1 - sw1) * below(h, 2);
per_frame_26=sw3 = (1 - sw1) * (1 - sw2) * below(h, 3);
per_frame_27=sw4 = (1 - sw1) * (1 - sw2) * (1 - sw3) * below(h, 4);
per_frame_28=sw6 = above(h, 5);
per_frame_29=sw5 = (1 - sw1) * (1 - sw2) * (1 - sw3) * (1 - sw4) * (1 - sw6);
per_frame_30=ob_r = sw1 + sw2 * (2 - h) + sw5 * (h - 4) + sw6;
per_frame_31=ob_g = sw1 * h + sw2 + sw3 + sw4 * (4 - h);
per_frame_32=ob_b = sw3 * (h - 2) + sw4 + sw5 + sw6 * (6 - h);
per_frame_33=t1 = t1 + min(avgvol * bass_att * 0.5, 0.25) * (60 / fps);
per_frame_34=t2 = t2 + min(avgvol * treb_att * 0.5, 0.25) * (60 / fps);
per_frame_35=t3 = t3 + min(avgvol * mid_att * 0.5, 0.25) * (60 / fps);
per_frame_36=monitor = avgvol;
per_frame_37=q1 = mtime;
per_frame_38=q2 = t1;
per_frame_39=q3 = t2;
per_frame_40=q4 = t3;
per_frame_41=cx = 0.5 * sin(0.01 * q2) + 0.5;
per_frame_42=cy = 0.5 * cos(0.01 * q3) + 0.5;
per_frame_43=rot = 15 * sin(0.01 * q2 - 0.01 * q3) + 103;
per_pixel_1=c = sin(0.1 * q2);
per_pixel_2=cc = sin(0.1 * q3);
per_pixel_3=ccc = sin(0.1 * q4);
per_pixel_4=cx1 = 0.5 + 0.3 * ccc;
per_pixel_5=cy1 = 0.5 + 0.4 * cc;
per_pixel_6=myx = cx1 - x;
per_pixel_7=myy = cy1 - (1 - y);
per_pixel_8=mrad = pow(myx * myx + myy * myy, 0.5);
per_pixel_9=mang = asin(abs(myy) / mrad);
per_pixel_10=ax = mang;
per_pixel_11=ay = mang;
per_pixel_12=mrot = 0.1 * (1 - mrad) * sin(0.01 * q1 + 0.1 * q2);
per_pixel_13=dx = sign(myy) * sin(ax) * mrot;
per_pixel_14=dy = sign(myx) * cos(ay) * mrot;
per_pixel_15=cx1 = 0.5 + 0.3 * cc;
per_pixel_16=cy1 = 0.5 + 0.25 * c + 0.25 * ccc;
per_pixel_17=myx = cx1 - x;
per_pixel_18=myy = cy1 - (1 - y);
per_pixel_19=mrad = pow(myx * myx + myy * myy, 0.5);
per_pixel_20=mang = asin(abs(myy) / mrad);
per_pixel_21=ax = mang;
per_pixel_22=ay = mang;
per_pixel_23=mrot = 0.1 * (1 - mrad) * sin(0.02 * q3 + 0.3 * q1);
per_pixel_24=dx = dx - sign(myy) * sin(ax) * mrot;
per_pixel_25=dy = dy - sign(myx) * cos(ay) * mrot;
wave_0_init1=q2 = 0;
wave_0_init2=q1 = 0;
wave_0_init3=q3 = 0;
wave_0_per_point1=x = 0.3 * sin(0.1 * q2 + 0.01 * q1) + 0.5 + 0.1 * value1;
wave_0_per_point2=y = 0.3 * cos(0.1 * q1 - 0.05 * q3) + 0.5 + 0.1 * value2;
wave_0_per_point3=r = 0.5 * sin(q2 + 3.14 * sample - treb) + 0.5;
wave_0_per_point4=g = 0.5 * cos(q3 + 3.14 * sample - bass) + 0.5;
wave_0_per_point5=b = 0.5 * sin(q1 + 3.14 * sample - mid) + 0.5;
