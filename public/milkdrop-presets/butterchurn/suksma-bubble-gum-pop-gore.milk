wave_0_per_frame1=basstime = basstime + bass * bass;
wave_0_per_frame2=t1 = 0.003 * basstime;
wave_0_per_point1=smp = 6.283 * sample;
wave_0_per_point2=xp = 0.2 * sin(smp);
wave_0_per_point3=yp = 0.2 * cos(smp);
wave_0_per_point4=zp = 0;
wave_0_per_point5=angy = 6.28 * sin(25.12 * sample + t1);
wave_0_per_point6=xq = xp * cos(angy) - zp * sin(angy);
wave_0_per_point7=zq = xp * sin(angy) + zp * cos(angy);
wave_0_per_point8=xp = xq;
wave_0_per_point9=zp = zq;
wave_0_per_point10=angy = 0.1 * t1;
wave_0_per_point11=xq = xp * cos(angy) - zp * sin(angy);
wave_0_per_point12=zq = xp * sin(angy) + zp * cos(angy);
wave_0_per_point13=xp = xq;
wave_0_per_point14=zp = zq;
wave_0_per_point15=axs1 = sin(0.15 * t1) + 1.6;
wave_0_per_point16=yq = yp * cos(axs1) - zp * sin(axs1);
wave_0_per_point17=zq = yp * sin(axs1) + zp * cos(axs1);
wave_0_per_point18=yp = yq;
wave_0_per_point19=zp = zq;
wave_0_per_point20=axs2 = 3.3 * sin(0.1 * t1);
wave_0_per_point21=xq = xp * cos(axs2) - zp * sin(axs2);
wave_0_per_point22=zq = xp * sin(axs2) + zp * cos(axs2);
wave_0_per_point23=xp = xq;
wave_0_per_point24=zp = zq;
wave_0_per_point25=yp = yp * 1.2;
wave_0_per_point26=zp = zp + 2.1;
wave_0_per_point27=xs = xp / zp;
wave_0_per_point28=ys = yp / zp;
wave_0_per_point29=x = xs + 0.5;
wave_0_per_point30=y = ys + 0.5;
wave_0_per_point31=r = 1 - q1;
wave_0_per_point32=g = 1 - q2;
wave_0_per_point33=b = 1 - q3;
shape_0_per_frame1=y = 0.5 * bass_att + 0.2;
shape_0_per_frame2=x = 0.5 * cos(2 * time) + 0.5;
shape_2_per_frame1=x = 0.4 * sin(5 * time) + 0.5;
shape_2_per_frame2=y = 0.5 * treb_att;
shape_3_per_frame1=x = 0.5 + 0.07 * bass;

[comp_shader]
shader_body { 
  vec3 bird_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (texsize.zw * 2.0);
  vec3 tmpvar_4;
  tmpvar_4 = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_3))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_3))
  ).xyz * scale1) + bias1));
  vec3 tmpvar_5;
  tmpvar_5 = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_3))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_3))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_6;
  tmpvar_6.x = tmpvar_4.y;
  tmpvar_6.y = tmpvar_5.y;
  vec2 tmpvar_7;
  tmpvar_7 = (uv + (tmpvar_6 * 0.05));
  vec2 x_8;
  x_8 = (tmpvar_7 - uv);
  vec2 tmpvar_9;
  tmpvar_9.x = tmpvar_4.y;
  tmpvar_9.y = tmpvar_5.y;
  bird_1 = (pow (vec3(max (texture (sampler_main, tmpvar_7).x, texture (sampler_main, 
    ((0.5 + ((uv - 0.5) * vec2(-1.0, 1.0))) + (tmpvar_9 * 0.05))
  ).x)), vec3(1.4, 1.4, 1.4)) * (hue_shader * hue_shader));
  vec2 tmpvar_10;
  tmpvar_10.x = tmpvar_4.y;
  tmpvar_10.y = tmpvar_5.y;
  ret_2 = (((
    ((((
      (((tmpvar_4.y + tmpvar_5.y) * 4.0) + 0.5)
     * vec3(0.0, 0.0, 1.0)) + (
      sqrt(dot (x_8, x_8))
     * vec3(64.0, 96.0, 0.0))) + (vec3(1.0, 0.0, 0.0) * texture (sampler_main, uv).y)) - vec3(0.0, 0.0, 0.3))
   * 0.6) * clamp (
    (1.0 - (bird_1.x * 4.0))
  , 0.0, 1.0)) + bird_1);
  vec3 tmpvar_11;
  tmpvar_11 = mix (ret_2, vec3(1.0, 1.0, 1.0), ((
    (((texture (sampler_blur1, (uv + 
      (tmpvar_10 * 0.1)
    )).xyz * scale1) + bias1) * clamp (1.0, 0.0, 1.0))
  .z * 6.0) * (1.0 - 
    (bird_1 * 3.0)
  )));
  ret_2 = tmpvar_11;
  vec4 tmpvar_12;
  tmpvar_12.w = 1.0;
  tmpvar_12.xyz = tmpvar_11;
  ret = tmpvar_12.xyz;
 }
