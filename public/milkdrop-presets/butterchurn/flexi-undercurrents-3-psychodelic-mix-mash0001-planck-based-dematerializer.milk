per_frame_init_52=x2 = 0.5;
per_frame_init_53=y2 = 0.5;
per_frame_init_54=x3 = 0.5;
per_frame_init_55=y3 = 0.5;
per_frame_init_56=x4 = 0.5;
per_frame_init_57=y4 = 0.5;
per_frame_1=decay = 1;
per_frame_2=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_3=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_4=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_5=x1 = 0.5 + xx1 - xx2;
per_frame_6=y1 = 0.5 + yy1;
per_frame_7=spring = 28;
per_frame_8=grav = 2;
per_frame_9=resist = 0.2;
per_frame_10=bounce = 0.94;
per_frame_11=dt = 0.0001;
per_frame_12=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_13=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_14=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_15=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_16=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_17=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_18=x2 = x2 + vx2;
per_frame_19=y2 = y2 + vy2;
per_frame_20=x3 = x3 + vx3;
per_frame_21=y3 = y3 + vy3;
per_frame_22=x4 = x4 + vx4;
per_frame_23=y4 = y4 + vy4;
per_frame_24=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_25=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_26=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_27=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_28=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_29=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_30=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_31=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_32=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_33=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_34=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_35=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
per_frame_36=q1 = x1;
per_frame_37=q2 = x2;
per_frame_38=q3 = x3;
per_frame_39=q4 = x4;
per_frame_40=q5 = y1;
per_frame_41=q6 = y2;
per_frame_42=q7 = y3;
per_frame_43=q8 = y4;
per_frame_44=zoom = 1;
per_frame_45=bb = 0.99 * bb + 0.02 * bass;
per_frame_46=mm = 0.99 * mm + 0.02 * mid;
per_frame_47=tt = 0.99 * tt + 0.02 * treb;
per_frame_48=mx = max(max(bb, mm), tt);
per_frame_49=mn = min(min(bb, mm), tt);
per_frame_50=ob_r = (bb - mn) / (mx - mn);
per_frame_51=ob_b = (mm - mn) / (mx - mn);
per_frame_52=ob_g = (tt - mn) / (mx - mn);
per_frame_53=q6 = atan2(vx4, vy4);
per_frame_54=q5 = sqrt(vx4 * vx4 + vy4 * vy4);
per_pixel_1=dir = -q6 + asin(1);
per_pixel_2=b1 = 0.1;
per_pixel_3=m1 = 25 * q5;
per_pixel_4=t1 = 0.05;
per_pixel_5=xx = q4;
per_pixel_6=yy = 1 - q8;
per_pixel_7=x1 = xx + cos(dir + 1.5708) * b1;
per_pixel_8=y1 = yy - sin(dir + 1.5708) * b1;
per_pixel_9=x2 = xx - cos(dir + 1.5708) * b1;
per_pixel_10=y2 = yy + sin(dir + 1.5708) * b1;
per_pixel_11=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * b1;
per_pixel_12=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_13=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * b1;
per_pixel_14=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_15=si3 = 100 * -pow(q5, 3);
per_pixel_16=dx = 2 * (si1 * sin(y1 - y) * m1 * d1 - si2 * sin(y2 - y) * m1 * d2 + si3 * cos(dir) * t1);
per_pixel_17=dy = 2 * (-si1 * sin(x1 - x) * m1 * d1 + si2 * sin(x2 - x) * m1 * d2 - si3 * sin(dir) * t1);
per_pixel_18=x = x - 0.5;
per_pixel_19=n = 20 + 0 * bass;
per_pixel_20=t = 1 * time;
per_pixel_21=m = 1 - si1 - si2;
per_pixel_22=dx = dx + 0.002 * (cos((-x + y) * n + t) + sin((x + y - 1) * n + t)) * m;
per_pixel_23=dy = dy + 0.002 * (cos((x - y) * n - t) + sin((-x - y + 1) * n - t)) * m;

[warp_shader]
shader_body { 
  vec3 z_1;
  vec3 tmpvar_2;
  vec2 tmpvar_3;
  tmpvar_3 = (0.1 * texsize.zw);
  tmpvar_2 = (0.25 * ((
    (texture (sampler_main, (uv + tmpvar_3)).xyz + texture (sampler_main, (uv + (tmpvar_3 * vec2(-1.0, 1.0)))).xyz)
   + texture (sampler_main, 
    (uv + (tmpvar_3 * vec2(1.0, -1.0)))
  ).xyz) + texture (sampler_main, (uv - tmpvar_3)).xyz));
  z_1.x = (tmpvar_2.x + ((
    -(((tmpvar_2.x * tmpvar_2.y) * tmpvar_2.y))
   + 
    (0.035 * (1.0 - tmpvar_2.x))
  ) * 4.0));
  z_1.y = (tmpvar_2.y + ((
    ((tmpvar_2.z * tmpvar_2.y) * tmpvar_2.z)
   - 
    (0.165 * tmpvar_2.y)
  ) * 4.0));
  z_1.z = tmpvar_2.z;
  z_1.x = (z_1.x + (0.4 * (
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
   - texture (sampler_main, uv).xyz)).x);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (z_1 + (0.09 * (
    (texture (sampler_noise_lq, (((uv * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz * 2.0)
   - 1.0)));
  ret = tmpvar_4.xyz;
 }

[comp_shader]
uniform sampler2D sampler_smalltiled_colors3;
 shader_body { 
  vec2 tmpvar_1;
  tmpvar_1 = (texsize.zw * 4.0);
  vec2 tmpvar_2;
  tmpvar_2.x = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  tmpvar_2.y = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * tmpvar_1))
  ).xyz * scale1) + bias1)).y;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (texture (sampler_smalltiled_colors3, (uv - (tmpvar_2 * 0.4))) * (vec4(1.0, 1.0, 1.0, 1.0) - vec4((texture (sampler_main, uv).y * 0.4)))).xyz;
  ret = tmpvar_3.xyz;
 }
