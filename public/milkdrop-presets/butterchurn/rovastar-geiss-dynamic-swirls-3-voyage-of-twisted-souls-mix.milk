[preset00]
fRating=5.000000
fGammaAdj=1.993000
nWaveMode=7.000000
bWaveThick=1.000000
bTexWrap=0.000000
fWaveAlpha=0.608039
fWaveScale=0.634243
fWaveSmoothing=0.100000
fWaveParam=0.500000
fWarpScale=1.331000
fZoom=1.004960
fWarp=0.000156
fSx=0.999666
fSy=0.999900
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fWaveY=0.360000
fOuterBorderR=1.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.015000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.150000
fMotionVectorsR=0.000000
fMotionVectorsG=0.000000
fMotionVectorsA=0.400000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=du = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=oldq8 = 0;
per_frame_init_4=mult = 0;
per_frame_init_5=ang2 = 0;
per_frame_init_6=dv = 0;
per_frame_init_7=q4 = 0;
per_frame_init_8=q2 = 0;
per_frame_init_9=dist = 0;
per_frame_init_10=q3 = 0;
per_frame_init_11=q8 = 0;
per_frame_1=ob_r = 0.7 - 0.3 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_2=ob_g = 0.5 - 0.48 * sin(1.324 * time);
per_frame_3=ob_b = 0.5 - 0.48 * cos(1.316 * time);
per_frame_4=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_5=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_6=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_7=mv_r = wave_r;
per_frame_8=mv_b = wave_b;
per_frame_9=mv_g = wave_g;
per_frame_10=q8 = oldq8 + if(0.00001 < abs(above(bass + bass_att, 2.8)), q8 + 0.005 * pow(bass + bass_att, 5), 0);
per_frame_11=oldq8 = q8;
per_frame_12=monitor = sin(q8);
per_frame_13=q1 = 0.62 * (0.6 * sin(0.374 * q8) + 0.4 * sin(0.294 * q8));
per_frame_14=q2 = 0.62 * (0.6 * sin(0.393 * q8) + 0.4 * sin(0.223 * q8));
per_frame_15=q3 = 0.62 * (0.6 * sin(0.174 * -q8) + 0.4 * sin(0.364 * q8));
per_frame_16=q4 = 0.62 * (0.6 * sin(0.234 * q8) + 0.4 * sin(0.271 * -q8));
per_pixel_1=du = 2 * x - 1 - q1;
per_pixel_2=dv = 2 * y - 1 - q2;
per_pixel_3=dist = sqrt(du * du + dv * dv);
per_pixel_4=ang2 = atan2(du, dv);
per_pixel_5=mult = 0.008 / (dist + 0.4);
per_pixel_6=dx = mult * sin(ang2 - 1.5);
per_pixel_7=dy = mult * cos(ang2 - 1.5);
per_pixel_8=du = 2 * x - 1 - q3;
per_pixel_9=dv = 2 * y - 1 - q4;
per_pixel_10=dist = sqrt(du * du + dv * dv);
per_pixel_11=ang2 = atan2(du, dv);
per_pixel_12=mult = 0.008 * sin(q8) / (dist + 0.4);
per_pixel_13=dx = dx + mult * sin(ang2 + 1.5);
per_pixel_14=dy = dy + mult * cos(ang2 + 1.5);
per_pixel_15=dx = dx * aspectx;
per_pixel_16=dy = dy * aspecty;
per_pixel_17=rot = abs(3 * dx) - abs(3 * dy);
per_pixel_18=zoom = 1 + abs(3 * dx) - abs(3 * dy);
per_pixel_19=zoomexp = 1 + abs(300 * dx - 300 * dy);
