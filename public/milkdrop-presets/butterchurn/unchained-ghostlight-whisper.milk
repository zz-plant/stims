per_frame_init_1=bass_residual = 0;
per_frame_init_2=gridx = 0;
per_frame_init_3=old_treb_flop = 0;
per_frame_init_4=bass_flop = 0;
per_frame_init_5=grid = 0;
per_frame_init_6=q6 = 0;
per_frame_init_7=q1 = 0;
per_frame_init_8=q5 = 0;
per_frame_init_9=treb_flop = 0;
per_frame_init_10=bass_thresh = 0;
per_frame_init_11=old_bass_flop = 0;
per_frame_init_12=treb_thresh = 0;
per_frame_init_13=pulse = 0;
per_frame_init_14=bass_changed = 0;
per_frame_init_15=mid_thresh = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=mid_changed = 0;
per_frame_init_18=entropy = 0;
per_frame_init_19=old_mid_flop = 0;
per_frame_init_20=mid_residual = 0;
per_frame_init_21=treb_residual = 0;
per_frame_init_22=chaos = 0;
per_frame_init_23=mid_flop = 0;
per_frame_init_24=q2 = 0;
per_frame_init_25=gridy = 0;
per_frame_init_26=treb_changed = 0;
per_frame_init_27=q3 = 0;
per_frame_init_28=q7 = 0;
per_frame_init_29=q8 = 0;
per_frame_init_30=entropy = 2;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(equal(pulse, -20)), 1 + bass_flop + treb_flop + mid_flop + randint(2), entropy);
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(0.1 * pulse * entropy) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(0.1 * pulse * entropy) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(0.1 * pulse * entropy) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.01 * (bass_thresh + mid_thresh + treb_thresh));
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = cos(pulse / 2 + q1);
per_frame_25=q6 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_26=q7 = entropy;
per_frame_27=q8 = sin(q6 * q1 + q7 * q2);
per_frame_28=wave_r = wave_r + 0.5 * sin(q1 + 2 * q2 + 2.1 * q4);
per_frame_29=wave_b = wave_b + 0.5 * sin(q2 + 2 * q3 + 2.2 * q4);
per_frame_30=wave_g = wave_g + 0.5 * sin(q3 + 2 * q1 + 2.3 * q4);
per_frame_31=mv_r = mv_r + 0.5 * sin(q4 + 1.14 * q5 * q1);
per_frame_32=mv_b = mv_b + 0.5 * sin(q4 + 1.14 * q5 * q2);
per_frame_33=mv_g = mv_g + 0.5 * sin(q5 + 1.14 * q5 * q3);
per_frame_34=mv_a = mv_a + mv_a * sin(q2 + q3 + 1.14 * q5);
per_frame_35=mv_l = 2 * q7;
per_frame_36=wave_x = wave_x + 0.03 * q7 * q4;
per_frame_37=wave_y = wave_x + 0.01 * q6 * q5;
per_frame_38=mv_x = q6 * q7;
per_frame_39=mv_y = q6 * q7;
per_frame_40=zoom = zoom + 0.01 * q1;
per_pixel_1=gridx = bnot(mod(q7 * sin(3.14 * x), 2));
per_pixel_2=gridy = bnot(mod(q7 * sin(3.14 * y), 2));
per_pixel_3=dx = 0.01 * sin((y - 0.5) * q1 * 6.2) + q5 * sin((y - 0.5) * q2 * 6.2) * 0.01;
per_pixel_4=dy = 0.01 * cos((x - 0.5) * q2 * 6.2) + q4 * cos((x - 0.5) * q1 * 6.2) * 0.01;
per_pixel_5=grid = sin(sigmoid(sin(6.28 * y * q2), sin(6.28 * x * q5)) * (10 + q7));
per_pixel_6=rot = rot * sign(grid) * q4;
per_pixel_7=sx = sx + 0.03 * grid;
