per_frame_9=ltreb = w4 + w3;
per_frame_10=lbass = w1 + w2;
per_frame_11=avgdb = 0.9 * avgdb + 0.1 * abs(db);
per_frame_12=avgdt = 0.9 * avgdt + 0.1 * abs(dt);
per_frame_13=rawbeatb = above(time - lbbtime, 0.75 * avgbbeatrate);
per_frame_14=beatb = rawbeatb * above(abs(dt), 3 * avgdt);
per_frame_15=beatb2 = rawbeatb * above(abs(db), 3 * avgdb);
per_frame_16=beat = max(beatb2, beatb);
per_frame_17=avgbbeatrate = beat * (0.99 * avgbbeatrate + 0.01 * (time - lbbtime)) + (1 - beat) * (avgbbeatrate + 0.00001 * (3 - avgbbeatrate));
per_frame_18=lbbtime = time * beat + (1 - beat) * lbbtime;
per_frame_19=ph = (time - lbbtime) * (60 / avgbbeatrate) * const;
per_frame_20=phase = max(min(ph, 1), 0);
per_frame_21=const = const * (1 - beatb2) + beatb2 * (const + 0.001 * bool);
per_frame_22=bool = below(phase, 0.98) * (0.99 - ph) - 0.5 * above(phase, 0.98) * ph;
per_frame_23=bc = bc + beatb;
per_frame_24=zoom = 1 + below(w1, 0);
per_frame_25=vol = beatb * (w1 + w4 + w2 + w3) * 0.1;
per_frame_26=avgvol = 0.999 * avgvol + 0.01 * vol;
per_frame_27=monitor = avgvol;
per_frame_28=mtime = mtime + (min(0.05 * avgdt, 0.5) + avgvol) * (1 / fps);
per_frame_29=mtime2 = mtime2 + (min(0.05 * avgdb, 0.5) + avgvol) * (1 / fps);
per_frame_30=mtime3 = mtime3 + beatb * db * (1 / fps);
per_frame_31=mtime4 = mtime4 + beatb2 * dt * (1 / fps);
