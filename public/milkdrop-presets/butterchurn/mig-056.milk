[preset00]
fRating=5.000000
fDecay=1.000000
nWaveMode=3.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=11.940000
fWaveScale=0.387000
fWaveSmoothing=0.700000
fWarpScale=1.772000
fZoomExponent=4.401000
fZoom=1.031000
fRot=0.003000
fWarp=0.000000
fWaveR=0.490000
fWaveG=0.490000
fWaveB=0.490000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=t = 0;
per_frame_1=t = 2.3 * time;
per_frame_2=wave_x = wave_x + 0.35 * (0.7 * sin(2.221 * time) + 0.3 * sin(1.821 * time));
per_frame_3=wave_y = wave_y + 0.35 * (0.3 * sin(1.942 * time) + 0.7 * sin(2.522 * time));
per_frame_4=wave_r = wave_r + 0.79 * (0.6 * sin(0.823 * t) + 0.4 * sin(0.916 * t));
per_frame_5=wave_g = wave_g + 0.79 * (0.6 * sin(0.9 * t) + 0.4 * sin(1.023 * t));
per_frame_6=wave_b = wave_b + 0.79 * (0.6 * sin(0.808 * t) + 0.4 * sin(0.949 * t));
per_frame_7=rot = rot + 0.01 * (0.6 * sin(0.038 * time) + 0.4 * sin(0.054 * time));
per_frame_8=dx = dx + 0.002 * (0.6 * sin(0.434 * time) + 0.4 * sin(0.277 * time));
per_frame_9=dy = dy + 0.002 * (0.6 * sin(0.384 * time) + 0.4 * sin(0.477 * time));

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xxx - 0.5)
   / 256.0) * 2.0));
  vec2 x_2;
  x_2 = (uv - uv_orig);
  ret_1 = (ret_1 * (0.97 + (0.03 * 
    clamp ((sqrt(dot (x_2, x_2)) * 200.0), 0.0, 1.0)
  )));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (((
    (texture (sampler_main, uv).xyz * -2.0)
   + 
    (((texture (sampler_blur1, uv).xyz * scale1) + bias1) * 2.0)
  ) + (
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
   * 2.0)) - 0.7);
  ret = tmpvar_1.xyz;
 }
