wave_0_per_point7=scale = scale * bass_att * bass_att * 0.5;
wave_0_per_point8=xp = xp * (1 + scale);
wave_0_per_point9=yp = yp * (1 + scale);
wave_0_per_point10=ang = n;
wave_0_per_point11=xr = xp * sin(ang) + zp * cos(ang);
wave_0_per_point12=yr = yp;
wave_0_per_point13=zr = xp * cos(ang) - zp * sin(ang);
wave_0_per_point14=xr = xr + 0.11;
wave_0_per_point15=ang = 4 * q1;
wave_0_per_point16=xp = xr * sin(ang) + zr * cos(ang);
wave_0_per_point17=yp = yr;
wave_0_per_point18=zp = xr * cos(ang) - zr * sin(ang);
wave_0_per_point19=zp = zp - 0.3;
wave_0_per_point20=ang = 0.4 * q1;
wave_0_per_point21=xq = xp;
wave_0_per_point22=yq = yp * sin(ang) + zp * cos(ang);
wave_0_per_point23=zq = yp * cos(ang) - zp * sin(ang);
wave_0_per_point24=ang = 1.1 * q1;
wave_0_per_point25=xp = xq * sin(ang) + zq * cos(ang);
wave_0_per_point26=yp = yq;
wave_0_per_point27=zp = xq * cos(ang) - zq * sin(ang);
wave_0_per_point28=zp = zp + 1.1;
wave_0_per_point29=xs = xp / zp;
wave_0_per_point30=ys = yp / zp;
wave_0_per_point31=flip = if(0.00001 < abs(above(sample, 0.5)), -1, 1);
wave_0_per_point32=x = xs * flip + 0.5;
