wave_0_per_point34=r = 0.5 * sin(time) + 0.5;
wave_0_per_point35=g = 0.5 * sin(time + 2.1) + 0.5;
wave_0_per_point36=b = 0.5 * sin(time + 4.2) + 0.5;
