shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=zoom = zoom + 0.01 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.01 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=decay = decay - 0.01 * equal(mod(frame, 5), 0);
per_pixel_1=rot = rot + 0.16 * sin(-3.3 * time + 11 * rad) * (1.3 - rad);
per_pixel_2=zoom = zoom + 0.04 * sin(1.2 * time + 18.84 * ang);
