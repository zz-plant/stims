  tmpvar_6 = fract(((
    (0.5 + ((uv - 0.5) * 0.996))
   - 
    (vec2(0.0, 1.0) * texsize.zw)
  ) - (
    (tmpvar_5 * texsize.zw)
   * 4.0)));
  ret_1.x = texture (sampler_main, tmpvar_6).x;
  ret_1.x = (ret_1.x + ((
    (ret_1.x - ((texture (sampler_blur2, tmpvar_6).xyz * scale2) + bias2))
  .x * 0.4) + 0.004));
