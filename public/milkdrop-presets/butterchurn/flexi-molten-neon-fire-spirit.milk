  tmpvar_7.y = tmpvar_4.y;
  vec2 tmpvar_8;
  tmpvar_8.x = tmpvar_4.z;
  tmpvar_8.y = -(tmpvar_3.z);
  ret_1.y = max (((
    clamp ((((texture (sampler_blur1, uv_orig).xyz * scale1) + bias1).x - 0.4), 0.0, 1.0)
   * 1.2) * ret_1.x), (texture (sampler_fc_main, (
    ((uv + (vec2(0.0, 2.0) * texsize.zw)) - ((tmpvar_7 * texsize.zw) * 2.0))
