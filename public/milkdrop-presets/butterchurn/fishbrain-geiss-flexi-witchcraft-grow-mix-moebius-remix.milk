per_frame_1=min_att = 2.5;
per_frame_2=decay_to = 0.8;
per_frame_3=decay_rate = pow(0.999, fps);
per_frame_4=beat = bass / max(min_att, bass_att);
per_frame_5=beat = max(beat, mid / max(min_att, mid_att));
per_frame_6=beat = max(beat, treb / max(min_att, treb_att));
per_frame_7=beat = max(beat, (prev_beat - decay_to) * decay_rate + decay_to);
per_frame_8=beat_level = 24 * (beat - prev_beat - 0.03);
per_frame_9=is_beat = above(beat_level, 0.5);
per_frame_10=prev_beat = beat;
per_frame_11=q7 = 3 * (max(max(bass / bass_att, treb / treb_att), mid / mid_att) - 0.82);
per_frame_12=q7 = max(0, min(1, q7));
per_frame_13=scale = 1;
per_frame_14=angle = 0.2 * time;
per_frame_15=translation_x = 0;
per_frame_16=translation_y = 0.12;
per_frame_17=a_r = cos(angle) * scale;
per_frame_18=a_i = sin(angle) * scale;
per_frame_19=b_r = translation_x;
per_frame_20=b_i = translation_y;
per_frame_21=scale = 1;
per_frame_22=angle = 0.3 * sin(0.1337 * time);
per_frame_23=translation_u = 0;
per_frame_24=translation_v = -0.2;
per_frame_25=q15 = cos(angle) * scale;
per_frame_26=q16 = sin(angle) * scale;
per_frame_27=q17 = translation_u;
per_frame_28=q18 = translation_v;
per_frame_29=c_inv_r = q15 / (q15 * q15 + q16 * q16);
per_frame_30=c_inv_i = q16 / (q15 * q15 + q16 * q16);
per_frame_31=q11 = a_r * c_inv_r - a_i * c_inv_i;
per_frame_32=q12 = a_r * c_inv_i - a_i * c_inv_r;
per_frame_33=bcad_r = b_r * q15 - b_i * q16 - (a_r * q17 - a_i * q18);
per_frame_34=bcad_i = b_r * q16 - b_i * q15 - (a_r * q18 - a_i * q17);
per_frame_35=q13 = bcad_r * c_inv_r - bcad_i * c_inv_i;
per_frame_36=q14 = bcad_r * c_inv_i - bcad_i * c_inv_r;
