wave_3_init4=q7 = 0;
wave_3_per_frame1=a = q7;
wave_3_per_point1=ma = ma + 3.1415 * above(bass, 0.5) * 0.02 * bass;
wave_3_per_point2=ma = ma - 3.1415 * above(treb, 0.5) * 0.02 * treb;
wave_3_per_point3=mx = mx + 0.0008 * cos(ma);
wave_3_per_point4=my = my + 0.0008 * sin(ma);
wave_3_per_point5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
wave_3_per_point6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
wave_3_per_point7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
wave_3_per_point8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
wave_3_per_point9=x = mx;
wave_3_per_point10=y = my;

[warp_shader]
shader_body { 
  vec4 lums_1;
  vec3 tmpvar_2;
  tmpvar_2.z = 0.0;
  tmpvar_2.xy = texsize.zw;
  vec3 tmpvar_3;
  tmpvar_3 = (tmpvar_2 * 4.0);
  lums_1.x = dot (texture (sampler_main, (uv + (texsize.zw * tmpvar_3.xz))).xyz, vec3(0.32, 0.49, 0.29));
  lums_1.y = dot (texture (sampler_main, (uv - (texsize.zw * tmpvar_3.xz))).xyz, vec3(0.32, 0.49, 0.29));
  lums_1.z = dot (texture (sampler_main, (uv + (texsize.zw * tmpvar_3.zy))).xyz, vec3(0.32, 0.49, 0.29));
  lums_1.w = dot (texture (sampler_main, (uv - (texsize.zw * tmpvar_3.zy))).xyz, vec3(0.32, 0.49, 0.29));
  vec2 tmpvar_4;
  tmpvar_4.x = (lums_1.x - lums_1.y);
  tmpvar_4.y = (lums_1.z - lums_1.w);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = (texture (sampler_fc_main, (uv + (
    (((clamp (
      ((((2300.0 * tmpvar_4) / 4.0) * 0.5) + 0.5)
    , 0.0, 1.0) * 2.0) - 1.0) * 1.4)
   * texsize.zw))).xyz * 0.965);
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec2 moebius_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3.x = q11;
  tmpvar_3.y = q12;
  vec2 tmpvar_4;
  tmpvar_4.x = q17;
  tmpvar_4.y = q18;
  vec2 tmpvar_5;
  tmpvar_5 = (uv - 0.5);
  vec2 tmpvar_6;
  tmpvar_6.x = ((tmpvar_5.x * q15) - (tmpvar_5.y * q16));
  tmpvar_6.y = ((tmpvar_5.x * q16) - (tmpvar_5.y * q15));
  vec2 tmpvar_7;
  tmpvar_7 = ((tmpvar_6 * aspect.yx) + tmpvar_4);
  vec2 tmpvar_8;
  tmpvar_8.x = ((q13 * tmpvar_7.x) + (q14 * tmpvar_7.y));
  tmpvar_8.y = ((q14 * tmpvar_7.x) - (q13 * tmpvar_7.y));
  moebius_1 = (0.5 + ((
    (1.0 - abs(((
      fract((((tmpvar_8 / 
        ((tmpvar_7.x * tmpvar_7.x) + (tmpvar_7.y * tmpvar_7.y))
      ) + tmpvar_3) * 0.5))
     * 2.0) - 1.0)))
   - 0.5) * 0.99));
  ret_2 = ((texture (sampler_main, moebius_1).xyz * 1.5) - 0.1);
  ret_2 = (ret_2 + (vec3(0.4, 0.256, 0.08000001) * (
    (texture (sampler_blur1, moebius_1).xyz * scale1)
   + bias1)));
  vec3 tmpvar_9;
  tmpvar_9 = mix (ret_2, ((
    ((texture (sampler_blur3, moebius_1).xyz * scale3) + bias3)
   * 
    (1.0 - (rad * 1.2))
  ) * 1.5), vec3(rad));
  ret_2 = tmpvar_9;
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = tmpvar_9;
  ret = tmpvar_10.xyz;
 }
