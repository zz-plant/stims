per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.91 * (bass_thresh - 1.3) + 1.3);
per_frame_2=wave_r = 0.5 + 0.5 * (0.6 * sin(1.3 * time) + 0.4 * sin(0.98 * time));
per_frame_3=wave_b = 0.5 + 0.5 * (0.6 * sin(1.1 * time) + 0.4 * sin(0.78 * time));
per_frame_4=wave_g = 0.5 + 0.5 * (0.6 * sin(1.2 * time) + 0.4 * sin(0.6 * time));
per_frame_5=q8 = wave_r;
per_frame_6=q7 = wave_b;
per_frame_7=q6 = wave_g;
per_frame_8=wr = 0.5 + 0.4 * (0.6 * sin(0.2 * time) + 0.4 * sin(0.8 * time));
per_frame_9=wb = 0.5 + 0.4 * (0.6 * sin(0.377 * time) + 0.4 * sin(0.5 * time));
per_frame_10=wg = 0.5 + 0.4 * (0.6 * sin(0.7 * time) + 0.4 * sin(0.4 * time));
