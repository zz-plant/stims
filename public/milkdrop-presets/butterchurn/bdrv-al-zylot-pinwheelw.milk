per_frame_init_1=dx_r = 0;
per_frame_init_2=dy_r = 0;
per_frame_init_3=q8 = 0;
per_frame_1=warp = 0;
per_frame_2=decay = 0.92;
per_pixel_1=zoom = zoom + 0.1;
per_pixel_2=rot = rot + 0.1 * rad;
per_pixel_3=rot = rot + 0.005 * cos(5 * ang * bass * time);
per_pixel_4=dx = dx + 0.1 * above(rad, 0.25) * dx_r;
per_pixel_5=dy = dy + 0.1 * above(rad, 0.25) * dy_r;
per_pixel_6=rot = 0.1 * pow(-ang, 3) - 1.18 * sin(ang);
per_pixel_7=zoom = 1.45 * sin(-rad) + 1.3 + sin(rad);
per_pixel_8=dx = dx + 0.09 * sin(0.785 * q8);
per_pixel_9=dy = dy + 0.09 * sin(0.675 * q8);
per_pixel_10=zoom = -0.0251 + zoom + abs(0.1 * tan(1.9 - rad));
shape_0_per_frame1=ang = ang + time;
shape_1_per_frame1=ang = ang - 0.333 * time;
shape_2_per_frame1=ang = ang + 4 * time;
