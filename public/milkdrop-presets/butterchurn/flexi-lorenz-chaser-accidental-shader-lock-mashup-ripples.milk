shape_0_per_frame1=xx1 = if(0.00001 < abs(equal(instance, 0)), q11, xx1);
shape_0_per_frame2=yy1 = if(0.00001 < abs(equal(instance, 0)), q12, yy1);
shape_0_per_frame3=zz1 = if(0.00001 < abs(equal(instance, 0)), q13, zz1);
shape_0_per_frame4=dx1 = q14 * (yy1 - xx1);
shape_0_per_frame5=dy1 = xx1 * (q15 - zz1) - yy1;
shape_0_per_frame6=dz1 = xx1 * yy1 - q16 * zz1;
shape_0_per_frame7=dd = sqrt(dx1 * dx1 + dy1 * dy1 + dz1 * dz1);
shape_0_per_frame8=xx1 = xx1 + q17 * dx1 / dd;
shape_0_per_frame9=yy1 = yy1 + q17 * dy1 / dd;
shape_0_per_frame10=zz1 = zz1 + q17 * dz1 / dd;
shape_0_per_frame11=my_x = 0.1 * xx1;
shape_0_per_frame12=my_y = 0.1 * yy1;
shape_0_per_frame13=my_z = 0.1 * zz1 - 3;
shape_0_per_frame14=d = 4.75;
shape_0_per_frame15=zoom = 0.55 + 0.25 * sin(0.5 * q32);
shape_0_per_frame16=w1 = q3;
shape_0_per_frame17=w2 = q4;
shape_0_per_frame18=w3 = q5;
shape_0_per_frame19=x1 = cos(w1) * my_x + sin(w1) * my_y;
shape_0_per_frame20=y1 = -sin(w1) * my_x + cos(w1) * my_y;
shape_0_per_frame21=z1 = my_z;
shape_0_per_frame22=x2 = cos(w2) * x1 + sin(w2) * z1;
shape_0_per_frame23=z2 = -sin(w2) * x1 + cos(w2) * z1;
shape_0_per_frame24=y2 = y1;
shape_0_per_frame25=y3 = cos(w3) * y2 + sin(w3) * z2;
shape_0_per_frame26=z3 = -sin(w3) * y2 + cos(w3) * z2;
shape_0_per_frame27=x3 = x2;
shape_0_per_frame28=l = sqrt(x3 * x3 + y3 * y3);
shape_0_per_frame29=w = atan2(x3, y3);
shape_0_per_frame30=p = tan(asin(1) + atan2(d + z3, l));
shape_0_per_frame31=d = sqrt(x3 * x3 + y3 * y3 + (z3 + d) * (z3 + d));
shape_0_per_frame32=my_x = zoom * sin(w) * p;
shape_0_per_frame33=my_y = zoom * cos(w) * p;
shape_0_per_frame34=x = 0.5 + my_x;
shape_0_per_frame35=y = 0.5 + my_y;
shape_0_per_frame36=rad = rad / d;
shape_0_per_frame37=ang = ang - instance / num_inst * asin(1) * 8;

[warp_shader]
vec2 xlat_mutabled;
vec2 xlat_mutabled_uv;
vec3 xlat_mutabledx;
vec3 xlat_mutabledy;
 shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_noise_lq, ((
    (uv_orig * texsize.xy)
   * texsize_noise_lq.zw) + rand_frame.xy)) - 0.5).xyz;
  xlat_mutabled = (texsize.zw * 4.0);
  xlat_mutabledx = (((texture (sampler_blur1, 
    (uv_orig + (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv_orig - (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  xlat_mutabledy = (((texture (sampler_blur1, 
    (uv_orig + (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv_orig - (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_3;
  tmpvar_3.x = xlat_mutabledx.x;
  tmpvar_3.y = xlat_mutabledy.x;
  xlat_mutabled_uv = (uv_orig + ((tmpvar_3 * texsize.zw) * 4.0));
  ret_1.x = texture (sampler_main, xlat_mutabled_uv).x;
  ret_1.x = (ret_1.x + ((
    ((ret_1.x - ((texture (sampler_blur1, xlat_mutabled_uv).xyz * scale1) + bias1).x) * 0.04)
   - 0.006) + (tmpvar_2 * 0.01)).x);
  vec2 tmpvar_4;
  tmpvar_4.x = xlat_mutabledx.y;
  tmpvar_4.y = xlat_mutabledy.y;
  vec2 tmpvar_5;
  tmpvar_5.x = xlat_mutabledx.x;
  tmpvar_5.y = xlat_mutabledy.x;
  vec2 tmpvar_6;
  tmpvar_6 = (uv - ((
    (vec2(0.0, -1.2) + (tmpvar_4 * 8.0))
   + 
    (tmpvar_5 * 4.0)
  ) * texsize.zw));
  ret_1.y = (max (texture (sampler_main, tmpvar_6).x, (texture (sampler_main, tmpvar_6).y - 0.0012)) + (tmpvar_2 * 0.08)).x;
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_1;
  ret = tmpvar_7.xyz;
 }

[comp_shader]
vec2 xlat_mutabled;
vec2 xlat_mutabled_uv;
 shader_body { 
  vec3 ret_1;
  ret_1 = ((texture (sampler_blur3, uv).xyz * scale3) + bias3);
  vec2 tmpvar_2;
  tmpvar_2 = mix (uv, ((uv * 
    (1.0 - (0.15 * ((texture (sampler_blur1, 
      clamp (ret_1.xy, 0.0, 1.0)
    ).xyz * scale1) + bias1)))
  .xy) + (0.075 * 
    ((texture (sampler_blur1, clamp (ret_1.xy, 0.0, 1.0)).xyz * scale1) + bias1)
  ).xy), vec2(0.75, 0.75));
  xlat_mutabled = (texsize.zw * 4.0);
  vec2 tmpvar_3;
  tmpvar_3.x = (((texture (sampler_blur1, 
    (tmpvar_2 + (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_2 - (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1)).x;
  tmpvar_3.y = (((texture (sampler_blur1, 
    (tmpvar_2 + (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (tmpvar_2 - (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1)).x;
  xlat_mutabled_uv = (tmpvar_2 + (tmpvar_3 * 0.03));
  vec3 tmpvar_4;
  tmpvar_4 = mix (((texture (sampler_blur2, xlat_mutabled_uv).xyz * scale2) + bias2), texture (sampler_main, xlat_mutabled_uv).xyz, vec3(0.4, 0.4, 0.4));
  ret_1 = (((tmpvar_4.y - 
    (tmpvar_4.x * 0.5)
  ) * mix (vec3(0.2, 0.7, 1.25), vec3(1.0, 1.0, 1.0), tmpvar_4.xxx)) * 1.4);
  vec3 tmpvar_5;
  tmpvar_5 = mix (mix (ret_1, vec3(-0.1, -0.1, 0.1), vec3((
    ((texture (sampler_blur1, (xlat_mutabled_uv - (texsize.zw * 32.0))).xyz * scale1) + bias1)
  .z * 0.6))), vec3(1.5, 1.5, 2.0), vec3((texture (sampler_main, uv).z * 0.36)));
  ret_1 = tmpvar_5;
