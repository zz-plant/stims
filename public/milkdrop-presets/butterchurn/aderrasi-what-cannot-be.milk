[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=2.216706
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=2.000000
nWaveMode=7.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=100.000000
fWaveScale=3.749272
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fWaveY=0.990000
fOuterBorderSize=0.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_init_4=nx = 0;
per_frame_init_5=ny = 0;
per_frame_1=wave_r = wave_r + 0.35 * sin(1.4 * time) + 0.25 * sin(2.5 * time);
per_frame_2=wave_g = wave_g + 0.35 * sin(1.7 * time) - 0.25 * sin(1.11 * time);
per_frame_3=wave_b = wave_b + 0.35 * sin(1.84 * time) + 0.25 * sin(2.3 * time);
per_frame_4=warp = 0;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=dy = dy + dy_r + 0.005 * below(y, 0.5);
per_pixel_5=dy = dy - dy_r - 0.005 * above(y, 0.5);
per_pixel_6=dx = dx + dx_r + 0.005 * above(y, sin(time)) - 0.005 * below(y, 0.8 * sin(time));
per_pixel_7=dx = dx + dx_r + 0.005 * above(y, 0.76 * sin(1.2 * time)) - 0.005 * below(y, 0.55 * sin(2 * time));
per_pixel_8=nx = 0.8 * x * sin(time) - 0.4 * x * sin(1.22 * time);
per_pixel_9=ny = 0.8 * y * cos(time) - 0.4 * y * cos(1.4 * time);
per_pixel_10=zoom = zoom + if(0.00001 < abs(below(rad, 0.4)), 0.05 - rad, 0);
per_pixel_11=zoom = zoom + if(0.00001 < abs(below(rad, 0.2)), 0.1 - rad, 0);
