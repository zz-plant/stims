shape_1_init9=var = 0;
shape_1_init10=var = 0;
shape_1_init11=var = 0;
shape_1_init12=alpha = 0;
shape_1_init13=alpha = 0;
shape_1_per_frame1=ang = 0.4 * bass * above(bass, 0.9);
shape_1_per_frame2=angvar = above(bass, 0.9);
shape_1_per_frame3=x = if(0.00001 < abs(angvar - 0.3 + 0.1 * (0.5 * sin(time) + 0.5)), 0.5 + 0.03 * (0.5 * sin(time) + 0.5), 0.5);
shape_1_per_frame4=y = if(0.00001 < abs(angvar - 0.3 + 0.1 * (0.5 * sin(time) + 0.5)), 0.5 + 0.03 * (0.5 * sin(time) + 0.5), 0.5);
shape_1_per_frame5=var = 0.01 * sin(time / 2);
shape_1_per_frame6=var = 0.1 * (var + above(bass, 0.9));
shape_1_per_frame7=alpha = 0.8 * bass - 0.4 * below(bass, 0.4);
shape_1_per_frame8=r = 1 - 3 * var;
shape_1_per_frame9=g = 1 - var;
shape_1_per_frame10=b = 1 - 3.5 * var;
shape_1_per_frame11=r2 = 1 - 2 * var;
shape_1_per_frame12=g2 = g;
shape_1_per_frame13=b2 = b;
shape_1_per_frame14=a = 0.9 * alpha;
shape_1_per_frame15=a2 = 0.9 * alpha;
shape_1_per_frame16=border_a = 0;
shape_2_per_frame1=r = 1 - 0.3 * sin(time);
shape_2_per_frame2=g2 = 1 - 0.3 * cos(time);
shape_2_per_frame3=x = 0.5 * sin(time) + 0.51;
shape_2_per_frame4=y = 0.5 * cos(time) + 0.51;
