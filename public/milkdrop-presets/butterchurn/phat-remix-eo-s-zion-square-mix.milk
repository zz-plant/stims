per_frame_init_1=dmt = 0;
per_frame_1=warp = 1;
per_frame_2=ib_r = 1 - 0.435 * (0.5 * sin(time) + 0.5);
per_frame_3=ib_g = 1 - 0.435 * (0.5 * cos(time) + 0.5);
per_frame_4=rot = 0.01;
per_pixel_1=dmt = 20 + 8 * (bass * bass * bass / 3) * above(bass, 1.1);
per_pixel_2=zoom = 1 + 0.4 * (sin(x * dmt + sin(time)) / 28 + cos(y * dmt + cos(time)) / 28);
per_pixel_3=dx = 0.01 * rad;
per_pixel_4=dy = 0.01 * rad;
per_pixel_5=dx = dx + 0.002 * above(bass, 0.9);
per_pixel_6=dy = dy + 0.002 * above(bass, 0.9);
shape_0_per_frame1=ang = sin(time / 2);
shape_0_per_frame2=r2 = 0.2 * (0.5 * sin(time) + 0.5);
shape_1_init1=angvar = 0;
shape_1_init2=angvar = 0;
shape_1_init3=angvar = 0;
shape_1_init4=var = 0;
shape_1_init5=var = 0;
shape_1_init6=var = 0;
