per_pixel_6=zoom = 1 + abs(0.01 * mod);
per_pixel_7=rad_cycle = rad * rad * x * 60 * rad * sin(q1);
per_pixel_8=rot = if(0.00001 < abs(above(q2, q8)), 0.06 * sin(rad_cycle - 3 * sin(q3) - x * ang * q3) * equal(rad, x + y) * sin(q6) - 0.3 * sin(q7), 0.02 * sin(q3));
per_pixel_9=zoom = if(0.00001 < abs(above(q2, q8)), 2 * rot * rad + 1 - 0.01 * q1 * rad - (x - 0.3 * sin(q4)) + 0.25 * x * sin(q2), 1.1);
per_pixel_10=zoomexp = 1 - 0.1 * rad;
per_pixel_11=dx = if(0.00001 < abs(above(q2, q8)), equal(x, rad) * sin(q3) / y * sin(q1), 0.009 * sin(q5) * x * rad + d * sin(q2));
per_pixel_12=dy = if(0.00001 < abs(above(q2, q8)), equal(y, rad) * sin(q2) / x * sin(q5), 0.009 * sin(q3) * y * rad + r * sin(q1));
per_pixel_13=d = above(y, sin(3 * ang + time));
per_pixel_14=r = above(y, sin(3 * ang + time));
per_pixel_15=tm = 3 * sin(0.5 * time);
per_pixel_16=tm2 = 3 * cos(time);
per_pixel_17=zooma = above(cos(18.84 * x + tm), 0) * above(cos(12.56 * y + tm2), 0);
