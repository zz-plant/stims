per_pixel_19=rd = sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5)));
per_pixel_20=cx = 0.5 + q4;
per_pixel_21=cy = 0.5 - q5;
per_pixel_22=zoom = 0.041 + 0.99 * zooma + 0.99 * (1 - zooma);
per_pixel_23=rot = 0.3 * zooma * rd;
