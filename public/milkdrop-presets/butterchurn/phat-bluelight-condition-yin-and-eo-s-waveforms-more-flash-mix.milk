wave_2_per_point9=dir = -1 + 2 * above(sum, -0.001);
wave_2_per_point10=xtrudx = (1 - mod(counter, 2)) * t3 * sample * cos(ang + 1.5707 * dir) * abs(value1 + value2);
wave_2_per_point11=xtrudy = (1 - mod(counter, 2)) * t3 * sample * sin(ang + 1.5707 * dir) * abs(value1 + value2);
