per_frame_init_1=d = 0;
per_frame_init_2=cx1 = 0;
per_frame_init_3=y3 = 0;
per_frame_init_4=y1 = 0;
per_frame_init_5=cy1 = 0;
per_frame_init_6=x1 = 0;
per_frame_init_7=x3 = 0;
per_frame_init_8=dir = 0;
per_frame_init_9=r = 0;
per_frame_init_10=x2 = 0;
per_frame_init_11=y2 = 0;
per_frame_1=ib_r = 0.3 * sin(5 * time) + 0.7;
per_frame_2=ib_g = 0.3 * sin(4 * time) + 0.3;
per_frame_3=ib_b = 0.5 * sin(4 * (time / 3)) + 0.5;
per_frame_4=wave_r = 1 - ib_r;
per_frame_5=wave_g = 1 - ib_g;
per_frame_6=wave_b = 1 - ib_b;
per_frame_7=wave_x = 0.5 + 0.3 * sin(3 * time);
per_frame_8=wave_y = 0.5 + 0.3 * cos(2.187 * time);
per_pixel_1=r = bass / 4;
per_pixel_2=cx1 = 0.5 + 0.2 * sin(0.618 * time);
per_pixel_3=cy1 = 0.5 + 0.2 * cos(1.618 * time);
per_pixel_4=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_5=dir = bass * (r * r - d * d) * 0.3;
per_pixel_6=x1 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_7=y1 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_8=cx1 = 0.5 + 0.3 * sin(2.618 * time);
per_pixel_9=cy1 = 0.5 + 0.3 * cos(3.14 * time);
per_pixel_10=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_11=dir = -mid * (r * r - d * d) * 0.3;
per_pixel_12=x2 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_13=y2 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_14=cx1 = 0.5 + 0.4 * sin(2.618 * -time);
per_pixel_15=cy1 = 0.5 + 0.4 * cos(1.14 * -time);
per_pixel_16=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_17=dir = -treb * (r * r - d * d) * 0.3;
per_pixel_18=x3 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_19=y3 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_20=dx = x1 + x2 + x3;
per_pixel_21=dy = y1 + y2 + y3;
shape_0_init1=vol = 0;
shape_0_init2=redsine = 0;
shape_0_init3=greensine = 0;
shape_0_init4=bluesine = 0;
shape_0_init5=redif = 0;
shape_0_init6=redsine = 0;
shape_0_init7=redif = 0;
shape_0_init8=redif = 0;
shape_0_init9=greenif = 0;
shape_0_init10=greensine = 0;
shape_0_init11=greenif = 0;
shape_0_init12=greenif = 0;
shape_0_init13=blueif = 0;
shape_0_init14=bluesine = 0;
shape_0_init15=blueif = 0;
shape_0_init16=blueif = 0;
shape_0_init17=redif = 0;
shape_0_init18=greenif = 0;
shape_0_init19=blueif = 0;
shape_0_per_frame1=vol = 0.3333 * (bass + mid + treb_att);
shape_0_per_frame2=redsine = 0.5 + 0.15 * bass * sin(3 * time);
shape_0_per_frame3=greensine = 0.5 + 0.15 * mid * sin(2 * time);
shape_0_per_frame4=bluesine = 0.5 + 0.15 * treb * sin(time);
shape_0_per_frame5=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.85 * redif));
shape_0_per_frame6=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.85 * greenif));
shape_0_per_frame7=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.85 * blueif));
shape_0_per_frame8=r = redif;
shape_0_per_frame9=g = greenif;
shape_0_per_frame10=b = blueif;
shape_0_per_frame11=r2 = sin(0.47 * time);
shape_0_per_frame12=g2 = sin(0.72 * time);
shape_0_per_frame13=b2 = sin(0.33 * time);
shape_0_per_frame14=tex_ang = 3.14 + 3.14 * sin(0.42 * time);
shape_0_per_frame15=ang = 3.14 + 3.14 * sin(0.55 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  vec2 tmpvar_2;
  tmpvar_2 = (uv - 0.5);
  tmpvar_1.xyz = (texture (sampler_main, ((
    ((tmpvar_2 * (0.97 + (rad * 0.02))) + 0.5)
   + 
    (((texture (sampler_blur1, (
      (tmpvar_2 * 0.9)
     + 0.5)).xyz * scale1) + bias1) * 0.1)
  .xy) - 0.01)).xyz - 0.001);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_blur1, uv).xyz * scale1)
   + bias1) * 3.0));
  ret_1 = (ret_1 + ((texture (sampler_blur2, 
    (((uv - 0.5) * 0.333) + 0.5)
  ).xyz * scale2) + bias2));
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
