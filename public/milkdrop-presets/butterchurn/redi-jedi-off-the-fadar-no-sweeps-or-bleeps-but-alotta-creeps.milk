per_frame_init_1=lbbtime = 0;
per_frame_init_2=bbtime = 0;
per_frame_init_3=beatb = 0;
per_frame_init_4=avgbeatrate = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=avgvol = 0;
per_frame_init_8=beatrate = 0;
per_frame_init_9=q4 = 0;
per_frame_init_10=lbass = 0;
per_frame_init_11=rawbeatb = 0;
per_frame_init_12=db = 0;
per_frame_init_13=vol = 0;
per_frame_init_14=bc = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=q3 = 0;
per_frame_init_17=mtime = 0;
per_frame_init_18=avgdb = 0;
per_frame_init_19=beatrate = 5;
per_frame_init_20=avgbeatrate = 1;
per_frame_init_21=bbtime = 1;
per_frame_init_22=lbbtime = 0.5;
per_frame_init_23=avgdb = 0.5;
per_frame_init_24=vol = 1;
per_frame_init_25=avgvol = 0.2;
per_frame_1=db = (bass - lbass) * fps;
per_frame_2=lbass = bass;
per_frame_3=avgdb = 0.99 * avgdb + 0.01 * abs(db);
per_frame_4=rawbeatb = above(db, 2 * avgdb);
per_frame_5=beatb = rawbeatb * above(time - lbbtime, 0.75 * avgbeatrate) * above(bass_att, 0.3);
per_frame_6=bbtime = time * beatb;
per_frame_7=beatrate = beatb * (bbtime - lbbtime) + (1 - beatb) * beatrate;
per_frame_8=avgbeatrate = beatb * (0.999 * avgbeatrate + 0.001 * beatrate) + (1 - beatb) * avgbeatrate;
per_frame_9=lbbtime = time * beatb + (1 - beatb) * lbbtime;
per_frame_10=bc = bc + beatb;
per_frame_11=vol = rawbeatb * (db - avgdb) * 0.01;
per_frame_12=avgvol = 0.99 * avgvol + 0.05 * vol;
per_frame_13=mtime = mtime + min(0.5 * avgvol, 0.25);
per_frame_14=q2 = mtime;
per_frame_15=q1 = beatb;
per_frame_16=q3 = db;
per_frame_17=q4 = 60 / avgbeatrate;
per_frame_18=q5 = equal(mod(bc, 4), 0) * beatb;
per_frame_19=zoom = 1;
per_frame_20=decay = 0.99;
per_frame_21=warp = 0;
per_frame_22=wrap = 1;
per_frame_23=ob_r = 0.5 * sin(0.01 * q2 + 0.01 * bass) + 0.5;
per_frame_24=ob_g = 0.5 * cos(0.001 * q2 * q4 + 0.01 * treb) + 0.5;
per_frame_25=ob_b = 0.5 * sin(0.001 * time * q4) + 0.5;
per_frame_26=echo_alpha = 0.5;
per_frame_27=echo_zoom = 0.2 * sin(q2) + 1;
per_pixel_1=zoom = 1 + 0.1 * sin(q2 + 6 * treb_att * rad);
per_pixel_2=rot = 0.1 * sin(0.05 * q2 * q4 + 3 * bass_att * rad);
wave_1_init1=y1 = 0;
wave_1_init2=time1 = 0;
wave_1_init3=sw6 = 0;
wave_1_init4=sw2 = 0;
wave_1_init5=ii = 0;
wave_1_init6=t5 = 0;
wave_1_init7=t1 = 0;
wave_1_init8=x1 = 0;
wave_1_init9=sw3 = 0;
wave_1_init10=sw5 = 0;
wave_1_init11=q1 = 0;
wave_1_init12=t3 = 0;
wave_1_init13=hue = 0;
wave_1_init14=q4 = 0;
wave_1_init15=time2 = 0;
wave_1_init16=i = 0;
wave_1_init17=x2 = 0;
wave_1_init18=t2 = 0;
wave_1_init19=y2 = 0;
wave_1_init20=q2 = 0;
wave_1_init21=h = 0;
wave_1_init22=sw1 = 0;
wave_1_init23=t4 = 0;
wave_1_init24=sw4 = 0;
wave_1_init25=time1 = 1000 * bass_att;
wave_1_init26=time2 = 1000 * treb_att;
wave_1_per_frame1=time1 = time1 + 0.001 * (0.4 * sin(q2 * q4 * 0.15) + 0.5) * q4 + q1 * bass;
wave_1_per_frame2=time2 = time2 + 0.001 * (0.4 * cos(q2 * q4 * 0.1) + 0.5) * q4 + q1 * treb;
wave_1_per_frame3=t1 = time1;
wave_1_per_frame4=t2 = time2;
wave_1_per_frame5=hue = 0.1 * q2;
wave_1_per_frame6=h = 6 * (hue - floor(hue));
wave_1_per_frame7=sw1 = below(h, 1);
wave_1_per_frame8=sw2 = (1 - sw1) * below(h, 2);
wave_1_per_frame9=sw3 = (1 - sw1) * (1 - sw2) * below(h, 3);
wave_1_per_frame10=sw4 = (1 - sw1) * (1 - sw2) * (1 - sw3) * below(h, 4);
wave_1_per_frame11=sw6 = above(h, 5);
wave_1_per_frame12=sw5 = (1 - sw1) * (1 - sw2) * (1 - sw3) * (1 - sw4) * (1 - sw6);
wave_1_per_frame13=t3 = sw1 + sw2 * (2 - h) + sw5 * (h - 4) + sw6;
wave_1_per_frame14=t4 = sw1 * h + sw2 + sw3 + sw4 * (4 - h);
wave_1_per_frame15=t5 = sw3 * (h - 2) + sw4 + sw5 + sw6 * (6 - h);
wave_1_per_point1=i = 6.28 * sample;
wave_1_per_point2=x1 = sin(i + t2) * sin(i * t1);
wave_1_per_point3=y1 = cos(i + t1) * sin(i * t2);
wave_1_per_point4=x2 = 0.5 * x1 + 0.5;
wave_1_per_point5=y2 = 0.5 * y1 + 0.5;
wave_1_per_point6=x = x2;
wave_1_per_point7=y = y2;
wave_1_per_point8=ii = sample;
wave_1_per_point9=r = t3 * ii * 2;
wave_1_per_point10=g = t4 * (1 - ii);
wave_1_per_point11=b = t5 * (0.5 - ii);
