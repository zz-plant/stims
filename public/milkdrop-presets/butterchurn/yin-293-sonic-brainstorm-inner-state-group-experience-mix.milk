wave_0_per_point11=x1 = x1 + 2 * equal(q3, 0) * (q4 + 1) * t7;
wave_0_per_point12=y1 = y1 + equal(q3, 0) * (q4 + 1) * 1.2 * t6;
wave_0_per_point13=x1 = x1 + 0.1 * equal(q3, 2) * (t5 - t4);
wave_0_per_point14=y1 = y1 + 0.12 * equal(q3, 2) * (t5 + t4);
wave_0_per_point15=x1 = x1 + equal(q3, 1) * (x1 - 0.5 * value1 + 0.1 * cos(209.4367 * y1));
wave_0_per_point16=x1 = x1 + equal(q3, 3) * (0.5 * q4 + value2) * cos(t2 * (6.2831 * sample + 75 * time));
wave_0_per_point17=y1 = y1 + equal(q3, 3) * (0.5 * q4 + value1) * sin(t2 * (6.2831 * sample + 75 * time));
wave_0_per_point18=ox = x1;
wave_0_per_point19=oy = y1;
wave_0_per_point20=x1 = x1 + below(q3, 3) * (-x1 + ox * cos(q5) - oy * sin(q5));
wave_0_per_point21=y1 = y1 + below(q3, 3) * (-y1 + ox * sin(q5) + oy * cos(q5));
wave_0_per_point22=x1 = x1 - q1;
