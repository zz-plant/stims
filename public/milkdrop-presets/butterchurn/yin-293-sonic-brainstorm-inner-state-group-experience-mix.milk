shape_0_init9=coef = 0;
shape_0_init10=g3 = 0;
shape_0_per_frame1=r3 = 1 - abs(cos(3.243 * time + 0.434 + sin(1.23 * time + 4.324)));
shape_0_per_frame2=g3 = 1 - abs(cos(2.03 * time + 1.546 + cos(3.01 * time + 1.98)));
shape_0_per_frame3=b3 = 1 - abs(sin(2.54 * time + 0.65 + sin(3.77 * time + 8)));
shape_0_per_frame4=coef = 0.1 + 0.05 * (45 / fps);
shape_0_per_frame5=r = coef * b3;
shape_0_per_frame6=g = coef * r3;
shape_0_per_frame7=b = coef * g3;
shape_0_per_frame8=r2 = 0.33 * g;
shape_0_per_frame9=g2 = 0.33 * b;
shape_0_per_frame10=b2 = 0.33 * r;
shape_0_per_frame11=ang = 0.5236 * mod(frame, 12);
