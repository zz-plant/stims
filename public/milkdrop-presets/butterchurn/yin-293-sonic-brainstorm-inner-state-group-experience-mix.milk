wave_3_per_point23=y1 = y1 - q2;
wave_3_per_point24=x = 0.5 * (1 + x1 / (z1 - 10));
wave_3_per_point25=y = 0.5 * (1 + y1 / (z1 - 10));
wave_3_per_point26=a = below(z1, 9) * pow(1 - 0.0125 * abs(z1 - 9), 2.5);
shape_0_init1=r3 = 0;
shape_0_init2=g3 = 0;
shape_0_init3=b3 = 0;
shape_0_init4=coef = 0;
shape_0_init5=coef = 0;
shape_0_init6=b3 = 0;
shape_0_init7=coef = 0;
