per_frame_init_20=q8 = 0;
per_frame_1=wave_a = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=ra = 10;
per_frame_5=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_6=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_7=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_8=vav = tic * (vav * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_9=tt = tt + tic * treb_avg;
per_frame_10=mt = mt + tic * mid_avg;
per_frame_11=bt = bt + tic * bass_avg;
per_frame_12=vt = vt + tic * vav;
per_frame_13=sp = 0.1 * abs(vav - slide);
per_frame_14=slide = if(0.00001 < abs(above(slide, vav)), slide - tic * sp, slide + tic * sp);
per_frame_15=slide = 1.4;
per_frame_16=q1 = 0.5 * vt;
per_frame_17=q2 = 0.1 * tt;
per_frame_18=q3 = 0.1 * mt;
per_frame_19=q4 = 0.1 * bt;
per_frame_20=q5 = 0.5 * slide;
per_frame_21=q7 = 0.1 * vt;
per_frame_22=q8 = 0.1 * time;
per_frame_23=decay = 1;
wave_3_init1=xang = 0;
wave_3_init2=fov = 0;
wave_3_init3=tic = 0;
wave_3_init4=sam = 0;
wave_3_init5=yang = 0;
wave_3_init6=my = 0;
wave_3_init7=tin = 0;
wave_3_init8=oz = 0;
wave_3_init9=q4 = 0;
wave_3_init10=med = 0;
wave_3_init11=mz = 0;
wave_3_init12=oy = 0;
wave_3_init13=pib = 0;
wave_3_init14=mod = 0;
wave_3_init15=ra = 0;
wave_3_init16=mx = 0;
wave_3_init17=sp = 0;
wave_3_init18=q2 = 0;
wave_3_init19=zang = 0;
wave_3_init20=q3 = 0;
wave_3_init21=q7 = 0;
wave_3_init22=rb = 0;
wave_3_init23=ox = 0;
wave_3_per_point1=ra = 0.7;
wave_3_per_point2=rb = 0.1;
wave_3_per_point3=pib = 6.28318530718;
wave_3_per_point4=tic = min(time - tin, 0.1);
wave_3_per_point5=tin = if(0.00001 < abs(equal(sample, 0)), time, tin);
wave_3_per_point6=mod = pow(pib, 21);
wave_3_per_point7=med = 1;
wave_3_per_point8=sp = sample * pib * mod + 1 * time;
wave_3_per_point9=sam = sample * med - q7;
wave_3_per_point10=ox = ra * sin(sam * pib);
wave_3_per_point11=oy = ra * cos(sam * pib);
wave_3_per_point12=ox = ox + rb * -cos(sp) * sin(sam * pib);
wave_3_per_point13=oz = rb * -sin(sp);
wave_3_per_point14=oy = oy + rb * -cos(sp) * cos(sam * pib);
wave_3_per_point15=a = 0.5 + 0.5 * cos(sample * pib * 3 + 0.5 * pib);
wave_3_per_point16=xang = q2;
wave_3_per_point17=yang = q3;
wave_3_per_point18=zang = q4;
wave_3_per_point19=fov = 0.5;
wave_3_per_point20=mx = ox * cos(zang) - oy * sin(zang);
wave_3_per_point21=my = ox * sin(zang) + oy * cos(zang);
wave_3_per_point22=ox = mx;
wave_3_per_point23=oy = my;
wave_3_per_point24=mx = ox * cos(yang) + oz * sin(yang);
wave_3_per_point25=mz = -ox * sin(yang) + oz * cos(yang);
wave_3_per_point26=ox = mx;
wave_3_per_point27=oz = mz;
wave_3_per_point28=my = oy * cos(xang) - oz * sin(xang);
wave_3_per_point29=mz = oy * sin(xang) + oz * cos(xang);
wave_3_per_point30=oy = my;
wave_3_per_point31=oz = mz;
wave_3_per_point32=oz = oz - 2;
wave_3_per_point33=x = ox * fov / oz + 0.5;
wave_3_per_point34=x = 0.75 * (x - 0.5) + 0.5;
wave_3_per_point35=y = oy * fov / oz + 0.5;
