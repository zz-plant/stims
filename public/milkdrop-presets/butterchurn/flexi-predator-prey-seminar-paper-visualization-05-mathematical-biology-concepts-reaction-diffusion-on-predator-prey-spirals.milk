per_frame_init_1=d = 0;
per_frame_init_2=q6 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q5 = 0;
per_frame_init_5=startx = 0;
per_frame_init_6=q4 = 0;
per_frame_init_7=a = 0;
per_frame_init_8=b = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=starty = 0;
per_frame_init_11=q3 = 0;
per_frame_init_12=q7 = 0;
per_frame_init_13=x1 = 0;
per_frame_init_14=y1 = 0.001;
per_frame_init_15=z1 = 0;
per_frame_1=zoom = 1;
per_frame_2=warp = 0;
per_frame_3=wave_a = 0;
per_frame_4=startx = 0.7;
per_frame_5=starty = 0.7;
per_frame_6=a = 1;
per_frame_7=b = 0.14;
per_frame_8=d = 0.2;
per_frame_9=q1 = aspectx;
per_frame_10=q2 = aspecty;
per_frame_11=q3 = startx;
per_frame_12=q4 = starty;
per_frame_13=q5 = a;
per_frame_14=q6 = b;
per_frame_15=q7 = d;
per_pixel_1=x = 0.5 + (x - 0.5) * q1;
per_pixel_2=y = 0.5 - (y - 0.5) * q2;
per_pixel_3=dx = x * (1 - x) - q5 * x * y / (x + q6);
per_pixel_4=dy = -q7 * y * (1 - y / x);
per_pixel_5=dx = -0.01 * dx / q1;
per_pixel_6=dy = -0.01 * dy / q2;
wave_0_init1=xx = 0;
wave_0_init2=q6 = 0;
wave_0_init3=q1 = 0;
wave_0_init4=q5 = 0;
wave_0_init5=dx = 0;
wave_0_init6=q4 = 0;
wave_0_init7=dy = 0;
wave_0_init8=q2 = 0;
wave_0_init9=q3 = 0;
wave_0_init10=yy = 0;
wave_0_init11=q7 = 0;
wave_0_init12=t2 = 0;
wave_0_init13=t3 = 0;
wave_0_init14=t4 = 0;
wave_0_init15=ab = 1;
wave_0_per_point1=xx = if(0.00001 < abs(equal(sample, 0)), q3, xx);
wave_0_per_point2=yy = if(0.00001 < abs(equal(sample, 0)), q4, yy);
wave_0_per_point3=dx = xx * (1 - xx) - q5 * xx * yy / (xx + q6);
wave_0_per_point4=dy = q7 * yy * (1 - yy / xx);
wave_0_per_point5=x = xx;
wave_0_per_point6=y = yy;
wave_0_per_point7=xx = xx + 0.2 * dx;
wave_0_per_point8=yy = yy + 0.2 * dy;
wave_0_per_point9=x = 0.5 + (x - 0.5) / q1 + dy * value1 * 0.01;
wave_0_per_point10=y = 0.5 + (y - 0.5) / q2 - dx * value1 * 0.01;

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (texsize.zw * 12.0);
  vec2 tmpvar_4;
  tmpvar_4.x = (0.5 * ((2.0 * 
    ((texture (sampler_blur2, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale2) + bias2)
  ) - (2.0 * 
    ((texture (sampler_blur2, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale2) + bias2)
  ))).z;
  tmpvar_4.y = (0.5 * ((2.0 * 
    ((texture (sampler_blur2, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale2) + bias2)
  ) - (2.0 * 
    ((texture (sampler_blur2, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale2) + bias2)
  ))).z;
  uv_1 = (uv - (tmpvar_4 * texsize.zw));
  ret_2.z = ((texture (sampler_main, uv_1).z + (
    (texture (sampler_main, uv_1).z - ((texture (sampler_blur3, uv_1).xyz * scale3) + bias3))
  .z * 0.12)) + 0.008);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_2;
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
