per_frame_init_1=turn = 0;
per_frame_init_2=turnr = 0;
per_frame_init_3=simp = 0;
per_frame_1=wave_x = wave_x + 0.05 * sin(0.2 * time) - (0.05 * cos(0.1 * time) + 0.05 * sin(0.2 * time));
per_frame_2=wave_y = wave_y + 0.05 * sin(0.3 * time) - (0.05 * sin(0.88 * time) + 0.05 * cos(0.7 * time));
per_frame_3=wave_r = wave_r + 0.35 * sin(1.13 * time) + 0.1245 * sin(2.34 * time);
per_frame_4=wave_g = wave_g + 0.35 * sin(1.23 * time) + 0.12 * sin(2.134 * time);
per_frame_5=wave_b = wave_b + 0.35 * sin(1.33 * time) + 0.12 * sin(2.5 * time);
per_frame_6=wave_mystery = wave_mystery + 0 * sin(time);
per_frame_7=turn = 2 * above(bass_att, turn) + (1 - above(bass_att, turn)) * (0.96 * (turn - 1.3) + 1.3);
per_frame_8=turnr = 0.089 * equal(turn, 2) * sin(6.6 * time) + (1 - equal(turn, 2)) * turnr;
per_frame_9=simp = 0.35 * simp * sin(1.2 * time) - 0.62 * sin(0.7 * time) + 1.5 * sin(turn);
per_frame_10=rot = rot + 1.25 * simp * turnr;
per_pixel_1=zoom = zoom - 0.02 * (1 - rad);
per_pixel_2=dx = dx + 0.014 * (3.1 * bass_att * rot + 0.2 * cos(tan(80 * ang)));
per_pixel_3=dy = dy + 0.014 * (3.1 * bass_att * rot + 0.22 * sin(tan(80 * ang)));

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  float tmpvar_2;
  tmpvar_2 = (time * 10.0);
  tmpvar_1.x = (uv.x + ((
    (2.0 * sin(((uv.x * 
      (bass * 500.0)
    ) + tmpvar_2)))
   - 0.5) * 0.002));
  tmpvar_1.y = (uv.y + ((
    (2.0 * sin(((uv.y * 
      (treb * 500.0)
    ) + tmpvar_2)))
   - 0.5) * 0.002));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ((texture (sampler_fc_main, tmpvar_1).xyz - 0.005) * 0.97);
  ret = tmpvar_3.xyz;
 }
