per_frame_init_1=antirot = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.825 * time) + 0.4 * sin(0.915 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.025 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.81 * time) + 0.4 * sin(0.95 * time));
per_frame_4=mv_r = wave_r + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.75 * time));
per_frame_5=mv_g = wave_g + 0.35 * (0.6 * sin(0.825 * time) + 0.4 * sin(0.95 * time));
per_frame_6=mv_b = wave_b + 0.35 * (0.6 * sin(0.775 * time) + 0.4 * sin(1.025 * time));
per_frame_7=ib_r = 2 * bass;
per_frame_8=ib_b = 2 * treb;
per_frame_9=ib_g = 2 * mid;
per_frame_10=ob_r = mid_att + time;
per_frame_11=ob_b = bass_att + time;
per_frame_12=ob_g = treb_att + time;
per_frame_13=zoom = zoom - 0.15 * (0.1 - bass_att);
per_pixel_1=rot = antirot - ang;
