wave_2_per_point31=ang = 3.14 + 2.5 * sin(2 * tm - 0.5);
wave_2_per_point32=xq = xp;
wave_2_per_point33=sa = sin(ang);
wave_2_per_point34=ca = cos(ang);
wave_2_per_point35=yq = yp * sa + zp * ca;
