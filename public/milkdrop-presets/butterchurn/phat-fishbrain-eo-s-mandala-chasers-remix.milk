wave_2_per_point24=ang = 8 * tm;
wave_2_per_point25=sa = sin(ang);
wave_2_per_point26=ca = cos(ang);
wave_2_per_point27=xp = xq * sa + yq * ca;
wave_2_per_point28=yp = xq * ca - yq * sa;
wave_2_per_point29=zp = zq;
