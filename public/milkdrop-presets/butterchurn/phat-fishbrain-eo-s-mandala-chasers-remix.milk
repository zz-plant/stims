wave_0_per_point9=xoffset1 = cos(time * pphase2 + pphase) * pheight;
wave_0_per_point10=xoffset2 = -1 * cos(time * pphase2 + pphase) * pheight;
wave_0_per_point11=lrorient = if(0.00001 < abs(below(cos(time * pphase2 + pphase), cos((time - 0.1) * pphase2 + pphase))), 0, 1);
wave_0_per_point12=px = if(0.00001 < abs(equal(lrorient, 0)), xspout - pheight + xoffset1, xspout + pheight - xoffset2);
wave_0_per_point13=py = yspout + abs(sin(time * pphase2 + pphase)) * yheight;
wave_0_per_point14=x = px;
wave_0_per_point15=y = py;
