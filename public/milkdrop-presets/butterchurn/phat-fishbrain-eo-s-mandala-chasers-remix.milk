wave_2_per_point5=flip = flip * below(flip, 2);
wave_2_per_point6=xp = 0;
wave_2_per_point7=yp = (0.1 * flip - 0.05) * sample;
wave_2_per_point8=zp = 0;
wave_2_per_point9=ang = 20 * tm + 0.4 * sin(76 * tm + 4 * time);
wave_2_per_point10=sa = sin(ang);
wave_2_per_point11=ca = cos(ang);
wave_2_per_point12=xr = xp * sa + yp * ca;
