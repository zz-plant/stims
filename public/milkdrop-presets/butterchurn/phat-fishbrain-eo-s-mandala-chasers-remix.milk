wave_2_per_point40=zp = zq;
wave_2_per_point41=zp = zp - 0.35;
wave_2_per_point42=ang = 1.75 * cos(1 * tm) - 1.05;
wave_2_per_point43=sa = sin(ang);
wave_2_per_point44=ca = cos(ang);
wave_2_per_point45=xq = xp * sa + zp * ca;
wave_2_per_point46=yq = yp;
