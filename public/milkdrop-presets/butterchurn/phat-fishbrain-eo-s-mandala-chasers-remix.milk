wave_2_per_point51=ca = cos(ang);
wave_2_per_point52=yp = yq * ca - zq * sa;
wave_2_per_point53=zp = yq * sa + zq * ca;
wave_2_per_point54=zp = zp + 1.5;
wave_2_per_point55=xs = xp / zp;
wave_2_per_point56=ys = yp / zp;
