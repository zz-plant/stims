per_frame_init_1=thresh = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q5 = 0;
per_frame_init_4=dy_r = 0;
per_frame_init_5=block = 0;
per_frame_init_6=musictime = 0;
per_frame_init_7=q4 = 0;
