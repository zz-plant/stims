per_frame_init_11=ak = 0;
per_frame_init_12=q8 = 0;
per_frame_init_13=zoom = 1;
per_frame_init_14=xpos = 0;
per_frame_init_15=ypos = 0;
per_frame_1=decay = 1;
per_frame_2=vol = vol;
per_frame_3=mv_r = 0.5 + 0.4 * sin(1.324 * time);
per_frame_4=mv_g = 0.5 + 0.4 * cos(1.371 * time);
per_frame_5=zoom = 1;
per_frame_6=musictime = musictime + vol;
per_frame_7=q4 = 0.3 * sin(0.02 * musictime);
per_frame_8=q5 = 0.3 * sin(0.01 * musictime);
per_frame_9=dx = 0.01 * sin(0.1 * musictime);
per_frame_10=dy = 0.01 * cos(0.069 * musictime);
per_frame_11=monitor = rot;
per_pixel_1=ak = -sin(6 * sin(12.2 * rad) + mod(3 * mod(q1, 5), 5) * (2 * y - 1) + q1) * (1 - x + 0.2 * sin(0.54 * q1)) * above(2 * x - 1, 0);
per_pixel_2=block = if(0.00001 < abs(below(ak, -0.15)), ak, 0);
per_pixel_3=zoom = if(0.00001 < abs(block), 1, 0.97);
per_pixel_4=rd = sqrt(sqr(0.2 * sin(2 * x - 1) + 0.6));
per_pixel_5=cx = 0.5 + 55555 * q4;
per_pixel_6=cy = 0.5 - q5;
per_pixel_7=zoom = rd * rd * 2;
per_pixel_8=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_9=dx_r = 0.15 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_10=dy_r = 0.165 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_11=q1 = 8.3 + (sin(x + 0.137 * q8) - cos(y + 0.213 * q8));
per_pixel_12=zoom = rd * rd * 3;
per_pixel_13=rot = 5 * sin(0.0185 * time / 8);
per_pixel_14=rd = (1.2 + 0.3 * sin(0.2 * time) + 0.4 * sin(q5)) * sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5)));
per_pixel_15=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_16=dx_r = 0.15 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_17=dy_r = 0.165 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_18=zoom = zoom - 1.26 * (0.25 - rad) * sin(6 * x) * sin(0.1 * q4 * bass_att);
per_pixel_19=zoom = zoom / (1.1 + 0.025 * sin(time / 14)) - 1.26 * (0.25 - rad) * cos(6 * y) * cos(0.1 * q4 * bass_att) / 2;
