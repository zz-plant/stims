per_frame_init_1=sw = 0;
per_frame_init_2=fin = 0;
per_frame_init_3=tic = 0;
per_frame_init_4=vol = 0;
per_frame_init_5=q5 = 0;
per_frame_1=wave_a = 0;
per_frame_2=sw = above(time - fin, 0.06);
per_frame_3=fin = if(0.00001 < abs(sw), time, fin);
per_frame_4=zoom = if(0.00001 < abs(sw), 0.85, 1);
per_frame_5=monitor = tic;
per_frame_6=vol = 0.1 * (9 * vol + 0.333333 * (bass_att + mid_att + treb_att));
per_frame_7=q5 = 5 - 3.5 * vol;
wave_0_init1=fov = 0;
wave_0_init2=yr = 0;
wave_0_init3=s = 0;
