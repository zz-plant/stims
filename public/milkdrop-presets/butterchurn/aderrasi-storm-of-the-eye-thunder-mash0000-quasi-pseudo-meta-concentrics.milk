[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.970000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
nWaveMode=2.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
fWaveAlpha=100.000000
fWaveScale=0.797000
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=0.100000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=warp = 0;
per_frame_2=ob_r = ob_r + 0.8 * sin(1.1 * time) + 1.1 * cos(2 * time);
per_frame_3=ob_b = ob_b + 0.9 * sin(1.2 * time) + cos(1.5 * time);
per_frame_4=ob_g = ob_g + 0.7 * sin(time) + sin(0.4 * time);
per_frame_5=wave_r = abs(ob_r + 0.2);
per_frame_6=wave_g = abs(ob_g + 0.2);
per_frame_7=wave_b = abs(ob_b + 0.2);
per_frame_8=ib_b = ib_b + 0.44 * cos(1.5 * time) + 0.7 * tan(time);
per_frame_9=ib_g = ib_g + 2 * sin(time * bass_att);
per_frame_10=ib_r = ib_r + 0.8 * sin(1.2 * time) + 1.3 * cos(1.8 * time);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom + 0.07 * treb * abs(sin(time * rad)) * (0.3 - rad);
per_pixel_5=dy = dy + dy_r * below(rad, 0.5 - 0.2 * time);
per_pixel_6=dx = dx + dx_r * below(rad, 0.5 - 0.2 * time);
per_pixel_7=rot = rot + 0.7 * bass_att * sin(abs(dx_r * (1 - rad) * 2 * time + cos(12 * rad))) * 0.2;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (tmpvar_2.xyz + ((tmpvar_2.xyz - 
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  ) * 0.3));
  ret_1 = (ret_1 * 0.9);
  ret_1 = (ret_1 + ((
    (texture (sampler_noise_lq, ((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 0.1))).xyz - 0.5)
   / 256.0) * 28.0));
  vec3 tmpvar_3;
  tmpvar_3 = mix (ret_1, vec3(dot (ret_1, vec3(0.32, 0.49, 0.29))), vec3(0.04, 0.04, 0.04));
  ret_1 = tmpvar_3;
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = tmpvar_3;
  ret = tmpvar_4.xyz;
 }
