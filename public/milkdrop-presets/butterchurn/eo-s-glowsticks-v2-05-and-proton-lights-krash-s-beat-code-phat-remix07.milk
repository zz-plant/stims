per_frame_1=zoom = 1;
per_frame_2=volume = 0.3 * (bass + mid + att);
per_frame_3=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_4=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_5=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_6=peakbass_att = max(bass_att, peakbass_att);
per_frame_7=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_8=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_9=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_10=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_11=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_12=beatcounter = beatcounter + beat;
per_frame_13=mode = if(0.00001 < abs(beat * equal(mod(beatcounter, 2), 0)), 1 - mode, mode);
per_frame_14=flip = 2 * mode - 1;
per_frame_15=monitor = flip;
per_frame_16=q8 = flip;
per_frame_17=angadv = angadv + beat;
per_frame_18=angadv = if(0.00001 < abs(above(angadv, 5)), 2, angadv);
per_frame_19=q7 = angadv;
per_frame_20=decay = 0.95;
per_frame_21=zoom = 1.002;
per_frame_22=vol = 0.25 * (bass_att + mid_att + treb_att);
per_frame_23=vol = vol * vol;
per_frame_24=mtime = mtime + 0.1 * vol * flip * (37 / fps);
per_frame_25=q1 = 0.4 * mtime;
per_frame_26=warp = 0;
per_frame_27=cx = 0.4 * sin(0.2 * mtime) + 0.5;
per_frame_28=cy = sin(0.33 * mtime);
per_frame_29=cys = sign(cy);
per_frame_30=cy = cy * cy * cys;
per_frame_31=cy = 0.4 * cy + 0.5;
per_frame_32=rot = 0.31 * sin(0.25 * time);
per_pixel_1=tbr = 0.7 + 0.3 * treb;
per_pixel_2=var = -1.5 * tbr;
per_pixel_3=ag = 1.75 * atan((y - 0.5 - (cy - 0.5)) / (x - 0.5 - (cx - 0.5)));
per_pixel_4=star = sin(ang * q7) * tbr;
per_pixel_5=rdd = 4 * max(abs(x - 0.5), abs(y - 0.5));
per_pixel_6=zm = 1 + rdd / 40 + var / 40 + 0.003 * star;
per_pixel_7=sx = 0.8;
per_pixel_8=sy = sx;
