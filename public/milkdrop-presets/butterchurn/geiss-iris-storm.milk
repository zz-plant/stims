[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=1.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.207000
fWaveScale=0.747000
fWaveSmoothing=0.000000
fWaveParam=0.240000
fModWaveAlphaEnd=1.170000
fWarpAnimSpeed=0.451000
fWarpScale=3.040000
fZoomExponent=26.407390
fZoom=1.049710
fDX=0.005000
fDY=0.005000
fWarp=0.098620
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsR=0.350000
fMotionVectorsG=0.350000
fMotionVectorsB=0.350000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=time2 = 0;
per_frame_1=time2 = 17 * time;
per_frame_2=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time2) + 0.4 * sin(1.047 * time2));
per_frame_3=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time2) + 0.4 * sin(1.081 * time2));
per_frame_4=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time2) + 0.4 * sin(1.011 * time2));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=decay = decay - 0.01 * equal(mod(frame, 20), 0);
per_frame_8=zoom = zoom + 1.2 * (0.01 * cos(0.317 * time + 1) + 0.01 * cos(0.1132 * time + 4));
per_frame_9=rot = rot + 0.5 * (0.01 * cos(0.214 * time + 3) + 0.01 * cos(0.2732 * time + 2));
per_frame_10=wave_mystery = -0.1 + 0.3 * cos(3 * time * 17.3214);
per_frame_11=dx = dx + 0.01 * cos(1.613 * time + 1) + 0.01 * cos(2.303 * time + 5);
per_frame_12=dy = dy + 0.01 * sin(1.119 * time + 3) + 0.01 * cos(1.784 * time + 4);
per_pixel_1=rot = 0.07 * cos(9 * rad + 3 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_noise_hq, (rand_frame.xy + ((uv * 3.3) * (texsize.xy * texsize_noise_hq.zw)))).xy * texsize.zw)
   * 2.0))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_blur1, uv);
  ret_1 = (abs((texture (sampler_main, uv).xyz - 
    ((tmpvar_2.xyz * scale1) + bias1)
  )) * 12.0);
  ret_1 = (ret_1 + ((tmpvar_2.xyz * scale1) + bias1));
  ret_1 = (ret_1 * 2.0);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
