wave_0_per_point1=n = 6.283 * sample;
wave_0_per_point2=flip = flip + 1;
wave_0_per_point3=flip = flip * below(flip, 2);
wave_0_per_point4=phase = sin(3 * n) * sin(7.9 * n) * sin(16.7 * n) * sin(63.5 * n) * 6;
wave_0_per_point5=xp = sin(n + phase) * flip;
wave_0_per_point6=yp = cos(n + phase) * flip;
wave_0_per_point7=zp = 0;
wave_0_per_point8=ang = 2 * n + 0.2 * phase;
wave_0_per_point9=xq = xp * sin(ang) + zp * cos(ang);
wave_0_per_point10=yq = yp;
wave_0_per_point11=zq = xp * cos(ang) - zp * sin(ang);
wave_0_per_point12=ang = 0.1 * time;
wave_0_per_point13=xp = xq * sin(ang) + zq * cos(ang);
wave_0_per_point14=yp = yq;
wave_0_per_point15=zp = xq * cos(ang) - zq * sin(ang);
wave_0_per_point16=ang = 0.17 * time;
wave_0_per_point17=xq = xp;
wave_0_per_point18=yq = yp * sin(ang) + zp * cos(ang);
wave_0_per_point19=zq = yp * cos(ang) - zp * sin(ang);
wave_0_per_point20=zq = zq + 3.1;
wave_0_per_point21=xs = xq / zq;
wave_0_per_point22=ys = yq / zq;
wave_0_per_point23=x = xs + 0.5;
wave_0_per_point24=y = 1.3 * ys + 0.5;
wave_0_per_point25=a = 0.05 * (1 - flip);
