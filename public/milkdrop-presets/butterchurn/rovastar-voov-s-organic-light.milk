per_frame_9=q7 = 0.0001 * (pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps);
per_frame_10=ob_size = 0.95;
per_frame_11=monitor = q8;
per_pixel_1=rot = 0.1 * pow(-ang, 3) - 1.18 * sin(ang);
per_pixel_2=zoom = 2 * sin(-rad) + 1.3 + sin(rad);
per_pixel_3=dx = dx + 0.09 * sin(0.785 * q8);
per_pixel_4=dy = dy + 0.09 * sin(0.675 * q8);
per_pixel_5=zoom = zoom + q7;
