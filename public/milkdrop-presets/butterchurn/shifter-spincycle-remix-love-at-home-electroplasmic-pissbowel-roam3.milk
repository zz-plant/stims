per_frame_22=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_23=rb = 1;
per_frame_24=vav = tic * (vav * (1 / tic - rb) + rb * (bass + treb + mid) * 0.33333);
