[preset00]
fRating=0.000000
fDecay=0.999000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bDarkenCenter=1.000000
bDarken=1.000000
fWaveAlpha=0.115204
fWaveScale=1.106638
fWaveSmoothing=0.000000
fWaveParam=-0.420000
fModWaveAlphaStart=0.850000
fModWaveAlphaEnd=1.950000
fZoomExponent=0.042592
fSx=0.914340
fSy=0.951466
fWaveR=0.400000
fWaveG=0.400000
fWaveB=0.400000
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderSize=0.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
nMotionVectorsX=64.000000
nMotionVectorsY=1.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=x_wave_x = 0;
per_frame_init_2=treb_effect = 0;
per_frame_init_3=net_effect = 0;
per_frame_init_4=rot_residual = 0;
per_frame_init_5=bass_thresh = 0;
per_frame_init_6=shift = 0;
per_frame_1=warp = warp / bass;
per_frame_2=dx = -0.0005;
per_frame_3=dy = -0.0005;
per_frame_4=x_wave_x = 0.5 + 0.3 * sin(bass + treb + mid);
per_frame_5=wave_r = 1 + sin(6.28 * -x_wave_x);
per_frame_6=wave_g = abs(sin(12.56 * x_wave_x));
per_frame_7=wave_b = sin(6.28 * x_wave_x);
per_frame_8=treb_effect = if(0.00001 < abs(above(treb_att, 1.4)), pow(0.99, treb_att), 1);
per_frame_9=net_effect = if(0.00001 < abs(above(bass_att, 0.8 * treb_att)), 1, treb_effect);
per_frame_10=zoom = net_effect * bass_att;
per_frame_11=rot = rot + 0.5 * rot_residual;
per_frame_12=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_13=shift = tan(7 * time) - 0.05;
per_frame_14=shift = if(0.00001 < abs(above(shift, 0)), 0, if(0.00001 < abs(below(shift, -0.1)), -0.1, shift));
per_frame_15=rot_residual = if(0.00001 < abs(equal(bass_thresh, 2)), shift, rot_residual);
per_pixel_1=rot = rot + if(0.00001 < abs(equal(sin(ang), 1)), rot, sin(1 - rad) / 2);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ((max (tmpvar_1.xyz, texture (sampler_main, 
    (uv + (vec2(0.0, 13.0) * ((tmpvar_1.xy - 0.5) * texsize.zw)))
  ).xzy) - 0.008) * 0.96);
  ret = tmpvar_2.xyz;
 }
