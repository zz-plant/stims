per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=q2 = 0;
per_frame_init_6=q3 = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.25 * cos(1.12 * time) + 0.2 * (0.3 * cos(1.28 * time) + 0.3 * sin(2 * time));
per_frame_3=wave_g = wave_g + 0.25 * cos(1.142 * time) + 0.2 * (0.3 * cos(1.2 * time) + 0.32 * sin(1.623 * time));
per_frame_4=wave_b = wave_b + 0.25 * cos(1.13 * time) + 0.2 * (0.4 * cos(1.9 * time) + 0.34 * sin(1.5245 * time));
per_frame_5=q1 = wave_r;
per_frame_6=q2 = wave_g;
per_frame_7=q3 = wave_b;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.15 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.15 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=rot = rot + 0.2 * abs(7 * dx_r * (2 * rad - cos(12 * ang)) * sin(2 - rad) * abs(1.2 * dx_r));
per_pixel_5=zoom = zoom + 0.2 * abs(8 * dy_r * abs(dx_r * sin(2 * sin(2 * rad) * tan(6 * rad))));
per_pixel_6=zoom = zoom + 4 * dx_r * (rad - 3.5 * x * cos(sin(3 - 3 * rad * cos(2 * y - bass_att))) * (0.5 - rad));
shape_0_init1=q2 = 0;
