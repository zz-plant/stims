per_frame_39=movement = movement + 0.4 * ((bass + bass_att + 0.1 * pow(bass + 0.6 * bass_att + 0.2 * treb_att, 3)) / fps);
per_frame_40=movement = if(0.00001 < abs(above(movement, 10000)), 0, movement);
per_frame_41=rot = sin(movement);
per_frame_42=cx = wave_x;
per_frame_43=cy = y_pos + 0.5;
per_frame_44=q8 = movement;
per_pixel_1=myy = x - q1;
per_pixel_2=myx = y - q2 + 0.1;
per_pixel_3=dx = 6 * sin(0.675 * q8) * myx * myy;
per_pixel_4=dy = 3 * sin(0.675 * q8) * (myx * myx - myy * myy);

