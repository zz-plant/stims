wave_0_per_frame1=vol = 8 * bass + 5 * mid + 3 * treb;
wave_0_per_frame2=m = 0.97 * m + 0.08 * vol;
wave_0_per_frame3=monitor = vol;
wave_0_per_frame4=beat = above(vol, res) * above(vol, m) * above(vol, 16);
wave_0_per_frame5=diff = (1 - beat) * diff + beat * (vol - res);
wave_0_per_frame6=res = beat * (vol + 0.04 * m) + (1 - beat) * (res - 60 * (0.1 + 0.02 * diff) / fps);
wave_0_per_frame7=res = max(0, res);
wave_0_per_frame8=b = 0.1;
wave_0_per_frame9=g = beat;
