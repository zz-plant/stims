[preset00]
fRating=2.000000
fGammaAdj=1.000000
fDecay=0.960000
fVideoEchoZoom=0.010000
nWaveMode=3.000000
bWaveDots=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bInvert=1.000000
fWaveAlpha=0.793875
fWaveScale=1.074093
fWaveSmoothing=0.000000
fModWaveAlphaStart=1.000001
fModWaveAlphaEnd=0.000000
fWarpScale=0.010000
fZoom=1.001837
fWarp=0.010000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.015000
fOuterBorderR=0.300000
fOuterBorderA=0.200000
fInnerBorderSize=0.025000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=1.000000
fInnerBorderA=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.000000
fMotionVectorsR=0.000000
fMotionVectorsG=0.700000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=a = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=vol_now = 0;
per_frame_init_4=vol_mean = 0;
per_frame_init_5=beat = 0;
per_frame_init_6=sinbeat = 0;
per_frame_1=warp = 0;
per_frame_2=vol_now = 0.4 * bass + 0.1 * (bass_att + treb + mid);
per_frame_3=vol_mean = if(0.00001 < abs(equal(mod(frame, 50), 0)), vol_mean - 0.5 * (vol_mean - vol_now), 0.1 * (9 * vol_mean + vol_now));
per_frame_4=beat = if(0.00001 < abs(above(vol_now, 1.15 * vol_mean)), 1, 0);
per_frame_5=sinbeat = sin(beat * (vol_now - vol_mean));
per_frame_6=wave_b = cos(time) + abs(cos(time));
per_frame_7=wave_g = abs(sin(time));
per_frame_8=wave_r = -1 * cos(time) + abs(-1 * cos(time)) + 0.2 * (cos(sin(time)) + (abs(cos(sin(time))) + cos(sin(time))));
per_frame_9=ib_r = if(0.00001 < abs(above(wave_r, 1)), 1, if(0.00001 < abs(above(wave_r, 0)), abs(wave_r), 0));
per_frame_10=ib_g = if(0.00001 < abs(above(wave_g, 1)), 1, if(0.00001 < abs(above(wave_g, 0)), abs(wave_g), 0));
per_frame_11=ib_b = if(0.00001 < abs(above(wave_b, 1)), 1, if(0.00001 < abs(above(wave_b, 0)), abs(wave_b), 0));
per_frame_12=ob_r = 1 - if(0.00001 < abs(above(wave_r, 1)), 1, if(0.00001 < abs(above(wave_r, 0)), abs(wave_r), 0));
per_frame_13=ob_g = 1 - if(0.00001 < abs(above(wave_g, 1)), 1, if(0.00001 < abs(above(wave_g, 0)), abs(wave_g), 0));
per_frame_14=ob_b = 1 - if(0.00001 < abs(above(wave_b, 1)), 1, if(0.00001 < abs(above(wave_b, 0)), abs(wave_b), 0));
per_frame_15=q1 = sinbeat + 0.35;
per_frame_16=wave_mystery = vol_now;
per_frame_17=monitor = sinbeat;
per_pixel_1=a = pow(1.02, pow(1, 2 * rad - 1));
per_pixel_2=dx = (x - 0.5) * a + 0.5 - x;
per_pixel_3=dy = (y - 0.5) * a + 0.5 - y;
per_pixel_4=zoom = q1 + x;
