per_frame_18=q25 = q22 * (1 + randint(8)) / 8;
per_frame_19=mindev = min(min(abs(spb - spb_), abs(2 * spb - spb_)), abs(spb - 2 * spb_));
per_frame_20=sdev = if(0.00001 < abs(is_beat), 0.8 * sdev + 0.2 * pow(mindev + 0.02, 2), sdev);
per_frame_21=speed = 1 / fps / spb_;
per_frame_22=trel = trel + speed;
per_frame_23=q10 = trel;
per_frame_24=wamp = min(0.001 / sdev, 0.15);
per_frame_25=wamp_ = wamp_ * dec_slow + (1 - dec_slow) * wamp;
per_frame_26=q11 = sin(trel / 2) * wamp_;
per_frame_27=q12 = wamp_ / 2;
per_frame_28=rota = 2 * wamp_ * sin(trel / 3);
per_frame_29=q5 = cos(rota);
per_frame_30=q6 = sin(rota);
per_frame_31=q7 = -q6;
per_frame_32=q8 = q5;
per_frame_33=q15 = 0.05 * -sin(0.5 * trel);
per_frame_34=q16 = cos(trel) * wamp_ / 2;
per_frame_35=q19 = 0.1 * sin(trel / 12);
per_frame_36=trig1 = bnot(vis) * bnot(randint(100 * fps));
per_frame_37=vis = if(0.00001 < abs(trig1), 1, vis * below(mov1, 1));
per_frame_38=q30 = vis;
per_frame_39=mov1 = if(0.00001 < abs(vis), mov1 + 2 * speed / fps, -1);
per_frame_40=dir = if(0.00001 < abs(trig1), randint(100), dir);
per_frame_41=q31 = 0.5 + 0.5 * cos(dir) * mov1;
per_frame_42=q32 = 0.5 + 0.5 * sin(dir) * mov1;
per_frame_43=q29 = 2 + sin(time / 17);
