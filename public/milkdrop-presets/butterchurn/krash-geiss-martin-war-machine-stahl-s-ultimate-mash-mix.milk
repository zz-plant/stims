[preset00]
fRating=0.000000
fGammaAdj=1.900000
fDecay=1.000000
fVideoEchoZoom=1.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=1.000000
fWaveScale=1.348000
fWaveParam=-0.500000
fZoom=0.999900
fRot=0.100000
fOuterBorderA=0.100000
fInnerBorderSize=0.500000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=mode2 = 0;
per_frame_init_2=meanbass_att = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=q5 = 0;
per_frame_init_5=lastbeat = 0;
per_frame_init_6=beatrate = 0;
per_frame_init_7=mode3 = 0;
per_frame_init_8=mode = 0;
per_frame_init_9=peakbass_att = 0;
per_frame_init_10=beatcounter = 0;
per_frame_init_11=q4 = 0;
per_frame_init_12=att = 0;
per_frame_init_13=volume = 0;
per_frame_init_14=beat = 0;
per_frame_init_15=q2 = 0;
per_frame_init_16=q3 = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.45 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_3=wave_b = wave_b - 0.4 * (0.5 * sin(4.782 * time) + 0.5 * cos(0.522 * time));
per_frame_4=wave_g = wave_g + 0.4 * sin(1.731 * time);
per_frame_5=ob_r = above(bass_att, bass) * (bass_att - bass) * 4;
per_frame_6=volume = 0.3 * (bass + mid + att);
per_frame_7=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_8=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_9=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_10=peakbass_att = max(bass_att, peakbass_att);
per_frame_11=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_12=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_13=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_14=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_15=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_16=beatcounter = beatcounter + beat;
per_frame_17=mode = if(0.00001 < abs(beat * equal(mod(beatcounter, 2), 0)), 1 - mode, mode);
per_frame_18=mode2 = if(0.00001 < abs(beat), mod(mode2 + randint(7) + 1, 8), mode2);
per_frame_19=mode3 = if(0.00001 < abs(beat), mod(mode3 + randint(7) + 1, 8), mode3);
per_frame_20=q1 = 2 * mode - 1;
per_frame_21=q2 = mode2 + 2;
per_frame_22=q3 = 1 / q2;
per_frame_23=q4 = mode3 + 2;
per_frame_24=q5 = 1 / q4;
per_frame_25=wave_x = (randint(q2) + 0.5) * q3;
per_frame_26=wave_y = (randint(q4) + 0.5) * q5;
per_frame_27=decay = decay - 0.1 * equal(mod(frame, 50), 0);
per_pixel_1=cx = (band(0, x * q2 - 0.5) + 0.5) * q3;
per_pixel_2=cy = (band(0, y * q4 - 0.5) + 0.5) * q5;
per_pixel_3=rot = rot * pow(-1, band(0, x * q2 - 0.5) + band(0, y * q4 - 0.5)) * q1;

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0) * 3.0));
  vec3 tmpvar_2;
  tmpvar_2 = fract((ret_1 - 0.005));
  ret_1 = tmpvar_2;
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = tmpvar_2;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
uniform sampler2D sampler_rand00;
 shader_body { 
  vec3 ret1_1;
  vec2 uv1_2;
  vec3 tmpvar_3;
  tmpvar_3 = texture (sampler_main, uv).xyz;
  vec2 tmpvar_4;
  tmpvar_4.y = 0.0;
  tmpvar_4.x = texsize.z;
  vec2 tmpvar_5;
  tmpvar_5.x = 0.0;
  tmpvar_5.y = texsize.w;
  vec2 tmpvar_6;
  tmpvar_6.x = (texture (sampler_main, (uv - tmpvar_4)).xyz - texture (sampler_main, (uv + tmpvar_4)).xyz).x;
  tmpvar_6.y = (texture (sampler_main, (uv - tmpvar_5)).xyz - texture (sampler_main, (uv + tmpvar_5)).xyz).x;
  uv1_2 = ((0.3 * cos(
    (((uv - 0.5) * 2.0) + 1.7)
  )) - (2.0 * tmpvar_6));
  ret1_1 = ((-(tmpvar_3) / 4.0) + ((6.0 * vec3(
    clamp ((0.03 / sqrt(dot (uv1_2, uv1_2))), 0.0, 1.0)
  )) * (-0.08 + tmpvar_3)));
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ((texture (sampler_rand00, (0.4 + 
    (0.6 * ret1_1.xy)
  )) * dot (ret1_1, vec3(0.32, 0.49, 0.29))) * 3.0).xyz;
  ret = tmpvar_7.xyz;
 }
