per_frame_6=vr = sin(vr1) * r;
per_frame_7=bounce = below(y1, r - 0.5 * (aspectx - 1));
per_frame_8=y1 = y1 + vy1;
per_frame_9=vy1 = if(0.00001 < abs(bounce), 0.96 * abs(vy1) + 0.1 * (r - y1 - 0.5 * (aspectx - 1)), vy1 - 0.018 / fps);
per_frame_10=vx1 = if(0.00001 < abs(bounce), vx1 + 0.15 * (vr - vx1), vx1);
per_frame_11=vr = if(0.00001 < abs(bounce), vr + 0.85 * (vx1 - vr), vr);
per_frame_12=vr1 = asin(vr / r);
per_frame_13=bounce = above(x1, 1 - r + 0.5 * (aspecty - 1));
per_frame_14=vx1 = if(0.00001 < abs(bounce), 0.96 * -abs(vx1) + 0.1 * (1 - r - x1 + 0.5 * (aspecty - 1)), vx1);
