per_frame_58=vr = if(0.00001 < abs(bounce), vr - 0.85 * (vy3 + vr), vr);
per_frame_59=vr3 = asin(vr / r);
per_frame_60=bounce = below(sqrt(sqr(x1 + vx1 - x2 - vx2) + sqr(y1 + vy1 - y2 - vy2)), 2 * r);
per_frame_61=bounce = bounce * below(sqrt(sqr(x1 + vx1 - x2 - vx2) + sqr(y1 + vy1 - y2 - vy2)), sqrt(sqr(x1 - x2) + sqr(y1 - y2)));
per_frame_62=ref_ang = atan2(x2 - x1, y2 - y1) + asin(1);
per_frame_63=v1 = sqrt(vx1 * vx1 + vy1 * vy1);
per_frame_64=v2 = sqrt(vx2 * vx2 + vy2 * vy2);
per_frame_65=w1 = atan2(vx1, vy1);
per_frame_66=w2 = atan2(vx2, vy2);
per_frame_67=vr = sin(vr1) * r;
per_frame_68=v2r = sin(vr2) * r;
per_frame_69=vx1 = if(0.00001 < abs(bounce), sin(ref_ang) * v1 * cos(w1 - ref_ang) + 0.1 * (vr - v2r - sin(ref_ang) * v1 * cos(w1 - ref_ang)) + sin(ref_ang + asin(1)) * v2 * cos(w2 - ref_ang - asin(1)), vx1);
per_frame_70=vy1 = if(0.00001 < abs(bounce), cos(ref_ang) * v1 * cos(w1 - ref_ang) + 0.1 * (vr - v2r - cos(ref_ang) * v1 * cos(w1 - ref_ang)) + cos(ref_ang + asin(1)) * v2 * cos(w2 - ref_ang - asin(1)), vy1);
per_frame_71=vx2 = if(0.00001 < abs(bounce), sin(ref_ang) * v2 * cos(w2 - ref_ang) + 0.1 * (v2r - vr - sin(ref_ang) * v2 * cos(w2 - ref_ang)) + sin(ref_ang + asin(1)) * v1 * cos(w1 - ref_ang - asin(1)), vx2);
per_frame_72=vy2 = if(0.00001 < abs(bounce), cos(ref_ang) * v2 * cos(w2 - ref_ang) + 0.1 * (v2r - vr - cos(ref_ang) * v2 * cos(w2 - ref_ang)) + cos(ref_ang + asin(1)) * v1 * cos(w1 - ref_ang - asin(1)), vy2);
per_frame_73=vr = if(0.00001 < abs(bounce), vr + 0.9 * (cos(w1 - ref_ang) * (v1 - v2) - vr), vr);
per_frame_74=vr1 = asin(vr / r);
