per_frame_init_1=tg3 = 0;
per_frame_init_2=rg2 = 0;
per_frame_init_3=pfdx_r = 0;
per_frame_init_4=pfthresh = 0;
per_frame_init_5=ocog = 0;
per_frame_init_6=thresh = 0;
per_frame_init_7=cog = 0;
per_frame_init_8=dy_r = 0;
per_frame_init_9=tg2 = 0;
per_frame_init_10=tg1 = 0;
per_frame_init_11=rg3 = 0;
per_frame_init_12=pfdy_r = 0;
per_frame_init_13=rg1 = 0;
per_frame_init_14=q4 = 0;
per_frame_init_15=dx_r = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(4.326 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(7.121 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + (1 - wave_g));
per_frame_4=warp = 0;
per_frame_5=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_6=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_7=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_8=rg1 = abs(sin(time));
per_frame_9=rg2 = 0 * above(rg1, 0.75) + 3 * below(rg1, 0.25) + 1 * above(rg1, 0.25) * below(rg1, 0.5) + 2 * above(rg1, 0.5) * below(rg1, 0.75);
per_frame_10=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_11=wave_a = 0;
per_frame_12=cog = ocog + 0.005 * (bass + bass_att + bass * bass_att - 2);
per_frame_13=ocog = below(cog, 30000) * cog;
per_frame_14=q4 = cog;
per_frame_15=ob_r = wave_g;
per_frame_16=ob_b = wave_r;
per_frame_17=ob_g = wave_b;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 6 * dx_r * above(tg1, 0.5) + 6 * dy_r * below(tg1, 0.5);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
per_pixel_7=zoom = zoom + abs(6 * tg3 * (2 / q4 - 2 * cos(5 * ang * rad)));
per_pixel_8=zoom = zoom - abs(6 * tg3 * (2 / q4 - 2 * abs(5 * ang * rad)));
per_pixel_9=warp = warp + 2 * sin(q4);
shape_0_init1=shpt = 0;
shape_0_init2=shpt = 0;
