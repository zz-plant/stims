shape_0_per_frame1=shpt = 2 * above(bass_att, shpt) + (1 - above(bass_att, shpt)) * (0.96 * (shpt - 1.3) + 1.3);
shape_0_per_frame2=sdx_r = 0.015 * equal(shpt, 2) * sin(5 * time) + (1 - equal(shpt, 2)) * sdx_r;
shape_0_per_frame3=sdy_r = 0.015 * equal(shpt, 2) * sin(6 * time) + (1 - equal(shpt, 2)) * sdy_r;
shape_0_per_frame4=sg1 = abs(sin(time));
shape_0_per_frame5=sg2 = 12 * sdx_r * above(sg1, 0.5) + 12 * sdy_r * below(sg1, 0.5);
shape_0_per_frame6=sg3 = if(0.00001 < abs(equal(shpt, 2)), sg2, sg3);
shape_0_per_frame7=ang = ang + q4 + 2;
