per_frame_init_1=t = 0;
per_frame_1=t = 12.3 * time;
per_frame_2=wave_x = wave_x + 0.35 * (0.7 * sin(11.105 * time) + 0.3 * sin(1.821 * time * 15));
per_frame_3=wave_y = wave_y + 0.35 * (0.3 * sin(1.942 * time * 5) + 0.7 * sin(37.83 * time));
per_frame_4=wave_r = wave_r + 0.79 * (0.6 * sin(0.823 * t) + 0.4 * sin(0.916 * t));
per_frame_5=wave_g = wave_g + 0.79 * (0.6 * sin(0.9 * t) + 0.4 * sin(1.023 * t));
per_frame_6=wave_b = wave_b + 0.79 * (0.6 * sin(0.808 * t) + 0.4 * sin(0.949 * t));
per_frame_7=rot = rot + 0.03 * (0.6 * sin(0.38 * time) + 0.4 * sin(0.54 * time));
per_frame_8=dx = dx + 0.002 * (0.6 * sin(0.434 * time) + 0.4 * sin(0.277 * time));
per_frame_9=dy = dy + 0.002 * (0.6 * sin(0.384 * time) + 0.4 * sin(0.477 * time));

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, (uv + (
    ((texture (sampler_main, uv).xyz - ((
      (texture (sampler_blur1, uv).xyz * scale1)
     + bias1) * 5.0)).xy * texsize.zw)
   * 5.0))).xyz + ((
    (texture (sampler_noise_lq, ((uv_orig * texsize.xy) * texsize_noise_lq.zw)).xyz * 2.0)
   - 1.0) * 0.01));
  ret_1 = (ret_1 - 0.00014);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  vec3 tmpvar_3;
  tmpvar_3.z = 0.0;
  tmpvar_3.xy = texsize.zw;
  vec3 tmpvar_4;
  tmpvar_4 = (tmpvar_3 * 1.5);
  ret_1 = (mix (vec3(dot (tmpvar_2.xyz, vec3(0.3333, 0.3333, 0.3333))), tmpvar_2.xyz, vec3(2.5, 2.5, 2.5)) * 0.5);
  ret_1 = (ret_1 + (vec3(5.4, 3.78, 1.62) * clamp (
    (dot (((texture (sampler_blur1, 
      (uv + tmpvar_4.xz)
    ).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29)) - dot (((texture (sampler_blur1, 
      (uv - tmpvar_4.xz)
    ).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29)))
  , 0.0, 1.0)));
  ret_1 = (ret_1 + (vec3(1.08, 2.7, 3.78) * clamp (
    (dot (((texture (sampler_blur1, 
      (uv + tmpvar_4.zy)
    ).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29)) - dot (((texture (sampler_blur1, 
      (uv - tmpvar_4.zy)
    ).xyz * scale1) + bias1), vec3(0.32, 0.49, 0.29)))
  , 0.0, 1.0)));
  ret_1 = (ret_1 * 1.5);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }
