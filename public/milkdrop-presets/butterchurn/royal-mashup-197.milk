wave_2_per_point1=q1 = 0;
wave_2_per_point2=speed = 0.8 * bass_att;
wave_2_per_point3=v = 1000000 * sample + value2 * bass * 0.1;
wave_2_per_point4=xs = xs + sin(v) * speed * atan(1.51 * v);
wave_2_per_point5=ys = ys + sin(v) * speed * atan(10 * v);
wave_2_per_point6=x = 0.5 + 0.5 * sin(0.1 * xs) * cos(0.2 * time + xs);
wave_2_per_point7=y = 0.5 + 0.5 * sin(0.14 * ys) * cos(0.1 * time + xs);
