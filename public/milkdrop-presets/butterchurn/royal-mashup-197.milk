wave_1_init2=speed = 0;
wave_1_init3=v = 0;
wave_1_init4=xs = 0;
wave_1_init5=ys = 0;
wave_1_per_point1=q1 = 0;
wave_1_per_point2=speed = 0.8 * bass_att;
wave_1_per_point3=v = 1000000 * sample + value2 * bass * 0.1;
wave_1_per_point4=xs = xs + sin(v) * speed * atan(1.51 * v);
wave_1_per_point5=ys = ys + sin(v) * speed * atan(10 * v);
wave_1_per_point6=x = 0.5 + 0.5 * sin(0.1 * xs) * cos(0.2 * time + xs);
wave_1_per_point7=y = 0.5 + 0.5 * sin(0.14 * ys) * cos(0.1 * time + xs);
wave_1_per_point8=x = 0.8 * x + 0.1;
wave_1_per_point9=y = 0.8 * y + 0.1;
wave_1_per_point10=x = 0.6 * x + 0.2;
wave_1_per_point11=y = 0.6 * y + 0.2;
wave_1_per_point12=r = 0.5 * sin(1.322 * time) + 0.6;
wave_1_per_point13=g = 0.4 + 0.4 * sin(1.5407 * time + 2 * y);
wave_1_per_point14=b = 0.4 + 0.4 * sin(1.759 * time + 2 * x);
wave_1_per_point15=xs = if(0.00001 < abs(above(xs, 1000)), 0, xs);
wave_1_per_point16=ys = if(0.00001 < abs(above(ys, 1000)), 0, ys);
