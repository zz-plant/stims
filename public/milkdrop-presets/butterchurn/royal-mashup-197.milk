wave_2_per_point9=y = 0.8 * y + 0.1;
wave_2_per_point10=x = 0.25 * x + 0.375;
wave_2_per_point11=y = 0.25 * y + 0.375;
wave_2_per_point12=r = 0.5 * sin(1.622 * time) + 0.6;
wave_2_per_point13=g = 0.4 + 0.4 * sin(1.2407 * time + 2 * y);
wave_2_per_point14=b = 0.4 + 0.4 * sin(1.359 * time + 2 * x);
wave_2_per_point15=xs = if(0.00001 < abs(above(xs, 1000)), 0, xs);
