[preset00]
fRating=5.000000
fGammaAdj=2.700000
nWaveMode=6.000000
bModWaveAlphaByVolume=1.000000
fWaveAlpha=0.496230
fWaveScale=4.695139
fWaveSmoothing=0.495000
fWaveParam=-0.140000
fModWaveAlphaStart=0.670000
fModWaveAlphaEnd=0.970000
fWarpScale=1.331000
fZoom=1.007964
fRot=0.020000
fCX=0.499999
fWarp=0.000156
fSx=0.999667
fSy=0.999900
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fWaveY=0.630000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=du = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=mult = 0;
per_frame_init_4=ang2 = 0;
per_frame_init_5=dv = 0;
per_frame_init_6=q4 = 0;
per_frame_init_7=q2 = 0;
per_frame_init_8=dist = 0;
per_frame_init_9=q3 = 0;
per_frame_1=wave_r = wave_r + 0.35 * (0.6 * sin(0.98 * time) + 0.4 * sin(1.047 * time));
per_frame_2=wave_g = wave_g + 0.35 * (0.6 * sin(0.835 * time) + 0.4 * sin(1.081 * time));
per_frame_3=wave_b = wave_b + 0.35 * (0.6 * sin(0.814 * time) + 0.4 * sin(1.011 * time));
per_frame_4=q1 = 2 * cx - 1 + 0.32 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_5=q2 = 2 * cy - 1 + 0.52 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_6=q3 = 2 * cx - 1 + 0.32 * (0.6 * sin(0.174 * -time) + 0.4 * sin(0.364 * time));
per_frame_7=q4 = 2 * cy - 1 + 0.52 * (0.6 * sin(0.234 * time) + 0.4 * sin(0.271 * -time));
per_frame_8=decay = decay - 0.01 * equal(mod(frame, 5), 0);
per_pixel_1=du = 2 * x - 1 - q1;
per_pixel_2=dv = 2 * y - 1 - q2;
per_pixel_3=dist = sqrt(du * du + dv * dv);
per_pixel_4=ang2 = atan2(du, dv);
per_pixel_5=mult = 0.012 / (dist + 0.4);
per_pixel_6=dx = mult * sin(ang2 - 1.5);
per_pixel_7=dy = mult * cos(ang2 - 1.5);
per_pixel_8=du = 2 * x - 1 - q3;
per_pixel_9=dv = 2 * y - 1 - q4;
per_pixel_10=dist = sqrt(du * du + dv * dv);
per_pixel_11=ang2 = atan2(du, dv);
per_pixel_12=mult = 0.012 / (dist + 0.4);
per_pixel_13=dx = dx + mult * sin(ang2 + 1.5);
per_pixel_14=dy = dy + mult * cos(ang2 + 1.5);

[warp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = texture (sampler_main, uv).xyz;
  vec2 tmpvar_2;
  tmpvar_2 = (normalize((uv - uv_orig)) * texsize.zw);
  vec4 tmpvar_3;
  tmpvar_3.w = 0.0;
  tmpvar_3.xyz = ret_1;
  vec4 tmpvar_4;
  tmpvar_4.w = 0.0;
  tmpvar_4.xyz = max (tmpvar_3, (texture (sampler_main, (uv + tmpvar_2)) * 0.97)).xyz;
  vec4 tmpvar_5;
  tmpvar_5.w = 0.0;
  tmpvar_5.xyz = max (tmpvar_4, (texture (sampler_main, (uv - tmpvar_2)) * 0.97)).xyz;
  vec4 tmpvar_6;
  tmpvar_6.w = 0.0;
  tmpvar_6.xyz = max (tmpvar_5, (texture (sampler_main, (uv + 
    (tmpvar_2 * 2.0)
  )) * 0.9)).xyz;
  ret_1 = (max (tmpvar_6, (texture (sampler_main, 
    (uv - (tmpvar_2 * 2.0))
  ) * 0.9)).xyz * 0.95);
  vec4 tmpvar_7;
  tmpvar_7.w = 1.0;
  tmpvar_7.xyz = ret_1;
  ret = tmpvar_7.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 1.7);
  ret = tmpvar_1.xyz;
 }
