per_frame_init_1=bass_thresh = 0;
per_frame_1=wave_x = 0.5 + 0.2 * (sin(0.678 * time) + sin(0.987 * time));
per_frame_2=wave_y = 0.5 - 0.2 * (sin(0.876 * time) + sin(0.789 * time));
per_frame_3=decay = decay - 0.05 * equal(mod(frame, 16), 1);
per_frame_4=wave_r = 0.8 + 0.2 * sin(1.24 * time);
per_frame_5=wave_g = 0.3 + 0.1 * sin(0.54 * time);
per_frame_6=wave_b = 0.25 + 0.1 * sin(0.677 * time);
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_8=cx = cx + bass_thresh;
per_frame_9=sx = sx - 0.2 * bass_thresh;
per_frame_10=cy = cy + wave_y;
per_frame_11=ib_r = wave_r + 0.35 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_12=ib_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_13=ib_b = wave_b + 0.35 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_14=warp = 0;
per_frame_15=dx = 0.02 * bass;
per_pixel_1=zoom = zoom + 0.005 * tan(ang - ang);
per_pixel_2=cx = 0.05 * band(0, 20 * x - 0.5) + 0.05;
per_pixel_3=cy = 0.05 * band(0, 20 * y - 0.5) + 0.05;
