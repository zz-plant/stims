[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=5.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bSolarize=1.000000
fWaveAlpha=0.032000
fWaveScale=4.778000
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=1.019590
fWarp=0.009100
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderSize=0.050000
fOuterBorderA=0.100000
fInnerBorderSize=0.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_0_samples=16.000000
wavecode_0_thick=1.000000
wavecode_0_additive=1.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=redsine = 0;
per_frame_init_2=bluesine = 0;
per_frame_init_3=thresh = 0;
per_frame_init_4=greenif = 0;
per_frame_init_5=dy_r = 0;
per_frame_init_6=dx_r = 0;
per_frame_init_7=redif = 0;
per_frame_init_8=blueif = 0;
per_frame_init_9=vol = 0;
per_frame_init_10=greensine = 0;
per_frame_1=vol = 0.3333 * (bass + mid + treb_att);
per_frame_2=redsine = 0.5 + 0.15 * bass * sin(1.21 * time);
per_frame_3=greensine = 0.5 + 0.15 * mid * sin(1.133 * time);
per_frame_4=bluesine = 0.5 + 0.15 * treb * sin(1.114 * time);
per_frame_5=redif = if(0.00001 < abs(above(bass, 1.2)), redsine, if(0.00001 < abs(above(redif, 0.95)), 0, 0.5 * redif));
per_frame_6=greenif = if(0.00001 < abs(above(mid, 1.2)), greensine, if(0.00001 < abs(above(greenif, 0.95)), 0, 0.5 * greenif));
per_frame_7=blueif = if(0.00001 < abs(above(treb, 1.2)), bluesine, if(0.00001 < abs(above(blueif, 0.95)), 0, 0.5 * blueif));
per_frame_8=ob_r = redif;
per_frame_9=ob_g = greenif;
per_frame_10=ob_b = blueif;
per_frame_11=wave_x = wave_x + 0.2 * sin(0.32 * time);
per_frame_12=wave_y = wave_y + 0.2 * cos(0.32 * time);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=dx = dx_r + 0.005 * sin(1.463 * time);
per_pixel_5=dy = dy_r + 0.005 * sin(1.222 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_fw_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 mb_1;
  vec3 ret_2;
  ret_2 = mix ((texture (sampler_fw_main, uv).xyz * 5.0), (texture (sampler_fw_main, (
    (0.5 - uv)
   + 0.5)).xyz * 5.0), vec3(0.5, 0.5, 0.5));
  ret_2 = ((ret_2.x * (1.0 - ret_2)) + 1.0);
  ret_2.x = (ret_2.x * (ret_2.x / ret_2.y));
  mb_1.x = texture (sampler_noise_hq, uv).x;
  mb_1.y = ((texture (sampler_blur1, uv).xyz * scale1) + bias1).x;
  mb_1.z = ((texture (sampler_blur2, uv).xyz * scale2) + bias2).x;
  mb_1.w = ((texture (sampler_blur3, uv).xyz * scale3) + bias3).x;
  ret_2 = (ret_2 - ((
    (1.0 - ret_2)
   * texture (sampler_noise_lq, mb_1.xy).xyz).x * mb_1.w));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
