per_frame_init_1=aa = 0;
per_frame_init_2=maxdbass = 0;
per_frame_init_3=q6 = 0;
per_frame_init_4=dbass = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=cheat = 0;
per_frame_init_8=lastbeat = 0;
per_frame_init_9=curscale = 0;
per_frame_init_10=interval = 0;
per_frame_init_11=pbass = 0;
per_frame_init_12=curang = 0;
per_frame_init_13=cursc = 0;
per_frame_init_14=beat = 0;
per_frame_init_15=q7 = 0;
per_frame_init_16=sure = 0;
per_frame_init_17=q8 = 0;
per_frame_init_18=time = 0;
per_frame_1=sure = if(0.00001 < abs(equal(sure, 0)), 0.6, sure);
per_frame_2=interval = if(0.00001 < abs(equal(interval, 0)), 40, interval);
per_frame_3=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), frame - fps, lastbeat);
per_frame_4=dbass = (bass - pbass) / fps;
per_frame_5=beat = above(dbass, 0.6 * maxdbass) * above(frame - lastbeat, fps / 3);
per_frame_6=sure = if(0.00001 < abs(beat * below(abs(frame - (interval + lastbeat)), fps / 5)), min(0.095 + sure, 1), beat * (sure - 0.095) + (1 - beat) * sure * 0.9996);
per_frame_7=sure = max(0.5, sure);
per_frame_8=cheat = if(0.00001 < abs(above(frame, lastbeat + interval + floor(fps / 10)) * above(sure, 0.91)), 1, cheat);
per_frame_9=beat = if(0.00001 < abs(cheat), 1, beat);
per_frame_10=sure = if(0.00001 < abs(cheat), 0.95 * sure, sure);
per_frame_11=maxdbass = max(0.999 * maxdbass, dbass);
per_frame_12=maxdbass = max(0.012, maxdbass);
per_frame_13=maxdbass = min(0.02, maxdbass);
per_frame_14=interval = if(0.00001 < abs(beat), frame - lastbeat, interval);
per_frame_15=lastbeat = if(0.00001 < abs(beat), frame - cheat * floor(fps / 10), lastbeat);
per_frame_16=cheat = 0;
per_frame_17=pbass = bass;
per_frame_18=q1 = beat;
per_frame_19=warp = 0;
per_frame_20=q8 = 55 / fps;
per_frame_21=q7 = min((frame - lastbeat) / interval, 1);
per_frame_22=aa = aa + beat;
per_frame_23=wave_g = q7;
per_frame_24=wave_b = q7;
per_frame_25=curang = 0.97 * curang - q1 * (0.4 + max(bass, 1.5) * randint(20) / 100) * (-1 + 2 * mod(aa, 2)) * q8;
per_frame_26=cursc = 1 + 0.97 * curscale + 0.3 * q8 * beat;
per_frame_27=sx = cursc;
per_frame_28=sy = 1 - (cursc - 1);
per_frame_29=decay = 1 - 0.2 * beat;
per_frame_30=ob_a = 0.2 * beat;
per_frame_31=ib_a = 0.3 * beat;
per_frame_32=q6 = below(mod(aa, 4), 2) * if(0.00001 < abs(equal(mod(aa, 2), 0)), 1, -1);
per_frame_33=q5 = above(mod(aa, 4), 1) * if(0.00001 < abs(equal(mod(aa, 2), 0)), -1, 1);
per_frame_34=wave_x = 0.5 + 0.03 * q7 * q6;
per_frame_35=wave_y = 0.5 + 0.03 * q7 * q5;
per_frame_36=rot = curang;
per_pixel_1=x = x - 0.5;
per_pixel_2=y = 1 - (y + 0.5);
per_pixel_3=zoom = zoom - 0.1 * q8 * below(rad, 0.7) * (1 + 0.5 * (1 - q7));
