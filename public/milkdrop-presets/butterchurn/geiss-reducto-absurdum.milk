[preset00]
fRating=0.000000
nWaveMode=2.000000
fWaveAlpha=0.399000
fWaveScale=1.605000
fWaveSmoothing=0.100000
fWarpScale=2.853000
fZoom=1.042000
fWarp=0.000000
fWaveR=0.600000
fWaveG=0.600000
fWaveB=0.600000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_r = wave_r + 0.4 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.4 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=wave_b = wave_b + 0.4 * (0.6 * sin(0.91 * time) + 0.4 * sin(0.92 * time));
per_frame_4=zoom = zoom + 0.213 * (0.6 * sin(0.339 * time) + 0.4 * sin(0.276 * time));
per_frame_5=rot = rot + 0.05 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_6=cx = cx + 7 * (zoom - 1);
per_frame_7=cy = cy + 2 * rot;
per_frame_8=sx = sx - max(0, bass_att - 1.2);
per_frame_9=sy = sy - max(0, treb_att - 1.2);
