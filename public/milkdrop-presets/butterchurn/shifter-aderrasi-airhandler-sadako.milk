per_frame_1=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_2=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_3=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_frame_4=wave_x = wave_x + 0.2 * sin(0.32 * time);
per_frame_5=wave_y = wave_y + 0.2 * cos(0.32 * time);
per_frame_6=ob_r = wave_r;
per_frame_7=ob_g = wave_g;
per_frame_8=ob_b = wave_b;
per_frame_9=ob_r = 0.3;
per_frame_10=ob_g = 0.3;
per_frame_11=ob_b = 0.3;
per_pixel_1=zoom = zoom - 0.04 * (sin(8 + 6 * sin(0.2 * time) * ang) + 0.3 * sin(sin(2 * time * sin(time) * rad)) - 0.1 * cos(rad));
per_pixel_2=rot = rot + 0.3 * abs(0.746 - rad) * sin(2.2 * (0.5 - rad) + 5.7 * sin(0.1 * time));
per_pixel_3=sx = sx - 0.01 * (0.99 - rad) * sin(0.733 * time) * below(sin(time), 0);
per_pixel_4=sy = sy - 0.01 * (0.99 - rad) * cos(0.953 * time) * above(sin(time), 0);
per_pixel_5=zoom = zoom + 0.015 * (1.5 - rad) * below(rad, 1.5);
