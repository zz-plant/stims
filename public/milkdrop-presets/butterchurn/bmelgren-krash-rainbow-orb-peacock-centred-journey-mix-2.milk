per_frame_init_1=q1 = 0;
per_frame_init_2=q2 = 0;
per_frame_init_3=x_wave_x = 0;
per_frame_init_4=treb_effect = 0;
per_frame_init_5=net_effect = 0;
per_frame_init_6=rot_residual = 0;
per_frame_init_7=bass_thresh = 0;
per_frame_init_8=shift = 0;
per_frame_1=warp = warp / bass;
per_frame_2=x_wave_x = 0.5 + 0.3 * sin(bass + treb + mid);
per_frame_3=wave_r = 1 + sin(6.28 * -x_wave_x);
per_frame_4=wave_g = abs(sin(12.56 * x_wave_x));
per_frame_5=wave_b = sin(6.28 * x_wave_x);
per_frame_6=treb_effect = if(0.00001 < abs(above(treb_att, 1.4)), pow(0.99, treb_att), 1);
per_frame_7=net_effect = if(0.00001 < abs(above(bass_att, 0.8 * treb_att)), 1, treb_effect);
per_frame_8=zoom = net_effect;
per_frame_9=rot = rot + rot_residual / 1.5;
per_frame_10=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_11=shift = tan(7 * time) - 0.05;
per_frame_12=shift = if(0.00001 < abs(above(shift, 0)), 0, if(0.00001 < abs(below(shift, -0.1)), -0.1, shift));
per_frame_13=rot_residual = if(0.00001 < abs(equal(bass_thresh, 2)), shift, rot_residual);
per_frame_14=q1 = net_effect;
per_frame_15=q2 = bass_thresh;
per_pixel_1=rot = rot + if(0.00001 < abs(equal(tan(ang), q1)), rot, tan(q1 - rad) / q2);
