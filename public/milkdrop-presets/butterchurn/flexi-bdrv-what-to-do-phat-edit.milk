per_pixel_4=dy = if(0.00001 < abs(below(dy, -1)), -1, dy);
per_pixel_5=dy = if(0.00001 < abs(above(dy, 1)), 1, dy);
per_pixel_6=sy = if(0.00001 < abs(below(sy, 0.01)), 0.01, sy);
