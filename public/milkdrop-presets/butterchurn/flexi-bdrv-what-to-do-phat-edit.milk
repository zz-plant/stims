per_pixel_9=block = if(0.00001 < abs(below(ak, -0.15)), ak, 0);
per_pixel_10=zoom = if(0.00001 < abs(block), 1, 0.97);
per_pixel_11=rd = sqrt(sqr(0) + sqr(0.2 * sin(3 * y + time / 8) + 0.6));
per_pixel_12=zoom = rd * rd * 2;
per_pixel_13=rd = sqrt(sqr(1.7 * (x - 0.5 - q4)) + sqr(1.2 * (y - 0.5 + q5))) + 0.001;
per_pixel_14=cy = 0.5 - q5;
per_pixel_15=zoom = -3.5 * pow(rd, sin(time) + 3.5) + 0.5;
per_pixel_16=zoom = 0.5 * zoom + 1;
