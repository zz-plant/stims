[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=1.000000
nVideoEchoOrientation=1.000000
nWaveMode=5.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.001000
fWaveScale=1.447722
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fShader=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.015000
fOuterBorderA=1.000000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=pfdx_r = 0;
per_frame_init_2=pfthresh = 0;
per_frame_init_3=thresh = 0;
per_frame_init_4=ladder = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=leafset = 0;
per_frame_init_7=dy_r = 0;
per_frame_init_8=pfdy_r = 0;
per_frame_init_9=leaf = 0;
per_frame_init_10=dx_r = 0;
per_frame_init_11=q2 = 0;
per_frame_init_12=q3 = 0;
per_frame_init_13=leafset = 3;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=pfthresh = 3 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_6=pfdx_r = 0.015 * equal(pfthresh, 3) * sin(5 * time) + (1 - equal(pfthresh, 3)) * pfdx_r;
per_frame_7=pfdy_r = 0.015 * equal(pfthresh, 3) * sin(6 * time) + (1 - equal(pfthresh, 3)) * pfdy_r;
per_frame_8=q1 = wave_r;
per_frame_9=q2 = wave_g;
per_frame_10=q3 = wave_b;
per_frame_11=ob_r = 1 - 0.75 * abs(q1);
per_frame_12=ob_g = 1 - 0.75 * abs(q2);
per_frame_13=ob_b = 1 - 0.75 * abs(q3);
per_frame_14=echo_zoom = echo_zoom + min(max(0.75, 50 * pfdx_r), 1);
per_frame_15=echo_orient = echo_orient + 16 * pfdy_r;
per_frame_16=dx = dx + 15.1 * pfdx_r;
per_frame_17=dy = dy + 15.1 * pfdy_r;
per_frame_18=ob_size = ob_size + 0.005 * bass_att;
per_frame_19=ib_a = ib_a - min(0.5, 0.5 - abs(dx + dy));
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=ladder = abs(sin(1 * time));
per_pixel_5=leaf = 5 * below(ladder, 0.2) + 8 * above(ladder, 0.2) * below(ladder, 0.4) + 12 * above(ladder, 0.4) * below(ladder, 0.6) + 18 * above(ladder, 0.6) * below(ladder, 0.8) + 24 * above(ladder, 0.8);
per_pixel_6=leafset = if(0.00001 < abs(equal(thresh, 2)), leaf, leafset);
per_pixel_7=zoom = zoom + 0.05 * (0.75 - cos(leafset * rad)) * (1 - rad);
per_pixel_8=zoom = zoom - abs(0.05 * (0.75 - cos(4 * rad)));
