per_frame_1=warp = 0;
per_frame_2=decay = 0.999;
per_frame_3=q1 = sin(time);
per_frame_4=q1sgn = sign(q1);
per_frame_5=q1 = abs(q1);
per_frame_6=q1 = pow(q1, 6);
per_frame_7=q1 = q1 * q1sgn;
per_frame_8=q1 = 0.4 * q1 + 0.5;
per_frame_9=q2 = 0.5 + 0.1 * sin(0.548 * time);
per_frame_10=tic = min(time - tin, 0.1);
per_frame_11=tin = time;
per_frame_12=ra = 1;
per_frame_13=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_14=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_15=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_16=rb = 1;
per_frame_17=vav = tic * (vav * (1 / tic - rb) + rb * (bass + treb + mid) * 0.33333);
per_frame_18=tt = tt + tic * treb_avg;
per_frame_19=mt = mt + tic * mid_avg;
per_frame_20=bt = bt + tic * bass_avg;
per_frame_21=vt = vt + tic * (treb_avg + mid_avg + bass_avg) * 0.33333;
per_frame_22=sp = 0.1 * abs(vav - slide);
per_frame_23=slide = if(0.00001 < abs(above(slide, vav)), slide - tic * sp, slide + tic * sp) + (1 - toc) * vav;
per_frame_24=toc = 1;
per_frame_25=q3 = 0.3333 * (treb + bass + mid);
per_frame_26=q3 = q3 * q3 * 0.5 + 0.1;
per_frame_27=q3 = min(q3, 1);
per_frame_28=monitor = floor(4 * q3) / 4;
per_frame_29=q4 = mt;
per_frame_30=q5 = bt;
per_frame_31=cx = q1;
per_frame_32=cy = q2;
per_frame_33=rmod = 0.01 * (0.5 * (treb_avg + mid_avg) - 0.5 * bass_avg);
per_frame_34=rmod = 0.14 * pow(rmod / 0.02, 2);
per_frame_35=rmod = min(0.001, max(rmod, -0.001));
per_frame_36=rmod = rmod * pow(1.1 * sin(time), 2);
per_frame_37=rot = 0.8 * pow(rmod / 0.02, 2);
per_frame_38=q6 = rmod;
per_frame_39=q7 = slide - below(q3, 0.5) * (6 + 2 * sin(24 * time)) * pow(min(1, 2 * (0.5 - q3)), 5);
per_frame_40=q8 = if(0.00001 < abs(above(sin(0.5 * time), 0)), -1, 1);
per_pixel_1=tm = time / rad;
per_pixel_2=a = q1;
per_pixel_3=b = q2;
per_pixel_4=mx = x - a;
per_pixel_5=my = y - b;
per_pixel_6=zm = -0.45;
per_pixel_7=zm = if(0.00001 < abs(above(sin(2.1 * time), 0.95)), 0.45 * max(1 - 0.5 * q3, 0), zm);
per_pixel_8=dis = 0.70710678 * pow(mx * mx + my * my, 0.5);
per_pixel_9=rot = rot * (1 - dis);
per_pixel_10=rot = 20 * rot * q8;
per_pixel_11=limit = 0.05;
per_pixel_12=dx = zm * mx * dis * cos(3.14 * my) * q3;
per_pixel_13=dsign = sign(dx);
per_pixel_14=dx = dx - max(abs(dx) - limit, 0) * dsign;
per_pixel_15=dy = zm * my * dis * cos(3.14 * mx) * q3;
per_pixel_16=dsign = sign(dy);
per_pixel_17=dy = dy - max(abs(dy) - limit, 0) * dsign;
wave_2_init1=sw = 0;
