wave_2_init12=rx = 0;
wave_2_init13=tm = 0;
wave_2_init14=g1 = 0;
wave_2_init15=b1 = 0;
wave_2_per_frame1=t1 = 0.5 * sin(0.236 * time) + 0.5;
wave_2_per_point1=it = (it + 1) * below(it, 25);
wave_2_per_point2=sw = if(0.00001 < abs(equal(it, 0)), randint(2), sw);
wave_2_per_point3=rx = if(0.00001 < abs(sw), 0.001 * randint(1001), randint(2));
wave_2_per_point4=ry = if(0.00001 < abs(sw), randint(2), 0.001 * randint(1001));
wave_2_per_point5=tm = 0.5 * time + 2 * sample;
wave_2_per_point6=vx = if(0.00001 < abs(equal(it, 0)), rx, vx + 0.002 * sw);
wave_2_per_point7=vy = if(0.00001 < abs(equal(it, 0)), ry, vy + 0.002 * (1 - sw));
wave_2_per_point8=x = vx;
wave_2_per_point9=y = vy;
wave_2_per_point10=tm = 1.11 + sample + 2 * t1;
wave_2_per_point11=flux = 0.5 * sin(time);
wave_2_per_point12=fluy = 0.5 * cos(time);
wave_2_per_point13=xfade = max(-abs(x - 0.5 + flux) + 1, 0);
wave_2_per_point14=xfade2 = max(-abs(y - 0.5 + fluy) + 1, 0);
wave_2_per_point15=xfade = 0.5 * (xfade2 + xfade);
wave_2_per_point16=r1 = 0.5 + 0.5 * sin(tm + 0);
wave_2_per_point17=g1 = 0.5 + 0.5 * sin(tm + 2.1);
wave_2_per_point18=b1 = 0.5 + 0.5 * sin(tm + 4.2);
wave_2_per_point19=r = r1 * xfade + g1 * (1 - xfade);
wave_2_per_point20=g = g1 * xfade + b1 * (1 - xfade);
wave_2_per_point21=b = b1 * xfade + r1 * (1 - xfade);
shape_0_init1=q1 = 0;
