  vec2 tmpvar_7;
  tmpvar_7.x = tmpvar_3.x;
  tmpvar_7.y = tmpvar_4.x;
  vec2 x_8;
  x_8 = ((uv - (tmpvar_7 * 4.0)) - tmpvar_5);
  plastic_1.x = (tmpvar_6.x / (1.0 + (16.0 * 
    pow (sqrt(dot (x_8, x_8)), 0.5)
  )));
  vec2 tmpvar_9;
  tmpvar_9.x = tmpvar_3.y;
  tmpvar_9.y = tmpvar_4.y;
