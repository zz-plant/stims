wave_3_per_point16=yq = yp;
wave_3_per_point17=zq = zp;
wave_3_per_point18=ang = 8 * tm + 1;
wave_3_per_point19=sinang = sin(ang);
wave_3_per_point20=cosang = cos(ang);
wave_3_per_point21=xp = xq * sinang + yq * cosang;
wave_3_per_point22=yp = xq * cosang - yq * sinang;
wave_3_per_point23=zp = zq;
wave_3_per_point24=zp = zp - 0.3;
wave_3_per_point25=ang = 3.14 + 1.5 * sin(2 * tm - 0.5);
wave_3_per_point26=sinang = sin(ang);
wave_3_per_point27=cosang = cos(ang);
wave_3_per_point28=xq = xp;
wave_3_per_point29=yq = yp * sinang + zp * cosang;
wave_3_per_point30=zq = yp * cosang - zp * sinang;
wave_3_per_point31=ang = -1 + cos(3.1 * tm + 0.5);
wave_3_per_point32=sinang = sin(ang);
wave_3_per_point33=cosang = cos(ang);
wave_3_per_point34=xp = xq * sinang + yq * cosang;
wave_3_per_point35=yp = xq * cosang - yq * sinang;
wave_3_per_point36=zp = zq;
wave_3_per_point37=zp = zp - 0.35;
wave_3_per_point38=ang = 1.75 * cos(2.3 * tm) - 1.05;
wave_3_per_point39=sinang = sin(ang);
wave_3_per_point40=cosang = cos(ang);
wave_3_per_point41=xq = xp * sinang + zp * cosang;
wave_3_per_point42=yq = yp;
wave_3_per_point43=zq = xp * cosang - zp * sinang;
wave_3_per_point44=ang = 0.5 * cos(tm) - 0.5;
wave_3_per_point45=sinang = sin(ang);
wave_3_per_point46=cosang = cos(ang);
wave_3_per_point47=xp = xq;
wave_3_per_point48=yp = yq * cosang - zq * sinang;
wave_3_per_point49=zp = yq * sinang + zq * cosang;
wave_3_per_point50=zp = zp + 2;
wave_3_per_point51=xs = xp / zp;
wave_3_per_point52=ys = yp / zp;
wave_3_per_point53=x = xs + 0.5;
wave_3_per_point54=y = 1.3 * ys + 0.5;
wave_3_per_point55=a = if(0.00001 < abs(equal(q8, 1)), 1 - sample, sample);
wave_3_per_point56=a = a * a;
wave_3_per_point57=a = a * above(sin(128 * tm * t8), 0);
wave_3_per_point58=r = t4;
wave_3_per_point59=g = t5;
wave_3_per_point60=b = t6;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (max (texture (sampler_main, uv).xyz, texture (sampler_main, (vec2(1.0, 1.0) - uv)).xyz) * 0.98);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 plastic_1;
  vec2 tmpvar_2;
  tmpvar_2 = (texsize.zw * 8.0);
  vec3 tmpvar_3;
