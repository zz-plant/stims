per_frame_32=q11 = radi / 220 + 0.05;
per_frame_33=trig = bnot(q27) * q24;
per_frame_34=dray = bnot(trig) * dray + trig * randint(10);
per_frame_35=q12 = 0.02;
per_frame_36=q13 = abs(sin(time / 12));
per_frame_37=q30 = aspectx / aspecty;
per_frame_38=monitor = q13;
per_frame_39=vis = vis * dec_slow + (1 - dec_slow) * above(q28, 2);
