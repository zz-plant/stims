per_frame_init_1=bass_thresh = 0;
per_frame_init_2=cx_residual = 0;
per_frame_init_3=treb_thresh = 0;
per_frame_init_4=cy_residual = 0;
per_frame_init_5=mid_thresh = 0;
per_frame_init_6=rot_residual = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.5 * bass;
per_frame_3=wave_g = wave_g + 0.5 * treb;
per_frame_4=wave_b = wave_b + 0.5 * mid;
per_frame_5=ib_r = ib_r + 0.4 * sin(0.222 * time);
per_frame_6=ib_g = ib_g + 0.4 * sin(0.333 * time);
per_frame_7=ib_b = ib_b + 0.4 * sin(0.111 * time);
per_frame_8=ib_a = ib_a + 0.05 * sin(0.555 * time);
per_frame_9=ib_size = ib_size + 0.24 * sin(0.444 * time);
per_frame_10=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_11=cx_residual = 0.016 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * cx_residual;
per_frame_12=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_13=cy_residual = 0.016 * equal(treb_thresh, 2) * sin(7 * time) + (1 - equal(treb_thresh, 2)) * cy_residual;
per_frame_14=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_15=rot_residual = 0.016 * equal(mid_thresh, 2) * sin(7 * time) + (1 - equal(mid_thresh, 2)) * rot_residual;
per_frame_16=cx = cx_residual + sin(0.888 * time);
per_frame_17=cy = cy_residual + sin(0.999 * time);
per_frame_18=rot = 3 * rot_residual;
per_pixel_1=zoom = zoom + 0.07 * cos(10 * rad * sin(0.666 * time));
