wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=d = 0;
per_frame_init_2=cx1 = 0;
per_frame_init_3=y3 = 0;
per_frame_init_4=y1 = 0;
per_frame_init_5=cy1 = 0;
per_frame_init_6=x1 = 0;
per_frame_init_7=q6 = 0;
per_frame_init_8=x3 = 0;
per_frame_init_9=dir = 0;
per_frame_init_10=r = 0;
per_frame_init_11=x2 = 0;
per_frame_init_12=y2 = 0;
per_frame_init_13=q7 = 0;
per_frame_1=ib_r = 0.3 * sin(5 * time) + 0.7;
per_frame_2=ib_g = 0.3 * sin(4 * time) + 0.3;
per_frame_3=ib_b = 0.5 * sin(4 * (time / 3)) + 0.5;
per_frame_4=wave_r = 1 - ib_r;
per_frame_5=wave_g = 1 - ib_g;
per_frame_6=wave_b = 1 - ib_b;
per_frame_7=wave_x = 0.5 + 0.3 * sin(3 * time);
per_frame_8=wave_y = 0.5 + 0.3 * cos(2.187 * time);
per_frame_9=q6 = cos(0.77 * time);
per_frame_10=q7 = cos(0.57 * time);
per_pixel_1=r = bass / 4;
per_pixel_2=cx1 = 0.5 + 0.2 * sin(0.618 * time);
per_pixel_3=cy1 = 0.5 + 0.2 * cos(1.618 * time);
per_pixel_4=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_5=dir = bass * (r * r - d * d) * 0.3;
per_pixel_6=x1 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_7=y1 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_8=cx1 = 0.5 + 0.3 * sin(2.618 * time);
per_pixel_9=cy1 = 0.5 + 0.3 * cos(3.14 * time);
per_pixel_10=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_11=dir = -mid * (r * r - d * d) * 0.3;
per_pixel_12=x2 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_13=y2 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_14=cx1 = 0.5 + 0.4 * sin(2.618 * -time);
per_pixel_15=cy1 = 0.5 + 0.4 * cos(1.14 * -time);
per_pixel_16=d = sqrt((x - cx1) * (x - cx1) + (y - cy1) * (y - cy1));
per_pixel_17=dir = -treb * (r * r - d * d) * 0.3;
per_pixel_18=x3 = if(0.00001 < abs(above(d, r)), 0, sin(y - cy1) * dir);
per_pixel_19=y3 = if(0.00001 < abs(above(d, r)), 0, -sin(x - cx1) * dir);
per_pixel_20=dx = x1 + x2 + x3;
per_pixel_21=dy = y1 + y2 + y3;

[warp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = bass;
  tmpvar_1.y = treb;
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (mix (uv, uv_orig, vec2(-1.0, -1.0)) + texsize.zw)).xy - 0.37)
   * 
    (0.005 + (0.045 * clamp ((tmpvar_1 - 1.0), 0.0, 1.0)))
  ))).xyz - 0.001);
  ret = tmpvar_2.xyz;
 }

[comp_shader]
shader_body { 
  vec3 N_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = (texsize.zw * 4.0);
  N_1.x = (((
    (texture (sampler_blur2, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale2)
   + bias2) - (
    (texture (sampler_blur2, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale2)
   + bias2)).x * 0.7);
  N_1.y = (((
    (texture (sampler_blur2, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale2)
   + bias2) - (
    (texture (sampler_blur2, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale2)
   + bias2)).x * 0.7);
  N_1.x = (N_1.x + ((
    ((texture (sampler_blur1, (uv + (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
   - 
    ((texture (sampler_blur1, (uv - (vec2(1.0, 0.0) * tmpvar_3))).xyz * scale1) + bias1)
  ).x * 0.3));
  N_1.y = (N_1.y + ((
    ((texture (sampler_blur1, (uv + (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
   - 
    ((texture (sampler_blur1, (uv - (vec2(0.0, 1.0) * tmpvar_3))).xyz * scale1) + bias1)
  ).x * 0.3));
  N_1.z = -0.05;
  vec3 tmpvar_4;
  tmpvar_4 = normalize(N_1);
  N_1 = tmpvar_4;
  vec3 tmpvar_5;
  tmpvar_5.z = -0.8;
  tmpvar_5.x = q6;
  tmpvar_5.y = q7;
  vec3 tmpvar_6;
  tmpvar_6.z = 0.0;
  tmpvar_6.xy = ((uv_orig * 2.0) - 1.0);
  vec3 tmpvar_7;
  tmpvar_7 = normalize((tmpvar_5 - tmpvar_6));
  vec3 tmpvar_8;
  tmpvar_8 = normalize((tmpvar_6 - vec3(0.0, 0.0, 1.0)));
  ret_2 = (vec3(clamp (dot (tmpvar_4, tmpvar_7), 0.0, 1.0)) * normalize((
    ((texture (sampler_blur3, uv_orig).xyz * scale3) + bias3)
   + 0.05)));
  ret_2 = (ret_2 + (pow (
    clamp (dot (normalize((tmpvar_8 + 
      ((2.0 * tmpvar_4) * dot (tmpvar_8, tmpvar_4))
    )), tmpvar_7), 0.0, 1.0)
  , 16.0) * 0.5));
  vec4 tmpvar_9;
  tmpvar_9.w = 1.0;
  tmpvar_9.xyz = ret_2;
  ret = tmpvar_9.xyz;
 }
