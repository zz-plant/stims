per_frame_1=vol = 8 * bass + 5 * mid + 3 * treb;
per_frame_2=m = 0.97 * m + 0.08 * vol;
per_frame_3=monitor = vol;
per_frame_4=beat = above(vol, res) * above(vol, m) * above(vol, 16);
per_frame_5=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_6=res = beat * (vol + 0.1 * m) + (1 - beat) * (res - 60 * (0.1 + 0.02 * diff) / fps);
per_frame_7=res = max(0, res);
per_frame_8=x = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, x);
per_frame_9=y = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, y);
per_frame_10=q1 = x;
per_frame_11=q2 = y;
per_frame_12=wave_x = q1;
per_frame_13=wave_y = 1 - q2;
per_frame_14=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_15=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_16=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_17=x1 = 0.5 + 2 * (xx1 - xx2);
per_frame_18=y1 = 0.4 + yy1;
per_frame_19=x1 = max(0, min(1, x1));
per_frame_20=y1 = max(0, min(1, y1));
per_frame_21=spring = 10;
per_frame_22=grav = 0.5;
per_frame_23=resist = 1;
per_frame_24=bounce = 0.75;
per_frame_25=dt = 0.001 * (60 / fps);
per_frame_26=vx2 = vx2 * (1 - resist * dt) + dt * (x1 + x3 - 2 * x2) * spring;
per_frame_27=vy2 = vy2 * (1 - resist * dt) + dt * ((y1 + y3 - 2 * y2) * spring - grav);
per_frame_28=vx3 = vx3 * (1 - resist * dt) + dt * (x2 + x4 - 2 * x3) * spring;
per_frame_29=vy3 = vy3 * (1 - resist * dt) + dt * ((y2 + y4 - 2 * y3) * spring - grav);
per_frame_30=vx4 = vx4 * (1 - resist * dt) + dt * (x3 - x4) * spring;
per_frame_31=vy4 = vy4 * (1 - resist * dt) + dt * ((y3 - y4) * spring - grav);
per_frame_32=x2 = x2 + vx2;
per_frame_33=y2 = y2 + vy2;
per_frame_34=x3 = x3 + vx3;
per_frame_35=y3 = y3 + vy3;
per_frame_36=x4 = x4 + vx4;
per_frame_37=y4 = y4 + vy4;
per_frame_38=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, abs(vx2) * bounce);
per_frame_39=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, -abs(vx2) * bounce);
per_frame_40=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, abs(vx3) * bounce);
per_frame_41=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, -abs(vx3) * bounce);
per_frame_42=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, abs(vx4) * bounce);
per_frame_43=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, -abs(vx4) * bounce);
per_frame_44=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, abs(vy2) * bounce);
per_frame_45=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, -abs(vy2) * bounce);
per_frame_46=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, abs(vy3) * bounce);
per_frame_47=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, -abs(vy3) * bounce);
per_frame_48=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, abs(vy4) * bounce);
per_frame_49=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, -abs(vy4) * bounce);
