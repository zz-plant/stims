per_pixel_10=m1 = 25 * q11;
per_pixel_11=t1 = 0.05;
per_pixel_12=xx = q4;
per_pixel_13=yy = 1 - q8;
per_pixel_14=x1 = xx + cos(dir + 1.5708) * b1;
per_pixel_15=y1 = yy - sin(dir + 1.5708) * b1;
per_pixel_16=x2 = xx - cos(dir + 1.5708) * b1;
per_pixel_17=y2 = yy + sin(dir + 1.5708) * b1;
per_pixel_18=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * b1;
per_pixel_19=si1 = 1 - 1 / (1 + pow(2, 1000 * -d1));
per_pixel_20=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * b1;
per_pixel_21=si2 = 1 - 1 / (1 + pow(2, 1000 * -d2));
per_pixel_22=si3 = 0 * -pow(q5, 3);
per_pixel_23=dx = dx + 12 * (si1 * sin(y1 - y) * m1 * d1 - si2 * sin(y2 - y) * m1 * d2 + si3 * cos(dir) * t1);
per_pixel_24=dy = dy + 12 * (-si1 * sin(x1 - x) * m1 * d1 + si2 * sin(x2 - x) * m1 * d2 - si3 * sin(dir) * t1);
