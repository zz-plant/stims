per_frame_60=q12 = atan2(vx4, vy4);
per_frame_61=q11 = sqrt(vx4 * vx4 + vy4 * vy4);
per_pixel_1=cx = q1;
per_pixel_2=cy = q2;
per_pixel_3=d = pow(sqrt(sqr(x - cx) + sqr(y - cy)), 0.8);
per_pixel_4=r = 0.2;
per_pixel_5=v = 0.2;
