wave_3_per_point1=sample = 1 - sample;
wave_3_per_point2=xxx = xx;
wave_3_per_point3=yyy = yy;
wave_3_per_point4=xx = pow(sample, 5) * t1 + 5 * pow(sample, 4) * (1 - sample) * t1 + 10 * pow(sample, 3) * sqr(1 - sample) * t2 + 10 * sqr(sample) * pow(1 - sample, 3) * t3 + 5 * pow(1 - sample, 4) * sample * t4 + pow(1 - sample, 5) * t4;
wave_3_per_point5=yy = pow(sample, 5) * t5 + 5 * pow(sample, 4) * (1 - sample) * t5 + 10 * pow(sample, 3) * sqr(1 - sample) * t6 + 10 * sqr(sample) * pow(1 - sample, 3) * t7 + 5 * pow(1 - sample, 4) * sample * t8 + pow(1 - sample, 5) * t8;
wave_3_per_point6=d = 1 / sqrt(sqr(xx - xxx) + sqr(yy - yyy));
wave_3_per_point7=dd = 0.95 * dd + value1;
wave_3_per_point8=ddd = dd * sample * (1 - sample) * d;
wave_3_per_point9=ddd = sample * (1 - sample) * sin(120 * sample) * d * 0.1;
wave_3_per_point10=x = xx + (yy - yyy) * ddd;
wave_3_per_point11=y = yy - (xx - xxx) * ddd;
wave_3_per_point12=x = 0.5 + (x - 0.5) * q9;
wave_3_per_point13=y = 0.5 + (y - 0.5) * q10;
shape_0_per_frame1=x = randint(1000) / 1000;
shape_0_per_frame2=y = randint(1000) / 1000;
shape_0_per_frame3=ang = randint(150) / 100;
