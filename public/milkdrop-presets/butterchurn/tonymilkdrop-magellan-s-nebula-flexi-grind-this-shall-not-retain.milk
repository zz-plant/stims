per_frame_init_1=q1 = 0;
per_frame_1=q1 = 0.0003 * pow(1 + 1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6);
per_frame_2=mv_a = q1;
per_frame_3=mv_x = mv_x + sin(time);
per_frame_4=mv_y = mv_y + cos(time);
per_frame_5=mv_dx = mv_dx + 1.25 * sin(8 * fps);
per_frame_6=mv_dy = mv_dy + 1.35 * sin(8 * fps);
per_frame_7=mv_r = mv_r + sin(0.565 * time);
per_frame_8=mv_g = mv_g + sin(0.615 * time);
per_frame_9=mv_b = mv_b + sin(0.665 * time);
per_frame_10=wave_r = wave_r + 0.5 * sin(1.13 * time);
per_frame_11=wave_g = wave_g + 0.5 * sin(1.23 * time);
per_frame_12=wave_b = wave_b + 0.5 * sin(1.33 * time);
per_pixel_1=zoom = zoom + 0.0125 * q1;
per_pixel_2=rot = rot + 0.025 * sin(10 * fps) * q1;
per_pixel_3=warp = 0;
shape_0_init1=q1 = 0;
shape_0_per_frame1=r = r + sin(0.339 * time);
shape_0_per_frame2=g = g + sin(0.369 * time);
shape_0_per_frame3=b = b + sin(0.399 * time);
shape_0_per_frame4=r2 = r2 + sin(0.113 * time);
shape_0_per_frame5=g2 = g2 + sin(0.123 * time);
shape_0_per_frame6=b2 = b2 + sin(0.133 * time);
shape_0_per_frame7=rad = q1 / 3;

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = ((640.0 * texsize.z) * ((2.0 * 
    ((texture (sampler_blur2, (uv + vec2(0.02, 0.0))).xyz * scale2) + bias2)
  ) - (2.0 * 
    ((texture (sampler_blur2, (uv - vec2(0.02, 0.0))).xyz * scale2) + bias2)
  )).y);
  tmpvar_2.y = ((512.0 * texsize.w) * ((2.0 * 
    ((texture (sampler_blur2, (uv + vec2(0.0, 0.02))).xyz * scale2) + bias2)
  ) - (2.0 * 
    ((texture (sampler_blur2, (uv - vec2(0.0, 0.02))).xyz * scale2) + bias2)
  )).y);
  ret_1.y = texture (sampler_pc_main, (uv - (tmpvar_2 * 0.004))).y;
  ret_1.y = (ret_1.y + ((
    (((2.0 * ret_1.y) - (2.0 * (
      (texture (sampler_blur1, uv).xyz * scale1)
     + bias1).y)) - 0.1)
   * 0.05) + 0.02));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec2 dz_1;
  vec3 dy_2;
  vec3 dx_3;
  vec2 d_4;
  vec3 ret_5;
  vec2 tmpvar_6;
  vec2 tmpvar_7;
  tmpvar_7 = (vec2(1.0, 0.0) * texsize.zw);
  tmpvar_6.x = (texture (sampler_main, (uv + tmpvar_7)).xyz - texture (sampler_main, (uv - tmpvar_7)).xyz).y;
  vec2 tmpvar_8;
  tmpvar_8 = (vec2(0.0, 1.0) * texsize.zw);
  tmpvar_6.y = (texture (sampler_main, (uv + tmpvar_8)).xyz - texture (sampler_main, (uv - tmpvar_8)).xyz).y;
  d_4 = (texsize.zw * 2.0);
  dx_3 = (((texture (sampler_blur1, 
    (uv + (vec2(1.0, 0.0) * d_4))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(1.0, 0.0) * d_4))
  ).xyz * scale1) + bias1));
  dy_2 = (((texture (sampler_blur1, 
    (uv + (vec2(0.0, 1.0) * d_4))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv - (vec2(0.0, 1.0) * d_4))
  ).xyz * scale1) + bias1));
  vec2 tmpvar_9;
  tmpvar_9.x = dx_3.y;
  tmpvar_9.y = dy_2.y;
  dz_1 = ((tmpvar_6 * 3.0) + tmpvar_9);
  ret_5 = (vec3(((
    pow ((sqrt(dot (dz_1, dz_1)) * 0.8), 0.7)
   * 2.0) + (
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  .y * 2.0))) * vec3(0.2, 0.3, 0.6));
  vec2 tmpvar_10;
  tmpvar_10.x = q19;
  tmpvar_10.y = q20;
  vec2 tmpvar_11;
  tmpvar_11 = fract(((0.5 + 
    (uv - 0.5)
  ) + (tmpvar_10 * vec2(-1.0, 1.0))));
  vec2 tmpvar_12;
  tmpvar_12.x = dx_3.y;
  tmpvar_12.y = dy_2.y;
  vec3 tmpvar_13;
  tmpvar_13 = ((mix (ret_5, vec3(3.0, 2.0, 1.0), 
    ((texture (sampler_blur3, (tmpvar_11 - tmpvar_12)).xyz * scale3) + bias3)
  .xxx) * (vec3(1.0, 1.0, 1.0) - 
    ((texture (sampler_blur2, (tmpvar_11 - dz_1)).xyz * scale2) + bias2)
  .xxx)) * (vec3(1.0, 1.0, 1.0) - vec3((1.5 * texture (sampler_main, tmpvar_11).x))));
  ret_5 = tmpvar_13;
  vec4 tmpvar_14;
  tmpvar_14.w = 1.0;
  tmpvar_14.xyz = tmpvar_13;
  ret = tmpvar_14.xyz;
 }
