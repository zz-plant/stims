per_frame_1=warp = 0;
per_frame_2=wave_a = 0;
per_pixel_1=zoom = if(0.00001 < abs(above(x, 0.3)), if(0.00001 < abs(below(x, 0.7)), if(0.00001 < abs(below(y, 0.7)), if(0.00001 < abs(above(y, 0.3)), zoom + 0.01, 0.5), 0.5), 0.5), 0.5);
per_pixel_2=dx = if(0.00001 < abs(above(x, 0.3)), if(0.00001 < abs(below(x, 0.7)), if(0.00001 < abs(below(y, 0.7)), if(0.00001 < abs(above(y, 0.3)), 0, 0.5), 0.5), 0.5), 0.5);
per_pixel_3=dy = if(0.00001 < abs(above(x, 0.3)), if(0.00001 < abs(below(x, 0.7)), if(0.00001 < abs(below(y, 0.7)), if(0.00001 < abs(above(y, 0.3)), 0, 0.5), 0.5), 0.5), 0.5);
per_pixel_4=zoom = if(0.00001 < abs(below(zoom, 1)), zoom + -0.4 * x + 0.02 * sin(time + 2 * bass), zoom);
per_pixel_5=zoom = zoom + if(0.00001 < abs(below(zoom, 1)), zoom + 0.2 * (y - 0.5 + 0.5 * sin(0.66 * time)) * sin(0.5 * time), 0);
per_pixel_6=dx = if(0.00001 < abs(above(dx, 0)), (randint(50) - 25) * bass * 0.0045, dx);
per_pixel_7=zoom = zoom + (0.1 + 0.1 * sin(0.3 * time)) * below(zoom, 1) + 0.025;
per_pixel_8=zoom = zoom * above(zoom, 0);
wave_3_per_point1=x = 0.5 + (0.12 + 0.02 * sin(0.8 * time)) * cos(100 * sample * sin(0.1 * time) + 0.8 * time);
wave_3_per_point2=y = 0.5 + (0.12 + 0.02 * sin(time)) * sin(100 * sample * sin(0.5 * time) + 0.5 * time);
wave_3_per_point3=a = -0.7 + sin(1000 * sample + 2 * time);
wave_3_per_point4=a = above(a, 0);
wave_3_per_point5=r = -0.7 + sin(100 * sample + 2 * time);
wave_3_per_point6=g = -0.7 + sin(100 * (sample + 0.4) + 2 * time);
wave_3_per_point7=b = -0.7 + sin(100 * (sample + 0.77) + 2 * time);
