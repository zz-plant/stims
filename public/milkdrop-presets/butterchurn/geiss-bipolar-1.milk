[preset00]
fRating=0.000000
fGammaAdj=1.998000
nWaveMode=3.000000
bWaveThick=1.000000
fWaveAlpha=4.400000
fWaveScale=1.170370
fWaveSmoothing=0.900000
fWarpScale=2.853000
fRot=0.006000
fWarp=0.000000
fWaveR=0.900000
fWaveG=0.450000
fWaveB=0.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_1=wave_r = wave_r + 0.1 * (0.6 * sin(0.933 * time) + 0.4 * sin(1.045 * time));
per_frame_2=wave_g = wave_g + 0.05 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.956 * time));
per_frame_3=decay = decay - 0.01 * equal(mod(frame, 40), 0);
per_frame_4=rot = rot + 0.01 * sin(0.113 * time);
per_frame_5=rot = rot + 0.01 * sin(0.533 * time);
per_frame_6=rot = rot + 0.02 * sin(-0.323 * time);
per_frame_7=dx = dx + dx_residual;
per_frame_8=dy = dy + dy_residual;
per_frame_9=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_10=dx_residual = 0.0072 * equal(bass_thresh, 2) * sin(7 * time) + (1 - equal(bass_thresh, 2)) * dx_residual;
per_frame_11=dy_residual = 0.0054 * equal(bass_thresh, 2) * sin(9 * time) + (1 - equal(bass_thresh, 2)) * dy_residual;
per_pixel_1=zoom = 0.9615 + 0.1 * rad;
per_pixel_2=rot = 3 * rot * (1 - pow(2 * rad - 1, 2));
