[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.970000
fVideoEchoZoom=1.050000
fVideoEchoAlpha=0.200000
nWaveMode=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=100.000000
fWaveScale=0.800000
fWaveSmoothing=0.000000
fWaveParam=-0.400000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fWarpScale=100.000000
fZoomExponent=0.022800
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.000000
fWaveG=0.000000
fWaveB=0.000000
fOuterBorderSize=0.000000
fOuterBorderA=1.000000
fInnerBorderSize=0.250000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_b = wave_b + 0.7 * sin(bass);
per_frame_2=wave_r = wave_r - 0.8 * sin(treb);
per_frame_3=wave_g = wave_g + 0.8 * sin(mid);
per_frame_4=zoom = zoom + 0.008;
per_frame_5=ob_size = ob_size + 0 * sin(8900 * time);
per_frame_6=zoomexp = zoomexp + if(0.00001 < abs(above(bass, 1)), 0.025, 0.099);
per_frame_7=rot = rot + if(0.00001 < abs(above(bass, 1)), 0.01, -0.01);
per_frame_8=warp = warp + if(0.00001 < abs(above(treb, 1)), 0.5, -0.5);
per_frame_9=dy = dy + if(0.00001 < abs(above(mid, 1.5)), 0.01, -0.0025);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec2 tmpvar_2;
  tmpvar_2.x = (((
    ((texture (sampler_blur2, (uv + vec2(0.01, 0.0))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.01, 0.0))).xyz * scale2) + bias2)
  ).y * 1280.0) * texsize.z);
  tmpvar_2.y = (((
    ((texture (sampler_blur2, (uv + vec2(0.0, 0.01))).xyz * scale2) + bias2)
   - 
    ((texture (sampler_blur2, (uv - vec2(0.0, 0.01))).xyz * scale2) + bias2)
  ).y * 1024.0) * texsize.w);
  ret_1.y = texture (sampler_fw_main, (uv + (tmpvar_2 * 0.005))).y;
  ret_1 = (ret_1 + ((
    (ret_1 - ((texture (sampler_blur3, uv).xyz * scale3) + bias3))
   * 0.3) - 0.05));
  ret_1 = (ret_1 + ((texture (sampler_noise_lq, 
    (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 0.25)) + rand_frame.xy)
  ).xyz - 0.5) * 0.1));
  ret_1 = mix (ret_1, vec3(dot (ret_1, vec3(0.32, 0.49, 0.29))), vec3(0.2, 0.2, 0.2));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
