per_frame_init_1=vol_now = 0;
per_frame_init_2=redneg = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=slowtime = 0;
per_frame_init_5=blueneg = 0;
per_frame_init_6=greenneg = 0;
per_frame_init_7=beat = 0;
per_frame_init_8=ff = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=vol_mean = 0;
per_frame_1=slowtime = slowtime + beat * time;
per_frame_2=vol_now = 0.4 * bass + 0.1 * (bass_att + treb + mid);
per_frame_3=vol_mean = if(0.00001 < abs(equal(mod(frame, 50), 0)), vol_mean - 0.5 * (vol_mean - vol_now), 0.1 * (9 * vol_mean + vol_now));
per_frame_4=beat = if(0.00001 < abs(above(vol_now, 1.5 * vol_mean)), 1, 0);
per_frame_5=ib_r = sin(cos(0.235 * slowtime));
per_frame_6=ib_g = sin(cos(0.335 * slowtime));
per_frame_7=ib_b = sin(cos(0.435 * slowtime));
per_frame_8=redneg = if(0.00001 < abs(below(ib_r, 0)), 1, 0);
per_frame_9=greenneg = if(0.00001 < abs(below(ib_g, 0)), 1, 0);
per_frame_10=blueneg = if(0.00001 < abs(below(ib_b, 0)), 1, 0);
per_frame_11=ib_r = 1 - if(0.00001 < abs(redneg), if(0.00001 < abs(bor(greenneg, blueneg)), 1, 1 + ib_r), ib_r);
per_frame_12=ib_g = 1 - if(0.00001 < abs(greenneg), if(0.00001 < abs(equal(greenneg + blueneg, 2)), 1, 1 + ib_g), ib_g);
per_frame_13=ib_b = 1 - if(0.00001 < abs(blueneg), 1 + ib_b, ib_b);
per_frame_14=ff = slowtime / 100;
per_frame_15=wave_r = sin(5 * ff / bass) / 2 + 0.5;
per_frame_16=wave_g = cos(ff / mid) / 2 + 0.5;
per_frame_17=wave_b = cos(3 * ff / treb) / 2 + 0.5;
per_frame_18=rot = rot + 0.04 * (0.6 * sin(0.381 * slowtime) + 0.4 * sin(0.579 * slowtime));
per_frame_19=zoom = max(0.97, min(0.15 + 0.7 * bass_att, 1.75));
per_frame_20=ob_r = sin(beat * cos(0.735 * slowtime));
per_frame_21=ob_g = sin(bass * cos(0.635 * slowtime));
per_frame_22=ob_b = sin(bass * cos(0.535 * slowtime));
per_frame_23=redneg = if(0.00001 < abs(below(ob_r, 0)), 1, 0);
per_frame_24=greenneg = if(0.00001 < abs(below(ob_g, 0)), 1, 0);
per_frame_25=blueneg = if(0.00001 < abs(below(ob_b, 0)), 1, 0);
per_frame_26=ob_r = 1 - if(0.00001 < abs(redneg), if(0.00001 < abs(bor(greenneg, blueneg)), 1, 1 + ob_r), ob_r);
per_frame_27=ob_g = 1 - if(0.00001 < abs(greenneg), if(0.00001 < abs(equal(greenneg + blueneg, 2)), 1, 1 + ob_g), ob_g);
per_frame_28=ob_b = 1 - if(0.00001 < abs(blueneg), 1 + ob_b, ob_b);
per_frame_29=q1 = sin(slowtime);
per_pixel_1=q2 = above(rad, 0.603);
per_pixel_2=rot = rot + if(0.00001 < abs(q2), 0, 0.5 * sin(0.7243 * time));
per_pixel_3=zoom = zoom + if(0.00001 < abs(q2), 0, rad * sin(0.734 * time) * 0.8);
per_pixel_4=warp = warp + if(0.00001 < abs(above(rad, 0.2166)), sin(ang * rad), 0);
shape_0_init1=q1 = 0;
shape_0_per_frame1=ang = 1.4 * time;
shape_0_per_frame2=x = 0.5 + 0.08 * cos(1.1 * time) + 0.015 * cos(0.7 * time);
shape_0_per_frame3=y = q1 + 0.02 * sin(1.3 * time) + 0.02 * sin(0.2 * time);
shape_0_per_frame4=r = 0.5 + 0.25 * sin(0.713 * time + 1);
shape_0_per_frame5=g = 0.5 + 0.25 * sin(0.563 * time + 2);
shape_0_per_frame6=b = 0.5 + 0.25 * sin(0.654 * time + 5);
shape_0_per_frame7=r2 = 0.5 + 0.25 * sin(0.885 * time + 4);
shape_0_per_frame8=g2 = 0.5 + 0.25 * sin(0.556 * time + 1);
shape_0_per_frame9=b2 = 0.5 + 0.25 * sin(0.638 * time + 3);
