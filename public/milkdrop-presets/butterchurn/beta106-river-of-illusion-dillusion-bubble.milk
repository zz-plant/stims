per_frame_init_1=beet = 0;
per_frame_init_2=beetcd = 0;
per_frame_init_3=beeta = 0;
per_frame_init_4=cdelay1 = 0;
per_frame_init_5=cdelay2 = 0;
per_frame_init_6=beetb = 0;
per_frame_init_7=beetc = 0;
per_frame_init_8=bas = 0;
per_frame_init_9=trebtemp = 0;
per_frame_init_10=bass_thresh = 0;
per_frame_init_11=beetab = 0;
per_frame_init_12=counter2 = 0;
per_frame_init_13=treb_thresh = 0;
