per_frame_init_27=basstemp = 0;
per_frame_init_28=trasstemp = 0;
per_pixel_1=rot = rot + 0.05 * sin(rad - (0.1 * time + bas));
per_pixel_2=bas = 2.5 * bass;
per_pixel_3=bos = bass;
per_pixel_4=warp = 0.1 * (bos + bass + bass);
per_pixel_5=cx = 0.5 * (cx + treb);
per_pixel_6=q2 = q4 * (bass + 0.25);
per_pixel_7=warp = q4 - q2;
per_pixel_8=dx = dy + 0.01;
per_pixel_9=dy = dx - 0.01;
per_pixel_10=basstemp = bass + bass_att + bass_thresh;
per_pixel_11=trebtemp = treb + treb_att + treb_thresh;
per_pixel_12=trasstemp = max(basstemp, trebtemp);
per_pixel_13=trassave = trasstemp / 3;
per_pixel_14=basst = max(bass + bass_att, treb + treb_att);
per_pixel_15=trebb = min(basst + bass_thresh, basst + treb_thresh);
per_pixel_16=midbeat = trebb / 3;
per_pixel_17=midtb = max(midbeat + mid, midbeat + mid_att);
per_pixel_18=mtb = midtb / 2.25;
per_pixel_19=beeta = (max(treb, bass) + min(treb_att, bass_att)) / 2;
per_pixel_20=beetb = (max(mid, beeta) + min(mid_att, 0.5 * beeta)) / 2;
per_pixel_21=beetab = (beeta + beetb) / 2;
per_pixel_22=beetc = (max(mid, treb) + min(mid_att, treb_att)) / 2;
per_pixel_23=beetd = (max(bass, beetc) + min(bass_att, 0.5 * beetc)) / 2;
per_pixel_24=beetcd = (beetc + beetd) / 2;
per_pixel_25=beet = (beetab + beetcd) / 2;
per_pixel_26=madbeat = (trassave + mtb + beet) / 3;
shape_1_per_frame1=ang = ang + 0.2 * bass + 0.4 * time;
shape_1_per_frame2=x = 0.09 * sin(time) + 0.5;
shape_1_per_frame3=y = 0.09 * sin(time / 5) + 0.5;
