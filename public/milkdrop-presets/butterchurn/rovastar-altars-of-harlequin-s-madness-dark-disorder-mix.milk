per_frame_1=q8 = oldq8 + 0.001 * (pow(1.2 * bass + 0.4 * bass_att + 0.2 * treb + 0.2 * treb_att + 0.2 * mid + 0.2 * mid_att, 6) / fps) + 0.1 / fps;
per_frame_2=oldq8 = q8;
per_frame_3=ob_r = 0.3 - 0.3 * (0.5 * sin(0.701 * q8) + 0.3 * cos(0.438 * q8));
per_frame_4=ob_g = 0.6 - 0.4 * sin(2.924 * q8);
per_frame_5=ob_b = 0.35 - 0.3 * cos(0.816 * q8);
per_frame_6=warp = 0;
per_frame_7=ib_size = 0.02;
per_frame_8=ib_r = ib_r + 0.5 * sin(3.034 * q8);
per_frame_9=ib_g = ib_g + 0.5 * sin(2.547 * q8);
per_frame_10=ib_b = ib_b - 0.5 * sin(1.431 * q8);
per_frame_11=ib_r = 0;
per_frame_12=ib_g = 0;
per_frame_13=ib_b = 0;
per_frame_14=volume = 0.15 * (bass_att + bass + mid + mid_att);
per_frame_15=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_16=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_17=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_18=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_19=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_20=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_21=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_22=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_23=mybeat = if(0.00001 < abs(beat), mybeat + 1, mybeat);
per_frame_24=mybeat = if(0.00001 < abs(above(mybeat, 7)), 0, mybeat);
per_frame_25=mybeat2 = if(0.00001 < abs(equal(mybeat, 1)), 1, 0);
per_frame_26=q7 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq7);
per_frame_27=oldq7 = q7;
per_frame_28=q6 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq6);
per_frame_29=oldq6 = q6;
per_frame_30=q5 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq5);
per_frame_31=oldq5 = q5;
per_frame_32=q4 = if(0.00001 < abs(beat * mybeat2), 0.001 + 0.0001 * randint(40), oldq4);
per_frame_33=oldq4 = q4;
per_frame_34=flag = if(0.00001 < abs(beat * mybeat2), if(0.00001 < abs(randint(2) - 1), 1, 0), oldflag);
per_frame_35=oldflag = flag;
per_frame_36=ratio = if(0.00001 < abs(beat * mybeat2), 100 + randint(60), oldratio);
per_frame_37=oldratio = ratio;
per_frame_38=q3 = if(0.00001 < abs(beat * mybeat2), if(0.00001 < abs(flag), ratio, 0.75 * ratio), oldq3);
per_frame_39=oldq3 = q3;
per_frame_40=q2 = if(0.00001 < abs(beat * mybeat2), if(0.00001 < abs(flag), 0.75 * ratio, ratio), oldq2);
per_frame_41=oldq2 = q2;
per_frame_42=solarize = beat;
per_pixel_1=box = 0.7 * sqrt(2) - rad + mod(0.8 * abs(3 * x - 0.4 * sin(q1)), 2) + mod(0.8 * abs(3 * y + 0.4 * sin(q1)), 2);
per_pixel_2=q1 = 8.3 + (sin(x + 0.137 * q8) - cos(y + 0.213 * q8));
per_pixel_3=zoom = if(0.00001 < abs(above(box, 1)), 0.1 * q1, zoom);
per_pixel_4=rot = if(0.00001 < abs(above(box, 1)), 0.1 * rad + sin(0.385 * q8), rot);
per_pixel_5=dx = if(0.00001 < abs(above(box, 1)), dx, q4 * sin((y - 0.5) * q3) + q5 * sin((y - 0.5) * q2));
per_pixel_6=dy = if(0.00001 < abs(above(box, 1)), dy, q6 * cos((x - 0.5) * q2) + q7 * cos((x - 0.5) * q3));
