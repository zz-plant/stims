per_frame_1=warp = 0;
per_frame_2=tic = min(time - tin, 0.1);
per_frame_3=tin = time;
per_frame_4=vol = 0.333333 * (bass_att + treb_att + mid_att);
per_frame_5=ra = 0.25 * (1 / tic);
per_frame_6=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_7=mid_avg = tic * (mid_avg * (1 / tic - ra) + ra * mid);
per_frame_8=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_9=vav = tic * (vav * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_10=tt = tt + tic * treb;
per_frame_11=mt = mt + tic * mid;
per_frame_12=bt = bt + tic * bass;
per_frame_13=vt = vt + tic * vav;
per_frame_14=q1 = 3 * tt;
per_frame_15=q2 = 3 * mt;
per_frame_16=q3 = 3 * bt;
per_frame_17=q4 = vt;
per_frame_18=rb = if(0.00001 < abs(rb), rb, 0.2 + 0.0006 * randint(1001));
per_frame_19=rc = if(0.00001 < abs(rc), rc, 0.2 + 0.0006 * randint(1001));
per_frame_20=rd = if(0.00001 < abs(rd), rd, 0.2 + 0.0006 * randint(1001));
per_frame_21=re = if(0.00001 < abs(re), re, 0.2 + 0.0006 * randint(1001));
per_frame_22=rot = 0.26;
per_frame_23=cx = 0.3 + 0.1 * sin(vt * re) + 0.1 * cos(vt * rc);
per_frame_24=cy = 0.5 + 0.2 * sin(vt * rb) + 0.1 * cos(vt * rd);
per_frame_25=q5 = 0.035 * min(1, 0.5 * treb_avg);
per_frame_26=q6 = 0.035 * min(1, 0.5 * mid_avg);
per_frame_27=q7 = 0.035 * min(1, 0.5 * bass_avg);
per_pixel_1=num = 8;
per_pixel_2=pi = 3.141592654;
per_pixel_3=radi = 0.75 * (y - 0.5);
per_pixel_4=radi = y - 0.5;
per_pixel_5=radi = pow(radi * radi + (x - 0.5) * (x - 0.5), 0.5);
per_pixel_6=an = ang + pi + time;
per_pixel_7=an = an - 2 * pi * floor(an / (2 * pi));
per_pixel_8=mod = 0.1;
per_pixel_9=seg = ang + pi;
per_pixel_10=seg = seg / (2 * pi) * num;
per_pixel_11=seg = floor(seg);
per_pixel_12=seg = seg - equal(seg, num);
per_pixel_13=anga = ang + pi - 2 * pi / num * seg;
per_pixel_14=anga = if(0.00001 < abs(equal(mod(seg, 2), 0)), 2 * pi / num - anga, anga);
per_pixel_15=anga = anga + pi / 4;
per_pixel_16=ox = 0.5 - radi * sin(anga);
per_pixel_17=oy = 0.5 + radi * cos(anga);
per_pixel_18=dx = equal(seg, 3) * (x - ox);
per_pixel_19=dy = equal(seg, 3) * (y - oy);
per_pixel_20=dx = above(seg, 0) * (x - ox);
per_pixel_21=dy = above(seg, 0) * (y - oy);
