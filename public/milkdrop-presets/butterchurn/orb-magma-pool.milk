per_frame_init_1=basstime = 0;
per_frame_init_2=stickybit = 0;
per_frame_init_3=volavg2 = 0;
per_frame_init_4=q6 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=sample1 = 0;
per_frame_init_8=diff = 0;
per_frame_init_9=edge = 0;
per_frame_init_10=q4 = 0;
per_frame_init_11=volavg = 0;
per_frame_init_12=bit2 = 0;
per_frame_init_13=vol = 0;
per_frame_init_14=q2 = 0;
per_frame_init_15=q3 = 0;
per_frame_init_16=basssum = 0;
per_frame_init_17=sample2 = 0;
per_frame_1=basstime = basstime + 0.006 * bass;
per_frame_2=q2 = basstime;
per_frame_3=q1 = 0.001 * basstime;
per_frame_4=q4 = cos(basstime);
per_frame_5=q5 = sin(basstime);
per_frame_6=vol = pow(bass + mid + treb, 2);
per_frame_7=basssum = vol;
per_frame_8=stickybit = mod(time, 2);
per_frame_9=volavg = volavg + vol * equal(stickybit, 1);
per_frame_10=sample1 = sample1 + equal(stickybit, 1);
per_frame_11=volavg2 = volavg2 + vol * equal(stickybit, 0);
per_frame_12=sample2 = sample2 + equal(stickybit, 0);
per_frame_13=edge = bnot(equal(bit2, stickybit));
per_frame_14=volavg = volavg - volavg * edge * stickybit;
per_frame_15=volavg2 = volavg2 - volavg2 * edge * equal(stickybit, 0);
per_frame_16=sample1 = sample1 - sample1 * edge * stickybit;
per_frame_17=sample2 = sample2 - sample2 * edge * equal(stickybit, 0);
per_frame_18=diff = if(0.00001 < abs(equal(stickybit, 1)), basssum / (volavg2 / sample2), 0);
per_frame_19=diff = if(0.00001 < abs(equal(stickybit, 0)), basssum / (volavg / sample1), diff);
per_frame_20=q3 = 0;
per_frame_21=q6 = diff;
per_frame_22=bit2 = mod(time, 2);
per_frame_23=monitor = 5 * (diff - 1);
per_pixel_1=zoom = 0.2;
per_pixel_2=rot = 0;
shape_0_init1=basstime = 0;
shape_0_init2=ob_r = 0;
shape_0_init3=ob_g = 0;
shape_0_init4=ob_b = 0;
shape_0_per_frame1=ang = basstime;
shape_0_per_frame2=tex_ang = sin(basstime);
shape_0_per_frame3=ob_r = 0.5 * sin(1.12 * basstime);
shape_0_per_frame4=ob_g = 0.5 * sin(1.5 * basstime);
shape_0_per_frame5=ob_b = 0.5 * sin(2.12 * basstime);
shape_1_init1=tex_capture = 0;
shape_1_per_frame1=tex_capture = above(bass, 1);
shape_2_init1=q5 = 0;
shape_2_per_frame1=b2 = sin(0.4 * q5);

[warp_shader]
shader_body { 
  float final_noise_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)].x = q5;
  tmpvar_2[uint(0)].y = -(q4);
  tmpvar_2[1u].x = q4;
  tmpvar_2[1u].y = q5;
  vec3 tmpvar_3;
  tmpvar_3.xy = uv;
  tmpvar_3.z = q2;
  final_noise_1 = ((texture (sampler_noisevol_hq, (tmpvar_3 * 
    pow (q3, 0.0)
  )) * 2.0) - 1.0).x;
  final_noise_1 = (final_noise_1 + (0.5 * (
    (texture (sampler_noisevol_hq, (tmpvar_3 * q3)) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.25 * (
    (texture (sampler_noisevol_hq, (tmpvar_3 * (q3 * q3))) * 2.0)
   - 1.0)).x);
  final_noise_1 = (final_noise_1 + (0.125 * (
    (texture (sampler_noisevol_hq, (tmpvar_3 * pow (q3, 3.0))) * 2.0)
   - 1.0)).x);
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_main, ((
    (((uv - 0.5) * tmpvar_2) * (1.0 - ((rad * 3.7) * (1.0 - 
      (bass_att * 0.3)
    ))))
   * final_noise_1) + 0.5)).xyz - 0.08);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)].x = q4;
  tmpvar_2[uint(0)].y = -(q5);
  tmpvar_2[1u].x = q5;
  tmpvar_2[1u].y = q4;
  vec2 tmpvar_3;
  tmpvar_3 = (uv - 0.5);
  ret_1 = (mix (texture (sampler_main, fract(
    (((tmpvar_3 * tmpvar_2) * 0.9) + 0.5)
  )).xyz, texture (sampler_main, fract(
    ((((
      (-(tmpvar_3) + 0.5)
     - 0.5) * -(tmpvar_2)) * 0.9) + 0.5)
  )).xyz, vec3(0.5, 0.5, 0.5)) * 2.0);
  vec3 tmpvar_4;
  tmpvar_4.x = (ret_1.x * 10.0);
  tmpvar_4.y = ret_1.y;
  tmpvar_4.z = -(ret_1.z);
  ret_1 = tmpvar_4;
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = tmpvar_4;
  ret = tmpvar_5.xyz;
 }
