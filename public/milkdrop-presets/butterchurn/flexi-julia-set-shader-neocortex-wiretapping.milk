[preset00]
fRating=5.000000
fGammaAdj=1.000000
nWaveMode=1.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=0.004000
fWaveScale=0.762000
fWaveSmoothing=0.900000
fWaveParam=-0.440000
fModWaveAlphaStart=1.000000
fModWaveAlphaEnd=1.000000
fWarpAnimSpeed=2.130000
fWarpScale=2.498000
fZoomExponent=0.672880
fZoom=1.025000
fWarp=0.361460
fWaveY=0.040000
fOuterBorderSize=0.030000
fOuterBorderA=1.000000
fInnerBorderSize=0.050000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsG=0.910000
fMotionVectorsB=0.710000
fMotionVectorsA=0.000000
b1ed=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=abv = 0;
per_frame_init_2=t = 0;
per_frame_init_3=r = 0;
per_frame_init_4=l = 0;
per_frame_init_5=vol = 0;
per_frame_init_6=q2 = 0;
per_frame_init_7=h = 0;
per_frame_init_8=old_h = 0;
per_frame_init_9=m = 0;
per_frame_init_10=rr = 0;
per_frame_1=wave_a = 0;
per_frame_2=warp = 0;
per_frame_3=r = 0.98 * r + 0.5 * (bass - treb);
per_frame_4=rr = 0.94 * rr + 0.01 * r;
per_frame_5=q2 = 0.05 * rr;
per_frame_6=vol = 0.65 * max(bass, max(mid, treb));
per_frame_7=abv = above(vol, t);
per_frame_8=old_h = if(0.00001 < abs(abv), h, 0.99 * old_h);
per_frame_9=h = if(0.00001 < abs(abv), vol, 0.99 * h);
per_frame_10=l = min(0.999, max(0.9, l * (1 + 0.1 * (old_h - h))));
per_frame_11=m = 0.98 * m + 0.1 * abv;
per_frame_12=t = if(0.00001 < abs(abv), 1.5, t * l);
per_frame_13=ob_r = 2 - m;
per_frame_14=ob_g = ob_r;
per_frame_15=ob_b = 0;

[warp_shader]
shader_body { 
  vec2 my_uv_1;
  vec2 tmpvar_2;
  tmpvar_2.x = 0.6;
  tmpvar_2.y = (-0.5 + q2);
  vec2 tmpvar_3;
  tmpvar_3 = ((uv - 0.5) * vec2(2.0, 2.0));
  vec2 tmpvar_4;
  tmpvar_4.x = ((tmpvar_3.x * tmpvar_3.x) - (tmpvar_3.y * tmpvar_3.y));
  tmpvar_4.y = ((2.0 * tmpvar_3.x) * tmpvar_3.y);
  my_uv_1 = (tmpvar_4 + tmpvar_2);
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = (texture (sampler_fw_main, (my_uv_1 - floor(my_uv_1))).xyz - 0.004);
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
