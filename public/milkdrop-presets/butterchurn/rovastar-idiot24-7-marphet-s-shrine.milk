per_frame_init_1=q1 = 0;
per_frame_1=wave_r = wave_r * sin(0.961 * time);
per_frame_2=wave_b = wave_b * sin(0.131 * time);
per_frame_3=wave_g = wave_g * sin(0.312 * time);
per_frame_4=ib_r = wave_r;
per_frame_5=ib_b = wave_b;
per_frame_6=ib_g = wave_g;
per_frame_7=mv_r = 1 - ib_r;
per_frame_8=mv_g = 1 - ib_g;
per_frame_9=mv_b = 1 - ib_b;
per_frame_10=mv_x = 1.25;
per_frame_11=mv_y = 48;
per_frame_12=warp = 0;
per_frame_13=q1 = if(0.00001 < abs(above(bass_att + bass, 2.8)), 0.5 * (bass_att + bass), 0.1);
per_pixel_1=rot = rot + if(0.00001 < abs(equal(tan(2 * ang), 0)), -rot, rad) * q1;
per_pixel_2=zoom = zoom + 0.1 * sin(rad + 0.4 * time + 5);
