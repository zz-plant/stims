per_frame_init_31=q8 = 0;
per_frame_init_32=d12 = 0;
per_frame_init_33=x1 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_34=y1 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_35=x2 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_36=y2 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_37=x3 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_38=y3 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_39=x4 = 0.5 + (randint(100) - 50) / 500;
per_frame_init_40=y4 = 0.5 + (randint(100) - 50) / 500;
per_frame_1=zoom = 1;
per_frame_2=warp = 0;
per_frame_3=wave_a = 0;
per_frame_4=bounce = 0.8;
per_frame_5=d12 = 1 / (sqr(x1 - x2) + sqr(y1 - y2));
per_frame_6=d13 = 1 / (sqr(x1 - x3) + sqr(y1 - y3));
per_frame_7=d14 = 1 / (sqr(x1 - x4) + sqr(y1 - y4));
per_frame_8=d23 = 1 / (sqr(x2 - x3) + sqr(y2 - y3));
per_frame_9=d24 = 1 / (sqr(x2 - x4) + sqr(y2 - y4));
per_frame_10=d34 = 1 / (sqr(x3 - x4) + sqr(y3 - y4));
per_frame_11=vx1 = vx1 + (x2 - x1) * d12 + (x3 - x1) * d13 + (x4 - x1) * d14;
per_frame_12=vy1 = vy1 + (y2 - y1) * d12 + (y3 - y1) * d13 + (y4 - y1) * d14;
per_frame_13=vx2 = vx2 + (x1 - x2) * d12 + (x3 - x2) * d23 + (x4 - x2) * d24;
per_frame_14=vy2 = vy2 + (y1 - y2) * d12 + (y3 - y2) * d23 + (y4 - y2) * d24;
per_frame_15=vx3 = vx3 + (x1 - x3) * d13 + (x2 - x3) * d23 + (x4 - x3) * d34;
per_frame_16=vy3 = vy3 + (y1 - y3) * d13 + (y2 - y3) * d23 + (y4 - y3) * d34;
per_frame_17=vx4 = vx4 + (x1 - x4) * d14 + (x2 - x4) * d24 + (x3 - x4) * d34;
per_frame_18=vy4 = vy4 + (y1 - y4) * d14 + (y2 - y4) * d24 + (y3 - y4) * d34;
per_frame_19=dt = 0.00003;
per_frame_20=vx1 = if(0.00001 < abs(above(x1, 1)), -abs(vx1) * bounce, if(0.00001 < abs(below(x1, 0)), abs(vx1) * bounce, vx1));
per_frame_21=vx2 = if(0.00001 < abs(above(x2, 1)), -abs(vx2) * bounce, if(0.00001 < abs(below(x2, 0)), abs(vx2) * bounce, vx2));
per_frame_22=vx3 = if(0.00001 < abs(above(x3, 1)), -abs(vx3) * bounce, if(0.00001 < abs(below(x3, 0)), abs(vx3) * bounce, vx3));
per_frame_23=vx4 = if(0.00001 < abs(above(x4, 1)), -abs(vx4) * bounce, if(0.00001 < abs(below(x4, 0)), abs(vx4) * bounce, vx4));
per_frame_24=vy1 = if(0.00001 < abs(above(y1, 1)), -abs(vy1) * bounce, if(0.00001 < abs(below(y1, 0)), abs(vy1) * bounce, vy1));
per_frame_25=vy2 = if(0.00001 < abs(above(y2, 1)), -abs(vy2) * bounce, if(0.00001 < abs(below(y2, 0)), abs(vy2) * bounce, vy2));
per_frame_26=vy3 = if(0.00001 < abs(above(y3, 1)), -abs(vy3) * bounce, if(0.00001 < abs(below(y3, 0)), abs(vy3) * bounce, vy3));
per_frame_27=vy4 = if(0.00001 < abs(above(y4, 1)), -abs(vy4) * bounce, if(0.00001 < abs(below(y4, 0)), abs(vy4) * bounce, vy4));
per_frame_28=x1 = x1 + vx1 * dt;
per_frame_29=y1 = y1 + vy1 * dt;
per_frame_30=x2 = x2 + vx2 * dt;
per_frame_31=y2 = y2 + vy2 * dt;
per_frame_32=x3 = x3 + vx3 * dt;
per_frame_33=y3 = y3 + vy3 * dt;
per_frame_34=x4 = x4 + vx4 * dt;
per_frame_35=y4 = y4 + vy4 * dt;
per_frame_36=q1 = x1;
per_frame_37=q2 = y1;
per_frame_38=q3 = x2;
per_frame_39=q4 = y2;
per_frame_40=q5 = x3;
