per_frame_init_1=d = 0;
per_frame_init_2=res = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=x = 0;
per_frame_init_5=v = 0;
per_frame_init_6=diff = 0;
per_frame_init_7=r = 0;
per_frame_init_8=y = 0;
per_frame_init_9=beat = 0;
per_frame_init_10=vol = 0;
per_frame_init_11=q2 = 0;
per_frame_init_12=m = 0;
per_frame_1=vol = 8 * bass + 5 * mid + 3 * treb;
per_frame_2=m = 0.97 * m + 0.08 * vol;
per_frame_3=monitor = vol;
per_frame_4=beat = above(vol, res) * above(vol, m) * above(vol, 16);
per_frame_5=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_6=res = beat * (vol + 0.1 * m) + (1 - beat) * (res - 60 * (0.1 + 0.02 * diff) / fps);
per_frame_7=res = max(0, res);
per_frame_8=x = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, x);
per_frame_9=y = if(0.00001 < abs(beat), 0.01 * randint(60) + 0.2, y);
per_frame_10=q1 = x;
per_frame_11=q2 = y;
per_frame_12=wave_x = q1;
per_frame_13=wave_y = 1 - q2;
per_pixel_1=cx = q1;
per_pixel_2=cy = q2;
per_pixel_3=d = pow(sqrt(sqr(x - cx) + sqr(y - cy)), 0.8);
per_pixel_4=r = 0.2;
per_pixel_5=v = 0.2;
per_pixel_6=dx = (x - cx) * v * (d - r);
per_pixel_7=dy = (y - cy) * v * (d - r);
shape_0_per_frame1=x = randint(1000) / 1000;
shape_0_per_frame2=y = randint(1000) / 1000;
shape_0_per_frame3=ang = randint(150) / 100;

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = normalize((uv_orig - 0.5));
  float tmpvar_3;
  tmpvar_3 = (time * 7.0);
  uv_1 = (mix (uv_orig, uv, vec2((
    clamp ((((bass / bass_att) - 0.9) * 13.0), 0.0, 1.0)
   * 0.3))) + ((
    (tmpvar_2 * texsize.zw)
   * 
    cos(((rad * 170.0) - tmpvar_3))
  ) * 2.0));
  uv_1 = (uv_1 + ((
    (vec2(5.0, -5.0) * texsize.zw)
   * 
    cos(((ang * 30.0) - tmpvar_3))
  ) * tmpvar_2.yx));
  vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = (texture (sampler_pw_main, uv_1).xyz - 0.004);
  ret = tmpvar_4.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv2_1;
  vec3 ret_2;
  uv2_1 = (uv + (vec2(1.0, 0.0) * texsize.zw));
  float tmpvar_3;
  tmpvar_3 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(-1.0, 0.0) * texsize.zw));
  float tmpvar_4;
  tmpvar_4 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(0.0, 1.0) * texsize.zw));
  float tmpvar_5;
  tmpvar_5 = (((texture (sampler_main, uv2_1).xyz + 
    (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4)
  ) + (
    ((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2)
   * 0.15)) + ((
    (texture (sampler_blur3, uv2_1).xyz * scale3)
   + bias3) * 0.1)).x;
  uv2_1 = (uv + (vec2(0.0, -1.0) * texsize.zw));
  vec3 tmpvar_6;
  tmpvar_6.z = 0.14;
  tmpvar_6.x = (tmpvar_3 - tmpvar_4);
  tmpvar_6.y = (tmpvar_5 - ((
    (texture (sampler_main, uv2_1).xyz + (((texture (sampler_blur1, uv2_1).xyz * scale1) + bias1) * 0.4))
   + 
    (((texture (sampler_blur2, uv2_1).xyz * scale2) + bias2) * 0.15)
  ) + (
    ((texture (sampler_blur3, uv2_1).xyz * scale3) + bias3)
   * 0.1)).x);
  ret_2 = (0.5 + (0.5 * normalize(tmpvar_6)));
  vec2 x_7;
  x_7 = (ret_2.xy - 0.5);
  ret_2 = (ret_2 * clamp ((
    sqrt(dot (x_7, x_7))
   * 5.0), 0.0, 1.0));
  ret_2 = ret_2.xxy;
  ret_2 = (ret_2 + 1.0);
  ret_2 = (ret_2 * mix (ret_2, (ret_2 * 
    (((texture (sampler_blur3, uv).xyz * scale3) + bias3) - ((texture (sampler_blur1, uv).xyz * scale1) + bias1))
  ), pow (hue_shader, ret_2)));
  ret_2 = (ret_2 * hue_shader);
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = ret_2;
  ret = tmpvar_8.xyz;
 }
