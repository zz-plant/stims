per_frame_init_17=q1 = 0;
per_frame_init_18=q5 = 0;
per_frame_init_19=q9 = 0;
per_frame_init_20=x = 0;
per_frame_init_21=v = 0;
per_frame_init_22=ww1 = 0;
per_frame_init_23=mm = 0;
per_frame_init_24=tt = 0;
per_frame_init_25=mult = 0;
per_frame_init_26=q31 = 0;
per_frame_init_27=angle = 0;
per_frame_init_28=vx = 0;
per_frame_init_29=q11 = 0;
per_frame_init_30=q10 = 0;
per_frame_init_31=ang2 = 0;
per_frame_init_32=dv = 0;
per_frame_init_33=vy = 0;
per_frame_init_34=q4 = 0;
per_frame_init_35=a = 0;
per_frame_init_36=q16 = 0;
per_frame_init_37=t = 0;
per_frame_init_38=w1 = 0;
per_frame_init_39=dy2 = 0;
per_frame_init_40=y = 0;
per_frame_init_41=mx = 0;
per_frame_init_42=mn = 0;
per_frame_init_43=q19 = 0;
per_frame_init_44=q17 = 0;
per_frame_init_45=y2 = 0;
per_frame_init_46=dx1 = 0;
per_frame_init_47=bb = 0;
per_frame_init_48=q2 = 0;
per_frame_init_49=q14 = 0;
per_frame_init_50=dist = 0;
per_frame_init_51=v1 = 0;
per_frame_init_52=xo = 0;
per_frame_init_53=q3 = 0;
per_frame_init_54=q32 = 0;
per_frame_init_55=yy = 0;
per_frame_init_56=q7 = 0;
per_frame_init_57=v2 = 0;
per_frame_init_58=q20 = 0;
per_frame_init_59=q8 = 0;
per_frame_init_60=yo = 0;
per_frame_1=warp = 0;
per_frame_2=zoom = 1;
per_frame_3=wave_a = 0;
per_frame_4=w = w1;
per_frame_5=ww = -(y1 - y2) * (1 + 2 * (70 / fps - 1)) - 0.8 * y1;
per_frame_6=w = w - 5 * ww;
per_frame_7=q1 = cos(ww);
per_frame_8=q2 = sin(ww);
per_frame_9=q3 = 1.12;
per_frame_10=q4 = 0.042 * sin(w);
per_frame_11=q5 = 0.042 * cos(w);
per_frame_12=a = 0.5 * asin(1);
per_frame_13=d = 0.08;
per_frame_14=q6 = cos(a + 0 * ww);
per_frame_15=q7 = sin(a + 0 * ww);
per_frame_16=q8 = 3.3;
per_frame_17=q9 = cos(-w + asin(1)) * d * aspectx;
per_frame_18=q10 = sin(-w + asin(1)) * d * aspecty;
per_frame_19=q11 = cos(-a + 0 * ww);
per_frame_20=q12 = sin(-a + 0 * ww);
per_frame_21=q13 = q8;
per_frame_22=q14 = cos(-w + asin(1)) * d * aspectx;
per_frame_23=q15 = sin(-w + asin(1)) * d * aspecty;
per_frame_24=bb = 0.97 * bb + 0.04 * bass;
per_frame_25=mm = 0.97 * mm + 0.04 * mid;
per_frame_26=tt = 0.97 * tt + 0.04 * treb;
per_frame_27=w1 = w1 + ww1 * sqrt(vx * vx + vy * vy) * a * 2;
per_frame_28=ww1 = 0.94 * ww1 + 0.1 * y1;
per_frame_29=q16 = 0.2 * (bb - tt);
per_frame_30=y1 = y1 + 0.1 * v1;
per_frame_31=y2 = y2 + 0.2 * v2;
per_frame_32=v1 = 0.95 * v1 - 0.1 * (y1 - q16);
per_frame_33=v2 = 0.99 * v2 - 0.2 * (y2 - y1);
per_frame_34=a = 2.2 * abs(y2 - y1) / fps;
per_frame_35=q17 = sin(w) * a;
per_frame_36=q18 = -cos(w) * a;
per_frame_37=v = 0.25;
per_frame_38=x = x + vx * v;
per_frame_39=x = min(1, max(-1, x));
per_frame_40=y = y + vy * v;
per_frame_41=y = min(1, max(-1, y));
per_frame_42=vx = 0.97 * vx + sin(w) * a + 0.2 * (equal(x, -1) - equal(x, 1));
per_frame_43=vy = 0.97 * vy - cos(w) * a + 0.2 * (equal(y, -1) - equal(y, 1));
per_frame_44=q19 = 0.5 * x;
per_frame_45=q20 = 0.5 * y;
per_frame_46=q21 = -w1 - 0 * ww;
per_frame_47=mx = max(max(bb, mm), tt);
per_frame_48=mn = min(min(bb, mm), tt);
per_frame_49=ob_r = (bb - mn) / (mx - mn);
per_frame_50=ob_g = (mm - mn) / (mx - mn);
per_frame_51=ob_b = (tt - mn) / (mx - mn);
per_frame_52=v = 1 / fps;
per_frame_53=xx = xx + v * (ob_r - ob_g);
per_frame_54=yy = yy + v * (ob_g - ob_b);
per_frame_55=q32 = xx;
per_frame_56=q31 = yy;
per_pixel_1=xo = x;
per_pixel_2=yo = y;
per_pixel_3=x = 0.5 + (x - 0.5) * aspectx;
per_pixel_4=y = 0.5 + (y - 0.5) * aspecty;
per_pixel_5=du = 2 * x - 1 - 2 * q19;
per_pixel_6=dv = 2 * y - 1 + 2 * q20;
per_pixel_7=dist = sqrt(du * du + dv * dv);
per_pixel_8=ang2 = 3 * atan2(du, dv) + 2 * q21;
per_pixel_9=mult = 0.02 * -pow(dist, 2);
per_pixel_10=dx2 = mult * sin(ang2) * aspectx;
per_pixel_11=dy2 = mult * cos(ang2) * aspecty;
per_pixel_12=x = xo;
per_pixel_13=y = yo;
per_pixel_14=angle = q21 + 1.579;
per_pixel_15=x1 = (x - 0.5) * aspectx;
per_pixel_16=y1 = (y - 0.5) * aspecty;
per_pixel_17=x = cos(-angle) * x1 - sin(-angle) * y1;
per_pixel_18=y = sin(-angle) * x1 + cos(-angle) * y1;
per_pixel_19=t = 2 * time;
per_pixel_20=v = 0.003;
per_pixel_21=n = 25;
per_pixel_22=dx = v * (cos((-x + y) * n + t) + sin((x + y) * n + t));
per_pixel_23=dy = v * (cos((x - y) * n - t) + sin((-x - y) * n - t));
per_pixel_24=dx1 = cos(angle) * dx - sin(angle) * dy;
per_pixel_25=dy1 = sin(angle) * dx + cos(angle) * dy;
per_pixel_26=dx = dx1 * aspectx;
per_pixel_27=dy = dy1 * aspecty;
per_pixel_28=dx = dx + dx2;
per_pixel_29=dy = dy + dy2;

[warp_shader]
shader_body { 
  vec2 uv1_1;
  vec3 ret_2;
  vec2 tmpvar_3;
  tmpvar_3 = clamp (uv, 0.0, 1.0);
  ret_2.yz = (texture (sampler_main, tmpvar_3).xyz - vec3(0.08, 0.0, 0.08)).yz;
  vec2 tmpvar_4;
  tmpvar_4 = (texsize.zw * 4.0);
  vec3 tmpvar_5;
  tmpvar_5 = ((2.0 * (
    (texture (sampler_blur1, (tmpvar_3 + (vec2(1.0, 0.0) * tmpvar_4))).xyz * scale1)
   + bias1)) - (2.0 * (
    (texture (sampler_blur1, (tmpvar_3 - (vec2(1.0, 0.0) * tmpvar_4))).xyz * scale1)
   + bias1)));
  vec3 tmpvar_6;
  tmpvar_6 = ((2.0 * (
    (texture (sampler_blur1, (tmpvar_3 + (vec2(0.0, 1.0) * tmpvar_4))).xyz * scale1)
   + bias1)) - (2.0 * (
    (texture (sampler_blur1, (tmpvar_3 - (vec2(0.0, 1.0) * tmpvar_4))).xyz * scale1)
   + bias1)));
  vec2 tmpvar_7;
  tmpvar_7.x = tmpvar_5.x;
  tmpvar_7.y = tmpvar_6.x;
  uv1_1 = (tmpvar_3 + (tmpvar_4 * (tmpvar_7 * 0.4)));
  ret_2.x = texture (sampler_fc_main, uv1_1).x;
  ret_2.x = (ret_2.x - ((
    (((texture (sampler_blur1, uv1_1).xyz * scale1) + bias1).x - ret_2.x)
   * 0.05) + 0.004));
  vec2 tmpvar_8;
  tmpvar_8.x = tmpvar_5.x;
  tmpvar_8.y = tmpvar_6.x;
  vec2 tmpvar_9;
  tmpvar_9.x = tmpvar_5.z;
  tmpvar_9.y = tmpvar_6.z;
  ret_2.z = (max ((
    sqrt(dot (tmpvar_8, tmpvar_8))
   * 1.4), texture (sampler_main, (
    clamp (mix (uv_orig, tmpvar_3, vec2(-1.0, -1.0)), 0.0, 1.0)
   - 
    ((tmpvar_9 * texsize.zw) * 4.0)
  )).z) - 0.004);
  vec4 tmpvar_10;
  tmpvar_10.w = 1.0;
  tmpvar_10.xyz = ret_2;
  ret = tmpvar_10.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
