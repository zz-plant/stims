shape_3_per_frame12=g = gmegabuf(floor(index + 6));
shape_3_per_frame13=b = gmegabuf(floor(index + 7));
shape_3_per_frame14=sample = sample / ppo;
shape_3_per_frame15=bending = 5 * gmegabuf(floor(index + 12)) + 5 * gmegabuf(floor(index + 10));
shape_3_per_frame16=dir = -ang + (sample - 0.4) * bending;
shape_3_per_frame17=ang = 1.5 * asin(1) - dir + 0.05 * bending;
shape_3_per_frame18=x = x + (0.06 * (sample - 0.3) * cos(dir) * size + sin(dir) * size * bending * 0.01);
shape_3_per_frame19=y = y + (0.06 * (sample - 0.3) * sin(dir) * size - cos(dir) * size * bending * 0.01);
shape_3_per_frame20=x = 0.5 + (x - 0.5) / q2;
shape_3_per_frame21=rad = 1.5 * rad - 0.05 * sample * size;
shape_3_per_frame22=i3 = i3 + 1;
shape_3_per_frame23=i4 = if(0.00001 < abs(equal(mod(i3, ppo), 0)), i4 + 1, i4);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz * 0.45);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = texture (sampler_main, uv).xyz;
  ret = tmpvar_1.xyz;
 }
