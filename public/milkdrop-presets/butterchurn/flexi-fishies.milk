shape_3_per_frame1=i3 = if(0.00001 < abs(equal(instance, 0)), 0, i3);
shape_3_per_frame2=i4 = if(0.00001 < abs(equal(instance, 0)), 0, i4);
shape_3_per_frame3=ppo = 8;
shape_3_per_frame4=index = i4 * q32;
shape_3_per_frame5=sample = mod(i3, ppo);
shape_3_per_frame6=size = 40 * gmegabuf(floor(index + 4));
shape_3_per_frame7=x = gmegabuf(floor(index));
shape_3_per_frame8=y = gmegabuf(floor(index + 1));
shape_3_per_frame9=ang = gmegabuf(floor(index + 9));
shape_3_per_frame10=rad = 0.05 * size;
