per_frame_init_24=dcsp = 0;
per_frame_init_25=warp = 0;
per_frame_1=volume = 0.3 * (bass + mid + att);
per_frame_2=beatrate = equal(beatrate, 0) + (1 - equal(beatrate, 0)) * (below(volume, 0.01) + (1 - below(volume, 0.01)) * beatrate);
per_frame_3=lastbeat = lastbeat + equal(lastbeat, 0) * time;
per_frame_4=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_5=peakbass_att = max(bass_att, peakbass_att);
per_frame_6=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_7=peakbass_att = beat * bass_att + (1 - beat) * peakbass_att * (0.95 * above(time - lastbeat, 2 * beatrate) + 0.995 * (1 - above(time - lastbeat, 2 * beatrate)));
per_frame_8=lastbeat = beat * time + (1 - beat) * lastbeat;
per_frame_9=peakbass_att = max(peakbass_att, 1.1 * meanbass_att);
per_frame_10=beat = above(volume, 0.8) * below(peakbass_att - bass_att, 0.05 * peakbass_att) * above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1));
per_frame_11=beatcounter = beatcounter + beat;
per_frame_12=mode = if(0.00001 < abs(beat * equal(mod(beatcounter, 2), 0)), 1 - mode, mode);
per_frame_13=flip = 2 * mode - 1;
per_frame_14=monitor = flip;
per_frame_15=q8 = flip;
per_frame_16=decay = 0.98;
per_frame_17=zoom = 1.002;
per_frame_18=vol = 0.25 * (bass_att + mid_att + treb_att);
per_frame_19=vol = vol * vol;
per_frame_20=mtime = mtime + 0.1 * vol * flip;
per_frame_21=q1 = 0.4 * mtime;
per_frame_22=warp = 0;
shape_0_init1=q1 = 0;
shape_0_init2=t1 = 0;
shape_0_init3=t1 = 0.01 * randint(100);
shape_0_init4=t2 = 0.01 * randint(100);
shape_0_per_frame1=ang = q1 * (0.03 + 0.01 * t1);
shape_0_per_frame2=r = min(1, max(0, 0.1 * sin(0.417 * time + 1)));
shape_0_per_frame3=g = min(1, max(0, 0.1 * sin(0.391 * time + 2)));
shape_0_per_frame4=b = min(1, max(0, 0.1 * sin(0.432 * time + 4)));
shape_0_per_frame5=r2 = min(1, max(0, r2 + 0.02 * sin(0.657 * time + 3)));
shape_0_per_frame6=g2 = min(1, max(0, g2 + 0.02 * sin(0.737 * time + 5)));
shape_0_per_frame7=b2 = min(1, max(0, b2 + 0.02 * sin(0.884 * time + 6)));
shape_0_per_frame8=additive = 0.5 + 0.15 * (bass + bass_att);
shape_1_init1=q1 = 0;
shape_1_init2=q1 = 0;
shape_1_init3=q1 = 0;
shape_1_init4=t1 = 0;
shape_1_init5=t1 = 0.01 * randint(100);
shape_1_init6=t2 = 0.01 * randint(100);
shape_1_per_frame1=x = x + 0.05 * sin(0.15 * q1 + 3);
shape_1_per_frame2=y = y + 0.03 * sin(0.19 * q1 + 1);
shape_1_per_frame3=tex_ang = q1 * (0.01 + 0.0001 * t1);
shape_1_per_frame4=r = min(1, max(0, r + 0.01 * sin(0.0417 * time + 1)));
shape_1_per_frame5=g = min(1, max(0, g + 0.01 * sin(0.391 * time + 2)));
shape_1_per_frame6=b = min(1, max(0, b + 0.01 * sin(0.432 * time + 4)));
shape_1_per_frame7=r2 = min(1, max(0, r2 + 0.01 * sin(0.457 * time + 3)));
shape_1_per_frame8=g2 = min(1, max(0, g2 + 0.01 * sin(0.0437 * time + 5)));
shape_1_per_frame9=b2 = min(1, max(0, b2 + 0.01 * sin(0.484 * time + 6)));
shape_2_init1=q1 = 0;
shape_2_init2=q1 = 0;
shape_2_init3=q1 = 0;
shape_2_init4=t1 = 0;
shape_2_init5=t2 = 0;
shape_2_init6=t1 = 0.01 * randint(100);
shape_2_init7=t2 = 0.01 * randint(100);
shape_2_per_frame1=x = x + 0.05 * sin(0.017 * q1);
shape_2_per_frame2=y = y + 0.03 * sin(0.013 * q1);
shape_2_per_frame3=tex_ang = q1 * (0.02 + 0.0001 * t1);
shape_2_per_frame4=rad = rad * (0.9 + 0.2 * t2);
shape_2_per_frame5=r = min(1, max(0, r + 0.01 * sin(0.417 * time + 1)));
shape_2_per_frame6=g = min(1, max(0, g + 0.01 * sin(0.391 * time + 2)));
shape_2_per_frame7=b = min(1, max(0, b + 0.01 * sin(0.432 * time + 4)));
shape_2_per_frame8=r2 = min(1, max(0, r2 + 0.01 * sin(0.457 * time + 3)));
shape_2_per_frame9=g2 = min(1, max(0, g2 + 0.01 * sin(0.437 * time + 5)));
shape_2_per_frame10=b2 = min(1, max(0, b2 + 0.01 * sin(0.484 * time + 6)));
shape_3_init1=q1 = 0;
shape_3_init2=q1 = 0;
shape_3_per_frame1=x = x + 0.2 * sin(0.25 * q1);
shape_3_per_frame2=y = y + 0.1 * sin(0.5 * q1 + 2);

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 1.333);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
