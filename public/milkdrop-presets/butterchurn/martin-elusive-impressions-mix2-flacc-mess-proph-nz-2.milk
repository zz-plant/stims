per_frame_1=vol = bass + treb + mid;
per_frame_2=q1 = max(1, min(5.5, 1.15 * vol));
per_frame_3=atime = atime + vol;
per_frame_4=q23 = 0.02 * atime;
per_frame_5=dec_med = pow(0.9, 30 / fps);
per_frame_6=dec_slow = pow(0.98, 30 / fps);
per_frame_7=beat = bass + mid + treb;
per_frame_8=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_9=is_beat = above(beat, 0.2 + avg + peak) * above(time, t0 + 0.1);
per_frame_10=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_11=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_12=index = mod(index + is_beat, 16);
per_frame_13=index2 = mod(index2 + is_beat * bnot(index), 12);
per_frame_14=spb = min(t0 - t0a + 0.01, 2);
per_frame_15=t0a = t0;
per_frame_16=spb_ = if(0.00001 < abs(is_beat), 0.9 * spb_ + 0.1 * spb, spb_);
per_frame_17=mindev = min(min(abs(spb - spb_), abs(2 * spb - spb_)), abs(spb - 2 * spb_));
per_frame_18=sdev = if(0.00001 < abs(is_beat), 0.9 * sdev + 0.1 * pow(mindev + 0.02, 2), sdev);
per_frame_19=q20 = avg;
per_frame_20=q21 = beat;
per_frame_21=q22 = peak + 0.1;
per_frame_22=q24 = is_beat;
per_frame_23=q27 = index;
per_frame_24=q28 = index2;
per_frame_25=trel = trel + 4 * (1 / fps / spb_);
per_frame_26=itrel = floor(trel);
per_frame_27=q25 = above(itrel, itrel_);
per_frame_28=q30 = mod(itrel, 2);
per_frame_29=itrel_ = itrel;
per_frame_30=q31 = itrel;
per_frame_31=ma = ma + peak / fps;
per_frame_32=mx = mx * dec_med + (1 - dec_med) * cos(ma);
per_frame_33=my = my * dec_med + (1 - dec_med) * sin(ma + trel / 16);
per_frame_34=q15 = mx;
per_frame_35=q16 = my;
per_frame_36=q17 = ma;
per_frame_37=sw1 = if(0.00001 < abs(sw1), bnot(q24 * bnot(floor(randint(20)))), q24 * bnot(floor(randint(20))));
per_frame_38=sw2 = if(0.00001 < abs(sw2), bnot(q24 * bnot(floor(randint(10)))), q24 * bnot(floor(randint(80))));
per_frame_39=sw3 = if(0.00001 < abs(sw3), bnot(q24 * bnot(floor(randint(10)))), q24 * bnot(floor(randint(100 + 10000 * sdev))));
per_frame_40=q6 = sin(time / 15) * sin(time / 27) * 0.2;
per_frame_41=q10 = sin(time / 8);
per_frame_42=q10 = q10 * q10 * 0.1;
per_frame_43=q11 = 1.5 + sin(time / 7.8);
per_frame_44=q12 = if(0.00001 < abs(below(sdev, 0.015) * bnot(q8)), q25, 1);
per_frame_45=q13 = 0.5 + sin(time / 17);
per_frame_46=q19 = 0.2 * sin(time / 5.3);
per_frame_47=q3 = sw1;
per_frame_48=q4 = 0.02 / sdev;
per_frame_49=q5 = 0.4 * max(min(4 * sin(trel / 64) - 3, 1), 0);
per_frame_50=q7 = below(sdev, 0.004) * mod(index2, 2);
per_frame_51=q2 = abs(q19) * sqrt(q15 * q15 + q16 * q16);
per_frame_52=trel2 = trel2 + 0.003 * q22 * q22 / fps;
per_frame_53=tmp = sin(trel2);
per_frame_54=tmp = 20 * tmp - 19;
per_frame_55=q8 = tmp * above(tmp, 0) * (4 / max(q22 - 4, 0.2) + 4);
per_frame_56=q26 = above(q22, 12) * (q22 - 12) * 2;
per_frame_57=tmp = index2 / 6;
per_frame_58=q14 = 6 * abs(tmp - floor(tmp) - 0.5) + 1;
per_frame_59=tmp = sin(3.14 * (trel / 4));
per_frame_60=jmp = jmp + 8 * (above(tmp, 0.5) * tmp / fps) * sw2;
per_frame_61=q9 = jmp * equal(q14, 1) * below(sdev, 0.04) + time * above(sin(q17 / 23), 0.9);
per_frame_62=q18 = tmp * bnot(q8) * sw3;
per_frame_63=monitor = sw1;
per_frame_64=rot = 0.003;
per_frame_65=warp = 0;
per_frame_66=zoom = 1 + (avg - log(sdev)) / 200;
