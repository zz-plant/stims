shape_2_per_frame6=y = 0.3 * (cos(q23) + 1.57) + 0.004 * floor(randint(15)) * (bass_att + treb_att + mid_att) * if(0.00001 < abs(equal(floor(randint(2)), 1)), 1, -1) + instance - instance;
