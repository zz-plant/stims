[warp_shader]
mat2 ofs;
float xlat_mutablenoise;
vec2 xlat_mutableuv1;
vec2 xlat_mutableuv2;
float xlat_mutablezv;
 shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = q15;
  tmpvar_1.y = q16;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)].x = texsize.z;
  tmpvar_2[uint(0)].y = 0.0;
  tmpvar_2[1u].x = 0.0;
