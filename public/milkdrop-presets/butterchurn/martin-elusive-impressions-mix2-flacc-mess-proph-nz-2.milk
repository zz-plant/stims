shape_3_per_frame1=ma = ma + 3.1415 * above(bass, 1) * 0.01 * bass;
shape_3_per_frame2=ma = ma - 3.1415 * above(treb, 1) * 0.01 * treb;
shape_3_per_frame3=mx = mx + 0.0002 * cos(ma);
shape_3_per_frame4=my = my + 0.0002 * tan(ma);
shape_3_per_frame5=mx = if(0.00001 < abs(above(mx, 0.9)), 0.9 - mx, mx);
shape_3_per_frame6=my = if(0.00001 < abs(above(my, 0.9)), 0.9 - my, my);
shape_3_per_frame7=mx = if(0.00001 < abs(below(mx, 0.1)), 0.9 + mx, mx);
shape_3_per_frame8=my = if(0.00001 < abs(below(my, 0.1)), 0.9 + my, my);
