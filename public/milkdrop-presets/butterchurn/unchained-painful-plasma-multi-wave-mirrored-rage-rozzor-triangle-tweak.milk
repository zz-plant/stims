per_frame_init_1=bass_residual = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=thresh = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=newrad = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=treb_flop = 0;
per_frame_init_9=bass_thresh = 0;
per_frame_init_10=old_bass_flop = 0;
per_frame_init_11=treb_thresh = 0;
per_frame_init_12=pulse = 0;
per_frame_init_13=bass_changed = 0;
per_frame_init_14=mid_thresh = 0;
per_frame_init_15=q4 = 0;
per_frame_init_16=mid_changed = 0;
per_frame_init_17=entropy = 0;
per_frame_init_18=newx = 0;
per_frame_init_19=old_mid_flop = 0;
per_frame_init_20=mid_residual = 0;
per_frame_init_21=treb_residual = 0;
per_frame_init_22=chaos = 0;
per_frame_init_23=newzoom = 0;
per_frame_init_24=mid_flop = 0;
per_frame_init_25=q2 = 0;
per_frame_init_26=treb_changed = 0;
per_frame_init_27=q3 = 0;
per_frame_init_28=newy = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -20)), 1 + randint(3), entropy));
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=bass_residual = bass_changed * sin(0.1 * pulse * entropy) + bnot(bass_changed) * bass_residual;
per_frame_17=treb_residual = treb_changed * sin(0.1 * pulse * entropy) + bnot(treb_changed) * treb_residual;
per_frame_18=mid_residual = mid_changed * sin(0.1 * pulse * entropy) + bnot(mid_changed) * mid_residual;
per_frame_19=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.052 * (bass_thresh + mid + thresh + treb_thresh) + 0.01 * -(bass + treb + mid));
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = sin(pulse / 2);
per_frame_25=wave_r = wave_r + 0.5 * bass_residual;
per_frame_26=wave_r = wave_g + 0.5 * mid_residual;
per_frame_27=wave_r = wave_b + 0.5 * treb_residual;
per_frame_28=wave_mystery = mid_residual;
per_frame_29=ob_r = if(0.00001 < abs(bass_flop), treb_flop, wave_r);
per_frame_30=ob_b = if(0.00001 < abs(treb_flop), mid_flop, wave_b);
per_frame_31=ob_g = if(0.00001 < abs(mid_flop), bass_flop, wave_g);
per_frame_32=ob_a = 0.05 + 0.05 * cos(wave_r + 0.03 * pulse);
per_frame_33=ob_size = 0.2 + 0.2 * treb_residual;
per_frame_34=ib_r = if(0.00001 < abs(bass_flop), ob_b, ob_g);
per_frame_35=ib_b = if(0.00001 < abs(treb_flop), ob_g, ob_r);
per_frame_36=ib_g = if(0.00001 < abs(mid_flop), ob_r, ob_b);
per_frame_37=ib_size = ob_size * cos(wave_g + 0.4 * pulse) * 0.5;
per_frame_38=mv_a = q1;
per_frame_39=mv_x = randint(30);
per_frame_40=mv_y = randint(30);
per_frame_41=mv_r = wave_b;
per_frame_42=mv_b = wave_g;
per_frame_43=mv_g = wave_r;
per_frame_44=wave_mode = 4 + 4 * q4;
per_pixel_1=newx = x - abs(q1);
per_pixel_2=newy = y - abs(q2);
per_pixel_3=newrad = 2 * sqrt(newx * newx + 0.5625 * newy * newy);
per_pixel_4=newzoom = pow(1.03, pow(0.01 + sin(newrad * newrad), 2 * newrad - 1));
per_pixel_5=dx = newx * newzoom - newx;
per_pixel_6=dy = newy * newzoom - newy;
per_pixel_7=rot = -0.1 * newrad * (0.5 * rad + 0.1);
per_pixel_8=zoom = zoom + 0.07 * cos(10 * x * q3);
per_pixel_9=rot = rot * (zoom - 1);
shape_1_per_frame1=ang = 1.4 * time;
shape_1_per_frame2=x = 0.5 + 0.08 * cos(1.1 * time) + 0.03 * cos(0.7 * time);
shape_1_per_frame3=y = 0.5 + 0.08 * sin(1.1 * time) + 0.03 * sin(0.7 * time);
shape_1_per_frame4=r = 0.5 + 0.5 * sin(0.713 * time + 1);
shape_1_per_frame5=g = 0.5 + 0.5 * sin(0.563 * time + 2);
shape_1_per_frame6=b = 0.5 + 0.5 * sin(0.654 * time + 5);
shape_1_per_frame7=r2 = 0.5 + 0.5 * sin(0.885 * time + 4);
shape_1_per_frame8=g2 = 0.5 + 0.5 * sin(0.556 * time + 1);
shape_1_per_frame9=b2 = 0.5 + 0.5 * sin(0.638 * time + 3);
