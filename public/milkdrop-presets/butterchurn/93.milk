wave_2_init19=ox = 0;
wave_2_per_frame1=t1 = q3;
wave_2_per_frame2=t2 = q2;
wave_2_per_frame3=t3 = 0.3 * q2;
wave_2_per_point1=t = t1 + t2 * (1 - sample);
wave_2_per_point2=ox = 0.5 + (0.3 + 0.05 * sample) * cos(t + 0.65 + 3.1415 * sin(1.7 * t + 0.98)) * sin(1.32 * t + 3.21);
wave_2_per_point3=oy = 0.5 + 1.25 * (0.3 + 0.05 * sample) * sin(0.78 * t + 1.71) * cos(0.91 * t + 3.09 + 3.1415 * sin(1.49 * t + 0.43));
wave_2_per_point4=ang = atan2(py - oy, px - ox);
wave_2_per_point5=l = tan(ang);
wave_2_per_point6=x2 = 0.5 + (0.3 - 0.05 * sample) * cos(t + 0.65 + 3.1415 * sin(1.7 * t + 0.98)) * sin(1.32 * t + 3.21);
wave_2_per_point7=y2 = 0.5 + 1.25 * (0.3 - 0.05 * sample) * sin(0.78 * t + 1.71) * cos(0.91 * t + 3.09 + 3.1415 * sin(1.49 * t + 0.43));
wave_2_per_point8=sum = (l * x2 - y2 + oy - l * ox) * sign(ang) * sign(l);
wave_2_per_point9=dir = -1 + 2 * above(sum, -0.001);
wave_2_per_point10=xtrudx = (1 - mod(counter, 2)) * t3 * sample * cos(ang + 1.5707 * dir) * abs(value1 + value2);
wave_2_per_point11=xtrudy = (1 - mod(counter, 2)) * t3 * sample * sin(ang + 1.5707 * dir) * abs(value1 + value2);
wave_2_per_point12=x = ox + xtrudx;
wave_2_per_point13=y = oy + xtrudy;
wave_2_per_point14=px = ox;
wave_2_per_point15=py = oy;
wave_2_per_point16=counter = counter + 1;
wave_2_per_point17=a = sqr(sample);
