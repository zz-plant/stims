per_frame_3=mv_dx = bass;
per_frame_4=ib_a = 0.005;
per_frame_5=vol = 0.45 * (bass + mid + treb);
per_frame_6=vol = vol * vol;
per_frame_7=mtime = mtime + 0.01 * vol * (48 / fps);
per_frame_8=q1 = 0.5 * mtime;
per_frame_9=dt = 1 / fps;
per_frame_10=mytime = mytime + dt;
per_frame_11=contvol = min(max(0.5, (1 - 0.5 * dt) * contvol + 0.5 * dt * (bass + mid + treb) * 0.133), 2);
per_frame_12=q2 = contvol;
per_frame_13=q3 = mytime;
per_frame_14=echo_zoom = 1 + 0.01 * vol;
