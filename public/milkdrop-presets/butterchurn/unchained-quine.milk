[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=0.999496
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
bDarken=1.000000
fWaveAlpha=1.059200
fWaveScale=0.653093
fWaveSmoothing=0.090000
fWarpAnimSpeed=5.995700
fWarpScale=1.331000
fZoom=1.008384
fRot=0.500000
fWarp=1.008145
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderR=0.500000
fInnerBorderG=0.900000
fInnerBorderB=0.500000
fInnerBorderA=1.000000
nMotionVectorsX=24.959999
nMotionVectorsY=19.199999
nMotionVectorsLoop=0.850000
fMotionVectorsR=0.499900
fMotionVectorsG=0.499900
fMotionVectorsB=0.499900
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=xx = 0;
per_frame_init_2=bass_residual = 0;
per_frame_init_3=grid_shift = 0;
per_frame_init_4=old_treb_flop = 0;
per_frame_init_5=bass_flop = 0;
per_frame_init_6=grid = 0;
per_frame_init_7=q6 = 0;
per_frame_init_8=q1 = 0;
per_frame_init_9=q5 = 0;
per_frame_init_10=treb_flop = 0;
per_frame_init_11=bass_thresh = 0;
per_frame_init_12=old_bass_flop = 0;
per_frame_init_13=treb_thresh = 0;
per_frame_init_14=pulse = 0;
per_frame_init_15=bass_changed = 0;
per_frame_init_16=mid_thresh = 0;
per_frame_init_17=echo_orientation = 0;
per_frame_init_18=q4 = 0;
per_frame_init_19=mid_changed = 0;
per_frame_init_20=entropy = 0;
per_frame_init_21=old_mid_flop = 0;
per_frame_init_22=mid_residual = 0;
per_frame_init_23=treb_residual = 0;
per_frame_init_24=chaos = 0;
per_frame_init_25=mid_flop = 0;
per_frame_init_26=q2 = 0;
per_frame_init_27=treb_changed = 0;
per_frame_init_28=q3 = 0;
per_frame_init_29=yy = 0;
per_frame_init_30=q7 = 0;
per_frame_init_31=q8 = 0;
per_frame_1=old_bass_flop = bass_flop;
per_frame_2=old_treb_flop = treb_flop;
per_frame_3=old_mid_flop = mid_flop;
per_frame_4=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_5=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.6) * chaos + 1.6);
per_frame_6=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_7=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.6) * chaos + 1.6);
per_frame_8=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_9=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.6) * chaos + 1.6);
per_frame_10=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_11=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_12=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_13=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_14=bass_residual = bass_changed * sin(3 * pulse) + bnot(bass_changed) * bass_residual;
per_frame_15=treb_residual = treb_changed * sin(3 * pulse) + bnot(treb_changed) * treb_residual;
per_frame_16=mid_residual = mid_changed * sin(3 * pulse) + bnot(mid_changed) * mid_residual;
per_frame_17=monitor = warp / 100;
per_frame_18=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + (bass_thresh + mid_thresh + treb_thresh) * (warp / 100));
per_frame_19=entropy = if(0.00001 < abs(bass_changed * mid_changed * treb_changed), bass_flop + treb_flop + mid_flop + randint(10 * rot), entropy);
per_frame_20=q1 = mid_residual;
per_frame_21=q2 = bass_residual;
per_frame_22=q3 = treb_residual;
per_frame_23=q4 = sin(pulse);
per_frame_24=q5 = cos(pulse * (0.5 + 0.1 * entropy));
per_frame_25=q6 = sin(pulse * (0.5 + pow(0.25, entropy)));
per_frame_26=q7 = above(q1, 0) + above(q2, 0) + above(q3, 0) + above(q3, 0) * treb_flop + above(q2, 0) * bass_flop + above(q1, 0) * mid_flop;
per_frame_27=q8 = entropy;
per_frame_28=ib_r = 0.5 + 0.5 * cos(1.2 * time + 0.1 * q1);
per_frame_29=ib_b = 0.5 + 0.5 * cos(2.811 * time + 0.1 * q2);
per_frame_30=ib_g = 0.5 + 0.5 * cos(1.666 * time + 0.1 * q3);
per_frame_31=ob_r = 1 - if(0.00001 < abs(mod(q8, 2)), ib_b, ib_g);
per_frame_32=ob_b = 1 - if(0.00001 < abs(above(q8, 3)), ib_g, ib_r);
per_frame_33=ob_g = 1 - if(0.00001 < abs(mod(q8, 3)), ib_r, ib_b);
per_frame_34=ib_size = 0.03 + 0.02 * q2;
per_frame_35=ob_size = 0.03 + 0.02 * sin(2.321 * time + 0.2 * q2);
per_frame_36=ib_a = 0.9 + 0.1 * sin(0.3 * q2 + q4 + 0.5 * q1);
per_frame_37=mv_r = 0.5 + 0.5 * sin(q4 + 0.678 * time);
per_frame_38=mv_b = 0.5 + 0.5 * sin(q4 + 0.789 * time);
per_frame_39=mv_g = 0.5 + 0.5 * sin(q5 + 0.456 * time);
per_frame_40=mv_a = 0.1 + 0.1 * sin(1.178 * time + 1.14 * q5);
per_frame_41=wave_r = 0.5 + 0.5 * sin(q1 + 2.183 * time);
per_frame_42=wave_b = 0.5 + 0.5 * sin(q2 + 1.211 * time);
per_frame_43=wave_g = 0.5 + 0.5 * sin(q3 + 1.541 * time);
per_frame_44=wave_mystery = wave_mystery + sin(2.18 * time + q6);
per_frame_45=wave_x = wave_x + 0.3 * sin(0.811 * time) + 0.005 * mod(frame, 3);
per_frame_46=wave_y = wave_y + 0.3 * sin(0.788 * time) + 0.005 * mod(frame, 3);
per_frame_47=wave_mode = mod(q8, 2);
per_frame_48=echo_orientation = mod(q8, 4);
per_frame_49=warp = 0;
per_frame_50=rot = 0;
per_pixel_1=xx = above(y, 0.5 + 0.5 * q2) * x * q1 - 0.5 + 0.03 * q5 + 0.1 * y * q6 + 0.1 * sin(0.322 * time);
per_pixel_2=yy = above(x, 0.5 + 0.5 * q3) * y * q1 - 0.5 + 0.03 * q6 + 0.1 * x * q5 + 0.1 * sin(0.427 * time);
per_pixel_3=rot = sin(rad * (1.4 + 0.7 * q4 + 0.7 * q5 + 0.7 * q6));
per_pixel_4=grid = bnot(mod(sin(xx * yy), q8));
per_pixel_5=grid_shift = grid * sin(6.3 * (yy - 0.5) * q4);
per_pixel_6=dx = if(0.00001 < abs(above(q4, 0) * above(abs(x - 0.5), 0.25 + 0.25 * q1)), below(q7, 4) * grid_shift, sin(3.14 * xx * above(q3, 0)));
per_pixel_7=dy = if(0.00001 < abs(equal(q7, 3)), above(q5, 0) * above(q7, 3) * grid_shift, sin(3.14 * yy * above(q2, 0)));
per_pixel_8=zoom = zoom + cos(rad * q5 + q7 * xx + q8 * yy) * q6 * 0.5;
