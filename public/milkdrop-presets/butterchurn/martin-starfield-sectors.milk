wave_0_per_frame1=t1 = sin(t / 7);
wave_0_per_point1=t_abs = sample;
wave_0_per_point2=ox = sin(68 * t_abs);
wave_0_per_point3=oy = cos(63 * t_abs);
wave_0_per_point4=oz = sin(125 * t_abs);
wave_0_per_point5=r = 0;
wave_0_per_point6=g = 1;
wave_0_per_point7=b = 1;
wave_0_per_point8=t_rel = sample - time / 127;
wave_0_per_point9=t_rel = t_rel - floor(t_rel);
wave_0_per_point10=a = mod(512 * sample - 2 * time, 2);
wave_0_per_point11=a = 1;
wave_0_per_point12=xang = 0;
wave_0_per_point13=yang = t1;
wave_0_per_point14=zang = t1;
wave_0_per_point15=fov = 0.15;
wave_0_per_point16=mx = ox * cos(zang) - oy * sin(zang);
wave_0_per_point17=my = ox * sin(zang) + oy * cos(zang);
wave_0_per_point18=ox = mx;
wave_0_per_point19=oy = my;
wave_0_per_point20=mx = ox * cos(yang) + oz * sin(yang);
wave_0_per_point21=mz = -ox * sin(yang) + oz * cos(yang);
wave_0_per_point22=ox = mx;
wave_0_per_point23=oz = mz;
wave_0_per_point24=my = oy * cos(xang) - oz * sin(xang);
wave_0_per_point25=mz = oy * sin(xang) + oz * cos(xang);
wave_0_per_point26=oy = my;
wave_0_per_point27=oz = mz;
wave_0_per_point28=x = ox * fov / oz + 0.5;
wave_0_per_point29=y = oy * fov / oz + 0.5;
