per_frame_1=dec_med = pow(0.9, 30 / fps);
per_frame_2=dec_slow = pow(0.99, 30 / fps);
per_frame_3=beat = max(max(bass, mid), treb);
per_frame_4=avg = avg * dec_slow + beat * (1 - dec_slow);
per_frame_5=is_beat = above(beat, avg + peak) * above(time, t0 + 0.2);
per_frame_6=t0 = is_beat * time + (1 - is_beat) * t0;
per_frame_7=peak = is_beat * beat + (1 - is_beat) * peak * dec_med;
per_frame_8=index = mod(index + is_beat, 4);
per_frame_9=index2 = mod(index2 + is_beat * bnot(index), 4);
per_frame_10=monitor = index2;
per_frame_11=q20 = avg;
per_frame_12=q21 = beat;
per_frame_13=q22 = peak;
per_frame_14=q23 = index;
per_frame_15=q24 = is_beat;
per_frame_16=q26 = (bass + mid + treb) / 16;
per_frame_17=k1 = is_beat * bnot(index) * bnot(index2);
per_frame_18=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_19=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_20=p3 = dec_med * p3 + (1 - dec_med) * p2;
per_frame_21=rott = 3.1416 * p3 / 4;
per_frame_22=pos = pos + q20 / 140;
per_frame_23=q28 = pos;
per_frame_24=q27 = index + 1;
per_frame_25=q1 = cos(rott);
per_frame_26=q2 = sin(rott);
per_frame_27=q3 = -q2;
per_frame_28=q4 = q1;
per_frame_29=trel = time / 10;
per_frame_30=q5 = cos(trel);
per_frame_31=q6 = sin(trel);
per_frame_32=q7 = -q6;
per_frame_33=q8 = q5;
per_frame_34=trig = q24 * mod(index, 4);
per_frame_35=mox = bnot(trig) * mox + trig * (randint(100) / 100 - 0.5);
per_frame_36=moy = bnot(trig) * moy + trig * (randint(100) / 100 - 0.5);
per_frame_37=q15 = mox / 2;
per_frame_38=q16 = moy / 2;
per_frame_39=speed = speed * bnot(trig) + trig * q26;
per_frame_40=movz = movz + speed / fps;
per_frame_41=q9 = movz;
per_frame_42=q30 = 3 * (1.2 + sin(time / 7));
per_frame_43=zoom = 1;
per_frame_44=rot = -0;
