per_frame_init_1=bass_thresh = 0;
per_frame_init_2=q2 = 0;
per_frame_init_3=vol = 0;
per_frame_init_4=q3 = 0;
per_frame_init_5=q4 = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.91 * (bass_thresh - 1.3) + 1.3);
per_frame_2=q2 = bass_thresh;
per_frame_3=vol = 0.25 * (bass + mid + treb);
per_frame_4=q3 = vol;
per_frame_5=q4 = min(0.5 * vol, 1);
per_frame_6=dy = -0.005;
per_frame_7=warp = 0;
shape_1_init1=q4 = 0;
shape_1_per_frame1=r = q4;
shape_1_per_frame2=b = 1 - r;
shape_1_per_frame3=g = 1 - r;
shape_1_per_frame4=r2 = r;
shape_1_per_frame5=b2 = b;
shape_1_per_frame6=g2 = g;

[warp_shader]
uniform sampler2D sampler_cartunemask1;
 shader_body { 
  vec2 uv_1;
  uv_1.y = uv.y;
  uv_1.x = (uv.x + ((
    cos(((uv.y * q3) * 20.0))
   * 0.04) * texture (sampler_cartunemask1, uv).xyz).x);
  vec2 tmpvar_2;
  tmpvar_2.x = uv_1.x;
  tmpvar_2.y = (uv.y - pow (pow (
    (((texture (sampler_blur1, uv_1).xyz * scale1) + bias1) - 0.05)
  , 
    (texture (sampler_main, uv_1).xyz - 0.9)
  ).x, 0.007));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (texture (sampler_main, fract(tmpvar_2)).xyz + 0.001);
  ret = tmpvar_3.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv).xyz;
  ret_1 = ((tmpvar_2 * tmpvar_2) * 1.54);
  ret_1 = (ret_1 * ret_1);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
