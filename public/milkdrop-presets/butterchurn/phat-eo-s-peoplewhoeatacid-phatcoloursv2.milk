per_pixel_1=adv = min(bass * bass * bass, 1);
per_pixel_2=warp = 3 * (0.5 * sin(3 * time) + 0.5) * (x - 0.5) * -2 + 3 * (0.5 * cos(3 * time) + 0.5) * (y - 0.5) * 2;
per_pixel_3=warp = warp * adv;
per_pixel_4=bax = above(10 * sin(1 * time), 9) * sin(2 * time) * 0.3;
per_pixel_5=bar = above(sin(26 * x + 4 * time), 0.6);
per_pixel_6=bay = above(10 * cos(1 * time), 9) * sin(2 * time) * 0.6;
per_pixel_7=bat = above(sin(3 * ang + 4 * time), 0.6);
per_pixel_8=zoom = zoom + bar * bax;
per_pixel_9=rot = rot + bay * bat;
