per_frame_init_11=beat = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=beatcounter = 0;
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + 0.15 * sin(0.222 * time);
per_frame_3=wave_g = wave_g + 0.15 * sin(0.333 * time);
per_frame_4=wave_b = wave_b + 0.15 * sin(0.444 * time);
per_frame_5=zoom = zoom + 0.01 - 0.01 * bass_att;
per_frame_6=volume = 0.3 * (bass + mid);
per_frame_7=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_8=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_9=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_10=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_11=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_12=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_13=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_14=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_15=peakbass_att = max(if(0.00001 < abs(beat), bass_att, peakbass_att), 1.1 * meanbass_att);
per_frame_16=beatcounter = if(0.00001 < abs(above(beat, 0)), beatcounter + 1, beatcounter);
per_frame_17=beatcounter = if(0.00001 < abs(above(beatcounter, 5)), 0, beatcounter);
per_frame_18=beateven = mod(beatcounter, 2);
per_frame_19=mycounter = if(0.00001 < abs(beateven), if(0.00001 < abs(beat), if(0.00001 < abs(above(mycounter, 4)), 0, mycounter + 1), mycounter), mycounter);
per_frame_20=q2 = if(0.00001 < abs(beat), if(0.00001 < abs(beateven), 2, mycounter + 3), oldq2);
per_frame_21=oldq2 = q2;
per_frame_22=ib_r = ib_r + 0.25 * sin(0.965 * time);
per_frame_23=ib_g = ib_g + 0.25 * sin(1.123 * time);
per_frame_24=ib_b = ib_b + 0.25 * sin(1.046 * time);
per_frame_25=ob_r = ob_r + 0.15 * sin(0.865 * time);
per_frame_26=ob_g = ob_g + 0.15 * sin(1.103 * time);
per_frame_27=ob_b = ob_b + 0.15 * sin(1.086 * time);
per_frame_28=wave_a = 0;
per_frame_29=ob_size = 0.05 * beat;
per_frame_30=q1 = beat;
per_frame_31=monitor = q2;
per_frame_32=mv_a = 0.02 * q1;
per_pixel_1=rot = 0.3 * tan(0.1 * sin(20 * pow(rad, 4) + time) + 0.1 * sin(0.222 * time));
per_pixel_2=zoom = zoom + 0.1 * sin(ang * q2 - time);
per_pixel_3=zoomexp = 100 * (sqrt(2) - rad);
shape_0_init1=q1 = 0;
shape_0_init2=q1 = 0;
