[comp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = ((texture (sampler_main, (uv + texture (sampler_pw_noise_lq, 
    (((floor(
      (uv * vec2(10.0, 10.0))
    ) * 0.1) + rand_preset.xy) * aspect.xy)
  ).xy)).xyz * 1.4) - 0.4);
  ret = tmpvar_1.xyz;
 }
