per_frame_1=wave_r = wave_r + 0.2 * (0.6 * sin(1.517 * time) + 0.4 * sin(1.58 * time));
per_frame_2=wave_g = wave_g + 0.2 * (0.6 * sin(1.088 * time) + 0.4 * sin(1.076 * time));
per_frame_3=wave_b = wave_b + 0.2 * (0.6 * sin(1.037 * time) + 0.4 * sin(0.922 * time));
per_frame_4=rot = rot + 0.04 * (0.6 * sin(0.381 * time) + 0.4 * sin(0.579 * time));
per_frame_5=cx = cx + 0.11 * (0.6 * sin(0.374 * time) + 0.4 * sin(0.294 * time));
per_frame_6=cy = cy + 0.11 * (0.6 * sin(0.393 * time) + 0.4 * sin(0.223 * time));
per_frame_7=q1 = cos(1.41 * time);
per_frame_8=q2 = time + 0.3 * sin(1.47 * time);
per_pixel_1=rot = rot + 0.05 * sin(13.5 * rad + 1.3 * q2 + 1.31 * q);
per_pixel_2=zoom = zoom + 0.05 * sin(10 * ang + 7.5 * rad + 1.63 * q2 + q);

[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 tmpvar_2;
  tmpvar_2 = normalize((uv_orig - 0.5));
  float tmpvar_3;
  tmpvar_3 = (time * 11.0);
  float tmpvar_4;
  tmpvar_4 = (rad * 30.0);
  uv_1 = (uv + ((
    (tmpvar_2 * texsize.zw)
   * 
    cos(((6.283186 * (
      fract(tmpvar_4)
     + 0.5)) - tmpvar_3))
  ) * 2.0));
  uv_1 = (uv_1 + ((
    (tmpvar_2.yx * vec2(1.0, -1.0))
   * texsize.zw) * cos(
    (((ang * 6.28) * (7.0 + floor(tmpvar_4))) - tmpvar_3)
  )));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ((texture (sampler_main, uv_1).xyz - 0.016) * 0.985);
  ret = tmpvar_5.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret_1;
  ret_1 = (texture (sampler_main, uv).xyz + ((
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
   - blur1_min) * 2.5));
  ret_1 = (ret_1 * 1.3);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ret_1;
  ret = tmpvar_2.xyz;
 }
