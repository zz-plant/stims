[warp_shader]
shader_body { 
  vec2 uv_1;
  vec2 uv6_2;
  uv_1 = (uv + (vec2(0.0, 0.01) * dot (
    ((texture (sampler_blur1, uv).xyz * scale1) + bias1)
  , vec3(0.32, 0.49, 0.29))));
  uv6_2 = (0.4 * sin((
    (uv_1 * 8.0)
   + 
    (rand_frame * 6.0)
  .xy)));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = (((
    (texture (sampler_main, uv_1).xyz - (((texture (sampler_blur2, 
      fract(uv_1)
    ).xyz * scale2) + bias2) * 0.03))
   + 
    (0.1 * (vec3((0.1 / sqrt(
      dot (uv6_2, uv6_2)
    ))) * ((1.0 + roam_cos) / 2.0).xyz))
  ) * 0.99) - 0.02);
  ret = tmpvar_3.xyz;
 }

[comp_shader]
vec3 xlat_mutablenoise;
vec2 xlat_mutablers;
 shader_body { 
  vec2 uv1_1;
  mat2 tmpvar_2;
  tmpvar_2[uint(0)] = _qa.xy;
  tmpvar_2[1u] = _qa.zw;
  uv1_1 = (((uv - 0.5) * aspect.xy) * tmpvar_2);
  uv1_1 = (uv1_1 * aspect.yx);
  float tmpvar_3;
  tmpvar_3 = ((3.0 + (q10 * 4.0)) / abs(uv1_1.y));
  xlat_mutablers.x = (uv1_1.x * tmpvar_3);
  xlat_mutablers.y = (tmpvar_3 + (time * 6.0));
  vec2 tmpvar_4;
  tmpvar_4 = sin(xlat_mutablers);
  vec3 tmpvar_5;
  tmpvar_5 = vec3((1.0 - sqrt((
    sqrt(dot (tmpvar_4, tmpvar_4))
   - 0.4))));
  xlat_mutablenoise = (tmpvar_5 * (vec3(
    greaterThanEqual (tmpvar_5, vec3(0.1, 0.1, 0.1))
  ) * clamp (
    (1.0 - (tmpvar_3 / 40.0))
  , 0.0, 1.0)));
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ((texture (sampler_main, (uv + 
    (xlat_mutablenoise / 2.0)
  .xy)).xyz * 1.5) - (0.1 * xlat_mutablenoise));
  ret = tmpvar_6.xyz;
 }
