[preset00]
fRating=0.000000
fGammaAdj=1.210000
fDecay=0.970000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
bAdditiveWaves=1.000000
bMaximizeWaveColor=0.000000
bTexWrap=0.000000
bDarken=1.000000
fWaveAlpha=100.000000
fWaveScale=2.630000
fWaveSmoothing=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=1.000000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=ob_r = 1 - abs(wave_r);
per_frame_6=ob_b = 1 - abs(wave_b);
per_frame_7=ob_g = 1 - abs(wave_g);
per_frame_8=ib_r = 1 - abs(ob_r);
per_frame_9=ib_g = 1 - abs(ob_g);
per_frame_10=ib_b = 1 - abs(ob_b);
per_frame_11=ob_a = ob_a - sin(time);
per_frame_12=ib_a = ib_a - cos(time);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom - 0.03;
per_pixel_5=dy = dy + 2 * dy_r * cos(sin(1.2 * cos(2.7 * time) * (0.5 - x)) * y) * 8 * dx_r * sin(1.02 * time);
per_pixel_6=dx = dx + 2 * dx_r * sin(cos(1.32 * sin(1.24 * time) * (0.5 - y)) * x) * 8 * dy_r * cos(1.2 * time);
per_pixel_7=sx = sx - 12 * dx_r * cos(sin(1.1 * sin(2.87 * time) * 1.5 * rad) * rad) * 12 * dx_r * tan(0.8 * x * time);
per_pixel_8=sy = sy - 12 * dy_r * sin(sin(0.67 * cos(1.12 * time) * 1.5 * rad) * rad) * 12 * dy_r * tan(0.9 * y * time);

[warp_shader]
shader_body { 
  vec3 ret_1;
  vec4 tmpvar_2;
  tmpvar_2 = texture (sampler_main, uv);
  ret_1 = (tmpvar_2.xyz + ((tmpvar_2.xyz - 
    ((texture (sampler_blur2, uv).xyz * scale2) + bias2)
  ) * 0.3));
  ret_1 = (ret_1 * 0.9);
  ret_1 = (ret_1 + ((
    (texture (sampler_noise_lq, (((uv_orig * texsize.xy) * (texsize_noise_lq.zw * 0.4)) + rand_frame.xy)).xyz - 0.5)
   / 256.0) * 112.0));
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_1;
  ret = tmpvar_3.xyz;
 }
