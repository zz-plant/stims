per_frame_init_54=c_x = 0.5;
per_frame_init_55=c_y = 0.5;
per_frame_1=sx = 1 + 0.01 * mod(8 * bass, 8) * equal(mod(time, floor(24 - 2 * bass)), 0);
per_frame_2=sy = 1 + 0.01 * mod(8 * mid, 8) * equal(mod(time, 12 + floor(24 - 2 * bass)), 0);
per_frame_3=q1 = aspectx;
per_frame_4=q2 = aspecty;
per_frame_5=rot = 0;
per_frame_6=zoom = 1;
per_frame_7=warp = 0;
per_frame_8=vol = 8 * bass + 4 * mid + 2 * treb;
per_frame_9=vol = vol * above(vol, 17);
per_frame_10=monitor = vol;
per_frame_11=beat = above(vol, res);
per_frame_12=diff = (1 - beat) * diff + beat * (vol - res);
per_frame_13=res = beat * (vol + 2 * diff) + (1 - beat) * (res - 60 * (0.04 * diff + 0.12) / fps);
per_frame_14=res = max(0, res);
per_frame_15=monitor = res;
per_frame_16=r = if(0.00001 < abs(beat), 0.0001 * (randint(200) - 100), r);
per_frame_17=rot = r;
per_frame_18=c_x = if(0.00001 < abs(beat), 0.5 + 0.005 * (randint(200) - 100), c_x);
per_frame_19=c_y = if(0.00001 < abs(beat), 0.5 + 0.005 * (randint(200) - 100), c_y);
per_frame_20=q23 = c_x;
per_frame_21=q24 = c_y;
per_frame_22=xx1 = 0.9 * xx1 + 0.01 * bass;
per_frame_23=xx2 = 0.9 * xx2 + 0.01 * treb;
per_frame_24=yy1 = 0.94 * yy1 + 0.0075 * (treb + bass);
per_frame_25=x1 = 0.5 + 2 * (xx1 - xx2);
per_frame_26=y1 = 0.4 + 1.5 * yy1;
per_frame_27=dt = 0.03 / fps;
per_frame_28=vx2 = vx2 * (1 - 2 * dt) + 10 * dt * (x1 + x3 - 2 * x2);
per_frame_29=vy2 = vy2 * (1 - 2 * dt) + dt * (10 * (y1 + y3 - 2 * y2) - 0.5);
per_frame_30=vx3 = vx3 * (1 - 2 * dt) + 10 * dt * (x2 + x4 - 2 * x3);
per_frame_31=vy3 = vy3 * (1 - 2 * dt) + dt * (10 * (y2 + y4 - 2 * y3) - 0.5);
per_frame_32=vx4 = vx4 * (1 - 2 * dt) + 10 * dt * (x3 - x4);
per_frame_33=vy4 = vy4 * (1 - 2 * dt) + dt * (10 * (y3 - y4) - 0.5);
per_frame_34=x2 = x2 + vx2;
per_frame_35=y2 = y2 + vy2;
per_frame_36=x3 = x3 + vx3;
per_frame_37=y3 = y3 + vy3;
per_frame_38=x4 = x4 + vx4;
per_frame_39=y4 = y4 + vy4;
per_frame_40=vx2 = if(0.00001 < abs(above(x2, 0)), vx2, 0.5 * abs(vx2));
per_frame_41=vx2 = if(0.00001 < abs(below(x2, 1)), vx2, 0.5 * -abs(vx2));
per_frame_42=vx3 = if(0.00001 < abs(above(x3, 0)), vx3, 0.5 * abs(vx3));
per_frame_43=vx3 = if(0.00001 < abs(below(x3, 1)), vx3, 0.5 * -abs(vx3));
per_frame_44=vx4 = if(0.00001 < abs(above(x4, 0)), vx4, 0.5 * abs(vx4));
per_frame_45=vx4 = if(0.00001 < abs(below(x4, 1)), vx4, 0.5 * -abs(vx4));
per_frame_46=vy2 = if(0.00001 < abs(above(y2, 0)), vy2, 0.5 * abs(vy2));
per_frame_47=vy2 = if(0.00001 < abs(below(y2, 1)), vy2, 0.5 * -abs(vy2));
per_frame_48=vy3 = if(0.00001 < abs(above(y3, 0)), vy3, 0.5 * abs(vy3));
per_frame_49=vy3 = if(0.00001 < abs(below(y3, 1)), vy3, 0.5 * -abs(vy3));
per_frame_50=vy4 = if(0.00001 < abs(above(y4, 0)), vy4, 0.5 * abs(vy4));
per_frame_51=vy4 = if(0.00001 < abs(below(y4, 1)), vy4, 0.5 * -abs(vy4));
per_frame_52=q1 = x1;
per_frame_53=q2 = x2;
per_frame_54=q3 = x3;
per_frame_55=q4 = x4;
per_frame_56=q5 = y1;
per_frame_57=q6 = y2;
per_frame_58=q7 = y3;
per_frame_59=q8 = y4;
per_frame_60=q9 = 1 / aspectx;
per_frame_61=q10 = 1 / aspecty;
per_frame_62=q11 = aspectx;
per_frame_63=q12 = aspecty;
per_frame_64=q13 = 0.8 * sqrt(vx4 * vx4 + vy4 * vy4);
per_frame_65=q14 = atan2(vx4, vy4);
per_pixel_1=d = pow(sqrt(sqr(x - q3) + sqr(y - q4)), 2) - 0;
per_pixel_2=v = 0.03;
per_pixel_3=dx = v * (x - q23) * d;
per_pixel_4=dy = v * (y - q24) * d;
per_pixel_5=x = 0.5 + (x - 0.5) * q11;
per_pixel_6=y = 0.5 + (y - 0.5) * q12;
per_pixel_7=dir = -q14 + asin(1);
per_pixel_8=velocity = q13;
per_pixel_9=strength = 100;
per_pixel_10=size = 0.07;
per_pixel_11=xx = q4;
per_pixel_12=yy = 1 - q8;
per_pixel_13=x1 = xx + cos(dir + 1.5708) * size;
per_pixel_14=y1 = yy - sin(dir + 1.5708) * size;
per_pixel_15=x2 = xx - cos(dir + 1.5708) * size;
per_pixel_16=y2 = yy + sin(dir + 1.5708) * size;
per_pixel_17=d1 = sqrt((x1 - x) * (x1 - x) + (y1 - y) * (y1 - y)) - 2 * size;
per_pixel_18=si1 = 1 - 1 / (1 + pow(2, 100 * -d1));
per_pixel_19=d2 = sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y)) - 2 * size;
per_pixel_20=si2 = 1 - 1 / (1 + pow(2, 100 * -d2));
per_pixel_21=dx = dx + (si1 * sin(y1 - y) * d1 - si2 * sin(y2 - y) * d2) * strength * velocity;
per_pixel_22=dy = dy + (-si1 * sin(x1 - x) * d1 + si2 * sin(x2 - x) * d2) * strength * velocity;
shape_0_init1=vx = 0;
shape_0_init2=vy = 0;

[warp_shader]
vec2 xlat_mutabled;
vec3 xlat_mutabledx;
vec3 xlat_mutabledy;
 shader_body { 
  vec3 ret_1;
  vec3 tmpvar_2;
  tmpvar_2 = (texture (sampler_noise_lq, ((
    (uv_orig * texsize.xy)
   * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5);
  xlat_mutabled = (texsize.zw * 4.0);
  xlat_mutabledx = (((texture (sampler_blur1, 
    (uv_orig + (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv_orig - (vec2(1.0, 0.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  xlat_mutabledy = (((texture (sampler_blur1, 
    (uv_orig + (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1) - ((texture (sampler_blur1, 
    (uv_orig - (vec2(0.0, 1.0) * xlat_mutabled))
  ).xyz * scale1) + bias1));
  xlat_mutabled = uv;
  vec2 tmpvar_3;
  tmpvar_3.x = xlat_mutabledx.y;
  tmpvar_3.y = xlat_mutabledy.y;
  vec2 tmpvar_4;
  tmpvar_4.x = xlat_mutabledx.z;
  tmpvar_4.y = xlat_mutabledy.z;
  vec4 tmpvar_5;
  tmpvar_5 = texture (sampler_main, uv_orig);
  ret_1.y = ((texture (sampler_main, (uv - 
    ((tmpvar_3 * texsize.zw) * 6.0)
  )).y - 0.008) + ((1.0 - tmpvar_5.x) * 0.018));
  ret_1.z = ((texture (sampler_main, (uv - 
    ((tmpvar_4 * texsize.zw) * 6.0)
  )).z - 0.008) + (tmpvar_5.x * 0.018));
  ret_1.x = texture (sampler_fc_main, (uv + ((tmpvar_2.xy * texsize.zw) * 0.5))).x;
  ret_1.x = (ret_1.x + ((
    (ret_1.x - ((texture (sampler_blur3, uv).xyz * scale3) + bias3).x)
   * 0.15) + (tmpvar_2 * 0.0042)).x);
  vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = ret_1;
  ret = tmpvar_6.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = q3;
  tmpvar_1.y = q4;
  vec2 tmpvar_2;
  tmpvar_2.x = q6;
  tmpvar_2.y = q7;
  vec2 tmpvar_3;
  tmpvar_3.x = q9;
  tmpvar_3.y = q10;
  vec2 tmpvar_4;
  tmpvar_4.x = q12;
  tmpvar_4.y = q13;
  vec2 tmpvar_5;
  tmpvar_5 = (texsize.zw * 1.25);
  vec3 tmpvar_6;
  tmpvar_6 = (texture (sampler_main, (uv + (vec2(1.0, 0.0) * tmpvar_5))).xyz - texture (sampler_main, (uv - (vec2(1.0, 0.0) * tmpvar_5))).xyz);
  vec3 tmpvar_7;
  tmpvar_7 = (texture (sampler_main, (uv + (vec2(0.0, 1.0) * tmpvar_5))).xyz - texture (sampler_main, (uv - (vec2(0.0, 1.0) * tmpvar_5))).xyz);
  vec2 tmpvar_8;
  tmpvar_8.x = dot (tmpvar_6, vec3(0.32, 0.49, 0.29));
  tmpvar_8.y = dot (tmpvar_7, vec3(0.32, 0.49, 0.29));
  vec2 x_9;
  x_9 = ((uv - (tmpvar_8 * 8.0)) - tmpvar_1);
  vec2 tmpvar_10;
  tmpvar_10.x = dot (tmpvar_6, vec3(0.32, 0.49, 0.29));
  tmpvar_10.y = dot (tmpvar_7, vec3(0.32, 0.49, 0.29));
  vec2 x_11;
  x_11 = ((uv - (tmpvar_10 * 8.0)) - tmpvar_2);
  vec2 tmpvar_12;
  tmpvar_12.x = dot (tmpvar_6, vec3(0.32, 0.49, 0.29));
  tmpvar_12.y = dot (tmpvar_7, vec3(0.32, 0.49, 0.29));
  vec2 x_13;
  x_13 = ((uv - (tmpvar_12 * 8.0)) - tmpvar_3);
  vec2 tmpvar_14;
  tmpvar_14.x = dot (tmpvar_6, vec3(0.32, 0.49, 0.29));
  tmpvar_14.y = dot (tmpvar_7, vec3(0.32, 0.49, 0.29));
  vec2 x_15;
  x_15 = ((uv - (tmpvar_14 * 8.0)) - tmpvar_4);
  vec4 tmpvar_16;
  tmpvar_16.w = 1.0;
  tmpvar_16.xyz = mix (texture (sampler_main, uv).xyz, max (max (
    (vec3((1.0 - pow (sqrt(
      dot (x_9, x_9)
    ), 0.2))) * vec3(2.0, 1.0, -1.0))
  , 
    (vec3((1.0 - pow (sqrt(
      dot (x_11, x_11)
    ), 0.2))) * vec3(2.0, -1.0, 1.0))
  ), max (
    (vec3((1.0 - pow (sqrt(
      dot (x_13, x_13)
    ), 0.2))) * vec3(-1.0, 1.0, 2.0))
  , 
    (vec3((1.0 - pow (sqrt(
      dot (x_15, x_15)
    ), 0.2))) * vec3(1.0, -1.0, 2.0))
  )), vec3(0.5, 0.5, 0.5));
  ret = tmpvar_16.xyz;
 }
