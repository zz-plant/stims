[preset00]
fRating=3.000000
fGammaAdj=1.000000
fDecay=0.997000
fVideoEchoZoom=0.997000
nVideoEchoOrientation=1.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
bDarken=1.000000
fWaveAlpha=0.001000
fWaveScale=0.010000
fWaveSmoothing=0.270000
fWaveParam=-0.380000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=0.999510
fWarp=0.010000
fOuterBorderSize=0.500000
fOuterBorderR=0.010000
fInnerBorderSize=0.260000
fInnerBorderR=1.000000
fInnerBorderG=1.000000
fInnerBorderB=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.850000
fMotionVectorsR=0.500000
fMotionVectorsG=0.500000
fMotionVectorsB=0.500000
fMotionVectorsA=0.000000
wavecode_0_enabled=1.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=warp = 0;
per_frame_2=decay = 0.92;
per_pixel_1=zoom = zoom + 0.03 * bass_att * bass_att * rad;
per_pixel_2=rot = rot + rad * band(-2.5, 5 * cos(time)) * 0.01;
wave_0_per_point1=x = 0.5 + 0.2 * bass * sin(20 * sample * time * treb);
wave_0_per_point2=y = 0.5 + 0.2 * bass * cos(20 * sample * time * treb);
wave_0_per_point3=r = 1 + 0.5 * sin(0.1 * sample + 10 * time * bass);
wave_0_per_point4=g = 1 + 0.5 * sin(2 * sample + 50 * time * treb);
wave_0_per_point5=b = 1 + 0.5 * sin(5 * sample + 20 * time * mid);
wave_0_per_point6=a = r;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, uv).xyz - 0.04);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec3 ret1_1;
  vec2 uv1_2;
  vec3 tmpvar_3;
  tmpvar_3 = texture (sampler_main, uv).xyz;
  vec2 tmpvar_4;
  tmpvar_4.x = (texture (sampler_main, (uv - vec2(0.001, 0.0))).xyz - texture (sampler_main, (uv + vec2(0.001, 0.0))).xyz).x;
  tmpvar_4.y = (texture (sampler_main, (uv - vec2(0.0, 0.001))).xyz - texture (sampler_main, (uv + vec2(0.0, 0.001))).xyz).x;
  uv1_2 = ((0.5 * cos(
    (((uv - 0.5) * 1.5) + 1.6)
  )) - (3.0 * tmpvar_4));
  ret1_1 = ((0.3 * dot (tmpvar_3, vec3(0.32, 0.49, 0.29))) + ((
    (clamp ((0.01 / sqrt(
      dot (uv1_2, uv1_2)
    )), 0.0, 1.0) * tmpvar_3)
   * 
    (4.0 * (bass + mid))
  ) * treb_att));
  vec4 tmpvar_5;
  tmpvar_5.w = 0.0;
  tmpvar_5.xyz = ret1_1;
  vec4 tmpvar_6;
  tmpvar_6.w = 0.0;
  tmpvar_6.xyz = abs((ret1_1 - 1.0));
  vec4 tmpvar_7;
  tmpvar_7 = mix (texture (sampler_noise_lq, ((
    (uv_orig * texsize.xy)
   * texsize_noise_lq.zw) + rand_frame.xy)), tmpvar_5, tmpvar_6);
  ret1_1 = tmpvar_7.xyz;
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = (0.8 * tmpvar_7.xyz);
  ret = tmpvar_8.xyz;
 }
