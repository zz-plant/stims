per_pixel_1=dx1 = 0.132 * cos(y * q3 * 30);
per_pixel_2=dx = if(0.00001 < abs(above(y, 0.8)), if(0.00001 < abs(below(y, 0.83)), if(0.00001 < abs(above(x, 0.05)), if(0.00001 < abs(below(x, 0.93)), dx1 * (1 - rad + 0.1) * 1.5, 0), 0), 0), 0);
per_pixel_3=q1 = dx;
