[preset00]
fRating=4.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=3.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
bMaximizeWaveColor=0.000000
fWaveAlpha=4.100000
fWaveScale=0.010000
fWaveSmoothing=0.630000
fWaveParam=-0.400000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.050000
fOuterBorderA=0.300000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=0.200000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
nMotionVectorsLoop=0.500000
fMotionVectorsR=0.350000
fMotionVectorsG=0.350000
fMotionVectorsB=0.350000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 0.25 * sin(1.4 * time) + 0.25 * sin(2.25 * time);
per_frame_2=wave_g = wave_g + 0.25 * sin(1.7 * time) + 0.25 * sin(2.11 * time);
per_frame_3=wave_b = wave_b + 0.25 * sin(1.84 * time) + 0.25 * sin(2.3 * time);
per_frame_4=warp = 0;
per_frame_5=ob_r = ob_r + wave_b;
per_frame_6=ob_g = ob_g + wave_r;
per_frame_7=ob_b = ob_b + wave_g;
per_frame_8=ib_r = ib_r + wave_r;
per_frame_9=ib_b = ib_b + wave_b;
per_frame_10=ib_g = ib_g + wave_g;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=rot = rot + 0.2 * (0.144 * sin(rad - 0.22 / abs(2 * rad + bass / time)) - treb / 1.3 * cos(bass_att));
per_pixel_5=zoom = zoom - 0.03 * abs(sin(bass * time + 52 * rad) - cos(0.3 * bass - mid_att));
per_pixel_6=zoom = zoom - 0.026 * abs(-0.2 * bass * rot - 3 * (0.5 - cos(0.5 * rot) - rad) / 2);
per_pixel_7=dx = dx + 1.5 * cos(zoom) * dx_r;
per_pixel_8=dy = dy + 1.5 * sin(zoom) * dy_r;
per_pixel_9=rot = if(0.00001 < abs(equal(bass, 0)), 0, rot);
per_pixel_10=zoom = if(0.00001 < abs(equal(bass, 0)), 0, zoom);
