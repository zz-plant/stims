per_frame_init_1=rg2 = 0;
per_frame_init_2=pfdx_r = 0;
per_frame_init_3=pfthresh = 0;
per_frame_init_4=ocog = 0;
per_frame_init_5=thresh = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q5 = 0;
per_frame_init_8=cog = 0;
per_frame_init_9=dy_r = 0;
per_frame_init_10=rg3 = 0;
per_frame_init_11=pfdy_r = 0;
