per_frame_init_17=q2 = 0;
per_frame_init_18=orcog = 0;
per_frame_init_19=q3 = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(1.6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 2;
per_frame_5=wave_x = wave_x + 0.1 * sin(1.2 * time) + 0.1 * sin(0.1 * time);
per_frame_6=wave_y = wave_y + 0.2 * cos(1.4 * time) - 0.1 * cos(0.4 * time);
per_frame_7=ob_r = wave_g;
per_frame_8=ob_b = wave_r;
per_frame_9=ob_g = wave_b;
per_frame_10=ib_r = 1 - abs(ob_r);
per_frame_11=ib_b = 1 - abs(ob_b);
per_frame_12=ib_g = 1 - abs(ob_g);
per_frame_13=q1 = wave_r;
per_frame_14=q2 = wave_b;
per_frame_15=q3 = wave_g;
per_frame_16=cog = ocog + 0.005 * (bass + bass_att + bass * bass_att - 2);
per_frame_17=ocog = below(cog, 30000) * cog;
per_frame_18=q4 = cog;
per_frame_19=rcog = orcog + 0.005 * randint(100);
per_frame_20=orcog = below(rcog, 20000) * rcog;
per_frame_21=q5 = rcog;
per_frame_22=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_23=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_24=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_25=rg1 = abs(sin(2.3 * time));
per_frame_26=rg2 = 0 * above(rg1, 0.5) + 1 * below(rg1, 0.25);
per_frame_27=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=zoom = zoom - abs(0.025 * sin(4 * q4));
per_pixel_5=xy = above(sin(3 * q4), 0) * x + below(sin(3 * q4), 0) * y;
per_pixel_6=zoom = zoom - 3 * dx_r * rad * sin(6 * bass_att * (3 - rad));
per_pixel_7=rot = rot - 0.35 * above(xy, 0.45 + 0.75 * sin(5 * q4 * bass_att)) * below(xy, 0.55 + 0.75 * sin(5 * q4 * bass_att));
shape_0_init1=t1 = 0;
shape_0_init2=t2 = 0;
shape_0_init3=t1 = 0.01 * randint(100);
shape_0_init4=t2 = 0.01 * randint(100);
shape_0_per_frame1=ang = time * (0.3 + 0.1 * t1);
shape_0_per_frame2=rad = rad * (0.9 + 0.2 * t2);
shape_0_per_frame3=r = min(1, max(0, r + 0.2 * sin(0.417 * time + 1)));
shape_0_per_frame4=g = min(1, max(0, g + 0.2 * sin(0.391 * time + 2)));
shape_0_per_frame5=b = min(1, max(0, b + 0.2 * sin(0.432 * time + 4)));
shape_0_per_frame6=r2 = min(1, max(0, r2 + 0.2 * sin(0.657 * time + 3)));
shape_0_per_frame7=g2 = min(1, max(0, g2 + 0.2 * sin(0.737 * time + 5)));
shape_0_per_frame8=b2 = min(1, max(0, b2 + 0.2 * sin(0.884 * time + 6)));
shape_1_init1=t1 = 0;
shape_1_init2=t2 = 0;
shape_1_init3=t1 = 0.01 * randint(100);
shape_1_init4=t2 = 0.01 * randint(100);
shape_1_per_frame1=x = x + 0.05 * sin(1.05 * time + 3);
shape_1_per_frame2=y = y + 0.03 * sin(1.29 * time + 1);
shape_1_per_frame3=ang = time * (0.1 + 0.1 * t1);
shape_1_per_frame4=rad = rad * (0.9 + 0.2 * t2);
shape_2_init1=t1 = 0;
shape_2_init2=t2 = 0;
shape_2_init3=q2 = 0;
shape_2_init4=q1 = 0;
shape_2_init5=q3 = 0;
shape_2_init6=t1 = 0.01 * randint(100);
shape_2_init7=t2 = 0.01 * randint(100);
shape_2_per_frame1=x = x + 0.05 * sin(0.17 * time);
shape_2_per_frame2=y = y + 0.03 * sin(0.83 * time);
shape_2_per_frame3=ang = time * (0.2 + 0.1 * t1);
shape_2_per_frame4=rad = rad * (0.9 + 0.2 * t2);
shape_2_per_frame5=r = q2;
shape_2_per_frame6=g = q1;
shape_2_per_frame7=b = q3;
shape_2_per_frame8=r2 = min(1, max(0, r2 + 0.1 * sin(0.457 * time + 3)));
shape_2_per_frame9=g2 = min(1, max(0, g2 + 0.1 * sin(0.437 * time + 5)));
shape_2_per_frame10=b2 = min(1, max(0, b2 + 0.1 * sin(0.484 * time + 6)));
shape_3_init1=q2 = 0;
shape_3_init2=q3 = 0;
shape_3_init3=q1 = 0;
shape_3_per_frame1=x = x + 0.2 * sin(0.25 * time);
shape_3_per_frame2=y = y + 0.1 * sin(0.5 * time + 2);
shape_3_per_frame3=r = q2;
shape_3_per_frame4=g = q3;
shape_3_per_frame5=b = q1;
