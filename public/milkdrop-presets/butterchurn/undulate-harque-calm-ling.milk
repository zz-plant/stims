     - 0.5))) * dist_3)
   + 0.5) + q31));
  xlat_mutableneu = (texture (sampler_main, tmpvar_6).xyz + (2.0 * (
    (texture (sampler_blur1, tmpvar_6).xyz * scale1)
   + bias1)));
  xlat_mutableret1 = max ((xlat_mutableret1 * 0.9), (xlat_mutableneu * inten_2));
  uv2_4 = (uv_1 * aspect.yx);
  vec2 tmpvar_7;
  tmpvar_7 = abs((fract(
    (uv2_4 + 0.5)
  ) - 0.5));
  uv2_4 = tmpvar_7;
