[preset00]
fRating=0.000000
fGammaAdj=1.994000
fDecay=0.970000
nWaveMode=1.000000
bAdditiveWaves=1.000000
fWaveAlpha=4.500000
fWaveScale=1.524000
fWaveSmoothing=0.900000
fWarpAnimSpeed=0.335000
fWarpScale=3.928000
fZoomExponent=2.100000
fZoom=0.961000
fWarp=1.771010
fWaveR=0.650000
fWaveG=0.650000
fWaveB=0.650000
fOuterBorderSize=0.000000
fOuterBorderA=0.500000
fInnerBorderSize=0.030000
fInnerBorderR=0.340000
fInnerBorderG=0.340000
fInnerBorderB=0.340000
fInnerBorderA=0.100000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_1=wave_x = wave_x + 0.29 * (0.6 * sin(2.121 * time) + 0.4 * sin(1.621 * time));
per_frame_2=wave_y = wave_y + 0.29 * (0.6 * sin(1.742 * time) + 0.4 * sin(2.322 * time));
per_frame_3=wave_r = wave_r + 0.35 * (0.6 * sin(0.823 * time) + 0.4 * sin(0.916 * time));
per_frame_4=wave_g = wave_g + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.023 * time));
per_frame_5=wave_b = wave_b + 0.35 * (0.6 * sin(0.808 * time) + 0.4 * sin(0.949 * time));
per_frame_6=rot = rot + 0.35 * (0.6 * sin(0.21 * time) + 0.3 * sin(0.339 * time));
per_frame_7=cx = cx + 0.3 * (0.6 * sin(0.374 * time) + 0.14 * sin(0.194 * time));
per_frame_8=cy = cy + 0.37 * (0.6 * sin(0.274 * time) + 0.1 * sin(0.394 * time));
per_frame_9=ib_r = ib_r + 0.2 * sin(0.5413 * time);
per_frame_10=ib_g = ib_g + 0.2 * sin(0.6459 * time);
per_frame_11=ib_b = ib_b + 0.2 * sin(0.7354 * time);

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1 = texture (sampler_main, uv);
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = ((max (tmpvar_1.xyz, texture (sampler_main, 
    (uv + (vec2(0.0, 5.0) * ((tmpvar_1.xy - 0.5) * texsize.zw)))
  ).xyz) - 0.008) * 0.96);
  ret = tmpvar_2.xyz;
 }
