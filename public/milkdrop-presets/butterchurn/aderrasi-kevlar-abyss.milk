[preset00]
fRating=0.000000
fGammaAdj=1.000000
fVideoEchoZoom=1.000000
nVideoEchoOrientation=3.000000
nWaveMode=1.000000
bWaveDots=1.000000
bWaveThick=1.000000
fWaveAlpha=0.127257
fWaveScale=1.599183
fWaveSmoothing=0.000000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fDX=0.000010
fDY=0.000010
fWarp=0.010000
fWaveR=0.500000
fWaveG=0.500000
fWaveB=0.500000
fOuterBorderSize=0.005000
fOuterBorderA=0.010000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
nMotionVectorsLoop=1.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=wave_r = wave_r + 0.25 * sin(1.4 * time) + 0.25 * sin(2.25 * time);
per_frame_2=wave_g = wave_g + 0.25 * sin(1.7 * time) + 0.25 * sin(2.11 * time);
per_frame_3=wave_b = wave_b + 0.25 * sin(1.84 * time) + 0.25 * sin(2.3 * time);
per_frame_4=warp = 0;
per_frame_5=ob_r = ob_r + 0.3 * sin(1.2 * time);
per_frame_6=ob_g = ob_g + 0.3 * cos(2 * time);
per_frame_7=ob_b = ob_b + 0.25 * sin(1.5 * time);
per_frame_8=ib_r = wave_r;
per_frame_9=ib_b = wave_b;
per_frame_10=ib_g = wave_g;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=rot = rot + 0.05 * (2 - rad) * (0.2 * cos(rad - 0.22 * abs(12 * ang + bass / time)) - 1.3 * treb * cos(bass_att));
per_pixel_5=zoom = zoom - 0.02 * abs(sin(bass - time / 22 * rad) - cos(0.3 * bass - mid_att));
per_pixel_6=zoom = zoom - 0.2 * abs(0.5 * sin(0.2 * bass * rot - 3 * (0.5 - sin(0.5 * time) - (0.25 - rad))));
per_pixel_7=zoomexp = zoomexp + 0.25 + abs(0.5 * sin(time * bass_att));
per_pixel_8=zoom = if(0.00001 < abs(below(bass, 0.05)), 0, zoom);
per_pixel_9=rot = if(0.00001 < abs(below(bass, 0.05)), 0, sin(0.2));
per_pixel_10=cy = cy + 5.5 * sin(time) * dy_r;
per_pixel_11=cx = cx + 5.5 * cos(2.5 * time) * dx_r;
