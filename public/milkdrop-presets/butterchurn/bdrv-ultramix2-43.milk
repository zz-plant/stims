per_frame_init_1=jzm = 0;
per_frame_init_2=kdx = 0;
per_frame_init_3=crs = 0;
per_frame_init_4=crx = 0;
per_frame_init_5=cb = 0;
per_frame_init_6=ci = 0;
per_frame_init_7=jcy = 0;
per_frame_init_8=thresh = 0;
per_frame_init_9=kzm = 0;
per_frame_init_10=jdx = 0;
per_frame_init_11=jwp = 0;
per_frame_init_12=kwp = 0;
per_frame_init_13=dy_r = 0;
per_frame_init_14=cr2 = 0;
per_frame_init_15=jrt = 0;
per_frame_init_16=cr = 0;
per_frame_init_17=jdy = 0;
per_frame_init_18=jsx = 0;
per_frame_init_19=ksy = 0;
per_frame_init_20=xy = 0;
per_frame_init_21=kcy = 0;
per_frame_init_22=ksx = 0;
per_frame_init_23=dx_r = 0;
per_frame_init_24=jsy = 0;
per_frame_init_25=mekdx = 0;
per_frame_init_26=kcx = 0;
per_frame_init_27=jcx = 0;
per_frame_init_28=crr = 0;
per_frame_init_29=cqr = 0;
per_frame_init_30=kx1 = 0;
per_frame_init_31=cr1 = 0;
per_frame_init_32=jx1 = 0;
per_frame_init_33=kdy = 0;
per_frame_init_34=krt = 0;
per_frame_1=wave_r = 0.5 + 0.5 * sin(6 * time);
per_frame_2=wave_g = 0.5 + 0.5 * sin(4.1 * time);
per_frame_3=wave_b = -1 + (1 - wave_r + 1 - wave_g);
per_frame_4=warp = 0;
per_frame_5=ob_r = 1 - abs(wave_r);
per_frame_6=ob_g = 1 - abs(wave_g);
per_frame_7=ob_b = 1 - abs(wave_b);
per_frame_8=ib_r = abs(wave_r);
per_frame_9=ib_b = abs(wave_b);
per_frame_10=ib_g = abs(wave_g);
per_pixel_1=mekdx = dx;
per_pixel_2=kdy = dy;
per_pixel_3=ksx = sx;
per_pixel_4=ksy = sy;
per_pixel_5=krt = rot;
per_pixel_6=kzm = zoom;
per_pixel_7=kcx = cx;
per_pixel_8=kcy = cy;
per_pixel_9=kwp = warp;
per_pixel_10=dx = 0;
per_pixel_11=dy = 0;
per_pixel_12=sx = 1;
per_pixel_13=sy = 1;
per_pixel_14=rot = 0;
per_pixel_15=zoom = 1;
per_pixel_16=cx = 0.5;
per_pixel_17=cy = 0.5;
per_pixel_18=warp = 0;
per_pixel_19=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_20=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_21=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_22=xy = above(sin(time), 0) * x + below(sin(1.34 * time), 0) * y + -1 * above(bass_att, 1.1);
per_pixel_23=dx = dx + dx_r;
per_pixel_24=dy = dy + dy_r;
per_pixel_25=sx = sx - abs(12 * dx_r * xy * sin(xy * bass_att * 1.25));
per_pixel_26=sy = sy - abs(12 * dy_r * xy * sin(xy * bass_att * 1.25));
per_pixel_27=rot = rot + 22 * dx_r * xy * cos(4 * xy * treb_att);
per_pixel_28=cx = cx + 8 * dx_r * xy * sin(xy * mid_att * 1.1);
per_pixel_29=cy = cy + 8 * dy_r * xy * sin(xy * mid_att * 1.1);
per_pixel_30=cr1 = 0.01;
per_pixel_31=cr2 = 0.99;
per_pixel_32=crx = cr2 - cr1;
per_pixel_33=ci = 4 * (1 - (1 - abs(-2 * (x + y) / 2 + 1) + (1 - abs(-2 * (1 - (x + (1 - y)) / 2) + 1))) / 2) - 1;
per_pixel_34=cb = 0.25;
per_pixel_35=crs = 2;
per_pixel_36=cr = pow(sin(6.3 * ci - 6.3 * cb) / 2 + 0.5, crs) * crx + cr1;
per_pixel_37=cqr = if(0.00001 < abs(above(ci, 0.25 + cb)), cr, crx + cr1);
per_pixel_38=crr = if(0.00001 < abs(below(ci, 1.5)), cqr, crx + cr1);
per_pixel_39=jx1 = crr;
per_pixel_40=kx1 = 1 - crr;
per_pixel_41=jdx = dx;
per_pixel_42=jdy = dy;
per_pixel_43=jsx = sx;
per_pixel_44=jsy = sy;
per_pixel_45=jrt = rot;
per_pixel_46=jzm = zoom;
per_pixel_47=jcx = cx;
per_pixel_48=jcy = cy;
per_pixel_49=jwp = warp;
per_pixel_50=dx = jx1 * jdx + kx1 * kdx;
per_pixel_51=dy = jx1 * jdy + kx1 * kdy;
per_pixel_52=sx = jx1 * jsx + kx1 * ksx;
per_pixel_53=sy = jx1 * jsy + kx1 * ksy;
per_pixel_54=rot = jx1 * jrt + kx1 * krt;
per_pixel_55=zoom = jx1 * jzm + kx1 * kzm;
per_pixel_56=cx = jx1 * jcx + kx1 * kcx;
per_pixel_57=cy = jx1 * jcy + kx1 * kcy;
per_pixel_58=warp = jx1 * jwp + kx1 * kwp;
