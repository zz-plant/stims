wave_0_init7=md = 0;
wave_0_per_point1=oldmd = md;
wave_0_per_point2=md = mod(md + randint(4), 4);
wave_0_per_point3=md = if(0.00001 < abs(equal(md, oldmd)), mod(md + 1, 4), md);
wave_0_per_point4=mx = mx + 0.002 * equal(md, 0) * bass;
wave_0_per_point5=mx = mx - 0.002 * equal(md, 1) * bass;
wave_0_per_point6=my = my + 0.002 * equal(md, 2) * treb;
