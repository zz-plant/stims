[preset00]
fRating=0.000000
fGammaAdj=1.000000
fDecay=0.925000
fVideoEchoZoom=0.986700
fVideoEchoAlpha=0.500000
nWaveMode=7.000000
bAdditiveWaves=1.000000
bWaveThick=1.000000
fWaveAlpha=4.099998
fWaveScale=1.285751
fWaveSmoothing=0.630000
fModWaveAlphaStart=0.710000
fModWaveAlphaEnd=1.300000
fWarpScale=1.331000
fZoom=0.999514
fWarp=0.010000
fOuterBorderSize=0.500000
fOuterBorderR=0.010000
fInnerBorderSize=0.260000
nMotionVectorsX=64.000000
nMotionVectorsY=1.248000
nMotionVectorsLoop=5.000000
fMotionVectorsB=0.000000
fMotionVectorsA=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=bass_thresh = 0;
per_frame_init_3=treb_thresh = 0;
per_frame_init_4=mid_thresh = 0;
per_frame_init_5=ez = 0;
per_frame_init_6=q4 = 0;
per_frame_init_7=vol_thresh = 0;
per_frame_init_8=mid_mid_att = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=q3 = 0;
per_frame_1=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * (0.96 * (bass_thresh - 1.3) + 1.3);
per_frame_2=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_3=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_4=vol_thresh = bass_thresh + treb_thresh + mid_thresh;
per_frame_5=q1 = bass_thresh;
per_frame_6=q2 = treb_thresh;
per_frame_7=q3 = mid_thresh;
per_frame_8=q4 = vol_thresh;
per_frame_9=wave_r = 0.1 + 0.5 * sin(0.54 * time) - 0.2 * sin(below(q1, q2));
per_frame_10=wave_b = if(0.00001 < abs(above(q2, q3)), 0.5 - 0.3 * sin(0.23 * time), 0);
per_frame_11=wave_g = if(0.00001 < abs(above(q2, q3)), wave_r - 0.05 * sin(0.3 * time) + 0.5 * sin(above(q1, q2)), 1 - 0.5 * sin(time) * sin(equal(wave_b, 0)));
per_frame_12=ez = sin(wave_g) * cos(wave_r - wave_b) + 0.3 * sin(if(0.00001 < abs(below(ez, 0.7)), ez, ez + 0.2));
per_frame_13=echo_zoom = ez;
per_pixel_1=zoom = zoom + 0.01 * sin(3.14 * rad - q1) + 0.03 * sin(q3);
per_pixel_2=rot = rot - 0.01 * sin(3.14 * rad) + 0.02 * sin(above(q1, q2));
per_pixel_3=dx = dx + 0.01 * sin(5 * rad) * sin(0.54 * time - q3);
