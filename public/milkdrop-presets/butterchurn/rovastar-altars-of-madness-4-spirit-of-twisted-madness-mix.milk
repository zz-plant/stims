shapecode_3_enabled=0.000000
per_frame_init_1=meanbass_att = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q5 = 0;
per_frame_init_4=oldq8 = 0;
per_frame_init_5=box = 0;
per_frame_init_6=lastbeat = 0;
per_frame_init_7=beatrate = 0;
per_frame_init_8=peakbass_att = 0;
per_frame_init_9=oldq3 = 0;
per_frame_init_10=oldq5 = 0;
per_frame_init_11=volume = 0;
per_frame_init_12=beat = 0;
per_frame_init_13=q3 = 0;
per_frame_init_14=q8 = 0;
per_frame_1=ob_r = 0.7 - 0.3 * (0.5 * sin(0.701 * time) + 0.3 * cos(0.438 * time));
per_frame_2=ob_g = 0.5 - 0.4 * sin(5.924 * time);
per_frame_3=ob_b = 0.45 - 0.3 * cos(0.816 * time);
per_frame_4=warp = 0;
per_frame_5=volume = 0.08 * (bass_att + 3 * bass + mid + mid_att);
per_frame_6=beatrate = if(0.00001 < abs(equal(beatrate, 0)), 1, if(0.00001 < abs(below(volume, 0.01)), 1, beatrate));
per_frame_7=lastbeat = if(0.00001 < abs(equal(lastbeat, 0)), time, lastbeat);
per_frame_8=meanbass_att = 0.1 * (9 * meanbass_att + bass_att);
per_frame_9=peakbass_att = if(0.00001 < abs(above(bass_att, peakbass_att)), bass_att, peakbass_att);
per_frame_10=beat = if(0.00001 < abs(above(volume, 0.8)), if(0.00001 < abs(below(peakbass_att - bass_att, 0.05 * peakbass_att)), if(0.00001 < abs(above(time - lastbeat, 0.1 + 0.5 * (beatrate - 0.1))), 1, 0), 0), 0);
per_frame_11=beatrate = max(if(0.00001 < abs(beat), if(0.00001 < abs(below(time - lastbeat, 2 * beatrate)), 0.1 * (9 * beatrate + time - lastbeat), beatrate), beatrate), 0.1);
per_frame_12=peakbass_att = if(0.00001 < abs(equal(beat, 0)), if(0.00001 < abs(above(time - lastbeat, 2 * beatrate)), 0.95 * peakbass_att, 0.995 * peakbass_att), bass_att);
per_frame_13=lastbeat = if(0.00001 < abs(beat), time, lastbeat);
per_frame_14=peakbass_att = max(if(0.00001 < abs(beat), bass_att, peakbass_att), 1.1 * meanbass_att);
per_frame_15=q5 = if(0.00001 < abs(beat), 0.1 * randint(1000), oldq5);
per_frame_16=oldq5 = q5;
per_frame_17=q3 = if(0.00001 < abs(beat), 0.1 * randint(1000), oldq3);
per_frame_18=oldq3 = q3;
per_frame_19=ib_size = 0.02;
per_frame_20=ib_r = ib_r + 0.5 * sin(2.424 * time);
per_frame_21=ib_g = ib_g + 0.5 * sin(2.247 * time);
per_frame_22=ib_b = ib_b - 0.5 * sin(1.131 * time);
per_frame_23=q8 = oldq8 + 0.003 * (pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 6) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 5) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 4) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 3) / fps + pow(1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att, 2) / fps + (1.2 * bass + 0.4 * bass_att + 0.1 * treb + 0.1 * treb_att + 0.1 * mid + 0.1 * mid_att) / fps) + 1 / (5 * fps);
per_frame_24=oldq8 = q8;
per_pixel_1=box = mod(abs(2 * x - 0.4 * sin(q3)), 2) + mod(abs(2 * y + 0.4 * sin(q5)), 2);
per_pixel_2=q1 = 4.05 + (sin(x + 0.237 * time) - cos(y + 0.513 * time));
per_pixel_3=zoom = if(0.00001 < abs(above(box, 1)), 0.1 * q1, zoom);
per_pixel_4=rot = if(0.00001 < abs(above(box, 1)), sin(0.885 * q8), 0);
per_pixel_5=dx = if(0.00001 < abs(above(box, 1)), sin(0.542 * time), 0.005 * sin(48 * (2 * y - 1)) + 0.001 * tan(64 * (2 * y - 1)));
per_pixel_6=dy = if(0.00001 < abs(above(box, 1)), sin(0.581 * time), 0.001 * (1 + abs(sin(q8))) * cos(48 * (2 * x - 1)) + 0.001 * tan(48 * (2 * x - 1)));
per_pixel_7=zoomexp = if(0.00001 < abs(above(box, 1)), 3, 1);
