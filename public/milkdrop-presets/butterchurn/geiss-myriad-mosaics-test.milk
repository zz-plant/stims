[warp_shader]
shader_body { 
  vec3 ret_1;
  float tmpvar_2;
  tmpvar_2 = (0.03 + (1.5 * (q11 * q11)));
  vec3 tmpvar_3;
  tmpvar_3.xy = (((
    (uv_orig * 4.0)
   * texsize.xy) / 850.0) * tmpvar_2);
  tmpvar_3.z = (time * 0.055);
  vec2 tmpvar_4;
  tmpvar_4 = (uv_orig * texsize.xy);
  ret_1 = texture (sampler_main, (uv + ((1.53 * 
    (cos(((
      (0.6 * tmpvar_4)
     * tmpvar_2) + (texture (sampler_noisevol_hq, tmpvar_3).xy * 9.0))) * texsize.zw)
  ) / tmpvar_2))).xyz;
  ret_1 = (ret_1 * 0.99);
  ret_1 = (ret_1 + (19.52 * (
    (texture (sampler_noise_lq, ((tmpvar_4 * texsize_noise_lq.zw) + rand_frame.xy)).xyz - 0.5)
   / 256.0)));
  ret_1 = mix (ret_1, ret_1.zxy, vec3(0.05, 0.05, 0.05));
  vec4 tmpvar_5;
  tmpvar_5.w = 1.0;
  tmpvar_5.xyz = ret_1;
  ret = tmpvar_5.xyz;
 }

[comp_shader]
