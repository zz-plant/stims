per_frame_27=wave_a = 24 * (beat - prev_beat - 0.07);
per_frame_28=is_beat = above(wave_a, 0.5);
per_frame_29=rot = (1 - is_beat) * my_rot + is_beat * new_rot;
per_frame_30=zoom = (1 - is_beat) * my_zoom + is_beat * new_zoom;
per_frame_31=warp = (1 - is_beat) * my_warp + is_beat * new_warp;
