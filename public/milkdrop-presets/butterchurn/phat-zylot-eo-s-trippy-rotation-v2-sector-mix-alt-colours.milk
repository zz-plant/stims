per_pixel_1=zoom = 0.99;
per_pixel_2=cx = 0.5 + q4;
per_pixel_3=cy = 0.5 - q5;
per_pixel_4=rd = sqrt(sqr(2 * (x - 0.5 - q4)) + sqr(1.5 * (y - 0.5 + q5)));
per_pixel_5=zm = 1;
per_pixel_6=ag = atan((y - 0.5 + q5) / (x - 0.5 - q4));
per_pixel_7=star = sin(ag / 5) * (2 - rd);
per_pixel_8=zm = zm + star / 20;
per_pixel_9=sx = zm;
per_pixel_10=sy = zm;
per_pixel_11=rot = 0.1 * (above(rd, 0.7) / (rd + 7)) * bass_att / rd;
per_pixel_12=sect_a = if(0.00001 < abs(below(x, 0.333)), 1, 0);
per_pixel_13=sect_b = if(0.00001 < abs(below(x, 0.666)), 1, 0);
per_pixel_14=sect_b = if(0.00001 < abs(above(x, 0.333)), sect_b, 0);
per_pixel_15=sect_c = if(0.00001 < abs(above(x, 0.666)), 1, 0);
per_pixel_16=dx_a = 0.003 * sin(75.36 * y);
per_pixel_17=dy_a = 0.003 * sin(87.92 * x);
per_pixel_18=dy_b = 0.01 * sin(time + 2 * sin(time));
per_pixel_19=dx = dx_a * sect_a;
per_pixel_20=dy = dy_a * sect_a + dy_b * sect_b;
