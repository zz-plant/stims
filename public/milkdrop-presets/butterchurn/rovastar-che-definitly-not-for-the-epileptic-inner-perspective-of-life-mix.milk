[preset00]
fRating=1.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000400
nWaveMode=1.000000
bAdditiveWaves=1.000000
bWaveDots=1.000000
bWaveThick=1.000000
bModWaveAlphaByVolume=1.000000
bDarkenCenter=1.000000
bDarken=1.000000
fWaveAlpha=1.005730
fWaveScale=0.282090
fWaveSmoothing=0.000000
fModWaveAlphaStart=1.489999
fModWaveAlphaEnd=0.750000
fWarpScale=1.331000
fZoomExponent=0.690737
fShader=1.000000
fZoom=2.380962
fCX=0.499900
fCY=0.499900
fDX=0.200000
fDY=0.200000
fWarp=0.010000
fSx=0.463935
fSy=0.535239
fWaveR=0.000000
fWaveB=0.000000
fOuterBorderSize=0.030000
fOuterBorderA=1.000000
fInnerBorderSize=0.005000
fInnerBorderR=0.000000
fInnerBorderG=0.000000
fInnerBorderB=0.000000
fInnerBorderA=1.000000
nMotionVectorsX=64.000000
nMotionVectorsY=1.248000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=q1 = 0;
per_frame_init_2=le = 0;
per_frame_init_3=pulse = 0;
per_frame_init_4=th = 0;
per_frame_init_5=block = 0;
per_frame_init_6=cycle = 0;
per_frame_1=le = 1.4 * bass_att + 0.1 * bass + 0.5 * treb;
per_frame_2=pulse = band(above(le, th), above(le - th, block));
per_frame_3=block = le - th;
per_frame_4=th = if(0.00001 < abs(above(le, th)), le + 114 / (le + 10) - 7.407, th + 0.07 * th / (th - 12) + 0.1 * below(th, 2.7) * (2.7 - th));
per_frame_5=cycle = if(0.00001 < abs(pulse), cycle + 1, cycle);
per_frame_6=q1 = cycle;
per_frame_7=wave_r = 0.5 + 0.35 * (0.6 * sin(0.825 * time) + 0.4 * sin(0.915 * time));
per_frame_8=wave_g = 0.5 + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(1.025 * time));
per_frame_9=wave_b = 0.5 + 0.35 * (0.6 * sin(0.81 * time) + 0.4 * sin(0.95 * time));
per_frame_10=mv_r = 0.5 + 0.35 * (0.6 * sin(0.9 * time) + 0.4 * sin(0.75 * time));
per_frame_11=mv_g = 0.5 + 0.35 * (0.6 * sin(0.825 * time) + 0.4 * sin(0.95 * time));
per_frame_12=mv_b = 0.5 + 0.35 * (0.6 * sin(0.775 * time) + 0.4 * sin(1.025 * time));
per_frame_13=ib_r = mv_b;
per_frame_14=ib_b = 1 - mv_g;
per_frame_15=ib_g = wave_r;
per_frame_16=ob_b = mv_r;
per_frame_17=ob_r = 0.5 * (wave_b + wave_g);
per_frame_18=ob_g = 0.5 * (wave_r + mv_b);
per_frame_19=zoom = zoom - 0.1 * (0.1 - (0.5 * th + 0.2 * le + pulse));
per_frame_20=warp = 0;
per_pixel_1=rot = -ang + sin(q1);
per_pixel_2=zoom = zoom - 0.08 * rot;
