per_frame_10=ob_g = 0;
per_frame_11=ob_r = 0;
per_frame_12=ob_b = 0;
per_frame_13=ob_a = 1;
per_frame_14=zoomin = bass + 0.01 * zoomin;
per_frame_15=zoomi = above(zoomin, 2) + 0.975 * zoomi;
per_frame_16=zval = cos(0.3 * time) * above(zoomi, 2);
per_frame_17=zuse = 0.05 * zval + 1;
per_frame_18=monitor = zoomi;
per_frame_19=zoom = zuse;
per_frame_20=r = above(bass, 1.3) + 0.95 * r;
per_frame_21=t = below(r, 5);
per_frame_22=q1 = t * val * 0.5;
per_frame_23=mv_dx = 0.5 * sin(time) + 0.5;
per_frame_24=mv_dy = 0.5 * cos(time) + 0.5;
