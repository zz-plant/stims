per_frame_1=zoom = 1;
per_frame_2=decay = 0.995;
per_frame_3=maat = maat + above(bass_att, 1.5);
per_frame_4=maat = maat * below(maat, 16);
per_frame_5=val = if(0.00001 < abs(above(maat, 8)), 1, val);
per_frame_6=val = if(0.00001 < abs(above(val, 0.6)), 0.99 * val, 0.3);
per_frame_7=echo_zoom = val + 0.7;
per_frame_8=zoom = 1;
