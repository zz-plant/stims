per_frame_init_35=v2 = 0;
per_frame_init_36=q20 = 0;
per_frame_init_37=q8 = 0;
per_frame_1=w = w1;
per_frame_2=ww = -(y1 - y2) * (1 + 2 * (70 / fps - 1)) - 0.8 * y1;
per_frame_3=w = w - 5 * ww;
per_frame_4=q1 = cos(ww);
per_frame_5=q2 = sin(ww);
per_frame_6=q3 = 1.12;
per_frame_7=q4 = 0.042 * sin(w);
per_frame_8=q5 = 0.042 * cos(w);
per_frame_9=a = 0.5 * asin(1);
per_frame_10=d = 0.08;
per_frame_11=q6 = cos(a + 0 * ww);
per_frame_12=q7 = sin(a + 0 * ww);
per_frame_13=q8 = 3.3;
per_frame_14=q9 = cos(-w + asin(1)) * d * aspectx;
per_frame_15=q10 = sin(-w + asin(1)) * d * aspecty;
per_frame_16=q11 = cos(-a + 0 * ww);
per_frame_17=q12 = sin(-a + 0 * ww);
per_frame_18=q13 = q8;
per_frame_19=q14 = cos(-w + asin(1)) * d * aspectx;
per_frame_20=q15 = sin(-w + asin(1)) * d * aspecty;
per_frame_21=bb = 0.97 * bb + 0.04 * bass;
per_frame_22=tt = 0.97 * tt + 0.04 * treb;
per_frame_23=w1 = w1 + ww1 * a * 0.15;
per_frame_24=ww1 = 0.94 * ww1 + 0.1 * y1;
per_frame_25=q16 = 0.2 * (bb - tt);
per_frame_26=y1 = y1 + 0.1 * v1;
per_frame_27=y2 = y2 + 0.2 * v2;
per_frame_28=v1 = 0.95 * v1 - 0.1 * (y1 - q16);
per_frame_29=v2 = 0.99 * v2 - 0.2 * (y2 - y1);
per_frame_30=a = 2.2 * abs(y2 - y1) / fps;
per_frame_31=q17 = sin(w) * a;
per_frame_32=q18 = -cos(w) * a;
per_frame_33=v = 0.25;
per_frame_34=x = x + vx * v;
per_frame_35=y = y + vy * v;
per_frame_36=vx = 0.98 * vx + sin(w) * a;
per_frame_37=vy = 0.98 * vy - cos(w) * a;
per_frame_38=q19 = 0.5 * x;
per_frame_39=q20 = 0.5 * y;
per_frame_40=monitor = cx;

[warp_shader]
vec2 xlat_mutablefactorA;
 shader_body { 
  vec3 ret_1;
  xlat_mutablefactorA = ((uv_orig - 0.5) * aspect.xy);
  vec2 tmpvar_2;
  tmpvar_2.x = ((xlat_mutablefactorA.x * q1) - (xlat_mutablefactorA.y * q2));
  tmpvar_2.y = ((xlat_mutablefactorA.x * q2) + (xlat_mutablefactorA.y * q1));
  vec2 tmpvar_3;
  tmpvar_3.x = q4;
  tmpvar_3.y = q5;
  vec2 tmpvar_4;
  tmpvar_4.x = ((xlat_mutablefactorA.x * q6) - (xlat_mutablefactorA.y * q7));
  tmpvar_4.y = ((xlat_mutablefactorA.x * q7) + (xlat_mutablefactorA.y * q6));
  vec2 tmpvar_5;
  tmpvar_5.x = q9;
  tmpvar_5.y = q10;
  vec2 tmpvar_6;
  tmpvar_6.x = ((xlat_mutablefactorA.x * q11) - (xlat_mutablefactorA.y * q12));
  tmpvar_6.y = ((xlat_mutablefactorA.x * q12) + (xlat_mutablefactorA.y * q11));
  vec2 tmpvar_7;
  tmpvar_7.x = q14;
  tmpvar_7.y = q15;
  ret_1.x = (max (texture (sampler_main, clamp (
    ((0.5 + ((tmpvar_2 * aspect.zw) * q3)) + (tmpvar_3 * aspect.zw))
  , 0.0, 1.0)).x, max (texture (sampler_main, 
    clamp (((0.5 + (
      (tmpvar_4 * aspect.zw)
     * q8)) + tmpvar_5), 0.0, 1.0)
  ).x, texture (sampler_main, 
    clamp (((0.5 + (
      (tmpvar_6 * aspect.zw)
     * q13)) + tmpvar_7), 0.0, 1.0)
  ).x)) - 0.004);
  vec4 tmpvar_8;
  tmpvar_8.w = 1.0;
  tmpvar_8.xyz = ret_1;
  ret = tmpvar_8.xyz;
 }

[comp_shader]
shader_body { 
  vec2 tmpvar_1;
  tmpvar_1.x = q19;
  tmpvar_1.y = q20;
  vec4 tmpvar_2;
  tmpvar_2.w = 1.0;
  tmpvar_2.xyz = texture (sampler_main, fract(((0.5 + 
    (uv - 0.5)
  ) + (tmpvar_1 * vec2(-1.0, 1.0))))).xxx;
  ret = tmpvar_2.xyz;
 }
