wave_0_per_point5=ampl = 5 * cos(t_rel);
wave_0_per_point6=ox = sin(8 * t_rel) + ampl * sin(12 * t_rel);
wave_0_per_point7=oy = cos(13 * t_rel) + ampl * cos(11 * t_rel);
wave_0_per_point8=oz = ampl / 3;
