wave_0_per_point12=a = 0.25 * cos(3.14 * t_abs / 2) + 0.2 * below(abs(1 - t_abs - t1), 0);
wave_0_per_point13=a = 0.25 * cos(1.5 * t_abs) + 0.7 * below(abs(t_abs), 0);
wave_0_per_point14=xang = 3 * k1;
