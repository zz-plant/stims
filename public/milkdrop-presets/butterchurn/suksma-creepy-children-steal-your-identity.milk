[preset00]
fRating=4.000000
fGammaAdj=1.900000
fDecay=0.982000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.500000
nVideoEchoOrientation=1.000000
nWaveMode=2.000000
bWaveThick=1.000000
bTexWrap=0.000000
bDarken=1.000000
fWaveAlpha=0.216000
fWaveScale=0.948000
fWaveSmoothing=0.500000
fZoomExponent=0.998170
fShader=0.200000
fZoom=0.980010
fCX=0.440000
fWarp=0.010000
fWaveR=0.600000
fWaveG=0.600000
fWaveB=0.600000
fWaveY=0.470000
fOuterBorderSize=0.000000
fInnerBorderSize=0.000000
fInnerBorderR=0.500000
fInnerBorderG=0.500000
fInnerBorderB=0.500000
fMotionVectorsA=0.000000
wavecode_0_enabled=0.000000
wavecode_1_enabled=0.000000
wavecode_2_enabled=0.000000
wavecode_3_enabled=0.000000
shapecode_0_enabled=0.000000
shapecode_1_enabled=0.000000
shapecode_2_enabled=0.000000
shapecode_3_enabled=0.000000
per_frame_init_1=funk = 0;
per_frame_init_2=old_treb_flop = 0;
per_frame_init_3=bass_flop = 0;
per_frame_init_4=g3 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q5 = 0;
per_frame_init_7=treb_flop = 0;
per_frame_init_8=bass_thresh = 0;
per_frame_init_9=g2 = 0;
per_frame_init_10=old_bass_flop = 0;
per_frame_init_11=treb_thresh = 0;
per_frame_init_12=pulse = 0;
per_frame_init_13=bass_changed = 0;
per_frame_init_14=y_shift = 0;
per_frame_init_15=mid_thresh = 0;
per_frame_init_16=q4 = 0;
per_frame_init_17=mid_changed = 0;
per_frame_init_18=entropy = 0;
per_frame_init_19=x_shift = 0;
per_frame_init_20=old_mid_flop = 0;
per_frame_init_21=chaos = 0;
per_frame_init_22=mid_flop = 0;
per_frame_init_23=r_shift = 0;
per_frame_init_24=q2 = 0;
per_frame_init_25=treb_changed = 0;
per_frame_init_26=q3 = 0;
per_frame_init_27=g1 = 0;
per_frame_1=warp = 0;
per_frame_2=old_bass_flop = bass_flop;
per_frame_3=old_treb_flop = treb_flop;
per_frame_4=old_mid_flop = mid_flop;
per_frame_5=chaos = 0.9 + 0.1 * sin(pulse);
per_frame_6=entropy = if(0.00001 < abs(bnot(entropy)), 2, if(0.00001 < abs(equal(pulse, -20)), 1 + floor(randint(6)), entropy));
per_frame_7=bass_thresh = 2 * above(bass_att, bass_thresh) + (1 - above(bass_att, bass_thresh)) * ((bass_thresh - 1.3) * chaos + 1.3);
per_frame_8=bass_flop = abs(bass_flop - equal(bass_thresh, 2));
per_frame_9=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * ((treb_thresh - 1.3) * chaos + 1.3);
per_frame_10=treb_flop = abs(treb_flop - equal(treb_thresh, 2));
per_frame_11=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_att, mid_thresh)) * ((mid_thresh - 1.3) * chaos + 1.3);
per_frame_12=mid_flop = abs(mid_flop - equal(mid_thresh, 2));
per_frame_13=bass_changed = bnot(equal(old_bass_flop, bass_flop));
per_frame_14=mid_changed = bnot(equal(old_mid_flop, mid_flop));
per_frame_15=treb_changed = bnot(equal(old_treb_flop, treb_flop));
per_frame_16=pulse = if(0.00001 < abs(above(abs(pulse), 20)), -20, pulse + 0.01 * chaos * bor(bor(bass_changed, treb_changed), mid_changed) + 0.025 * (mid + bass + treb));
per_frame_17=q3 = sin(pulse);
per_frame_18=q2 = 0.5 * (pulse / entropy) * chaos;
per_frame_19=q4 = sin(q2);
per_frame_20=q5 = entropy;
per_frame_21=q1 = (1 + 1 * above(q4, 0)) * (1 + 2 * above(q3, 0)) * (1 + 4 * mid_changed * above(q3, 0)) * (1 + 6 * above(pulse, 0));
per_frame_22=wave_r = if(0.00001 < abs(treb_flop), abs(0.5 * q4), if(0.00001 < abs(bass_flop), 0.5 + 0.5 * q4, 1));
per_frame_23=wave_g = if(0.00001 < abs(treb_changed), 0, if(0.00001 < abs(mid_changed), 0, 0.49));
per_frame_24=wave_b = if(0.00001 < abs(treb_flop), 0.8 + 0.2 * q4, bass_changed * mid_changed);
per_frame_25=cx = 0.5 + 0.2 * q3;
per_frame_26=cy = 0.5 + 0.2 * q4;
per_frame_27=wave_x = 0.5 + 0.2 * q4 * bnot(mod(q1, 7));
per_frame_28=wave_y = 0.5 + if(0.00001 < abs(bnot(mod(q1, 2))), 0.2 * q3, 0) + 0.1 * bnot(mod(q1, 3)) - 0.1 * bnot(mod(q1, 5));
per_frame_29=ob_r = if(0.00001 < abs(bass_flop), treb_flop, wave_g);
per_frame_30=ob_b = if(0.00001 < abs(treb_flop), 0.5 + 0.5 * q3, wave_b);
per_frame_31=ob_g = if(0.00001 < abs(mid_flop), wave_r, wave_b);
per_frame_32=ob_a = 0.07 + 0.05 * q3;
per_frame_33=ob_size = 0.01 * entropy * bnot(mod(q1, 6));
per_frame_34=ib_r = ib_r + 0.4 * bnot(mod(q1, 10)) - 0.4 * bnot(mod(q1, 30));
per_frame_35=ib_b = ib_b + 0.4 * bnot(mod(q1, 42)) - 0.4 * bnot(mod(q1, 21));
per_frame_36=ib_g = ib_g + 0.5 * sin(0.02 * time * entropy);
per_frame_37=ib_a = 0.07 + 0.05 * q3 * q4;
per_frame_38=ib_size = 0.01 + 0.009 * q3;
per_frame_39=zoom = zoom + 0.03 * bnot(mod(q1, 3)) - 0.03 * bnot(mod(q1, 35));
per_pixel_1=g1 = sin(0.1 * q2);
per_pixel_2=g2 = sin(0.2 * q2);
per_pixel_3=g3 = sin(0.3 * q2);
per_pixel_4=x_shift = if(0.00001 < abs(bnot(mod(q1, 3))), pow(x, 2) + x * g1 * 2 + sqr(g3), 3 * g2);
per_pixel_5=y_shift = if(0.00001 < abs(bnot(mod(q1, 5))), pow(y, 2) + y * g2 * 2 + sqr(g1), 3 * g3);
per_pixel_6=r_shift = if(0.00001 < abs(bnot(mod(q1, 7))), pow(rad, 2) + rad * g3 * 2 + sqr(3 * g2), g1);
per_pixel_7=funk = x_shift + y_shift + r_shift;
per_pixel_8=zoom = zoom + 0.05 * cos(funk) * q5;
per_pixel_9=rot = if(0.00001 < abs(bnot(mod(q1, 14))), g2 * rad, 0.1 * q3);
per_pixel_10=dx = dx + 0.33 * (4 - q5) * bnot(mod(q1, 70)) * g1;
per_pixel_11=cx = cy + 0.33 * (4 - q5) * bnot(mod(q1, 105)) * g2;

[warp_shader]
shader_body { 
  vec4 tmpvar_1;
  tmpvar_1.w = 1.0;
  tmpvar_1.xyz = (texture (sampler_main, (uv + (
    (texture (sampler_main, (uv + texsize.zw)).xy - 0.37)
   * 0.03))).xyz - 0.004);
  ret = tmpvar_1.xyz;
 }

[comp_shader]
shader_body { 
  vec2 uv_1;
  vec3 ret_2;
  uv_1 = (0.05 + (0.9 * uv));
  ret_2 = (abs((
    ((texture (sampler_blur1, uv_1).xyz * scale1) + bias1)
   - texture (sampler_main, uv_1).xyz)) * 6.0);
  ret_2 = (ret_2 * 1.333);
  vec4 tmpvar_3;
  tmpvar_3.w = 1.0;
  tmpvar_3.xyz = ret_2;
  ret = tmpvar_3.xyz;
 }
