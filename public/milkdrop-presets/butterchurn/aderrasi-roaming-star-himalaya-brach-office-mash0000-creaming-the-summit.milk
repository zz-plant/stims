per_frame_1=treb_thresh = 2 * above(treb_att, treb_thresh) + (1 - above(treb_att, treb_thresh)) * (0.96 * (treb_thresh - 1.3) + 1.3);
per_frame_2=mid_thresh = 2 * above(mid_att, mid_thresh) + (1 - above(mid_mid_att, mid_thresh)) * (0.96 * (mid_thresh - 1.3) + 1.3);
per_frame_3=vol_thresh = (pfthresh + treb_thresh + mid_thresh) / 3;
per_frame_4=q6 = vol_thresh;
per_frame_5=q7 = treb_thresh;
per_frame_6=q8 = mid_thresh;
per_frame_7=wave_r = 0.65 + 0.5 * sin(1.13 * time);
per_frame_8=wave_g = 0.65 + 0.5 * sin(1.23 * time);
per_frame_9=wave_b = 0.65 + 0.5 * sin(1.33 * time);
per_frame_10=warp = 0;
per_frame_11=pfthresh = 2 * above(bass_att, pfthresh) + (1 - above(bass_att, pfthresh)) * (0.96 * (pfthresh - 1.3) + 1.3);
per_frame_12=pfdx_r = 0.015 * equal(pfthresh, 2) * sin(5 * time) + (1 - equal(pfthresh, 2)) * pfdx_r;
per_frame_13=pfdy_r = 0.015 * equal(pfthresh, 2) * sin(6 * time) + (1 - equal(pfthresh, 2)) * pfdy_r;
per_frame_14=rg1 = abs(sin(time));
per_frame_15=rg2 = 0 * above(rg1, 0.75) + 3 * below(rg1, 0.25) + 1 * above(rg1, 0.25) * below(rg1, 0.5) + 2 * above(rg1, 0.5) * below(rg1, 0.75);
per_frame_16=rg3 = if(0.00001 < abs(equal(pfthresh, 2)), rg2, rg3);
per_frame_17=rg4 = abs(1.2 * sin(1.42 * time));
per_frame_18=rg5 = min(max(0.1, 0.75 * sin(1.42 * time)), 0.25);
per_frame_19=rg6 = if(0.00001 < abs(equal(pfthresh, 2)), rg5, rg6);
per_frame_20=q1 = wave_r;
per_frame_21=q2 = wave_g;
per_frame_22=q3 = wave_b;
per_frame_23=wave_x = wave_x + 0.32 * sin(0.41 * time);
per_frame_24=wave_y = wave_y + 0.152 * cos(0.42 * time) + 0.18 * cos(0.04 * time);
per_frame_25=cog = ocog + 0.025 * (bass + bass_att + bass * bass_att - 2);
per_frame_26=ocog = below(cog, 3000) * cog;
per_frame_27=q4 = cog;
per_frame_28=monitor = q4;
per_pixel_1=thresh = 2 * above(bass_att, thresh) + (1 - above(bass_att, thresh)) * (0.96 * (thresh - 1.3) + 1.3);
per_pixel_2=dx_r = 0.015 * equal(thresh, 2) * sin(5 * time) + (1 - equal(thresh, 2)) * dx_r;
per_pixel_3=dy_r = 0.015 * equal(thresh, 2) * sin(6 * time) + (1 - equal(thresh, 2)) * dy_r;
per_pixel_4=tg1 = abs(sin(time));
per_pixel_5=tg2 = 12 * dx_r * above(tg1, 0.5) + 12 * dy_r * below(tg1, 0.5);
per_pixel_6=tg3 = if(0.00001 < abs(equal(thresh, 2)), tg2, tg3);
