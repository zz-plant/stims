per_frame_27=q1 = cos(rott);
per_frame_28=q2 = sin(rott);
per_frame_29=q3 = -q2;
per_frame_30=q4 = q1;
per_frame_31=rota = rota * dec_med + q1 * bnot(index2) * (1 - dec_med);
per_frame_32=q5 = 0.2 * rota;
per_pixel_1=rot = q5 * sin(4 * q22 * (1 - rad));
per_pixel_2=zoom = 1.08;
