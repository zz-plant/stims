per_frame_18=hld = hld * dec_med + q24;
per_frame_19=q25 = min(hld, 1);
per_frame_20=monitor = q25;
per_frame_21=k1 = is_beat * equal(index, 0);
per_frame_22=p1 = k1 * (p1 + 1) + (1 - k1) * p1;
per_frame_23=p2 = dec_med * p2 + (1 - dec_med) * p1;
per_frame_24=rott = 3.14159265359 * p2 / 2;
per_frame_25=q27 = index;
